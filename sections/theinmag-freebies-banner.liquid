{%- comment -%}
  theinmag-freebies-banner
  Section 2 of /pages/freebies. Compact banner over the freebies_heading
  artwork - quick context only, it must not compete with the grid below.
  This section also loads the page-wide freebies CSS + JS once for every
  downstream section. See freebies-build-spec.md Section 2.
{%- endcomment -%}

{{ 'theinmag-freebies.css' | asset_url | stylesheet_tag }}
<script src="{{ 'theinmag-freebies.js' | asset_url }}" defer></script>

{%- liquid
  assign heading = section.settings.heading | default: 'Ohh goodie!'
  assign subhead = section.settings.subhead
-%}

{% render 'theinmag-character-pool' %}

<section
  class="theinmag-freebies-banner"
  aria-labelledby="theinmag-freebies-banner-heading"
  style="background-image: url('{{ 'freebies_heading.jpg' | asset_url }}');"
>
  <div class="theinmag-freebies-banner__inner">
    <span class="theinmag-freebies-banner__character" data-theinmag-pool-character></span>
    <div class="theinmag-freebies-banner__text">
      <h1 id="theinmag-freebies-banner-heading" class="theinmag-freebies-banner__heading">
        <span class="theinmag-freebies-banner__goodie">{{ heading }}</span>
        <span class="theinmag-freebies-banner__freebies">freebies!</span>
      </h1>
      {%- if subhead != blank -%}
        {%- assign sub_line1 = subhead | split: '. ' | first | append: '.' -%}
        {%- assign sub_line2 = subhead | remove_first: sub_line1 | strip -%}
        <p class="theinmag-freebies-banner__subhead">{{ sub_line1 }}{%- if sub_line2 != blank -%}<br>{{ sub_line2 }}{%- endif -%}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "theINmag Freebies banner",
  "tag": "section",
  "class": "theinmag-freebies-banner-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (H1)",
      "default": "Ohh goodie!"
    },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Subhead",
      "default": "Bite-sized creative ideas inspired by real Aussie kids. Take them, print them, share them. They're yours."
    }
  ],
  "presets": [
    {
      "name": "theINmag Freebies banner"
    }
  ]
}
{% endschema %}
