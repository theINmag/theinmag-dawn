{%- comment -%}
  theinmag-blog-index-editorial
  Top of /blogs/field-notes. Maude-style asymmetric editorial composition
  on the meet-tam lavender (#C9B5DB) so the blog reads as an editorial
  extension of the homepage rather than a foreign template.

  Layout (desktop):
    - Wordmark heading (the/IN/side, IN-emphasised) with subhead tucked
      under "side"; audience toggle (all/kids/adults) on the right
    - Big feature: full-width photo, white text overlaid bottom-left
    - 2/3 + 1/3 grid:
        LEFT  - 2 equal-height large cards stacked + 2 small bottom 2-up
        RIGHT - 6 small cards stacked with hairline dividers between
    - Right column scroll-translates faster than the page so the denser
      side resolves around the same beat as the left

  Audience toggle is wired live: clicking a chip filters the cards in
  this section AND broadcasts a custom event other audience-aware
  sections (the feature banner below) listen to. State persists in
  localStorage so the choice survives across pages.

  Mobile: single-column stack.
{%- endcomment -%}

{%- liquid
  assign heading_pre = section.settings.heading_pre
  assign heading_emphasis = section.settings.heading_emphasis
  assign heading_post = section.settings.heading_post
  assign heading_period = section.settings.heading_period
  assign subhead = section.settings.subhead
  assign show_toggle = section.settings.show_toggle

  assign bg_color = section.settings.background_color | default: '#C9B5DB'

  assign bg_src = ''
  if section.settings.background_image != blank
    assign bg_src = section.settings.background_image | image_url: width: 2400
  elsif section.settings.background_filename != blank
    assign bg_src = section.settings.background_filename | asset_url
  endif

  assign feature_block = blank
  for block in section.blocks
    if block.type == 'feature' and feature_block == blank
      assign feature_block = block
    endif
  endfor

  comment
    Per-audience pools (rebuilt 2026-05-26): we render THREE fully
    populated grids - one each for all/kids/adults - and the toggle
    swaps which pool is visible. Layout stays identical across views,
    no empty slots, parallax stays active. Previously a single grid
    was hidden card-by-card, which left holes in slots where the
    interleave landed an off-audience article.

    Fill priority per pool:
      all    : kids + mixed + adults, interleaved (kids on odd slots,
               mixed/adults on even) so the page reads as a mixture
               rather than a clustered run of one audience.
      kids   : kids first → mixed → adults (opposite only as a last
               resort so the 11 slots never run out before the
               articles do).
      adults : adults first → mixed → kids (mirror of kids).

    Articles are looked up from the global `articles` object by handle
    (filters can't go inside `[]` - assign the key first).
  endcomment
  assign feature_handle = ''
  if feature_block != blank
    if feature_block.settings.article != blank
      assign feature_handle = feature_block.settings.article.handle
    elsif feature_block.settings.link_override != blank
      assign feature_link = feature_block.settings.link_override
      if feature_link contains '/blogs/'
        assign link_parts = feature_link | split: '/'
        assign last_part = link_parts | last
        if last_part != blog.handle and last_part != '' and last_part != 'field-notes'
          assign feature_handle = last_part
        endif
      endif
    endif
  endif

  assign kids_handles = ''
  assign adult_handles = ''
  assign mixed_handles = ''
  for auto_article in blog.articles limit: 50
    if auto_article.handle == feature_handle
      continue
    endif
    assign ra = auto_article.metafields.field_notes.read_audience | downcase
    if ra == 'kids'
      assign kids_handles = kids_handles | append: auto_article.handle | append: ','
    elsif ra == 'parents' or ra == 'adults'
      assign adult_handles = adult_handles | append: auto_article.handle | append: ','
    else
      assign mixed_handles = mixed_handles | append: auto_article.handle | append: ','
    endif
  endfor
  assign kids_arr = kids_handles | split: ','
  assign adult_arr = adult_handles | split: ','
  assign mixed_arr = mixed_handles | split: ','

  assign total_articles = kids_arr.size | plus: adult_arr.size | plus: mixed_arr.size
-%}

{%- comment -%}
  Build ordered handles per pool. SLOT_TOTAL is 11 visible
  (2 large_left + 2 bottom_small + 7 right_small). Each pool gets
  exactly that many entries (capped to what actually exists).
{%- endcomment -%}

{%- liquid
  comment
    "all" pool: kids on odd slots, non-kids on even - the original
    interleave so the page reads as a mixture rather than clustering
    one audience into one region.
  endcomment
  assign all_handles = ''
  assign ki = 0
  assign oi = 0
  assign mi = 0
  for i in (0..10)
    assign slot_parity = i | modulo: 2
    assign picked = ''
    if slot_parity == 0
      if mi < mixed_arr.size
        assign picked = mixed_arr[mi]
        assign mi = mi | plus: 1
      elsif oi < adult_arr.size
        assign picked = adult_arr[oi]
        assign oi = oi | plus: 1
      elsif ki < kids_arr.size
        assign picked = kids_arr[ki]
        assign ki = ki | plus: 1
      endif
    else
      if ki < kids_arr.size
        assign picked = kids_arr[ki]
        assign ki = ki | plus: 1
      elsif mi < mixed_arr.size
        assign picked = mixed_arr[mi]
        assign mi = mi | plus: 1
      elsif oi < adult_arr.size
        assign picked = adult_arr[oi]
        assign oi = oi | plus: 1
      endif
    endif
    if picked != ''
      assign all_handles = all_handles | append: picked | append: ','
    endif
  endfor
  assign all_arr = all_handles | split: ','

  comment
    "kids" pool: every kids article, then mixed/blank, then adults
    only as a last-resort backfill so the 11 slots stay filled when
    real kids+mixed content runs out.
  endcomment
  assign kids_pool = ''
  for h in kids_arr
    assign kids_pool = kids_pool | append: h | append: ','
  endfor
  for h in mixed_arr
    assign kids_pool = kids_pool | append: h | append: ','
  endfor
  for h in adult_arr
    assign kids_pool = kids_pool | append: h | append: ','
  endfor
  assign kids_pool_arr = kids_pool | split: ','

  comment
    "adults" pool: mirror of kids.
  endcomment
  assign adults_pool = ''
  for h in adult_arr
    assign adults_pool = adults_pool | append: h | append: ','
  endfor
  for h in mixed_arr
    assign adults_pool = adults_pool | append: h | append: ','
  endfor
  for h in kids_arr
    assign adults_pool = adults_pool | append: h | append: ','
  endfor
  assign adults_pool_arr = adults_pool | split: ','
-%}

{%- comment -%}
  Per-pool capture: for a given ordered handle list, walk slots
  0-10 and append the rendered card to the right capture variable
  (large_left x2, bottom_small x2, right_small x7).

  This is duplicated for each pool because Liquid lacks reusable
  macros with mutable state. The snippet renders one card and writes
  to whichever capture var the slot index implies.
{%- endcomment -%}

{%- comment -%}
  Per-pool feature article. For 'all' the curated feature_block wins
  (Ryan's pick). For 'kids' / 'adults' we use the first article in the
  pool as the feature so the audience view leads with a matched piece
  instead of inheriting the curated all-view choice.
{%- endcomment -%}
{%- liquid
  assign kids_feature_handle = ''
  for h in kids_pool_arr
    if h == blank
      continue
    endif
    assign cand = articles[h]
    if cand != blank
      assign kids_feature_handle = h
      break
    endif
  endfor

  assign adults_feature_handle = ''
  for h in adults_pool_arr
    if h == blank
      continue
    endif
    assign cand = articles[h]
    if cand != blank
      assign adults_feature_handle = h
      break
    endif
  endfor
-%}

{%- capture all_feature_card -%}
  {%- if feature_block != blank -%}
    {%- render 'theinmag-editorial-card', block: feature_block, variant: 'feature' -%}
  {%- endif -%}
{%- endcapture -%}

{%- capture kids_feature_card -%}
  {%- if kids_feature_handle != '' -%}
    {%- assign kfa = articles[kids_feature_handle] -%}
    {%- if kfa != blank -%}
      {%- render 'theinmag-editorial-card', article: kfa, variant: 'feature' -%}
    {%- endif -%}
  {%- endif -%}
{%- endcapture -%}

{%- capture adults_feature_card -%}
  {%- if adults_feature_handle != '' -%}
    {%- assign afa = articles[adults_feature_handle] -%}
    {%- if afa != blank -%}
      {%- render 'theinmag-editorial-card', article: afa, variant: 'feature' -%}
    {%- endif -%}
  {%- endif -%}
{%- endcapture -%}

{%- capture all_large_left -%}{%- endcapture -%}
{%- capture all_bottom_small -%}{%- endcapture -%}
{%- capture all_right_small -%}{%- endcapture -%}
{%- assign all_count = 0 -%}
{%- for h in all_arr -%}
  {%- assign auto_article = articles[h] -%}
  {%- if auto_article == blank -%}{%- continue -%}{%- endif -%}
  {%- if all_count < 2 -%}
    {%- capture all_large_left -%}{{ all_large_left }}{%- render 'theinmag-editorial-card', article: auto_article, variant: 'large_left' -%}{%- endcapture -%}
  {%- elsif all_count < 4 -%}
    {%- capture all_bottom_small -%}{{ all_bottom_small }}{%- render 'theinmag-editorial-card', article: auto_article, variant: 'bottom_small' -%}{%- endcapture -%}
  {%- elsif all_count < 11 -%}
    {%- capture all_right_small -%}{{ all_right_small }}{%- render 'theinmag-editorial-card', article: auto_article, variant: 'right_small' -%}{%- endcapture -%}
  {%- endif -%}
  {%- assign all_count = all_count | plus: 1 -%}
{%- endfor -%}

{%- capture kids_large_left -%}{%- endcapture -%}
{%- capture kids_bottom_small -%}{%- endcapture -%}
{%- capture kids_right_small -%}{%- endcapture -%}
{%- assign kids_count = 0 -%}
{%- for h in kids_pool_arr -%}
  {%- if h == kids_feature_handle -%}{%- continue -%}{%- endif -%}
  {%- assign auto_article = articles[h] -%}
  {%- if auto_article == blank -%}{%- continue -%}{%- endif -%}
  {%- if kids_count < 2 -%}
    {%- capture kids_large_left -%}{{ kids_large_left }}{%- render 'theinmag-editorial-card', article: auto_article, variant: 'large_left' -%}{%- endcapture -%}
  {%- elsif kids_count < 4 -%}
    {%- capture kids_bottom_small -%}{{ kids_bottom_small }}{%- render 'theinmag-editorial-card', article: auto_article, variant: 'bottom_small' -%}{%- endcapture -%}
  {%- elsif kids_count < 11 -%}
    {%- capture kids_right_small -%}{{ kids_right_small }}{%- render 'theinmag-editorial-card', article: auto_article, variant: 'right_small' -%}{%- endcapture -%}
  {%- endif -%}
  {%- assign kids_count = kids_count | plus: 1 -%}
{%- endfor -%}

{%- capture adults_large_left -%}{%- endcapture -%}
{%- capture adults_bottom_small -%}{%- endcapture -%}
{%- capture adults_right_small -%}{%- endcapture -%}
{%- assign adults_count = 0 -%}
{%- for h in adults_pool_arr -%}
  {%- if h == adults_feature_handle -%}{%- continue -%}{%- endif -%}
  {%- assign auto_article = articles[h] -%}
  {%- if auto_article == blank -%}{%- continue -%}{%- endif -%}
  {%- if adults_count < 2 -%}
    {%- capture adults_large_left -%}{{ adults_large_left }}{%- render 'theinmag-editorial-card', article: auto_article, variant: 'large_left' -%}{%- endcapture -%}
  {%- elsif adults_count < 4 -%}
    {%- capture adults_bottom_small -%}{{ adults_bottom_small }}{%- render 'theinmag-editorial-card', article: auto_article, variant: 'bottom_small' -%}{%- endcapture -%}
  {%- elsif adults_count < 11 -%}
    {%- capture adults_right_small -%}{{ adults_right_small }}{%- render 'theinmag-editorial-card', article: auto_article, variant: 'right_small' -%}{%- endcapture -%}
  {%- endif -%}
  {%- assign adults_count = adults_count | plus: 1 -%}
{%- endfor -%}

{%- assign has_any_auto = false -%}
{%- if total_articles > 0 -%}
  {%- assign has_any_auto = true -%}
{%- endif -%}

{%- liquid
  capture editorial_style
    echo '--editorial-bg-color: '
    echo bg_color
    echo ';'
    if bg_src != blank
      echo " --editorial-bg-image: url('"
      echo bg_src
      echo "');"
    endif
  endcapture
-%}

<section
  class="theinmag-editorial{% if bg_src != blank %} theinmag-editorial--has-bg{% endif %}"
  data-theinmag-editorial
  aria-labelledby="theinmag-editorial-heading"
  style="{{ editorial_style }}"
>
  <div class="theinmag-editorial__inner">

    <header class="theinmag-editorial__intro">
      <div class="theinmag-editorial__wordmark">
        <h1 id="theinmag-editorial-heading" class="theinmag-editorial__heading">
          <img
            src="{{ 'fieldnotes_logo.png' | asset_url }}"
            alt="Field notes"
            class="theinmag-editorial__heading-logo"
            width="2160"
            height="1440"
          >
        </h1>
        {%- if subhead != blank -%}
          <p class="theinmag-editorial__subhead">{{ subhead }}</p>
        {%- endif -%}
      </div>

      {%- if show_toggle -%}
        <nav class="theinmag-editorial__toggle" aria-label="Filter posts by audience" data-field-notes-toggle>
          <button type="button" class="theinmag-editorial__chip is-active" data-audience="all">all</button>
          <button type="button" class="theinmag-editorial__chip" data-audience="kids">kids</button>
          <button type="button" class="theinmag-editorial__chip" data-audience="adults">adults</button>
        </nav>
      {%- endif -%}
    </header>

    {%- if has_any_auto -%}
      {%- comment -%}
        AUTO-PULL PATH: three pre-built audience pools. Pool visibility
        is toggled by the audience chip JS via data-audience-pool. Layout
        and slot count are identical across pools, so the page reads the
        same regardless of filter.
      {%- endcomment -%}

      <div class="theinmag-editorial__pool" data-audience-pool="all">
        {{ all_feature_card }}
        <div class="theinmag-editorial__grid">
          <div class="theinmag-editorial__col theinmag-editorial__col--left">
            {{ all_large_left }}
            <div class="theinmag-editorial__bottom-row">
              {{ all_bottom_small }}
            </div>
          </div>
          <div class="theinmag-editorial__col theinmag-editorial__col--right" data-parallax-window>
            <div class="theinmag-editorial__col-inner" data-parallax-target>
              {{ all_right_small }}
            </div>
          </div>
        </div>
      </div>

      <div class="theinmag-editorial__pool" data-audience-pool="kids" hidden>
        {{ kids_feature_card }}
        <div class="theinmag-editorial__grid">
          <div class="theinmag-editorial__col theinmag-editorial__col--left">
            {{ kids_large_left }}
            <div class="theinmag-editorial__bottom-row">
              {{ kids_bottom_small }}
            </div>
          </div>
          <div class="theinmag-editorial__col theinmag-editorial__col--right" data-parallax-window>
            <div class="theinmag-editorial__col-inner" data-parallax-target>
              {{ kids_right_small }}
            </div>
          </div>
        </div>
      </div>

      <div class="theinmag-editorial__pool" data-audience-pool="adults" hidden>
        {{ adults_feature_card }}
        <div class="theinmag-editorial__grid">
          <div class="theinmag-editorial__col theinmag-editorial__col--left">
            {{ adults_large_left }}
            <div class="theinmag-editorial__bottom-row">
              {{ adults_bottom_small }}
            </div>
          </div>
          <div class="theinmag-editorial__col theinmag-editorial__col--right" data-parallax-window>
            <div class="theinmag-editorial__col-inner" data-parallax-target>
              {{ adults_right_small }}
            </div>
          </div>
        </div>
      </div>
    {%- else -%}
      {%- comment -%}
        SAFETY FALLBACK: no real articles in the blog yet. Render curated
        blocks once (no per-audience pools - the placeholder content is
        the same shape regardless of toggle).
      {%- endcomment -%}
      <div class="theinmag-editorial__pool" data-audience-pool="all">
        {%- if feature_block != blank -%}
          {%- render 'theinmag-editorial-card', block: feature_block, variant: 'feature' -%}
        {%- endif -%}
        <div class="theinmag-editorial__grid">
          <div class="theinmag-editorial__col theinmag-editorial__col--left">
            {%- for block in section.blocks -%}
              {%- if block.type == 'large_left' -%}
                {%- render 'theinmag-editorial-card', block: block, variant: 'large_left' -%}
              {%- endif -%}
            {%- endfor -%}
            <div class="theinmag-editorial__bottom-row">
              {%- for block in section.blocks -%}
                {%- if block.type == 'bottom_small' -%}
                  {%- render 'theinmag-editorial-card', block: block, variant: 'bottom_small' -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
          <div class="theinmag-editorial__col theinmag-editorial__col--right" data-parallax-window>
            <div class="theinmag-editorial__col-inner" data-parallax-target>
              {%- for block in section.blocks -%}
                {%- if block.type == 'right_small' -%}
                  {%- render 'theinmag-editorial-card', block: block, variant: 'right_small' -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        </div>
      </div>
    {%- endif -%}

  </div>
</section>

{%- stylesheet -%}
  .theinmag-editorial {
    background-color: var(--editorial-bg-color, #C9B5DB);
    color: var(--color-inky-purple-navy, #2A1F3D);
    padding: clamp(40px, 6vw, 88px) clamp(16px, 3vw, 32px) clamp(56px, 8vw, 120px);
    overflow: hidden;
  }

  /* Optional decorative bg image - kid patterns/textures behind the
     editorial composition. cover keeps the image filling the section
     no matter how tall the content gets; bg-color sits underneath. */
  .theinmag-editorial--has-bg {
    background-image: var(--editorial-bg-image);
    background-position: top center;
    background-size: cover;
    background-repeat: no-repeat;
  }

  .theinmag-editorial__inner {
    max-width: 1320px;
    margin: 0 auto;
  }

  /* Per-audience pool wrapper. Visible pools use display:contents so
     their children (feature card + grid) participate in __inner's
     layout (esp. the mobile flex re-order) exactly as if there were no
     wrapper. Hidden pools fall through to the UA stylesheet's
     [hidden] { display: none } so their cards are absent from layout
     AND from parallax/dedupe queries scoped to the visible pool. */
  .theinmag-editorial__pool:not([hidden]) {
    display: contents;
  }

  /* ================================================================
     Mobile reorder: feature card at top (full-bleed against header,
     no purple gap, taller portrait crop for editorial weight), then
     intro (heading + tabs), then grid. Inside the grid, the right
     column converts from a vertical stack of dividers to a horizontal
     scroll rail of cards - sits between the bigger left-col tiles
     and the feature banner that follows the editorial section.
     Desktop layout untouched.
     ================================================================ */
  @media (max-width: 749px) {
    /* Hero hits the header with no purple gap above it. */
    .theinmag-editorial {
      padding-top: 0;
    }

    .theinmag-editorial__inner {
      display: flex;
      flex-direction: column;
      gap: clamp(28px, 4vw, 48px);
    }

    /* Note on selectors below: every rule that needs to override a
       desktop default uses the .theinmag-editorial__inner ancestor
       prefix. That bumps specificity from 0,2,0 to 0,3,0 so these
       rules win regardless of source order against the desktop
       defaults later in this stylesheet. Without the prefix, the
       desktop rules (border-radius: 12px on feature cover, padding
       on right_small siblings, etc.) clobber these mobile values
       because they appear later in source. */

    .theinmag-editorial__inner .theinmag-editorial__card--feature {
      order: 1;
      /* Negate section horizontal padding so card hits viewport edges. */
      margin-left: calc(-1 * clamp(16px, 3vw, 32px));
      margin-right: calc(-1 * clamp(16px, 3vw, 32px));
    }

    .theinmag-editorial__inner .theinmag-editorial__card--feature .theinmag-editorial__card-cover {
      border-radius: 0;
      box-shadow: none;
      /* Hero takes 60vh so the next two cards peek meaningfully below
         the fold - 75vh + announcement bar + sticky header was eating
         all visible viewport on Pixel and killing scroll discoverability.
         aspect-ratio cleared so height is viewport-driven. */
      aspect-ratio: auto;
      height: 60vh;
    }

    /* Darker bottom-of-image scrim on mobile for white-text overlay
       readability. Stronger lower stop, dark band climbs higher. */
    .theinmag-editorial__inner .theinmag-editorial__card--feature .theinmag-editorial__card-scrim {
      background: linear-gradient(
        to top,
        rgba(20, 14, 30, 0.86) 0%,
        rgba(20, 14, 30, 0.50) 45%,
        rgba(20, 14, 30, 0) 78%
      );
    }

    .theinmag-editorial__inner .theinmag-editorial__intro {
      order: 2;
      margin-bottom: 0;
    }

    .theinmag-editorial__inner .theinmag-editorial__grid {
      order: 3;
    }

    /* Right column becomes a horizontal scroll rail of small cards. */
    .theinmag-editorial__inner .theinmag-editorial__col--right .theinmag-editorial__col-inner {
      display: flex;
      flex-direction: row;
      gap: clamp(14px, 2vw, 20px);
      overflow-x: auto;
      overflow-y: visible;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      /* Bleed to viewport edges so cards extend past the section's
         padding for an editorial filmstrip feel. */
      margin-left: calc(-1 * clamp(16px, 3vw, 32px));
      margin-right: calc(-1 * clamp(16px, 3vw, 32px));
      padding: 4px clamp(16px, 3vw, 32px);
    }

    .theinmag-editorial__inner .theinmag-editorial__col--right .theinmag-editorial__col-inner::-webkit-scrollbar {
      display: none;
    }

    /* Each rail card is a self-contained white tile. Padding zeroed
       (overrides the desktop hairline-divider vertical padding that
       was leaving a white sliver above cards 2+) and first-child
       padding-top clobbered too so all cards align identically. */
    .theinmag-editorial__inner .theinmag-editorial__col--right .theinmag-editorial__card--right_small {
      flex-shrink: 0;
      width: 72vw;
      max-width: 280px;
      padding: 0;
      scroll-snap-align: start;
      background-color: #FFFFFF;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 2px 10px rgba(42, 31, 61, 0.10);
    }

    .theinmag-editorial__inner .theinmag-editorial__col--right .theinmag-editorial__card--right_small + .theinmag-editorial__card--right_small {
      border-top: none;
    }

    .theinmag-editorial__inner .theinmag-editorial__col--right .theinmag-editorial__card--right_small .theinmag-editorial__card-cover {
      border-radius: 0;
      box-shadow: none;
      display: block;
      margin: 0;
      vertical-align: top;
    }

    .theinmag-editorial__inner .theinmag-editorial__col--right .theinmag-editorial__card--right_small .theinmag-editorial__card-body {
      padding: clamp(12px, 1.6vw, 16px) clamp(14px, 1.6vw, 18px) clamp(14px, 1.8vw, 20px);
    }
  }

  /* ================================================================
     Intro row: wordmark left, audience toggle right
     Indented IN from the feature image edges below so the heading
     reads softer rather than ruler-flush against the photo.
     ================================================================ */
  .theinmag-editorial__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(20px, 2vw, 28px);
    margin-bottom: clamp(28px, 4vw, 56px);
    padding-left: clamp(8px, 3vw, 56px);
    padding-right: clamp(8px, 3vw, 56px);
  }

  @media (min-width: 750px) {
    .theinmag-editorial__intro {
      flex-direction: row;
      align-items: flex-end;
      /* Toggle sits just to the right of the wordmark rather than pushed
         to the far edge of the row (Ryan, 4 Jun). */
      justify-content: flex-start;
      gap: clamp(28px, 4vw, 56px);
    }
  }

  /* Wordmark wrap is shrink-fit so flex-end on subhead aligns to the
     RIGHT edge of the heading itself - i.e. under "side" - not to the
     full intro row width. */
  .theinmag-editorial__wordmark {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-end;
    width: max-content;
    max-width: 100%;
  }

  /* Heading composes four spans so the brand pun (capitalised IN) reads
     typographically: small "the" + big "IN" + small "side". Period span
     is supported but defaults blank for this surface. */
  .theinmag-editorial__heading {
    margin: 0;
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-size: clamp(80px, 11vw, 132px);
    line-height: 0.95;
    letter-spacing: 0;
    color: var(--color-inky-purple-navy, #2A1F3D);
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
  }

  .theinmag-editorial__heading-aux {
    font-size: 0.42em;
    line-height: 1;
    transform: translateY(-0.04em);
    margin: 0 0.04em;
  }

  .theinmag-editorial__heading-main,
  .theinmag-editorial__heading-period {
    font-size: 1em;
    line-height: 1;
  }

  .theinmag-editorial__heading-period {
    margin-left: -0.02em;
  }

  .theinmag-editorial__heading-logo {
    display: block;
    height: 1em;
    width: auto;
    flex: 0 0 auto;
  }

  /* Subhead tucks UP under the emphasis word (rightmost in the
     wordmark) - negative margin pulls it close to the baseline,
     flex-end on the parent right-aligns it. */
  .theinmag-editorial__subhead {
    margin: -0.6em 0.1em 0 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: clamp(14px, 1.4vw, 17px);
    line-height: 1.4;
    color: var(--color-inky-purple-navy, #2A1F3D);
    opacity: 0.78;
    text-align: right;
    max-width: 28ch;
  }

  /* ================================================================
     Audience toggle - text chips matching homepage feed pattern
     Inactive: opacity 0.42, regular weight. Active: full opacity, bold.
     ================================================================ */
  .theinmag-editorial__toggle {
    display: inline-flex;
    align-items: center;
    gap: clamp(14px, 2vw, 22px);
    flex-shrink: 0;
  }

  .theinmag-editorial__chip {
    background: none;
    border: 0;
    padding: 4px 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 500;
    font-size: clamp(20px, 2.4vw, 28px);
    line-height: 1;
    letter-spacing: -0.005em;
    color: var(--color-inky-purple-navy, #2A1F3D);
    opacity: 0.42;
    cursor: pointer;
    transition: opacity 0.15s ease, font-weight 0.15s ease;
  }

  .theinmag-editorial__chip:hover,
  .theinmag-editorial__chip:focus-visible {
    opacity: 0.85;
    outline: none;
  }

  .theinmag-editorial__chip:focus-visible {
    outline: 2px solid var(--color-purple-dark, #5D3A7A);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .theinmag-editorial__chip.is-active {
    opacity: 1;
    font-weight: 700;
  }

  /* ================================================================
     Card base
     ================================================================ */
  .theinmag-editorial__card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s ease, opacity 0.22s ease;
  }

  .theinmag-editorial__card:hover,
  .theinmag-editorial__card:focus-visible {
    transform: translateY(-4px);
    outline: none;
  }

  .theinmag-editorial__card[hidden] {
    display: none;
  }

  /* Slight drop shadow lifts each cover off the painterly bg so the
     images don't read as flat cutouts on the new top background. */
  /* Drop shadow lifts each cover off the painterly purple bg. Notably
     deepened (Ryan, 4 Jun) so the images read clearly against the
     lavender - applies to every card, including the faster-scrolling
     right column (same .card-cover class). */
  .theinmag-editorial__card-cover {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 8px;
    background-color: rgba(42, 31, 61, 0.18);
    box-shadow: 0 12px 28px rgba(20, 14, 30, 0.42), 0 4px 10px rgba(20, 14, 30, 0.28);
    transition: box-shadow 0.25s ease;
  }

  .theinmag-editorial__card:hover .theinmag-editorial__card-cover,
  .theinmag-editorial__card:focus-visible .theinmag-editorial__card-cover {
    box-shadow: 0 18px 38px rgba(20, 14, 30, 0.50), 0 5px 14px rgba(20, 14, 30, 0.32);
  }

  .theinmag-editorial__card-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  /* Kid-art covers (Real Kids Voices) anchor to the top so the subject's
     head stays in frame rather than being cropped by the cover fill. */
  .theinmag-editorial__card-image--top {
    object-position: top center;
  }

  .theinmag-editorial__card:hover .theinmag-editorial__card-image,
  .theinmag-editorial__card:focus-visible .theinmag-editorial__card-image {
    transform: scale(1.04);
  }

  .theinmag-editorial__card-placeholder {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #5D3A7A 0%, #C9543E 100%);
  }

  .theinmag-editorial__card-body {
    display: flex;
    flex-direction: column;
    gap: clamp(6px, 0.7vw, 10px);
    padding-top: clamp(14px, 1.6vw, 20px);
  }

  .theinmag-editorial__card-topic {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-purple-dark, #5D3A7A);
  }

  .theinmag-editorial__card-title {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: clamp(19px, 1.8vw, 24px);
    line-height: 1.18;
    letter-spacing: -0.01em;
    color: var(--color-inky-purple-navy, #2A1F3D);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .theinmag-editorial__card-excerpt {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--color-inky-purple-navy, #2A1F3D);
    opacity: 0.8;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ================================================================
     Feature card - full-width photo, white text overlay
     Padding-bottom on the title gives descenders (g, y, p) room before
     overflow:hidden clips them.
     ================================================================ */
  .theinmag-editorial__card--feature {
    margin-bottom: clamp(28px, 4vw, 56px);
  }

  .theinmag-editorial__card--feature .theinmag-editorial__card-cover {
    aspect-ratio: 16 / 9;
    border-radius: 12px;
  }

  @media (min-width: 750px) {
    .theinmag-editorial__card--feature .theinmag-editorial__card-cover {
      aspect-ratio: 21 / 9;
    }
  }

  .theinmag-editorial__card-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(20, 14, 30, 0.72) 0%,
      rgba(20, 14, 30, 0.32) 38%,
      rgba(20, 14, 30, 0) 65%
    );
    pointer-events: none;
  }

  .theinmag-editorial__card-overlay {
    position: absolute;
    left: clamp(20px, 3vw, 48px);
    right: clamp(20px, 3vw, 48px);
    bottom: clamp(24px, 3vw, 40px);
    display: flex;
    flex-direction: column;
    gap: clamp(8px, 1vw, 14px);
    color: #FFFFFF;
    max-width: 56ch;
  }

  .theinmag-editorial__card-topic--on-photo {
    color: #FFFFFF;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
  }

  .theinmag-editorial__card-title--on-photo {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: clamp(32px, 5.2vw, 56px);
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: #FFFFFF;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.4), 0 1px 2px rgba(0, 0, 0, 0.3);
    padding-bottom: 0.08em;
    -webkit-line-clamp: 3;
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
  }

  .theinmag-editorial__card-excerpt--on-photo {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: clamp(15px, 1.6vw, 18px);
    line-height: 1.5;
    color: #FFFFFF;
    opacity: 0.95;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
    padding-bottom: 0.1em;
    -webkit-line-clamp: 2;
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
  }

  /* ================================================================
     Grid: mobile single column, desktop 2/3 + 1/3
     ================================================================ */
  .theinmag-editorial__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(28px, 3vw, 40px);
  }

  @media (min-width: 990px) {
    .theinmag-editorial__grid {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      gap: clamp(40px, 5vw, 72px);
      align-items: start;
    }
  }

  .theinmag-editorial__col {
    min-width: 0;
  }

  .theinmag-editorial__col--left {
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 3vw, 44px);
  }

  /* Mobile: right col is a normal stack. Desktop overrides further
     down turn it into a clipping window for the parallax filmstrip. */
  .theinmag-editorial__col--right {
    display: block;
    position: relative;
  }

  .theinmag-editorial__col-inner {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* ================================================================
     Large left cards
     ================================================================ */
  .theinmag-editorial__card--large_left .theinmag-editorial__card-cover {
    aspect-ratio: 4 / 3;
  }

  /* Heading hierarchy (re-introduced 2026-05-22 per Ryan): the left
     column (large_left + bottom_small) sits a step larger than
     right_small so the left reads as the lead. The 18 May revert to a
     unified size was because the size gap shrank the right filmstrip
     vs the left column and threw the parallax pace; compensated here by
     bumping the right_small auto-pull count (5 -> 7) so the right column
     still out-heights the left and the parallax window stays filled. */
  .theinmag-editorial__card--large_left .theinmag-editorial__card-title {
    font-size: clamp(22px, 2.1vw, 27px);
  }

  /* ================================================================
     Bottom row - 2-up under the left column's large cards
     ================================================================ */
  .theinmag-editorial__bottom-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(24px, 3vw, 36px);
  }

  @media (min-width: 750px) {
    .theinmag-editorial__bottom-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .theinmag-editorial__card--bottom_small .theinmag-editorial__card-cover {
    aspect-ratio: 4 / 3;
  }

  .theinmag-editorial__card--bottom_small .theinmag-editorial__card-title {
    font-size: clamp(22px, 2.1vw, 27px);
    -webkit-line-clamp: 2;
  }

  .theinmag-editorial__card--bottom_small .theinmag-editorial__card-excerpt {
    -webkit-line-clamp: 2;
    font-size: 14px;
  }

  /* ================================================================
     Right column - up to 8 stacked small cards with hairline dividers.
     At desktop the column becomes a clipping window (overflow:hidden,
     fixed height = left column height) and the inner filmstrip
     translates upward as the section scrolls so denser content
     resolves through the same vertical band. Anything that escapes
     the window's top or bottom edge is clipped, never overlaps the
     hero above or leaves blank space below.
     ================================================================ */
  .theinmag-editorial__card--right_small {
    padding: clamp(18px, 1.8vw, 24px) 0;
  }

  .theinmag-editorial__card--right_small + .theinmag-editorial__card--right_small {
    border-top: 1px solid rgba(42, 31, 61, 0.18);
  }

  .theinmag-editorial__card--right_small:first-child {
    padding-top: 0;
  }

  .theinmag-editorial__card--right_small:last-child {
    padding-bottom: 0;
  }

  .theinmag-editorial__card--right_small .theinmag-editorial__card-cover {
    aspect-ratio: 16 / 10;
  }

  .theinmag-editorial__card--right_small .theinmag-editorial__card-title {
    font-size: clamp(18px, 1.6vw, 21px);
    -webkit-line-clamp: 2;
  }

  .theinmag-editorial__card--right_small .theinmag-editorial__card-excerpt {
    -webkit-line-clamp: 1;
    font-size: 14px;
  }

  @media (min-width: 990px) {
    .theinmag-editorial__col--right {
      overflow: hidden;
    }
    .theinmag-editorial__col-inner {
      will-change: transform;
    }
  }

  /* ================================================================
     Whoosh transition - audience toggle leaving state
     Cards fade out + slide a touch left on the way out, swap, then
     fade back in. Layout reflows naturally because we toggle [hidden].
     ================================================================ */
  .theinmag-editorial.is-audience-leaving .theinmag-editorial__card {
    opacity: 0;
    transform: translateX(-12px);
  }

  /* ================================================================
     Reduced motion
     ================================================================ */
  @media (prefers-reduced-motion: reduce) {
    .theinmag-editorial__card,
    .theinmag-editorial__card-image,
    .theinmag-editorial__col-inner {
      transition: none;
    }
    .theinmag-editorial__card:hover,
    .theinmag-editorial__card:focus-visible {
      transform: none;
    }
    .theinmag-editorial__card:hover .theinmag-editorial__card-image,
    .theinmag-editorial__card:focus-visible .theinmag-editorial__card-image {
      transform: none;
    }
    .theinmag-editorial__col-inner {
      transform: none !important;
    }
    .theinmag-editorial__col--right {
      overflow: visible !important;
      height: auto !important;
    }
    .theinmag-editorial.is-audience-leaving .theinmag-editorial__card {
      opacity: 1;
      transform: none;
    }
  }

  /* ================================================================
     Focus ring
     ================================================================ */
  .theinmag-editorial__card:focus-visible {
    outline: 3px solid var(--color-purple-dark, #5D3A7A);
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* Banner dedupe — hides editorial cards whose article matches the
     currently-visible audience banner. Toggled by the dedupe IIFE in
     the section's <script> block. */
  .theinmag-editorial__card--banner-dupe {
    display: none !important;
  }
{%- endstylesheet -%}

<script>
  (function () {
    var section = document.querySelector('[data-theinmag-editorial]');
    if (!section) return;

    var STORAGE_KEY = 'field-notes-audience';
    var EVENT_NAME = 'field-notes:audience-changed';
    var TRANSITION_MS = 240;
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var mql = window.matchMedia('(min-width: 990px)');

    var pools = Array.prototype.slice.call(section.querySelectorAll('[data-audience-pool]'));
    var poolByAudience = {};
    pools.forEach(function (p) {
      poolByAudience[p.dataset.audiencePool] = p;
    });

    /* ---------- Right-column parallax ----------------------------
       Pattern: each pool's right column wrapper is a clipping window
       pinned to its OWN left column's height. Inside sits a longer
       filmstrip of cards that translates upward as the section scrolls.
       Since only one pool is visible at a time (others are display:none
       via [hidden]), we bind to whichever pool is currently active and
       re-bind on audience change.
       --------------------------------------------------------- */
    var activeRightWrap = null;
    var activeRightInner = null;
    var activeLeftCol = null;
    var resizeObs = null;
    var ticking = false;

    function bindParallax(pool) {
      if (resizeObs) {
        try { resizeObs.disconnect(); } catch (e) {}
        resizeObs = null;
      }
      if (activeRightWrap) {
        activeRightWrap.style.height = '';
      }
      if (activeRightInner) {
        activeRightInner.style.transform = '';
      }
      activeRightWrap = pool ? pool.querySelector('[data-parallax-window]') : null;
      activeRightInner = pool ? pool.querySelector('[data-parallax-target]') : null;
      activeLeftCol = pool ? pool.querySelector('.theinmag-editorial__col--left') : null;

      if (!activeRightWrap || !activeRightInner || !activeLeftCol || reduced) return;

      if ('ResizeObserver' in window) {
        resizeObs = new ResizeObserver(function () {
          syncHeights();
          onScroll();
        });
        resizeObs.observe(activeLeftCol);
        resizeObs.observe(activeRightInner);
      }

      syncHeights();
      updateParallax();
    }

    function syncHeights() {
      if (!activeRightWrap || !activeLeftCol) return;
      if (!mql.matches) {
        activeRightWrap.style.height = '';
        if (activeRightInner) activeRightInner.style.transform = '';
        return;
      }
      var leftH = activeLeftCol.offsetHeight;
      if (leftH > 0) {
        activeRightWrap.style.height = leftH + 'px';
      }
    }

    function updateParallax() {
      ticking = false;
      if (!activeRightWrap || !activeRightInner) return;
      if (!mql.matches) {
        activeRightInner.style.transform = '';
        return;
      }
      /* Shifted-pinned: progress 0 when the wrapper TOP is still SHIFT
         pixels below the viewport top (parallax starts before the
         wrapper is fully pinned), reaches 1 when wrapper BOTTOM hits
         the viewport bottom. SHIFT bigger = earlier start, slower
         perceived speed. 0.3 * viewportH is Ryan's tuned middle. */
      var wRect = activeRightWrap.getBoundingClientRect();
      var wH = wRect.height;
      if (wH <= 0) return;
      var viewportH = window.innerHeight || document.documentElement.clientHeight;
      var SHIFT = viewportH * 0.3;
      var range = SHIFT + wH - viewportH;
      if (range <= 0) {
        activeRightInner.style.transform = '';
        return;
      }
      var raw = (SHIFT - wRect.top) / range;
      var progress = Math.max(0, Math.min(1, raw));
      var innerH = activeRightInner.offsetHeight;
      var maxOffset = Math.max(0, innerH - wH);
      var offset = progress * maxOffset;
      activeRightInner.style.transform = 'translate3d(0, ' + (-offset).toFixed(2) + 'px, 0)';
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(updateParallax);
    }

    function onResize() {
      syncHeights();
      onScroll();
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onResize);
    if (mql.addEventListener) mql.addEventListener('change', onResize);
    else if (mql.addListener) mql.addListener(onResize);

    /* ---------- Audience toggle ---------------------------------- */
    var toggle = section.querySelector('[data-field-notes-toggle]');
    var chips = toggle ? toggle.querySelectorAll('[data-audience]') : [];

    function syncChips(audience) {
      chips.forEach(function (chip) {
        chip.classList.toggle('is-active', chip.dataset.audience === audience);
      });
    }

    function showPool(audience) {
      var target = poolByAudience[audience] || poolByAudience['all'] || pools[0];
      pools.forEach(function (p) {
        p.hidden = (p !== target);
      });
      bindParallax(target);
    }

    function setAudience(audience, opts) {
      opts = opts || {};
      if (!poolByAudience[audience]) audience = 'all';
      syncChips(audience);
      try { localStorage.setItem(STORAGE_KEY, audience); } catch (e) {}
      document.documentElement.setAttribute('data-field-notes-audience', audience);

      if (opts.animate && !reduced) {
        section.classList.add('is-audience-leaving');
        setTimeout(function () {
          showPool(audience);
          window.requestAnimationFrame(function () {
            section.classList.remove('is-audience-leaving');
          });
        }, TRANSITION_MS);
      } else {
        showPool(audience);
      }

      if (opts.broadcast !== false) {
        window.dispatchEvent(new CustomEvent(EVENT_NAME, { detail: { audience: audience, animate: !!opts.animate } }));
      }
    }

    /* Init from localStorage if present */
    var initial = 'all';
    try { initial = localStorage.getItem(STORAGE_KEY) || 'all'; } catch (e) {}
    if (initial !== 'all' && initial !== 'kids' && initial !== 'adults') initial = 'all';
    setAudience(initial, { animate: false, broadcast: false });

    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        var audience = chip.dataset.audience;
        if (!audience) return;
        if (chip.classList.contains('is-active')) return;
        setAudience(audience, { animate: true });
      });
    });

    /* Listen for changes coming from other sections (e.g. a future
       sticky filter bar) so this toggle stays in sync. */
    window.addEventListener(EVENT_NAME, function (e) {
      if (!e || !e.detail) return;
      var audience = e.detail.audience;
      if (!audience) return;
      var current = chips.length ? Array.prototype.find.call(chips, function (c) { return c.classList.contains('is-active'); }) : null;
      if (current && current.dataset.audience === audience) return;
      setAudience(audience, { animate: !!e.detail.animate, broadcast: false });
    });

    /* Recompute parallax after image loads inside the active pool
       finish (offsetHeight grows as covers paint). */
    if (document.readyState === 'complete') {
      onResize();
    } else {
      window.addEventListener('load', onResize);
    }
  })();

  /* ================================================================
     Banner-vs-editorial dedupe (added 2026-05-18; simplified 2026-05-26)
     The audience banner section sits below the editorial grid and is
     curated to a specific article per audience. If that curated
     article also lands in the editorial auto-pull above, it reads as
     a duplicate. This IIFE hides matching editorial cards client-side
     after page render and on every audience-toggle change.

     Cross-section dedupe in Liquid isn't possible (each section has
     its own scope). Doing it client-side once the DOM is settled is
     the cleanest path - no Liquid restructure, automatic re-eval as
     the banner pick rotates.
     ================================================================ */
  (function () {
    var DEDUPE_CLASS = 'theinmag-editorial__card--banner-dupe';

    function getBannerHrefs() {
      var hrefs = {};
      var bannerCards = document.querySelectorAll(
        '.theinmag-feature-banner a[href], .theinmag-feature-banner article[data-audience]'
      );
      bannerCards.forEach(function (el) {
        var rect = el.getBoundingClientRect();
        var computed = window.getComputedStyle(el);
        var hidden = computed.display === 'none' || computed.visibility === 'hidden' || rect.width === 0;
        if (hidden) return;
        var href = el.getAttribute('href');
        if (href) hrefs[href] = true;
      });
      return hrefs;
    }

    function applyDedupe() {
      var hrefs = getBannerHrefs();
      /* Never dedupe the feature card - it's the page hero and the
         layout depends on it. If the banner happens to share its
         article, we'd rather render both (different crops, different
         treatments) than leave the editorial section header-less.
         Grid cards (large_left / bottom_small / right_small) still
         get deduped to avoid a duplicate-in-the-grid + duplicate-in-
         the-banner read. */
      var cards = document.querySelectorAll('[data-audience-pool] .theinmag-editorial__card:not(.theinmag-editorial__card--feature)');
      cards.forEach(function (card) {
        var href = card.getAttribute('href');
        if (href && hrefs[href]) {
          card.classList.add(DEDUPE_CLASS);
        } else {
          card.classList.remove(DEDUPE_CLASS);
        }
      });
    }

    function run() {
      // Tiny delay so the banner's own toggle handler finishes hiding
      // or showing panels before we read computed styles.
      window.setTimeout(applyDedupe, 50);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', run);
    } else {
      run();
    }

    window.addEventListener('field-notes:audience-changed', run);
  })();
</script>


