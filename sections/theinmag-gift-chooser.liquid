{%- comment -%}
  theinmag-gift-chooser
  The decision section of /pages/gifts. Three white cards on a warm
  wave-peach field (Print Membership, Digital Membership, a single
  mag), then a cream "how gifting works" panel with three numbered
  steps and a seasonal Christmas order-by line.

  Every price on this section is LIVE: the Membership variant prices
  come off all_products['membership'] and the single-mag card follows
  the highest-numbered issue whose PRINT variant is in stock and which
  is not a pre-order (the same rule as theinmag-funnel-strip), so it
  never headlines a sold-out issue and nothing here goes stale at a
  drop. No issue number, price or date is typed into copy.

  Yellow stamp appears once (the lead card). The other two cards use
  the outlined purple secondary so the hierarchy reads at a glance.
  Decision cards STACK on phones rather than riding a scroll rail:
  a buyer has to compare all three, and a rail hides two of them.

  Christmas line shows 1 Oct to 20 Dec only (same window as
  theinmag-faq-master's [christmas_line]); tighten the wording in
  both places once AusPost publishes the year's send-by dates.

  Design system: archetype 6.29 (gift chooser).
{%- endcomment -%}

{%- liquid
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign intro = section.settings.intro

  assign membership = all_products['membership']
  assign price_print_4 = ''
  assign price_print_8 = ''
  assign price_digital_4 = ''
  assign digital_image = blank
  for v in membership.variants
    if v.option1 == 'Print' and v.option2 == '4-Issue'
      assign price_print_4 = v.price | money_without_trailing_zeros
    elsif v.option1 == 'Print' and v.option2 == '8-Issue'
      assign price_print_8 = v.price | money_without_trailing_zeros
    elsif v.option1 == 'Digital' and v.option2 == '4-Issue'
      assign price_digital_4 = v.price | money_without_trailing_zeros
      if v.featured_image != blank
        assign digital_image = v.featured_image
      endif
    endif
  endfor
  assign print_image = membership.featured_image

  assign issues_collection = section.settings.issues_collection | default: 'single-issues'
  assign current_product = null
  assign current_best_num = 0
  assign current_price = ''
  for p in collections[issues_collection].products
    assign p_num = p.metafields.single_mag.issue_number.value | plus: 0
    assign p_pre = p.metafields.theinmag.is_pre_order | default: false
    if p_num > 0 and p_pre == false and p_num > current_best_num
      assign p_print_price = ''
      for v in p.variants
        assign vt = v.title | downcase
        if vt contains 'print' and v.available
          assign p_print_price = v.price | money_without_trailing_zeros
          break
        endif
      endfor
      if p_print_price != blank
        assign current_product = p
        assign current_best_num = p_num
        assign current_price = p_print_price
      endif
    endif
  endfor
  assign current_label = ''
  if current_product != blank
    assign current_label = current_product.title | split: ' - ' | last
  endif
  assign single_link = section.settings.single_link | default: '/pages/shop'

  assign lead_points = section.settings.lead_points | newline_to_br | split: '<br />'
  assign digital_points = section.settings.digital_points | newline_to_br | split: '<br />'
  assign single_points = section.settings.single_points | newline_to_br | split: '<br />'

  assign xmas_month = 'now' | date: '%m' | times: 1
  assign xmas_day = 'now' | date: '%d' | times: 1
  assign show_xmas = false
  if section.settings.show_xmas and section.settings.xmas_line != blank
    if xmas_month == 10 or xmas_month == 11
      assign show_xmas = true
    elsif xmas_month == 12 and xmas_day <= 20
      assign show_xmas = true
    endif
  endif

  assign section_style = '--tgc-pt: ' | append: section.settings.padding_top | append: 'px; --tgc-pb: ' | append: section.settings.padding_bottom | append: 'px;'
-%}

<section
  class="theinmag-gift-chooser"
  data-theinmag-gift-chooser
  aria-labelledby="theinmag-gift-chooser-heading"
  style="{{ section_style }}"
>
  <div class="theinmag-gift-chooser__inner">

    <header class="theinmag-gift-chooser__head">
      {%- if eyebrow != blank -%}
        <p class="theinmag-gift-chooser__eyebrow">{{ eyebrow }}</p>
      {%- endif -%}
      <h2 id="theinmag-gift-chooser-heading" class="theinmag-gift-chooser__heading">{{ heading }}</h2>
      {%- if intro != blank -%}
        <p class="theinmag-gift-chooser__intro">{{ intro }}</p>
      {%- endif -%}
    </header>

    <ul class="theinmag-gift-chooser__cards" role="list">

      <li class="theinmag-gift-chooser__card theinmag-gift-chooser__card--lead">
        <div class="theinmag-gift-chooser__media">
          {%- if print_image != blank -%}
            <img
              src="{{ print_image | image_url: width: 900 }}"
              srcset="{{ print_image | image_url: width: 480 }} 480w, {{ print_image | image_url: width: 900 }} 900w, {{ print_image | image_url: width: 1200 }} 1200w"
              sizes="(min-width: 990px) 30vw, 100vw"
              width="{{ print_image.width }}"
              height="{{ print_image.height }}"
              alt="{{ section.settings.lead_image_alt | escape }}"
              loading="lazy"
            >
          {%- endif -%}
        </div>
        <div class="theinmag-gift-chooser__body">
          <p class="theinmag-gift-chooser__card-eyebrow">{{ section.settings.lead_eyebrow }}</p>
          <h3 class="theinmag-gift-chooser__card-title">{{ section.settings.lead_title }}</h3>
          {%- if price_print_4 != blank -%}
            <p class="theinmag-gift-chooser__price">
              <strong class="theinmag-gift-chooser__amount">{{ price_print_4 }}</strong>
              <span class="theinmag-gift-chooser__price-note">for 4 mags, shipping included</span>
              {%- if price_print_8 != blank -%}
                <span class="theinmag-gift-chooser__price-alt">or {{ price_print_8 }} for 8</span>
              {%- endif -%}
            </p>
          {%- endif -%}
          <ul class="theinmag-gift-chooser__points" role="list">
            {%- for point in lead_points -%}
              {%- assign pt = point | strip -%}
              {%- if pt != blank -%}<li>{{ pt }}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
          <a class="theinmag-btn theinmag-btn--primary theinmag-gift-chooser__cta" href="/products/membership?fmt=Print&length=4-Issue">{{ section.settings.lead_cta }}</a>
        </div>
      </li>

      <li class="theinmag-gift-chooser__card">
        <div class="theinmag-gift-chooser__media">
          {%- if digital_image != blank -%}
            <img
              src="{{ digital_image | image_url: width: 900 }}"
              srcset="{{ digital_image | image_url: width: 480 }} 480w, {{ digital_image | image_url: width: 900 }} 900w, {{ digital_image | image_url: width: 1200 }} 1200w"
              sizes="(min-width: 990px) 30vw, 100vw"
              width="{{ digital_image.width }}"
              height="{{ digital_image.height }}"
              alt="{{ section.settings.digital_image_alt | escape }}"
              loading="lazy"
            >
          {%- endif -%}
        </div>
        <div class="theinmag-gift-chooser__body">
          <p class="theinmag-gift-chooser__card-eyebrow">{{ section.settings.digital_eyebrow }}</p>
          <h3 class="theinmag-gift-chooser__card-title">{{ section.settings.digital_title }}</h3>
          {%- if price_digital_4 != blank -%}
            <p class="theinmag-gift-chooser__price">
              <strong class="theinmag-gift-chooser__amount">{{ price_digital_4 }}</strong>
              <span class="theinmag-gift-chooser__price-note">for 4 mags, emailed</span>
            </p>
          {%- endif -%}
          <ul class="theinmag-gift-chooser__points" role="list">
            {%- for point in digital_points -%}
              {%- assign pt = point | strip -%}
              {%- if pt != blank -%}<li>{{ pt }}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
          <a class="theinmag-btn theinmag-btn--secondary theinmag-gift-chooser__cta" href="/products/membership?fmt=Digital&length=4-Issue">{{ section.settings.digital_cta }}</a>
        </div>
      </li>

      <li class="theinmag-gift-chooser__card">
        <div class="theinmag-gift-chooser__media">
          {%- if current_product != blank and current_product.featured_image != blank -%}
            {%- assign single_image = current_product.featured_image -%}
            <img
              src="{{ single_image | image_url: width: 900 }}"
              srcset="{{ single_image | image_url: width: 480 }} 480w, {{ single_image | image_url: width: 900 }} 900w, {{ single_image | image_url: width: 1200 }} 1200w"
              sizes="(min-width: 990px) 30vw, 100vw"
              width="{{ single_image.width }}"
              height="{{ single_image.height }}"
              alt="{{ current_product.featured_image.alt | default: current_product.title | escape }}"
              loading="lazy"
            >
          {%- endif -%}
        </div>
        <div class="theinmag-gift-chooser__body">
          <p class="theinmag-gift-chooser__card-eyebrow">{{ section.settings.single_eyebrow }}</p>
          <h3 class="theinmag-gift-chooser__card-title">{{ section.settings.single_title }}</h3>
          {%- if current_price != blank -%}
            <p class="theinmag-gift-chooser__price">
              <strong class="theinmag-gift-chooser__amount">{{ current_price }}</strong>
              <span class="theinmag-gift-chooser__price-note">{{ current_label }} in print, posted now</span>
            </p>
          {%- endif -%}
          <ul class="theinmag-gift-chooser__points" role="list">
            {%- for point in single_points -%}
              {%- assign pt = point | strip -%}
              {%- if pt != blank -%}<li>{{ pt }}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
          <a class="theinmag-btn theinmag-btn--secondary theinmag-gift-chooser__cta" href="{{ single_link }}">{{ section.settings.single_cta }}</a>
        </div>
      </li>

    </ul>

    <div class="theinmag-gift-chooser__how">
      <h3 class="theinmag-gift-chooser__how-heading">{{ section.settings.how_heading }}</h3>
      <ol class="theinmag-gift-chooser__steps">
        {%- for i in (1..3) -%}
          {%- liquid
            assign t_key = 'step_' | append: i | append: '_title'
            assign b_key = 'step_' | append: i | append: '_body'
            assign step_title = section.settings[t_key]
            assign step_body = section.settings[b_key]
          -%}
          {%- if step_title != blank -%}
            <li class="theinmag-gift-chooser__step">
              <span class="theinmag-gift-chooser__step-num" aria-hidden="true">{{ i }}</span>
              <div class="theinmag-gift-chooser__step-copy">
                <strong class="theinmag-gift-chooser__step-title">{{ step_title }}</strong>
                {%- if step_body != blank -%}
                  <p class="theinmag-gift-chooser__step-body">{{ step_body }}</p>
                {%- endif -%}
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
      {%- if show_xmas -%}
        <p class="theinmag-gift-chooser__note">{{ section.settings.xmas_line }}</p>
      {%- endif -%}
    </div>

  </div>
</section>

{%- stylesheet -%}
  .theinmag-gift-chooser {
    background-color: var(--color-wave-peach);
    color: var(--color-inky-purple-navy);
    padding: var(--tgc-pt, 72px) clamp(20px, 5vw, 64px) var(--tgc-pb, 72px);
    position: relative;
  }

  .theinmag-gift-chooser__inner {
    max-width: 1180px;
    margin: 0 auto;
  }

  .theinmag-gift-chooser__head {
    text-align: center;
    max-width: 640px;
    margin: 0 auto clamp(28px, 4vw, 44px);
  }

  .theinmag-gift-chooser__eyebrow {
    margin: 0 0 10px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(42, 31, 61, 0.72);
  }

  .theinmag-gift-chooser__heading {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(26px, 4.5vw, 40px);
    line-height: 1.15;
    font-synthesis: none;
    text-wrap: balance;
  }

  .theinmag-gift-chooser__intro {
    margin: 12px auto 0;
    font-family: var(--font-body);
    font-size: clamp(16px, 1.7vw, 18px);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .theinmag-gift-chooser__cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 18px;
  }

  .theinmag-gift-chooser__card {
    display: flex;
    flex-direction: column;
    background-color: #FFFFFF;
    border-radius: var(--radius-xl);
    border: 2px solid transparent;
    box-shadow: 0 6px 24px rgba(42, 31, 61, 0.08);
    overflow: hidden;
    transition: transform var(--transition-hover), box-shadow var(--transition-hover);
  }

  .theinmag-gift-chooser__card--lead {
    border-color: var(--color-soft-pink);
  }

  .theinmag-gift-chooser__media {
    background-color: var(--color-cream);
  }

  .theinmag-gift-chooser__media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .theinmag-gift-chooser__body {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    padding: 20px 20px 24px;
    font-family: var(--font-body);
  }

  .theinmag-gift-chooser__card-eyebrow {
    margin: 0 0 6px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-purple-dark);
  }

  .theinmag-gift-chooser__card-title {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(20px, 2.2vw, 24px);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .theinmag-gift-chooser__price {
    margin: 12px 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 10px;
    font-size: 15px;
    line-height: 1.4;
  }

  .theinmag-gift-chooser__amount {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 1.9em;
    line-height: 0.9;
    letter-spacing: -0.01em;
    font-synthesis: none;
  }

  .theinmag-gift-chooser__price-note {
    color: rgba(42, 31, 61, 0.78);
  }

  .theinmag-gift-chooser__price-alt {
    flex-basis: 100%;
    font-size: 13.5px;
    color: rgba(42, 31, 61, 0.62);
  }

  .theinmag-gift-chooser__points {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    gap: 8px;
    font-size: 15px;
    line-height: 1.5;
  }

  .theinmag-gift-chooser__points li {
    position: relative;
    padding-left: 24px;
  }

  .theinmag-gift-chooser__points li::before {
    content: "\2713";
    position: absolute;
    left: 0;
    top: 0;
    font-weight: 700;
    color: var(--color-sage-dark);
  }

  .theinmag-gift-chooser__cta {
    margin-top: auto;
    padding-top: 0;
  }

  .theinmag-gift-chooser__body .theinmag-gift-chooser__cta {
    margin-top: 22px;
    width: 100%;
    justify-content: center;
    text-align: center;
  }

  .theinmag-gift-chooser__how {
    max-width: 760px;
    margin: clamp(28px, 4vw, 44px) auto 0;
    padding: clamp(22px, 3vw, 32px) clamp(20px, 3vw, 32px);
    background-color: var(--color-cream);
    border-radius: var(--radius-xl);
    font-family: var(--font-body);
  }

  .theinmag-gift-chooser__how-heading {
    margin: 0 0 16px;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(22px, 3vw, 28px);
    line-height: 1.15;
    font-synthesis: none;
  }

  .theinmag-gift-chooser__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }

  .theinmag-gift-chooser__step {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
  }

  .theinmag-gift-chooser__step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-pill);
    background-color: var(--color-peach);
    font-family: var(--font-heading);
    font-size: 20px;
    line-height: 1;
    font-synthesis: none;
  }

  .theinmag-gift-chooser__step-title {
    display: block;
    font-weight: 700;
    font-size: 16px;
    line-height: 1.35;
    padding-top: 7px;
  }

  .theinmag-gift-chooser__step-body {
    margin: 4px 0 0;
    font-size: 15px;
    line-height: 1.55;
    color: rgba(42, 31, 61, 0.84);
  }

  .theinmag-gift-chooser__step-body a,
  .theinmag-gift-chooser__note a {
    color: var(--color-teal-dark);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .theinmag-gift-chooser__note {
    margin: 18px 0 0;
    padding-top: 14px;
    border-top: 1px solid rgba(42, 31, 61, 0.12);
    font-size: 14.5px;
    line-height: 1.55;
    color: rgba(42, 31, 61, 0.84);
  }

  @media (min-width: 750px) {
    .theinmag-gift-chooser .theinmag-gift-chooser__steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }
  }

  @media (min-width: 990px) {
    .theinmag-gift-chooser .theinmag-gift-chooser__cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 22px;
      align-items: stretch;
    }

    .theinmag-gift-chooser .theinmag-gift-chooser__body {
      padding: 24px 24px 28px;
    }
  }

  @media (hover: hover) {
    .theinmag-gift-chooser .theinmag-gift-chooser__card:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 32px rgba(42, 31, 61, 0.12);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-gift-chooser .theinmag-gift-chooser__card,
    .theinmag-gift-chooser .theinmag-gift-chooser__card:hover {
      transform: none;
      transition: none;
    }
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "Gift chooser",
  "tag": "section",
  "class": "theinmag-gift-chooser-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Prices and the single-mag issue are read live from the products. Nothing here needs editing at a drop."
    },
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Pick the gift" },
    { "type": "text", "id": "heading", "label": "Heading (question form)", "default": "Which gift suits them?" },
    { "type": "textarea", "id": "intro", "label": "Intro line", "default": "Three ways to give it. Every one is made by Aussie kids, ad-free, and theirs to keep." },
    { "type": "header", "content": "Card 1: Print Membership (yellow)" },
    { "type": "text", "id": "lead_eyebrow", "label": "Eyebrow", "default": "Most gift-givers pick this" },
    { "type": "text", "id": "lead_title", "label": "Title", "default": "Print Membership" },
    { "type": "textarea", "id": "lead_points", "label": "Points (one per line)", "default": "Posted to the child in February, June and October\nArrives with their name on it\nYour message goes in with the first mag" },
    { "type": "text", "id": "lead_cta", "label": "Button label", "default": "Give a Print Membership" },
    { "type": "text", "id": "lead_image_alt", "label": "Image alt text", "default": "A hand holding a fanned stack of printed theINmag issues." },
    { "type": "header", "content": "Card 2: Digital Membership" },
    { "type": "text", "id": "digital_eyebrow", "label": "Eyebrow", "default": "Last-minute? Emailed in minutes" },
    { "type": "text", "id": "digital_title", "label": "Title", "default": "Digital Membership" },
    { "type": "textarea", "id": "digital_points", "label": "Points (one per line)", "default": "The current issue lands in your inbox within minutes\nForward it, or print a page to tuck into the card\nA new issue each drop, on any screen" },
    { "type": "text", "id": "digital_cta", "label": "Button label", "default": "Give a Digital Membership" },
    { "type": "text", "id": "digital_image_alt", "label": "Image alt text", "default": "Two kids reading a digital issue of theINmag on a tablet." },
    { "type": "header", "content": "Card 3: single mag (live issue)" },
    { "type": "text", "id": "single_eyebrow", "label": "Eyebrow", "default": "Try one first" },
    { "type": "text", "id": "single_title", "label": "Title", "default": "A single mag" },
    { "type": "textarea", "id": "single_points", "label": "Points (one per line)", "default": "A real magazine to wrap\nPosts within three business days\nEvery page by a real Aussie kid" },
    { "type": "text", "id": "single_cta", "label": "Button label", "default": "Shop single mags" },
    { "type": "text", "id": "single_link", "label": "Button link", "default": "/pages/shop", "info": "Relative URL. The card itself follows the newest issue whose print run is in stock." },
    { "type": "text", "id": "issues_collection", "label": "Issues collection handle", "default": "single-issues" },
    { "type": "header", "content": "How gifting works" },
    { "type": "text", "id": "how_heading", "label": "Heading", "default": "How gifting works" },
    { "type": "text", "id": "step_1_title", "label": "Step 1 title", "default": "Choose print or digital" },
    { "type": "inline_richtext", "id": "step_1_body", "label": "Step 1 body", "default": "Print posts to the child. Digital is emailed to you within minutes." },
    { "type": "text", "id": "step_2_title", "label": "Step 2 title", "default": "Use the child's address for delivery" },
    { "type": "inline_richtext", "id": "step_2_body", "label": "Step 2 body", "default": "Your own address goes in as billing. Every mag then arrives with their name on it." },
    { "type": "text", "id": "step_3_title", "label": "Step 3 title", "default": "Add your message at the cart" },
