{%- comment -%}
  theinmag-contact-form
  Section 2 of /pages/contact. Two-column on desktop:
    Left  (~55%) - H2 + paragraph + Shopify-native contact form
    Right (~45%) - van photo + caption
  Mobile stacks form first, image below.

  Form uses Shopify {% form 'contact' %} so submissions route to the
  store's notification email (heyhey@theinmag.com.au, set in admin
  Settings -> Notifications).

  Three fields only: name, email, message. No phone. No surname.
  Honeypot bot trap is a hidden field; JS blocks submission if filled.

  States:
    - Default:                        form visible
    - form.posted_successfully?:      form REPLACED with thank-you block
    - form.errors:                    error messages above the form,
                                      form values preserved (Shopify
                                      auto-preserves form.name,
                                      form.email, form.body)

  Van image: section setting takes precedence; if blank, fall back to
  filename theinmag-van-contact.jpg (Ryan drops the file in /assets/).
  If neither resolves to a real asset the <img> onerror swaps in a
  styled placeholder so the page never shows a broken image.
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading
  assign intro = section.settings.intro_html
  assign submit_label = section.settings.submit_label
  assign image = section.settings.image
  assign image_filename = section.settings.image_filename | strip
  assign image_alt = section.settings.image_alt

  assign success_heading = section.settings.success_heading
  assign success_body = section.settings.success_body
  assign success_cta_label = section.settings.success_cta_label
  assign success_cta_url = section.settings.success_cta_url
  assign success_secondary_label = section.settings.success_secondary_label

  assign router_heading = section.settings.router_heading
  assign t1_label = section.settings.t1_label
  assign t1_url = section.settings.t1_url
  assign t2_label = section.settings.t2_label
  assign t2_url = section.settings.t2_url
  assign t3_label = section.settings.t3_label
  assign t3_url = section.settings.t3_url

  assign instagram_url = section.settings.instagram_url
  assign instagram_handle = section.settings.instagram_handle
  assign facebook_url = section.settings.facebook_url
  assign facebook_handle = section.settings.facebook_handle

  assign section_style = '--ctf-pt: ' | append: section.settings.padding_top | append: 'px; --ctf-pb: ' | append: section.settings.padding_bottom | append: 'px;'
-%}

<section
  class="theinmag-contact-form"
  data-theinmag-contact-form
  aria-labelledby="theinmag-contact-form-heading"
  style="{{ section_style }}"
>
  <div class="theinmag-contact-form__inner">

    <div class="theinmag-contact-form__col theinmag-contact-form__col--form">
      {%- form 'contact', id: 'theinmag-contact-form-element', class: 'theinmag-contact-form__form' -%}
        {%- if form.posted_successfully? -%}
          {%- comment -%} Thank-you block - replaces the form in the same column {%- endcomment -%}
          <div class="theinmag-contact-form__thanks" tabindex="-1" autofocus>
            <div class="theinmag-contact-form__thanks-icon" aria-hidden="true">
              <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" focusable="false">
                <circle cx="32" cy="32" r="32" fill="#F9C23C"/>
                <path d="M19 33.5 L28 42 L46 23" fill="none" stroke="#2A1F3D" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            {%- if success_heading != blank -%}
              <h2 class="theinmag-contact-form__thanks-heading">{{ success_heading }}</h2>
            {%- endif -%}
            {%- if success_body != blank -%}
              <p class="theinmag-contact-form__thanks-body">{{ success_body }}</p>
            {%- endif -%}
            {%- if success_cta_label != blank and success_cta_url != blank -%}
              <a class="theinmag-btn theinmag-btn--primary theinmag-contact-form__thanks-cta" href="{{ success_cta_url }}">{{ success_cta_label }}</a>
            {%- endif -%}
            {%- if success_secondary_label != blank -%}
              <a class="theinmag-contact-form__thanks-back" href="{{ page.url | default: '/pages/contact' }}">{{ success_secondary_label }}</a>
            {%- endif -%}
          </div>
        {%- else -%}
          <header class="theinmag-contact-form__header">
            {%- if heading != blank -%}
              <h2 id="theinmag-contact-form-heading" class="theinmag-contact-form__heading">{{ heading }}</h2>
            {%- endif -%}
            {%- if intro != blank -%}
              <div class="theinmag-contact-form__intro">{{ intro }}</div>
            {%- endif -%}
          </header>

          {%- if form.errors -%}
            <div class="theinmag-contact-form__errors" role="alert" tabindex="-1" autofocus>
              <p class="theinmag-contact-form__errors-heading">We couldn't send your message just yet:</p>
              <ul class="theinmag-contact-form__errors-list">
                {%- for field in form.errors -%}
                  <li>
                    {%- assign translated = form.errors.translated_fields[field] | default: field -%}
                    {{ translated | capitalize }} {{ form.errors.messages[field] }}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <div class="theinmag-contact-form__field">
            <label class="theinmag-contact-form__label" for="theinmag-contact-form-name">First name <span class="theinmag-contact-form__required" aria-hidden="true">*</span></label>
            <input
              class="theinmag-contact-form__input"
              type="text"
              id="theinmag-contact-form-name"
              name="contact[name]"
              autocomplete="given-name"
              required
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.first_name }}{% endif %}"
            >
          </div>

          <div class="theinmag-contact-form__field">
            <label class="theinmag-contact-form__label" for="theinmag-contact-form-email">Email <span class="theinmag-contact-form__required" aria-hidden="true">*</span></label>
            <input
              class="theinmag-contact-form__input"
              type="email"
              id="theinmag-contact-form-email"
              name="contact[email]"
              autocomplete="email"
              spellcheck="false"
              autocapitalize="off"
              required
              aria-required="true"
              {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            >
          </div>

          <div class="theinmag-contact-form__field">
            <label class="theinmag-contact-form__label" for="theinmag-contact-form-body">Message <span class="theinmag-contact-form__required" aria-hidden="true">*</span></label>
            <textarea
              class="theinmag-contact-form__input theinmag-contact-form__textarea"
              id="theinmag-contact-form-body"
              name="contact[body]"
              rows="5"
              required
            >{{ form.body }}</textarea>
          </div>

          {%- comment -%}
            Honeypot. Visually-hidden + autocomplete="off" + tabindex=-1
            so humans never reach it; bots auto-fill, JS blocks submit.
            Field name is generic so the email line reads naturally if
            anything ever does sneak through.
          {%- endcomment -%}
          <div class="theinmag-contact-form__honeypot" aria-hidden="true">
            <label for="theinmag-contact-form-website">Leave this field empty</label>
            <input type="text" id="theinmag-contact-form-website" name="contact[website]" tabindex="-1" autocomplete="off">
          </div>

          <div class="theinmag-contact-form__submit-row">
            <button type="submit" class="theinmag-btn theinmag-btn--secondary theinmag-contact-form__submit">{{ submit_label | default: 'Send it' }}</button>

            {%- if instagram_url != blank or facebook_url != blank -%}
              <ul class="theinmag-contact-form__socials" role="list" aria-label="Follow theINmag">
                {%- if instagram_url != blank -%}
                  <li>
                    <a
                      class="theinmag-contact-form__social-icon theinmag-contact-form__social-icon--instagram"
                      href="{{ instagram_url }}"
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label="theINmag on Instagram{% if instagram_handle != blank %} ({{ instagram_handle }}){% endif %}"
                    >
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" focusable="false">
                        <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                        <circle cx="12" cy="12" r="4"></circle>
                        <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"></circle>
                      </svg>
                    </a>
                  </li>
                {%- endif -%}
                {%- if facebook_url != blank -%}
                  <li>
                    <a
                      class="theinmag-contact-form__social-icon theinmag-contact-form__social-icon--facebook"
                      href="{{ facebook_url }}"
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label="theINmag on Facebook{% if facebook_handle != blank %} ({{ facebook_handle }}){% endif %}"
                    >
                      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                        <path d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.7c0-.9.3-1.5 1.6-1.5h1.7V4.3a23 23 0 0 0-2.5-.1c-2.5 0-4.2 1.5-4.2 4.3v2.4H7.4V14h2.7v8h3.4Z"></path>
                      </svg>
                    </a>
                  </li>
                {%- endif -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>

    <div class="theinmag-contact-form__col theinmag-contact-form__col--side">
      <div class="theinmag-contact-form__image-wrap">
        {%- if image != blank -%}
          {{ image | image_url: width: 1200 | image_tag:
            loading: 'lazy',
            widths: '400, 600, 800, 1000, 1200',
            sizes: '(min-width: 990px) 45vw, 90vw',
            class: 'theinmag-contact-form__image',
            alt: image_alt
          }}
        {%- elsif image_filename != blank -%}
          <img
            class="theinmag-contact-form__image"
            src="{{ image_filename | asset_url }}"
            alt="{{ image_alt | escape }}"
            loading="lazy"
            onerror="this.style.display='none';var p=this.parentElement.querySelector('.theinmag-contact-form__image-placeholder');if(p)p.style.display='flex';"
          >
          <div class="theinmag-contact-form__image-placeholder" role="img" aria-label="{{ image_alt | escape }}">
            <span class="theinmag-contact-form__image-placeholder-eyebrow">theINmag HQ</span>
            <span class="theinmag-contact-form__image-placeholder-body">Van photo coming soon.</span>
          </div>
        {%- else -%}
          <div class="theinmag-contact-form__image-placeholder theinmag-contact-form__image-placeholder--shown" role="img" aria-label="theINmag van placeholder">
            <span class="theinmag-contact-form__image-placeholder-eyebrow">theINmag HQ</span>
            <span class="theinmag-contact-form__image-placeholder-body">Van photo coming soon.</span>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%}
        Router (specialist enquiries) and socials live INSIDE the form
        section's right column so the whole page sits on one viewport on
        desktop. Drop the standalone theinmag-contact-router /
        theinmag-contact-social sections from page.contact.json - they
        still exist on disk for any other page that might want them.
      {%- endcomment -%}

      {%- if router_heading != blank or t1_label != blank or t2_label != blank or t3_label != blank -%}
        <div class="theinmag-contact-form__router" aria-labelledby="theinmag-contact-form-router-heading">
          {%- if router_heading != blank -%}
            <h3 id="theinmag-contact-form-router-heading" class="theinmag-contact-form__router-heading">{{ router_heading }}</h3>
          {%- endif -%}
          <ul class="theinmag-contact-form__router-tiles" role="list">
            {%- if t1_label != blank and t1_url != blank -%}
              <li>
                <a class="theinmag-contact-form__router-tile" href="{{ t1_url }}">
                  <span class="theinmag-contact-form__router-tile-label">{{ t1_label }}</span>
                  <span class="theinmag-contact-form__router-tile-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            {%- endif -%}
            {%- if t2_label != blank and t2_url != blank -%}
              <li>
                <a class="theinmag-contact-form__router-tile" href="{{ t2_url }}">
                  <span class="theinmag-contact-form__router-tile-label">{{ t2_label }}</span>
                  <span class="theinmag-contact-form__router-tile-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            {%- endif -%}
            {%- if t3_label != blank and t3_url != blank -%}
              <li>
                <a class="theinmag-contact-form__router-tile" href="{{ t3_url }}">
                  <span class="theinmag-contact-form__router-tile-label">{{ t3_label }}</span>
                  <span class="theinmag-contact-form__router-tile-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            {%- endif -%}
          </ul>
        </div>
      {%- endif -%}

    </div>

  </div>
</section>

{%- stylesheet -%}
  /* ================================================================
     theinmag-contact-form
     Cream pair surface (workhorse). Two-column from 990px, single
     column on mobile with form first, image below.
     ================================================================ */

  .theinmag-contact-form {
    background-color: var(--color-cream, #FBF6EA);
    color: var(--color-inky-purple-navy, #2A1F3D);
    padding: var(--ctf-pt, 56px) clamp(16px, 4vw, 32px) var(--ctf-pb, 56px);
    position: relative;
  }

  @media (min-width: 750px) {
    .theinmag-contact-form {
      padding-top: calc(var(--ctf-pt, 56px) * 1.2);
      padding-bottom: calc(var(--ctf-pb, 56px) * 1.2);
    }
  }

  .theinmag-contact-form__inner {
    max-width: 1180px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 4vw, 40px);
  }

  @media (min-width: 990px) {
    .theinmag-contact-form__inner {
      flex-direction: row;
      align-items: flex-start;
      gap: clamp(32px, 4vw, 56px);
    }

    .theinmag-contact-form .theinmag-contact-form__col--form { flex: 0 0 55%; min-width: 0; }
    .theinmag-contact-form .theinmag-contact-form__col--side { flex: 0 0 45%; min-width: 0; }
  }

  /* Right column stack - van photo, then specialist router, then social.
     Spacing tight so the page comfortably fits one viewport on desktop. */
  .theinmag-contact-form__col--side {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 2.4vw, 28px);
  }

  /* ----- Form column ---------------------------------------------- */

  .theinmag-contact-form__form {
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 1.6vw, 18px);
  }

  .theinmag-contact-form__header {
    margin-bottom: clamp(4px, 0.6vw, 8px);
  }

  .theinmag-contact-form__heading {
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-size: clamp(28px, 4vw, 38px);
    line-height: 1.1;
    letter-spacing: 0;
    margin: 0 0 clamp(10px, 1.2vw, 14px);
    color: var(--color-inky-purple-navy, #2A1F3D);
    text-wrap: balance;
  }

  .theinmag-contact-form__intro {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-size: clamp(16px, 1.4vw, 17px);
    line-height: 1.6;
    color: var(--color-inky-purple-navy, #2A1F3D);
    opacity: 0.92;
  }

  .theinmag-contact-form__intro p { margin: 0; }

  .theinmag-contact-form__intro a {
    color: var(--color-purple-dark, #5D3A7A);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    transition: color var(--transition-standard, 0.15s ease), text-decoration-thickness var(--transition-standard, 0.15s ease);
  }

  .theinmag-contact-form__intro a:hover,
  .theinmag-contact-form__intro a:focus-visible {
    color: var(--color-purple-dark, #5D3A7A);
    text-decoration-thickness: 2px;
    outline: none;
  }

  /* Errors panel */
  .theinmag-contact-form__errors {
    background-color: #FBE0D6;
    color: #8B2D1A;
    border-radius: var(--radius-md, 12px);
    padding: clamp(12px, 1.6vw, 16px) clamp(14px, 1.8vw, 18px);
    border-left: 4px solid var(--color-coral-dark, #C9543E);
  }

  .theinmag-contact-form__errors-heading {
    margin: 0 0 6px;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: 15px;
  }

  .theinmag-contact-form__errors-list {
    margin: 0;
    padding-left: 18px;
    font-size: 14px;
    line-height: 1.5;
  }

  /* Field row */
  .theinmag-contact-form__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .theinmag-contact-form__label {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.01em;
    color: var(--color-inky-purple-navy, #2A1F3D);
  }

  .theinmag-contact-form__required {
    color: var(--color-coral-dark, #C9543E);
    margin-left: 2px;
  }

  .theinmag-contact-form__input {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-size: 16px;
    line-height: 1.5;
    color: var(--color-inky-purple-navy, #2A1F3D);
    background-color: #FFFFFF;
    border: 1.5px solid rgba(42, 31, 61, 0.15);
    border-radius: var(--radius-md, 12px);
    padding: 12px 14px;
    width: 100%;
    box-sizing: border-box;
    transition: border-color var(--transition-standard, 0.15s ease), box-shadow var(--transition-standard, 0.15s ease);
    -webkit-appearance: none;
    appearance: none;
  }

  .theinmag-contact-form__input:focus,
  .theinmag-contact-form__input:focus-visible {
    border-color: var(--color-purple-dark, #5D3A7A);
    outline: none;
    box-shadow: 0 0 0 3px rgba(93, 58, 122, 0.15);
  }

  .theinmag-contact-form__input[aria-invalid="true"] {
    border-color: var(--color-coral-dark, #C9543E);
  }

  .theinmag-contact-form__textarea {
    resize: vertical;
    min-height: 130px;
    line-height: 1.55;
  }

  /* Honeypot - off-screen, untabbable, screen-reader-skippable */
  .theinmag-contact-form__honeypot {
    position: absolute;
    left: -10000px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* Submit row - button on the left, social icons on the right. Stays
     in a row even on mobile (icons are small and the layout shrinks
     with the parent). */
  .theinmag-contact-form__submit-row {
    margin-top: clamp(6px, 0.8vw, 10px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(12px, 2vw, 20px);
    flex-wrap: wrap;
  }

  /* Specificity prefix on the submit so it overrides the base button's
     min-height/padding only inside this form context. (Pattern library
     §3.1 - prefix mobile/special rules with the section root class.) */
  .theinmag-contact-form .theinmag-contact-form__submit {
    min-width: 160px;
  }

  .theinmag-contact-form__socials {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .theinmag-contact-form__social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill, 9999px);
    color: #FFFFFF;
    text-decoration: none;
    transition: transform var(--transition-hover, 0.2s ease),
                box-shadow var(--transition-hover, 0.2s ease),
                filter var(--transition-hover, 0.2s ease);
    box-shadow: 0 3px 10px rgba(42, 31, 61, 0.12);
  }

  .theinmag-contact-form__social-icon svg {
    width: 22px;
    height: 22px;
    display: block;
  }

  .theinmag-contact-form__social-icon:hover,
  .theinmag-contact-form__social-icon:focus-visible {
    transform: translateY(-2px);
    filter: brightness(1.06);
    box-shadow: 0 6px 16px rgba(42, 31, 61, 0.2);
    outline: none;
  }

  .theinmag-contact-form__social-icon--instagram { background-color: var(--color-purple-dark, #5D3A7A); }
  .theinmag-contact-form__social-icon--facebook  { background-color: var(--color-teal-dark, #2D6878); }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-contact-form__social-icon { transition: none; }
    .theinmag-contact-form__social-icon:hover,
    .theinmag-contact-form__social-icon:focus-visible { transform: none; }
  }

  /* Thank-you block - same column position, same width as the form */
  .theinmag-contact-form__thanks {
    background-color: #FFFFFF;
    border-radius: var(--radius-xl, 28px);
    padding: clamp(28px, 4vw, 40px) clamp(20px, 3vw, 32px);
    box-shadow: var(--shadow-card, 0 2px 12px rgba(123, 79, 158, 0.08));
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(14px, 1.6vw, 18px);
  }

  .theinmag-contact-form__thanks-icon {
    width: clamp(72px, 9vw, 88px);
    height: clamp(72px, 9vw, 88px);
    display: block;
    flex-shrink: 0;
  }

  .theinmag-contact-form__thanks-icon svg {
    width: 100%;
    height: 100%;
    display: block;
    /* Sticker drop shadow matches the yellow primary CTA - keeps the
       success moment in the same visual family. */
    filter: drop-shadow(0 4px 0 var(--color-yellow-shadow, #D4A02E));
  }

  .theinmag-contact-form__thanks-heading {
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-size: clamp(28px, 4.2vw, 40px);
    line-height: 1.1;
    margin: 0;
    color: var(--color-inky-purple-navy, #2A1F3D);
  }

  .theinmag-contact-form__thanks-body {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-size: clamp(16px, 1.4vw, 17px);
    line-height: 1.6;
    margin: 0;
    color: var(--color-inky-purple-navy, #2A1F3D);
    max-width: 44ch;
  }

  .theinmag-contact-form__thanks-cta {
    margin-top: clamp(2px, 0.4vw, 6px);
  }

  .theinmag-contact-form__thanks-back {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-size: 14px;
    color: var(--color-link, #2D6878);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    transition: color var(--transition-standard, 0.15s ease), text-decoration-thickness var(--transition-standard, 0.15s ease);
  }

  .theinmag-contact-form__thanks-back:hover,
  .theinmag-contact-form__thanks-back:focus-visible {
    color: var(--color-purple-dark, #5D3A7A);
    text-decoration-thickness: 2px;
    outline: none;
  }

  /* ----- Right column blocks -------------------------------------- */

  .theinmag-contact-form__image-wrap {
    margin: 0;
  }

  .theinmag-contact-form__image {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-lg, 20px);
    aspect-ratio: 16 / 9;
    object-fit: cover;
    box-shadow: var(--shadow-card, 0 2px 12px rgba(123, 79, 158, 0.08));
  }

  /* Placeholder shown when image_picker empty AND no asset filename
     resolves. Bumped specificity with the section class to dodge
     Dawn's div:empty rule (pattern library §4.8). */
  .theinmag-contact-form .theinmag-contact-form__image-placeholder {
    display: none;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg, 20px);
    background-color: var(--color-lavender, #E8DEEF);
    color: var(--color-purple-dark, #5D3A7A);
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 6px;
    text-align: center;
    padding: clamp(16px, 2vw, 24px);
    box-sizing: border-box;
    box-shadow: var(--shadow-card, 0 2px 12px rgba(123, 79, 158, 0.08));
  }

  .theinmag-contact-form .theinmag-contact-form__image-placeholder--shown {
    display: flex;
  }

  .theinmag-contact-form__image-placeholder-eyebrow {
    font-family: var(--font-emphasis, 'Caveat', cursive);
    font-weight: 700;
    font-size: clamp(20px, 2.4vw, 26px);
    line-height: 1;
    color: var(--color-yellow, #F9C23C);
    text-shadow: 0 1px 0 rgba(42, 31, 61, 0.06);
  }

  .theinmag-contact-form__image-placeholder-body {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: clamp(15px, 1.3vw, 17px);
    color: var(--color-purple-dark, #5D3A7A);
  }

  /* ----- Nested router (specialist enquiries) --------------------- */

  .theinmag-contact-form__router-heading {
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-size: clamp(20px, 2.2vw, 24px);
    line-height: 1.15;
    margin: 0 0 clamp(10px, 1.4vw, 14px);
    color: var(--color-inky-purple-navy, #2A1F3D);
  }

  .theinmag-contact-form__router-tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(8px, 1.2vw, 10px);
  }

  .theinmag-contact-form__router-tile {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    background-color: #FFFFFF;
    color: var(--color-inky-purple-navy, #2A1F3D);
    border: 1.5px solid rgba(42, 31, 61, 0.08);
    border-radius: var(--radius-md, 12px);
    padding: clamp(10px, 1.4vw, 14px) clamp(14px, 1.8vw, 18px);
    text-decoration: none;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 500;
    font-size: clamp(14px, 1.3vw, 16px);
    line-height: 1.4;
    box-shadow: var(--shadow-card, 0 2px 12px rgba(123, 79, 158, 0.08));
    transition: transform var(--transition-hover, 0.2s ease),
                box-shadow var(--transition-hover, 0.2s ease),
                border-color var(--transition-hover, 0.2s ease),
                color var(--transition-hover, 0.2s ease);
    min-height: 44px;
    box-sizing: border-box;
    text-align: left;
  }

  .theinmag-contact-form__router-tile-label { flex: 1; }

  .theinmag-contact-form__router-tile-arrow {
    flex-shrink: 0;
    color: var(--color-purple-dark, #5D3A7A);
    font-size: 18px;
    line-height: 1;
    transition: transform var(--transition-hover, 0.2s ease);
  }

  .theinmag-contact-form__router-tile:hover,
  .theinmag-contact-form__router-tile:focus-visible {
    border-color: var(--color-purple-dark, #5D3A7A);
    color: var(--color-purple-dark, #5D3A7A);
    box-shadow: var(--shadow-card-hover, 0 4px 20px rgba(123, 79, 158, 0.15));
    outline: none;
    transform: translateY(-2px);
  }

  .theinmag-contact-form__router-tile:hover .theinmag-contact-form__router-tile-arrow,
  .theinmag-contact-form__router-tile:focus-visible .theinmag-contact-form__router-tile-arrow {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-contact-form__router-tile,
    .theinmag-contact-form__router-tile-arrow {
      transition: none;
    }
    .theinmag-contact-form__router-tile:hover,
    .theinmag-contact-form__router-tile:focus-visible {
      transform: none;
    }
    .theinmag-contact-form__router-tile:hover .theinmag-contact-form__router-tile-arrow,
    .theinmag-contact-form__router-tile:focus-visible .theinmag-contact-form__router-tile-arrow {
      transform: none;
    }
  }
{%- endstylesheet -%}

<script>
  (function () {
    var form = document.getElementById('theinmag-contact-form-element');
    if (!form) return;

    form.addEventListener('submit', function (evt) {
      var honeypot = form.querySelector('input[name="contact[website]"]');
      if (honeypot && honeypot.value) {
        /* Bot filled the trap. Block submission, fail silently so the
           bot's "did this work?" probe gets no useful signal. */
        evt.preventDefault();
        return false;
      }
    });
  })();
</script>

