{%- comment -%}
  theinmag-audience-tiles
  Section 4. Four full-bleed image tiles linking to the audience pages.

  Layout:
  - Below 1200px: horizontal scroll carousel with snap. Each tile is
                  ~85vw on phone, ~60vw on tablet/narrow desktop so
                  the next tile peeks at the right edge as a "swipe
                  for more" cue.
  - >= 1200px:    4-up single row, all four tiles fit, no scroll.

  Section heading "Designed with you in mind" sits absolute-positioned
  at the bottom of the section across all viewports. On narrow
  viewports the heading stays locked while the tiles scroll
  horizontally underneath it - playful theINmag move on top of the
  Maude pattern.

  Spec: ../theinmag-docs/homepage-build-spec.md Section 4.
{%- endcomment -%}

{%- liquid
  assign heading_text = section.settings.heading | default: 'Designed with you in mind'
  assign intro_text = section.settings.intro_text
  assign heading_position = section.settings.heading_position | default: 'overlay_bottom'
  assign exclude_label_raw = section.settings.exclude_label | default: ''
  assign exclude_label = exclude_label_raw | downcase | strip

  # Count the tiles that survive the exclude_label filter (Liquid
  # `concat` only works on arrays of arrays, so the previous
  # `concat: block` pre-partition silently dropped every block).
  # Render-pass filter below skips matching blocks inline.
  assign tile_count = section.blocks.size
  if exclude_label != ''
    assign tile_count = 0
    for block in section.blocks
      assign this_label = block.settings.label | default: '' | downcase | strip
      unless this_label == exclude_label
        assign tile_count = tile_count | plus: 1
      endunless
    endfor
  endif
  assign padding_top = section.settings.padding_top | default: 0
  assign padding_bottom = section.settings.padding_bottom | default: 0

  assign bg_image_filename = section.settings.bg_image_filename
  assign bg_image_opacity = section.settings.bg_image_opacity | default: 30
  assign bg_image_opacity_decimal = bg_image_opacity | times: 1.0 | divided_by: 100.0

  assign tile_shadow = section.settings.tile_shadow

  assign root_class = 'theinmag-tiles'
  if heading_position == 'top'
    assign root_class = root_class | append: ' theinmag-tiles--heading-top'
  endif
  if tile_shadow
    assign root_class = root_class | append: ' theinmag-tiles--shadow'
  endif

  assign bg_image_url = ''
  if bg_image_filename != blank
    assign bg_image_url = bg_image_filename | asset_url
  endif
-%}

<section
  class="{{ root_class }}"
  aria-labelledby="theinmag-tiles-heading-{{ section.id }}"
  style="--theinmag-tiles-count: {{ tile_count }}; --theinmag-tiles-pt: {{ padding_top }}px; --theinmag-tiles-pb: {{ padding_bottom }}px; --theinmag-tiles-bg-opacity: {{ bg_image_opacity_decimal }};{% if bg_image_url != blank %} --theinmag-tiles-bg-image: url('{{ bg_image_url }}');{% endif %}"
>
  {%- if bg_image_url != blank -%}
    <div class="theinmag-tiles__bg-image" aria-hidden="true"></div>
  {%- endif -%}

  {%- comment -%}
    Check the RAW setting (not heading_text with its | default: fallback)
    so an empty-string template override actually hides the heading.
  {%- endcomment -%}
  {%- liquid
    assign show_top_heading = false
    if heading_position == 'top'
      if section.settings.heading != blank
        assign show_top_heading = true
      endif
      if intro_text != blank
        assign show_top_heading = true
      endif
    endif
    assign caveat_label = section.settings.caveat_label
  -%}
  {%- if show_top_heading -%}
    <div class="theinmag-tiles__top-heading">
      {%- if section.settings.heading != blank -%}
        <h2 id="theinmag-tiles-heading-{{ section.id }}" class="theinmag-tiles__top-heading-text">{{ heading_text }}</h2>
      {%- endif -%}
      {%- if intro_text != blank -%}
        <p class="theinmag-tiles__top-intro">{{ intro_text }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if heading_position == 'top' and caveat_label != blank -%}
    <p class="theinmag-tiles__caveat-label" aria-hidden="true">{{ caveat_label }}</p>
  {%- endif -%}

  <div class="theinmag-tiles__scroller">
    <ul class="theinmag-tiles__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign label = block.settings.label
          assign this_label_lc = label | default: '' | downcase | strip
          if exclude_label != '' and this_label_lc == exclude_label
            continue
          endif
          assign link = block.settings.link
          assign image = block.settings.image
          assign image_alt = block.settings.image_alt | default: label
          assign fallback_filename = block.settings.fallback_filename
        -%}
        <li class="theinmag-tiles__item" {{ block.shopify_attributes }}>
          <a
            class="theinmag-tile"
            href="{{ link | default: '#' }}"
            aria-label="{{ label | escape }} - learn more"
          >
            <span class="theinmag-tile__media">
              {%- if image != blank -%}
                <img
                  class="theinmag-tile__image"
                  src="{{ image | image_url: width: 1200 }}"
                  srcset="
                    {{ image | image_url: width: 600 }} 600w,
                    {{ image | image_url: width: 900 }} 900w,
                    {{ image | image_url: width: 1200 }} 1200w,
                    {{ image | image_url: width: 1800 }} 1800w
                  "
                  sizes="(min-width: 1200px) 25vw, (min-width: 750px) 60vw, 85vw"
                  width="{{ image.width }}"
                  height="{{ image.height }}"
                  alt="{{ image_alt | escape }}"
                  loading="lazy"
                >
              {%- elsif fallback_filename != blank -%}
                <img
                  class="theinmag-tile__image"
                  src="{{ fallback_filename | asset_url }}"
                  alt="{{ image_alt | escape }}"
                  loading="lazy"
                >
              {%- else -%}
                <span class="theinmag-tile__image theinmag-tile__image--empty" aria-hidden="true"></span>
              {%- endif -%}
              <span class="theinmag-tile__darken" aria-hidden="true"></span>
            </span>

            <span class="theinmag-tile__label">{{ label }}</span>
          </a>
        </li>
      {%- else -%}
        <li class="theinmag-tiles__empty">
          <p>Add audience tiles in the theme editor.</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>

  {%- if heading_position != 'top' -%}
    <div class="theinmag-tiles__heading-scrim" aria-hidden="true"></div>
    <h2
      id="theinmag-tiles-heading-{{ section.id }}"
      class="theinmag-tiles__heading"
    >
      {{ heading_text }}
    </h2>
  {%- endif -%}
</section>

{% stylesheet %}
  /* ================================================================
     theinmag-audience-tiles (Section 4)
     ================================================================ */

  /* Optional full-bleed bg image (per-instance). 2-class selector
     beats Dawn's `div:empty { display: none }` rule so the empty
     decoration div renders. Sits behind every section child. */
  .theinmag-tiles .theinmag-tiles__bg-image {
    display: block;
    position: absolute;
    inset: 0;
    background-image: var(--theinmag-tiles-bg-image);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: var(--theinmag-tiles-bg-opacity, 0.3);
    pointer-events: none;
    z-index: 0;
  }

  /* Lift every other direct child above the bg-image's stacking
     context (z-index: 0) so heading + tiles render in front. */
  .theinmag-tiles > :not(.theinmag-tiles__bg-image) {
    position: relative;
    z-index: 1;
  }

  /* Optional white-border + drop-shadow treatment (opt-in via the
     tile_shadow setting, default off so other audience pages don't
     change). Adds a thin white frame, rounded corners and a layered
     shadow for a friendly 3D pop. */
  .theinmag-tiles--shadow .theinmag-tile {
    border: 4px solid #ffffff;
    border-radius: var(--radius-md, 12px);
    box-shadow:
      0 10px 30px rgba(20, 14, 30, 0.18),
      0 4px 12px rgba(20, 14, 30, 0.10);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .theinmag-tiles--shadow .theinmag-tile:hover,
  .theinmag-tiles--shadow .theinmag-tile:focus-visible {
    transform: translateY(-3px);
    box-shadow:
      0 14px 36px rgba(20, 14, 30, 0.22),
      0 6px 16px rgba(20, 14, 30, 0.14);
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-tiles--shadow .theinmag-tile {
      transition: none;
    }
    .theinmag-tiles--shadow .theinmag-tile:hover,
    .theinmag-tiles--shadow .theinmag-tile:focus-visible {
      transform: none;
    }
  }

  .theinmag-tiles {
    position: relative;
    background-color: var(--color-cream);
    /* Section padding is 0 - tiles are full-bleed at every viewport,
       and the heading is an overlay positioned against the section. */
    padding: 0;
    overflow: hidden;
  }

  /* ================================================================
     Scroller
     - Below 1200px: overflow-x scroll with snap
     - >= 1200px:    overflow visible, the grid switches to 4-up
     ================================================================ */

  .theinmag-tiles__scroller {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    /* Hide scrollbar visually - the peeking next tile is the
       affordance for "swipe for more". */
    scrollbar-width: none;
  }
  .theinmag-tiles__scroller::-webkit-scrollbar { display: none; }

  @media (min-width: 1200px) {
    .theinmag-tiles__scroller {
      overflow: visible;
      scroll-snap-type: none;
    }
  }

  /* ================================================================
     Grid
     ================================================================ */

  .theinmag-tiles__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    gap: 0;
  }

  @media (min-width: 1200px) {
    .theinmag-tiles__grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* heading-top variant: smaller square tiles, centered grid.
     Used as the closer "coda" on audience pages. */
  @media (min-width: 1200px) {
    .theinmag-tiles--heading-top .theinmag-tiles__grid {
      grid-template-columns: repeat(var(--theinmag-tiles-count, 4), minmax(0, 320px));
      justify-content: center;
      gap: clamp(16px, 2vw, 32px);
    }
  }

  /* Square aspect everywhere in the heading-top variant (homepage
     overlay-bottom variant keeps 4:5 portrait). */
  .theinmag-tiles--heading-top .theinmag-tile {
    aspect-ratio: 1 / 1;
  }

  /* Mobile/tablet: smaller scroll-snap tiles too (was 85vw/60vw -
     now ~70vw/45vw so 2 fit on screen at a time and the row reads
     as a "coda" not a featured tile rail). */
  .theinmag-tiles--heading-top .theinmag-tiles__item {
    width: 70vw;
    max-width: 320px;
  }
  @media (min-width: 750px) {
    .theinmag-tiles--heading-top .theinmag-tiles__item {
      width: 45vw;
      max-width: 320px;
    }
  }
  @media (min-width: 1200px) {
    .theinmag-tiles--heading-top .theinmag-tiles__item {
      width: 100%;
      max-width: 320px;
    }
  }

  .theinmag-tiles__item {
    margin: 0;
    padding: 0;
    list-style: none;
    /* Phone: tile is ~85vw so the next peeks on the right. */
    flex: 0 0 auto;
    width: 85vw;
    max-width: 480px;
    scroll-snap-align: start;
  }

  /* Tablet + narrow desktop (up to 1199px): tile is 60vw, capped at
     600px. Keeps the slide carousel feeling consistent across the
     whole non-grid range. */
  @media (min-width: 750px) {
    .theinmag-tiles__item {
      width: 60vw;
      max-width: 600px;
    }
  }

  @media (min-width: 1200px) {
    .theinmag-tiles__item {
      width: auto;
      max-width: none;
      flex: initial;
    }
  }

  .theinmag-tiles__empty {
    list-style: none;
    width: 100%;
    text-align: center;
    padding: var(--space-3xl) var(--space-md);
    color: var(--color-text-muted);
    font-family: var(--font-body);
  }

  /* ================================================================
     Tile
     ================================================================ */

  .theinmag-tile {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    background-color: var(--color-cream);
  }

  .theinmag-tile__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .theinmag-tile__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.4s ease;
  }

  .theinmag-tile__image--empty {
    background-color: var(--color-lavender);
  }

  /* Uniform darken across the whole photo - matches every tile to a
     similar brightness regardless of how the photo was lit. The
     bottom heading scrim adds extra darkness over this for the
     overlay heading legibility. */
  .theinmag-tile__darken {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.25);
    pointer-events: none;
    transition: background-color var(--transition-hover);
    z-index: 1;
  }

  .theinmag-tile:hover .theinmag-tile__image,
  .theinmag-tile:focus-visible .theinmag-tile__image {
    transform: scale(1.04);
  }

  .theinmag-tile:hover .theinmag-tile__darken,
  .theinmag-tile:focus-visible .theinmag-tile__darken {
    background-color: rgba(0, 0, 0, 0.32);
  }

  .theinmag-tile:focus-visible {
    outline: 3px solid var(--color-yellow);
    outline-offset: -6px;
  }

  /* ================================================================
     Tile label - top-left, white, Inter 600. No text-shadow.
     Legibility relies on the uniform tile darken (0.25 alpha) +
     the contrast of white on darker tones. If a photo's top-left
     area is too bright for white text to read, that needs a tighter
     crop or a different photo rather than a CSS shadow.
     ================================================================ */

  .theinmag-tile__label {
    position: absolute;
    top: var(--space-md);
    left: var(--space-md);
    z-index: 2;
    pointer-events: none;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: clamp(16px, 1.8vw, 19px);
    line-height: 1.5;
    letter-spacing: 0;
    color: #ffffff;
  }

  @media (min-width: 750px) {
    .theinmag-tile__label {
      top: var(--space-lg);
      left: var(--space-lg);
    }
  }

  @media (min-width: 1200px) {
    .theinmag-tile__label {
      top: var(--space-xl);
      left: var(--space-xl);
    }
  }

  /* ================================================================
     Section heading - "Designed with you in mind"
     Absolute-positioned overlay at every viewport. On the narrow
     scroll layouts it stays locked while tiles slide underneath.
     ================================================================ */

  .theinmag-tiles__heading {
    position: absolute;
    bottom: clamp(20px, 4vh, 56px);
    left: 0;
    right: 0;
    z-index: 3;
    margin: 0;
    padding: 0 var(--space-md);
    font-family: var(--font-heading);
    font-weight: 400;
    /* Bumped from clamp(28px, 5vw, 56px). At narrow desktop widths
       (750-1199px) the previous clamp landed in the 35-50px range
       which read small against the photos. New floor 36px keeps it
       substantial on phone too. text-wrap: balance gives nicer
       2-line wraps on smaller viewports where it doesn't fit on one
       line (~24 chars at the chosen size). */
    font-size: clamp(36px, 6vw, 68px);
    line-height: 1.05;
    text-wrap: balance;
    color: #ffffff;
    text-align: center;
    pointer-events: none;
    text-shadow:
      0 2px 6px rgba(0, 0, 0, 0.55),
      0 4px 24px rgba(0, 0, 0, 0.35);
  }

  /* Bottom gradient that runs across the visible tile area. Sits
     between the photos and the heading. Gives the white heading a
     darker field to land on regardless of what each photo looks
     like at that vertical band. */
  .theinmag-tiles__heading-scrim {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 38%;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.50) 0%,
      rgba(0, 0, 0, 0.25) 55%,
      rgba(0, 0, 0, 0) 100%
    );
    pointer-events: none;
    z-index: 2;
  }

  /* ================================================================
     heading-top variant - used as the closer "coda" on audience pages
     (For Parents, etc). Heading + intro sit ABOVE the tiles in the
     cream area; no bottom overlay. Padding becomes the configured
     top/bottom on the section root (default 0 still applies on the
     homepage overlay-bottom variant).
     ================================================================ */

  .theinmag-tiles--heading-top {
    padding: var(--theinmag-tiles-pt, 0) var(--space-md) var(--theinmag-tiles-pb, 0);
  }

  .theinmag-tiles--heading-top .theinmag-tiles__top-heading {
    text-align: center;
    max-width: 760px;
    margin: 0 auto clamp(28px, 4vw, 48px);
  }

  .theinmag-tiles--heading-top .theinmag-tiles__top-heading-text {
    margin: 0 0 clamp(8px, 1vw, 14px);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: clamp(24px, 3.5vw, 32px);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-inky-purple-navy, #2A1F3D);
  }

  .theinmag-tiles--heading-top .theinmag-tiles__top-intro {
    margin: 0 auto;
    max-width: 50ch;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: clamp(15px, 1.6vw, 17px);
    line-height: 1.6;
    color: rgba(42, 31, 61, 0.72);
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .theinmag-tile__image,
    .theinmag-tile__darken {
      transition: none;
    }
    .theinmag-tile:hover .theinmag-tile__image,
    .theinmag-tile:focus-visible .theinmag-tile__image {
      transform: none;
    }
    .theinmag-tiles__scroller {
      scroll-behavior: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "theINmag audience tiles",
  "tag": "section",
  "class": "theinmag-tiles-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Four audience tiles. Below 1200px the tiles become a horizontal scroll carousel - swipe to see all four. Heading 'Designed with you in mind' stays locked over the bottom of the tiles at every viewport."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "info": "Sits over the bottom of the tile row at every viewport.",
      "default": "Designed with you in mind"
    },
    {
      "type": "select",
      "id": "heading_position",
      "label": "Heading position",
      "info": "Overlay bottom (default, homepage rhythm): white heading on the photos' bottom scrim. Top: dark heading + intro sit above the tiles in the cream area (used as the closer 'coda' on audience pages).",
      "options": [
        { "value": "overlay_bottom", "label": "Overlay bottom (default)" },
        { "value": "top", "label": "Top (closer coda)" }
      ],
      "default": "overlay_bottom"
    },
    {
      "type": "textarea",
      "id": "intro_text",
      "label": "Intro / subhead",
      "info": "Only shown when heading position is Top. One sentence under the heading. Leave blank to hide."
    },
    {
      "type": "text",
      "id": "exclude_label",
      "label": "Exclude tile by label",
      "info": "Case-insensitive label match. e.g. 'Parents' on the For Parents page so the closer routes to the other audiences. Leave blank to render all blocks."
    },
    {
      "type": "text",
      "id": "caveat_label",
      "label": "Caveat sign-off label (top variant only)",
      "info": "Small handwritten label above the tile container. e.g. 'p.s. more INside.'. Only renders when heading position is Top. Leave blank to hide."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (px)",
      "info": "Only applies in Top heading mode. Homepage rhythm uses 0.",
      "min": 0,
      "max": 160,
      "step": 8,
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (px)",
      "info": "Only applies in Top heading mode. Homepage rhythm uses 0.",
      "min": 0,
      "max": 160,
      "step": 8,
      "default": 0
    },
    {
      "type": "header",
      "content": "Background image (optional)"
    },
    {
      "type": "text",
      "id": "bg_image_filename",
      "label": "Background image filename in /assets/",
      "info": "Optional full-bleed image behind the tiles. Leave blank for plain cream bg."
    },
    {
      "type": "range",
      "id": "bg_image_opacity",
      "label": "Background image opacity (%)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 30
    },
    {
      "type": "header",
      "content": "Tile treatment"
    },
    {
      "type": "checkbox",
      "id": "tile_shadow",
      "label": "White border + drop shadow on tiles",
      "info": "Adds a thin white frame, rounded corners, and a layered shadow for a friendly 3D pop. Off by default; other audience pages unaffected.",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Audience tile",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label (single word)",
          "info": "e.g. Parents, Teachers, Homeschoolers, Kids. Renders white in Inter 600 (matches the hero subhead).",
          "default": "Parents"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Tile link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image",
          "info": "1800x1800 square JPG, under 300KB after TinyPNG. Falls back to the filename below if not set."
        },
        {
          "type": "text",
          "id": "fallback_filename",
          "label": "Fallback filename in /assets/",
          "info": "Used only if no image is uploaded above. Asset-folder filename, no path.",
          "default": "HERO_audiences-parents.jpg"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text",
          "info": "Descriptive and keyword-aware. Drives AEO."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "theINmag audience tiles",
      "blocks": [
        {
          "type": "tile",
          "settings": {
            "label": "Parents",
            "link": "/pages/for-parents",
            "fallback_filename": "HERO_audiences-parents.jpg",
            "image_alt": "An Australian parent reading theINmag with their child."
          }
        },
        {
          "type": "tile",
          "settings": {
            "label": "Teachers",
            "link": "/pages/for-teachers",
            "fallback_filename": "HERO_audiences-teachers.jpg",
            "image_alt": "An Australian teacher using theINmag with their classroom."
          }
        },
        {
          "type": "tile",
          "settings": {
            "label": "Homeschoolers",
            "link": "/pages/for-homeschoolers",
            "fallback_filename": "HERO_audiences-homeschoolers.jpg",
            "image_alt": "An Australian homeschool family at the kitchen table with theINmag."
          }
        },
        {
          "type": "tile",
          "settings": {
            "label": "Kids",
            "link": "/pages/for-kids",
            "fallback_filename": "HERO_audiences-kids.jpg",
