{%- comment -%}
  theinmag-daily-prompt-guide
  A teacher-facing content band that sits BELOW the daily prompt hero + loop on
  /pages/daily-prompt. Three parts, top to bottom:
    1. A calm lede paragraph (styled like theinmag-legal-hero's lede).
    2. Two labelled groups (product benefits, then classroom use), each with its
       own heading and one-line intro, then its beats: a bold lead-in plus one or
       two sentences, as clean stacked cards. Each beat is tagged to a group.
    3. A FAQ accordion (eight Q and As) built on the theinmag-legal-accordions
       pattern: button + aria-expanded + data-open max-height, single-open,
       keyboard accessible, prefers-reduced-motion respected.
  A FAQPage JSON-LD script covers exactly the eight FAQ Q and As (plain text,
  no HTML in the answers) so the questions can surface as rich results.

  Palette matches the daily-prompt page: cream field, lavender hover, purple-dark
  and inky-purple-navy text tokens, so the band reads as one tidy unit continuing
  from the prompt above. Yellow stays a stamp only (not used as a field here).

  BRAND RULES honoured: sentence case headings, no en or em dashes anywhere
  (hyphens only, code comments included), Post Regular for the display headings
  (a few words only) and Inter for body, no Caveat, "theINmag" casing exact,
  "creation" not "work", no pure-white or pure-yellow section fields.

  Editable in the theme editor: the lede, each group heading + intro, each beat
  (a block, tagged to a group), the FAQ heading, and each FAQ item (a block).
  All seeded with the copy below as defaults so Ryan can tweak.
{%- endcomment -%}

{%- liquid
  assign beats = section.blocks | where: 'type', 'beat'
  assign faqs = section.blocks | where: 'type', 'faq_item'

  assign intro_bg = section.settings.intro_bg_color | default: '#C9E5E8'

  assign section_style = '--dpg-pt: ' | append: section.settings.padding_top | append: 'px; --dpg-pb: ' | append: section.settings.padding_bottom | append: 'px; --dpg-intro-bg: ' | append: intro_bg | append: ';'

  assign intro_art_1 = section.settings.intro_art_1 | default: 'blog-image-universal-28.jpg'
  assign intro_art_2 = section.settings.intro_art_2 | default: 'blog-image-universal-37.jpg'
  assign intro_art_3 = section.settings.intro_art_3 | default: 'blog-image-universal-39.jpg'
  assign intro_art_4 = section.settings.intro_art_4 | default: 'blog-image-universal-40.jpg'
  assign intro_art_alt = section.settings.intro_art_alt | default: 'A creation by a real Australian kid, from theINmag.'
-%}

<section
  class="theinmag-dp-guide"
  data-theinmag-dp-guide
  aria-labelledby="theinmag-dp-guide-lede-heading"
  style="{{ section_style }}"
>
  {%- comment -%}
    ===== 1. Split intro band =====
    Its own two-column band on a distinct sky-pair field, so it reads apart
    from the cream "Made for a busy classroom" and FAQ area below. Left column
    is a rotating editorial image (random-picked on load from the same 4-image
    pool the single-mags pillars use); right column is the caps eyebrow, the
    search-shaped H2 band heading and the lede. On mobile the image stacks
    above the text.
  {%- endcomment -%}
  {%- if section.settings.lede != blank -%}
    {%- assign band_eyebrow = section.settings.band_eyebrow | default: 'Speaking and listening. Morning routines. Class discussion.' -%}
    {%- assign band_heading = section.settings.band_heading | default: 'A daily discussion prompt for your classroom' -%}
    <div class="theinmag-dp-guide__intro-band">
      <div class="theinmag-dp-guide__intro-inner">
        <div
          class="theinmag-dp-guide__intro-media"
          data-dp-guide-art-wrap
          data-art-1="{{ intro_art_1 | asset_url }}"
          data-art-2="{{ intro_art_2 | asset_url }}"
          data-art-3="{{ intro_art_3 | asset_url }}"
          data-art-4="{{ intro_art_4 | asset_url }}"
        >
          <img
            class="theinmag-dp-guide__intro-img"
            data-dp-guide-art-img
            src="{{ intro_art_1 | asset_url }}"
            alt="{{ intro_art_alt | escape }}"
            loading="lazy"
            width="1200"
            height="1500"
          >
        </div>
        <div class="theinmag-dp-guide__intro-copy">
          {%- if band_eyebrow != blank -%}
            <p class="theinmag-dp-guide__eyebrow">{{ band_eyebrow }}</p>
          {%- endif -%}
          <h2 id="theinmag-dp-guide-lede-heading" class="theinmag-dp-guide__band-heading">{{ band_heading }}</h2>
          <div class="theinmag-dp-guide__lede">
            {{ section.settings.lede }}
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}

  <div class="theinmag-dp-guide__body">
    <div class="theinmag-dp-guide__inner">

    {%- comment -%}
      ===== 2. Two groups: product benefits (ease) then classroom use (use) =====
      Each beat block carries a "group" setting. We loop the beats twice and
      render only those tagged to the current group, with the number badge
      restarting from 1 inside each group.
    {%- endcomment -%}

    {%- comment -%} Group 1: made for a busy classroom (ease) {%- endcomment -%}
    {%- assign ease_count = 0 -%}
    {%- for block in beats -%}
      {%- if block.settings.group == 'ease' -%}{%- assign ease_count = ease_count | plus: 1 -%}{%- endif -%}
    {%- endfor -%}
    {%- if ease_count > 0 -%}
      <div class="theinmag-dp-guide__howto">
        {%- if section.settings.group1_heading != blank -%}
          <h2 class="theinmag-dp-guide__howto-heading">{{ section.settings.group1_heading }}</h2>
        {%- endif -%}
        {%- if section.settings.group1_intro != blank -%}
          <p class="theinmag-dp-guide__howto-intro">{{ section.settings.group1_intro }}</p>
        {%- endif -%}

        <ol class="theinmag-dp-guide__beats" role="list">
          {%- assign ease_n = 0 -%}
          {%- for block in beats -%}
            {%- if block.settings.group == 'ease' -%}
              {%- assign ease_n = ease_n | plus: 1 -%}
              <li class="theinmag-dp-guide__beat" {{ block.shopify_attributes }}>
                <span class="theinmag-dp-guide__beat-num" aria-hidden="true">{{ ease_n }}</span>
                <div class="theinmag-dp-guide__beat-body">
                  {%- if block.settings.lead != blank -%}
                    <span class="theinmag-dp-guide__beat-lead">{{ block.settings.lead }}</span>
                  {%- endif -%}
                  {%- if block.settings.body != blank -%}
                    <span class="theinmag-dp-guide__beat-text">{{ block.settings.body }}</span>
                  {%- endif -%}
                </div>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ol>
      </div>
    {%- endif -%}

    {%- comment -%} Group 2: in your room (use) {%- endcomment -%}
    {%- assign use_count = 0 -%}
    {%- for block in beats -%}
      {%- if block.settings.group == 'use' -%}{%- assign use_count = use_count | plus: 1 -%}{%- endif -%}
    {%- endfor -%}
    {%- if use_count > 0 -%}
      <div class="theinmag-dp-guide__howto">
        {%- if section.settings.group2_heading != blank -%}
          <h2 class="theinmag-dp-guide__howto-heading">{{ section.settings.group2_heading }}</h2>
        {%- endif -%}
        {%- if section.settings.group2_intro != blank -%}
          <p class="theinmag-dp-guide__howto-intro">{{ section.settings.group2_intro }}</p>
        {%- endif -%}

        <ol class="theinmag-dp-guide__beats" role="list">
          {%- assign use_n = 0 -%}
          {%- for block in beats -%}
            {%- if block.settings.group == 'use' -%}
              {%- assign use_n = use_n | plus: 1 -%}
              <li class="theinmag-dp-guide__beat" {{ block.shopify_attributes }}>
                <span class="theinmag-dp-guide__beat-num" aria-hidden="true">{{ use_n }}</span>
                <div class="theinmag-dp-guide__beat-body">
                  {%- if block.settings.lead != blank -%}
                    <span class="theinmag-dp-guide__beat-lead">{{ block.settings.lead }}</span>
                  {%- endif -%}
                  {%- if block.settings.body != blank -%}
                    <span class="theinmag-dp-guide__beat-text">{{ block.settings.body }}</span>
                  {%- endif -%}
                </div>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ol>
      </div>
    {%- endif -%}

    {%- comment -%} ===== 3. FAQ accordion ===== {%- endcomment -%}
    {%- if faqs.size > 0 -%}
      <div class="theinmag-dp-guide__faq" data-theinmag-dp-guide-faq>
        {%- if section.settings.faq_heading != blank -%}
          <h2 class="theinmag-dp-guide__faq-heading">{{ section.settings.faq_heading }}</h2>
        {%- endif -%}

        <ul class="theinmag-dp-guide__faq-list" role="list">
          {%- for block in faqs -%}
            {%- liquid
              assign panel_id = 'theinmag-dp-guide-panel-' | append: section.id | append: '-' | append: forloop.index0
              assign trigger_id = 'theinmag-dp-guide-trigger-' | append: section.id | append: '-' | append: forloop.index0
            -%}
            <li class="theinmag-dp-guide__faq-item" {{ block.shopify_attributes }}>
              <h3 class="theinmag-dp-guide__faq-q">
                <button
                  type="button"
                  class="theinmag-dp-guide__faq-trigger"
                  id="{{ trigger_id }}"
                  aria-expanded="false"
                  aria-controls="{{ panel_id }}"
                  data-theinmag-dp-guide-trigger
                >
                  <span class="theinmag-dp-guide__faq-q-text">{{ block.settings.question }}</span>
                  <span class="theinmag-dp-guide__faq-caret" aria-hidden="true"></span>
                </button>
              </h3>
              <div
                id="{{ panel_id }}"
                class="theinmag-dp-guide__faq-panel"
                role="region"
                aria-labelledby="{{ trigger_id }}"
                data-theinmag-dp-guide-panel
                data-open="false"
              >
                <div class="theinmag-dp-guide__faq-a">
                  {{ block.settings.answer }}
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    </div>
  </div>
</section>

{%- comment -%}
  FAQPage JSON-LD. Plain text only (strip_html removes richtext formatting), so
  the answers stay HTML-free per the schema.org FAQPage spec. Each faq_item block
  becomes one Question + acceptedAnswer pair.
{%- endcomment -%}
{%- if faqs.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- assign first = true -%}
    {%- for block in faqs -%}
      {%- if block.settings.question != blank -%}
        {%- unless first -%},{%- endunless -%}
        {
          "@type": "Question",
          "name": {{ block.settings.question | strip_html | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ block.settings.answer | strip_html | strip_newlines | json }}
          }
        }
        {%- assign first = false -%}
      {%- endif -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{%- stylesheet -%}
  /* ================================================================
     theinmag-dp-guide
     Two fields, stacked. A distinct sky-pair split band at the top
     (rotating editorial image left, intro copy right), then the cream
     field below carrying the how-to cards and the single-open FAQ.
     ================================================================ */

  .theinmag-dp-guide {
    color: var(--color-inky-purple-navy, #2A1F3D);
  }

  /* ---- 0. Split intro band (distinct sky field) ---- */
  .theinmag-dp-guide__intro-band {
    background-color: var(--dpg-intro-bg, #C9E5E8);
    padding: clamp(36px, 6vw, 72px) clamp(16px, 4vw, 32px);
  }

  .theinmag-dp-guide__intro-inner {
    max-width: 1060px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(24px, 4vw, 44px);
    align-items: center;
  }

  @media (min-width: 860px) {
    .theinmag-dp-guide__intro-inner {
      grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
      gap: clamp(32px, 4.5vw, 60px);
    }
  }

  /* Image column: portrait editorial photo, framed with soft rounded
     corners and a gentle shadow. Capped and centred on mobile so a
     1200x1500 portrait does not run the full screen height. */
  .theinmag-dp-guide__intro-media {
    margin: 0 auto;
    width: 100%;
    max-width: 340px;
  }

  @media (min-width: 860px) {
    .theinmag-dp-guide__intro-media {
      max-width: none;
    }
  }

  .theinmag-dp-guide__intro-img {
    display: block;
    width: 100%;
    height: auto;
    /* 4 / 5 matches the source 1200x1500, so cover never distorts or crops. */
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-md, 14px);
    box-shadow: 0 18px 40px rgba(42, 31, 61, 0.20);
  }

  .theinmag-dp-guide__intro-copy {
    text-align: left;
  }

  .theinmag-dp-guide__body {
    background-color: var(--color-cream, #FBF6EA);
    padding: var(--dpg-pt, 56px) clamp(16px, 4vw, 32px) var(--dpg-pb, 72px);
    border-top: 1px solid rgba(42, 31, 61, 0.08);
  }

  .theinmag-dp-guide__inner {
    max-width: 820px;
    margin: 0 auto;
  }

  /* First how-to group sits straight under the cream field's top padding,
     so drop its own top margin to avoid a double gap. */
  .theinmag-dp-guide__body > .theinmag-dp-guide__inner > .theinmag-dp-guide__howto:first-child {
    margin-top: 0;
  }

  .theinmag-dp-guide__vh {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0);
    white-space: nowrap; border: 0;
  }

  /* ---- 1. Band heading + lede (left-aligned beside the image) ---- */
  .theinmag-dp-guide__lede {
    max-width: 54ch;
    margin: 0;
    text-align: left;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: clamp(16px, 1.8vw, 20px);
    line-height: 1.6;
    color: var(--color-inky-purple-navy, #2A1F3D);
  }

  /* Small caps eyebrow (a brand signature move) carrying the search phrases a
     teacher actually types, above the search-shaped band heading. */
  .theinmag-dp-guide__eyebrow {
    margin: 0 0 clamp(8px, 1vw, 12px);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: clamp(11px, 1.05vw, 12px);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-purple-dark, #5D3A7A);
  }

  .theinmag-dp-guide__band-heading {
    margin: 0 0 clamp(14px, 2vw, 22px);
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-size: clamp(26px, 4vw, 40px);
    line-height: 1.08;
    color: var(--color-inky-purple-navy, #2A1F3D);
  }

  .theinmag-dp-guide__lede p {
    margin: 0 0 clamp(10px, 1.2vw, 14px);
  }

  .theinmag-dp-guide__lede p:last-child {
    margin-bottom: 0;
  }

  /* ---- 2. How to use it ---- */
  .theinmag-dp-guide__howto {
    margin-top: clamp(40px, 6vw, 72px);
  }

  .theinmag-dp-guide__howto-heading {
    margin: 0;
    text-align: center;
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-synthesis: none;
    font-size: clamp(28px, 4vw, 42px);
    line-height: 1.1;
    color: var(--color-inky-purple-navy, #2A1F3D);
  }

  .theinmag-dp-guide__howto-intro {
    margin: clamp(8px, 1vw, 12px) auto 0;
    max-width: 48ch;
    text-align: center;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: clamp(16px, 1.7vw, 19px);
    line-height: 1.4;
    color: var(--color-purple-dark, #5D3A7A);
  }

  .theinmag-dp-guide__beats {
    list-style: none;
    margin: clamp(24px, 3.5vw, 40px) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(10px, 1.4vw, 14px);
  }

  /* Each beat is a warm cream-tinted card with a lavender left edge in the day's
     purple accent, so the six read as a settled stack, not a bullet list. */
  .theinmag-dp-guide__beat {
    display: flex;
    align-items: flex-start;
    gap: clamp(12px, 1.6vw, 18px);
    background-color: #FDFAF3;
    border: 1px solid rgba(123, 79, 158, 0.16);
    border-left: 4px solid var(--color-purple-dark, #5D3A7A);
    border-radius: var(--radius-sm, 8px);
    padding: clamp(16px, 2vw, 22px) clamp(16px, 2.2vw, 24px);
  }

  .theinmag-dp-guide__beat-num {
    flex: 0 0 auto;
    width: clamp(28px, 3.2vw, 34px);
    height: clamp(28px, 3.2vw, 34px);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background-color: var(--color-lavender, #E8DEEF);
    color: var(--color-purple-dark, #5D3A7A);
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-size: clamp(15px, 1.7vw, 18px);
    line-height: 1;
    margin-top: 1px;
  }

  .theinmag-dp-guide__beat-body {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-size: clamp(15px, 1.5vw, 17px);
    line-height: 1.55;
    color: var(--color-inky-purple-navy, #2A1F3D);
  }

  .theinmag-dp-guide__beat-lead {
    font-weight: 700;
    color: var(--color-inky-purple-navy, #2A1F3D);
  }

  .theinmag-dp-guide__beat-text {
    font-weight: 400;
  }

  .theinmag-dp-guide__beat-lead + .theinmag-dp-guide__beat-text {
    margin-left: 0.4em;
  }

  /* ---- 3. FAQ accordion ---- */
  .theinmag-dp-guide__faq {
    margin-top: clamp(44px, 6vw, 80px);
  }

  .theinmag-dp-guide__faq-heading {
    margin: 0 0 clamp(16px, 2vw, 24px);
    text-align: center;
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-synthesis: none;
    font-size: clamp(26px, 3.8vw, 40px);
    line-height: 1.1;
    color: var(--color-inky-purple-navy, #2A1F3D);
  }

  .theinmag-dp-guide__faq-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(42, 31, 61, 0.12);
  }

  .theinmag-dp-guide__faq-item {
    border-bottom: 1px solid rgba(42, 31, 61, 0.12);
  }

  .theinmag-dp-guide__faq-q {
    margin: 0;
    font: inherit;
  }

  .theinmag-dp-guide__faq-trigger {
    appearance: none;
    background: none;
    border: 0;
    width: 100%;
    display: flex;
    align-items: center;
    gap: clamp(10px, 1.5vw, 14px);
    padding: clamp(16px, 2.2vw, 22px) clamp(10px, 1.5vw, 16px);
    cursor: pointer;
    text-align: left;
    color: var(--color-inky-purple-navy, #2A1F3D);
    min-height: 56px;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .theinmag-dp-guide__faq-trigger:hover {
    background-color: rgba(232, 222, 239, 0.4);
  }

  .theinmag-dp-guide__faq-trigger:focus-visible {
    outline: 2px dashed var(--color-purple-dark, #5D3A7A);
    outline-offset: -2px;
    border-radius: 4px;
  }

  .theinmag-dp-guide__faq-trigger[aria-expanded="true"] {
    color: var(--color-purple-dark, #5D3A7A);
  }

  .theinmag-dp-guide__faq-q-text {
    flex: 1;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: clamp(16px, 1.8vw, 20px);
    line-height: 1.3;
    letter-spacing: -0.005em;
  }

  /* Caret: chevron built from two rotated bars, matching the legal accordions. */
  .theinmag-dp-guide__faq-caret {
    flex: 0 0 auto;
    width: 22px;
    height: 22px;
    position: relative;
    transition: transform 0.3s ease;
    color: var(--color-purple-dark, #5D3A7A);
  }

  .theinmag-dp-guide__faq-caret::before,
  .theinmag-dp-guide__faq-caret::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 12px;
    height: 2px;
    background-color: currentColor;
    border-radius: 2px;
    transform-origin: 50% 50%;
  }

  .theinmag-dp-guide__faq-caret::before {
    left: 1px;
    transform: translateY(-50%) rotate(45deg);
  }

  .theinmag-dp-guide__faq-caret::after {
    right: 1px;
    transform: translateY(-50%) rotate(-45deg);
  }

  .theinmag-dp-guide__faq-trigger[aria-expanded="true"] .theinmag-dp-guide__faq-caret {
    transform: rotate(180deg);
  }

  .theinmag-dp-guide__faq-panel {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.2s ease;
  }

  .theinmag-dp-guide__faq-panel[data-open="true"] {
    max-height: 1200px;
    background-color: #FDFAF3;
  }

  .theinmag-dp-guide__faq-a {
    padding: clamp(4px, 1vw, 10px) clamp(10px, 1.5vw, 16px) clamp(20px, 2.6vw, 28px);
    max-width: none;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: clamp(15px, 1.4vw, 16px);
    line-height: 1.65;
    color: var(--color-inky-purple-navy, #2A1F3D);
  }

  .theinmag-dp-guide__faq-a p {
    margin: 0 0 clamp(10px, 1.2vw, 14px);
  }

  .theinmag-dp-guide__faq-a p:last-child {
    margin-bottom: 0;
  }

  .theinmag-dp-guide__faq-a a {
    color: var(--color-purple-dark, #5D3A7A);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Reduced motion: state changes happen instantly, no slide or caret spin. */
  @media (prefers-reduced-motion: reduce) {
    .theinmag-dp-guide__faq-panel,
    .theinmag-dp-guide__faq-caret,
    .theinmag-dp-guide__faq-trigger {
      transition: none;
    }
  }
{%- endstylesheet -%}

<script>
  (function () {
    var root = document.querySelector('[data-theinmag-dp-guide-faq]');
    if (!root) return;

    var triggers = root.querySelectorAll('[data-theinmag-dp-guide-trigger]');
    if (!triggers.length) return;

    function setOpen(trigger, open) {
      var panelId = trigger.getAttribute('aria-controls');
      var panel = panelId ? document.getElementById(panelId) : null;
      if (!panel) return;
      trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
      panel.setAttribute('data-open', open ? 'true' : 'false');
    }

    function closeAll() {
      Array.prototype.forEach.call(triggers, function (t) { setOpen(t, false); });
    }

    /* Single-open: opening one collapses the others. Keeps the reader focused,
       matching the legal-accordions behaviour. */
    Array.prototype.forEach.call(triggers, function (trigger) {
      trigger.addEventListener('click', function () {
        var willOpen = trigger.getAttribute('aria-expanded') !== 'true';
        closeAll();
        if (willOpen) setOpen(trigger, true);
      });
    });
  })();
</script>

<script>
  /* Split-band image: random-pick one of the 4-slot pool on load,
     mirroring theinmag-single-mags-pillars. Empty slots filtered out. */
  (function () {
    var wrap = document.querySelector('[data-dp-guide-art-wrap]');
    var img = document.querySelector('[data-dp-guide-art-img]');
    if (!wrap || !img) return;

    var pool = ['data-art-1', 'data-art-2', 'data-art-3', 'data-art-4']
      .map(function (key) { return wrap.getAttribute(key); })
      .filter(function (url) { return url && url.length > 0; });

    if (pool.length > 0) {
      var next = pool[Math.floor(Math.random() * pool.length)];
      img.setAttribute('src', next);
    }
  })();
</script>

