{%- comment -%}
  theinmag-video-teaser  (2026-10-20, Webster)
  Small "coming later" band on the /pages/videos hub, nudging people to the
  free email signup. Ryan plans courses; this says so honestly: no dates,
  no prices, no promised features. One action only.
  Light lavender (purple pair light) between two cream sections so the page
  rhythm oscillates; body text inky (purple pair passes AA either way).
{%- endcomment -%}
<section class="theinmag-video-teaser" aria-labelledby="vteaser-{{ section.id }}">
  <div class="theinmag-video-teaser__inner">
    <p class="theinmag-video-teaser__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 id="vteaser-{{ section.id }}" class="theinmag-video-teaser__heading">{{ section.settings.heading }}</h2>
    <p class="theinmag-video-teaser__copy">{{ section.settings.copy }}</p>
    <a class="theinmag-btn theinmag-btn--primary" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a>
  </div>
</section>

{% stylesheet %}
  .theinmag-video-teaser {
    background: var(--color-lavender);
    color: var(--color-inky-purple-navy);
    padding: clamp(36px, 5vw, 56px) clamp(16px, 3vw, 32px);
  }
  .theinmag-video-teaser__inner { max-width: 640px; margin: 0 auto; text-align: center; }
  .theinmag-video-teaser__eyebrow {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 8px;
  }
  .theinmag-video-teaser__heading {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(26px, 4vw, 36px);
    line-height: 1.15;
    margin: 0 0 10px;
  }
  .theinmag-video-teaser__copy { font-family: var(--font-body); font-size: 17px; line-height: 1.6; margin: 0 0 20px; }
{% endstylesheet %}

{% schema %}
{
  "name": "Video courses teaser",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "coming later" },
    { "type": "text", "id": "heading", "label": "Heading (a question)", "default": "Want to go deeper?" },
    { "type": "textarea", "id": "copy", "label": "Copy" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Join free" },
    { "type": "text", "id": "cta_url", "label": "Button URL", "default": "/pages/newsletter" }
  ],
  "presets": [ { "name": "Video courses teaser" } ]
}
{% endschema %}
