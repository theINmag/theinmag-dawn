{%- comment -%}
  theinmag-blog-feed
  Four-up post card row anchoring the homepage to the theINside blog.
  Maude-faithful editorial layout: heading left + "see all" link right
  in the header row, cards below.

  Heading is rendered as four spans so the brand pun (capitalised IN)
  shows typographically: "the" small + "IN" big + "side" small + "."
  big. Editor can change any of the four parts in admin.

  Each card is a unified cream tile (image + body in one rounded
  container). Topic label sits as a white overlay on the cover image
  bottom-left. Title and short excerpt sit in the body below.

  Cards prefer a chosen Shopify article; fall back to manual overrides
  (title/excerpt/image/link) so the row renders before the blog exists
  in admin.
{%- endcomment -%}

{%- liquid
  assign heading_pre = section.settings.heading_pre
  assign heading_emphasis = section.settings.heading_emphasis
  assign heading_post = section.settings.heading_post
  assign heading_period = section.settings.heading_period
  assign subhead = section.settings.subhead
  assign cta_label = section.settings.cta_label
  assign cta_link = section.settings.cta_link
  assign show_cta = section.settings.show_cta
-%}

<section
  class="theinmag-blog-feed"
  aria-labelledby="theinmag-blog-feed-heading"
  style="--blog-feed-pt: {{ section.settings.padding_top }}px; --blog-feed-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="theinmag-blog-feed__inner">
    <header class="theinmag-blog-feed__header">
      <div class="theinmag-blog-feed__title-stack">
        <h2 id="theinmag-blog-feed-heading" class="theinmag-blog-feed__heading">
          {%- if heading_pre != blank -%}<span class="theinmag-blog-feed__heading-aux">{{ heading_pre }}</span>{%- endif -%}
          {%- if heading_emphasis != blank -%}<span class="theinmag-blog-feed__heading-main">{{ heading_emphasis }}</span>{%- endif -%}
          {%- if heading_post != blank -%}<span class="theinmag-blog-feed__heading-aux">{{ heading_post }}</span>{%- endif -%}
          {%- if heading_period != blank -%}<span class="theinmag-blog-feed__heading-period">{{ heading_period }}</span>{%- endif -%}
        </h2>
        {%- if subhead != blank -%}
          <p class="theinmag-blog-feed__subhead">{{ subhead }}</p>
        {%- endif -%}
      </div>
      {%- if show_cta and cta_label != blank and cta_link != blank -%}
        <a class="theinmag-blog-feed__seeall" href="{{ cta_link }}">
          {{ cta_label }} <span aria-hidden="true">&rarr;</span>
        </a>
      {%- endif -%}
    </header>

    {%- if section.blocks.size > 0 -%}
      <ul class="theinmag-blog-feed__cards" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign article = block.settings.article

            assign title = block.settings.title_override
            if title == blank and article != blank
              assign title = article.title
            endif

            assign excerpt = block.settings.excerpt_override
            if excerpt == blank and article != blank
              assign excerpt = article.excerpt | strip_html
              if excerpt == blank
                assign excerpt = article.content | strip_html | truncatewords: 24
              endif
            endif

            assign topic = block.settings.topic
            if topic == blank and article != blank
              assign topic = article.tags.first
            endif

            assign card_link = block.settings.link_override
            if card_link == blank and article != blank
              assign card_link = article.url
            endif

            assign image_src = ''
            if block.settings.image != blank
              assign image_src = block.settings.image | image_url: width: 1200
            elsif block.settings.fallback_filename != blank
              assign image_src = block.settings.fallback_filename | asset_url
            elsif article != blank and article.image != blank
              assign image_src = article.image | image_url: width: 1200
            endif

            assign image_alt = block.settings.image_alt
            if image_alt == blank and article != blank and article.image != blank
              assign image_alt = article.image.alt | default: article.title
            endif
            if image_alt == blank
              assign image_alt = title
            endif
          -%}
          <li class="theinmag-blog-feed__card-wrap" {{ block.shopify_attributes }}>
            {%- if card_link != blank -%}
              <a class="theinmag-blog-feed__card" href="{{ card_link }}">
            {%- else -%}
              <div class="theinmag-blog-feed__card">
            {%- endif -%}
              <span class="theinmag-blog-feed__cover">
                {%- if image_src != blank -%}
                  <img
                    class="theinmag-blog-feed__image"
                    src="{{ image_src }}"
                    alt="{{ image_alt | escape }}"
                    loading="lazy"
                    width="1200"
                    height="1500"
                  >
                {%- else -%}
                  <span class="theinmag-blog-feed__cover-placeholder" aria-hidden="true"></span>
                {%- endif -%}
                <span class="theinmag-blog-feed__scrim" aria-hidden="true"></span>
                {%- if topic != blank -%}
                  <span class="theinmag-blog-feed__topic">{{ topic }}</span>
                {%- endif -%}
              </span>
              <span class="theinmag-blog-feed__body">
                {%- if title != blank -%}
                  <span class="theinmag-blog-feed__title">{{ title }}</span>
                {%- endif -%}
                {%- if excerpt != blank -%}
                  <span class="theinmag-blog-feed__excerpt">{{ excerpt }}</span>
                {%- endif -%}
              </span>
            {%- if card_link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{%- stylesheet -%}
  .theinmag-blog-feed {
    background-color: var(--color-cream, #FBF6EA);
    color: var(--color-inky-purple-navy, #2A1F3D);
    padding: var(--blog-feed-pt, 64px) clamp(16px, 3vw, 32px) var(--blog-feed-pb, 64px);
  }

  .theinmag-blog-feed__inner {
    max-width: 1320px;
    margin: 0 auto;
  }

  /* Header row: heading + subhead stack on the left, see-all on the
     right baseline-aligned. Tight bottom margin so cards sit close
     to the heading per the Maude reference. */
  .theinmag-blog-feed__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-md, 16px);
    margin-bottom: clamp(20px, 2.4vw, 32px);
    flex-wrap: wrap;
  }

  .theinmag-blog-feed__title-stack {
    display: flex;
    flex-direction: column;
    gap: clamp(4px, 0.6vw, 8px);
    min-width: 0;
  }

  /* Heading composes four spans so the brand pun (capitalised IN) reads
     typographically: small "the" + big "IN" + small "side" + big ".".
     Parent font-size is the BIG size; aux scales down via em. */
  .theinmag-blog-feed__heading {
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-size: clamp(56px, 8vw, 104px);
    line-height: 0.95;
    letter-spacing: 0;
    margin: 0;
    color: var(--color-inky-purple-navy, #2A1F3D);
    white-space: nowrap;
    /* Vertically centre the small aux glyphs against the big IN/period. */
    display: inline-flex;
    align-items: center;
  }

  .theinmag-blog-feed__heading-aux {
    font-size: 0.42em;
    line-height: 1;
    /* Slight optical lift so the small caps sit visually centred
       against the big IN glyphs rather than dropping to the baseline. */
    transform: translateY(-0.04em);
    /* Hairline horizontal breathing room around the IN. */
    margin: 0 0.04em;
  }

  .theinmag-blog-feed__heading-main,
  .theinmag-blog-feed__heading-period {
    font-size: 1em;
    line-height: 1;
  }

  .theinmag-blog-feed__heading-period {
    margin-left: -0.02em;
  }

  .theinmag-blog-feed__subhead {
    margin: 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: clamp(13px, 1.3vw, 15px);
    line-height: 1.5;
    color: var(--color-inky-purple-navy, #2A1F3D);
    opacity: 0.7;
    max-width: 60ch;
  }

  .theinmag-blog-feed__seeall {
    flex: 0 0 auto;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: 13px;
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-teal-dark, #2D6878);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: color 0.15s ease, text-decoration-thickness 0.15s ease;
    padding-bottom: clamp(6px, 0.8vw, 14px);
    white-space: nowrap;
  }

  @media (min-width: 750px) {
    .theinmag-blog-feed__seeall {
      font-size: 14px;
    }
  }

  .theinmag-blog-feed__seeall:hover,
  .theinmag-blog-feed__seeall:focus-visible {
    color: var(--color-purple-dark, #5D3A7A);
    text-decoration-thickness: 2px;
    outline: none;
  }

  /* Card grid: 1 col mobile, 2 col tablet, 4 col desktop. */
  .theinmag-blog-feed__cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg, 24px);
  }

  @media (min-width: 600px) {
    .theinmag-blog-feed__cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 990px) {
    .theinmag-blog-feed__cards {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-xl, 28px);
    }
  }

  .theinmag-blog-feed__card-wrap {
    display: flex;
  }

  /* Unified cream tile: image flush to top, body below, all clipped
     to a 20px rounded container. Subtle shadow lifts the tile off the
     cream section. */
  .theinmag-blog-feed__card {
    display: flex;
    flex-direction: column;
    flex: 1;
    text-decoration: none;
    color: inherit;
    background-color: var(--color-cream, #FBF6EA);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 1px 6px rgba(123, 79, 158, 0.08);
    transition: transform var(--transition-hover, 0.2s ease), box-shadow var(--transition-hover, 0.2s ease);
  }

  .theinmag-blog-feed__card:hover,
  .theinmag-blog-feed__card:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 4px 20px rgba(123, 79, 158, 0.16);
    outline: none;
  }

  .theinmag-blog-feed__card:focus-visible {
    box-shadow: 0 0 0 3px var(--color-purple-dark, #5D3A7A), 0 4px 20px rgba(123, 79, 158, 0.16);
  }

  .theinmag-blog-feed__cover {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background-color: #E8DEEF;
  }

  .theinmag-blog-feed__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .theinmag-blog-feed__card:hover .theinmag-blog-feed__image,
  .theinmag-blog-feed__card:focus-visible .theinmag-blog-feed__image {
    transform: scale(1.03);
  }

  .theinmag-blog-feed__cover-placeholder {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #5D3A7A 0%, #C9543E 100%);
  }

  /* Bottom-only scrim now that the title's left the overlay - just
     enough darkness for the topic label to read against bright art. */
  .theinmag-blog-feed__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 55%,
      rgba(0, 0, 0, 0.55) 100%
    );
    pointer-events: none;
  }

  .theinmag-blog-feed__topic {
    position: absolute;
    bottom: clamp(14px, 1.6vw, 18px);
    left: clamp(14px, 1.6vw, 18px);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #FFFFFF;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.55);
  }

  @media (min-width: 750px) {
    .theinmag-blog-feed__topic {
      font-size: 12px;
    }
  }

  /* Body: title + excerpt stacked under the cover. */
  .theinmag-blog-feed__body {
    display: flex;
    flex-direction: column;
    gap: clamp(8px, 1vw, 12px);
    padding: clamp(16px, 1.8vw, 22px);
    flex: 1;
  }

  .theinmag-blog-feed__title {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: clamp(17px, 1.6vw, 21px);
    line-height: 1.22;
    letter-spacing: -0.005em;
    color: var(--color-inky-purple-navy, #2A1F3D);
    /* Two-line clamp keeps card heights even across the row. */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (min-width: 990px) {
    .theinmag-blog-feed__title {
      -webkit-line-clamp: 2;
    }
  }

  .theinmag-blog-feed__excerpt {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-inky-purple-navy, #2A1F3D);
    opacity: 0.78;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (min-width: 990px) {
    .theinmag-blog-feed__excerpt {
      font-size: 13.5px;
      -webkit-line-clamp: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-blog-feed__card,
    .theinmag-blog-feed__image,
    .theinmag-blog-feed__seeall {
      transition: none;
    }
    .theinmag-blog-feed__card:hover,
    .theinmag-blog-feed__card:focus-visible {
      transform: none;
    }
    .theinmag-blog-feed__card:hover .theinmag-blog-feed__image,
    .theinmag-blog-feed__card:focus-visible .theinmag-blog-feed__image {
      transform: none;
    }
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "theINside feed",
  "tag": "section",
  "class": "theinmag-blog-feed-section",
  "settings": [
    {
      "type": "header",
      "content": "Heading (split into four parts so 'IN' lifts visually)"
    },
    {
      "type": "text",
      "id": "heading_pre",
      "label": "Pre (small)",
      "default": "the"
    },
    {
      "type": "text",
      "id": "heading_emphasis",
      "label": "Emphasis (large)",
      "default": "IN"
    },
    {
      "type": "text",
      "id": "heading_post",
      "label": "Post (small)",
      "default": "side"
    },
    {
      "type": "text",
      "id": "heading_period",
      "label": "Punctuation (large)",
      "default": "."
    },
    {
      "type": "text",
      "id": "subhead",
      "label": "Subhead (optional)",
      "default": "Field notes from the road, the classroom, and the kitchen table."
    },
    {
      "type": "header",
      "content": "See all blogs link"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show 'see all blogs' link",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Link label",
      "default": "see all blogs"
    },
    {
      "type": "text",
      "id": "cta_link",
      "label": "Link path",
      "default": "/blogs/theinside",
      "info": "Internal path, e.g. /blogs/theinside."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "featured_post",
      "name": "Post card",
      "limit": 4,
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "Article",
          "info": "Pick a Shopify article. Title, excerpt, image and topic auto-fill from it. Override below if needed."
        },
        {
          "type": "text",
          "id": "topic",
          "label": "Topic label (optional)",
          "info": "Small uppercase label overlaid bottom-left of the cover (e.g. Creativity, Numeracy). Falls back to the article's first tag."
        },
        {
          "type": "text",
          "id": "title_override",
          "label": "Title override (optional)",
          "info": "Sentence-case lowercase with a full stop matches the editorial register."
        },
        {
          "type": "textarea",
          "id": "excerpt_override",
          "label": "Excerpt override (optional)",
          "info": "Two to three lines max - sits below the title. Falls back to article excerpt or first ~24 words of body."
        },
        {
          "type": "text",
          "id": "link_override",
          "label": "Link override (optional)",
          "info": "Internal path used when no article is picked."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Cover image"
        },
        {
          "type": "text",
          "id": "fallback_filename",
          "label": "Cover image fallback filename",
          "info": "Used when the image picker is empty. Filename of an image in /assets/."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Cover image alt text",
          "info": "Describe the kid creation. Falls back to the article's image alt or the title."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "theINside feed",
      "blocks": [
        { "type": "featured_post" },
        { "type": "featured_post" },
        { "type": "featured_post" },
        { "type": "featured_post" }
      ]
    }
  ]
}
{% endschema %}
