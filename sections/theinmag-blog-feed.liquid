{%- comment -%}
  theinmag-blog-feed
  Four-up post card row anchoring the homepage to the theINside blog.
  Maude-faithful editorial layout: heading left + "see all" link right
  in the header row, cards below.

  Each card is a 4:5 portrait cover with title + topic overlaid in
  white-on-scrim (per the design tokens premium-photo-text rule),
  followed only by a short excerpt below the image.

  Cards prefer a chosen Shopify article; fall back to manual overrides
  (title/excerpt/image/link) so the row renders before the blog exists
  in admin.
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading
  assign cta_label = section.settings.cta_label
  assign cta_link = section.settings.cta_link
  assign show_cta = section.settings.show_cta
-%}

<section
  class="theinmag-blog-feed"
  aria-labelledby="theinmag-blog-feed-heading"
  style="--blog-feed-pt: {{ section.settings.padding_top }}px; --blog-feed-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="theinmag-blog-feed__inner">
    <header class="theinmag-blog-feed__header">
      <h2 id="theinmag-blog-feed-heading" class="theinmag-blog-feed__heading">{{ heading }}</h2>
      {%- if show_cta and cta_label != blank and cta_link != blank -%}
        <a class="theinmag-blog-feed__seeall" href="{{ cta_link }}">
          {{ cta_label }} <span aria-hidden="true">&rarr;</span>
        </a>
      {%- endif -%}
    </header>

    {%- if section.blocks.size > 0 -%}
      <ul class="theinmag-blog-feed__cards" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign article = block.settings.article

            assign title = block.settings.title_override
            if title == blank and article != blank
              assign title = article.title
            endif

            assign excerpt = block.settings.excerpt_override
            if excerpt == blank and article != blank
              assign excerpt = article.excerpt | strip_html
              if excerpt == blank
                assign excerpt = article.content | strip_html | truncatewords: 24
              endif
            endif

            assign topic = block.settings.topic
            if topic == blank and article != blank
              assign topic = article.tags.first
            endif

            assign card_link = block.settings.link_override
            if card_link == blank and article != blank
              assign card_link = article.url
            endif

            assign image_src = ''
            if block.settings.image != blank
              assign image_src = block.settings.image | image_url: width: 1200
            elsif block.settings.fallback_filename != blank
              assign image_src = block.settings.fallback_filename | asset_url
            elsif article != blank and article.image != blank
              assign image_src = article.image | image_url: width: 1200
            endif

            assign image_alt = block.settings.image_alt
            if image_alt == blank and article != blank and article.image != blank
              assign image_alt = article.image.alt | default: article.title
            endif
            if image_alt == blank
              assign image_alt = title
            endif
          -%}
          <li class="theinmag-blog-feed__card-wrap" {{ block.shopify_attributes }}>
            {%- if card_link != blank -%}
              <a class="theinmag-blog-feed__card" href="{{ card_link }}">
            {%- else -%}
              <div class="theinmag-blog-feed__card">
            {%- endif -%}
              <span class="theinmag-blog-feed__cover">
                {%- if image_src != blank -%}
                  <img
                    class="theinmag-blog-feed__image"
                    src="{{ image_src }}"
                    alt="{{ image_alt | escape }}"
                    loading="lazy"
                    width="1200"
                    height="1500"
                  >
                {%- else -%}
                  <span class="theinmag-blog-feed__cover-placeholder" aria-hidden="true"></span>
                {%- endif -%}
                <span class="theinmag-blog-feed__scrim" aria-hidden="true"></span>
                {%- if title != blank -%}
                  <span class="theinmag-blog-feed__title">{{ title }}</span>
                {%- endif -%}
                {%- if topic != blank -%}
                  <span class="theinmag-blog-feed__topic">{{ topic }}</span>
                {%- endif -%}
              </span>
              {%- if excerpt != blank -%}
                <span class="theinmag-blog-feed__excerpt">{{ excerpt }}</span>
              {%- endif -%}
            {%- if card_link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{%- stylesheet -%}
  .theinmag-blog-feed {
    background-color: var(--color-cream, #FBF6EA);
    color: var(--color-inky-purple-navy, #2A1F3D);
    padding: var(--blog-feed-pt, 64px) clamp(16px, 3vw, 32px) var(--blog-feed-pb, 64px);
  }

  .theinmag-blog-feed__inner {
    max-width: 1320px;
    margin: 0 auto;
  }

  /* Header row: heading left, see-all right, baseline-aligned. Tight
     bottom margin so cards sit close to the heading per the Maude
     reference. */
  .theinmag-blog-feed__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-md, 16px);
    margin-bottom: clamp(20px, 2.4vw, 32px);
  }

  .theinmag-blog-feed__heading {
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-size: clamp(40px, 6vw, 72px);
    line-height: 1;
    letter-spacing: 0;
    margin: 0;
    color: var(--color-inky-purple-navy, #2A1F3D);
    white-space: nowrap;
  }

  .theinmag-blog-feed__seeall {
    flex: 0 0 auto;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: 13px;
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-teal-dark, #2D6878);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    transition: color 0.15s ease, text-decoration-thickness 0.15s ease;
    /* Lift slightly off the baseline so it sits visually centred against
       the very large heading rather than dragging to the heading's
       descender line. */
    padding-bottom: clamp(6px, 0.8vw, 14px);
  }

  @media (min-width: 750px) {
    .theinmag-blog-feed__seeall {
      font-size: 14px;
    }
  }

  .theinmag-blog-feed__seeall:hover,
  .theinmag-blog-feed__seeall:focus-visible {
    color: var(--color-purple-dark, #5D3A7A);
    text-decoration-thickness: 2px;
    outline: none;
  }

  /* Card grid: 1 col mobile, 2 col tablet, 4 col desktop. */
  .theinmag-blog-feed__cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg, 24px);
  }

  @media (min-width: 600px) {
    .theinmag-blog-feed__cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 990px) {
    .theinmag-blog-feed__cards {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-xl, 28px);
    }
  }

  .theinmag-blog-feed__card-wrap {
    display: flex;
  }

  /* No card background or shadow - the rounded image is the card.
     Excerpt sits as plain text on the cream section below. */
  .theinmag-blog-feed__card {
    display: flex;
    flex-direction: column;
    flex: 1;
    text-decoration: none;
    color: inherit;
    gap: var(--space-md, 14px);
  }

  /* 4:5 portrait cover, rounded edges, scrim + overlay text. */
  .theinmag-blog-feed__cover {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 20px;
    background-color: #E8DEEF;
  }

  .theinmag-blog-feed__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .theinmag-blog-feed__card:hover .theinmag-blog-feed__image,
  .theinmag-blog-feed__card:focus-visible .theinmag-blog-feed__image {
    transform: scale(1.03);
  }

  .theinmag-blog-feed__cover-placeholder {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #5D3A7A 0%, #C9543E 100%);
  }

  /* Scrim: dark fade at top + bottom, transparent middle. Strong enough
     to anchor white text on busy/light kid art (orange/pink backgrounds
     are common). */
  .theinmag-blog-feed__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.55) 0%,
      rgba(0, 0, 0, 0.18) 28%,
      rgba(0, 0, 0, 0) 50%,
      rgba(0, 0, 0, 0.18) 72%,
      rgba(0, 0, 0, 0.55) 100%
    );
    pointer-events: none;
  }

  /* Title overlay: top-left, white, Inter bold. text-shadow adds the
     "lift" Ryan referenced - a subtle 1-2px drop softens the edge so
     the type detaches from the image. */
  .theinmag-blog-feed__title {
    position: absolute;
    top: clamp(14px, 1.6vw, 20px);
    left: clamp(14px, 1.6vw, 20px);
    right: clamp(14px, 1.6vw, 20px);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: clamp(17px, 1.6vw, 21px);
    line-height: 1.2;
    letter-spacing: -0.005em;
    color: #FFFFFF;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.55);
    /* Two-line clamp keeps the overlay from running into the topic
       label at the bottom. */
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Topic overlay: bottom-left, white, Inter 600 uppercase. */
  .theinmag-blog-feed__topic {
    position: absolute;
    bottom: clamp(14px, 1.6vw, 20px);
    left: clamp(14px, 1.6vw, 20px);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #FFFFFF;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.55);
  }

  @media (min-width: 750px) {
    .theinmag-blog-feed__topic {
      font-size: 12px;
    }
  }

  /* Excerpt: short tease below the rounded image. No body background,
     no shadow - sits as plain text on the cream section. */
  .theinmag-blog-feed__excerpt {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-inky-purple-navy, #2A1F3D);
    opacity: 0.78;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    padding: 0 4px;
  }

  @media (min-width: 990px) {
    .theinmag-blog-feed__excerpt {
      font-size: 13.5px;
      -webkit-line-clamp: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-blog-feed__image,
    .theinmag-blog-feed__seeall {
      transition: none;
    }
    .theinmag-blog-feed__card:hover .theinmag-blog-feed__image,
    .theinmag-blog-feed__card:focus-visible .theinmag-blog-feed__image {
      transform: none;
    }
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "theINside feed",
  "tag": "section",
  "class": "theinmag-blog-feed-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "theINside."
    },
    {
      "type": "header",
      "content": "See all posts link"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show 'see all posts' link",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Link label",
      "default": "see all posts"
    },
    {
      "type": "text",
      "id": "cta_link",
      "label": "Link path",
      "default": "/blogs/theinside",
      "info": "Internal path, e.g. /blogs/theinside."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "featured_post",
      "name": "Post card",
      "limit": 4,
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "Article",
          "info": "Pick a Shopify article. Title, excerpt, image and topic auto-fill from it. Override below if needed."
        },
        {
          "type": "text",
          "id": "topic",
          "label": "Topic label (optional)",
          "info": "Small uppercase label overlaid bottom-left of the cover (e.g. Creativity, Numeracy). Falls back to the article's first tag."
        },
        {
          "type": "text",
          "id": "title_override",
          "label": "Title override (optional)",
          "info": "Sentence-case lowercase with a full stop matches the editorial register."
        },
        {
          "type": "textarea",
          "id": "excerpt_override",
          "label": "Excerpt override (optional)",
          "info": "Two to three lines max - sits below the image. Falls back to article excerpt or first ~24 words of body."
        },
        {
          "type": "text",
          "id": "link_override",
          "label": "Link override (optional)",
          "info": "Internal path used when no article is picked."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Cover image"
        },
        {
          "type": "text",
          "id": "fallback_filename",
          "label": "Cover image fallback filename",
          "info": "Used when the image picker is empty. Filename of an image in /assets/."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Cover image alt text",
          "info": "Describe the kid creation. Falls back to the article's image alt or the title."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "theINside feed",
      "blocks": [
        { "type": "featured_post" },
        { "type": "featured_post" },
        { "type": "featured_post" },
        { "type": "featured_post" }
      ]
    }
  ]
}
{% endschema %}
