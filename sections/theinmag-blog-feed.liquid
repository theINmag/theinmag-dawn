{%- comment -%}
  theinmag-blog-feed
  Four-up post card row anchoring the homepage to the field notes blog.
  Maude-faithful editorial layout: heading left, audience filter chips
  + "see all blogs" pill button right.

  Heading is rendered as four spans so the brand pun (capitalised IN)
  shows typographically: "the" small + "IN" big + "side" small + "."
  big. Editor can change any of the four parts in admin.

  Audience chips are nav links - tapping one navigates to the blog
  index filtered by that audience (logic lives on the blog page, not
  here). The active chip is just a visual indicator of "this is the
  current view"; on the homepage card row "all" is always active.

  Each card is a unified cream tile (image + body in one rounded
  container). Topic label sits as a white overlay on the cover image
  bottom-left. Title and short excerpt sit in the body below.

  Cards prefer a chosen Shopify article; fall back to manual overrides
  (title/excerpt/image/link) so the row renders before the blog exists
  in admin.
{%- endcomment -%}

{%- liquid
  assign heading_pre = section.settings.heading_pre
  assign heading_emphasis = section.settings.heading_emphasis
  assign heading_post = section.settings.heading_post
  assign heading_period = section.settings.heading_period
  assign subhead = section.settings.subhead
  assign cta_label = section.settings.cta_label
  assign cta_link = section.settings.cta_link
  assign show_cta = section.settings.show_cta
  assign show_filters = section.settings.show_filters
  assign active_chip = section.settings.active_chip

  assign bg_src = ''
  if section.settings.background_image != blank
    assign bg_src = section.settings.background_image | image_url: width: 2400
  elsif section.settings.background_filename != blank
    assign bg_src = section.settings.background_filename | asset_url
  endif

  assign section_class = 'theinmag-blog-feed'
  if bg_src != blank
    assign section_class = 'theinmag-blog-feed theinmag-blog-feed--has-bg'
  endif

  assign section_style = '--blog-feed-pt: ' | append: section.settings.padding_top | append: 'px; --blog-feed-pb: ' | append: section.settings.padding_bottom | append: 'px;'
  if bg_src != blank
    assign section_style = section_style | append: " --blog-feed-bg: url('" | append: bg_src | append: "');"
  endif
-%}

<section
  class="{{ section_class }}"
  data-theinmag-blog-feed
  aria-labelledby="theinmag-blog-feed-heading"
  style="{{ section_style }}"
>
  <div class="theinmag-blog-feed__inner">
    <header class="theinmag-blog-feed__header">
      <div class="theinmag-blog-feed__title-stack">
        <h2 id="theinmag-blog-feed-heading" class="theinmag-blog-feed__heading">
          <a class="theinmag-blog-feed__heading-link" href="/blogs/field-notes" aria-label="Browse all field notes">
            <img
              src="{{ 'fieldnotes_logo.png' | asset_url }}"
              alt="Field notes"
              class="theinmag-blog-feed__heading-logo"
              width="2160"
              height="1440"
              loading="lazy"
            >
          </a>
        </h2>
        {%- if subhead != blank -%}
          <p class="theinmag-blog-feed__subhead">{{ subhead }}</p>
        {%- endif -%}
      </div>

      <div class="theinmag-blog-feed__nav">
        {%- if show_filters -%}
          <nav class="theinmag-blog-feed__filters" aria-label="Filter posts by audience">
            <a
              class="theinmag-blog-feed__chip{% if active_chip == 'all' %} is-active{% endif %}"
              data-filter="all"
              href="{{ section.settings.chip_all_link }}"
            >all</a>
            <a
              class="theinmag-blog-feed__chip{% if active_chip == 'kids' %} is-active{% endif %}"
              data-filter="kids"
              href="{{ section.settings.chip_kids_link }}"
            >kids</a>
            <a
              class="theinmag-blog-feed__chip{% if active_chip == 'adults' %} is-active{% endif %}"
              data-filter="adults"
              href="{{ section.settings.chip_adults_link }}"
            >adults</a>
          </nav>
        {%- endif -%}

        {%- if show_cta and cta_label != blank and cta_link != blank -%}
          <a class="theinmag-blog-feed__seeall" href="{{ cta_link }}">{{ cta_label }}</a>
        {%- endif -%}
      </div>
    </header>

    {%- if section.blocks.size > 0 -%}
      <ul class="theinmag-blog-feed__cards" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign article = block.settings.article

            assign title = block.settings.title_override
            if title == blank and article != blank
              assign title = article.title
            endif

            assign excerpt = block.settings.excerpt_override
            if excerpt == blank and article != blank
              assign excerpt = article.excerpt | strip_html
              if excerpt == blank
                assign excerpt = article.content | strip_html | truncatewords: 24
              endif
            endif

            assign topic = block.settings.topic
            if topic == blank and article != blank
              assign topic = article.tags.first
            endif

            assign card_link = block.settings.link_override
            if card_link == blank and article != blank
              assign card_link = article.url
            endif

            assign image_src = ''
            if block.settings.image != blank
              assign image_src = block.settings.image | image_url: width: 1200
            elsif block.settings.fallback_filename != blank
              assign image_src = block.settings.fallback_filename | asset_url
            elsif article != blank and article.image != blank
              assign image_src = article.image | image_url: width: 1200
            endif

            assign image_alt = block.settings.image_alt
            if image_alt == blank and article != blank and article.image != blank
              assign image_alt = article.image.alt | default: article.title
            endif
            if image_alt == blank
              assign image_alt = title
            endif
          -%}
          <li class="theinmag-blog-feed__card-wrap" data-audience="{{ block.settings.audience | default: 'both' }}" {{ block.shopify_attributes }}>
            {%- if card_link != blank -%}
              <a class="theinmag-blog-feed__card" href="{{ card_link }}">
            {%- else -%}
              <div class="theinmag-blog-feed__card">
            {%- endif -%}
              <span class="theinmag-blog-feed__cover">
                {%- if image_src != blank -%}
                  <img
                    class="theinmag-blog-feed__image"
                    src="{{ image_src }}"
                    alt="{{ image_alt | escape }}"
                    loading="lazy"
                    width="1200"
                    height="1500"
                  >
                {%- else -%}
                  <span class="theinmag-blog-feed__cover-placeholder" aria-hidden="true"></span>
                {%- endif -%}
                <span class="theinmag-blog-feed__scrim" aria-hidden="true"></span>
                {%- if topic != blank -%}
                  <span class="theinmag-blog-feed__topic">{{ topic }}</span>
                {%- endif -%}
              </span>
              <span class="theinmag-blog-feed__body">
                {%- if title != blank -%}
                  <span class="theinmag-blog-feed__title">{{ title }}</span>
                {%- endif -%}
                {%- if excerpt != blank -%}
                  <span class="theinmag-blog-feed__excerpt">{{ excerpt }}</span>
                {%- endif -%}
              </span>
            {%- if card_link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      <p class="theinmag-blog-feed__empty" data-empty hidden>Nothing here yet for that view. Try another filter.</p>
    {%- endif -%}
  </div>
</section>

<script>
(function () {
  var root = document.querySelector('[data-theinmag-blog-feed]');
  if (!root) return;
  var chips = root.querySelectorAll('[data-filter]');
  var cards = root.querySelectorAll('[data-audience]');
  var empty = root.querySelector('[data-empty]');

  function applyFilter(filter) {
    var visible = 0;
    chips.forEach(function (chip) {
      chip.classList.toggle('is-active', chip.dataset.filter === filter);
    });
    cards.forEach(function (card) {
      var audience = card.dataset.audience || 'both';
      var show = filter === 'all' || audience === 'both' || audience === filter;
      card.hidden = !show;
      if (show) visible++;
    });
    if (empty) empty.hidden = visible > 0;
  }

  chips.forEach(function (chip) {
    chip.addEventListener('click', function (e) {
      e.preventDefault();
      applyFilter(chip.dataset.filter);
    });
  });
})();
</script>

{%- stylesheet -%}
  .theinmag-blog-feed {
    background-color: var(--color-cream, #FBF6EA);
    color: var(--color-inky-purple-navy, #2A1F3D);
    padding: var(--blog-feed-pt, 64px) clamp(16px, 3vw, 32px) var(--blog-feed-pb, 64px);
  }

  /* When a background image is set: the coral painterly art sits as
     a decorative frame around the cream panel below. No scrim now -
     the panel insulates the content so the bg can stay rich. */
  .theinmag-blog-feed--has-bg {
    background-image: var(--blog-feed-bg);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  /* The cream panel that holds heading, filter row, and the four
     tiles. When a bg is set the panel pops off the coral; without a
     bg it sits flush on the section's cream background, just slightly
     lifted by its shadow. Mission-row sibling treatment. */
  .theinmag-blog-feed__inner {
    max-width: 1320px;
    margin: 0 auto;
    background-color: var(--color-cream, #FBF6EA);
    padding: clamp(14px, 2vw, 28px) clamp(20px, 4vw, 56px) clamp(28px, 4vw, 56px);
    box-shadow: 0 8px 32px rgba(123, 79, 158, 0.12);
  }

  /* Header row: title-stack on the left, nav cluster (filters + see-all
     pill) on the right. Stacks vertically on narrow viewports. */
  .theinmag-blog-feed__header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    /* Tighter gap on mobile so the chips sit close to the wordmark. */
    gap: clamp(2px, 0.6vw, 12px);
    margin-bottom: clamp(8px, 1.4vw, 18px);
  }

  @media (min-width: 750px) {
    .theinmag-blog-feed__header {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-md, 16px);
    }
  }

  .theinmag-blog-feed__title-stack {
    display: flex;
    flex-direction: column;
    gap: clamp(4px, 0.6vw, 8px);
    min-width: 0;
    /* Indent the wordmark off the panel's left edge so it doesn't
       sit flush against the corner. */
    margin-left: clamp(8px, 3vw, 64px);
  }

  /* Heading composes four spans so the brand pun (capitalised IN) reads
     typographically: small "the" + big "IN" + small "side" + big ".".
     Parent font-size is the BIG size; aux scales down via em. */
  .theinmag-blog-feed__heading {
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    /* Mobile floor bumped from 56 to 72 so the wordmark feels
       proportionate to the section on phone widths. */
    font-size: clamp(72px, 9vw, 104px);
    line-height: 0.95;
    letter-spacing: 0;
    margin: 0;
    color: var(--color-inky-purple-navy, #2A1F3D);
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
  }

  .theinmag-blog-feed__heading-aux {
    font-size: 0.42em;
    line-height: 1;
    transform: translateY(-0.04em);
    margin: 0 0.04em;
  }

  .theinmag-blog-feed__heading-main,
  .theinmag-blog-feed__heading-period {
    font-size: 1em;
    line-height: 1;
  }

  .theinmag-blog-feed__heading-period {
    margin-left: -0.02em;
  }

  .theinmag-blog-feed__heading-logo {
    display: block;
    height: 1em;
    width: auto;
    flex: 0 0 auto;
  }

  /* Wrapping the logo in an anchor to /blogs/field-notes — styles
     keep the image as the only visible affordance (no underline,
     no inherited color), with a soft hover lift to signal it's
     interactive. Focus ring kept for keyboard nav. */
  .theinmag-blog-feed__heading-link {
    display: inline-block;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .theinmag-blog-feed__heading-link:hover,
  .theinmag-blog-feed__heading-link:focus-visible {
    transform: translateY(-1px);
    opacity: 0.92;
    outline: none;
  }

  .theinmag-blog-feed__heading-link:focus-visible {
    outline: 2px dashed var(--color-purple-dark, #5D3A7A);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .theinmag-blog-feed__subhead {
    margin: 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: clamp(13px, 1.3vw, 15px);
    line-height: 1.5;
    color: var(--color-inky-purple-navy, #2A1F3D);
    opacity: 0.7;
    max-width: 60ch;
  }

  /* Nav cluster: filter chips + see-all pill, grouped on the right of
     the header on desktop. */
  .theinmag-blog-feed__nav {
    display: flex;
    align-items: center;
    gap: clamp(20px, 3vw, 36px);
    flex-wrap: wrap;
    /* Mirror the heading's left indent so both sides sit evenly off
       the panel edges. */
    margin-right: clamp(8px, 3vw, 64px);
  }

  /* Filter chips: muted text links, active one in full ink + bolder. */
  .theinmag-blog-feed__filters {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, 22px);
  }

  .theinmag-blog-feed__chip {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 500;
    font-size: clamp(20px, 2.4vw, 28px);
    line-height: 1;
    letter-spacing: -0.005em;
    color: var(--color-inky-purple-navy, #2A1F3D);
    text-decoration: none;
    opacity: 0.42;
    transition: opacity 0.15s ease;
  }

  .theinmag-blog-feed__chip:hover,
  .theinmag-blog-feed__chip:focus-visible {
    opacity: 0.85;
    outline: none;
  }

  .theinmag-blog-feed__chip.is-active {
    opacity: 1;
    font-weight: 600;
  }

  /* See-all pill: outlined dark teal (the section's accent), 32px pill
     to match the brand's button shape language. Lowercase + Inter 600
     for the editorial register. */
  .theinmag-blog-feed__seeall {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    color: var(--color-teal-dark, #2D6878);
    border: 2px solid var(--color-teal-dark, #2D6878);
    border-radius: 32px;
    padding: 10px 22px;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: 13px;
    line-height: 1;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
    min-height: 40px;
    white-space: nowrap;
  }

  @media (min-width: 750px) {
    .theinmag-blog-feed__seeall {
      padding: 12px 26px;
      font-size: 14px;
      min-height: 44px;
    }
  }

  .theinmag-blog-feed__seeall:hover,
  .theinmag-blog-feed__seeall:focus-visible {
    background-color: var(--color-teal-dark, #2D6878);
    color: #FFFFFF;
    outline: none;
  }

  /* Card grid: 1 col mobile, 2 col tablet, 4 col desktop. */
  .theinmag-blog-feed__cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg, 24px);
  }

  @media (min-width: 600px) {
    .theinmag-blog-feed__cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 990px) {
    .theinmag-blog-feed__cards {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-xl, 28px);
    }
  }

  .theinmag-blog-feed__card-wrap {
    display: flex;
  }

  .theinmag-blog-feed__card-wrap[hidden] {
    display: none;
  }

  .theinmag-blog-feed__empty {
    margin: 0;
    padding: var(--space-xl, 32px);
    text-align: center;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-size: 15px;
    color: var(--color-inky-purple-navy, #2A1F3D);
    opacity: 0.7;
  }

  /* Tiles get their own cream background + shadow back so they read
     as discrete tiles against the cream panel. Stronger shadow than
     before since both are cream - the shadow defines the tile edge. */
  .theinmag-blog-feed__card {
    display: flex;
    flex-direction: column;
    flex: 1;
    text-decoration: none;
    color: inherit;
    background-color: var(--color-cream, #FBF6EA);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(123, 79, 158, 0.14);
    transition: transform var(--transition-hover, 0.2s ease), box-shadow var(--transition-hover, 0.2s ease);
  }

  .theinmag-blog-feed__card:hover,
  .theinmag-blog-feed__card:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 6px 24px rgba(123, 79, 158, 0.22);
    outline: none;
  }

  .theinmag-blog-feed__card:focus-visible {
    box-shadow: 0 0 0 3px var(--color-purple-dark, #5D3A7A), 0 6px 24px rgba(123, 79, 158, 0.22);
  }

  .theinmag-blog-feed__cover {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background-color: #E8DEEF;
  }

  .theinmag-blog-feed__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .theinmag-blog-feed__card:hover .theinmag-blog-feed__image,
  .theinmag-blog-feed__card:focus-visible .theinmag-blog-feed__image {
    transform: scale(1.03);
  }

  .theinmag-blog-feed__cover-placeholder {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #5D3A7A 0%, #C9543E 100%);
  }

  .theinmag-blog-feed__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 55%,
      rgba(0, 0, 0, 0.55) 100%
    );
    pointer-events: none;
  }

  .theinmag-blog-feed__topic {
    position: absolute;
    bottom: clamp(14px, 1.6vw, 18px);
    left: clamp(14px, 1.6vw, 18px);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #FFFFFF;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.55);
  }

  @media (min-width: 750px) {
    .theinmag-blog-feed__topic {
      font-size: 12px;
    }
  }

  .theinmag-blog-feed__body {
    display: flex;
    flex-direction: column;
    gap: clamp(8px, 1vw, 12px);
    padding: clamp(16px, 1.8vw, 22px);
    flex: 1;
  }

  .theinmag-blog-feed__title {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: clamp(17px, 1.6vw, 21px);
    line-height: 1.22;
    letter-spacing: -0.005em;
    color: var(--color-inky-purple-navy, #2A1F3D);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (min-width: 990px) {
    .theinmag-blog-feed__title {
      -webkit-line-clamp: 2;
    }
  }

  .theinmag-blog-feed__excerpt {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-inky-purple-navy, #2A1F3D);
    opacity: 0.78;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (min-width: 990px) {
    .theinmag-blog-feed__excerpt {
      font-size: 13.5px;
      -webkit-line-clamp: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-blog-feed__card,
    .theinmag-blog-feed__image,
    .theinmag-blog-feed__seeall,
    .theinmag-blog-feed__chip {
      transition: none;
    }
    .theinmag-blog-feed__card:hover,
    .theinmag-blog-feed__card:focus-visible {
      transform: none;
    }
    .theinmag-blog-feed__card:hover .theinmag-blog-feed__image,
    .theinmag-blog-feed__card:focus-visible .theinmag-blog-feed__image {
      transform: none;
    }
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "field notes feed",
  "tag": "section",
  "class": "theinmag-blog-feed-section",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading_pre",
      "label": "Pre (small)",
      "default": "field"
    },
    {
      "type": "text",
      "id": "heading_emphasis",
      "label": "Emphasis (large)",
      "default": "notes"
    },
    {
      "type": "text",
      "id": "heading_post",
      "label": "Post (small, optional)"
    },
    {
      "type": "text",
      "id": "heading_period",
      "label": "Punctuation (large)"
    },
    {
      "type": "text",
      "id": "subhead",
      "label": "Subhead (optional)"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "background_filename",
      "label": "Background fallback filename",
      "info": "Used when the image picker is empty. Filename of an image in /assets/."
    },
    {
      "type": "header",
      "content": "Audience filter chips"
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show filter chips",
      "default": true
    },
    {
      "type": "radio",
      "id": "active_chip",
      "label": "Active chip",
      "options": [
        { "value": "all", "label": "all" },
        { "value": "kids", "label": "kids" },
        { "value": "adults", "label": "adults" }
      ],
      "default": "all"
    },
    {
      "type": "text",
      "id": "chip_all_link",
      "label": "'all' link",
      "default": "/blogs/field-notes"
    },
    {
      "type": "text",
      "id": "chip_kids_link",
      "label": "'kids' link",
      "default": "/blogs/field-notes?audience=kids"
    },
    {
      "type": "text",
      "id": "chip_adults_link",
      "label": "'adults' link",
      "default": "/blogs/field-notes?audience=adults"
    },
    {
      "type": "header",
      "content": "See all blogs button"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show 'see all blogs' button",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "see all blogs"
    },
    {
