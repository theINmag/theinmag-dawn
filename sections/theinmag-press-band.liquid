{%- comment -%}
  theinmag-press-band
  Horizontal infinitely-scrolling band of press mentions that sits
  between the mission/products section and the audience tiles. Format
  is "[heading] [logo] [heading] [logo] ..." sliding right-to-left at
  a slow constant speed. Pauses on hover. With prefers-reduced-motion
  the animation flips off and the items wrap into a centred static
  row instead.

  The heading is "Seen IN" by default - the IN capitalised to match
  the theINmag / INfo / INkids / Send IN family. "Featured in" reads
  too corporate; "Seen IN" is friendlier for a kids' brand and the
  capitalised IN is a quiet brand-pun moment. Editable in the theme
  editor if the wording needs to change.

  Logos are blocks - admin can add as many as needed. Each block
  accepts either an image picker upload or a fallback filename in
  /assets/. The JS clones the rendered set once into the same track
  so the scroll loops seamlessly.

  Spec: ../theinmag-docs/theinmag-design-tokens.md (cream bg, generous vertical pad,
  prefers-reduced-motion respected). Press logo source spec lives in
  ../theinmag-docs/homepage-build-spec.md Section 3.
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading | default: 'Seen IN'
  assign blocks = section.blocks | where: 'type', 'press_logo'
-%}

<section
  class="theinmag-press-band"
  data-theinmag-press-band
  aria-labelledby="theinmag-press-heading"
>
  <h2 id="theinmag-press-heading" class="theinmag-press-band__a11y-heading">Where has theINmag been seen?</h2>

  {%- if blocks.size > 0 -%}
    <div class="theinmag-press-band__viewport">
      <div class="theinmag-press-band__track" data-theinmag-press-track>
        {%- for block in blocks -%}
          {%- liquid
            assign src = ''
            if block.settings.image != blank
              assign src = block.settings.image | image_url: width: 600
            elsif block.settings.fallback_filename != blank
              assign src = block.settings.fallback_filename | asset_url
            endif
          -%}
          {%- if src != blank -%}
            {%- assign size_class = block.settings.size | default: 'regular' -%}
            <div class="theinmag-press-band__item" {{ block.shopify_attributes }}>
              <span class="theinmag-press-band__heading">{{ heading }}</span>
              <img
                class="theinmag-press-band__logo theinmag-press-band__logo--{{ size_class }}"
                src="{{ src }}"
                alt="{{ block.settings.alt | default: 'theINmag press mention' }}"
                loading="lazy"
                width="200"
                height="60"
              >
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{%- stylesheet -%}
  /* ================================================================
     theinmag-press-band
     Cream background, slow right-to-left scroll, pauses on hover.
     ================================================================ */

  .theinmag-press-band {
    background-color: var(--color-cream, #FBF6EA);
    color: var(--color-inky-purple-navy, #2A1F3D);
    /* Top padding tighter than bottom so the band sits closer to the
       sand panel above. Bottom keeps generous breathing room before
       the audience tiles. */
    padding: clamp(12px, 1.6vw, 24px) 0 clamp(28px, 4vw, 56px);
    overflow: hidden;
  }

  .theinmag-press-band__a11y-heading {
    /* AEO heading is question-format per house style, but the visible UI
       is the rolling band so the heading itself is hidden. */
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .theinmag-press-band__viewport {
    /* Wraps the track. width:100% with overflow:hidden creates the
       window through which the track scrolls. */
    width: 100%;
    overflow: hidden;
  }

  .theinmag-press-band__track {
    display: flex;
    align-items: center;
    /* width: max-content lets the flex items lay out at their natural
       width instead of squishing into the viewport. */
    width: max-content;
    gap: clamp(32px, 4vw, 64px);
    padding: 0 clamp(16px, 2vw, 32px);
    /* Scroll right-to-left at a constant rate. Animation duration is
       chosen so each logo takes ~4-5s to cross the viewport on a
       typical 1280px screen. JS duplicates the set so the -50% end
       point lands exactly where the original first item sat at start. */
    animation: theinmag-press-scroll 60s linear infinite;
  }

  .theinmag-press-band:hover .theinmag-press-band__track {
    animation-play-state: paused;
  }

  .theinmag-press-band__item {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2vw, 28px);
    flex-shrink: 0;
  }

  .theinmag-press-band__heading {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 500;
    font-size: clamp(14px, 1.4vw, 17px);
    letter-spacing: 0.02em;
    color: var(--color-inky-purple-navy, #2A1F3D);
    opacity: 0.75;
    white-space: nowrap;
  }

  /* Brand pun: capitalise just the IN in "Seen IN". Hooked off a
     nested span inside the heading - same approach the announcement
     bar uses for its hand-lettered hooks. The default heading "Seen IN"
     already has the right casing inline, so this is a CSS no-op unless
     admin wraps a span in the editor. */
  .theinmag-press-band__heading strong {
    font-family: var(--font-heading);
    font-weight: 400;
  }

  .theinmag-press-band__logo {
    display: block;
    height: clamp(36px, 4vw, 56px);
    width: auto;
    max-width: 200px;
    object-fit: contain;
    /* Logos arrive in their original brand colours. Drop saturation +
       knock to monochrome inky purple-navy so the band reads as a
       cohesive theINmag surface rather than a colour explosion. */
    filter: grayscale(1) brightness(0.4) opacity(0.85);
    transition: filter 0.2s ease;
  }

  /* Per-block size boost - circular/square logos look smaller than wide
     wordmarks at the same height, so admins can mark specific blocks
     "Large" in the editor to bring them into balance. */
  .theinmag-press-band__logo--large {
    height: clamp(50px, 5.5vw, 76px);
    max-width: 240px;
  }

  .theinmag-press-band__item:hover .theinmag-press-band__logo {
    filter: grayscale(0) brightness(1) opacity(1);
  }

  @keyframes theinmag-press-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* Reduced motion: kill the scroll, kill the hover filter pop, lay
     the items out in a centred static row. */
  @media (prefers-reduced-motion: reduce) {
    .theinmag-press-band__track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
    }

    .theinmag-press-band__logo {
      transition: none;
    }
  }
{%- endstylesheet -%}

<script>
  (function () {
    const track = document.querySelector('[data-theinmag-press-track]');
    if (!track || track.children.length === 0) return;

    /* Duplicate the rendered items once so the -50% animation end-point
       lands exactly where the original first item began - giving a
       seamless loop. The clones are aria-hidden so screen readers don't
       hear the press list twice. */
    const items = Array.from(track.children);
    items.forEach(function (item) {
      const clone = item.cloneNode(true);
      clone.setAttribute('aria-hidden', 'true');
      track.appendChild(clone);
    });
  })();
</script>

{% schema %}
{
  "name": "theINmag press band",
  "tag": "section",
  "class": "theinmag-press-band-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Seen IN",
      "info": "Repeats alongside each logo. \"Seen IN\" matches the brand-IN capitalisation; \"Featured in\" or similar also work."
    }
  ],
  "blocks": [
    {
      "type": "press_logo",
      "name": "Press logo",
      "limit": 16,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo image"
        },
        {
          "type": "text",
          "id": "fallback_filename",
          "label": "Fallback filename",
          "info": "Used when the image picker is empty. Filename of an image in /assets/ - e.g. \"press-mediaweek.png\"."
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text",
          "info": "Publication name."
        },
        {
          "type": "select",
          "id": "size",
          "label": "Logo size",
          "info": "Use Large for circular or square logos that look small at the default height.",
          "options": [
            { "value": "regular", "label": "Regular" },
            { "value": "large", "label": "Large" }
          ],
          "default": "regular"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "theINmag press band",
      "blocks": [
        { "type": "press_logo", "settings": { "fallback_filename": "press-1.png", "alt": "Press mention" } },
        { "type": "press_logo", "settings": { "fallback_filename": "press-2.png", "alt": "Press mention" } },
        { "type": "press_logo", "settings": { "fallback_filename": "press-3.png", "alt": "Press mention" } },
        { "type": "press_logo", "settings": { "fallback_filename": "press-4.png", "alt": "Press mention" } },
        { "type": "press_logo", "settings": { "fallback_filename": "press-5.png", "alt": "Press mention" } },
        { "type": "press_logo", "settings": { "fallback_filename": "press-6.png", "alt": "Press mention" } }
      ]
    }
  ]
}
{% endschema %}
