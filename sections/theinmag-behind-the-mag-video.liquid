{%- comment -%}
  theinmag-behind-the-mag-video
  "Wait - why's it called theINmag?" moment. Split layout: copy on
  the LEFT, portrait video on the RIGHT. Sized so the whole moment
  fits on a Pixel 6 viewport (412x915) without scrolling - desktop
  spreads out to a more generous side-by-side.

  Video accepts either a Shopify CDN MP4 URL (recommended for
  portrait clips like this one) or a YouTube ID. MP4 path uses
  preload="none" so the bytes only download when a visitor presses
  play; a poster JPG paints the still-frame on first paint.
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading | default: "Wait - why's it called theINmag?"
  assign subhead = section.settings.subhead | default: 'Glad you asked'

  assign yt_input = section.settings.youtube_id | strip
  assign yt_id = ''
  if yt_input contains 'youtu'
    assign url_after_v = yt_input | split: 'v=' | last | split: '&' | first
    if url_after_v != yt_input
      assign yt_id = url_after_v
    else
      assign yt_id = yt_input | split: 'youtu.be/' | last | split: '?' | first
    endif
  else
    assign yt_id = yt_input
  endif

  assign mp4_url = section.settings.mp4_url | strip

  assign poster_src = ''
  if section.settings.poster_image != blank
    assign poster_src = section.settings.poster_image | image_url: width: 1080
  elsif section.settings.poster_filename != blank
    assign poster_src = section.settings.poster_filename | asset_url
  endif

  assign poster_alt = section.settings.poster_alt | default: 'Tam and Ryan in front of the van talking about why it is called theINmag.'
-%}

<section
  class="theinmag-bm-video"
  data-theinmag-bm-video
  aria-labelledby="theinmag-bm-video-heading"
>
  <div class="theinmag-bm-video__inner">
    <div class="theinmag-bm-video__copy">
      <h2 id="theinmag-bm-video-heading" class="theinmag-bm-video__heading">{{ heading }}</h2>
      {%- if subhead != blank -%}
        <p class="theinmag-bm-video__subhead">{{ subhead }}</p>
      {%- endif -%}
    </div>

    <div
      class="theinmag-bm-video__frame"
      data-bm-video-frame
      data-yt-id="{{ yt_id | escape }}"
      data-mp4-url="{{ mp4_url | escape }}"
    >
      {%- if poster_src != blank -%}
        <button
          type="button"
          class="theinmag-bm-video__poster"
          data-bm-video-trigger
          aria-label="Play video: {{ heading | escape }}"
        >
          <img
            class="theinmag-bm-video__poster-image"
            src="{{ poster_src }}"
            alt="{{ poster_alt | escape }}"
            loading="lazy"
            width="1080"
            height="1920"
          >
          <span class="theinmag-bm-video__play" aria-hidden="true">
            <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="32" cy="32" r="32" fill="#F9C23C"/>
              <polygon points="26 20 46 32 26 44" fill="#2A1F3D"/>
            </svg>
          </span>
        </button>
      {%- elsif mp4_url != blank -%}
        {%- comment -%}
          No poster but we do have an MP4. Use the video element with
          preload="metadata" so the first frame paints without
          downloading the whole file. Click overlay still drives play.
        {%- endcomment -%}
        <button
          type="button"
          class="theinmag-bm-video__poster theinmag-bm-video__poster--no-poster"
          data-bm-video-trigger
          aria-label="Play video: {{ heading | escape }}"
        >
          <video
            class="theinmag-bm-video__poster-image"
            src="{{ mp4_url }}"
            preload="metadata"
            muted
            playsinline
            aria-hidden="true"
          ></video>
          <span class="theinmag-bm-video__play" aria-hidden="true">
            <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="32" cy="32" r="32" fill="#F9C23C"/>
              <polygon points="26 20 46 32 26 44" fill="#2A1F3D"/>
            </svg>
          </span>
        </button>
      {%- else -%}
        <div class="theinmag-bm-video__poster theinmag-bm-video__poster--placeholder" aria-hidden="true">
          <span class="theinmag-bm-video__placeholder-text">Video coming soon</span>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var frame = document.querySelector('[data-bm-video-frame]');
    if (!frame) return;
    var trigger = frame.querySelector('[data-bm-video-trigger]');
    if (!trigger) return;

    trigger.addEventListener('click', function () {
      var ytId = frame.getAttribute('data-yt-id') || '';
      var mp4Url = frame.getAttribute('data-mp4-url') || '';

      if (ytId) {
        var iframe = document.createElement('iframe');
        iframe.className = 'theinmag-bm-video__iframe';
        iframe.src = 'https://www.youtube-nocookie.com/embed/' + encodeURIComponent(ytId)
          + '?autoplay=1&rel=0&modestbranding=1&playsinline=1';
        iframe.title = trigger.getAttribute('aria-label') || 'theINmag video';
        iframe.setAttribute('frameborder', '0');
        iframe.setAttribute('allow', 'autoplay; encrypted-media; picture-in-picture');
        iframe.setAttribute('allowfullscreen', '');
        frame.replaceChild(iframe, trigger);
        return;
      }

      if (mp4Url) {
        var video = document.createElement('video');
        video.className = 'theinmag-bm-video__iframe';
        video.src = mp4Url;
        video.controls = true;
        video.autoplay = true;
        video.playsInline = true;
        frame.replaceChild(video, trigger);
        return;
      }
    });
  })();
</script>

{%- stylesheet -%}
  /* ================================================================
     theinmag-bm-video
     Cream surface. Mobile: copy stacked above a portrait video,
     centred. Desktop: copy left, portrait video right.
     ================================================================ */
  .theinmag-bm-video {
    background-color: var(--color-cream, #FBF6EA);
    color: var(--color-inky-purple-navy, #2A1F3D);
    padding: clamp(56px, 8vw, 112px) clamp(20px, 5vw, 48px);
  }

  .theinmag-bm-video__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(24px, 3vw, 40px);
    align-items: center;
  }

  @media (min-width: 750px) {
    .theinmag-bm-video__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.7fr);
      gap: clamp(40px, 5vw, 72px);
    }
  }

  .theinmag-bm-video__copy {
    display: flex;
    flex-direction: column;
    gap: clamp(8px, 1.2vw, 14px);
    text-align: center;
  }

  @media (min-width: 750px) {
    .theinmag-bm-video__copy {
      text-align: left;
    }
  }

  .theinmag-bm-video__heading {
    margin: 0;
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-size: clamp(28px, 4.6vw, 48px);
    line-height: 1.1;
    letter-spacing: 0;
    color: var(--color-inky-purple-navy, #2A1F3D);
    text-wrap: balance;
  }

  .theinmag-bm-video__subhead {
    margin: 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(16px, 1.7vw, 19px);
    line-height: 1.4;
    color: var(--color-inky-purple-navy, #2A1F3D);
    opacity: 0.74;
  }

  /* ================================================================
     Portrait video frame. Aspect 9/16 to match the source. Mobile
     caps width so the section + copy fit on one Pixel 6 viewport
     without scrolling.
     ================================================================ */
  .theinmag-bm-video__frame {
    position: relative;
    width: 100%;
    max-width: 280px;
    aspect-ratio: 9 / 16;
    margin: 0 auto;
    background-color: var(--color-inky-purple-navy, #2A1F3D);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 14px 36px rgba(123, 79, 158, 0.22);
  }

  @media (min-width: 750px) {
    .theinmag-bm-video__frame {
      max-width: 320px;
      margin: 0 0 0 auto;
    }
  }

  @media (min-width: 990px) {
    .theinmag-bm-video__frame {
      max-width: 360px;
    }
  }

  .theinmag-bm-video__poster {
    appearance: none;
    border: 0;
    margin: 0;
    padding: 0;
    background: none;
    width: 100%;
    height: 100%;
    cursor: pointer;
    position: relative;
    display: block;
    overflow: hidden;
  }
  .theinmag-bm-video__poster:focus-visible {
    outline: 3px solid var(--color-yellow, #F9C23C);
    outline-offset: -3px;
  }

  .theinmag-bm-video__poster-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease, filter 0.2s ease;
    filter: brightness(0.9);
  }
  .theinmag-bm-video__poster:hover .theinmag-bm-video__poster-image {
    transform: scale(1.02);
    filter: brightness(0.84);
  }

  .theinmag-bm-video__play {
    position: absolute;
    top: 50%;
    left: 50%;
    width: clamp(56px, 8vw, 76px);
    height: clamp(56px, 8vw, 76px);
    transform: translate(-50%, -50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    transition: transform 0.2s ease;
    filter: drop-shadow(0 6px 18px rgba(0, 0, 0, 0.4));
  }
  .theinmag-bm-video__poster:hover .theinmag-bm-video__play {
    transform: translate(-50%, -50%) scale(1.06);
  }
  .theinmag-bm-video__play svg {
    width: 100%;
    height: 100%;
  }

  .theinmag-bm-video__poster--placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--color-purple-dark, #5D3A7A) 0%, var(--color-inky-purple-navy, #2A1F3D) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .theinmag-bm-video__placeholder-text {
    color: rgba(255, 255, 255, 0.85);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 500;
    font-size: clamp(14px, 1.4vw, 16px);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .theinmag-bm-video__iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-bm-video__poster-image,
    .theinmag-bm-video__play {
      transition: none;
    }
    .theinmag-bm-video__poster:hover .theinmag-bm-video__poster-image {
      transform: none;
    }
    .theinmag-bm-video__poster:hover .theinmag-bm-video__play {
      transform: translate(-50%, -50%);
    }
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "theINmag BM video",
  "tag": "section",
  "class": "theinmag-bm-video-section",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "subhead", "label": "Italic subhead" },
    { "type": "header", "content": "Video source" },
    { "type": "paragraph", "content": "Either paste a YouTube URL or 11-character video ID, OR upload an MP4 to Shopify Files (Content > Files) and paste the cdn.shopify.com URL. The portrait MP4 path is recommended for this section." },
    { "type": "text", "id": "youtube_id", "label": "YouTube URL or ID" },
    { "type": "text", "id": "mp4_url", "label": "MP4 URL (Shopify CDN)" },
    { "type": "header", "content": "Poster image" },
    { "type": "image_picker", "id": "poster_image", "label": "Poster image" },
    { "type": "text", "id": "poster_filename", "label": "Poster fallback filename", "info": "Portrait, 1080x1920 ideal. e.g. behind-the-mag-video-poster.jpg" },
    { "type": "text", "id": "poster_alt", "label": "Poster alt text" }
  ],
  "presets": [
    {
      "name": "theINmag BM video",
      "settings": {
        "heading": "Wait - why's it called theINmag?",
        "subhead": "Glad you asked",
        "poster_filename": "behind-the-mag-video-poster.jpg",
        "poster_alt": "Tam and Ryan in front of the van talking about why it's called theINmag."
      }
    }
  ]
}
{% endschema %}
