{%- comment -%}
  theinmag-bundle-pillars
  Three numbered pillars on a cream surface. Persuasion break between
  the picker and the pull-quote. Plant decorations deferred — Ryan
  wants to tune positioning after first paint.

  Archetype: §6.7 pillars/locked-benefits list, but with big-number
  badges instead of short-name nav (the bundle pillars are explicitly
  3/5/8 thresholds, so the number IS the identifier).
{%- endcomment -%}

{%- liquid
  assign pillars = section.blocks | where: 'type', 'pillar'
  assign aeo_heading = section.settings.heading | default: 'How do bundle discounts work?'
  assign intro = section.settings.intro_text
  assign footer = section.settings.footer_microcopy
  assign pad_top = section.settings.padding_top | default: 64
  assign pad_bottom = section.settings.padding_bottom | default: 64
  assign bg_filename = section.settings.background_filename | default: 'section_background_topblogs.jpg'
  assign bg_src = bg_filename | asset_url
-%}

{%- comment -%}
  Sitewide kid character pool. Idempotent (guards with
  window.__theinmagCharacterPoolInit). Lets the data-pool-character
  slot below get a random character + scroll-pop pattern.
{%- endcomment -%}
{% render 'theinmag-character-pool' %}

<section
  class="theinmag-bundle-pillars"
  aria-labelledby="theinmag-bundle-pillars-heading"
  style="--bp-pt: {{ pad_top }}px; --bp-pb: {{ pad_bottom }}px; --bp-bg: url('{{ bg_src }}');"
>
  <div class="theinmag-bundle-pillars__inner">
    <div class="theinmag-bundle-pillars__card-wrap">
      <h2 id="theinmag-bundle-pillars-heading" class="theinmag-bundle-pillars__heading">{{ aeo_heading }}</h2>
      {%- if intro != blank -%}
        <p class="theinmag-bundle-pillars__intro">{{ intro }}</p>
      {%- endif -%}

      {%- if pillars.size > 0 -%}
        <div class="theinmag-bundle-pillars__grid" role="list">
          {%- for block in pillars -%}
            <article class="theinmag-bundle-pillars__card{% if forloop.last %} theinmag-bundle-pillars__card--has-character{% endif %}" role="listitem" {{ block.shopify_attributes }}>
              {%- if forloop.last -%}
                <span
                  class="theinmag-bundle-pillars__character"
                  data-theinmag-pool-character
                  aria-hidden="true"
                ></span>
              {%- endif -%}
              <p class="theinmag-bundle-pillars__number">{{ block.settings.number }}</p>
              <h3 class="theinmag-bundle-pillars__card-heading">{{ block.settings.headline }}</h3>
              <p class="theinmag-bundle-pillars__card-body">{{ block.settings.body }}</p>
            </article>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if footer != blank -%}
        <p class="theinmag-bundle-pillars__footer">{{ footer }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{%- stylesheet -%}
  .theinmag-bundle-pillars {
    background-color: var(--color-cream);
    background-image: var(--bp-bg);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    color: var(--color-inky-purple-navy);
    padding: var(--bp-pt, 64px) clamp(16px, 4vw, 48px) var(--bp-pb, 64px);
  }

  .theinmag-bundle-pillars__inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: clamp(48px, 8vw, 96px) 0;
  }

  /* Lifted white card popping off the patterned bg. Inherits the same
     shadow rule the picker zones card uses so the page reads as a
     consistent depth language. */
  .theinmag-bundle-pillars__card-wrap {
    background-color: #FFFFFF;
    border-radius: var(--radius-xl, 28px);
    padding: clamp(28px, 4vw, 48px);
    box-shadow: 0 16px 48px rgba(42, 31, 61, 0.16);
  }

  .theinmag-bundle-pillars__heading {
    margin: 0 0 var(--space-md, 16px);
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-size: clamp(32px, 5.5vw, 52px);
    line-height: 1.05;
    color: var(--color-inky-purple-navy);
    text-wrap: balance;
  }
  /* On desktop the card is wide enough for the heading to live on a
     single line; force `nowrap` to lock that in. Mobile still wraps. */
  @media (min-width: 750px) {
    .theinmag-bundle-pillars__heading {
      white-space: nowrap;
    }
  }

  .theinmag-bundle-pillars__intro {
    margin: 0 0 clamp(32px, 4vw, 48px);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-inky-purple-navy);
    max-width: 50ch;
  }

  .theinmag-bundle-pillars__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg, 24px);
  }
  @media (min-width: 750px) {
    .theinmag-bundle-pillars__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .theinmag-bundle-pillars__card {
    background-color: var(--color-cream);
    border: 1px solid rgba(42, 31, 61, 0.06);
    border-radius: var(--radius-lg, 20px);
    padding: var(--space-lg, 24px);
    position: relative;
  }

  /* Card hosting the kid character lets the character's body bleed
     above the card's top edge. Default card has `overflow: visible`
     already via no explicit overflow, but explicit declaration here
     is defensive against future card-level changes. */
  .theinmag-bundle-pillars__card--has-character {
    overflow: visible;
  }

  /* Kid character peeking from the top-right of the 8 card. Scroll-pop
     pattern + the sitewide bob (applied to the inner `<img>` by
     theinmag-character-pool.liquid). Slight rotation gives the
     "popped in from the side" feel. */
  .theinmag-bundle-pillars__character {
    position: absolute;
    top: clamp(-90px, -8vw, -64px);
    right: clamp(-8px, 1vw, 16px);
    width: clamp(96px, 12vw, 140px);
    z-index: 2;
    pointer-events: none;
    opacity: 0;
    transform: translateY(24px) rotate(8deg);
    transition: opacity 0.7s ease, transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .theinmag-bundle-pillars__character.is-popped {
    opacity: 1;
    transform: translateY(0) rotate(8deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .theinmag-bundle-pillars__character {
      transition: none;
      opacity: 1;
      transform: rotate(8deg);
    }
  }

  .theinmag-bundle-pillars__number {
    margin: 0 0 8px;
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-size: clamp(48px, 6vw, 72px);
    line-height: 1;
    color: var(--color-purple-dark, #5D3A7A);
  }

  .theinmag-bundle-pillars__card-heading {
    margin: 0 0 8px;
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-size: 22px;
    line-height: 1.2;
    color: var(--color-inky-purple-navy);
  }

  .theinmag-bundle-pillars__card-body {
    margin: 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-inky-purple-navy);
  }

  .theinmag-bundle-pillars__footer {
    margin: clamp(32px, 4vw, 48px) auto 0;
    max-width: 60ch;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: 13px;
    line-height: 1.5;
    color: rgba(42, 31, 61, 0.6);
    text-align: center;
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "Bundle pillars",
  "tag": "section",
  "class": "shopify-section--theinmag-bundle-pillars",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading (H2)", "default": "How do bundle discounts work?" },
    { "type": "textarea", "id": "intro_text", "label": "Intro paragraph", "default": "Mix anything you like. The more you add, the more you save." },
    { "type": "textarea", "id": "footer_microcopy", "label": "Footer microcopy", "default": "Each mag = 1 item. Each Snack Pack = 1 item. Each Membership = 1 item, no matter how many issues it contains." },
    { "type": "header", "content": "Background" },
    { "type": "text", "id": "background_filename", "label": "Background image filename", "info": "Filename in /assets/ to render behind the white pillars card.", "default": "section_background_topblogs.jpg" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 8, "default": 64, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 8, "default": 64, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "number", "label": "Threshold number" },
        { "type": "text", "id": "headline", "label": "Headline" },
        { "type": "textarea", "id": "body", "label": "Body" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle pillars",
      "blocks": [
        { "type": "pillar", "settings": { "number": "3", "headline": "items, 5% off", "body": "Three mags. A Membership and two issues. A Snack Pack and a Membership. Any three items." } },
        { "type": "pillar", "settings": { "number": "5", "headline": "items, 10% off", "body": "Push to five and unlock double the discount. Most bundles land here." } },
        { "type": "pillar", "settings": { "number": "8", "headline": "items, 15% off", "body": "Eight or more is the biggest saving we offer. Built for grandparents, classrooms, or families with more than one kid reading." } }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["page"]
  }
}
{% endschema %}
