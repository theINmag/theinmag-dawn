{%- comment -%}
  theinmag-bundle-picker
  The pick zone for /pages/build-a-bundle. Owns:
    3.0  Section wrapper (cream + section-bg snippet + heading)
    3.1  Horizontal rail of single-issue tiles (Mag10..Mag01 + Snack Pack last)
    3.3  Two Membership tiles (Print + Digital)
    3.4  Membership modal (Length pills + Starting Issue radios)
    3.5  Running-total panel (desktop sticky right column) + fixed mobile
         bottom action bar
    Shared updateBundleUI() that re-fetches /cart.js and repaints
    every dependent surface (tier strip, panel, mobile bar, tile
    steppers). Dispatches `theinmag-bundle:update` so external surfaces
    (the tier strip section) can listen.

  Snack Pack ordering: handled in Liquid by skipping the Snack Pack
  handle inside the newest-first loop and rendering it once as the
  final tile. No admin date change required.
{%- endcomment -%}

{%- liquid
  assign rail_collection_handle = section.settings.rail_collection | default: 'single-issues'
  assign snack_pack_handle = section.settings.snack_pack_handle | default: 'theinmag-snack-pack'
  assign digital_stack_handle = section.settings.digital_stack_handle | default: 'theinmag-digital-stack'

  assign rail_products = collections[rail_collection_handle].products | sort: 'title' | reverse
  assign snack_pack_product = all_products[snack_pack_handle]

  assign membership_product_handle = section.settings.membership_product_handle | default: 'membership'
  assign membership_product = all_products[membership_product_handle]

  assign print_member_image = section.settings.print_member_image
  assign digital_member_image = section.settings.digital_member_image

  assign print_member_src = ''
  assign print_member_input = section.settings.print_member_image_filename
  if print_member_input != blank
    if print_member_input contains '//'
      assign print_member_src = print_member_input
    else
      assign print_member_src = print_member_input | asset_url
    endif
  endif

  assign digital_member_src = ''
  assign digital_member_input = section.settings.digital_member_image_filename
  if digital_member_input != blank
    if digital_member_input contains '//'
      assign digital_member_src = digital_member_input
    else
      assign digital_member_src = digital_member_input | asset_url
    endif
  endif

  assign print_member_image_alt = section.settings.print_member_image_alt | default: 'Letterbox stack of theINmag issues from the Print Membership.'
  assign digital_member_image_alt = section.settings.digital_member_image_alt | default: 'theINmag opened on an iPad screen.'

  assign current_issue = shop.metafields.theinmag.current_issue_number.value | default: 'Mag09'
  assign print_in_stock = shop.metafields.theinmag.current_issue_print_in_stock.value
  assign next_release_value = shop.metafields.theinmag.next_release_date.value
  assign next_release_formatted = next_release_value | date: '%-d %B %Y'

  assign current_num_str = current_issue | remove: 'Mag'
  assign current_num = current_num_str | times: 1
  assign next_num = current_num | plus: 1
  if next_num < 10
    assign next_issue = 'Mag0' | append: next_num
  else
    assign next_issue = 'Mag' | append: next_num
  endif

  if print_in_stock
    assign print_stock_attr = 'true'
  else
    assign print_stock_attr = 'false'
  endif
-%}

<section
  id="theinmag-bundle-picker"
  class="theinmag-bundle-picker"
  data-theinmag-bundle-picker
  data-current-issue="{{ current_issue }}"
  data-next-issue="{{ next_issue }}"
  data-next-release="{{ next_release_formatted }}"
  data-print-in-stock="{{ print_stock_attr }}"
  data-print-member-img="{{ print_member_src | escape }}"
  data-digital-member-img="{{ digital_member_src | escape }}"
  aria-labelledby="theinmag-bundle-picker-heading"
>
  {% render 'theinmag-section-bg', opacity: 0.4 %}

  <div class="theinmag-bundle-picker__inner">
    <h2 class="theinmag-bundle-picker__a11y-heading">How do theINmag bundle discounts work?</h2>

    <div class="theinmag-bundle-picker__grid">
      <div class="theinmag-bundle-picker__zones">
        <div class="theinmag-bundle-picker__zones-card">

        <header class="theinmag-bundle-picker__intro">
          <p id="theinmag-bundle-picker-heading" class="theinmag-bundle-picker__heading">{{ section.settings.heading }}</p>
          {%- if section.settings.subhead != blank -%}
            <p class="theinmag-bundle-picker__subhead">{{ section.settings.subhead }}</p>
          {%- endif -%}
        </header>

        {%- comment -%} 3.1 - Single mag rail {%- endcomment -%}
        <h3 class="theinmag-bundle-picker__rail-heading">Single mags</h3>

        <div
          class="theinmag-bundle-picker__rail"
          role="list"
          aria-label="Single mags and Snack Pack"
          data-bundle-rail
        >
          {%- comment -%}
            Snack Pack rendered FIRST (leftmost) so the curated bundle
            anchors the rail; individual issues follow newest-first.
          {%- endcomment -%}
          {%- if snack_pack_product != blank and snack_pack_product != empty -%}
            <div role="listitem">{% render 'theinmag-bundle-tile', product: snack_pack_product %}</div>
          {%- endif -%}

          {%- for product in rail_products -%}
            {%- unless product.handle == digital_stack_handle or product.handle == snack_pack_handle or product.handle == rail_collection_handle -%}
              <div role="listitem">{% render 'theinmag-bundle-tile', product: product %}</div>
            {%- endunless -%}
          {%- endfor -%}
        </div>

        {%- comment -%} 3.3 - Membership tiles {%- endcomment -%}
        <h3 class="theinmag-bundle-picker__memberships-heading">Add a Membership</h3>

        <div class="theinmag-bundle-picker__memberships">
          <article class="theinmag-bundle-picker__member-tile" data-bundle-member-tile data-format="Print">
            <div class="theinmag-bundle-picker__member-cover">
              {%- if print_member_image != blank -%}
                <img
                  src="{{ print_member_image | image_url: width: 600 }}"
                  alt="{{ print_member_image_alt | escape }}"
                  loading="lazy"
                  width="600"
                  height="800"
                >
              {%- elsif print_member_src != blank -%}
                <img
                  src="{{ print_member_src }}"
                  alt="{{ print_member_image_alt | escape }}"
                  loading="lazy"
                  width="600"
                  height="800"
                >
              {%- else -%}
                <div class="theinmag-bundle-picker__member-cover-placeholder" aria-hidden="true"></div>
              {%- endif -%}
            </div>
            <h4 class="theinmag-bundle-picker__member-title">Print Membership</h4>
            <p class="theinmag-bundle-picker__member-sub">Real paper, in your kid's hands every drop.</p>
            <p class="theinmag-bundle-picker__member-price">From $28.90/drop</p>
            <button type="button" class="theinmag-bundle-picker__member-add" data-bundle-member-open data-format="Print">Add</button>
          </article>

          <article class="theinmag-bundle-picker__member-tile" data-bundle-member-tile data-format="Digital">
            <div class="theinmag-bundle-picker__member-cover">
              {%- if digital_member_image != blank -%}
                <img
                  src="{{ digital_member_image | image_url: width: 600 }}"
                  alt="{{ digital_member_image_alt | escape }}"
                  loading="lazy"
                  width="600"
                  height="800"
                >
              {%- elsif digital_member_src != blank -%}
                <img
                  src="{{ digital_member_src }}"
                  alt="{{ digital_member_image_alt | escape }}"
                  loading="lazy"
                  width="600"
                  height="800"
                >
              {%- else -%}
                <div class="theinmag-bundle-picker__member-cover-placeholder" aria-hidden="true"></div>
              {%- endif -%}
            </div>
            <h4 class="theinmag-bundle-picker__member-title">Digital Membership</h4>
            <p class="theinmag-bundle-picker__member-sub">Yours to share with friends, family, the classroom.</p>
            <p class="theinmag-bundle-picker__member-price">From $10.45/drop</p>
            <button type="button" class="theinmag-bundle-picker__member-add" data-bundle-member-open data-format="Digital">Add</button>
          </article>
        </div>
        </div>
      </div>

      {%- comment -%} 3.5 - Running-total panel (desktop only) {%- endcomment -%}
      <aside class="theinmag-bundle-picker__panel" data-bundle-panel aria-label="Your bundle">
        <div class="theinmag-bundle-picker__panel-card">
          <h3 class="theinmag-bundle-picker__panel-heading">Your bundle</h3>

          <ul class="theinmag-bundle-picker__panel-items" data-panel-items role="list">
            <li class="theinmag-bundle-picker__panel-empty" data-panel-empty>
              Nothing in here yet - pick a mag to start.
            </li>
          </ul>

          <div class="theinmag-bundle-picker__panel-totals" data-panel-totals hidden>
            <div class="theinmag-bundle-picker__panel-row">
              <span>Subtotal</span>
              <span data-panel-subtotal>$0.00</span>
            </div>
            <div class="theinmag-bundle-picker__panel-row theinmag-bundle-picker__panel-row--discount" data-panel-discount-row hidden>
              <span data-panel-discount-label>Bundle discount</span>
              <span data-panel-discount-amount>-$0.00</span>
            </div>
            <div class="theinmag-bundle-picker__panel-row theinmag-bundle-picker__panel-row--total">
              <span>Total</span>
              <span data-panel-total>$0.00</span>
            </div>
          </div>

          <a href="/cart" class="theinmag-bundle-picker__panel-cta" data-panel-cta hidden>
            Review &amp; checkout
            <span aria-hidden="true"> &rarr;</span>
          </a>

          <p class="theinmag-bundle-picker__panel-microcopy" data-panel-microcopy hidden>
            Free shipping over $40. Discount applied at checkout.
          </p>
        </div>
      </aside>
    </div>
  </div>

  {%- comment -%}
    Floating mini bundle widget — pops top-right when the main
    running-total panel scrolls out of view (i.e. once you scroll past
    the picker section into the quote / pillars / FAQ below). Mirrors
    the Membership PDP's sticky sales widget visual: white card,
    deep shadow, compact label + meta + Review CTA. Hidden on mobile
    where the bottom bar covers the same need.
  {%- endcomment -%}
  <aside class="theinmag-bundle-picker__float" data-bundle-float aria-label="Your bundle">
    <p class="theinmag-bundle-picker__float-label">YOUR BUNDLE</p>
    <p class="theinmag-bundle-picker__float-meta">
      <span data-float-count>0</span> items
      <span class="theinmag-bundle-picker__float-dot" aria-hidden="true">·</span>
      <span data-float-total>$0.00</span>
    </p>
    <a class="theinmag-bundle-picker__float-cta" href="/cart">Review &amp; checkout &rarr;</a>
  </aside>

  {%- comment -%}
    Mobile bottom action bar with expandable drawer.
    Collapsed: count + total + Review CTA + chevron.
    Expanded: drawer slides up showing item list (read-only) +
    subtotal/discount/total breakdown. Tap chevron or summary to
    toggle. Edits still happen on the cart page (Review).
  {%- endcomment -%}
  <div class="theinmag-bundle-picker__mobile-bar" data-bundle-mobile-bar hidden>
    <div class="theinmag-bundle-picker__mobile-drawer" data-mobile-drawer aria-hidden="true">
      <ul class="theinmag-bundle-picker__mobile-items" data-mobile-items role="list"></ul>
      <div class="theinmag-bundle-picker__mobile-totals">
        <div class="theinmag-bundle-picker__mobile-totals-row">
          <span>Subtotal</span>
          <span data-mobile-subtotal>$0.00</span>
        </div>
        <div class="theinmag-bundle-picker__mobile-totals-row theinmag-bundle-picker__mobile-totals-row--discount" data-mobile-discount-row hidden>
          <span data-mobile-discount-label>Bundle discount</span>
          <span data-mobile-discount-amount>-$0.00</span>
        </div>
      </div>
    </div>
    <div class="theinmag-bundle-picker__mobile-row-main">
      <button
        type="button"
        class="theinmag-bundle-picker__mobile-toggle"
        data-mobile-toggle
        aria-expanded="false"
      >
        <span class="theinmag-bundle-picker__mobile-summary">
          <span data-mobile-count>0</span> items &middot; <span data-mobile-total>$0.00</span>
        </span>
        <span class="theinmag-bundle-picker__mobile-chevron" aria-hidden="true"></span>
      </button>
      <a class="theinmag-bundle-picker__mobile-cta" href="/cart">Review &rarr;</a>
    </div>
  </div>

  {%- comment -%} Membership modal {%- endcomment -%}
  <dialog class="theinmag-bundle-picker__modal" data-bundle-modal aria-labelledby="theinmag-bundle-modal-title">
    <form method="dialog" class="theinmag-bundle-picker__modal-inner" data-bundle-modal-form>
      <button type="submit" class="theinmag-bundle-picker__modal-close" aria-label="Close" value="cancel">&times;</button>

      <h2 id="theinmag-bundle-modal-title" class="theinmag-bundle-picker__modal-title" data-modal-title>Print Membership</h2>
      <p class="theinmag-bundle-picker__modal-sub">Never miss an issue.</p>

      <fieldset class="theinmag-bundle-picker__modal-fieldset">
        <legend class="theinmag-bundle-picker__modal-legend">How many issues?</legend>
        <div class="theinmag-bundle-picker__modal-pills" role="radiogroup" aria-label="Length" data-modal-length-group>
          <button type="button" class="theinmag-bundle-picker__modal-pill is-active" data-modal-length="4-Issue" role="radio" aria-checked="true">
            <span class="theinmag-bundle-picker__modal-pill-title">4-Issue</span>
            <span class="theinmag-bundle-picker__modal-pill-price" data-modal-pill-price-4>$89</span>
          </button>
          <button type="button" class="theinmag-bundle-picker__modal-pill" data-modal-length="8-Issue" role="radio" aria-checked="false">
            <span class="theinmag-bundle-picker__modal-pill-title">8-Issue</span>
            <span class="theinmag-bundle-picker__modal-pill-price" data-modal-pill-price-8>$159</span>
            <span class="theinmag-bundle-picker__modal-pill-chip">Best value</span>
          </button>
          {%- comment -%}
            Rolling is intentionally NOT offered in Build a Bundle. It's a
            recurring subscription (Appstle selling plan), and the bundle's
            add-to-cart doesn't attach a selling plan - so a Rolling line here
            would create a one-time charge with no subscription. Rolling lives
            only on the /products/membership PDP, where the selling plan is
            wired in. (The JS Rolling branches below are now dead but harmless;
            activeLength can only be 4-Issue or 8-Issue here.)
          {%- endcomment -%}
        </div>
      </fieldset>

      {%- comment -%}
        The starting-issue choice lives in the shared start picker dialog
        (snippets/theinmag-start-picker): covers, not radios, and it knows
        which issues have sold out. Opens on "Add to bundle" for Print.
        Digital always starts with the current issue and skips it.
      {%- endcomment -%}
      <p class="theinmag-bundle-picker__modal-start-note" data-modal-start-hint>Next, you'll pick which mag arrives first.</p>
      <p class="theinmag-bundle-picker__modal-start-note" data-modal-start-note hidden>
        Digital always starts with the <strong>current issue ({{ current_issue }})</strong>.
      </p>

      <button type="button" class="theinmag-bundle-picker__modal-cta" data-modal-submit>
        Add to bundle - <span data-modal-cta-price>$89</span>
      </button>
    </form>
  </dialog>

  {% render 'theinmag-start-picker' %}

  {%- if membership_product != blank and membership_product != empty -%}
    <script type="application/json" data-bundle-membership-variants>
      [
        {%- for v in membership_product.variants -%}
          {"id": {{ v.id }}, "format": {{ v.option1 | json }}, "length": {{ v.option2 | json }}, "price": {{ v.price }}, "available": {{ v.available }}}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    </script>
  {%- else -%}
    <script type="application/json" data-bundle-membership-variants>[]</script>
  {%- endif -%}
</section>

{%- stylesheet -%}
  .theinmag-bundle-picker {
    position: relative;
    background-color: var(--color-cream);
    color: var(--color-inky-purple-navy);
    padding: clamp(48px, 8vw, 96px) clamp(16px, 4vw, 48px);
    /* No `overflow: hidden` here. It kills `position: sticky` on the
       running-total panel inside this section. The section-bg snippet
       is absolutely-positioned with inset:0 and constrained by the
       section's own bounding box, so it doesn't need clipping. */
  }

  .theinmag-bundle-picker__inner {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    margin: 0 auto;
  }

  .theinmag-bundle-picker__a11y-heading {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .theinmag-bundle-picker__intro {
    margin: 0 0 clamp(24px, 3vw, 36px);
    max-width: 60ch;
  }

  .theinmag-bundle-picker__heading {
    margin: 0 0 10px;
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-size: clamp(28px, 4.5vw, 40px);
    line-height: 1.15;
    color: var(--color-inky-purple-navy);
    text-wrap: balance;
  }
  .theinmag-bundle-picker__subhead {
    margin: 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: 15px;
    line-height: 1.5;
    color: rgba(42, 31, 61, 0.72);
  }

  .theinmag-bundle-picker__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(24px, 3vw, 40px);
  }

  @media (min-width: 990px) {
    .theinmag-bundle-picker__grid {
      grid-template-columns: minmax(0, 1fr) 320px;
      align-items: start;
    }
  }

  .theinmag-bundle-picker__zones {
    min-width: 0;
  }

  /* White card wrapping the picker's left column so type stays
     legible over the busy section-bg pattern. The right-column panel
     is already its own white card. */
  .theinmag-bundle-picker__zones-card {
    background-color: #FFFFFF;
    border-radius: var(--radius-xl, 28px);
    padding: clamp(20px, 3vw, 32px);
    box-shadow: 0 12px 36px rgba(42, 31, 61, 0.10);
  }

  .theinmag-bundle-picker__rail-heading {
    margin: 0 0 var(--space-md, 16px);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: 14px;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-sandy-orange-dark, #D9783A);
  }

  /* Rail. */
  .theinmag-bundle-picker__rail {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: var(--space-md, 16px);
    padding-right: clamp(40px, 8vw, 96px);
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .theinmag-bundle-picker__rail::-webkit-scrollbar { display: none; }

  .theinmag-bundle-picker__rail > [role='listitem'] {
    flex: 0 0 160px;
    scroll-snap-align: start;
  }
  @media (min-width: 750px) {
    .theinmag-bundle-picker__rail > [role='listitem'] {
      flex: 0 0 240px;
    }
  }

  /* Memberships block. */
  .theinmag-bundle-picker__memberships-heading {
    margin: clamp(40px, 5vw, 64px) 0 var(--space-md, 16px);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: 14px;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-sandy-orange-dark, #D9783A);
  }

  .theinmag-bundle-picker__memberships {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md, 16px);
  }
  @media (min-width: 600px) {
    .theinmag-bundle-picker__memberships {
      grid-template-columns: 1fr 1fr;
    }
  }

  .theinmag-bundle-picker__member-tile {
    background-color: var(--color-cream);
    border: 1px solid var(--color-soft-pink, #F7A092);
    border-radius: var(--radius-lg, 20px);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .theinmag-bundle-picker__member-cover {
    aspect-ratio: 1 / 1;
    background-color: var(--color-lavender);
    overflow: hidden;
  }
  .theinmag-bundle-picker__member-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .theinmag-bundle-picker__member-cover-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #E8DEEF 0%, #C9E5E8 100%);
  }
  .theinmag-bundle-picker__member-title {
    margin: var(--space-md, 16px) var(--space-md, 16px) 4px;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: 15px;
    line-height: 1.3;
    color: var(--color-inky-purple-navy);
  }
  .theinmag-bundle-picker__member-sub {
    margin: 0 var(--space-md, 16px) 4px;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: 13px;
    line-height: 1.4;
    color: rgba(42, 31, 61, 0.72);
  }
  .theinmag-bundle-picker__member-price {
    margin: 0 var(--space-md, 16px) var(--space-md, 16px);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: 14px;
    color: var(--color-purple-dark, #5D3A7A);
  }
  .theinmag-bundle-picker__member-add {
    appearance: none;
    margin: 0 var(--space-md, 16px) var(--space-md, 16px);
    padding: 10px 14px;
    background: transparent;
    border: 1.5px solid var(--color-purple-dark, #5D3A7A);
    color: var(--color-purple-dark, #5D3A7A);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: 14px;
    border-radius: var(--radius-pill, 9999px);
    cursor: pointer;
    min-height: 44px;
    transition: background-color var(--transition-hover, 0.2s ease), color var(--transition-hover, 0.2s ease);
  }
  .theinmag-bundle-picker__member-add:hover,
  .theinmag-bundle-picker__member-add:focus-visible {
    background-color: var(--color-purple-dark, #5D3A7A);
    color: #FFFFFF;
    outline: none;
  }

  /* Running-total panel. */
  .theinmag-bundle-picker__panel {
    display: none;
  }
  @media (min-width: 990px) {
    .theinmag-bundle-picker__panel {
      display: block;
      position: sticky;
      top: calc(var(--header-height, 80px) + 60px + 16px);
      align-self: start;
    }
  }
  .theinmag-bundle-picker__panel-card {
    background-color: #FFFFFF;
    border-radius: var(--radius-xl, 28px);
    box-shadow: 0 12px 36px rgba(42, 31, 61, 0.22);
    padding: var(--space-lg, 24px);
  }
  .theinmag-bundle-picker__panel-heading {
    margin: 0 0 var(--space-md, 16px);
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-size: clamp(22px, 2.5vw, 28px);
    line-height: 1.15;
    color: var(--color-inky-purple-navy);
  }
  .theinmag-bundle-picker__panel-items {
    list-style: none;
    margin: 0 0 var(--space-md, 16px);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .theinmag-bundle-picker__panel-empty {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: 14px;
    line-height: 1.5;
