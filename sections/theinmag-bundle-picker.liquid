<script>
  (function () {
    const root = document.querySelector('[data-theinmag-bundle-picker]');
    if (!root) return;

    const variantsScript = root.querySelector('[data-bundle-membership-variants]');
    let membershipVariants = [];
    try {
      membershipVariants = variantsScript ? JSON.parse(variantsScript.textContent) : [];
    } catch (e) { membershipVariants = []; }

    const currentIssue = root.dataset.currentIssue || 'Mag09';
    const nextIssue = root.dataset.nextIssue || 'Mag10';
    const nextRelease = root.dataset.nextRelease || '';
    const printInStock = root.dataset.printInStock === 'true';
    const printMemberImg = root.dataset.printMemberImg || '';
    const digitalMemberImg = root.dataset.digitalMemberImg || '';

    /* For Membership cart lines, the variant carries no image so the
       cart returns the product's default featured image (often empty
       or the wrong format). Detect membership items by product handle
       or by the presence of a `_starting_mag` line item property and
       swap in the format-specific photo wired to the section. */
    function thumbnailFor(item) {
      const handle = item.handle || (item.url || '').split('/products/')[1] || '';
      const isMembership = handle.indexOf('membership') !== -1 || (item.properties && (item.properties._starting_mag || item.properties['_starting_mag']));
      if (isMembership) {
        const opt1 = (item.options_with_values && item.options_with_values[0] && item.options_with_values[0].value) || item.variant_options && item.variant_options[0] || '';
        const fmt = String(opt1).toLowerCase();
        if (fmt.indexOf('digital') !== -1) return digitalMemberImg || item.image || '';
        if (fmt.indexOf('print') !== -1) return printMemberImg || item.image || '';
        if (fmt.indexOf('combo') !== -1) return printMemberImg || item.image || '';
      }
      return item.image || (item.featured_image && item.featured_image.url) || '';
    }

    /* ============ Cart state + dispatch ============ */
    function fetchCart() {
      return fetch('/cart.js', { credentials: 'same-origin' }).then(function (r) { return r.json(); });
    }

    function dispatchUpdate(cart) {
      const event = new CustomEvent('theinmag-bundle:update', { detail: cart });
      window.dispatchEvent(event);
    }

    function updateBundleUI() {
      return fetchCart().then(function (cart) {
        lastCart = cart;
        repaintPanel(cart);
        repaintMobileBar(cart);
        repaintFloat(cart);
        repaintTiles(cart);
        updateFloatPosition();
        updateFloatVisibility(cart);
        dispatchUpdate(cart);
        return cart;
      });
    }

    function formatAud(cents) {
      return '$' + (cents / 100).toFixed(2);
    }

    function tierFor(count) {
      if (count >= 8) return { rate: 0.15, label: '15% off' };
      if (count >= 5) return { rate: 0.10, label: '10% off' };
      if (count >= 3) return { rate: 0.05, label: '5% off' };
      return { rate: 0, label: '' };
    }

    /* ============ Tile rendering (Add button label) ============ */
    function repaintTiles(cart) {
      const tiles = root.querySelectorAll('[data-bundle-tile]');
      tiles.forEach(function (tile) {
        const rows = tile.querySelectorAll('[data-variant-id]');
        rows.forEach(function (row) {
          const vid = row.dataset.variantId;
          if (!vid) return;
          const inCart = cart.items.find(function (i) { return String(i.variant_id) === String(vid); });
          const qty = inCart ? inCart.quantity : 0;
          const addBtn = row.querySelector('[data-bundle-add]');
          const addLabel = row.querySelector('[data-add-label]');
          const addedLabel = row.querySelector('[data-added-label]');
          if (qty > 0) {
            if (addLabel) addLabel.hidden = true;
            if (addedLabel) addedLabel.hidden = false;
            if (addBtn) addBtn.classList.add('is-in-cart');
          } else {
            if (addLabel) addLabel.hidden = false;
            if (addedLabel) addedLabel.hidden = true;
            if (addBtn) addBtn.classList.remove('is-in-cart');
          }
        });
      });
    }

    /* ============ Running-total panel ============ */
    const panelItems = root.querySelector('[data-panel-items]');
    const panelEmpty = root.querySelector('[data-panel-empty]');
    const panelTotals = root.querySelector('[data-panel-totals]');
    const panelSubtotal = root.querySelector('[data-panel-subtotal]');
    const panelDiscountRow = root.querySelector('[data-panel-discount-row]');
    const panelDiscountLabel = root.querySelector('[data-panel-discount-label]');
    const panelDiscountAmount = root.querySelector('[data-panel-discount-amount]');
    const panelTotal = root.querySelector('[data-panel-total]');
    const panelCta = root.querySelector('[data-panel-cta]');
    const panelMicro = root.querySelector('[data-panel-microcopy]');

    function repaintPanel(cart) {
      if (!panelItems) return;
      panelItems.innerHTML = '';

      if (!cart.items || cart.items.length === 0) {
        const li = document.createElement('li');
        li.className = 'theinmag-bundle-picker__panel-empty';
        li.textContent = 'Nothing in here yet - pick a mag to start.';
        panelItems.appendChild(li);
        if (panelTotals) panelTotals.hidden = true;
        if (panelCta) panelCta.hidden = true;
        if (panelMicro) panelMicro.hidden = true;
        return;
      }

      cart.items.forEach(function (item) {
        const li = document.createElement('li');
        li.className = 'theinmag-bundle-picker__panel-item';

        const img = document.createElement('img');
        img.src = thumbnailFor(item);
        img.alt = item.product_title || '';
        if (img.src) li.appendChild(img); else li.appendChild(document.createElement('span'));

        const meta = document.createElement('div');
        meta.className = 'theinmag-bundle-picker__panel-item-meta';
        const title = document.createElement('span');
        title.className = 'theinmag-bundle-picker__panel-item-title';
        title.textContent = item.product_title + (item.variant_title && item.variant_title !== 'Default Title' ? ' - ' + item.variant_title : '');
        meta.appendChild(title);
        const startingProp = item.properties && (item.properties._starting_mag || item.properties['_starting_mag']);
        if (startingProp) {
          const sub = document.createElement('span');
          sub.className = 'theinmag-bundle-picker__panel-item-sub';
          sub.textContent = 'Starting: ' + startingProp;
          meta.appendChild(sub);
        }
        const linePrice = document.createElement('span');
        linePrice.className = 'theinmag-bundle-picker__panel-item-sub';
        linePrice.textContent = formatAud(item.line_price);
        meta.appendChild(linePrice);
        li.appendChild(meta);

        const stepper = document.createElement('div');
        stepper.className = 'theinmag-bundle-picker__panel-item-stepper';
        const minus = document.createElement('button');
        minus.type = 'button';
        minus.className = 'theinmag-bundle-picker__panel-step';
        minus.setAttribute('aria-label', 'Decrease quantity');
        minus.innerHTML = '&minus;';
        minus.addEventListener('click', function () { changeLine(item.key, Math.max(0, item.quantity - 1)); });
        const qtyEl = document.createElement('span');
        qtyEl.className = 'theinmag-bundle-picker__panel-step-qty';
        qtyEl.textContent = String(item.quantity);
        const plus = document.createElement('button');
        plus.type = 'button';
        plus.className = 'theinmag-bundle-picker__panel-step';
        plus.setAttribute('aria-label', 'Increase quantity');
        plus.textContent = '+';
        plus.addEventListener('click', function () { changeLine(item.key, item.quantity + 1); });
        stepper.appendChild(minus);
        stepper.appendChild(qtyEl);
        stepper.appendChild(plus);
        li.appendChild(stepper);

        panelItems.appendChild(li);
      });

      const tier = tierFor(cart.item_count);
      const subtotal = cart.total_price;
      const discountAmount = Math.round(subtotal * tier.rate);
      const finalTotal = subtotal - discountAmount;

      if (panelSubtotal) panelSubtotal.textContent = formatAud(subtotal);

      if (tier.rate > 0) {
        if (panelDiscountRow) panelDiscountRow.hidden = false;
        if (panelDiscountLabel) panelDiscountLabel.textContent = 'Bundle discount (' + tier.label + ')';
        if (panelDiscountAmount) panelDiscountAmount.textContent = '-' + formatAud(discountAmount);
      } else if (panelDiscountRow) {
        panelDiscountRow.hidden = true;
      }
      if (panelTotal) panelTotal.textContent = formatAud(finalTotal);
      if (panelTotals) panelTotals.hidden = false;
      if (panelCta) panelCta.hidden = false;
      if (panelMicro) panelMicro.hidden = false;
    }

    /* ============ Mobile bottom bar ============ */
    const mobileBar = root.querySelector('[data-bundle-mobile-bar]');
    const mobileCount = root.querySelector('[data-mobile-count]');
    const mobileTotal = root.querySelector('[data-mobile-total]');

    const mobileToggle = root.querySelector('[data-mobile-toggle]');
    const mobileDrawer = root.querySelector('[data-mobile-drawer]');
    const mobileItems = root.querySelector('[data-mobile-items]');
    const mobileSubtotal = root.querySelector('[data-mobile-subtotal]');
    const mobileDiscountRow = root.querySelector('[data-mobile-discount-row]');
    const mobileDiscountLabel = root.querySelector('[data-mobile-discount-label]');
    const mobileDiscountAmount = root.querySelector('[data-mobile-discount-amount]');

    function repaintMobileBar(cart) {
      if (!mobileBar) return;
      if (!cart.item_count) {
        mobileBar.hidden = true;
        mobileBar.classList.remove('is-expanded');
        if (mobileToggle) mobileToggle.setAttribute('aria-expanded', 'false');
        if (mobileDrawer) mobileDrawer.setAttribute('aria-hidden', 'true');
        return;
      }
      mobileBar.hidden = false;
      const tier = tierFor(cart.item_count);
      const subtotal = cart.total_price || 0;
      const discountAmount = Math.round(subtotal * tier.rate);
      const finalTotal = subtotal - discountAmount;

      if (mobileCount) mobileCount.textContent = String(cart.item_count);
      if (mobileTotal) mobileTotal.textContent = formatAud(finalTotal);

      /* Drawer contents: item list + subtotal + discount line. */
      if (mobileItems) {
        mobileItems.innerHTML = '';
        cart.items.forEach(function (item) {
          const li = document.createElement('li');
          li.className = 'theinmag-bundle-picker__mobile-item';

          const img = document.createElement('img');
          img.src = thumbnailFor(item);
          img.alt = item.product_title || '';
          if (img.src) li.appendChild(img); else li.appendChild(document.createElement('span'));

          const meta = document.createElement('div');
          const title = document.createElement('span');
          title.className = 'theinmag-bundle-picker__mobile-item-title';
          title.textContent = item.product_title + (item.variant_title && item.variant_title !== 'Default Title' ? ' - ' + item.variant_title : '');
          meta.appendChild(title);
          if (item.quantity > 1) {
            const qty = document.createElement('span');
            qty.className = 'theinmag-bundle-picker__mobile-item-sub';
            qty.textContent = 'Qty ' + item.quantity;
            meta.appendChild(qty);
          }
          const startingProp = item.properties && (item.properties._starting_mag || item.properties['_starting_mag']);
          if (startingProp) {
            const sub = document.createElement('span');
            sub.className = 'theinmag-bundle-picker__mobile-item-sub';
            sub.textContent = 'Starting: ' + startingProp;
            meta.appendChild(sub);
          }
          li.appendChild(meta);

          const price = document.createElement('span');
          price.className = 'theinmag-bundle-picker__mobile-item-price';
          price.textContent = formatAud(item.line_price);
          li.appendChild(price);

          mobileItems.appendChild(li);
        });
      }

      if (mobileSubtotal) mobileSubtotal.textContent = formatAud(subtotal);
      if (tier.rate > 0 && mobileDiscountRow) {
        mobileDiscountRow.hidden = false;
        if (mobileDiscountLabel) mobileDiscountLabel.textContent = 'Bundle discount (' + tier.label + ')';
        if (mobileDiscountAmount) mobileDiscountAmount.textContent = '-' + formatAud(discountAmount);
      } else if (mobileDiscountRow) {
        mobileDiscountRow.hidden = true;
      }
    }

    /* Tap to expand drawer. */
    if (mobileToggle) {
      mobileToggle.addEventListener('click', function () {
        const expanded = mobileBar.classList.toggle('is-expanded');
        mobileToggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
        if (mobileDrawer) mobileDrawer.setAttribute('aria-hidden', expanded ? 'false' : 'true');
      });
    }

    /* ============ Floating top-right widget ============ */
    const floatWidget = root.querySelector('[data-bundle-float]');
    const floatCount = root.querySelector('[data-float-count]');
    const floatTotal = root.querySelector('[data-float-total]');

    function repaintFloat(cart) {
      if (!floatWidget) return;
      const count = cart.item_count || 0;
      const tier = tierFor(count);
      const discountAmount = Math.round((cart.total_price || 0) * tier.rate);
      const finalTotal = (cart.total_price || 0) - discountAmount;
      if (floatCount) floatCount.textContent = String(count);
      if (floatTotal) floatTotal.textContent = formatAud(finalTotal);
    }

    /* Toggle visibility: show when the main panel scrolls out of view
       AND cart has items. Hides when panel is back in view (= user
       returned to the picker). Position-top is computed from the
       persistent chrome bottom so it sits below any sticky header. */
    function persistentChromeBottom() {
      /* Query the exact two chrome elements rather than `[class*=
         "header"]` etc. - the announcement bar sits in natural flow
         (NOT position:sticky) at scroll=0, and a generic header-name
         filter also matches inner `<header>` elements inside content
         sections, causing both false misses and false hits. Both
         theinmag-announcement and theinmag-header are unique on
         the page. */
      const targets = [
        document.querySelector('.theinmag-announcement'),
        document.querySelector('.theinmag-header')
      ];
      let maxBottom = 0;
      targets.forEach(function (el) {
        if (!el) return;
        if (el.contains(floatWidget) || (floatWidget && floatWidget.contains(el))) return;
        const r = el.getBoundingClientRect();
        if (r.bottom > 0 && r.top < window.innerHeight / 2) {
          if (r.bottom > maxBottom) maxBottom = r.bottom;
        }
      });
      return maxBottom;
    }

    function updateFloatPosition() {
      if (!floatWidget) return;
      const chrome = persistentChromeBottom();
      /* Tier strip pins right below chrome. The float should clear the
         tier strip too, so add its height (52-64px) + a small gap. */
      const tierStrip = document.querySelector('[data-theinmag-bundle-strip].is-sticky');
      const tierStripHeight = tierStrip ? tierStrip.offsetHeight : 0;
      const top = (chrome || 88) + tierStripHeight + 16;
      floatWidget.style.setProperty('--bundle-float-top', top + 'px');
    }

    function updateFloatVisibility(cart) {
      if (!floatWidget) return;
      const panel = root.querySelector('[data-bundle-panel]');
      if (!panel || !cart || !cart.item_count) {
        floatWidget.classList.remove('is-visible');
        return;
      }
      const rect = panel.getBoundingClientRect();
      const offScreen = rect.bottom < 0 || rect.top > window.innerHeight;
      floatWidget.classList.toggle('is-visible', offScreen);
    }

    let lastCart = { item_count: 0, total_price: 0, items: [] };
    window.addEventListener('scroll', function () {
      updateFloatPosition();
      updateFloatVisibility(lastCart);
    }, { passive: true });
    window.addEventListener('resize', updateFloatPosition);

    /* ============ Cart writes ============ */
    function addToCart(variantId, properties) {
      const body = { id: variantId, quantity: 1 };
      if (properties) body.properties = properties;
      return fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify(body)
      }).then(function (r) { return r.json(); }).then(function () { return updateBundleUI(); });
    }

    function changeLine(key, qty) {
      return fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ id: key, quantity: qty })
      }).then(function (r) { return r.json(); }).then(function () { return updateBundleUI(); });
    }

    function changeVariantQty(variantId, qty) {
      return fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ id: variantId, quantity: qty })
      }).then(function (r) { return r.json(); }).then(function () { return updateBundleUI(); });
    }

    /* ============ Tile click wiring ============ */
    root.addEventListener('click', function (e) {
      const addBtn = e.target.closest('[data-bundle-add]');
      if (addBtn) {
        e.preventDefault();
        addToCart(addBtn.dataset.variantId);
        return;
      }
    });

    /* ============ Membership modal ============ */
    const modal = root.querySelector('[data-bundle-modal]');
    const modalTitle = root.querySelector('[data-modal-title]');
    const modalRollingNote = root.querySelector('[data-modal-rolling-note]');
    const modalLengthGroup = root.querySelector('[data-modal-length-group]');
    const modalCtaPrice = root.querySelector('[data-modal-cta-price]');
    const modalSubmit = root.querySelector('[data-modal-submit]');

    let activeFormat = 'Print';
    let activeLength = '4-Issue';

    function findVariant(format, length) {
      return membershipVariants.find(function (v) {
        return (v.format || '').toLowerCase() === format.toLowerCase()
            && (v.length || '').toLowerCase() === length.toLowerCase();
      });
    }

    function priceForPill(format, length) {
      const v = findVariant(format, length);
      if (!v) return '';
      if (length === 'Rolling') return formatAud(v.price) + '/drop';
      return formatAud(v.price);
    }

    function updateModalForFormat() {
      /* Repaint pill prices with format-specific values. */
      const pills = modalLengthGroup ? modalLengthGroup.querySelectorAll('[data-modal-length]') : [];
      pills.forEach(function (pill) {
        const length = pill.dataset.modalLength;
        const priceEl = pill.querySelector('.theinmag-bundle-picker__modal-pill-price');
        if (priceEl) priceEl.textContent = priceForPill(activeFormat, length);
      });
      refreshCta();
    }

    function refreshCta() {
      const v = findVariant(activeFormat, activeLength);
      if (modalCtaPrice && v) {
        const label = activeLength === 'Rolling' ? formatAud(v.price) + '/drop' : formatAud(v.price);
        modalCtaPrice.textContent = label;
      }
      if (modalRollingNote) modalRollingNote.hidden = activeLength !== 'Rolling';
    }

    function openModal(format) {
      activeFormat = format;
      activeLength = '4-Issue';
      if (modalTitle) modalTitle.textContent = format + ' Membership';
      /* Reset length pills. */
      if (modalLengthGroup) {
        modalLengthGroup.querySelectorAll('[data-modal-length]').forEach(function (p) {
          const isActive = p.dataset.modalLength === activeLength;
          p.classList.toggle('is-active', isActive);
          p.setAttribute('aria-checked', isActive ? 'true' : 'false');
        });
      }
      /* Starting issue: Digital says so and skips the picker; Print gets
         the one-line hint and picks from covers on "Add to bundle". */
      const modalStartNote = root.querySelector('[data-modal-start-note]');
      const modalStartHint = root.querySelector('[data-modal-start-hint]');
      if (modalStartNote) modalStartNote.hidden = format !== 'Digital';
      if (modalStartHint) modalStartHint.hidden = format === 'Digital';
      bundleChosenStart = null;
      updateModalForFormat();

      if (modal && typeof modal.showModal === 'function') {
        modal.showModal();
      } else if (modal) {
        modal.setAttribute('open', '');
      }
    }

    function closeModal() {
      if (!modal) return;
      if (typeof modal.close === 'function') modal.close('cancel');
      else modal.removeAttribute('open');
    }

    /* Open buttons. */
    root.querySelectorAll('[data-bundle-member-open]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        openModal(btn.dataset.format);
      });
    });

    /* Length pill clicks. */
    if (modalLengthGroup) {
      modalLengthGroup.addEventListener('click', function (e) {
        const pill = e.target.closest('[data-modal-length]');
        if (!pill) return;
        activeLength = pill.dataset.modalLength;
        modalLengthGroup.querySelectorAll('[data-modal-length]').forEach(function (p) {
          const isActive = p === pill;
          p.classList.toggle('is-active', isActive);
          p.setAttribute('aria-checked', isActive ? 'true' : 'false');
        });
        refreshCta();
      });
    }

    /* Click-outside-to-close (native dialog backdrop fires click on dialog). */
    if (modal) {
      modal.addEventListener('click', function (e) {
        if (e.target === modal) closeModal();
      });
    }

    /* Submit CTA. */
    function magNumberToString(num) {
      if (num < 10) return 'Mag0' + num;
      return 'Mag' + num;
    }

    function buildMagsIncluded(startingMag, length, skipSoldOut) {
      const sp = window.theinmagStartPicker;
      if (sp && typeof sp.compute === 'function') {
        return sp.compute(startingMag, length, { skipSoldOut: skipSoldOut !== false }).magsIncluded;
      }
      const startNum = parseInt(startingMag.replace('Mag', ''), 10) || 1;
      if (length === 'Rolling') return startingMag;
      const count = length === '8-Issue' ? 8 : 4;
      const mags = [];
      for (let i = 0; i < count; i++) {
        mags.push(magNumberToString(startNum + i));
      }
      return mags.join(', ');
    }

    function remainingAfterFirst(length) {
      if (length === 'Rolling') return '0';
      if (length === '8-Issue') return '7';
      return '3';
    }

    let bundleChosenStart = null;
    function addMembershipWithStart(v, startingMag, skipSoldOut) {
      const properties = {
        _starting_mag: startingMag,
        _remaining_after_first: remainingAfterFirst(activeLength),
        _mags_included: buildMagsIncluded(startingMag, activeLength, skipSoldOut)
      };
      addToCart(v.id, properties).then(function () {
        closeModal();
      });
    }
    if (modalSubmit) {
      modalSubmit.addEventListener('click', function () {
        const v = findVariant(activeFormat, activeLength);
        if (!v) return;
        if (activeFormat === 'Digital') {
          addMembershipWithStart(v, currentIssue, false);
          return;
        }
        const sp = window.theinmagStartPicker;
        if (sp && typeof sp.open === 'function') {
          sp.open({
            length: activeLength,
            confirmLabel: 'Add to bundle',
            preselect: bundleChosenStart,
            opener: modalSubmit,
            onPick: function (result) {
              bundleChosenStart = result.startMag;
              addMembershipWithStart(v, result.startMag, true);
            }
          });
          return;
        }
        /* No picker script (should not happen): safe default, never the sold-out issue. */
        const st = sp ? sp.state() : null;
        const fallback = printInStock ? currentIssue : nextIssue;
        addMembershipWithStart(v, st ? (st.currentSoldOut ? (st.prevAvailable ? st.prevIssue : st.nextIssue) : st.currentIssue) : fallback, true);
      });
    }

    /* Suppress unused `nextRelease` warning - we surface the formatted
       string in Liquid-rendered radio labels, but JS doesn't repaint
       them so we just hold the reference for future use. */
    void nextRelease;

    /* ============ Initial paint ============ */
    updateBundleUI();
  })();
</script>

{% schema %}
{
  "name": "Bundle picker",
  "tag": "section",
  "class": "shopify-section--theinmag-bundle-picker",
  "settings": [
    { "type": "header", "content": "Section copy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick your mags. Pick your Memberships." },
    { "type": "text", "id": "subhead", "label": "Subhead", "default": "Tap Add on anything you want. Adjust quantities in your bundle on the right. The discount appears at checkout." },
    { "type": "header", "content": "Sources" },
    { "type": "text", "id": "rail_collection", "label": "Rail collection handle", "info": "Single-issues collection. All Print/Digital mags + Snack Pack.", "default": "single-issues" },
    { "type": "text", "id": "snack_pack_handle", "label": "Snack Pack product handle", "default": "snack-pack" },
    { "type": "text", "id": "digital_stack_handle", "label": "Digital Stack handle (excluded)", "default": "theinmag-digital-stack" },
    { "type": "text", "id": "membership_product_handle", "label": "Membership product handle", "default": "membership" },
    { "type": "header", "content": "Membership covers" },
    { "type": "image_picker", "id": "print_member_image", "label": "Print Membership tile cover" },
    { "type": "text", "id": "print_member_image_filename", "label": "Print Membership fallback image", "info": "Either a filename in /assets/ (e.g. product-membership.jpg) OR a full Shopify Files / CDN URL.", "default": "product-membership.jpg" },
    { "type": "text", "id": "print_member_image_alt", "label": "Print Membership cover alt" },
    { "type": "image_picker", "id": "digital_member_image", "label": "Digital Membership tile cover" },
    { "type": "text", "id": "digital_member_image_filename", "label": "Digital Membership fallback image", "info": "Either a filename in /assets/ (e.g. digi_membership.jpg) OR a full Shopify Files / CDN URL.", "default": "digi_membership.jpg" },
    { "type": "text", "id": "digital_member_image_alt", "label": "Digital Membership cover alt" }
  ],
  "presets": [
    { "name": "Bundle picker" }
  ],
  "enabled_on": {
    "templates": ["page"]
  }
}
