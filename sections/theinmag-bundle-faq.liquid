{%- comment -%}
  theinmag-bundle-faq
  Bundle-specific FAQ accordion. Lavender bg, FAQ_HollowCircles.png in
  the left gutter per sitewide FAQ pattern. Mirrors theinmag-faq /
  theinmag-membership-faq accordion mechanics (h3 > button + panel +
  caret pseudo-elements) and emits FAQPage JSON-LD.

  Archetype: §6.16 FAQ accordion. Page-scoped data attribute is
  `bundle-faq-trigger` so this instance can coexist on a page with
  any other FAQ section without JS collision.
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading | default: 'Bundle questions, answered.'
  assign items = section.blocks | where: 'type', 'faq_item'
  assign pad_top = section.settings.padding_top | default: 72
  assign pad_bottom = section.settings.padding_bottom | default: 72
-%}

{%- comment -%}
  Sitewide kid character pool. Snippet is idempotent (guards with
  `window.__theinmagCharacterPoolInit`), safe to render alongside the
  Membership FAQ instance.
{%- endcomment -%}
{% render 'theinmag-character-pool' %}

<section
  class="theinmag-bundle-faq"
  data-theinmag-bundle-faq
  aria-labelledby="theinmag-bundle-faq-heading"
  style="--bfq-pt: {{ pad_top }}px; --bfq-pb: {{ pad_bottom }}px;"
>
  <span
    class="theinmag-bundle-faq__character"
    data-theinmag-pool-character
    aria-hidden="true"
  ></span>

  <div class="theinmag-bundle-faq__inner">
    <h2 id="theinmag-bundle-faq-heading" class="theinmag-bundle-faq__heading">{{ heading }}</h2>

    {%- if items.size > 0 -%}
      <ul class="theinmag-bundle-faq__list" role="list">
        {%- for block in items -%}
          {%- liquid
            assign q = block.settings.question
            assign a = block.settings.answer
            assign uid = section.id | append: '-' | append: forloop.index
          -%}
          <li class="theinmag-bundle-faq__item" {{ block.shopify_attributes }}>
            <h3 class="theinmag-bundle-faq__q">
              <button
                type="button"
                class="theinmag-bundle-faq__trigger"
                data-bundle-faq-trigger
                aria-expanded="false"
                aria-controls="theinmag-bundle-faq-panel-{{ uid }}"
                id="theinmag-bundle-faq-trigger-{{ uid }}"
              >
                <span class="theinmag-bundle-faq__q-text">{{ q }}</span>
                <span class="theinmag-bundle-faq__caret" aria-hidden="true"></span>
              </button>
            </h3>
            <div
              class="theinmag-bundle-faq__panel"
              id="theinmag-bundle-faq-panel-{{ uid }}"
              role="region"
              aria-labelledby="theinmag-bundle-faq-trigger-{{ uid }}"
              data-open="false"
            >
              <div class="theinmag-bundle-faq__answer">{{ a }}</div>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in items -%}
        {
          "@type": "Question",
          "name": {{ block.settings.question | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ block.settings.answer | strip_html | strip | json }}
          }
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
</script>

{% stylesheet %}
  .theinmag-bundle-faq {
    background-color: var(--color-lavender);
    color: var(--color-inky-purple-navy);
    padding: var(--bfq-pt, 72px) clamp(20px, 5vw, 64px) var(--bfq-pb, 72px);
    position: relative;
    overflow: hidden;
  }

  /* Left-gutter decorative PNG (sitewide FAQ pattern). Hidden below
     750px so the inner column reads cleanly on mobile. */
  .theinmag-bundle-faq::before {
    content: '';
    position: absolute;
    top: 50%;
    left: -40px;
    transform: translateY(-50%);
    width: 280px;
    height: 280px;
    background-image: url('{{ "FAQ_HollowCircles.png" | asset_url }}');
    background-size: contain;
    background-repeat: no-repeat;
    background-position: left center;
    opacity: 0.55;
    pointer-events: none;
    z-index: 0;
  }
  @media (max-width: 749px) {
    .theinmag-bundle-faq::before { display: none; }
  }

  .theinmag-bundle-faq__inner {
    max-width: 760px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  /* Kid character peeking from the left edge, slightly above the
     section's vertical centre, slightly larger than the Membership
     FAQ instance per brief. Scroll-pop pattern + sitewide bob from
     theinmag-character-pool.liquid. */
  .theinmag-bundle-faq__character {
    position: absolute;
    top: 22%;
    left: clamp(16px, 4vw, 96px);
    width: clamp(128px, 16vw, 220px);
    z-index: 0;
    pointer-events: none;
    opacity: 0;
    transform: translateX(-48px) rotate(-6deg);
    transition: opacity 0.7s ease, transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .theinmag-bundle-faq__character.is-popped {
    opacity: 1;
    transform: translateX(0) rotate(-6deg);
  }
  @media (max-width: 749px) {
    .theinmag-bundle-faq {
      overflow: visible;
    }
    .theinmag-bundle-faq__character {
      top: -40px;
      left: 12px;
      width: 118px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .theinmag-bundle-faq__character {
      transition: none;
      opacity: 1;
      transform: rotate(-6deg);
    }
  }

  .theinmag-bundle-faq__heading {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(28px, 4.5vw, 40px);
    line-height: 1.15;
    color: var(--color-purple-dark);
    margin: 0 0 var(--space-xl);
    text-align: center;
  }

  .theinmag-bundle-faq__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(93, 58, 122, 0.18);
  }

  .theinmag-bundle-faq__item {
    border-bottom: 1px solid rgba(93, 58, 122, 0.18);
  }

  .theinmag-bundle-faq__q {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 17px;
    line-height: 1.4;
  }

  .theinmag-bundle-faq__trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    background: transparent;
    border: 0;
    padding: var(--space-lg) 0;
    color: var(--color-inky-purple-navy);
    font: inherit;
    text-align: left;
    cursor: pointer;
    min-height: 56px;
  }

  .theinmag-bundle-faq__q-text { flex: 1; }

  .theinmag-bundle-faq__caret {
    position: relative;
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
    display: inline-block;
  }
  .theinmag-bundle-faq__caret::before,
  .theinmag-bundle-faq__caret::after {
    content: '';
    position: absolute;
    background-color: var(--color-purple-dark);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .theinmag-bundle-faq__caret::before {
    top: 50%;
    left: 0;
    right: 0;
    height: 2px;
    transform: translateY(-50%);
  }
  .theinmag-bundle-faq__caret::after {
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    transform: translateX(-50%);
  }
  .theinmag-bundle-faq__trigger[aria-expanded='true'] .theinmag-bundle-faq__caret::after {
    transform: translateX(-50%) scaleY(0);
    opacity: 0;
  }

  .theinmag-bundle-faq__panel {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }
  .theinmag-bundle-faq__panel[data-open='true'] {
    max-height: 1500px;
  }
  .theinmag-bundle-faq__answer {
    padding: 0 0 var(--space-lg);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-inky-purple-navy);
    white-space: pre-line;
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-bundle-faq__panel { transition: none; }
    .theinmag-bundle-faq__caret::before,
    .theinmag-bundle-faq__caret::after { transition: none; }
  }
{% endstylesheet %}

<script>
  (function () {
    const root = document.querySelector('[data-theinmag-bundle-faq]');
    if (!root) return;
    const triggers = root.querySelectorAll('[data-bundle-faq-trigger]');
    triggers.forEach(function (trigger) {
      trigger.addEventListener('click', function () {
        const expanded = trigger.getAttribute('aria-expanded') === 'true';
        const panelId = trigger.getAttribute('aria-controls');
        const panel = panelId ? document.getElementById(panelId) : null;
        triggers.forEach(function (other) {
          if (other !== trigger && other.getAttribute('aria-expanded') === 'true') {
            other.setAttribute('aria-expanded', 'false');
            const otherPanelId = other.getAttribute('aria-controls');
            const otherPanel = otherPanelId ? document.getElementById(otherPanelId) : null;
            if (otherPanel) otherPanel.setAttribute('data-open', 'false');
          }
        });
        trigger.setAttribute('aria-expanded', expanded ? 'false' : 'true');
        if (panel) panel.setAttribute('data-open', expanded ? 'false' : 'true');
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Bundle FAQ",
  "tag": "section",
  "class": "shopify-section--theinmag-bundle-faq",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (H2)", "default": "Bundle questions, answered." },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 128, "step": 4, "default": 72, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 128, "step": 4, "default": 72, "unit": "px" }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ item",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "textarea", "id": "answer", "label": "Answer", "info": "Blank line separates paragraphs." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle FAQ",
      "blocks": [
        { "type": "faq_item", "settings": { "question": "How do bundle discounts work?", "answer": "Add 3 items, get 5% off. 5 items, 10%. 8 or more, 15%. The discount applies to your whole cart and you'll see it at checkout. No code needed." } },
        { "type": "faq_item", "settings": { "question": "What counts as an item?", "answer": "Each mag is one item. Each Snack Pack is one item. Each Membership is one item, no matter how many issues it includes." } },
        { "type": "faq_item", "settings": { "question": "Can I mix print and digital in the same bundle?", "answer": "Yes. Mix any format with any other format. Bundle a Print Membership with three digital singles and the discount kicks in just the same." } },
        { "type": "faq_item", "settings": { "question": "What about Rolling Memberships?", "answer": "Rolling Memberships count as 1 item toward your bundle. The bundle discount applies to your first Rolling drop. Future renewals charge at the usual rate." } },
        { "type": "faq_item", "settings": { "question": "Is there a minimum bundle size?", "answer": "No minimum to add items, but the discount only kicks in at 3 items. Below that, everything stays at the regular price." } }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["page"]
  }
}
{% endschema %}
