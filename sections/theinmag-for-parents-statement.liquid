{%- comment -%}
  theinmag-for-parents-statement
  Section 3 of /pages/for-parents - "Why send IN".

  Editorial statement panel that opens the page's lavender chapter
  (sections 3-4-5 share --color-wave-purple background as one
  emotional beat per design system 3.2). Reads as the page's "the
  moment a kid sees their name in print, something changes" beat.

  Layout: heading + body + optional centred image + primary CTA +
  trust microcopy. All centered. Generous vertical padding so the
  section earns its weight as the emotional opener of the chapter.

  Reusable: drop into any audience page where the value proposition
  needs an editorial chapter break.
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading
  assign body = section.settings.body
  assign cta_label = section.settings.cta_label
  assign cta_link = section.settings.cta_link
  assign trust_microcopy = section.settings.trust_microcopy
  assign bg_color = section.settings.bg_color | default: '#FBF6EA'
  assign show_character = section.settings.show_character
  assign statement_layout = section.settings.layout | default: 'three_col'
  assign layout_class = ''
  if statement_layout == 'two_col'
    assign layout_class = ' theinmag-for-parents-statement--two-col'
  endif
-%}

<section
  class="theinmag-for-parents-statement{{ layout_class }}"
  aria-labelledby="theinmag-for-parents-statement-heading-{{ section.id }}"
  style="--theinmag-fps-bg: {{ bg_color }};"
>
  {%- if show_character -%}
    {% render 'theinmag-character-pool' %}
    <span class="theinmag-for-parents-statement__character" data-theinmag-pool-character aria-hidden="true"></span>
  {%- endif -%}

  <div class="theinmag-for-parents-statement__inner">
    <div class="theinmag-for-parents-statement__col theinmag-for-parents-statement__col--heading">
      {%- if heading != blank -%}
        <h2
          id="theinmag-for-parents-statement-heading-{{ section.id }}"
          class="theinmag-for-parents-statement__heading"
        >
          {{ heading }}
        </h2>
      {%- endif -%}
    </div>

    <div class="theinmag-for-parents-statement__col theinmag-for-parents-statement__col--body">
      {%- if body != blank -%}
        <p class="theinmag-for-parents-statement__body">{{ body }}</p>
      {%- endif -%}
    </div>

    <div class="theinmag-for-parents-statement__col theinmag-for-parents-statement__col--cta">
      {%- if cta_label != blank -%}
        <a
          class="theinmag-btn theinmag-btn--primary theinmag-for-parents-statement__cta"
          href="{{ cta_link | default: '/pages/send-in' }}"
        >
          {{ cta_label }}
        </a>
      {%- endif -%}

      {%- if trust_microcopy != blank -%}
        <p class="theinmag-for-parents-statement__trust">{{ trust_microcopy }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{%- stylesheet -%}
  /* Short conversion beat - tight vertical padding so the section
     reads as a quick interlude between chapters, not a hero moment. */
  .theinmag-for-parents-statement {
    background-color: var(--theinmag-fps-bg, #FBF6EA);
    color: var(--color-inky-purple-navy, #2A1F3D);
    padding: clamp(28px, 4vw, 48px) clamp(20px, 5vw, 64px);
    position: relative;
  }

  /* Kid character peeking in near the heading (top-left). Slightly bigger
     than the standard pillar character. Pops in from the left on scroll;
     the pool snippet's bob keeps it gently moving. Hidden below desktop so
     it never clashes with the stacked, centred heading. */
  .theinmag-for-parents-statement__character {
    position: absolute;
    top: clamp(0px, 1vw, 14px);
    left: clamp(0px, 2vw, 36px);
    width: clamp(120px, 14vw, 180px);
    height: auto;
    z-index: 2;
    transform: translateX(-44px) rotate(-6deg);
  }

  .theinmag-for-parents-statement__character.is-popped {
    transform: translateX(0) rotate(-6deg);
  }

  @media (max-width: 989px) {
    .theinmag-for-parents-statement__character {
      display: none;
    }
  }

  /* 3-column horizontal layout on desktop: heading | body | CTA+trust.
     Stacks vertically on mobile (heading -> body -> CTA -> trust).
     Each column centers its own content. */
  .theinmag-for-parents-statement__inner {
    max-width: 1320px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(20px, 3vw, 32px);
    align-items: center;
  }

  @media (min-width: 990px) {
    .theinmag-for-parents-statement__inner {
      grid-template-columns: 1fr 1fr 1fr;
      gap: clamp(32px, 4vw, 56px);
    }
  }

  /* Two-column variant: heading + CTA + trust stack in the left column
     (CTA sits directly under the heading); the body paragraph sits on the
     right by itself. Narrower max-width so the block reads more centred. */
  @media (min-width: 990px) {
    .theinmag-for-parents-statement--two-col .theinmag-for-parents-statement__inner {
      max-width: 1040px;
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        "heading body"
        "cta body";
      column-gap: clamp(40px, 5vw, 72px);
      row-gap: clamp(16px, 2vw, 24px);
    }

    .theinmag-for-parents-statement--two-col .theinmag-for-parents-statement__col--heading {
      grid-area: heading;
      align-self: end;
    }

    .theinmag-for-parents-statement--two-col .theinmag-for-parents-statement__col--cta {
      grid-area: cta;
      align-self: start;
    }

    .theinmag-for-parents-statement--two-col .theinmag-for-parents-statement__col--body {
      grid-area: body;
    }
  }

  .theinmag-for-parents-statement__col {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .theinmag-for-parents-statement__heading {
    margin: 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: clamp(24px, 3vw, 32px);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-inky-purple-navy, #2A1F3D);
    text-wrap: balance;
  }

  .theinmag-for-parents-statement__body {
    margin: 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: clamp(15px, 1.6vw, 17px);
    line-height: 1.7;
    color: var(--color-inky-purple-navy, #2A1F3D);
  }

  .theinmag-for-parents-statement__col--cta {
    gap: clamp(10px, 1.5vw, 14px);
  }

  .theinmag-for-parents-statement__cta {
    align-self: center;
  }

  .theinmag-for-parents-statement__trust {
    margin: 0;
    max-width: 36ch;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-style: italic;
    font-size: clamp(13px, 1.3vw, 14px);
    line-height: 1.5;
    color: rgba(42, 31, 61, 0.65);
    text-align: center;
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "For parents statement",
  "tag": "section",
  "class": "theinmag-for-parents-statement-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Editorial statement panel. 3-column horizontal layout (heading | body | CTA + trust). Cream bg by default - reads as a quiet conversion beat rather than a chapter opener."
    },
    {
      "type": "checkbox",
      "id": "show_character",
      "label": "Show kid character near the heading",
      "info": "Random kid character pops in top-left beside the heading (desktop only).",
      "default": false
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "three_col", "label": "Three columns (heading | body | CTA)" },
        { "value": "two_col", "label": "Two columns (heading + CTA | body)" }
      ],
      "default": "three_col"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "The moment a kid sees their name in print, something changes."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "They stand a little taller. They tell their nan about it. They go back to the page weeks later and check it's still there. It is. That feeling - being seen, being chosen, being part of something real - is the whole reason we make theINmag. And every single kid who sends in a creation has a shot at it."
    },
    {
      "type": "header",
      "content": "CTA"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Send IN your kid's creation"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Trust microcopy"
    },
    {
      "type": "text",
      "id": "trust_microcopy",
      "label": "Trust microcopy",
      "info": "Small italic line under the CTA.",
      "default": "Free to submit. Open to any Aussie kid. We read everything."
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background colour",
      "info": "Defaults to --color-cream (#FBF6EA).",
      "default": "#FBF6EA"
    }
  ],
  "presets": [
    {
      "name": "For parents statement"
    }
  ]
}
{% endschema %}
