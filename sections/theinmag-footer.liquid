{%- comment -%}
  theinmag-footer
  Site-wide footer. Replaces Dawn's stock footer inside footer-group.json.

  Visual stack (desktop, top to bottom):
    1. Optional torn-paper top edge (decorative)
    2. Five-column grid:
         [Newsletter] [Shop] [About] [Resources] [Follow]
       Newsletter is the heart and lives as a column on the left, Maude-
       style: small heading, sub-paragraph, first name + email rows with
       underline-only inputs and a "sign up" text link.
    3. Acknowledgement of Country - full-width row, dignified, with the
       kid artist illustration as the visual anchor.
    4. Bottom row: white logo (left) | copyright + ABN (centre) | legal
       links (right).

  Mobile stack (top to bottom):
    1. Newsletter
    2. Three nav columns as native <details> accordions, collapsed
    3. Follow row (small, three social icons centred)
    4. Acknowledgement of Country with kid art
    5. White logo (centred)
    6. Copyright + ABN
    7. Legal links wrapping

  Background: inky purple-navy (#2A1F3D) with cream text. The dark zone
  closes the page deliberately and bookends the inky purple-navy
  announcement bar above the page.

  Newsletter form posts to Klaviyo's public client/subscriptions
  endpoint. Public company_id is safe to expose. List_id selects which
  list the signup lands in.

  Acknowledgement of Country: short version visible site-wide, links to
  /pages/acknowledgement for the full statement. Static, no animation.
  The kid artist illustration is the visual anchor - this is theINmag's
  brand moment of acknowledgement, not a generic compliance footer.

  Spec: ../theinmag-docs/theinmag-design-tokens.md, ../theinmag-docs/homepage-build-spec.md "Footer".
{%- endcomment -%}

{%- liquid
  assign newsletter_heading = section.settings.newsletter_heading | default: 'Get your FREE e-mag!'
  assign newsletter_subtext = section.settings.newsletter_subtext
  assign newsletter_button = section.settings.newsletter_button_label | default: 'sign up'
  assign newsletter_consent = section.settings.newsletter_consent_label
  assign klaviyo_company_id = section.settings.klaviyo_company_id
  assign klaviyo_list_id = section.settings.klaviyo_list_id

  assign follow_heading = section.settings.follow_heading | default: 'Follow'

  assign aoc_heading = section.settings.aoc_heading | default: 'Acknowledgement of Country'
  assign aoc_text = section.settings.aoc_text
  assign aoc_artist_image = section.settings.aoc_artist_image
  assign aoc_artist_credit = section.settings.aoc_artist_credit

  assign white_logo = section.settings.white_logo
  assign abn = section.settings.abn
  assign contact_email = section.settings.contact_email

  assign legal_url = section.settings.legal_url | default: '/pages/child-safety-terms-conditions-privacy-policy'
  assign legal_label = section.settings.legal_label | default: 'Child Safety, Terms and Privacy'
  assign shipping_refunds_url = section.settings.shipping_refunds_url | default: '/pages/shipping-refunds'

  assign instagram_url = section.settings.instagram_url
  assign facebook_url = section.settings.facebook_url
  assign youtube_url = section.settings.youtube_url

  assign current_year = 'now' | date: '%Y'
-%}

<footer
  class="theinmag-footer"
  role="contentinfo"
  aria-labelledby="theinmag-footer-newsletter-heading"
>
  <div class="theinmag-footer__inner">

    {%- comment -%} ============== Main grid: Newsletter + nav columns + Follow ============== {%- endcomment -%}
    <div class="theinmag-footer__grid">

      {%- comment -%} ----- Newsletter column ----- {%- endcomment -%}
      <section class="theinmag-footer__newsletter" aria-labelledby="theinmag-footer-newsletter-heading">
        <h2 class="theinmag-footer__newsletter-heading" id="theinmag-footer-newsletter-heading">
          {{ newsletter_heading | replace: 'FREE', '<span class="theinmag-footer__newsletter-emphasis">FREE</span>' }}
        </h2>

        {%- if newsletter_subtext != blank -%}
          <p class="theinmag-footer__newsletter-subtext">{{ newsletter_subtext }}</p>
        {%- endif -%}

        <form
          class="theinmag-footer__form"
          data-newsletter-form
          data-klaviyo-company-id="{{ klaviyo_company_id }}"
          data-klaviyo-list-id="{{ klaviyo_list_id }}"
          novalidate
        >
          <div class="theinmag-footer__field theinmag-footer__field--solo">
            <label class="theinmag-footer__label visually-hidden" for="theinmag-footer-firstname">First name</label>
            <input
              type="text"
              id="theinmag-footer-firstname"
              name="first_name"
              class="theinmag-footer__input"
              placeholder="your first name"
              autocomplete="given-name"
            >
          </div>

          <div class="theinmag-footer__field theinmag-footer__field--with-submit">
            <label class="theinmag-footer__label visually-hidden" for="theinmag-footer-email">Email address</label>
            <input
              type="email"
              id="theinmag-footer-email"
              name="email"
              class="theinmag-footer__input"
              placeholder="your email address"
              autocomplete="email"
              required
            >
            <button
              type="submit"
              class="theinmag-footer__submit"
              data-newsletter-submit
            >
              {{ newsletter_button }}
            </button>
          </div>

          {%- if newsletter_consent != blank -%}
            <label class="theinmag-footer__consent">
              <input type="checkbox" name="consent" value="yes" class="theinmag-footer__consent-input" required>
              <span class="theinmag-footer__consent-text">{{ newsletter_consent }}</span>
            </label>
          {%- endif -%}

          <p class="theinmag-footer__form-status" data-newsletter-status role="status" aria-live="polite"></p>
        </form>
      </section>

      {%- comment -%} ----- Nav columns (blocks) ----- {%- endcomment -%}
      {%- assign latest_mag_url = shop.metafields.theinmag.promoted_issue_handle | default: 'mag10' | prepend: '/products/' -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'nav_column' -%}
          {%- liquid
            # Per-block sentinel swap. Any link_N_url set to
            # /products/latest-mag resolves to whatever issue is
            # currently being promoted via shop.metafields.theinmag
            # .promoted_issue_handle. One metafield flip on drop day
            # rotates every "Latest issue" link site-wide.
            assign link_1_url = block.settings.link_1_url
            if link_1_url == '/products/latest-mag'
              assign link_1_url = latest_mag_url
            endif
            assign link_2_url = block.settings.link_2_url
            if link_2_url == '/products/latest-mag'
              assign link_2_url = latest_mag_url
            endif
            assign link_3_url = block.settings.link_3_url
            if link_3_url == '/products/latest-mag'
              assign link_3_url = latest_mag_url
            endif
            assign link_4_url = block.settings.link_4_url
            if link_4_url == '/products/latest-mag'
              assign link_4_url = latest_mag_url
            endif
            assign link_5_url = block.settings.link_5_url
            if link_5_url == '/products/latest-mag'
              assign link_5_url = latest_mag_url
            endif
            assign link_6_url = block.settings.link_6_url
            if link_6_url == '/products/latest-mag'
              assign link_6_url = latest_mag_url
            endif
          -%}
          <details class="theinmag-footer__column" open {{ block.shopify_attributes }}>
            <summary class="theinmag-footer__column-heading">
              {{ block.settings.heading }}
              <svg class="theinmag-footer__column-caret" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                <path d="M7 10l5 5 5-5z"></path>
              </svg>
            </summary>
            <ul class="theinmag-footer__column-list" role="list">
              {%- if block.settings.link_1_label != blank -%}
                <li><a class="theinmag-footer__column-link" href="{{ link_1_url | default: '#' }}">{{ block.settings.link_1_label }}</a></li>
              {%- endif -%}
              {%- if block.settings.link_2_label != blank -%}
                <li><a class="theinmag-footer__column-link" href="{{ link_2_url | default: '#' }}">{{ block.settings.link_2_label }}</a></li>
              {%- endif -%}
              {%- if block.settings.link_3_label != blank -%}
                <li><a class="theinmag-footer__column-link" href="{{ link_3_url | default: '#' }}">{{ block.settings.link_3_label }}</a></li>
              {%- endif -%}
              {%- if block.settings.link_4_label != blank -%}
                <li><a class="theinmag-footer__column-link" href="{{ link_4_url | default: '#' }}">{{ block.settings.link_4_label }}</a></li>
              {%- endif -%}
              {%- if block.settings.link_5_label != blank -%}
                <li><a class="theinmag-footer__column-link" href="{{ link_5_url | default: '#' }}">{{ block.settings.link_5_label }}</a></li>
              {%- endif -%}
              {%- if block.settings.link_6_label != blank -%}
                <li><a class="theinmag-footer__column-link" href="{{ link_6_url | default: '#' }}">{{ block.settings.link_6_label }}</a></li>
              {%- endif -%}
            </ul>
          </details>
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%} ----- Follow column - socials as a stacked icon list ----- {%- endcomment -%}
      {%- if instagram_url != blank or facebook_url != blank or youtube_url != blank -%}
        <div class="theinmag-footer__follow">
          <h2 class="theinmag-footer__follow-heading">{{ follow_heading }}</h2>
          <ul class="theinmag-footer__follow-list" role="list" aria-label="Follow theINmag">
            {%- if instagram_url != blank -%}
              <li>
                <a class="theinmag-footer__social-link" href="{{ instagram_url }}" target="_blank" rel="noopener noreferrer" aria-label="theINmag on Instagram">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" focusable="false">
                    <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                    <circle cx="12" cy="12" r="4"></circle>
                    <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"></circle>
                  </svg>
                </a>
              </li>
            {%- endif -%}
            {%- if facebook_url != blank -%}
              <li>
                <a class="theinmag-footer__social-link" href="{{ facebook_url }}" target="_blank" rel="noopener noreferrer" aria-label="theINmag on Facebook">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                    <path d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.7c0-.9.3-1.5 1.6-1.5h1.7V4.3a23 23 0 0 0-2.5-.1c-2.5 0-4.2 1.5-4.2 4.3v2.4H7.4V14h2.7v8h3.4Z"></path>
                  </svg>
                </a>
              </li>
            {%- endif -%}
            {%- if youtube_url != blank -%}
              <li>
                <a class="theinmag-footer__social-link" href="{{ youtube_url }}" target="_blank" rel="noopener noreferrer" aria-label="theINmag on YouTube">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                    <path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8ZM10 15V9l5.2 3-5.2 3Z"></path>
                  </svg>
                </a>
              </li>
            {%- endif -%}
          </ul>
        </div>
      {%- endif -%}

    </div>

    {%- comment -%} ============== Closing row - AOC on left, brand stack on right ============== {%- endcomment -%}
    <div class="theinmag-footer__close-row">

      <section class="theinmag-footer__aoc" aria-labelledby="theinmag-footer-aoc-heading">
        <div class="theinmag-footer__aoc-figure-col">
          {%- if aoc_artist_image != blank -%}
            <figure class="theinmag-footer__aoc-figure">
              <img
                class="theinmag-footer__aoc-image"
                src="{{ aoc_artist_image | image_url: width: 600 }}"
                alt="Acknowledgement of Country illustration by a First Nations kid artist"
                loading="lazy"
                width="{{ aoc_artist_image.width }}"
                height="{{ aoc_artist_image.height }}"
              >
              {%- if aoc_artist_credit != blank -%}
                <figcaption class="theinmag-footer__aoc-credit">{{ aoc_artist_credit }}</figcaption>
              {%- endif -%}
            </figure>
          {%- endif -%}
        </div>

        <div class="theinmag-footer__aoc-body">
          <h2 class="theinmag-footer__aoc-heading" id="theinmag-footer-aoc-heading">
            {{ aoc_heading }}
          </h2>

          {%- if aoc_text != blank -%}
            <div class="theinmag-footer__aoc-text">{{ aoc_text }}</div>
          {%- endif -%}
        </div>
      </section>

      <div class="theinmag-footer__brand-stack">
        <a class="theinmag-footer__white-logo-link" href="{{ routes.root_url }}" aria-label="theINmag home">
          {%- if white_logo != blank -%}
            <img class="theinmag-footer__white-logo" src="{{ white_logo | image_url: width: 600 }}" alt="theINmag" loading="lazy">
          {%- else -%}
            <img class="theinmag-footer__white-logo" src="{{ 'whitelogo.svg' | asset_url }}" alt="theINmag" loading="lazy">
          {%- endif -%}
        </a>

        <p class="theinmag-footer__copyright">
          <span class="theinmag-footer__copyright-line">&copy; {{ current_year }} theINmag</span>
          {%- if abn != blank -%}
            <span class="theinmag-footer__copyright-line">ABN {{ abn }}</span>
          {%- endif -%}
          {%- if contact_email != blank -%}
            <span class="theinmag-footer__copyright-line"><a class="theinmag-footer__copyright-link" href="mailto:{{ contact_email }}">{{ contact_email }}</a></span>
          {%- endif -%}
        </p>

        <ul class="theinmag-footer__legal" role="list" aria-label="Legal">
          <li><a class="theinmag-footer__legal-link" href="{{ legal_url }}">{{ legal_label }}</a></li>
          <li><a class="theinmag-footer__legal-link" href="{{ shipping_refunds_url }}">Shipping and Refunds</a></li>
        </ul>
      </div>

    </div>

  </div>

  {%- comment -%}
    Single authoritative Organization entity for the whole site. The stable @id lets
    other JSON-LD (Article publisher, AboutPage parentOrganization) reference it later.
    sameAs is built from the social URLs set in this section's settings, so it stays in
    sync with the visible footer buttons. YouTube is intentionally blank for now (channel
    not built out yet) - fill the Footer "YouTube URL" field to surface it in BOTH the
    footer button and this schema in one step.
  {%- endcomment -%}
  {%- assign org_same_as = '' -%}
  {%- if instagram_url != blank -%}{%- assign org_same_as = org_same_as | append: instagram_url | append: '||' -%}{%- endif -%}
  {%- if facebook_url != blank -%}{%- assign org_same_as = org_same_as | append: facebook_url | append: '||' -%}{%- endif -%}
  {%- if youtube_url != blank -%}{%- assign org_same_as = org_same_as | append: youtube_url | append: '||' -%}{%- endif -%}
  {%- assign org_same_as = org_same_as | split: '||' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": "{{ shop.url }}/#organization",
      "name": "theINmag",
      "alternateName": "theINmag - made by Aussie kids, for Aussie kids",
      "url": "{{ shop.url }}",
      "logo": "{{ 'theINmag_logo.png' | asset_url | prepend: 'https:' }}",
      "slogan": "The magazine for creative kids",
      "description": "theINmag is Australia's magazine made by kids, for kids - 100% kid-created, ad-free, and sustainably printed. Every issue publishes real drawings, stories, and creations sent in by Aussie kids.",
      "areaServed": {
        "@type": "Country",
        "name": "Australia"
      },
      "founder": [
        { "@type": "Person", "name": "Ryan", "jobTitle": "Co-founder, theINmag" },
        { "@type": "Person", "name": "Tam", "jobTitle": "Co-founder, theINmag" }
      ],
      "sameAs": {{ org_same_as | json }}
    }
  </script>
</footer>

{% stylesheet %}
  /* ================================================================
     theinmag-footer
     Inky purple-navy dark zone closing every page. Cream text.

     Layout:
       - Mobile: vertical stack. Newsletter on top, AOC after the nav
         accordions, white logo + copyright + legal at the bottom.
       - Desktop: 5-column grid (Newsletter | 3 nav | Follow), then a
         full-width AOC row, then a 3-zone bottom row.
     ================================================================ */

  .theinmag-footer-section {
    margin: 0;
    padding: 0;
    line-height: 0;
  }

  .theinmag-footer {
    background-color: var(--color-inky-purple-navy);
    color: var(--color-cream);
    line-height: 1.5;
    padding: var(--space-2xl) var(--space-md);
  }

  @media (min-width: 750px) {
    .theinmag-footer { padding: var(--space-3xl) var(--space-xl); }
  }

  @media (min-width: 990px) {
    .theinmag-footer { padding: var(--space-4xl) var(--space-xl); }
  }

  .theinmag-footer__inner {
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  @media (min-width: 990px) {
    .theinmag-footer__inner { gap: var(--space-3xl); }
  }

  /* ================================================================
     Main grid - Newsletter | 3 nav columns | Follow
     Mobile: stacked. Newsletter first, columns as accordions, Follow
     row at the end of the column stack.
     Desktop: 5-track grid.
     ================================================================ */

  .theinmag-footer__grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  @media (min-width: 990px) {
    .theinmag-footer__grid {
      display: grid;
      grid-template-columns: 1.6fr 1fr 1fr 1fr 0.7fr;
      gap: var(--space-2xl);
      align-items: start;
    }
  }

  /* ================================================================
     Newsletter column - the Maude-chic heart of the footer.
     Heading is Post Regular (brand voice), inputs are underline-only
     (clean, premium), submit is a small text-link "sign up" rather
     than a yellow stamp. Stamp would shout against the chic register.
     ================================================================ */

  .theinmag-footer__newsletter {
    /* Mobile: full-width on top of the column stack. */
    padding-bottom: var(--space-md);
  }

  @media (min-width: 990px) {
    .theinmag-footer__newsletter {
      padding-bottom: 0;
      /* Pad-right gives the email input space to breathe before the
         next column's content. */
      padding-right: var(--space-md);
    }
  }

  .theinmag-footer__newsletter-heading {
    font-family: var(--font-heading);
    color: var(--color-cream);
    font-size: clamp(24px, 2.6vw, 30px);
    line-height: 1.15;
    margin: 0 0 var(--space-sm);
    font-weight: 400;
  }

  .theinmag-footer__newsletter-emphasis {
    font-size: 1.4em;
    color: var(--color-yellow);
    line-height: 0.9;
  }

  .theinmag-footer__newsletter-subtext {
    font-family: var(--font-body);
    color: var(--color-cream);
    opacity: 0.8;
    font-size: 14px;
    line-height: 1.5;
    margin: 0 0 var(--space-lg);
  }

  .theinmag-footer__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .theinmag-footer__field {
    display: flex;
    align-items: center;
    border-bottom: 1px solid rgba(251, 246, 234, 0.35);
    padding-bottom: 6px;
    transition: border-color var(--transition-standard);
  }

  .theinmag-footer__field:focus-within {
    border-color: var(--color-yellow);
  }

  .theinmag-footer__field--solo {
    /* First-name row sits on its own. */
  }

  .theinmag-footer__field--with-submit {
    /* Email input + sign up text-link share a row. */
    gap: var(--space-sm);
  }

  .theinmag-footer__input {
    font-family: var(--font-body);
    font-size: 15px;
    background-color: transparent;
    color: var(--color-cream);
    border: none;
    padding: 8px 0;
    flex: 1;
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
  }

  .theinmag-footer__input:focus,
  .theinmag-footer__input:focus-visible {
    outline: none;
    box-shadow: none;
  }

  .theinmag-footer__input::placeholder {
    color: var(--color-cream);
    opacity: 0.55;
  }

  /* Auto-fill override - some browsers paint a coloured rectangle
     behind autofilled fields that ignores the transparent background.
     The inset shadow trick paints over it with the dark footer bg. */
  .theinmag-footer__input:-webkit-autofill,
  .theinmag-footer__input:-webkit-autofill:hover,
  .theinmag-footer__input:-webkit-autofill:focus {
    -webkit-box-shadow: 0 0 0 1000px var(--color-inky-purple-navy) inset;
    -webkit-text-fill-color: var(--color-cream);
    caret-color: var(--color-cream);
  }

  /* "sign up" text-link button. Sits on the right of the email row,
     behaves as a button. */
  .theinmag-footer__submit {
    flex-shrink: 0;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 14px;
    color: var(--color-cream);
    background: transparent;
    border: none;
    padding: 4px 0 4px var(--space-sm);
    cursor: pointer;
    letter-spacing: 0.04em;
    transition: color var(--transition-standard);
  }

  .theinmag-footer__submit:hover,
  .theinmag-footer__submit:focus-visible {
    color: var(--color-yellow);
    outline: none;
  }

  .theinmag-footer__submit:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .theinmag-footer__consent {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    font-size: 12px;
    color: var(--color-cream);
    opacity: 0.65;
    text-align: left;
    cursor: pointer;
    line-height: 1.5;
  }

  .theinmag-footer__consent-input {
    margin-top: 3px;
    accent-color: var(--color-yellow);
    flex-shrink: 0;
  }

  .theinmag-footer__form-status {
    font-size: 13px;
    margin: 0;
    min-height: 18px;
    color: var(--color-cream);
  }

  .theinmag-footer__form-status[data-state="success"] { color: var(--color-yellow); }
  .theinmag-footer__form-status[data-state="error"] { color: #FFB4A0; }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ================================================================
     Nav columns
     Mobile: native <details> accordions.
     Desktop: always-open columns, caret hidden.
     ================================================================ */

  .theinmag-footer__column {
    border-top: 1px solid rgba(251, 246, 234, 0.12);
  }

  @media (min-width: 990px) {
    .theinmag-footer__column { border-top: none; }
  }

  .theinmag-footer__column-heading {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-cream);
    padding: var(--space-md) 0;
    user-select: none;
  }

  .theinmag-footer__column-heading::-webkit-details-marker { display: none; }

  .theinmag-footer__column-caret {
    width: 16px;
    height: 16px;
    transition: transform var(--transition-standard);
    color: var(--color-cream);
    opacity: 0.7;
