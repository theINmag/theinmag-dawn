<script>
  (function () {
    var form = document.querySelector('[data-newsletter-form]');
    if (!form) return;

    var status = form.querySelector('[data-newsletter-status]');
    var submit = form.querySelector('[data-newsletter-submit]');

    var setStatus = function (message, state) {
      if (!status) return;
      status.textContent = message;
      if (state) {
        status.setAttribute('data-state', state);
      } else {
        status.removeAttribute('data-state');
      }
    };

    // Ties THIS BROWSER to the profile we just subscribed. Without it a new
    // subscriber stays anonymous to Klaviyo's onsite tracking, so nothing that
    // depends on knowing who is browsing (Active on Site, Viewed Product,
    // browse abandonment) ever fires for them. Klaviyo's own popup does this
    // automatically; posting to the subscriptions API alone does not.
    // Feature-detected and wrapped: analytics must never break a good signup.
    var identifyToKlaviyo = function (email, firstName) {
      try {
        if (window.klaviyo && typeof window.klaviyo.identify === 'function') {
          var person = { email: email };
          if (firstName) person.first_name = firstName;
          window.klaviyo.identify(person);
        } else if (window._learnq && typeof window._learnq.push === 'function') {
          // Legacy onsite object uses $-prefixed keys.
          var legacy = { $email: email };
          if (firstName) legacy.$first_name = firstName;
          window._learnq.push(['identify', legacy]);
        }
      } catch (err) {
        console.warn('[theinmag-footer] Klaviyo identify skipped:', err);
      }
    };

    form.addEventListener('submit', function (event) {
      event.preventDefault();

      var emailField = form.querySelector('input[name="email"]');
      var firstNameField = form.querySelector('input[name="first_name"]');
      var consentField = form.querySelector('input[name="consent"]');

      var email = emailField ? emailField.value.trim() : '';
      var firstName = firstNameField ? firstNameField.value.trim() : '';
      var consent = consentField ? consentField.checked : true;

      if (!email) {
        setStatus('Pop your email in first.', 'error');
        if (emailField) emailField.focus();
        return;
      }

      if (consentField && !consent) {
        setStatus('Tick the consent box to subscribe.', 'error');
        return;
      }

      var companyId = form.getAttribute('data-klaviyo-company-id');
      var listId = form.getAttribute('data-klaviyo-list-id');

      if (!companyId || !listId) {
        setStatus('Newsletter signup is being wired up. Try again soon.', 'error');
        return;
      }

      submit.disabled = true;
      setStatus('Signing you up...');

      var profile = {
        type: 'profile',
        attributes: { email: email }
      };
      if (firstName) {
        profile.attributes.first_name = firstName;
      }

      var body = {
        data: {
          type: 'subscription',
          attributes: {
            custom_source: 'Footer signup',
            profile: { data: profile }
          },
          relationships: {
            list: { data: { type: 'list', id: listId } }
          }
        }
      };

      fetch('https://a.klaviyo.com/client/subscriptions/?company_id=' + encodeURIComponent(companyId), {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'revision': '2024-10-15'
        },
        body: JSON.stringify(body)
      })
        .then(function (response) {
          if (response.ok || response.status === 202) {
            identifyToKlaviyo(email, firstName);
            setStatus('You are IN. Free e-mag heading to your inbox.', 'success');
            form.reset();
          } else {
            return response.text().then(function (text) {
              throw new Error(text || 'Signup failed');
            });
          }
        })
        .catch(function () {
          setStatus('Hit a snag. Try again in a sec.', 'error');
        })
        .finally(function () {
          submit.disabled = false;
        });
    });
  })();
</script>

