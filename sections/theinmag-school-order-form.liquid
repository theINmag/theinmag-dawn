  .theinmag-school-order-form__checkbox-row {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-size: 15px;
    line-height: 1.4;
    color: var(--color-inky-purple-navy, #2A1F3D);
    cursor: pointer;
  }

  .theinmag-school-order-form__checkbox-row input[type="checkbox"] {
    width: 18px;
    height: 18px;
    accent-color: var(--color-purple-dark, #5D3A7A);
    cursor: pointer;
  }

  .theinmag-school-order-form__ship-fields {
    display: flex;
    flex-direction: column;
    gap: clamp(12px, 1.6vw, 16px);
  }

  .theinmag-school-order-form__ship-fields[hidden] { display: none; }

  /* ----- Errors panel --------------------------------------------- */

  .theinmag-school-order-form__errors {
    background-color: #FBE0D6;
    color: #8B2D1A;
    border-radius: var(--radius-md, 12px);
    padding: clamp(12px, 1.6vw, 16px) clamp(14px, 1.8vw, 18px);
    border-left: 4px solid var(--color-coral-dark, #C9543E);
  }

  .theinmag-school-order-form__errors[hidden] { display: none; }

  .theinmag-school-order-form__errors-heading {
    margin: 0 0 6px;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: 15px;
  }

  .theinmag-school-order-form__errors-list {
    margin: 0;
    padding-left: 18px;
    font-size: 14px;
    line-height: 1.5;
  }

  /* ----- Honeypot ------------------------------------------------- */

  .theinmag-school-order-form__honeypot {
    position: absolute;
    left: -10000px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* ----- Submit --------------------------------------------------- */

  .theinmag-school-order-form__submit-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(10px, 1.4vw, 14px);
    margin-top: clamp(6px, 0.8vw, 10px);
    text-align: center;
  }

  .theinmag-school-order-form .theinmag-school-order-form__submit {
    min-width: 280px;
    position: relative;
  }

  .theinmag-school-order-form__submit[disabled] {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .theinmag-school-order-form__spinner {
    display: none;
    width: 14px;
    height: 14px;
    margin-left: 8px;
    border: 2px solid currentColor;
    border-top-color: transparent;
    border-radius: 50%;
    animation: theinmag-sof-spin 0.7s linear infinite;
    vertical-align: -2px;
  }

  .theinmag-school-order-form__submit.is-busy .theinmag-school-order-form__spinner {
    display: inline-block;
  }

  @keyframes theinmag-sof-spin {
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-school-order-form__spinner { animation: none; }
  }

  .theinmag-school-order-form__trust {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-inky-purple-navy, #2A1F3D);
    opacity: 0.8;
    max-width: 48ch;
    margin: 0;
  }

  .theinmag-school-order-form__trust strong { font-weight: 700; }
{%- endstylesheet -%}

