{%- comment -%}
  theinmag-school-order-form
  Sole section on /pages/school-order (template page.school-order.json).

  Flow:
    1. School fills this form (school details + contact + addresses).
    2. JS validates the email against a webmail blocklist, writes the
       form values as cart attributes via /cart/update.js, then redirects
       to Shopify checkout with the email + shipping address prefilled.
    3. At checkout the school picks "Bank transfer - school invoice"
       (manual payment method, set up in admin Settings -> Payments).
    4. Shop generates the order immediately, emails the pending-payment
       notification + Order Printer invoice PDF. 14 days to pay by bank
       transfer with the Shopify order number as the reference.

  Trust model: ship on order, 14 days to pay, no first-order review.
  Locked decisions live in the briefing doc at
  ../theinmag-docs/_briefing-for-claude-chat-2026-05-17-schools-invoice-flow.md

  Vendor block (entity name, ABN, address, bank details) reads from
  shop.metafields.theinmag.* with hard-coded fallbacks from the
  reference_theinmag_business_details memory. The metafields are
  admin-editable in Settings -> Custom data -> Shop.

  Email blocklist is a JSON array in section settings so it's editable
  without a deploy when a new public-webmail provider crops up.
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading
  assign subhead = section.settings.subhead

  assign callout_html = section.settings.callout_html

  assign vendor_heading = section.settings.vendor_heading
  assign vendor_intro = section.settings.vendor_intro

  assign submit_label = section.settings.submit_label
  assign trust_line = section.settings.trust_line

  assign blocklist_json = section.settings.email_blocklist | strip
  assign blocked_error = section.settings.blocked_email_error

  assign cart_empty_heading = section.settings.cart_empty_heading
  assign cart_empty_body = section.settings.cart_empty_body
  assign cart_empty_cta_label = section.settings.cart_empty_cta_label
  assign cart_empty_cta_url = section.settings.cart_empty_cta_url

  assign cart_heading = section.settings.cart_heading

  # Vendor details - metafield first, schema fallback second.
  # Schema fallbacks carry the canonical values from memory so the page
  # works the moment it's pushed, before the metafields are populated.
  assign entity_name = shop.metafields.theinmag.business_entity_name | default: section.settings.entity_name_fallback
  assign abn = shop.metafields.theinmag.business_abn | default: section.settings.abn_fallback
  assign address = shop.metafields.theinmag.business_address | default: section.settings.address_fallback
  assign bank_bsb = shop.metafields.theinmag.bank_bsb | default: section.settings.bank_bsb_fallback
  assign bank_account = shop.metafields.theinmag.bank_account | default: section.settings.bank_account_fallback
  assign bank_account_name = shop.metafields.theinmag.bank_account_name | default: section.settings.bank_account_name_fallback

  assign section_style = '--sof-pt: ' | append: section.settings.padding_top | append: 'px; --sof-pb: ' | append: section.settings.padding_bottom | append: 'px;'

  # Page-level JSON-LD URL stub
  assign page_origin = request.origin | default: 'https://theinmag.com.au'
  assign page_url = page_origin | append: '/pages/school-order'
-%}

<section
  class="theinmag-school-order-form"
  data-theinmag-school-order-form
  aria-labelledby="theinmag-school-order-form-heading"
  style="{{ section_style }}"
>
  <div class="theinmag-school-order-form__inner">

    {%- comment -%} ========= Header ========= {%- endcomment -%}
    <header class="theinmag-school-order-form__header">
      {%- if heading != blank -%}
        <h1 id="theinmag-school-order-form-heading" class="theinmag-school-order-form__heading">{{ heading }}</h1>
      {%- endif -%}
      {%- if subhead != blank -%}
        <p class="theinmag-school-order-form__subhead">{{ subhead }}</p>
      {%- endif -%}
    </header>

    {%- comment -%} ========= Bold callout - order not quote, 14 days to pay ========= {%- endcomment -%}
    {%- if callout_html != blank -%}
      <aside class="theinmag-school-order-form__callout" role="note">
        {{ callout_html }}
      </aside>
    {%- endif -%}

    {%- comment -%} ========= Vendor block - what to put on the school's PO ========= {%- endcomment -%}
    <details class="theinmag-school-order-form__vendor" open>
      <summary class="theinmag-school-order-form__vendor-summary">
        <span class="theinmag-school-order-form__vendor-summary-label">{{ vendor_heading | default: "What you'll need for your school's PO" }}</span>
        <svg class="theinmag-school-order-form__vendor-caret" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M7 10l5 5 5-5z"></path>
        </svg>
      </summary>

      {%- if vendor_intro != blank -%}
        <p class="theinmag-school-order-form__vendor-intro">{{ vendor_intro }}</p>
      {%- endif -%}

      <div class="theinmag-school-order-form__vendor-grid">
        <dl class="theinmag-school-order-form__vendor-block">
          <dt>Vendor</dt>
          <dd>
            <span data-copyable>{{ entity_name }}</span>
            <button type="button" class="theinmag-school-order-form__copy-btn" data-copy="{{ entity_name | escape }}" aria-label="Copy vendor name">Copy</button>
          </dd>

          <dt>ABN</dt>
          <dd>
            <span data-copyable>{{ abn }}</span>
            <button type="button" class="theinmag-school-order-form__copy-btn" data-copy="{{ abn | escape }}" aria-label="Copy ABN">Copy</button>
          </dd>

          <dt>Address</dt>
          <dd>
            <span data-copyable>{{ address | newline_to_br }}</span>
            <button type="button" class="theinmag-school-order-form__copy-btn" data-copy="{{ address | escape }}" aria-label="Copy address">Copy</button>
          </dd>
        </dl>

        <dl class="theinmag-school-order-form__vendor-block">
          <dt>Bank (NAB)</dt>
          <dd>
            <span data-copyable>BSB {{ bank_bsb }} &middot; Account {{ bank_account }}</span>
            <button type="button" class="theinmag-school-order-form__copy-btn" data-copy="BSB {{ bank_bsb | escape }} Account {{ bank_account | escape }}" aria-label="Copy bank details">Copy</button>
          </dd>

          <dt>Account name</dt>
          <dd>
            <span data-copyable>{{ bank_account_name }}</span>
            <button type="button" class="theinmag-school-order-form__copy-btn" data-copy="{{ bank_account_name | escape }}" aria-label="Copy account name">Copy</button>
          </dd>

          <dt>Payment terms</dt>
          <dd>14 days from order date</dd>

          <dt>Reference</dt>
          <dd>Your Shopify order number (sent after you place the order)</dd>
        </dl>
      </div>
    </details>

    {%- comment -%} ========= Cart preview ========= {%- endcomment -%}
    <div class="theinmag-school-order-form__cart" aria-labelledby="theinmag-school-order-form-cart-heading">
      <h2 id="theinmag-school-order-form-cart-heading" class="theinmag-school-order-form__cart-heading">{{ cart_heading | default: "What you're ordering" }}</h2>

      {%- if cart.item_count == 0 -%}
        <div class="theinmag-school-order-form__cart-empty">
          <p class="theinmag-school-order-form__cart-empty-heading">{{ cart_empty_heading | default: 'Your cart is empty.' }}</p>
          {%- if cart_empty_body != blank -%}
            <p class="theinmag-school-order-form__cart-empty-body">{{ cart_empty_body }}</p>
          {%- endif -%}
          {%- if cart_empty_cta_label != blank and cart_empty_cta_url != blank -%}
            <a class="theinmag-btn theinmag-btn--primary" href="{{ cart_empty_cta_url }}">{{ cart_empty_cta_label }}</a>
          {%- endif -%}
        </div>
      {%- else -%}
        <ul class="theinmag-school-order-form__cart-list" role="list">
          {%- for item in cart.items -%}
            <li class="theinmag-school-order-form__cart-row">
              <span class="theinmag-school-order-form__cart-qty">{{ item.quantity }}&times;</span>
              <span class="theinmag-school-order-form__cart-title">
                {{- item.product.title | replace: 'theINmag - ', '' -}}
                {%- if item.variant.title != 'Default Title' -%}
                  <span class="theinmag-school-order-form__cart-variant">{{ item.variant.title }}</span>
                {%- endif -%}
              </span>
              <span class="theinmag-school-order-form__cart-price">{{ item.final_line_price | money }}</span>
            </li>
          {%- endfor -%}
        </ul>
        <div class="theinmag-school-order-form__cart-totals">
          <div class="theinmag-school-order-form__cart-total-row">
            <span>Subtotal</span>
            <span>{{ cart.items_subtotal_price | money }}</span>
          </div>
          {%- if cart.requires_shipping -%}
            <div class="theinmag-school-order-form__cart-total-row theinmag-school-order-form__cart-total-row--muted">
              <span>Shipping</span>
              <span>Calculated at checkout</span>
            </div>
          {%- endif -%}
          <div class="theinmag-school-order-form__cart-total-row theinmag-school-order-form__cart-total-row--grand">
            <span>Estimated total</span>
            <span>{{ cart.total_price | money_with_currency }}</span>
          </div>
          <p class="theinmag-school-order-form__cart-tax-note">GST included where applicable. Final invoice issued on order.</p>
        </div>
        <a class="theinmag-school-order-form__cart-edit" href="{{ routes.cart_url }}">&larr; Edit cart</a>
      {%- endif -%}
    </div>

    {%- comment -%} ========= Form ========= {%- endcomment -%}
    <form
      class="theinmag-school-order-form__form"
      id="theinmag-school-order-form-element"
      data-cart-empty="{% if cart.item_count == 0 %}true{% else %}false{% endif %}"
      novalidate
    >
      <div class="theinmag-school-order-form__errors" role="alert" data-theinmag-school-errors hidden></div>

      {%- comment -%} ----- School ----- {%- endcomment -%}
      <fieldset class="theinmag-school-order-form__fieldset">
        <legend class="theinmag-school-order-form__legend">School</legend>

        <div class="theinmag-school-order-form__field">
          <label class="theinmag-school-order-form__label" for="theinmag-sof-school-name">School name <span class="theinmag-school-order-form__required" aria-hidden="true">*</span></label>
          <input class="theinmag-school-order-form__input" type="text" id="theinmag-sof-school-name" name="school_name" autocomplete="organization" required>
        </div>
      </fieldset>

      {%- comment -%} ----- Contact ----- {%- endcomment -%}
      <fieldset class="theinmag-school-order-form__fieldset">
        <legend class="theinmag-school-order-form__legend">Your details</legend>

        <div class="theinmag-school-order-form__grid theinmag-school-order-form__grid--2">
          <div class="theinmag-school-order-form__field">
            <label class="theinmag-school-order-form__label" for="theinmag-sof-first-name">First name <span class="theinmag-school-order-form__required" aria-hidden="true">*</span></label>
            <input class="theinmag-school-order-form__input" type="text" id="theinmag-sof-first-name" name="first_name" autocomplete="given-name" required>
          </div>

          <div class="theinmag-school-order-form__field">
            <label class="theinmag-school-order-form__label" for="theinmag-sof-last-name">Last name <span class="theinmag-school-order-form__required" aria-hidden="true">*</span></label>
            <input class="theinmag-school-order-form__input" type="text" id="theinmag-sof-last-name" name="last_name" autocomplete="family-name" required>
          </div>
        </div>

        <div class="theinmag-school-order-form__field">
          <label class="theinmag-school-order-form__label" for="theinmag-sof-email">Your school email <span class="theinmag-school-order-form__required" aria-hidden="true">*</span></label>
          <input class="theinmag-school-order-form__input" type="email" id="theinmag-sof-email" name="school_email" autocomplete="email" spellcheck="false" autocapitalize="off" required>
          <span class="theinmag-school-order-form__hint">Your school-domain email (not gmail / outlook). Needed for the invoice to be valid for your accounts department.</span>
        </div>

        <div class="theinmag-school-order-form__field">
          <label class="theinmag-school-order-form__label" for="theinmag-sof-phone">Phone <span class="theinmag-school-order-form__optional">(optional)</span></label>
          <input class="theinmag-school-order-form__input" type="tel" id="theinmag-sof-phone" name="school_phone" autocomplete="tel">
        </div>
      </fieldset>

      {%- comment -%} ----- Billing address (school) ----- {%- endcomment -%}
      <fieldset class="theinmag-school-order-form__fieldset">
        <legend class="theinmag-school-order-form__legend">School billing address</legend>

        <div class="theinmag-school-order-form__field">
          <label class="theinmag-school-order-form__label" for="theinmag-sof-bill-address1">Street address <span class="theinmag-school-order-form__required" aria-hidden="true">*</span></label>
          <input class="theinmag-school-order-form__input" type="text" id="theinmag-sof-bill-address1" name="bill_address1" autocomplete="address-line1" required>
        </div>

        <div class="theinmag-school-order-form__field">
          <label class="theinmag-school-order-form__label" for="theinmag-sof-bill-address2">Apt, suite, building <span class="theinmag-school-order-form__optional">(optional)</span></label>
          <input class="theinmag-school-order-form__input" type="text" id="theinmag-sof-bill-address2" name="bill_address2" autocomplete="address-line2">
        </div>

        <div class="theinmag-school-order-form__grid theinmag-school-order-form__grid--3">
          <div class="theinmag-school-order-form__field">
            <label class="theinmag-school-order-form__label" for="theinmag-sof-bill-city">City <span class="theinmag-school-order-form__required" aria-hidden="true">*</span></label>
            <input class="theinmag-school-order-form__input" type="text" id="theinmag-sof-bill-city" name="bill_city" autocomplete="address-level2" required>
          </div>

          <div class="theinmag-school-order-form__field">
            <label class="theinmag-school-order-form__label" for="theinmag-sof-bill-state">State <span class="theinmag-school-order-form__required" aria-hidden="true">*</span></label>
            <select class="theinmag-school-order-form__input theinmag-school-order-form__select" id="theinmag-sof-bill-state" name="bill_state" autocomplete="address-level1" required>
              <option value="" disabled selected>Pick one</option>
              <option value="ACT">ACT</option>
              <option value="NSW">NSW</option>
              <option value="NT">NT</option>
              <option value="QLD">QLD</option>
              <option value="SA">SA</option>
              <option value="TAS">TAS</option>
              <option value="VIC">VIC</option>
              <option value="WA">WA</option>
            </select>
          </div>

          <div class="theinmag-school-order-form__field">
            <label class="theinmag-school-order-form__label" for="theinmag-sof-bill-postcode">Postcode <span class="theinmag-school-order-form__required" aria-hidden="true">*</span></label>
            <input class="theinmag-school-order-form__input" type="text" id="theinmag-sof-bill-postcode" name="bill_postcode" autocomplete="postal-code" inputmode="numeric" pattern="[0-9]{4}" required>
          </div>
        </div>
      </fieldset>

      {%- comment -%} ----- Delivery address ----- {%- endcomment -%}
      <fieldset class="theinmag-school-order-form__fieldset">
        <legend class="theinmag-school-order-form__legend">Delivery address</legend>

        <div class="theinmag-school-order-form__same-row">
          <label class="theinmag-school-order-form__checkbox-row" for="theinmag-sof-same-address">
            <input type="checkbox" id="theinmag-sof-same-address" name="same_address" data-theinmag-same-address checked>
            <span>Same as the billing address above</span>
          </label>
        </div>

        <div class="theinmag-school-order-form__ship-fields" data-theinmag-ship-fields hidden>
          <div class="theinmag-school-order-form__field">
            <label class="theinmag-school-order-form__label" for="theinmag-sof-ship-address1">Street address <span class="theinmag-school-order-form__required" aria-hidden="true">*</span></label>
            <input class="theinmag-school-order-form__input" type="text" id="theinmag-sof-ship-address1" name="ship_address1" autocomplete="shipping address-line1">
          </div>

          <div class="theinmag-school-order-form__field">
            <label class="theinmag-school-order-form__label" for="theinmag-sof-ship-address2">Apt, suite, building <span class="theinmag-school-order-form__optional">(optional)</span></label>
            <input class="theinmag-school-order-form__input" type="text" id="theinmag-sof-ship-address2" name="ship_address2" autocomplete="shipping address-line2">
          </div>

          <div class="theinmag-school-order-form__grid theinmag-school-order-form__grid--3">
            <div class="theinmag-school-order-form__field">
              <label class="theinmag-school-order-form__label" for="theinmag-sof-ship-city">City <span class="theinmag-school-order-form__required" aria-hidden="true">*</span></label>
              <input class="theinmag-school-order-form__input" type="text" id="theinmag-sof-ship-city" name="ship_city" autocomplete="shipping address-level2">
            </div>

            <div class="theinmag-school-order-form__field">
              <label class="theinmag-school-order-form__label" for="theinmag-sof-ship-state">State <span class="theinmag-school-order-form__required" aria-hidden="true">*</span></label>
              <select class="theinmag-school-order-form__input theinmag-school-order-form__select" id="theinmag-sof-ship-state" name="ship_state" autocomplete="shipping address-level1">
                <option value="" disabled selected>Pick one</option>
                <option value="ACT">ACT</option>
                <option value="NSW">NSW</option>
                <option value="NT">NT</option>
                <option value="QLD">QLD</option>
                <option value="SA">SA</option>
                <option value="TAS">TAS</option>
                <option value="VIC">VIC</option>
                <option value="WA">WA</option>
              </select>
            </div>

            <div class="theinmag-school-order-form__field">
              <label class="theinmag-school-order-form__label" for="theinmag-sof-ship-postcode">Postcode <span class="theinmag-school-order-form__required" aria-hidden="true">*</span></label>
              <input class="theinmag-school-order-form__input" type="text" id="theinmag-sof-ship-postcode" name="ship_postcode" autocomplete="shipping postal-code" inputmode="numeric" pattern="[0-9]{4}">
            </div>
          </div>
        </div>
      </fieldset>

      {%- comment -%} ----- Optional extras ----- {%- endcomment -%}
      <fieldset class="theinmag-school-order-form__fieldset">
        <legend class="theinmag-school-order-form__legend">Anything else?</legend>

        <div class="theinmag-school-order-form__field">
          <label class="theinmag-school-order-form__label" for="theinmag-sof-po">PO number <span class="theinmag-school-order-form__optional">(optional)</span></label>
          <input class="theinmag-school-order-form__input" type="text" id="theinmag-sof-po" name="school_po" autocomplete="off">
          <span class="theinmag-school-order-form__hint">If your school issues PO numbers, drop yours here and we'll put it on the invoice.</span>
        </div>

        <div class="theinmag-school-order-form__field">
          <label class="theinmag-school-order-form__label" for="theinmag-sof-notes">Notes <span class="theinmag-school-order-form__optional">(optional)</span></label>
          <textarea class="theinmag-school-order-form__input theinmag-school-order-form__textarea" id="theinmag-sof-notes" name="school_notes" rows="3" maxlength="200"></textarea>
          <span class="theinmag-school-order-form__hint">Up to 200 characters. Anything we should know before we ship.</span>
        </div>
      </fieldset>

      {%- comment -%} ----- Honeypot ----- {%- endcomment -%}
      <div class="theinmag-school-order-form__honeypot" aria-hidden="true">
        <label for="theinmag-sof-website">Leave this field empty</label>
        <input type="text" id="theinmag-sof-website" name="website" tabindex="-1" autocomplete="off">
      </div>

      {%- comment -%} ----- Submit ----- {%- endcomment -%}
      <div class="theinmag-school-order-form__submit-row">
        <button
          type="submit"
          class="theinmag-btn theinmag-btn--primary theinmag-school-order-form__submit"
          data-theinmag-school-submit
          {% if cart.item_count == 0 %}disabled aria-disabled="true"{% endif %}
        >
          <span data-theinmag-submit-label>{{ submit_label | default: 'Place order + email me the invoice' }}</span>
          <span class="theinmag-school-order-form__spinner" data-theinmag-submit-spinner aria-hidden="true"></span>
        </button>

        {%- if trust_line != blank -%}
          <p class="theinmag-school-order-form__trust">{{ trust_line }}</p>
        {%- endif -%}
      </div>
    </form>

  </div>
</section>

{%- comment -%} ========= JSON-LD - BreadcrumbList + WebPage ========= {%- endcomment -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ page_origin | json }} },
      { "@type": "ListItem", "position": 2, "name": "School orders", "item": {{ page_url | json }} }
    ]
  }
</script>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": {{ heading | default: 'School invoice order' | json }},
    "description": {{ subhead | default: 'Order theINmag for your school. Pay by bank transfer within 14 days. ABN-compliant invoice issued on order.' | json }},
    "url": {{ page_url | json }},
    "mainEntityOfPage": {{ page_url | json }},
    "isPartOf": { "@type": "WebSite", "name": "theINmag", "url": {{ page_origin | json }} }
  }
</script>

{%- comment -%} ========= Inline script: copy buttons, same-address toggle, submit + blocklist + checkout redirect ========= {%- endcomment -%}
<script>
  (function () {
    var form = document.getElementById('theinmag-school-order-form-element');
    if (!form) return;

    var blocklist = [];
    try {
      blocklist = JSON.parse({{ blocklist_json | default: '"[]"' | json }});
    } catch (e) {
      blocklist = [];
    }
    var blockedError = {{ blocked_error | default: "Please use your school email address - it's needed for the invoice to be valid for your accounts department. If your school uses a personal-domain email for some reason, please contact heyhey@theinmag.com.au." | json }};

    var errBox = form.querySelector('[data-theinmag-school-errors]');
    var submitBtn = form.querySelector('[data-theinmag-school-submit]');
    var submitLabel = form.querySelector('[data-theinmag-submit-label]');

    /* --- Copy buttons in the vendor block --- */
    var copyButtons = document.querySelectorAll('.theinmag-school-order-form__copy-btn');
    copyButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var text = btn.getAttribute('data-copy') || '';
        var original = btn.textContent;
        var done = function () {
          btn.textContent = 'Copied';
          btn.classList.add('is-copied');
          setTimeout(function () {
            btn.textContent = original;
            btn.classList.remove('is-copied');
          }, 1400);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(done).catch(done);
        } else {
          /* Fallback for older browsers */
          var ta = document.createElement('textarea');
          ta.value = text;
          ta.setAttribute('readonly', '');
          ta.style.position = 'absolute';
          ta.style.left = '-9999px';
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); } catch (e) {}
          document.body.removeChild(ta);
          done();
        }
      });
    });

    /* --- Same-as-billing toggle --- */
    var sameBox = form.querySelector('[data-theinmag-same-address]');
    var shipWrap = form.querySelector('[data-theinmag-ship-fields]');
    var shipInputs = shipWrap ? shipWrap.querySelectorAll('input, select') : [];

    function syncShipFields() {
      if (!sameBox || !shipWrap) return;
      if (sameBox.checked) {
        shipWrap.setAttribute('hidden', '');
        shipInputs.forEach(function (el) { el.removeAttribute('required'); });
      } else {
        shipWrap.removeAttribute('hidden');
        shipInputs.forEach(function (el) {
          /* Only mark address1, city, state, postcode as required; address2 stays optional */
          if (/(address1|city|state|postcode)$/.test(el.name)) el.setAttribute('required', '');
        });
      }
    }
    if (sameBox) {
      sameBox.addEventListener('change', syncShipFields);
      syncShipFields();
    }

    /* --- Error rendering --- */
    function showErrors(messages) {
      if (!errBox) return;
      errBox.innerHTML = '';
      if (!messages || !messages.length) {
        errBox.setAttribute('hidden', '');
        return;
      }
      var heading = document.createElement('p');
      heading.className = 'theinmag-school-order-form__errors-heading';
      heading.textContent = "We couldn't submit your order just yet:";
      errBox.appendChild(heading);
      var ul = document.createElement('ul');
      ul.className = 'theinmag-school-order-form__errors-list';
      messages.forEach(function (m) {
        var li = document.createElement('li');
        li.textContent = m;
        ul.appendChild(li);
      });
      errBox.appendChild(ul);
      errBox.removeAttribute('hidden');
      errBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    /* --- Validation --- */
    function validate(data) {
      var errors = [];

      if (form.getAttribute('data-cart-empty') === 'true') {
        errors.push('Your cart is empty. Add some mags first before placing a school order.');
        return errors;
      }

      if (!data.school_name) errors.push('Please add your school name.');
      if (!data.first_name) errors.push('Please add your first name.');
      if (!data.last_name) errors.push('Please add your last name.');
      if (!data.school_email) errors.push('Please add your school email.');
      else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.school_email)) errors.push('That email address looks off - check the spelling.');
      else {
        var domain = data.school_email.split('@')[1].toLowerCase();
        if (blocklist.indexOf(domain) !== -1) errors.push(blockedError);
      }

      if (!data.bill_address1) errors.push('Please add the school street address.');
      if (!data.bill_city) errors.push('Please add the school city.');
      if (!data.bill_state) errors.push('Please pick the school state.');
      if (!data.bill_postcode) errors.push('Please add the school postcode.');

      if (!data.same_address) {
        if (!data.ship_address1) errors.push('Please add the delivery street address.');
        if (!data.ship_city) errors.push('Please add the delivery city.');
        if (!data.ship_state) errors.push('Please pick the delivery state.');
        if (!data.ship_postcode) errors.push('Please add the delivery postcode.');
      }

      return errors;
    }

    /* --- Read form values --- */
    function readForm() {
      var data = {};
      var fd = new FormData(form);
      fd.forEach(function (v, k) { data[k] = String(v).trim(); });
      data.same_address = form.querySelector('[data-theinmag-same-address]').checked;
      return data;
    }

    function setBusy(busy) {
      if (!submitBtn) return;
      if (busy) {
        submitBtn.setAttribute('disabled', '');
        submitBtn.setAttribute('aria-busy', 'true');
        if (submitLabel) submitLabel.textContent = 'Submitting...';
        submitBtn.classList.add('is-busy');
      } else {
        submitBtn.removeAttribute('disabled');
        submitBtn.removeAttribute('aria-busy');
        if (submitLabel) submitLabel.textContent = {{ submit_label | default: 'Place order + email me the invoice' | json }};
        submitBtn.classList.remove('is-busy');
      }
    }

    /* --- Build cart attributes payload --- */
    function buildAttributes(data) {
      var ship = data.same_address ? {
        address1: data.bill_address1,
        address2: data.bill_address2 || '',
        city: data.bill_city,
        state: data.bill_state,
        postcode: data.bill_postcode
      } : {
        address1: data.ship_address1,
        address2: data.ship_address2 || '',
        city: data.ship_city,
        state: data.ship_state,
        postcode: data.ship_postcode
      };

      var billLines = [data.bill_address1];
      if (data.bill_address2) billLines.push(data.bill_address2);
      billLines.push(data.bill_city + ' ' + data.bill_state + ' ' + data.bill_postcode);

      return {
        'School name': data.school_name,
        'School contact': data.first_name + ' ' + data.last_name,
        'School email': data.school_email,
        'School phone': data.school_phone || '',
        'School PO number': data.school_po || '',
        'School billing address': billLines.join('\n'),
        'School delivery same as billing': data.same_address ? 'yes' : 'no',
        'School notes': data.school_notes || '',
        '_school_order': 'true',
        '_ship': JSON.stringify(ship)
      };
    }

    /* --- Build the checkout redirect URL --- */
    function buildCheckoutUrl(data) {
      var ship = data.same_address ? {
        a1: data.bill_address1, a2: data.bill_address2 || '',
        city: data.bill_city, state: data.bill_state, zip: data.bill_postcode
      } : {
        a1: data.ship_address1, a2: data.ship_address2 || '',
        city: data.ship_city, state: data.ship_state, zip: data.ship_postcode
      };

      var params = [];
      function add(key, val) {
        if (val == null || val === '') return;
        params.push(encodeURIComponent(key) + '=' + encodeURIComponent(val));
      }

      add('checkout[email]', data.school_email);
      add('checkout[shipping_address][first_name]', data.first_name);
      add('checkout[shipping_address][last_name]', data.last_name);
      add('checkout[shipping_address][company]', data.school_name);
      add('checkout[shipping_address][address1]', ship.a1);
      add('checkout[shipping_address][address2]', ship.a2);
      add('checkout[shipping_address][city]', ship.city);
      add('checkout[shipping_address][province]', ship.state);
      add('checkout[shipping_address][zip]', ship.zip);
      add('checkout[shipping_address][country]', 'Australia');
      add('checkout[shipping_address][phone]', data.school_phone);

      return '/checkout?' + params.join('&');
    }

    /* --- Submit --- */
    form.addEventListener('submit', function (evt) {
      evt.preventDefault();

      /* Honeypot */
      var hp = form.querySelector('input[name="website"]');
      if (hp && hp.value) return;

      var data = readForm();
      var errors = validate(data);
      if (errors.length) {
        showErrors(errors);
        return;
      }
      showErrors([]);
      setBusy(true);

      var attributes = buildAttributes(data);
      var cartNote = data.school_notes ? 'School order: ' + data.school_notes : 'School invoice order';

      fetch('/cart/update.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ attributes: attributes, note: cartNote })
      }).then(function (r) {
        if (!r.ok) throw new Error('Cart update failed (' + r.status + ')');
        return r.json();
      }).then(function () {
        window.location.href = buildCheckoutUrl(data);
      }).catch(function (err) {
        setBusy(false);
        showErrors(['Something went wrong saving your details. Please try again, or email heyhey@theinmag.com.au and we will sort it out.']);
        if (window.console) console.error('[school-order-form]', err);
      });
    });
  })();
</script>

{%- stylesheet -%}
  /* ================================================================
     theinmag-school-order-form
     Cream pair surface. Single column layout, max-width capped so the
     form is comfortable to scan on Pixel 6 (412px) all the way up to
     desktop. Field family matches theinmag-contact-form.
     ================================================================ */

  .theinmag-school-order-form {
    background-color: var(--color-cream, #FBF6EA);
    color: var(--color-inky-purple-navy, #2A1F3D);
    padding: var(--sof-pt, 56px) clamp(16px, 4vw, 32px) var(--sof-pb, 56px);
    position: relative;
  }

  @media (min-width: 750px) {
    .theinmag-school-order-form {
      padding-top: calc(var(--sof-pt, 56px) * 1.2);
      padding-bottom: calc(var(--sof-pb, 56px) * 1.2);
    }
  }

  .theinmag-school-order-form__inner {
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 3vw, 36px);
  }

  /* ----- Header --------------------------------------------------- */

  .theinmag-school-order-form__header {
    text-align: center;
  }

  .theinmag-school-order-form__heading {
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-size: clamp(32px, 5.4vw, 48px);
    line-height: 1.05;
    margin: 0 0 clamp(8px, 1.2vw, 12px);
    color: var(--color-inky-purple-navy, #2A1F3D);
    text-wrap: balance;
  }

  .theinmag-school-order-form__subhead {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-size: clamp(16px, 1.5vw, 18px);
    line-height: 1.45;
    color: var(--color-inky-purple-navy, #2A1F3D);
    opacity: 0.85;
    margin: 0;
    text-wrap: balance;
  }

  /* ----- Bold callout --------------------------------------------- */

  .theinmag-school-order-form__callout {
    background-color: var(--color-soft-pink, #F7A092);
    color: var(--color-inky-purple-navy, #2A1F3D);
