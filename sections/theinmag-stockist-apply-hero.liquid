{%- comment -%}
  theinmag-stockist-apply-hero
  Section 1 of /pages/become-a-stockist. Mirrors the visual register of
  theinmag-contact-hero (lavender purple-pair band, capped ~30vh) so the
  apply page sits in the same family as the contact page. The form
  section below is the real centre of gravity.

  Page-level JSON-LD (BreadcrumbList + WebPage) lives at the bottom of
  this file because the hero is always the first section on the page.
  Same anchor pattern as theinmag-contact-hero / theinmag-send-in-hero.

  Background image setting expects a filename inside /assets/. Default
  is theinmag-stockist-shelf.jpg — Ryan to drop the actual photo (the
  mag on a shelf in a stockist's shop) when ready. Lavender fallback
  renders cleanly until then.
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading
  assign subhead = section.settings.subhead
  assign align = section.settings.text_align | default: 'center'
  assign jumps = section.blocks | where: 'type', 'jump_link'
  assign bg_filename = section.settings.bg_filename
  assign bg_url = ''
  if bg_filename != blank
    assign bg_filename = bg_filename | strip
    assign bg_url = bg_filename | asset_url
  endif

  assign heading_html = heading
  capture emphasis_wrap
    echo '<span class="theinmag-stockist-apply-hero__heading-emphasis">IN</span>'
  endcapture
  assign heading_html = heading_html | replace_first: 'IN', emphasis_wrap

  assign section_style = '--sah-pt: ' | append: section.settings.padding_top | append: 'px; --sah-pb: ' | append: section.settings.padding_bottom | append: 'px;'
  if bg_url != blank
    assign section_style = section_style | append: ' --sah-bg: url(' | append: bg_url | append: ');'
  endif

  # Scrim strength (0-90) + desktop min-height, both schema-driven so a
  # page can run a taller / darker hero without affecting the others.
  # Scrim keeps the current 1 / 0.53 / 0.08 top-mid-bottom falloff.
  assign ov = section.settings.overlay_opacity | default: 60
  assign ov_top = ov | divided_by: 100.00
  assign ov_mid = ov | times: 0.53 | divided_by: 100.00
  assign ov_bot = ov | times: 0.08 | divided_by: 100.00
  assign mh = section.settings.min_height | default: 460
  assign section_style = section_style | append: ' --sah-ov-top: ' | append: ov_top | append: '; --sah-ov-mid: ' | append: ov_mid | append: '; --sah-ov-bot: ' | append: ov_bot | append: '; --sah-mh: ' | append: mh | append: 'px;'
-%}

<section
  class="theinmag-stockist-apply-hero theinmag-stockist-apply-hero--align-{{ align }}{% if bg_url != blank %} theinmag-stockist-apply-hero--has-bg{% endif %}"
  data-theinmag-stockist-apply-hero
  aria-labelledby="theinmag-stockist-apply-hero-heading"
  style="{{ section_style }}"
>
  <div class="theinmag-stockist-apply-hero__inner">
    {%- if heading != blank -%}
      <h1 id="theinmag-stockist-apply-hero-heading" class="theinmag-stockist-apply-hero__heading">{{ heading_html }}</h1>
    {%- endif -%}

    {%- if subhead != blank -%}
      <p class="theinmag-stockist-apply-hero__subhead">{{ subhead }}</p>
    {%- endif -%}

    {%- if jumps.size > 0 -%}
      <ul class="theinmag-stockist-apply-hero__jumps" role="list">
        {%- for block in jumps -%}
          {%- assign t = block.settings.target_id | strip -%}
          {%- if t != blank -%}
            <li class="theinmag-stockist-apply-hero__jump-item" {{ block.shopify_attributes }}>
              <a class="theinmag-stockist-apply-hero__jump" href="#{{ t }}">{{ block.settings.label }}</a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{%- comment -%} Page-level JSON-LD - BreadcrumbList + WebPage {%- endcomment -%}
{%- assign page_origin = request.origin | default: 'https://theinmag.com.au' -%}
{%- assign page_path = page.url | default: '/pages/become-a-stockist' -%}
{%- assign page_url = page_origin | append: page_path -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": {{ page_origin | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Become a stockist",
        "item": {{ page_url | json }}
      }
    ]
  }
</script>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": {{ heading | default: 'Become a stockist' | json }},
    "description": {{ subhead | default: "Apply to stock theINmag - Australia's magazine made by kids, for kids. We work with shops that already champion creativity in their patch." | json }},
    "url": {{ page_url | json }},
    "mainEntityOfPage": {{ page_url | json }},
    "isPartOf": {
      "@type": "WebSite",
      "name": "theINmag",
      "url": {{ page_origin | json }}
    }
  }
</script>

{%- stylesheet -%}
  /* ================================================================
     theinmag-stockist-apply-hero
     Lavender band - purple pair (light bg + dark companion). Visual
     twin of theinmag-contact-hero so the apply page reads as part of
     the same family. Kept short (~30vh desktop) so the form section
     below is the real centre of gravity.
     ================================================================ */

  .theinmag-stockist-apply-hero {
    background-color: var(--color-lavender, #E8DEEF);
    color: var(--color-purple-dark, #5D3A7A);
    padding: var(--sah-pt, 48px) clamp(16px, 4vw, 32px) var(--sah-pb, 40px);
    position: relative;
    min-height: clamp(240px, 34vh, 300px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .theinmag-stockist-apply-hero--has-bg {
    background-image: var(--sah-bg);
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
    isolation: isolate; /* contains the ::before stacking context */
  }

  /* White-on-scrim treatment when a hero photo is present (per the
     premium-photo-text rule — no coloured pills on photography). Top-
     anchored dark gradient gives the heading legibility against any
     image, fades to transparent so the lower portion stays photo. */
  .theinmag-stockist-apply-hero--has-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(20, 14, 30, var(--sah-ov-top, 0.6)) 0%,
      rgba(20, 14, 30, var(--sah-ov-mid, 0.32)) 45%,
      rgba(20, 14, 30, var(--sah-ov-bot, 0.05)) 100%
    );
    pointer-events: none;
    z-index: 1;
  }

  @media (min-width: 750px) {
    .theinmag-stockist-apply-hero {
      min-height: clamp(320px, var(--sah-mh, 460px), 92vh);
      padding-top: calc(var(--sah-pt, 48px) * 1.6);
      padding-bottom: calc(var(--sah-pb, 40px) * 1.4);
    }
  }

  .theinmag-stockist-apply-hero__inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(10px, 1.4vw, 16px);
    position: relative;
    z-index: 2; /* sits above the scrim ::before */
  }

  .theinmag-stockist-apply-hero__heading {
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-size: clamp(34px, 6.5vw, 56px);
    line-height: 1.05;
    letter-spacing: 0;
    margin: 0;
    color: var(--color-purple-dark, #5D3A7A);
    text-wrap: balance;
  }

  .theinmag-stockist-apply-hero__heading-emphasis {
    display: inline-block;
    font-size: 1.4em;
    line-height: 1;
    vertical-align: -0.06em;
  }

  .theinmag-stockist-apply-hero__subhead {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: clamp(15px, 1.5vw, 17px);
    line-height: 1.5;
    color: var(--color-inky-purple-navy, #2A1F3D);
    opacity: 0.9;
    max-width: none;
    margin: 0;
  }

  /* Left-aligned variant: content flush-left within the band, vertically
     centred. Used on the stockist hub. */
  .theinmag-stockist-apply-hero--align-left .theinmag-stockist-apply-hero__inner {
    align-items: flex-start;
    text-align: left;
    margin: 0;
    max-width: 820px;
  }
  @media (min-width: 750px) {
    .theinmag-stockist-apply-hero--align-left {
      justify-content: flex-start;
    }
    .theinmag-stockist-apply-hero--align-left .theinmag-stockist-apply-hero__inner {
      padding-left: clamp(8px, 4vw, 56px);
    }
  }

  /* Jump buttons living inside the hero, under the subhead. Semi-dark
     fill so they stay legible over any part of the photo; cream outline
     + cream text, fill cream on hover. */
  .theinmag-stockist-apply-hero__jumps {
    list-style: none;
    margin: clamp(6px, 1vw, 12px) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }
  .theinmag-stockist-apply-hero--align-left .theinmag-stockist-apply-hero__jumps {
    justify-content: flex-start;
  }
  .theinmag-stockist-apply-hero__jump {
    display: inline-flex;
    align-items: center;
    min-height: 50px;
    padding: 12px 26px;
    border-radius: var(--radius-pill, 9999px);
    border: 1.5px solid var(--color-cream);
    background-color: rgba(20, 14, 30, 0.34);
    color: var(--color-cream);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 15px;
    line-height: 1;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .theinmag-stockist-apply-hero__jump:hover,
  .theinmag-stockist-apply-hero__jump:focus-visible {
    background-color: var(--color-cream);
    color: var(--color-inky-purple-navy);
    outline: none;
  }
  @media (min-width: 750px) {
    .theinmag-stockist-apply-hero__jump {
      min-height: 54px;
      padding: 14px 30px;
      font-size: 16px;
    }
  }

  /* Anchor-jump offset so targets clear the sticky site header. Harmless
     on other pages (these IDs only exist where the targets render). */
  #theinmag-stockists-h1,
  #theinmag-stockist-apply-form-heading,
  #shop-grid {
    scroll-margin-top: 100px;
  }

  /* Photography variant: white type with a soft text-shadow scrim,
     matched to the article-template overlay (rgba 20,14,30,0.35). */
  .theinmag-stockist-apply-hero--has-bg .theinmag-stockist-apply-hero__heading {
    color: #FFFFFF;
    text-shadow: 0 1px 12px rgba(20, 14, 30, 0.45),
                 0 1px 3px rgba(20, 14, 30, 0.35);
  }
  .theinmag-stockist-apply-hero--has-bg .theinmag-stockist-apply-hero__subhead {
    color: #FFFFFF;
    opacity: 1;
    text-shadow: 0 1px 8px rgba(20, 14, 30, 0.45),
                 0 1px 3px rgba(20, 14, 30, 0.35);
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "Stockist apply hero",
  "tag": "section",
  "class": "theinmag-stockist-apply-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Become a stockist"
    },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Subhead",
      "default": "We're looking for shops that grow creative communities. Could yours be next?",
      "info": "Sits on one line at desktop. Wraps to two balanced lines on mobile."
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "center", "label": "Centred" },
        { "value": "left", "label": "Left" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "text",
      "id": "bg_filename",
      "label": "Background image filename",
      "default": "theinmag-stockist-shelf.jpg",
      "info": "File inside theme assets/ - the mag on a shelf in a real stockist. Lavender shows as fallback if blank or missing."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Photo darkening (scrim %)",
      "min": 0,
      "max": 90,
      "step": 2,
      "unit": "%",
      "default": 60,
      "info": "How dark the gradient over the photo is, so white text pops. Only applies when a background image is set."
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Hero height (desktop max)",
      "min": 240,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 460
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "jump_link",
      "name": "Jump button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Button label"
        },
        {
          "type": "text",
          "id": "target_id",
          "label": "Target section ID",
          "info": "The id of the element to scroll to, with no #. e.g. shop-grid"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stockist apply hero"
    }
  ]
}
{% endschema %}
