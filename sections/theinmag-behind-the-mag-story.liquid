{%- comment -%}
  theinmag-behind-the-mag-story
  Nine-card story carousel. Real-DOM cards (no JS-injected content) so
  every word is crawlable. Mobile: native horizontal swipe via CSS
  scroll-snap. Desktop: same scroll-snap rail, plus arrow buttons +
  dot indicator (Stage 2 will wire the JS - markup is already in place
  in this Stage 1 file so Stage 2 is purely additive).

  Card numbering ("01"..."09") doubles as a static progress signal
  before any JS runs. Headings are H3 per the brief; the section's
  visually-hidden H2 (question form) carries the AEO load.

  Cards live as blocks so Ryan can edit individual cards in the editor
  without touching code. Default preset ships all nine pre-populated
  with the locked copy.
{%- endcomment -%}

{%- liquid
  assign cards = section.blocks | where: 'type', 'card'
  assign aeo_heading = section.settings.aeo_heading | default: 'How did theINmag come to be?'
  assign eyebrow = section.settings.eyebrow | default: 'the <em>story</em> so far'

  assign bg_src = ''
  if section.settings.background_image != blank
    assign bg_src = section.settings.background_image | image_url: width: 2400
  elsif section.settings.background_filename != blank
    assign bg_src = section.settings.background_filename | asset_url
  endif

  assign section_style = ''
  if bg_src != blank
    assign section_style = "--bm-story-bg: url('" | append: bg_src | append: "');"
  endif
-%}

<section
  class="theinmag-bm-story{% if bg_src != blank %} theinmag-bm-story--has-bg{% endif %}"
  data-theinmag-bm-story
  aria-labelledby="theinmag-bm-story-heading"
  style="{{ section_style }}"
>
  <h2 id="theinmag-bm-story-heading" class="theinmag-bm-story__a11y-heading">{{ aeo_heading }}</h2>

  <div class="theinmag-bm-story__intro">
    {%- if eyebrow != blank -%}
      <p class="theinmag-bm-story__eyebrow">{{ eyebrow }}</p>
    {%- endif -%}

    <span class="theinmag-bm-story__character" data-theinmag-pool-character></span>
  </div>

  <div
    class="theinmag-bm-story__rail-wrap"
    role="region"
    aria-roledescription="carousel"
    aria-labelledby="theinmag-bm-story-heading"
  >
    {%- comment -%}
      Arrow buttons are present in the DOM from Stage 1 but disabled
      and visually hidden until Stage 2 wires the scroll JS. This keeps
      Stage 2 purely additive.
    {%- endcomment -%}
    <button
      type="button"
      class="theinmag-bm-story__arrow theinmag-bm-story__arrow--prev"
      data-bm-story-prev
      aria-label="Previous card"
      disabled
      hidden
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <ol
      class="theinmag-bm-story__list"
      data-bm-story-list
      tabindex="0"
    >
      {%- for block in cards -%}
        {%- liquid
          assign card_index = forloop.index
          assign card_num = card_index | prepend: '0' | slice: -2, 2
          assign card_id = 'theinmag-bm-story-card-' | append: card_index

          assign card_image_src = ''
          if block.settings.image != blank
            assign card_image_src = block.settings.image | image_url: width: 1600
          elsif block.settings.fallback_filename != blank
            assign card_image_src = block.settings.fallback_filename | asset_url
          endif
        -%}
        <li
          id="{{ card_id }}"
          class="theinmag-bm-story__card"
          data-bm-story-card
          data-index="{{ card_index }}"
          aria-roledescription="slide"
          aria-label="Card {{ card_index }} of {{ cards.size }}"
          {{ block.shopify_attributes }}
        >
          <article class="theinmag-bm-story__card-inner">
            <div class="theinmag-bm-story__card-media">
              {%- if card_image_src != blank -%}
                <img
                  class="theinmag-bm-story__card-image"
                  src="{{ card_image_src }}"
                  alt="{{ block.settings.image_alt | default: block.settings.heading | escape }}"
                  loading="lazy"
                  width="800"
                  height="500"
                >
              {%- else -%}
                <div class="theinmag-bm-story__card-image theinmag-bm-story__card-image--placeholder" aria-hidden="true"></div>
              {%- endif -%}
              <span class="theinmag-bm-story__card-num" aria-hidden="true">{{ card_num }}</span>
            </div>

            <div class="theinmag-bm-story__card-body">
              {%- if block.settings.heading != blank -%}
                <h3 class="theinmag-bm-story__card-heading">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.body != blank -%}
                <p class="theinmag-bm-story__card-text">{{ block.settings.body }}</p>
              {%- endif -%}
            </div>
          </article>
        </li>
      {%- endfor -%}
    </ol>

    <button
      type="button"
      class="theinmag-bm-story__arrow theinmag-bm-story__arrow--next"
      data-bm-story-next
      aria-label="Next card"
      disabled
      hidden
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>

  <div class="theinmag-bm-story__indicator">
    <ol class="theinmag-bm-story__dots" role="tablist" aria-label="Story cards">
      {%- for block in cards -%}
        <li class="theinmag-bm-story__dot-item">
          <button
            type="button"
            class="theinmag-bm-story__dot{% if forloop.first %} is-active{% endif %}"
            data-bm-story-dot
            data-index="{{ forloop.index }}"
            aria-label="Go to card {{ forloop.index }}"
            aria-controls="theinmag-bm-story-card-{{ forloop.index }}"
            {% if forloop.first %}aria-current="true"{% endif %}
          ></button>
        </li>
      {%- endfor -%}
    </ol>
    <p class="theinmag-bm-story__progress" data-bm-story-progress aria-live="polite">
      <span data-bm-story-current>1</span> / {{ cards.size }}
    </p>
  </div>
</section>

{%- stylesheet -%}
  /* ================================================================
     theinmag-bm-story
     Cream-on-cream section with white cards. The carousel is a single
     horizontal scroll rail using CSS scroll-snap - no JS needed for
     the core swipe behaviour. Stage 2 layers in arrow paging + dot
     indicator wiring on top.
     ================================================================ */

  .theinmag-bm-story {
    background-color: var(--color-cream, #FBF6EA);
    color: var(--color-inky-purple-navy, #2A1F3D);
    /* Tightened from 48-96 -> 24-56 after the eyebrow heading was
       dropped (the cards explain themselves; the section doesn't
       need a label moment + breathing room). Adjacent sections
       above and below now sit closer. */
    padding: clamp(24px, 4vw, 56px) 0;
    position: relative;
    overflow: hidden;
  }

  /* Optional background image - editor-supplied via Liquid custom
     property. Sits behind the cards as a section-wide texture. */
  .theinmag-bm-story--has-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--bm-story-bg);
    background-size: cover;
    background-position: center;
    pointer-events: none;
    z-index: 0;
    /* Soft fade so the cards still pop against the bg. Opacity drives
       intensity - bump for stronger texture. */
    opacity: 0.55;
  }
  .theinmag-bm-story--has-bg .theinmag-bm-story__intro,
  .theinmag-bm-story--has-bg .theinmag-bm-story__rail-wrap,
  .theinmag-bm-story--has-bg .theinmag-bm-story__indicator {
    position: relative;
    z-index: 1;
  }

  .theinmag-bm-story__a11y-heading {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .theinmag-bm-story__intro {
    position: relative;
    max-width: 1280px;
    /* Bottom margin only kicks in when the eyebrow is rendered;
       blank eyebrow + character pop leave this near-flush with the
       rail. */
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 64px);
  }

  .theinmag-bm-story__eyebrow {
    margin: 0;
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-size: clamp(28px, 4.5vw, 44px);
    line-height: 1.1;
    letter-spacing: 0;
    color: var(--color-inky-purple-navy, #2A1F3D);
  }

  /* Emphasised word inside the eyebrow (e.g. "story" in "the story
     so far"). Slightly larger - same family for visual consistency. */
  .theinmag-bm-story__eyebrow em {
    font-style: normal;
    font-size: 1.25em;
    color: var(--color-purple-dark, #5D3A7A);
  }

  /* Kid character peeking at the right edge of the eyebrow row. */
  .theinmag-bm-story__character {
    position: absolute;
    top: clamp(-20px, -2vw, -10px);
    right: clamp(20px, 5vw, 64px);
    width: clamp(70px, 9vw, 110px);
    z-index: 2;
  }

  @media (max-width: 749px) {
    .theinmag-bm-story__character {
      right: 16px;
      width: 64px;
    }
  }

  /* ================================================================
     Rail wrap - holds the scrolling list + the (Stage 2) arrow buttons.
     ================================================================ */
  .theinmag-bm-story__rail-wrap {
    position: relative;
    max-width: 100%;
  }

  /* Arrow buttons (hidden in Stage 1, Stage 2 reveals them on desktop).
     [hidden] override required because display:inline-flex would
     otherwise win specificity over the UA's [hidden]{display:none}
     rule and paint the buttons before JS removes the hidden attr. */
  .theinmag-bm-story__arrow {
    appearance: none;
    background-color: #FFFFFF;
    color: var(--color-inky-purple-navy, #2A1F3D);
    border: 0;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    box-shadow: 0 4px 14px rgba(123, 79, 158, 0.18);
    cursor: pointer;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 4;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.15s ease, transform 0.15s ease, opacity 0.15s ease;
  }
  .theinmag-bm-story__arrow[hidden] {
    display: none;
  }
  .theinmag-bm-story__arrow svg {
    width: 22px;
    height: 22px;
  }
  .theinmag-bm-story__arrow--prev { left: clamp(8px, 2vw, 24px); }
  .theinmag-bm-story__arrow--next { right: clamp(8px, 2vw, 24px); }
  .theinmag-bm-story__arrow:hover {
    background-color: var(--color-purple-dark, #5D3A7A);
    color: #FFFFFF;
  }
  .theinmag-bm-story__arrow:focus-visible {
    background-color: var(--color-purple-dark, #5D3A7A);
    color: #FFFFFF;
    outline: 3px solid var(--color-yellow, #F9C23C);
    outline-offset: 2px;
  }
  .theinmag-bm-story__arrow[disabled] {
    opacity: 0.35;
    cursor: not-allowed;
  }

  /* ================================================================
     Card list - horizontal scroll-snap rail.
     ================================================================ */
  .theinmag-bm-story__list {
    list-style: none;
    margin: 0;
    padding: clamp(8px, 1.5vw, 16px) clamp(20px, 5vw, 64px) clamp(20px, 3vw, 32px);
    display: flex;
    flex-wrap: nowrap;
    gap: clamp(16px, 2.5vw, 28px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    /* Side-padding inside the scroll container so the first/last cards
       can sit at the visual margin without extra empty space at scroll
       extremes. */
  }
  .theinmag-bm-story__list::-webkit-scrollbar {
    display: none;
  }

  .theinmag-bm-story__list:focus-visible {
    outline: 2px dashed var(--color-purple-dark, #5D3A7A);
    outline-offset: 4px;
    border-radius: 6px;
  }

  .theinmag-bm-story__card {
    flex: 0 0 auto;
    /* Mobile: card takes ~85vw, peek of the next card visible at the
       right edge as a "swipe me" affordance. */
    width: min(85vw, 380px);
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  @media (min-width: 750px) {
    .theinmag-bm-story__card {
      width: 360px;
    }
  }

  @media (min-width: 990px) {
    .theinmag-bm-story__card {
      width: 420px;
    }
  }

  .theinmag-bm-story__card-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    background-color: #FFFFFF;
    box-shadow: 0 2px 12px rgba(123, 79, 158, 0.08);
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .theinmag-bm-story__card-inner:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 22px rgba(123, 79, 158, 0.14);
  }

  .theinmag-bm-story__card-media {
    position: relative;
    aspect-ratio: 8 / 5;
    overflow: hidden;
    background-color: var(--color-lavender, #E8DEEF);
  }

  .theinmag-bm-story__card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .theinmag-bm-story__card-image--placeholder {
    background: linear-gradient(135deg, var(--color-lavender, #E8DEEF) 0%, var(--color-wave-purple, #C9B5DB) 100%);
  }

  /* Card number badge - small, sit-on-image, lower-left. Doubles as
     static progress signal before any JS runs. */
  .theinmag-bm-story__card-num {
    position: absolute;
    bottom: 12px;
    left: 12px;
    background-color: rgba(255, 255, 255, 0.92);
    color: var(--color-inky-purple-navy, #2A1F3D);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.08em;
    padding: 4px 10px;
    border-radius: 9999px;
  }

  .theinmag-bm-story__card-body {
    padding: clamp(20px, 2.4vw, 28px) clamp(20px, 2.4vw, 28px) clamp(24px, 3vw, 32px);
    display: flex;
    flex-direction: column;
    gap: clamp(10px, 1.4vw, 14px);
  }

  /* Inter 700 for the card heading - editorial register. Post Regular
     would compound at 9 stacked cards (Post fatigue). */
  .theinmag-bm-story__card-heading {
    margin: 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: clamp(20px, 2.2vw, 24px);
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--color-inky-purple-navy, #2A1F3D);
  }

  .theinmag-bm-story__card-text {
    margin: 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: clamp(15px, 1.6vw, 16px);
    line-height: 1.65;
    color: var(--color-inky-purple-navy, #2A1F3D);
    opacity: 0.92;
  }

  /* ================================================================
     Indicator (dots + progress text)
     Stage 1 renders the dots inert (first one active). Stage 2 wires
     the click behaviour and updates active state on scroll.
     ================================================================ */
  .theinmag-bm-story__indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(10px, 1.4vw, 14px);
    padding: clamp(8px, 1vw, 14px) clamp(20px, 5vw, 64px) 0;
  }

  .theinmag-bm-story__dots {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 8px;
  }

  .theinmag-bm-story__dot-item {
    margin: 0;
  }

  .theinmag-bm-story__dot {
    appearance: none;
    background-color: rgba(42, 31, 61, 0.22);
    border: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    padding: 0;
    cursor: pointer;
    transition: background-color 0.15s ease, transform 0.15s ease;
  }
  .theinmag-bm-story__dot:hover {
    background-color: rgba(42, 31, 61, 0.5);
  }
  .theinmag-bm-story__dot:focus-visible {
    outline: 2px solid var(--color-purple-dark, #5D3A7A);
    outline-offset: 3px;
  }
  .theinmag-bm-story__dot.is-active {
    background-color: var(--color-purple-dark, #5D3A7A);
    transform: scale(1.3);
  }

  .theinmag-bm-story__progress {
    margin: 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.06em;
    color: var(--color-inky-purple-navy, #2A1F3D);
    opacity: 0.7;
  }

  /* Arrow buttons are desktop-only - on mobile the swipe gesture is the
     primary affordance and the buttons would just compete with content. */
  @media (max-width: 749px) {
    .theinmag-bm-story__arrow {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-bm-story__list {
      scroll-behavior: auto;
    }
    .theinmag-bm-story__card-inner,
    .theinmag-bm-story__arrow,
    .theinmag-bm-story__dot {
      transition: none;
    }
    .theinmag-bm-story__card-inner:hover {
      transform: none;
    }
  }
{%- endstylesheet -%}

<script>
  /* ================================================================
     Carousel JS - arrow paging, dot indicator, progress text,
     keyboard arrow nav. Markup was already in place from Stage 1; this
     script enables the disabled controls and wires up the interaction.
     ================================================================ */
  (function () {
    var root = document.querySelector('[data-theinmag-bm-story]');
    if (!root) return;

    var rail = root.querySelector('[data-bm-story-list]');
    var prevBtn = root.querySelector('[data-bm-story-prev]');
    var nextBtn = root.querySelector('[data-bm-story-next]');
    var dots = Array.prototype.slice.call(root.querySelectorAll('[data-bm-story-dot]'));
    var progressEl = root.querySelector('[data-bm-story-current]');
    var cards = Array.prototype.slice.call(root.querySelectorAll('[data-bm-story-card]'));

    if (!rail || !cards.length) return;

    var prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var current = 1;

    function getRailPaddingLeft() {
      var pad = parseInt(getComputedStyle(rail).paddingLeft, 10);
      return isNaN(pad) ? 0 : pad;
    }

    /* Find the card whose left edge is closest to the rail's content
       start. Snap-aligned so this is reliable once the snap settles. */
    function detectCurrent() {
      var railRect = rail.getBoundingClientRect();
      var pad = getRailPaddingLeft();
      var bestIdx = 1;
      var bestDist = Infinity;
      for (var i = 0; i < cards.length; i++) {
        var cardRect = cards[i].getBoundingClientRect();
        var dist = Math.abs((cardRect.left - railRect.left) - pad);
        if (dist < bestDist) {
          bestDist = dist;
          bestIdx = i + 1;
        }
      }
      return bestIdx;
    }

    function updateUI() {
      if (progressEl) progressEl.textContent = String(current);
      dots.forEach(function (dot) {
        var idx = parseInt(dot.getAttribute('data-index'), 10);
        var active = idx === current;
        dot.classList.toggle('is-active', active);
        if (active) {
          dot.setAttribute('aria-current', 'true');
        } else {
          dot.removeAttribute('aria-current');
        }
      });
      if (prevBtn) prevBtn.disabled = current <= 1;
      if (nextBtn) nextBtn.disabled = current >= cards.length;
    }

    function scrollToCard(idx) {
      if (idx < 1 || idx > cards.length) return;
      var card = cards[idx - 1];
      var railRect = rail.getBoundingClientRect();
      var cardRect = card.getBoundingClientRect();
      var pad = getRailPaddingLeft();
      var newLeft = rail.scrollLeft + (cardRect.left - railRect.left) - pad;
      rail.scrollTo({
        left: Math.max(0, newLeft),
        behavior: prefersReducedMotion ? 'auto' : 'smooth'
      });
      current = idx;
      updateUI();
    }

    /* Enable the controls now that JS is running. */
    if (prevBtn) {
      prevBtn.disabled = false;
      prevBtn.hidden = false;
      prevBtn.addEventListener('click', function () {
        scrollToCard(current - 1);
      });
    }
    if (nextBtn) {
      nextBtn.disabled = false;
      nextBtn.hidden = false;
      nextBtn.addEventListener('click', function () {
        scrollToCard(current + 1);
      });
    }

    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        var idx = parseInt(dot.getAttribute('data-index'), 10);
        if (!isNaN(idx)) scrollToCard(idx);
      });
    });

    /* Keyboard arrow nav when the rail is focused. The rail has
       tabindex="0" so it picks up Tab focus from the eyebrow row. */
    rail.addEventListener('keydown', function (evt) {
      if (evt.key === 'ArrowRight') {
        evt.preventDefault();
        scrollToCard(current + 1);
      } else if (evt.key === 'ArrowLeft') {
        evt.preventDefault();
        scrollToCard(current - 1);
      } else if (evt.key === 'Home') {
        evt.preventDefault();
        scrollToCard(1);
      } else if (evt.key === 'End') {
        evt.preventDefault();
        scrollToCard(cards.length);
      }
    });

    /* Detect current card on scroll (rAF-throttled) so the dot indicator
       stays in sync with native swipe + browser back/forward. */
    var scrollTimer = null;
    rail.addEventListener('scroll', function () {
      if (scrollTimer) cancelAnimationFrame(scrollTimer);
      scrollTimer = requestAnimationFrame(function () {
        var detected = detectCurrent();
        if (detected !== current) {
          current = detected;
          updateUI();
        }
      });
    }, { passive: true });

    updateUI();
  })();
</script>

{% schema %}
{
  "name": "theINmag BM story",
  "tag": "section",
  "class": "theinmag-bm-story-section",
  "settings": [
    { "type": "header", "content": "Section intro" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow line above the rail", "info": "Wrap a word in <em>...</em> tags to emphasise it (renders larger + dark purple)." },
    { "type": "text", "id": "aeo_heading", "label": "Visually-hidden H2 (question form)" },
    { "type": "header", "content": "Section background (optional)" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "text", "id": "background_filename", "label": "Background fallback filename" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Story card",
      "limit": 12,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Card image" },
        { "type": "text", "id": "fallback_filename", "label": "Fallback filename", "info": "Used when the image picker is empty. Filename of an image in /assets/." },
        { "type": "text", "id": "image_alt", "label": "Image alt text" },
        { "type": "text", "id": "heading", "label": "Card heading (H3)" },
        { "type": "textarea", "id": "body", "label": "Card body" }
      ]
    }
  ],
  "presets": [
    {
      "name": "theINmag BM story",
      "settings": {
        "eyebrow": "the story so far.",
        "aeo_heading": "How did theINmag come to be?"
      },
      "blocks": [
        {
