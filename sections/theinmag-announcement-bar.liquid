{%- comment -%}
  theinmag-announcement-bar
  Site-wide announcement strip. Lives at the very top of every page
  (above header/nav) via header-group.json.

  - Two messages.
  - Message 1 = "Mag X is here!" for most of the cycle, switching to a
    "Mag X+1 dropping in N days" countdown for the final 60 days before
    the next drop. Metafield-driven; flip both metafields on drop day.
  - Message 2 = free shipping promo (threshold editable in admin).
  - Desktop (>= 750px): both messages side-by-side, static.
  - Mobile (< 750px): single message visible, cycles 6s with fade.
  - prefers-reduced-motion: instant swap, no fade on mobile.
  - No dismiss button - the bar always shows.

  Spec: ../theinmag-docs/homepage-build-spec.md Section 0.
{%- endcomment -%}

{%- liquid
  # Release date + issue number source from the shop metafields so the
  # announcement bar, the /shop hero, and the Membership/Single PDPs all
  # read ONE source of truth and can never drift. Section settings stay
  # as fallbacks for preview/dev contexts where the metafields aren't
  # populated. To change the release date, update the
  # theinmag.next_release_date shop metafield (not this section).
  assign release_date_mf = shop.metafields.theinmag.next_release_date.value
  if release_date_mf != blank
    assign release_date_str = release_date_mf
  else
    assign release_date_str = section.settings.release_date | strip
  endif
  # current_issue_number holds the just-dropped / current issue (e.g. "Mag10"),
  # bumped to the new issue on drop day per ../theinmag-docs/new-issue-release-checklist.md.
  # The LIVE "Mag X is here!" message reads it as-is. The COUNTDOWN message adds
  # 1 to name the NEXT issue that is dropping - during countdown the metafield
  # still holds the PREVIOUS issue (it only flips on drop day). A single value
  # can't serve both because the metafield flips from previous -> current
  # exactly at the countdown -> live boundary.
  assign current_issue_mf = shop.metafields.theinmag.current_issue_number.value
  if current_issue_mf != blank
    assign current_number = current_issue_mf | remove: 'Mag' | times: 1
  else
    assign current_number = section.settings.issue_number | times: 1
  endif
  assign upcoming_number = current_number | plus: 1
  assign shipping_threshold = section.settings.shipping_threshold | default: 40

  assign show_msg_1 = section.settings.show_msg_1
  assign show_msg_2 = section.settings.show_msg_2

  assign msg_1_text = ''
  assign msg_1_state = 'hidden'

  if show_msg_1 and release_date_str != blank and current_number > 0
    # Normalise both timestamps to midnight before the day-count division.
    # The `plus: 43200` (half a day) turns the flooring division into a
    # round-to-nearest. WHY it is needed: Melbourne daylight saving starts the
    # first Sunday of October, so any countdown that spans that date (e.g. to a
    # 15 Oct drop) has a one-hour spring-forward inside the gap. Without the
    # half-day offset, `divided_by: 86400` floors that one-hour shortfall down a
    # whole day and the counter reads one short for the whole pre-October window
    # (found 2026-08-17: showed 57 on 18 Aug when the true count was 58). Half a
    # day absorbs a +/-1h DST shift in either direction and leaves every
    # non-DST-spanning count unchanged. NOTE: the /shop hero shows a formatted
    # date, not a day count, so it does not share this math (an older comment
    # here claimed it did; that is stale).
    assign release_midnight = release_date_str | date: '%Y-%m-%d' | date: '%s' | times: 1
    assign now_midnight = 'now' | date: '%Y-%m-%d' | date: '%s' | times: 1
    assign days_until = release_midnight | minus: now_midnight | plus: 43200 | divided_by: 86400

    # "Mag X is here!" carries the bulk of the cycle; the next-drop
    # countdown shows only inside the final 60 days. Roll-over is automatic
    # on drop day when current_issue_number + next_release_date are flipped.
    if days_until <= 60 and days_until > 0
      assign msg_1_state = 'countdown'
      assign day_label = 'days'
      if days_until == 1
        assign day_label = 'day'
      endif
      capture msg_1_text
        echo '<span class="theinmag-announcement__hook">Get ready</span> - Mag'
        echo upcoming_number
        echo ' dropping in <span class="theinmag-announcement__hook">'
        echo days_until
        echo '</span> '
        echo day_label
      endcapture
    else
      assign msg_1_state = 'live'
      capture msg_1_text
        echo '<span class="theinmag-announcement__hook">Mag'
        echo current_number
        echo ' is here!</span>'
      endcapture
    endif
  endif

  assign msg_2_text = ''
  if show_msg_2
    capture msg_2_text
      echo 'Free shipping on orders over $'
      echo shipping_threshold
      echo ' 📮'
    endcapture
  endif

  # Per-page override: on the stockist hub (/pages/instock) the top bar
  # speaks to stockists (default navy styling, single message, no rotation).
  # Hook spans = Post-font emphasis, same as the sitewide messages.
  # Copy changed 2026-08-07: it used to say "at checkout", which was true
  # until the page learned to resolve a stockist's real prices on the page
  # itself. Telling them to wait for checkout now reads as a contradiction
  # of the prices sitting right in front of them.
  if page.handle == 'instock'
    capture msg_1_text
      echo 'Are you a <span class="theinmag-announcement__hook">certified stockist?</span> Pop your <span class="theinmag-announcement__hook">code</span> in below and every price becomes your price.'
    endcapture
    assign msg_2_text = ''
  endif
-%}

{%- if msg_1_text != blank or msg_2_text != blank -%}
  <aside
    class="theinmag-announcement"
    data-theinmag-announcement
    role="region"
    aria-label="Site announcements"
  >
    <div class="theinmag-announcement__inner">
      <div class="theinmag-announcement__messages" aria-live="polite">

        {%- if msg_1_text != blank -%}
          {%- if section.settings.msg_1_link != blank -%}
            <a
              class="theinmag-announcement__message is-active"
              data-msg-index="0"
              href="{{ section.settings.msg_1_link }}"
            >
              {{- msg_1_text -}}
            </a>
          {%- else -%}
            <span class="theinmag-announcement__message is-active" data-msg-index="0">
              {{- msg_1_text -}}
            </span>
          {%- endif -%}
        {%- endif -%}

        {%- if msg_2_text != blank -%}
          {%- assign msg_2_index = 1 -%}
          {%- if msg_1_text == blank -%}{%- assign msg_2_index = 0 -%}{%- endif -%}
          {%- if section.settings.msg_2_link != blank -%}
            <a
              class="theinmag-announcement__message{% if msg_2_index == 0 %} is-active{% endif %}"
              data-msg-index="{{ msg_2_index }}"
              href="{{ section.settings.msg_2_link }}"
            >
              {{- msg_2_text -}}
            </a>
          {%- else -%}
            <span
              class="theinmag-announcement__message{% if msg_2_index == 0 %} is-active{% endif %}"
              data-msg-index="{{ msg_2_index }}"
            >
              {{- msg_2_text -}}
            </span>
          {%- endif -%}
        {%- endif -%}

      </div>
    </div>
  </aside>
{%- endif -%}

{% stylesheet %}
  /* ================================================================
     theinmag-announcement-bar
     ================================================================ */

  .theinmag-announcement {
    background-color: var(--color-inky-purple-navy);
    color: var(--color-cream);
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.01em;
    position: relative;
    z-index: 5;
  }

  @media (min-width: 750px) {
    .theinmag-announcement { font-size: 14px; }
  }

  .theinmag-announcement__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Bumped from 36/40 to 42/48 so the larger Post hook breathes. */
    min-height: 42px;
    padding: 8px var(--space-md);
  }

  @media (min-width: 750px) {
    .theinmag-announcement__inner {
      min-height: 48px;
      padding: 10px var(--space-lg);
    }
  }

  .theinmag-announcement__messages {
    position: relative;
    display: grid;
    grid-template-areas: "stack";
    width: 100%;
    text-align: center;
    line-height: 1.4;
  }

  .theinmag-announcement__message {
    grid-area: stack;
    color: inherit;
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .theinmag-announcement__message.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  a.theinmag-announcement__message {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  a.theinmag-announcement__message:hover,
  a.theinmag-announcement__message:focus-visible {
    text-decoration-thickness: 2px;
    outline: none;
  }

  /* "Get ready" + the days number + "MagX is here!" stamp moments -
     Post Regular at ~2x the Inter base. Carried inside the message
     text as spans so the rest stays in Inter. line-height: 0.9 keeps
     the bigger Post characters from blowing up the line-box and
     making the bar grow disproportionately tall. */
  .theinmag-announcement__hook {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 1.8em;
    line-height: 0.9;
    letter-spacing: 0;
    word-spacing: -0.12em;
    vertical-align: -0.12em;
    display: inline-block;
  }

  /* Desktop: both messages side-by-side, no cycling. The JS detects
     this breakpoint and stops the timer so messages stay static. */
  @media (min-width: 750px) {
    .theinmag-announcement__messages {
      grid-template-areas: none;
      grid-template-columns: none;
      display: flex;
      flex-wrap: wrap;
      flex-direction: row;
      justify-content: center;
      align-items: center;
      gap: var(--space-md) var(--space-2xl);
    }

    .theinmag-announcement__message {
      grid-area: auto;
      opacity: 1;
      pointer-events: auto;
      transition: none;
    }
  }

  /* Reduced motion: kill the cross-fade. JS will instant-swap. */
  @media (prefers-reduced-motion: reduce) {
    .theinmag-announcement__message {
      transition: opacity 0.01ms;
    }
  }
{% endstylesheet %}

<script>
  (function () {
    var root = document.querySelector('[data-theinmag-announcement]');
    if (!root) return;

    var messages = Array.prototype.slice.call(
      root.querySelectorAll('.theinmag-announcement__message')
    );
    if (messages.length < 2) return;

    var index = 0;
    var intervalMs = 6000;
    var timer = null;

    // Desktop shows both messages side-by-side via CSS - no cycle.
    // Mobile cycles through them with a fade.
    var desktopMQ = window.matchMedia('(min-width: 750px)');

    function show(i) {
      messages.forEach(function (el, idx) {
        if (idx === i) el.classList.add('is-active');
        else el.classList.remove('is-active');
      });
    }

    function tick() {
      index = (index + 1) % messages.length;
      show(index);
    }

    function stop() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    function start() {
      stop();
      if (desktopMQ.matches) return;
      timer = setInterval(tick, intervalMs);
    }

    function handleViewportChange() {
      if (desktopMQ.matches) {
        stop();
      } else {
        index = 0;
        show(0);
        start();
      }
    }

    if (desktopMQ.addEventListener) {
      desktopMQ.addEventListener('change', handleViewportChange);
    } else if (desktopMQ.addListener) {
      desktopMQ.addListener(handleViewportChange);
    }

    var inner = root.querySelector('.theinmag-announcement__inner');
    if (inner) {
      inner.addEventListener('mouseenter', stop);
      inner.addEventListener('mouseleave', start);
      inner.addEventListener('focusin', stop);
      inner.addEventListener('focusout', start);
    }

    start();
  })();
</script>

{% schema %}
{
  "name": "theINmag announcement bar",
  "tag": "aside",
  "class": "theinmag-announcement-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Site-wide strip above the header. Both messages show side-by-side on desktop; mobile cycles between them with a fade. Always visible - no dismiss button."
    },
    {
      "type": "header",
      "content": "Message 1 - Next issue countdown"
    },
    {
      "type": "checkbox",
      "id": "show_msg_1",
      "label": "Show countdown message",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "Release date + issue number now read from the theinmag.next_release_date and theinmag.current_issue_number shop metafields so this bar stays aligned with the /shop hero and PDPs. The two fields below are fallbacks only - used if the metafields are empty."
    },
    {
      "type": "text",
      "id": "release_date",
      "label": "Next release date (fallback)",
      "info": "Format: YYYY-MM-DD. Only used if the theinmag.next_release_date metafield is empty. Days-only countdown. Hides automatically two days after release.",
      "default": "2026-06-15"
    },
    {
      "type": "text",
      "id": "issue_number",
      "label": "Issue number (fallback)",
      "info": "Whole number only. Only used if the theinmag.current_issue_number metafield is empty.",
      "default": "10"
    },
    {
      "type": "url",
      "id": "msg_1_link",
      "label": "Link (optional)",
      "info": "Where the countdown message points. Usually the current issue product page."
    },
    {
      "type": "header",
      "content": "Message 2 - Free shipping"
    },
    {
      "type": "checkbox",
      "id": "show_msg_2",
      "label": "Show shipping message",
      "default": true
    },
    {
      "type": "number",
      "id": "shipping_threshold",
      "label": "Free shipping threshold ($)",
      "default": 40
    },
    {
      "type": "url",
      "id": "msg_2_link",
      "label": "Link (optional)",
      "info": "Usually /collections/all or /shop."
    }
  ],
  "presets": [
    {
      "name": "theINmag announcement bar"
    }
  ]
}
{% endschema %}
