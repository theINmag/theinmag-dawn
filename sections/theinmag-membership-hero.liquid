{%- comment -%}
  theinmag-membership-hero
  Stage 2c rebuild - Pangaia/Guava/Alessi-style two-column sticky-scroll
  PDP for /products/membership. Absorbs the Stage 2b form section so all
  variant logic, line item properties, and Starting Issue widget machinery
  live here in one comprehensive hero.

  Layout (matches theinmag-single-mags-hero - the typical product page -
  so the Membership PDP reads as the same product-page family):
    Mobile (<750px): single column - media gallery, then widget.
    Desktop (>=750px): two columns. Left = media gallery (one big square
    main image + a thumb strip below). Right = info widget with
    position: sticky so it stays pinned while the user scrolls. Flat -
    no card surfaces; the section bg + padding carry it.

  Variant Format selector swaps the gallery's slide-0 photo + thumb-0
  image on click (Print / Digital / Combo). Gallery JS (thumb click +
  prev/next arrows) lives in theinmag-membership-form.js.

  Right column stack:
    1. Judge.me preview badge
    2. Product title (H1)
    3. "Never miss an issue" tagline
    4. Price
    5. Format pills (coral)
    6. Length pills (coral)
    7. Starting Issue stacked tiles (coral)
    8. Add to Cart (yellow sticker)
    9. Trust microcopy
    10. Accordions: What's included, What ages?, Shipping, Cancel anytime (Rolling only)
    11. Wait-time post-add tile

  Locked random background pulled from the 3-image pool via the
  theinmag-section-bg snippet (sitewide pattern - same snippet works
  for every shop section once we extend the pool).

  Spec lives in this conversation; consolidates Stage 2a plumbing +
  Stage 2b extensions + Stage 2c overhaul.
{%- endcomment -%}

{%- liquid
  assign current_issue = shop.metafields.theinmag.current_issue_number.value | default: 'Mag09'
  assign print_in_stock = shop.metafields.theinmag.current_issue_print_in_stock.value
  assign next_release_value = shop.metafields.theinmag.next_release_date.value
  assign next_release_formatted = next_release_value | date: '%-d %B %Y'

  assign current_num_str = current_issue | remove: 'Mag'
  assign current_num = current_num_str | times: 1
  assign next_num = current_num | plus: 1
  if next_num < 10
    assign next_issue = 'Mag0' | append: next_num
  else
    assign next_issue = 'Mag' | append: next_num
  endif

  assign first_variant = product.selected_or_first_available_variant

  if print_in_stock
    assign print_stock_attr = 'true'
  else
    assign print_stock_attr = 'false'
  endif

  assign hero_print = 'membership-hero-print.jpg' | asset_url
  assign hero_digital = 'membership-hero-digital.jpg' | asset_url
  assign hero_combo = 'membership-hero-combo.jpg' | asset_url

  comment
    Flick-through video filename pattern: mag{NN}-02-flick-through1.mp4
    Bound to the shop-level current_issue_number metafield so the slot
    auto-rolls to the new mag at each release (Stage 14 trigger). If a
    matching file is not uploaded, the video tag's `poster` fallback or
    a manual file-name update via section setting is the remediation.
  endcomment
  assign flick_through_filename = 'mag' | append: current_num_str | append: '-02-flick-through1.mp4'
  assign flick_through_src = flick_through_filename | asset_url
  assign three_times_year_src = 'trust-overlay-three-times-year.jpg' | asset_url
  assign sustainable_src = 'trust-overlay-sustainable.jpg' | asset_url

  assign tagline = section.settings.tagline | default: 'Inspiring creative kids.'
  assign section_style = '--tmh-pt: ' | append: section.settings.padding_top | append: 'px; --tmh-pb: ' | append: section.settings.padding_bottom | append: 'px;'
-%}

<section
  class="theinmag-membership-hero"
  data-theinmag-membership-form
  data-current-issue="{{ current_issue }}"
  data-next-issue="{{ next_issue }}"
  data-print-in-stock="{{ print_stock_attr }}"
  data-hero-print="{{ hero_print }}"
  data-hero-digital="{{ hero_digital }}"
  data-hero-combo="{{ hero_combo }}"
  aria-labelledby="theinmag-membership-hero-heading"
  style="{{ section_style }}"
>
  {%- comment -%}
    Plain cream background. The hero's section CSS sets
    background-color: var(--color-cream); no patterned-bg render
    here so the flat layout reads clean against the page.
  {%- endcomment -%}

  <div class="theinmag-membership-hero__inner">

    {%- comment -%}
      LEFT: media gallery - one big main image + a thumb strip below.
      Mirrors the typical product page media column
      (theinmag-single-mags-hero) so the Membership PDP reads as the same
      product-page family. Slide 0 is the Format-driven variant photo
      (data-hero-swap); the rest are fixed lifestyle / trust photos plus
      the current-issue flick-through video. theinmag-membership-form.js
      runs a small gallery (thumb click + arrows toggle the active slide).
      Photo filename pool: membership-hero-print/digital/combo.jpg,
      trust-overlay-*.jpg, mag{NN}-02-flick-through1.mp4.
    {%- endcomment -%}
    {%- assign gallery_overlays = 'trust-overlay-gift-giving.jpg|A gift that keeps on giving.;trust-overlay-nevermissout.jpg|Letterbox excitement.;trust-overlay-ad-free.jpg|100% ad-free.;trust-overlay-aussie-kids.jpg|Made by Aussie kids for Aussie kids.' | split: ';' -%}
    <div class="theinmag-membership-hero__media-col">

      <div class="theinmag-membership-hero__media-main" data-media-main>
        {%- comment -%} Slide 0: variant-swap photo (Print / Digital / Combo). {%- endcomment -%}
        <div class="theinmag-membership-hero__slide is-active" data-slide>
          <img class="theinmag-membership-hero__slide-img" data-hero-swap src="{{ hero_print }}" alt="theINmag Membership - the magazine for creative kids." loading="eager" fetchpriority="high">
        </div>

        {%- comment -%} Slide 1: "New mags, three times a year." {%- endcomment -%}
        <div class="theinmag-membership-hero__slide" data-slide>
          <img class="theinmag-membership-hero__slide-img" src="{{ three_times_year_src }}" alt="New mags, three times a year." loading="lazy">
        </div>

        {%- comment -%} Trust-overlay slides. {%- endcomment -%}
        {%- for item in gallery_overlays -%}
          {%- assign parts = item | split: '|' -%}
          <div class="theinmag-membership-hero__slide" data-slide>
            <img class="theinmag-membership-hero__slide-img" src="{{ parts[0] | asset_url }}" alt="{{ parts[1] | escape }}" loading="lazy">
          </div>
        {%- endfor -%}

        {%- comment -%}
          Flick-through video of the current mag. Filename built from the
          current_issue_number metafield so the slot auto-rolls at each
          release. Autoplay muted loop playsinline for iOS Safari.
        {%- endcomment -%}
        <div class="theinmag-membership-hero__slide theinmag-membership-hero__slide--video" data-slide>
          <video
            class="theinmag-membership-hero__slide-video"
            src="{{ flick_through_src }}"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label="A quick flick-through of the latest theINmag issue."
          ></video>
        </div>

        {%- comment -%} "Sustainably printed in Australia." {%- endcomment -%}
        <div class="theinmag-membership-hero__slide" data-slide>
          <img class="theinmag-membership-hero__slide-img" src="{{ sustainable_src }}" alt="Sustainably printed in Australia." loading="lazy">
        </div>

        <button type="button" class="theinmag-membership-hero__media-arrow theinmag-membership-hero__media-arrow--prev" data-media-prev aria-label="Previous image">‹</button>
        <button type="button" class="theinmag-membership-hero__media-arrow theinmag-membership-hero__media-arrow--next" data-media-next aria-label="Next image">›</button>
      </div>

      <ol class="theinmag-membership-hero__thumbs" role="list" data-thumbs>
        <li>
          <button type="button" class="theinmag-membership-hero__thumb is-active" data-thumb aria-label="View the membership photo">
            <img data-thumb-swap src="{{ hero_print }}" alt="" loading="lazy">
          </button>
        </li>
        <li>
          <button type="button" class="theinmag-membership-hero__thumb" data-thumb aria-label="View: new mags three times a year">
            <img src="{{ three_times_year_src }}" alt="" loading="lazy">
          </button>
        </li>
        {%- for item in gallery_overlays -%}
          {%- assign parts = item | split: '|' -%}
          <li>
            <button type="button" class="theinmag-membership-hero__thumb" data-thumb aria-label="View: {{ parts[1] | escape }}">
              <img src="{{ parts[0] | asset_url }}" alt="" loading="lazy">
            </button>
          </li>
        {%- endfor -%}
        <li>
          <button type="button" class="theinmag-membership-hero__thumb theinmag-membership-hero__thumb--video" data-thumb aria-label="View the flick-through video">
            <img src="{{ three_times_year_src }}" alt="" loading="lazy">
            <span class="theinmag-membership-hero__thumb-play" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="14" height="14"><circle cx="12" cy="12" r="12" fill="#F9C23C"></circle><polygon points="10,8 10,16 16,12" fill="#2A1F3D"></polygon></svg>
            </span>
          </button>
        </li>
        <li>
          <button type="button" class="theinmag-membership-hero__thumb" data-thumb aria-label="View: sustainably printed in Australia">
            <img src="{{ sustainable_src }}" alt="" loading="lazy">
          </button>
        </li>
      </ol>

      {%- comment -%}
        Product description, sits under the media gallery (matches the
        typical product page's desc-col placement). Reads the same
        single_mag.description_block richtext metafield that the
        single-mags-hero uses for per-issue descriptions, so admin
        editing flows are consistent across product pages. `metafield_tag`
        renders richtext metafields as HTML.
      {%- endcomment -%}
      {%- assign desc_body = product.metafields.single_mag.description_block -%}
      {%- if desc_body != blank -%}
        <div class="theinmag-membership-hero__desc">
          {{ desc_body | metafield_tag }}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} RIGHT: sticky info widget {%- endcomment -%}
    <div class="theinmag-membership-hero__widget" data-widget>

      {%- comment -%}
        Wrap the brand-pun IN in <span class="theinmag-in"> for sitewide
        emphasis treatment (Post Regular renders the IN glyphs slightly
        larger per the design rule). Targets "theINmag" specifically so
        we don't catch unrelated IN substrings (PRINTING, INTERESTING, etc).
      {%- endcomment -%}
      {%- assign title_html = product.title | replace: 'theINmag', 'the<span class="theinmag-in">IN</span>mag' -%}
      <h1 id="theinmag-membership-hero-heading" class="theinmag-membership-hero__title">{{ title_html }}</h1>

      {%- comment -%}
        Tagline row: subtagline + inline shop-wide rating chip (stars + count)
        sitting on the same logical line. Rating links to the main reviews
        section. Pre-Judge.me-load the rating renders empty space; once shop
        metafields are populated (which they are at this point) it shows
        ★★★★★ (N). Atari-PDP-style placement: small rating immediately after
        the value-prop tagline.
      {%- endcomment -%}
      {%- liquid
        assign hero_jm = shop.metafields.judgeme
        assign hero_rating = hero_jm.all_reviews_rating | default: 0
        assign hero_count = hero_jm.all_reviews_count | default: 0
        # Strip trailing period from tagline so the inline rating reads cleanly
        # after a hyphen: "Inspiring creative kids - ★★★★★ (34)".
        assign tagline_clean = tagline
        assign last_char = tagline_clean | slice: -1
        if last_char == '.'
          assign last_index = tagline_clean | size | minus: 1
          assign tagline_clean = tagline_clean | slice: 0, last_index
        endif
      -%}
      <div class="theinmag-membership-hero__tagline-row">
        {%- if tagline_clean != blank -%}
          <p class="theinmag-membership-hero__tagline">{{ tagline_clean }}</p>
        {%- endif -%}
        {%- if hero_count != 0 and hero_count != blank -%}
          <a href="#theinmag-membership-reviews-heading" class="theinmag-membership-hero__rating-link" data-rating-jump aria-label="Read {{ hero_count }} customer reviews">
            <span class="theinmag-membership-hero__rating-sep" aria-hidden="true">-</span>
            <span data-score="{{ hero_rating }}" class="jdgm-all-reviews-rating" aria-label="{{ hero_rating | round: 1 }} stars" role="img"></span>
            <span class="theinmag-membership-hero__rating-count">({{ hero_count }})</span>
          </a>
        {%- endif -%}
      </div>

      <div class="theinmag-membership-hero__price" data-price-display>{{ first_variant.price | money }}</div>
      <p class="theinmag-membership-hero__shipping-note" data-shipping-note hidden>Shipping included</p>

      <form
        action="{{ routes.cart_add_url }}"
        method="post"
        enctype="multipart/form-data"
        class="theinmag-membership-hero__form"
        data-membership-form
      >
        <input type="hidden" name="id" data-variant-id-input value="{{ first_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <input type="hidden" name="properties[_starting_mag]" data-prop-starting-mag value="{{ current_issue }}">
        <input type="hidden" name="properties[_remaining_after_first]" data-prop-remaining value="3">
        <input type="hidden" name="properties[_mags_included]" data-prop-mags-included value="">

        <fieldset class="theinmag-membership-hero__fieldset">
          <legend class="theinmag-membership-hero__legend">Format</legend>
          <div class="theinmag-membership-hero__pills" role="radiogroup" data-option-name="format">
            <button type="button" class="theinmag-membership-hero__pill" data-value="Print" aria-pressed="true">Print</button>
            <button type="button" class="theinmag-membership-hero__pill" data-value="Digital" aria-pressed="false">Digital</button>
            <button type="button" class="theinmag-membership-hero__pill" data-value="Combo" aria-pressed="false">Combo</button>
          </div>
        </fieldset>

        <fieldset class="theinmag-membership-hero__fieldset">
          <legend class="theinmag-membership-hero__legend">Length</legend>
          <div class="theinmag-membership-hero__pills" role="radiogroup" data-option-name="length">
            <button type="button" class="theinmag-membership-hero__pill" data-value="4-Issue" aria-pressed="true">4-Issue</button>
            <button type="button" class="theinmag-membership-hero__pill" data-value="8-Issue" aria-pressed="false">8-Issue</button>
            <button type="button" class="theinmag-membership-hero__pill" data-value="Rolling" aria-pressed="false">Rolling</button>
          </div>
        </fieldset>

        <fieldset class="theinmag-membership-hero__fieldset">
          <legend class="theinmag-membership-hero__legend">Starting issue</legend>
          <div class="theinmag-membership-hero__starting" role="radiogroup" data-option-name="starting">
            <button type="button" class="theinmag-membership-hero__start-tile" data-value="current" data-requires-print-stock="true" aria-pressed="true">
              <span class="theinmag-membership-hero__start-title">Start with the current issue</span>
              <span class="theinmag-membership-hero__start-sub">{{ current_issue }}{% if print_in_stock %} - in stock now{% endif %}</span>
            </button>
            <button type="button" class="theinmag-membership-hero__start-tile" data-value="next" aria-pressed="false">
              <span class="theinmag-membership-hero__start-title">Start with the next issue</span>
              <span class="theinmag-membership-hero__start-sub">{{ next_issue }} - drops {{ next_release_formatted }}</span>
            </button>
          </div>
        </fieldset>

        {%- comment -%}
          CTA row: yellow ADD TO CART + outlined BUY NOW. Same pattern
          as the typical product page. name="checkout" on Buy Now is
          Shopify's built-in skip-cart submit - sends variant + line
          item properties straight to /checkout.
        {%- endcomment -%}
        <div class="theinmag-membership-hero__cta-row">
          <button type="submit" class="theinmag-membership-hero__cta theinmag-membership-hero__cta--primary" data-primary-cta>Add to cart</button>
          <button type="submit" name="checkout" class="theinmag-membership-hero__cta theinmag-membership-hero__cta--secondary" data-buy-now-cta>Buy now</button>
        </div>

        <p class="theinmag-membership-hero__microcopy">
          Free shipping over $40 - Sustainably printed in Australia - 120+ pages, zero ads
        </p>
      </form>

      {%- comment -%}
        Mini auto-scrolling reviews widget. Sits between the trust microcopy
        and the inline FAQ accordions. Renders Judge.me's featured_carousel
        HTML inside a constrained container — one card visible at a time,
        cycled by a small inline rotator. Hidden if no shop reviews yet.
        Atari-PDP-style placement (single-card carousel inside the sales
        widget for ambient social proof).
      {%- endcomment -%}
      {%- if hero_jm.featured_carousel != blank -%}
        <div class="theinmag-membership-hero__mini-reviews" data-mini-reviews>
          <button type="button" class="theinmag-membership-hero__mini-reviews-arrow theinmag-membership-hero__mini-reviews-arrow--prev" data-mini-reviews-prev aria-label="Previous review">‹</button>
          <div class="theinmag-membership-hero__mini-reviews-bubble">
            <div class="theinmag-membership-hero__mini-reviews-inner">
              {{ hero_jm.featured_carousel }}
            </div>
            <a href="#theinmag-membership-reviews-heading" class="theinmag-membership-hero__mini-reviews-readmore" data-rating-jump>Read more reviews →</a>
          </div>
          <button type="button" class="theinmag-membership-hero__mini-reviews-arrow theinmag-membership-hero__mini-reviews-arrow--next" data-mini-reviews-next aria-label="Next review">›</button>
        </div>
      {%- endif -%}

      <ul class="theinmag-membership-hero__accordions" role="list">

        <li class="theinmag-membership-hero__accordion" data-accordion>
          <h3 class="theinmag-membership-hero__acc-q">
            <button type="button" class="theinmag-membership-hero__acc-trigger" data-acc-trigger aria-expanded="false">
              <span>What's included</span>
              <span class="theinmag-membership-hero__acc-caret" aria-hidden="true"></span>
            </button>
          </h3>
          <div class="theinmag-membership-hero__acc-panel" data-acc-panel data-open="false">
            <p>Your chosen format (Print, Digital, or Combo) of every issue across the Membership length. First-dibs on each and every mag drop. Oh yeah - and endless inspiration.</p>
          </div>
        </li>

        <li class="theinmag-membership-hero__accordion" data-accordion>
          <h3 class="theinmag-membership-hero__acc-q">
            <button type="button" class="theinmag-membership-hero__acc-trigger" data-acc-trigger aria-expanded="false">
              <span>What ages is this magazine for?</span>
              <span class="theinmag-membership-hero__acc-caret" aria-hidden="true"></span>
            </button>
          </h3>
          <div class="theinmag-membership-hero__acc-panel" data-acc-panel data-open="false">
            <p>Designed for kids aged 5-13, though lately we've had submissions from kids up to 16. How exciting. Literally enjoyed by the whole family - the puzzles, jokes, art, and short comics pull in younger siblings, the longer reads and creator interviews keep older kids hooked, and parents usually end up reading along too.</p>
          </div>
        </li>

        <li class="theinmag-membership-hero__accordion" data-accordion>
          <h3 class="theinmag-membership-hero__acc-q">
            <button type="button" class="theinmag-membership-hero__acc-trigger" data-acc-trigger aria-expanded="false">
              <span>Shipping and delivery</span>
              <span class="theinmag-membership-hero__acc-caret" aria-hidden="true"></span>
            </button>
          </h3>
          <div class="theinmag-membership-hero__acc-panel" data-acc-panel data-open="false">
            <p>Print mags ship within three business days from order. Free shipping over $40 - not a problem for members. Digital lands in your inbox the day each issue drops. Releases hit mid February, mid June, and mid October.</p>
          </div>
        </li>

        <li class="theinmag-membership-hero__accordion" data-accordion data-rolling-only hidden>
          <h3 class="theinmag-membership-hero__acc-q">
            <button type="button" class="theinmag-membership-hero__acc-trigger" data-acc-trigger aria-expanded="false">
              <span>Can I cancel anytime?</span>
              <span class="theinmag-membership-hero__acc-caret" aria-hidden="true"></span>
            </button>
          </h3>
          <div class="theinmag-membership-hero__acc-panel" data-acc-panel data-open="false">
            <p>Yes - two-click cancel from your account on theinmag.com.au. No emails, no phone calls, no "90-day notice" nonsense. Any issue already charged still ships; renewals stop from the next drop.</p>
          </div>
        </li>

      </ul>

      <aside class="theinmag-membership-hero__post-add" aria-label="Shipping and digital alternative" data-post-add-tile hidden>
        <p>Grabbing a printed mag? It's about to start its Aussie road trip to your house 🚐💨 - up to three business days to ship. Want something to flick through tonight? Upgrade to Combo above and the digital lands in your inbox in about four minutes.</p>
      </aside>

    </div>
  </div>

  <script type="application/json" data-membership-variants>
    [
      {%- for v in product.variants -%}
        {"id": {{ v.id }}, "option1": {{ v.option1 | json }}, "option2": {{ v.option2 | json }}, "price": {{ v.price }}, "available": {{ v.available }}}{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  </script>

</section>

{%- comment -%}
  Floating order-summary card. Rendered as a sibling of the hero
  section (not a child) so it escapes the hero's stacking context
  (isolation: isolate) and stays on top of every section that comes
  after the hero. position: fixed + viewport-level stacking context
  = always-on-top while scrolling the rest of the PDP.

  Same cream-card register as the widget so it reads as "the same
  widget in miniature" - clearly the user's order. Shown by JS via
  the existing data-back-to-order hook when the widget's bottom
  scrolls off viewport top. Two interaction targets inside: (1) the
  body acts as a back-to-widget tap and (2) the CTA submits the
  form's currently-selected variant to cart. Reuses the form's
  variant data + price machinery via update() in theinmag-membership-form.js.
{%- endcomment -%}
<aside class="theinmag-membership-hero__floating-cart" data-back-to-order data-floating-cart data-show="false" aria-label="Your order summary">
  <div class="theinmag-membership-hero__floating-cart-card">
    <button type="button" class="theinmag-membership-hero__floating-cart-tap" data-floating-cart-tap aria-label="Back to the selectors">
      <span class="theinmag-membership-hero__floating-cart-eyebrow">your order</span>
      <span class="theinmag-membership-hero__floating-cart-summary" data-floating-cart-summary>4-Issue Print</span>
      <span class="theinmag-membership-hero__floating-cart-issue" data-floating-cart-issue>Start with {{ current_issue }}</span>
    </button>
    <button type="button" class="theinmag-membership-hero__floating-cart-cta" data-floating-cart-cta aria-label="Add this Membership to cart">
      <span>Add to cart</span>
      <span aria-hidden="true">-</span>
      <span data-floating-cart-cta-price>{{ first_variant.price | money }}</span>
    </button>
  </div>
</aside>

<script src="{{ 'theinmag-membership-form.js' | asset_url }}" defer></script>

<script>
  (function () {
    // Flatten Judge.me's internal carousel wrappers — move every
    // .jdgm-carousel-item to be a direct child of the inner host so
    // CSS display-none/block toggling works regardless of how Judge.me
    // nested things. Also strips Judge.me's own arrows/title block.
    function flattenJdgm(root, host) {
      var items = root.querySelectorAll('.jdgm-carousel-item');
      items.forEach(function (item) {
        if (item.parentNode !== host) {
          host.appendChild(item);
        }
      });
      var cruft = root.querySelectorAll('.jdgm-carousel, .jdgm-carousel__items, .jdgm-carousel__item-container, .jdgm-carousel-title-and-link, .jdgm-carousel__arrow-left, .jdgm-carousel__arrow-right, .jdgm-carousel__arrows');
      cruft.forEach(function (c) {
        if (c.parentNode && c.children.length === 0) {
          c.parentNode.removeChild(c);
        } else if (c.parentNode) {
          c.parentNode.removeChild(c);
        }
      });
    }

    function initMiniReviews(root) {
      var host = root.querySelector('.theinmag-membership-hero__mini-reviews-inner');
      if (!host) return;
      flattenJdgm(root, host);

      var items = Array.prototype.slice.call(host.querySelectorAll(':scope > .jdgm-carousel-item'));
      if (!items.length) {
        // Fallback: any jdgm-carousel-item, even if still nested.
        items = Array.prototype.slice.call(host.querySelectorAll('.jdgm-carousel-item'));
      }
      if (!items.length) return;
      // Cap at 10 items for sane DOM weight.
      items.slice(10).forEach(function (n) { n.parentNode && n.parentNode.removeChild(n); });
      items = Array.prototype.slice.call(host.querySelectorAll('.jdgm-carousel-item'));
      if (!items.length) return;

      var index = 0;
      items.forEach(function (n, i) { n.classList.toggle('is-active', i === 0); });

      function show(i) {
        index = (i + items.length) % items.length;
        items.forEach(function (n, j) { n.classList.toggle('is-active', j === index); });
      }

      var prev = root.querySelector('[data-mini-reviews-prev]');
      var next = root.querySelector('[data-mini-reviews-next]');
      if (prev) prev.addEventListener('click', function () { show(index - 1); stop(); });
      if (next) next.addEventListener('click', function () { show(index + 1); stop(); });

      var timer = null;
      function start() {
        if (timer) return;
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        timer = setInterval(function () { show(index + 1); }, 6000);
      }
      function stop() { if (timer) { clearInterval(timer); timer = null; } }

      start();
      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', start);
    }

    function init() {
      document.querySelectorAll('[data-mini-reviews]').forEach(initMiniReviews);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
    // Re-run on load in case Judge.me's JS rearranged things after first init.
    window.addEventListener('load', function () { setTimeout(init, 50); });
  })();
</script>

{% stylesheet %}
  .theinmag-membership-hero {
    position: relative;
    isolation: isolate;
    color: var(--color-inky-purple-navy);
    background-color: var(--color-cream);
    padding: var(--tmh-pt, 56px) var(--space-lg) var(--tmh-pb, 56px);
    overflow: hidden;
  }

  .theinmag-membership-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  @media (min-width: 750px) {
    .theinmag-membership-hero__inner {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      gap: var(--space-2xl);
      align-items: start;
    }
  }

  /* ---------- LEFT: media gallery (main image + thumb strip) ---------- */
  /* Ported from theinmag-single-mags-hero so the Membership PDP media
     column reads identically to the typical product page. Flat - no
     card surface; the section's own bg + padding carry it. */

  .theinmag-membership-hero__media-col {
    width: 100%;
  }

  .theinmag-membership-hero__media-main {
    position: relative;
    width: 100%;
    /* Square canvas - matches the single-mags hero. */
    aspect-ratio: 1 / 1;
    background-color: rgba(42, 31, 61, 0.04);
    overflow: hidden;
  }

  .theinmag-membership-hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }
  .theinmag-membership-hero__slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }
  .theinmag-membership-hero__slide-img,
  .theinmag-membership-hero__slide-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .theinmag-membership-hero__media-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.85);
    border: 0;
    color: var(--color-inky-purple-navy);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    display: none;
    z-index: 2;
    transition: background 0.15s ease;
  }
  .theinmag-membership-hero__media-arrow:hover { background: #ffffff; }
  .theinmag-membership-hero__media-arrow--prev { left: var(--space-sm); }
  .theinmag-membership-hero__media-arrow--next { right: var(--space-sm); }
  @media (min-width: 750px) {
    .theinmag-membership-hero__media-arrow { display: grid; place-items: center; }
  }

  .theinmag-membership-hero__thumbs {
    list-style: none;
    margin: var(--space-sm) 0 0;
    padding: 0;
    display: flex;
    gap: var(--space-xs);
    flex-wrap: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .theinmag-membership-hero__thumbs::-webkit-scrollbar { display: none; }
  .theinmag-membership-hero__thumbs li { margin: 0; flex: 0 0 auto; }

  .theinmag-membership-hero__thumb {
    appearance: none;
    background: transparent;
    border: 2px solid transparent;
    padding: 0;
    width: 60px;
    height: 60px;
    cursor: pointer;
    overflow: hidden;
    position: relative;
    transition: border-color 0.15s ease;
  }
  .theinmag-membership-hero__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .theinmag-membership-hero__thumb.is-active {
    border-color: var(--color-purple-dark);
  }
  .theinmag-membership-hero__thumb-play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
  }

  /* Product description block - sits under the gallery thumbs, inside
     the media column. Matches the typical product page rhythm. */
  .theinmag-membership-hero__desc {
    margin: var(--space-md) 0 0;
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-inky-purple-navy);
  }
  .theinmag-membership-hero__desc p { margin: 0 0 var(--space-sm); }
  .theinmag-membership-hero__desc p:last-child { margin-bottom: 0; }
  .theinmag-membership-hero__desc h2,
  .theinmag-membership-hero__desc h3 {
    font-family: var(--font-heading);
    font-weight: 400;
    color: var(--color-inky-purple-navy);
    margin: var(--space-md) 0 var(--space-xs);
  }
  .theinmag-membership-hero__desc h2 { font-size: clamp(20px, 2.4vw, 24px); }
  .theinmag-membership-hero__desc h3 { font-size: clamp(16px, 1.8vw, 18px); }
  .theinmag-membership-hero__desc a {
    color: var(--color-purple-dark);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .theinmag-membership-hero__desc ul,
  .theinmag-membership-hero__desc ol {
    margin: 0 0 var(--space-sm);
    padding-left: 1.25em;
  }
  .theinmag-membership-hero__desc li { margin: 0 0 4px; }

  /* ---------- RIGHT column (sticky widget) ---------- */

  /* Flat - no card surface (matches the typical product page). The
     section bg + padding carry it; the widget just needs internal
     spacing off the media column. */
  .theinmag-membership-hero__widget {
    padding: var(--space-md) 0 0;
  }

  @media (min-width: 750px) {
    .theinmag-membership-hero__widget {
      /* Sticky-bottom: widget pins at viewport bottom once its own
         bottom would otherwise scroll off, then releases with the
         media column at section end. Matches single-mags-hero. */
      position: sticky;
      bottom: 0;
      align-self: start;
      padding: 0 0 0 var(--space-md);
    }
  }

  /* Tagline row holds the italic subtagline + inline shop-wide rating chip.
     Centred so the tagline keeps its visual weight when the chip is absent
     (no reviews yet); chip sits to the right on wider widths, wraps below
     the tagline on narrow widget widths. */
  .theinmag-membership-hero__tagline-row {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px 10px;
    margin: 0 0 var(--space-sm);
  }
  .theinmag-membership-hero__rating-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-inky-purple-navy);
    text-decoration: none;
    cursor: pointer;
  }
  .theinmag-membership-hero__rating-link .jdgm-all-reviews-rating {
    display: inline-block;
    font-size: 16px;
    line-height: 1;
  }
  .theinmag-membership-hero__rating-sep {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    color: var(--color-inky-purple-navy);
    opacity: 0.5;
    line-height: 1;
    margin: 0 2px 0 0;
  }
  .theinmag-membership-hero__rating-count {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-inky-purple-navy);
    opacity: 0.78;
    line-height: 1;
  }

  .theinmag-membership-hero__title {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(24px, 3vw, 32px);
    line-height: 1.05;
    color: var(--color-inky-purple-navy);
    margin: 0 0 2px;
    white-space: nowrap;
    text-align: center;
  }

  /* Editorial benefit line under title. Inky-navy italic - sandy-orange
     read as "red" against the soft pink pills, the pair clashed.
     Centred + sitting tight under the title (Ryan: closer to heading). */
  .theinmag-membership-hero__tagline {
    font-family: var(--font-body);
    font-style: italic;
    font-weight: 400;
    font-size: 14px;
    line-height: 1.4;
    color: var(--color-inky-purple-navy);
    opacity: 0.78;
    margin: 0;
    text-align: center;
  }

  .theinmag-membership-hero__price {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(20px, 2.6vw, 26px);
    line-height: 1.1;
    color: var(--color-inky-purple-navy);
    margin: 0 0 var(--space-xs);
  }

  /* Shipping-included note appears under the price for Rolling Print + Rolling
     Combo - the spec bakes shipping into the Rolling variant price, so flag it
     up-front before the customer hits checkout. JS toggles `hidden`. */
  .theinmag-membership-hero__shipping-note {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 12px;
    line-height: 1.4;
    color: var(--color-sage-dark);
    margin: 0 0 var(--space-md);
  }
  .theinmag-membership-hero__shipping-note[hidden] { display: none; }

  .theinmag-membership-hero__form { display: block; }

  .theinmag-membership-hero__fieldset {
    border: 0;
    padding: 0;
    margin: 0 0 var(--space-md);
  }

  .theinmag-membership-hero__legend {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--color-inky-purple-navy);
    text-transform: uppercase;
    padding: 0;
    margin: 0 0 var(--space-xs);
    opacity: 0.78;
  }

  /* Soft-pink pill toggles - white default, pink border, pink fill on
     selection. The pink (--color-soft-pink, sampled from the header wordmark
     backdrop) reads warmer and less aggressive than the dark coral. Selected
     state keeps inky-navy text so we hold WCAG AA contrast on the pink fill. */
  .theinmag-membership-hero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .theinmag-membership-hero__pill {
    /* flex: 1 1 0 (NOT 1 1 auto) so all three pills divide the row
       equally regardless of label width - "4-Issue" is shorter than
       "8-Issue"/"Rolling" so auto sizes give unequal widths. */
    flex: 1 1 0;
    min-width: 0;
    min-height: 40px;
    padding: 8px 14px;
    background: #ffffff;
    border: 2px solid var(--color-soft-pink);
    border-radius: var(--radius-pill);
    color: var(--color-inky-purple-navy);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 13px;
    cursor: pointer;
    transition: background var(--transition-standard), color var(--transition-standard);
  }
  .theinmag-membership-hero__pill:hover { background: rgba(247, 160, 146, 0.18); }
  .theinmag-membership-hero__pill[aria-pressed='true'] {
    background: var(--color-soft-pink);
    color: var(--color-inky-purple-navy);
  }
  .theinmag-membership-hero__pill[hidden] { display: none; }

  /* Starting issue tiles - stacked vertically per Ryan's preference (reverting
     the earlier side-by-side experiment - the stacked treatment reads cleaner
     and lets the two-line tile content breathe). Tiles shrink to fit their
     content width so there's no dead space on the right - matches the rest
     of the widget's tight rhythm. */
  .theinmag-membership-hero__starting {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xs);
  }
  .theinmag-membership-hero__start-tile {
    background: #ffffff;
    border: 1.5px solid var(--color-soft-pink);
    border-radius: var(--radius-pill);
    padding: 8px 16px;
    cursor: pointer;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 1px;
    color: var(--color-inky-purple-navy);
    font-family: var(--font-body);
    transition: background var(--transition-standard), color var(--transition-standard);
  }
  .theinmag-membership-hero__start-tile[aria-pressed='true'] {
    background: var(--color-soft-pink);
    color: var(--color-inky-purple-navy);
  }
  .theinmag-membership-hero__start-tile[hidden] { display: none; }
  .theinmag-membership-hero__start-title { font-weight: 700; font-size: 13px; line-height: 1.3; }
  .theinmag-membership-hero__start-sub { font-weight: 400; font-size: 12px; opacity: 0.85; line-height: 1.3; }

  /* CTA row holds the yellow ADD TO CART + outlined BUY NOW side by side.
     Pattern matches the typical product page (theinmag-single-mags-hero). */
  .theinmag-membership-hero__cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: var(--space-sm) 0 0;
    justify-content: center;
  }

  .theinmag-membership-hero__cta {
    appearance: none;
    flex: 1 1 0;
    min-width: 0;
    max-width: 220px;
    color: var(--color-inky-purple-navy);
    font-family: var(--font-heading);
    font-size: 18px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    padding: 12px 20px;
    border: 0;
    border-radius: var(--radius-button);
    cursor: pointer;
    transition: background var(--transition-standard), color var(--transition-standard), translate var(--transition-standard), box-shadow var(--transition-standard);
  }

  /* Yellow sticker - locked convention for ADD TO CART. */
  .theinmag-membership-hero__cta--primary {
    background: var(--color-yellow);
    box-shadow: var(--shadow-button-yellow);
  }
  .theinmag-membership-hero__cta--primary:hover {
    background: var(--color-purple-dark);
    color: #ffffff;
    translate: 0 2px;
    box-shadow: var(--shadow-button-pressed);
  }

  /* Outlined companion for BUY NOW - inky-purple stroke on the cream
     section bg, fills on hover. */
  .theinmag-membership-hero__cta--secondary {
    background: transparent;
    border: 2px solid var(--color-inky-purple-navy);
    padding: 10px 18px; /* compensate for border so total height matches primary */
  }
  .theinmag-membership-hero__cta--secondary:hover {
    background: var(--color-inky-purple-navy);
    color: var(--color-cream);
    translate: 0 2px;
  }

  .theinmag-membership-hero__microcopy {
    font-family: var(--font-body);
    font-size: 12px;
    line-height: 1.5;
    color: var(--color-inky-purple-navy);
    opacity: 0.78;
    margin: var(--space-sm) 0 0;
    text-align: center;
  }

  /* Mini reviews widget — sits between trust microcopy and the FAQ
     accordions. Bubble visual matches the starting-issue tile style
     (white surface, 2px soft-pink border, radius-lg, body font), arrows
     on the left and right sides of the bubble, body clamped to 3 lines
     with a "Read more" link that scroll-jumps to the main reviews
     section. JS flattens Judge.me's internal carousel wrappers + toggles
     `.is-active` on the visible card. */
  .theinmag-membership-hero__mini-reviews {
    display: flex;
    align-items: stretch;
    gap: 6px;
    margin: var(--space-md) 0 0;
  }
  .theinmag-membership-hero__mini-reviews-bubble {
    flex: 1 1 auto;
    min-width: 0;
    background: #FFFFFF;
    border: 2px solid var(--color-soft-pink);
    border-radius: var(--radius-lg);
    padding: 10px 14px;
    text-align: left;
  }
  .theinmag-membership-hero__mini-reviews-inner {
    min-height: 80px;
  }
  .theinmag-membership-hero__mini-reviews-arrow {
    flex: 0 0 auto;
    width: 24px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-coral-dark);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    border-radius: 4px;
    transition: background-color 0.15s ease, transform 0.1s ease;
  }
  .theinmag-membership-hero__mini-reviews-arrow:hover,
  .theinmag-membership-hero__mini-reviews-arrow:focus-visible {
    background-color: rgba(201, 84, 62, 0.08);
  }
  .theinmag-membership-hero__mini-reviews-arrow:active {
