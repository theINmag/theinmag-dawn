<script>
  (function () {
    // Flatten Judge.me's internal carousel wrappers — move every
    // .jdgm-carousel-item to be a direct child of the inner host so
    // CSS display-none/block toggling works regardless of how Judge.me
    // nested things. Also strips Judge.me's own arrows/title block.
    function flattenJdgm(root, host) {
      var items = root.querySelectorAll('.jdgm-carousel-item');
      items.forEach(function (item) {
        if (item.parentNode !== host) {
          host.appendChild(item);
        }
      });
      var cruft = root.querySelectorAll('.jdgm-carousel, .jdgm-carousel__items, .jdgm-carousel__item-container, .jdgm-carousel-title-and-link, .jdgm-carousel__arrow-left, .jdgm-carousel__arrow-right, .jdgm-carousel__arrows');
      cruft.forEach(function (c) {
        if (c.parentNode && c.children.length === 0) {
          c.parentNode.removeChild(c);
        } else if (c.parentNode) {
          c.parentNode.removeChild(c);
        }
      });
    }

    function initMiniReviews(root) {
      var host = root.querySelector('.theinmag-membership-hero__mini-reviews-inner');
      if (!host) return;
      flattenJdgm(root, host);

      var items = Array.prototype.slice.call(host.querySelectorAll(':scope > .jdgm-carousel-item'));
      if (!items.length) {
        // Fallback: any jdgm-carousel-item, even if still nested.
        items = Array.prototype.slice.call(host.querySelectorAll('.jdgm-carousel-item'));
      }
      if (!items.length) return;
      // Cap at 10 items for sane DOM weight.
      items.slice(10).forEach(function (n) { n.parentNode && n.parentNode.removeChild(n); });
      items = Array.prototype.slice.call(host.querySelectorAll('.jdgm-carousel-item'));
      if (!items.length) return;

      var index = 0;
      items.forEach(function (n, i) { n.classList.toggle('is-active', i === 0); });

      function show(i) {
        index = (i + items.length) % items.length;
        items.forEach(function (n, j) { n.classList.toggle('is-active', j === index); });
      }

      var prev = root.querySelector('[data-mini-reviews-prev]');
      var next = root.querySelector('[data-mini-reviews-next]');
      if (prev) prev.addEventListener('click', function () { show(index - 1); stop(); });
      if (next) next.addEventListener('click', function () { show(index + 1); stop(); });

      var timer = null;
      function start() {
        if (timer) return;
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        timer = setInterval(function () { show(index + 1); }, 6000);
      }
      function stop() { if (timer) { clearInterval(timer); timer = null; } }

      start();
      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', start);
    }

    function init() {
      document.querySelectorAll('[data-mini-reviews]').forEach(initMiniReviews);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
    // Re-run on load in case Judge.me's JS rearranged things after first init.
    window.addEventListener('load', function () { setTimeout(init, 50); });
  })();
</script>

{% stylesheet %}
  .theinmag-membership-hero {
    position: relative;
    isolation: isolate;
    color: var(--color-inky-purple-navy);
    background-color: #FFFFFF;
    padding: var(--tmh-pt, 56px) var(--space-lg) var(--tmh-pb, 56px);
    overflow: hidden;
  }

  .theinmag-membership-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    /* Mobile reads headline (title, tagline, stars, trust) BEFORE the
       photo (Ryan, 2026-08-12); grid areas reorder visually while the
       DOM keeps media first. */
    grid-template-areas:
      'headline'
      'media'
      'widget';
    gap: var(--space-xl);
  }
  .theinmag-membership-hero__headline { grid-area: headline; }
  .theinmag-membership-hero__media-col { grid-area: media; }
  .theinmag-membership-hero__widget { grid-area: widget; }

  @media (max-width: 749px) {
    .theinmag-membership-hero__inner {
      row-gap: var(--space-md);
    }
    /* Phones: the lone title above the photo sits centred (Ryan). */
    .theinmag-membership-hero__title {
      text-align: center;
    }
  }

  @media (min-width: 750px) {
    .theinmag-membership-hero__inner {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      /* Headline tops the right column, media spans both rows - the
         desktop look is unchanged from when the title lived inside the
         widget. */
      grid-template-areas:
        'media headline'
        'media widget';
      grid-template-rows: auto 1fr;
      /* Tight row gap keeps the title visually attached to the widget
         below it, as when it lived inside the widget. */
      column-gap: var(--space-2xl);
      row-gap: var(--space-sm);
      align-items: start;
    }
  }

  /* ---------- Colour field mode (concept 3) ---------- */
  /* Full-strength kid-art pattern behind one elevated cream tile. The
     wash sits on the layer's ::after so the pattern keeps its colour
     under a translucent cream veil (competitions treatment). */
  .theinmag-membership-hero--field {
    background-color: var(--color-cream);
    padding-left: clamp(12px, 3vw, 40px);
    padding-right: clamp(12px, 3vw, 40px);
  }
  /* Pattern on ::before, cream wash on ::after (paints above ::before at
     the same z-index). An empty layer div would be display:none'd by
     Dawn's base.css div:empty rule. */
  .theinmag-membership-hero--field::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: var(--tmh-field-img);
    /* Sized off the VIEWPORT WIDTH, not the element (cover), so the
       pattern never rescales when an accordion opens and the section
       grows taller - Ryan's "background zooms" report. Tall sections
       tile vertically; the cream wash keeps any seam quiet. */
    background-size: 100vw auto;
    background-position: top center;
    background-repeat: repeat;
    pointer-events: none;
  }
  .theinmag-membership-hero--field::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background-color: rgba(251, 246, 234, var(--tmh-field-wash, 0.55));
    pointer-events: none;
  }
  .theinmag-membership-hero--field .theinmag-membership-hero__inner {
    background-color: var(--color-cream);
    border-radius: var(--radius-xl);
    box-shadow: 0 12px 36px rgba(42, 31, 61, 0.22);
    padding: clamp(16px, 3vw, 32px);
  }

  /* ---------- LEFT: media gallery (main image + thumb strip) ---------- */
  /* Ported from theinmag-single-mags-hero so the Membership PDP media
     column reads identically to the typical product page. Flat - no
     card surface; the section's own bg + padding carry it. */

  .theinmag-membership-hero__media-col {
    width: 100%;
    /* min-width:0 + overflow-x:clip stops the media gallery's intrinsic
       content width from inflating the grid track on mobile, which was
       pushing the entire __inner column to ~508px wide on a 375px
       viewport and clipping the picker. Grid items default to min-width:
       auto (= min-content sized), so without this the gallery's
       internal min-content wins over the parent's available space. */
    min-width: 0;
    overflow-x: clip;
  }

  .theinmag-membership-hero__media-main {
    position: relative;
    width: 100%;
    /* Square canvas - matches the single-mags hero. */
    aspect-ratio: 1 / 1;
    background-color: rgba(42, 31, 61, 0.04);
    overflow: hidden;
  }

  .theinmag-membership-hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
  }
  .theinmag-membership-hero__slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }
  .theinmag-membership-hero__slide-img,
  .theinmag-membership-hero__slide-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Peek-inside affordance. Full-cover click target + white-on-scrim
     "See inside" cue pinned bottom-centre. Mirrors the single-mags hero. */
  .theinmag-membership-hero__peek-trigger {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: clamp(10px, 2vw, 16px);
    border: 0;
    background: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .theinmag-membership-hero__peek-cue {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 999px;
    background: rgba(26, 18, 32, 0.62);
    color: #fff;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: 13px;
    line-height: 1;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(2px);
    transition: background 0.15s ease, transform 0.15s ease;
    pointer-events: none;
  }
  .theinmag-membership-hero__peek-cue svg { display: block; }
  .theinmag-membership-hero__peek-trigger:hover .theinmag-membership-hero__peek-cue,
  .theinmag-membership-hero__peek-trigger:focus-visible .theinmag-membership-hero__peek-cue {
    background: rgba(26, 18, 32, 0.8);
    transform: translateY(-1px);
  }
  .theinmag-membership-hero__peek-trigger:focus-visible {
    outline: 2px solid var(--color-yellow, #F9C23C);
    outline-offset: -3px;
  }
  .theinmag-membership-hero__peek-a11y {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .theinmag-membership-hero__peek-cue { transition: none; }
    .theinmag-membership-hero__peek-trigger:hover .theinmag-membership-hero__peek-cue,
    .theinmag-membership-hero__peek-trigger:focus-visible .theinmag-membership-hero__peek-cue { transform: none; }
  }

  .theinmag-membership-hero__media-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.85);
    border: 0;
    color: var(--color-inky-purple-navy);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    display: none;
    /* Above the peek-inside trigger (z-index 2) so prev/next stay clickable. */
    z-index: 3;
    transition: background 0.15s ease;
  }
  .theinmag-membership-hero__media-arrow:hover { background: #ffffff; }
  .theinmag-membership-hero__media-arrow--prev { left: var(--space-sm); }
  .theinmag-membership-hero__media-arrow--next { right: var(--space-sm); }
  @media (min-width: 750px) {
    .theinmag-membership-hero__media-arrow { display: grid; place-items: center; }
  }

  .theinmag-membership-hero__thumbs {
    list-style: none;
    margin: var(--space-sm) 0 0;
    padding: 0;
    display: flex;
    gap: var(--space-xs);
    flex-wrap: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .theinmag-membership-hero__thumbs::-webkit-scrollbar { display: none; }
  .theinmag-membership-hero__thumbs li { margin: 0; flex: 0 0 auto; }

  .theinmag-membership-hero__thumb {
    appearance: none;
    background: transparent;
    border: 2px solid transparent;
    padding: 0;
    width: 60px;
    height: 60px;
    cursor: pointer;
    overflow: hidden;
    position: relative;
    transition: border-color 0.15s ease;
  }
  .theinmag-membership-hero__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .theinmag-membership-hero__thumb.is-active {
    border-color: var(--color-purple-dark);
  }
  .theinmag-membership-hero__thumb-play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
  }

  /* Product description block - sits under the gallery thumbs, inside
     the media column. Matches the typical product page rhythm. */
  .theinmag-membership-hero__desc {
    margin: var(--space-md) 0 0;
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-inky-purple-navy);
  }
  .theinmag-membership-hero__desc p { margin: 0 0 var(--space-sm); }
  .theinmag-membership-hero__desc p:last-child { margin-bottom: 0; }
  .theinmag-membership-hero__desc h2,
  .theinmag-membership-hero__desc h3 {
    font-family: var(--font-heading);
    font-weight: 400;
    color: var(--color-inky-purple-navy);
    margin: var(--space-md) 0 var(--space-xs);
  }
  .theinmag-membership-hero__desc h2 { font-size: clamp(20px, 2.4vw, 24px); }
  .theinmag-membership-hero__desc h3 { font-size: clamp(16px, 1.8vw, 18px); }
  .theinmag-membership-hero__desc a {
    color: var(--color-purple-dark);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .theinmag-membership-hero__desc ul,
  .theinmag-membership-hero__desc ol {
    margin: 0 0 var(--space-sm);
    padding-left: 1.25em;
  }
  .theinmag-membership-hero__desc li { margin: 0 0 4px; }

  /* ---------- RIGHT column (sticky widget) ---------- */

  /* Flat - no card surface (matches the typical product page). The
     section bg + padding carry it; the widget just needs internal
     spacing off the media column.

     min-width: 0 + overflow-x: clip is load-bearing: without them, the
     widget's grid track expands to fit its widest descendant (the
     Judge.me featured-carousel ships ~416px-wide markup that can't be
     shrunk via theme CSS), which on mobile bloats the column to ~508px
     wide and pushes the picker (Format / Length / Starting Issue) past
     the viewport edge. min-width:0 lets grid's 1fr actually win on
     narrow screens; the clip contains any remaining third-party
     overflow without breaking the desktop sticky behaviour. */
  .theinmag-membership-hero__widget {
    padding: var(--space-md) 0 0;
    min-width: 0;
    max-width: 100%;
    overflow-x: clip;
  }

  @media (min-width: 750px) {
    .theinmag-membership-hero__widget {
      /* Sticky-bottom: widget pins at viewport bottom once its own
         bottom would otherwise scroll off, then releases with the
         media column at section end. Matches single-mags-hero. */
      position: sticky;
      bottom: 0;
      align-self: start;
      padding: 0 0 0 var(--space-md);
    }
  }

  /* Tagline row holds the italic subtagline + inline shop-wide rating chip.
     Centred so the tagline keeps its visual weight when the chip is absent
     (no reviews yet); chip sits to the right on wider widths, wraps below
     the tagline on narrow widget widths. */
  .theinmag-membership-hero__tagline-row {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: 8px 10px;
    margin: 0 0 var(--space-sm);
  }
  .theinmag-membership-hero__rating-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-inky-purple-navy);
    text-decoration: none;
    cursor: pointer;
  }
  .theinmag-membership-hero__rating-link .jdgm-all-reviews-rating {
    display: inline-block;
    font-size: 16px;
    line-height: 1;
  }
  .theinmag-membership-hero__rating-sep {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    color: var(--color-inky-purple-navy);
    opacity: 0.5;
    line-height: 1;
    margin: 0 2px 0 0;
  }
  .theinmag-membership-hero__rating-count {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-inky-purple-navy);
    opacity: 0.78;
    line-height: 1;
  }

  .theinmag-membership-hero__title {
    font-family: var(--font-heading);
    font-weight: 400;
    /* Bumped from 26-34 (Ryan, 2026-08-12: product names should grab
       more attention). */
    font-size: clamp(30px, 3.8vw, 42px);
    line-height: 1.05;
    color: var(--color-inky-purple-navy);
    margin: 0 0 2px;
    white-space: normal;
    text-align: left;
  }

  /* Editorial benefit line under title. Inky-navy italic - sandy-orange
     read as "red" against the soft pink pills, the pair clashed.
     Centred + sitting tight under the title (Ryan: closer to heading). */
  .theinmag-membership-hero__tagline {
    font-family: var(--font-body);
    font-style: italic;
    font-weight: 400;
    font-size: 14px;
    line-height: 1.4;
    color: var(--color-inky-purple-navy);
    opacity: 0.78;
    margin: 0;
    text-align: left;
  }

  .theinmag-membership-hero__price {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(24px, 3vw, 30px);
    line-height: 1.1;
    color: var(--color-inky-purple-navy);
    margin: 0 0 var(--space-xs);
    text-align: left;
  }

  /* Shipping-included note appears under the price for Rolling Print + Rolling
     Combo - the spec bakes shipping into the Rolling variant price, so flag it
     up-front before the customer hits checkout. JS toggles `hidden`. */
  .theinmag-membership-hero__shipping-note {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 12px;
    line-height: 1.4;
    color: var(--color-sage-dark);
    margin: 0 0 var(--space-md);
  }
  .theinmag-membership-hero__shipping-note[hidden] { display: none; }

  .theinmag-membership-hero__form { display: block; }

  .theinmag-membership-hero__fieldset {
    border: 0;
    padding: 0;
    margin: 0 0 var(--space-md);
  }

  .theinmag-membership-hero__legend {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--color-inky-purple-navy);
    text-transform: uppercase;
    padding: 0;
    margin: 0 0 var(--space-xs);
    opacity: 0.78;
  }

  /* Soft-pink pill toggles - white default, pink border, pink fill on
     selection. The pink (--color-soft-pink, sampled from the header wordmark
     backdrop) reads warmer and less aggressive than the dark coral. Selected
     state keeps inky-navy text so we hold WCAG AA contrast on the pink fill. */
  /* Pills are an even grid (Format 2-up, Length 3-up) that fills the row,
     each a stacked title + price like the build-a-bundle modal. */
  .theinmag-membership-hero__pills {
    display: grid;
    gap: 8px;
    /* Headroom so the "Best value" chip on the 8-Issue pill clears the
       legend above. */
    margin-top: 7px;
  }
  .theinmag-membership-hero__pills[data-option-name="format"] {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .theinmag-membership-hero__pills[data-option-name="length"] {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .theinmag-membership-hero__pill {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-height: 52px;
    padding: 8px 10px;
    background: #ffffff;
    border: 2px solid var(--color-soft-pink);
    border-radius: var(--radius-lg);
    color: var(--color-inky-purple-navy);
    font-family: var(--font-body);
    cursor: pointer;
    transition: background var(--transition-standard), color var(--transition-standard), border-color var(--transition-standard);
  }
  .theinmag-membership-hero__pill-title {
    font-weight: 600;
    font-size: 14px;
    line-height: 1.2;
  }
  .theinmag-membership-hero__pill-price {
    font-weight: 500;
    font-size: 12.5px;
    line-height: 1.2;
    opacity: 0.82;
  }
  .theinmag-membership-hero__pill-price:empty { display: none; }
  .theinmag-membership-hero__pill:hover { background: rgba(93, 58, 122, 0.07); }
  /* Active state matches the build-a-bundle modal: soft purple tint,
     solid purple border, purple label. Reads premium next to the white
     resting pills and clearly signals selection (grandparents + kids
     need an obvious cue). Border is already 2px so no layout shift. */
  .theinmag-membership-hero__pill[aria-pressed='true'] {
    background: rgba(93, 58, 122, 0.10);
    border-color: var(--color-purple-dark);
    color: var(--color-purple-dark);
  }
  .theinmag-membership-hero__pill[hidden] { display: none; }

  /* "Best value" chip on the 8-Issue length pill (matches the modal). */
  .theinmag-membership-hero__pill-chip {
    position: absolute;
    top: -8px;
    right: 8px;
    background: var(--color-yellow);
    color: var(--color-inky-purple-navy);
    font-weight: 700;
    font-size: 9px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 9999px;
    pointer-events: none;
  }

  /* First-mag row: the pick made in the start picker, shown as a mini
     cover + name + one-line note, with a Change link. Same card register
     as the old starting-issue tiles (white on cream, soft-pink border). */
  .theinmag-membership-hero__first-mag {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #ffffff;
    border: 2px solid var(--color-purple-dark);
    border-radius: 14px;
    padding: 10px 12px;
    margin-bottom: var(--space-md);
  }
  .theinmag-membership-hero__first-mag[hidden] { display: none; }
  .theinmag-membership-hero__first-mag-cover {
    flex: 0 0 auto;
    width: 44px;
    aspect-ratio: 1435 / 1875;
    border-radius: 6px;
    overflow: hidden;
    background: var(--color-lavender);
    box-shadow: 0 1px 4px rgba(42, 31, 61, 0.18);
  }
  .theinmag-membership-hero__first-mag-cover img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .theinmag-membership-hero__first-mag-text {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
    font-family: var(--font-body);
    color: var(--color-inky-purple-navy);
  }
  .theinmag-membership-hero__first-mag-label {
    font-weight: 600;
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.72;
  }
  .theinmag-membership-hero__first-mag-text strong { font-weight: 700; font-size: 15px; line-height: 1.2; }
  .theinmag-membership-hero__first-mag-note { font-weight: 500; font-size: 12.5px; line-height: 1.35; opacity: 0.85; }
  .theinmag-membership-hero__first-mag-change {
    flex: 0 0 auto;
    appearance: none;
    background: transparent;
    border: 1.5px solid var(--color-purple-dark);
    color: var(--color-purple-dark);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 12px;
    padding: 7px 12px;
    min-height: 36px;
    border-radius: var(--radius-pill);
    cursor: pointer;
    transition: background var(--transition-standard), color var(--transition-standard);
  }
  .theinmag-membership-hero__first-mag-change:hover,
  .theinmag-membership-hero__first-mag-change:focus-visible {
    background: var(--color-purple-dark);
    color: #ffffff;
    outline: none;
  }
  .theinmag-membership-hero__start-hint {
    margin: -4px 0 var(--space-md);
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 12.5px;
    line-height: 1.4;
    color: var(--color-inky-purple-navy);
    opacity: 0.72;
  }
  .theinmag-membership-hero__start-hint[hidden] { display: none; }

  /* Digital-only note that replaces the chooser when Format = Digital. */
  .theinmag-membership-hero__start-note {
    margin: 0;
    padding: 12px 16px;
    background: rgba(93, 58, 122, 0.07);
    border: 1.5px solid rgba(93, 58, 122, 0.25);
    border-radius: 16px;
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.45;
    color: var(--color-inky-purple-navy);
  }
  .theinmag-membership-hero__start-note[hidden] { display: none; }

  /* CTA row holds the yellow ADD TO CART + outlined BUY NOW side by side.
     Pattern matches the typical product page (theinmag-single-mags-hero). */
  /* Centred CTA row - yellow Add to cart + outlined Buy now side by side. */
  .theinmag-membership-hero__cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: var(--space-sm) 0 0;
    justify-content: center;
  }

  .theinmag-membership-hero__cta {
    appearance: none;
    flex: 1 1 0;
    min-width: 0;
    max-width: 220px;
    color: var(--color-inky-purple-navy);
    font-family: var(--font-heading);
    font-size: 18px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    padding: 12px 20px;
    border: 0;
    border-radius: var(--radius-button);
    cursor: pointer;
    transition: background var(--transition-standard), color var(--transition-standard), translate var(--transition-standard), box-shadow var(--transition-standard);
  }

  /* Yellow sticker - locked convention for ADD TO CART. */
  .theinmag-membership-hero__cta--primary {
    background: var(--color-yellow);
    box-shadow: var(--shadow-button-yellow);
  }
  .theinmag-membership-hero__cta--primary:hover {
    background: var(--color-purple-dark);
    color: #ffffff;
    translate: 0 2px;
    box-shadow: var(--shadow-button-pressed);
  }

  /* Outlined companion for BUY NOW - inky-purple stroke on the cream
     section bg, fills on hover. */
  .theinmag-membership-hero__cta--secondary {
    background: transparent;
    border: 2px solid var(--color-inky-purple-navy);
    padding: 10px 18px; /* compensate for border so total height matches primary */
  }
  .theinmag-membership-hero__cta--secondary:hover {
    background: var(--color-inky-purple-navy);
    color: var(--color-cream);
    translate: 0 2px;
  }

  .theinmag-membership-hero__microcopy {
    font-family: var(--font-body);
    font-size: 12px;
    line-height: 1.5;
    color: var(--color-inky-purple-navy);
    opacity: 0.78;
    margin: var(--space-sm) 0 0;
    text-align: center;
  }
  /* One-line trust note under the stars. 11px holds the full line at the
     widget's desktop width; it may wrap to two on narrow phones, which
     is fine. */
  .theinmag-membership-hero__trust-line {
    margin: 4px 0 0;
    font-family: var(--font-body);
    font-size: 11px;
    line-height: 1.5;
    color: var(--color-inky-purple-navy);
    opacity: 0.7;
    white-space: nowrap;
  }
  @media (max-width: 989px) {
    .theinmag-membership-hero__trust-line {
      white-space: normal;
    }
  }

  /* Rolling-only billing-timing note (charge on the 1st, issue mid-month).
     Toggled via [data-rolling-only] by the form JS. */
  .theinmag-membership-hero__rolling-note {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--color-inky-purple-navy);
    opacity: 0.9;
    margin: var(--space-sm) 0 0;
    text-align: center;
  }
  .theinmag-membership-hero__rolling-note[hidden] { display: none; }

  /* Mini reviews widget — sits between trust microcopy and the FAQ
     accordions. Bubble visual matches the starting-issue tile style
     (white surface, 2px soft-pink border, radius-lg, body font), arrows
     on the left and right sides of the bubble, body clamped to 3 lines
     with a "Read more" link that scroll-jumps to the main reviews
     section. JS flattens Judge.me's internal carousel wrappers + toggles
     `.is-active` on the visible card. */
  .theinmag-membership-hero__mini-reviews {
    display: flex;
    align-items: stretch;
    gap: 6px;
    margin: var(--space-md) 0 0;
  }
  .theinmag-membership-hero__mini-reviews-bubble {
    flex: 1 1 auto;
    min-width: 0;
    background: #FFFFFF;
    border: 2px solid var(--color-soft-pink);
    border-radius: var(--radius-lg);
    padding: 10px 14px;
    text-align: left;
  }
  .theinmag-membership-hero__mini-reviews-inner {
    min-height: 80px;
  }
  .theinmag-membership-hero__mini-reviews-arrow {
    flex: 0 0 auto;
    width: 24px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-coral-dark);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    border-radius: 4px;
    transition: background-color 0.15s ease, transform 0.1s ease;
  }
  .theinmag-membership-hero__mini-reviews-arrow:hover,
  .theinmag-membership-hero__mini-reviews-arrow:focus-visible {
    background-color: rgba(201, 84, 62, 0.08);
  }
  .theinmag-membership-hero__mini-reviews-arrow:active {
    transform: scale(0.9);
  }
  /* Hide all carousel items except the active one. The JS toggles
     .is-active on the visible item. */
  .theinmag-membership-hero__mini-reviews .jdgm-carousel-item {
    display: none !important;
    width: 100% !important;
    max-width: 100% !important;
    flex: 0 0 100% !important;
    padding: 0 !important;
    margin: 0 !important;
    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
    transform: none !important;
    opacity: 1 !important;
    position: static !important;
  }
  .theinmag-membership-hero__mini-reviews .jdgm-carousel-item.is-active {
    display: block !important;
  }
  .theinmag-membership-hero__mini-reviews .jdgm-carousel-item__review-rating .jdgm-star {
    font-size: 12px;
  }
  .theinmag-membership-hero__mini-reviews .jdgm-carousel-item__review-title {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 13px;
    line-height: 1.3;
    color: var(--color-inky-purple-navy);
    margin: 4px 0 4px;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .theinmag-membership-hero__mini-reviews .jdgm-carousel-item__review-body {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 12px;
    line-height: 1.5;
    color: var(--color-inky-purple-navy);
    opacity: 0.85;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .theinmag-membership-hero__mini-reviews .jdgm-carousel-item__reviewer-name {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 11px;
    color: var(--color-inky-purple-navy);
    margin: 6px 0 0;
  }
  .theinmag-membership-hero__mini-reviews .jdgm-carousel-item__timestamp,
  .theinmag-membership-hero__mini-reviews .jdgm-carousel-item__product-info,
  .theinmag-membership-hero__mini-reviews .jdgm-carousel-item__product-image,
  .theinmag-membership-hero__mini-reviews .jdgm-carousel-item__product,
  .theinmag-membership-hero__mini-reviews .jdgm-carousel__arrows,
  .theinmag-membership-hero__mini-reviews .jdgm-carousel__arrow-left,
  .theinmag-membership-hero__mini-reviews .jdgm-carousel__arrow-right,
  .theinmag-membership-hero__mini-reviews .jdgm-carousel-number-of-reviews,
  .theinmag-membership-hero__mini-reviews .jdgm-carousel-title-and-link,
  .theinmag-membership-hero__mini-reviews .jdgm-carousel-title {
    display: none !important;
  }
  .theinmag-membership-hero__mini-reviews-readmore {
    display: inline-block;
    margin-top: 6px;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    color: var(--color-purple-dark);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .theinmag-membership-hero__mini-reviews-readmore:hover,
  .theinmag-membership-hero__mini-reviews-readmore:focus-visible {
    color: var(--color-coral-dark);
  }

  /* Accordions - small text (Ryan's preference), open one at a time
     pattern handled by the JS. Cancel-anytime accordion has [hidden]
     toggled by JS based on Length=Rolling. */
  .theinmag-membership-hero__accordions {
    list-style: none;
    margin: var(--space-lg) 0 0;
    padding: 0;
    border-top: 1px solid rgba(42, 31, 61, 0.12);
  }
  .theinmag-membership-hero__accordion {
    border-bottom: 1px solid rgba(42, 31, 61, 0.12);
  }
  .theinmag-membership-hero__accordion[hidden] { display: none; }
  .theinmag-membership-hero__acc-q { margin: 0; }
  .theinmag-membership-hero__acc-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    background: transparent;
    border: 0;
    padding: 10px 0;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 13px;
    color: var(--color-inky-purple-navy);
    cursor: pointer;
    text-align: left;
  }
  .theinmag-membership-hero__acc-caret {
    position: relative;
    flex: 0 0 auto;
    width: 14px;
    height: 14px;
  }
  .theinmag-membership-hero__acc-caret::before,
  .theinmag-membership-hero__acc-caret::after {
    content: '';
    position: absolute;
    background: var(--color-inky-purple-navy);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .theinmag-membership-hero__acc-caret::before {
    top: 50%; left: 0; right: 0; height: 2px;
    transform: translateY(-50%);
  }
  .theinmag-membership-hero__acc-caret::after {
    left: 50%; top: 0; bottom: 0; width: 2px;
    transform: translateX(-50%);
  }
  .theinmag-membership-hero__acc-trigger[aria-expanded='true'] .theinmag-membership-hero__acc-caret::after {
    transform: translateX(-50%) scaleY(0);
    opacity: 0;
  }
  .theinmag-membership-hero__acc-panel {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }
  .theinmag-membership-hero__acc-panel[data-open='true'] { max-height: 600px; }
  .theinmag-membership-hero__acc-panel p {
    margin: 0;
    padding: 0 0 var(--space-md);
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-inky-purple-navy);
    opacity: 0.85;
  }

  /* Wait-time tile - lavender-tinted card below the accordions. */
  .theinmag-membership-hero__post-add {
    margin-top: var(--space-lg);
    padding: var(--space-md);
    background-color: rgba(232, 222, 239, 0.7);
    border-radius: var(--radius-lg);
  }
  .theinmag-membership-hero__post-add p {
    margin: 0;
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.55;
    color: var(--color-inky-purple-navy);
  }

  /* Floating order-summary card.
     OUTER (.theinmag-membership-hero__floating-cart) handles fixed
     positioning + the slide-in entry transform when data-show flips
     to "true".
     INNER (.theinmag-membership-hero__floating-cart-card) holds the
     visible cream-card styling + a ridiculously-subtle continuous
     wobble. Splitting outer/inner stops the slide-in transform
     fighting the wobble rotation (single-element transform can only
     hold one animation at a time without smearing). */
  .theinmag-membership-hero__floating-cart {
    position: fixed;
    z-index: 50;
    /* Mobile: bottom-fixed, full-width minus side gutters. */
    left: var(--space-md);
    right: var(--space-md);
    bottom: calc(var(--space-md) + env(safe-area-inset-bottom, 0px));
    /* Slide-in starts above (desktop) or below (mobile) the final
       resting position. Initial opacity 0 + pointer-events none so
       the hidden card never intercepts clicks. */
    opacity: 0;
    transform: translateY(24px);
    pointer-events: none;
    transition: opacity 0.45s ease, transform 0.55s cubic-bezier(0.34, 1.4, 0.64, 1);
    color: var(--color-inky-purple-navy);
    font-family: var(--font-body);
  }
  .theinmag-membership-hero__floating-cart[data-show="true"] {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  @media (min-width: 750px) {
    .theinmag-membership-hero__floating-cart {
      /* Desktop: top-right floating card, well clear of the header. */
      top: clamp(104px, 13vh, 140px);
      right: var(--space-md);
      bottom: auto;
      left: auto;
      width: clamp(220px, 22vw, 260px);
      /* Desktop slides DOWN from above the resting position. */
      transform: translateY(-28px);
    }
    .theinmag-membership-hero__floating-cart[data-show="true"] {
      transform: translateY(0);
    }
  }

  .theinmag-membership-hero__floating-cart-card {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    gap: 10px;
    padding: 12px 14px;
    background-color: rgba(251, 246, 234, 0.96);
    border: 1.5px solid var(--color-soft-pink);
    border-radius: 20px;
    /* Deep shadow so the card reads 3D off the page (Ryan's brief). */
    box-shadow: 0 18px 44px rgba(42, 31, 61, 0.28), 0 4px 12px rgba(42, 31, 61, 0.14);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  @media (min-width: 750px) {
    .theinmag-membership-hero__floating-cart-card {
      flex-direction: column;
      gap: 10px;
      padding: 16px 16px;
      border-radius: 22px;
      /* Ridiculously subtle wobble - tiny rotation + drift, slow loop. */
      animation: theinmag-floating-cart-wobble 5.5s ease-in-out infinite;
      transform-origin: 80% 40%;
    }
  }

  @keyframes theinmag-floating-cart-wobble {
    0%, 100% { transform: rotate(-0.35deg) translateY(0); }
    50% { transform: rotate(0.35deg) translateY(-1.5px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-membership-hero__floating-cart {
      transition: none;
    }
    .theinmag-membership-hero__floating-cart-card {
      animation: none;
    }
  }

  .theinmag-membership-hero__floating-cart-tap {
    appearance: none;
    background: transparent;
    border: 0;
    padding: 0;
    margin: 0;
    text-align: left;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1 1 auto;
    min-width: 0;
    color: inherit;
    font-family: inherit;
    transition: opacity var(--transition-hover);
  }
  .theinmag-membership-hero__floating-cart-tap:hover,
  .theinmag-membership-hero__floating-cart-tap:focus-visible {
    opacity: 0.85;
    outline: none;
  }

  .theinmag-membership-hero__floating-cart-eyebrow {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-soft-pink);
    line-height: 1;
  }
  .theinmag-membership-hero__floating-cart-summary {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-inky-purple-navy);
  }
  .theinmag-membership-hero__floating-cart-issue {
    font-size: 12px;
    font-weight: 400;
    line-height: 1.3;
    color: rgba(42, 31, 61, 0.7);
  }

  .theinmag-membership-hero__floating-cart-cta {
    appearance: none;
    border: 0;
    cursor: pointer;
    background: var(--color-soft-pink);
    color: var(--color-inky-purple-navy);
    font-family: inherit;
    font-weight: 700;
    font-size: 13px;
    padding: 10px 14px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    white-space: nowrap;
    flex-shrink: 0;
    transition: background var(--transition-standard), translate var(--transition-standard);
  }
  .theinmag-membership-hero__floating-cart-cta:hover,
  .theinmag-membership-hero__floating-cart-cta:focus-visible {
    background: var(--color-yellow);
    translate: 0 -1px;
    outline: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-membership-hero__floating-cart-cta:hover { translate: 0 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-membership-hero__cta:hover {
      translate: 0 0;
    }
    .theinmag-membership-hero__cta--primary:hover {
      box-shadow: var(--shadow-button-yellow);
    }
    .theinmag-membership-hero__acc-panel { transition: none; }
  }
{% endstylesheet %}

