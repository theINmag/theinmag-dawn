{% stylesheet %}
  /* Lesson page v3 (2026-11-07). Calm, one ground per series, one mINion, one decoration per screen. */
  .theinmag-video-watch { background: var(--color-cream); color: var(--color-inky-purple-navy); font-family: var(--font-body); }
  .theinmag-video-watch__inner { max-width: 1180px; margin: 0 auto; padding: 0 clamp(16px, 3vw, 32px); position: relative; z-index: 1; }

  /* ---------- band ---------- */
  .theinmag-video-watch__band { position: relative; overflow: hidden; padding: clamp(16px, 2.6vw, 26px) 0 clamp(32px, 4.5vw, 56px); }
  .theinmag-video-watch--picnic .theinmag-video-watch__band { background-color: #2c634f; color: var(--color-cream); }
  .theinmag-video-watch--fieldnotes .theinmag-video-watch__band {
    background-color: #FFD99B;
    background-image: linear-gradient(rgba(251, 246, 234, 0.55), rgba(251, 246, 234, 0.55)), var(--vw-pattern);
    background-size: auto, 640px auto; background-repeat: repeat;
  }
  .theinmag-video-watch__decor {
    position: absolute; z-index: 0; pointer-events: none; background-color: #CFEADB; opacity: 0.85;
    -webkit-mask: var(--decor-mask) center / contain no-repeat; mask: var(--decor-mask) center / contain no-repeat;
    width: clamp(200px, 24vw, 360px); aspect-ratio: 803 / 736; top: -90px; right: -110px;
  }
  /* Opening line: centred Post, says exactly what the video is (registry field 23), a short yellow strip under it in the chips' family. */
  .theinmag-video-watch__opener {
    margin: 0 auto clamp(18px, 2.6vw, 30px); padding: 0 0 14px; max-width: 34ch; text-align: center; position: relative;
    font-family: var(--font-heading); font-weight: 400; font-size: clamp(20px, 2.2vw, 30px); line-height: 1.2; letter-spacing: 0.03em; text-wrap: balance;
    animation: theinmag-video-watch-rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) 0.1s both;
  }
  .theinmag-video-watch__opener::after { content: ""; position: absolute; left: 50%; bottom: 0; width: 64px; height: 6px; transform: translateX(-50%) rotate(-1.2deg); background: var(--color-yellow); }
  .theinmag-video-watch--picnic .theinmag-video-watch__opener { color: var(--color-cream); }
  .theinmag-video-watch--fieldnotes .theinmag-video-watch__opener { color: var(--color-inky-purple-navy); }
  @keyframes theinmag-video-watch-rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .theinmag-video-watch__opener { animation: none; } }
  .theinmag-video-watch__toprow { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; margin: 0 0 clamp(14px, 2vw, 22px); }
  .theinmag-video-watch__crumbs { display: flex; flex-wrap: wrap; gap: 8px; font-size: 14px; font-weight: 600; }
  /* Subscribe link (moved down from the breadcrumb row into the action slot, 10 Nov): the original small link styling. */
  .theinmag-video-watch__sub { font-size: 14px; font-weight: 700; text-underline-offset: 3px; }
  .theinmag-video-watch--picnic .theinmag-video-watch__sub { color: var(--color-yellow); }
  .theinmag-video-watch--fieldnotes .theinmag-video-watch__sub { color: var(--color-purple-dark); }
  .theinmag-video-watch__crumbs a { color: inherit; text-underline-offset: 3px; }

  .theinmag-video-watch__top { display: grid; gap: 16px; grid-template-areas: "head" "player" "act"; }
  .theinmag-video-watch__head { grid-area: head; }
  .theinmag-video-watch__player { grid-area: player; }
  .theinmag-video-watch__act { grid-area: act; }
  .theinmag-video-watch__brandrow { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px; margin: 0 0 14px; }
  .theinmag-video-watch__brand { display: block; margin: 0; }
  @media (min-width: 990px) {
    .theinmag-video-watch__top {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      grid-template-areas: "player head" "player act";
      grid-template-rows: auto 1fr;
      column-gap: clamp(28px, 3.5vw, 52px); row-gap: 14px;
    }
    .theinmag-video-watch__head { align-self: end; }
  }
  /* one row of magazine labels under the subscribe link (Tam, 10 Nov) */
  .theinmag-video-watch__chips { list-style: none; display: flex; flex-direction: row; flex-wrap: wrap; align-items: center; gap: 8px; margin: 2px 0 0; padding: 0; }
  /* magazine-style highlighter strips (Ryan, 7 Nov: like the coloured labels in the mag, not bubbles) */
  .theinmag-video-watch__chips li {
    font-family: var(--font-heading); font-size: 15px; letter-spacing: 0.04em; line-height: 1;
    padding: 6px 10px 5px; color: var(--color-inky-purple-navy); background: var(--color-yellow);
  }
  .theinmag-video-watch__chips li:nth-child(2) { background: var(--color-soft-pink); }
  .theinmag-video-watch__chips li:nth-child(3) { background: var(--color-wave-purple); }
  .theinmag-video-watch__title { margin: 0; font-family: var(--font-heading); font-weight: 400; font-size: clamp(26px, 2.7vw, 38px); line-height: 1.12; text-wrap: balance; color: inherit; }
  .theinmag-video-watch--picnic .theinmag-video-watch__title,
  .theinmag-video-watch--picnic .theinmag-video-watch__lede,
  .theinmag-video-watch--picnic .theinmag-video-watch__crumbs a,
  .theinmag-video-watch--picnic .theinmag-video-watch__small a { color: var(--color-cream); }
  .theinmag-video-watch--fieldnotes .theinmag-video-watch__title { color: var(--color-inky-purple-navy); }
  .theinmag-video-watch__title.is-inter { font-family: var(--font-body); font-weight: 700; letter-spacing: -0.01em; }
  .theinmag-video-watch__player { position: relative; aspect-ratio: 16 / 9; border-radius: 16px; overflow: hidden; background: #000000; box-shadow: 0 10px 26px rgba(20, 14, 30, 0.22); }
  .theinmag-video-watch__player iframe,
  .theinmag-video-watch__poster { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; object-fit: cover; }
  .theinmag-video-watch__soon { position: absolute; inset: auto 0 0 0; display: flex; flex-direction: column; gap: 4px; padding: 64px 24px 20px; background: linear-gradient(to top, rgba(0,0,0,0.78), rgba(0,0,0,0)); color: #FFFFFF; }
  .theinmag-video-watch__soon-big { font-weight: 700; font-size: clamp(18px, 2.4vw, 26px); }
  .theinmag-video-watch__lede { margin: 0 0 16px; font-size: 17px; line-height: 1.55; max-width: 40ch; }
  .theinmag-video-watch__actions { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; margin: 0 0 12px; }
  .theinmag-video-watch__small { margin: 0; font-size: 14px; font-weight: 600; }
  .theinmag-video-watch__small a { color: inherit; text-underline-offset: 3px; }
  .theinmag-video-watch__logo { display: block; height: auto; }
  .theinmag-video-watch__logo img { display: block; width: 100%; height: auto; }
  /* Tam, 10 Nov: logo a size up, and on desktop it floats a little above the video's top line rather than lining up with it */
  .theinmag-video-watch__logo--picnic { width: clamp(132px, 12.5vw, 176px); }
  .theinmag-video-watch__logo--fieldnotes { width: clamp(140px, 13vw, 184px); }
  @media (min-width: 990px) { .theinmag-video-watch__brandrow { margin-top: -26px; } }

  /* ---------- body ---------- */
  .theinmag-video-watch__body { display: grid; gap: clamp(32px, 4vw, 56px); padding-top: clamp(32px, 4.5vw, 56px); padding-bottom: clamp(40px, 6vw, 72px); }
  @media (min-width: 990px) { .theinmag-video-watch__body { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); align-items: start; } }
  /* Talk layout: one reading column, the field notes post under the video */
  @media (min-width: 990px) { .theinmag-video-watch__body--talk { grid-template-columns: minmax(0, 760px); justify-content: start; } }
  /* with a cover: the blog's own treatment. Phone: a 4/5 cover above the words. Desktop: the cover column runs
     the full height of the post and the image inside it is sticky at the top of the screen, filling the screen
     top to bottom while the words scroll beside it (theinmag-article's cover-sticky rules). */
  /* Ryan, 10 Nov: exactly the blog's cover. Full bleed to the left edge of the screen, no gap above it (it
     meets the hero band), square corners, screen-height sticky on desktop. The body breaks out of the
     1180px container to do it; the words keep the container's right-hand padding and reading width. */
  .theinmag-video-watch__body--with-cover { --hero-progress: 0; --hero-darken: 0.3; --color-teal: var(--color-teal-dark, #2D6878); max-width: none; width: 100vw; margin-left: calc(50% - 50vw); padding: 0 0 clamp(40px, 6vw, 72px); row-gap: 0; }
  /* the blog's body padding at every width (theinmag-article__body-col), so the words sit where they do on the blog */
  .theinmag-video-watch__body--with-cover .theinmag-video-watch__main { padding: clamp(40px, 6vw, 96px) clamp(40px, 6vw, 96px) 0 clamp(20px, 4vw, 56px); }
  .theinmag-video-watch__cover-col { background: var(--color-inky-purple-navy); }
  .theinmag-video-watch__cover-sticky { position: relative; width: 100%; aspect-ratio: 4 / 5; overflow: hidden; border-radius: 0; background: var(--color-inky-purple-navy); }
  @media (min-width: 750px) { .theinmag-video-watch__cover-sticky { aspect-ratio: 3 / 4; } }
  /* The blog's cover: darkened at rest, brightening to natural and settling from a 4% zoom as --hero-progress runs 0 to 1 */
  .theinmag-video-watch__cover-image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: brightness(calc(1 - var(--hero-darken) + (var(--hero-progress) * var(--hero-darken)))); transform: scale(calc(1.04 - (var(--hero-progress) * 0.04))); transition: filter 0.05s linear, transform 0.05s linear; transform-origin: center center; will-change: filter, transform; }
  /* The blog's hero overlay: white words on a soft scrim, fading and drifting up as the reader scrolls (theinmag-article__overlay, same numbers) */
  .theinmag-video-watch__overlay { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-start; padding: clamp(24px, 4vw, 56px); color: #FFFFFF; background: linear-gradient(to bottom, rgba(20, 14, 30, 0.55) 0%, rgba(20, 14, 30, 0.18) 45%, rgba(20, 14, 30, 0) 80%); opacity: calc(1 - var(--hero-progress)); transform: translateY(calc(var(--hero-progress) * -32px)) scale(calc(1 + (var(--hero-progress) * 0.04))); transition: opacity 0.05s linear, transform 0.05s linear; transform-origin: left center; pointer-events: none; text-shadow: 0 1px 12px rgba(20, 14, 30, 0.35); will-change: opacity, transform; }
  .theinmag-video-watch__overlay-title { margin: 0 0 clamp(12px, 1.6vw, 20px); font-family: var(--font-body, 'Inter', system-ui, sans-serif); font-weight: 700; font-size: clamp(28px, 4.5vw, 52px); line-height: 1.1; letter-spacing: -0.015em; color: #FFFFFF; max-width: 20ch; }
  .theinmag-video-watch__overlay-topic { font-family: var(--font-body, 'Inter', system-ui, sans-serif); font-weight: 600; font-size: 12px; line-height: 1; letter-spacing: 0.18em; text-transform: uppercase; margin-bottom: clamp(10px, 1.2vw, 14px); opacity: 0.92; }
  .theinmag-video-watch__overlay-byline { margin: 0; font-family: var(--font-body, 'Inter', system-ui, sans-serif); font-weight: 500; font-size: clamp(13px, 1.3vw, 15px); line-height: 1.4; letter-spacing: 0.01em; color: #FFFFFF; opacity: 0.92; max-width: 32ch; }
  .theinmag-video-watch__overlay-role { margin: 4px 0 0; font-family: var(--font-body, 'Inter', system-ui, sans-serif); font-weight: 400; font-size: clamp(12px, 1.15vw, 13px); line-height: 1.4; letter-spacing: 0.01em; color: #FFFFFF; opacity: 0.82; max-width: 32ch; }
  @media (max-width: 989px) { .theinmag-video-watch__cover-col { margin: 0; } }
  @media (min-width: 990px) {
    /* align-items stretch, not start: the sticky child needs its column to run the full height of the row or it has nowhere to travel.
       Two equal columns and the blog's body padding, so the page is the blog page with a video on top. */
    .theinmag-video-watch__body--with-cover { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 0; justify-content: stretch; align-items: stretch; }
    .theinmag-video-watch__body--with-cover .theinmag-video-watch__main { max-width: none; }
    .theinmag-video-watch__cover-col { align-self: stretch; }
    .theinmag-video-watch__cover-sticky { position: sticky; top: 0; height: 100vh; aspect-ratio: auto; border-radius: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .theinmag-video-watch__cover-image { filter: none; transform: none; transition: none; }
    .theinmag-video-watch__overlay { opacity: 1; transform: none; transition: none; }
  }
  @media (prefers-reduced-motion: reduce) and (min-width: 990px) { .theinmag-video-watch__cover-sticky { position: relative; height: auto; aspect-ratio: 3 / 4; } }
  /* The blog's byline row and Quick read card (theinmag-article__byline-row, __quick-read) */
  .theinmag-video-watch__post-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; margin: 0 0 clamp(28px, 3vw, 40px); padding-bottom: clamp(20px, 2.4vw, 28px); border-bottom: 1px solid rgba(42, 31, 61, 0.18); font-family: var(--font-body, 'Inter', system-ui, sans-serif); font-weight: 500; font-size: 13px; line-height: 1.3; color: var(--color-inky-purple-navy); opacity: 0.7; }
  .theinmag-video-watch__post-meta > * + *::before { content: '·'; margin-right: 8px; opacity: 0.6; }
  .theinmag-video-watch__post-topic { text-transform: uppercase; letter-spacing: 0.08em; font-size: 11px; font-weight: 600; color: var(--color-purple-dark); opacity: 1; }
  .theinmag-video-watch__quick { margin: 0 auto clamp(28px, 3vw, 40px); max-width: 84%; padding: clamp(20px, 2.4vw, 28px) clamp(22px, 2.6vw, 32px); background: #FFFFFF; border-radius: 16px; box-shadow: 0 2px 14px rgba(123, 79, 158, 0.10); }
  .theinmag-video-watch__quick-label { display: inline-block; margin-bottom: clamp(8px, 1vw, 12px); font-family: var(--font-body, 'Inter', system-ui, sans-serif); font-weight: 700; font-size: 12px; line-height: 1; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-purple-dark); }
  .theinmag-video-watch__quick-body { font-family: var(--font-body, 'Inter', system-ui, sans-serif); font-weight: 400; font-style: italic; font-size: clamp(13px, 1.2vw, 14px); line-height: 1.55; color: var(--color-inky-purple-navy); }
  .theinmag-video-watch__quick-body p { margin: 0 0 0.6em; }
  .theinmag-video-watch__quick-body p:last-child { margin-bottom: 0; }
  .theinmag-video-watch__lede--talk { max-width: 46ch; font-size: 16px; }
  /* The post reads exactly like the blog (same type rules as theinmag-article__body: Inter throughout, blog sizes, teal links) */
  .theinmag-video-watch__post { margin: 8px 0 36px; }
  .theinmag-video-watch__post-eyebrow { margin: 0 0 6px; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-purple-dark); }
  .theinmag-video-watch__post-title { margin: 0 0 18px; font-family: var(--font-body, 'Inter', system-ui, sans-serif); font-weight: 700; font-size: clamp(22px, 2.2vw, 28px); line-height: 1.2; letter-spacing: -0.01em; color: var(--color-inky-purple-navy); }
  .theinmag-video-watch__post-body { font-family: var(--font-body, 'Inter', system-ui, sans-serif); font-weight: 400; font-size: clamp(14px, 1.2vw, 15px); line-height: 1.65; color: var(--color-inky-purple-navy); }
  .theinmag-video-watch__post-body p { margin: 0 0 1.2em; }
  .theinmag-video-watch__post-body h2 { margin: 1.6em 0 0.6em; font-family: var(--font-body, 'Inter', system-ui, sans-serif); font-weight: 700; font-size: clamp(18px, 1.9vw, 22px); line-height: 1.25; letter-spacing: -0.005em; color: var(--color-inky-purple-navy); }
  .theinmag-video-watch__post-body h3, .theinmag-video-watch__post-body h4 { margin: 1.4em 0 0.5em; font-family: var(--font-body, 'Inter', system-ui, sans-serif); font-weight: 600; font-size: clamp(15px, 1.5vw, 17px); line-height: 1.3; color: var(--color-inky-purple-navy); }
  .theinmag-video-watch__post-body img { display: block; max-width: 100%; height: auto; border-radius: 14px; }
  .theinmag-video-watch__post-body blockquote { margin: 1.4em 0; padding: 4px 0 4px 18px; border-left: 4px solid var(--color-yellow); font-style: normal; }
  .theinmag-video-watch__post-body ul, .theinmag-video-watch__post-body ol { padding-left: 1.3em; margin: 0 0 1.2em; }
  .theinmag-video-watch__post-body a { color: var(--color-teal, var(--color-purple-dark)); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 2px; }
  .theinmag-video-watch__main { max-width: 68ch; }
  .theinmag-video-watch__about { margin: 0 0 36px; }
  .theinmag-video-watch__summary { margin: 0 0 8px; font-size: clamp(18px, 1.8vw, 20px); line-height: 1.6; }
  .theinmag-video-watch__credit { margin: 0; font-size: 15px; font-weight: 600; color: var(--color-purple-dark); }
  .theinmag-video-watch__h2 { font-family: var(--font-heading); font-weight: 400; font-size: clamp(21px, 2.2vw, 26px); line-height: 1.15; margin: 0 0 14px; }

  .theinmag-video-watch__chapters { list-style: none; margin: 0 0 36px; padding: 0 0 0 14px; border-left: 3px dotted rgba(42, 31, 61, 0.25); }
  .theinmag-video-watch__chapters li { margin: 0 0 4px; }
  .theinmag-video-watch__chapter {
    display: flex; align-items: center; gap: 12px; width: 100%; min-height: 44px; padding: 6px 10px; margin-left: -10px;
    border: 0; border-radius: 10px; background: none; color: inherit; font: inherit; font-size: 16px; text-align: left; cursor: pointer;
  }
  .theinmag-video-watch__chapter:hover, .theinmag-video-watch__chapter:focus-visible { background: rgba(249, 194, 60, 0.22); }
  .theinmag-video-watch__chapter:focus-visible { outline: 2px solid var(--color-inky-purple-navy); outline-offset: 2px; }
  .theinmag-video-watch__chapter.is-current { background: rgba(249, 194, 60, 0.32); font-weight: 700; }
  .theinmag-video-watch__time {
    flex: 0 0 auto; min-width: 52px; text-align: center; font-size: 13px; font-weight: 700; font-variant-numeric: tabular-nums;
    padding: 4px 8px; border-radius: 999px; background: none; color: var(--color-inky-purple-navy); border: 1.5px solid currentColor;
  }

  .theinmag-video-watch__pockets { display: grid; gap: 14px; margin: 0 0 40px; }
  @media (min-width: 600px) { .theinmag-video-watch__pockets { grid-template-columns: 1fr 1fr; } }
  .theinmag-video-watch__pocket { border-radius: 16px; padding: 18px 20px; background: #FFFFFF; border: 2px solid var(--color-inky-purple-navy); box-shadow: 4px 4px 0 var(--color-inky-purple-navy); }
  .theinmag-video-watch__pocket--cruising { box-shadow: 4px 4px 0 var(--color-sage-dark); border-color: var(--color-sage-dark); }
  .theinmag-video-watch__pocket-label { margin: 0 0 6px; font-size: 13px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-purple-dark); }
  .theinmag-video-watch__pocket--cruising .theinmag-video-watch__pocket-label { color: #3F6B4F; }
  .theinmag-video-watch__h2--pocket span { display: block; margin-top: 4px; font-size: 0.62em; color: var(--color-purple-dark); }
  .theinmag-video-watch__pocket-qs { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .theinmag-video-watch__pocket-qs li { font-size: 17px; font-weight: 700; line-height: 1.35; }
  .theinmag-video-watch__pocket-qs li + li { padding-top: 10px; border-top: 1px dashed rgba(42, 31, 61, 0.25); }
  .theinmag-video-watch__pocket-more { margin: -24px 0 40px; font-size: 15px; }

  .theinmag-video-watch__intask { position: relative; margin: 0 0 32px; padding: 24px 24px 22px; border-radius: 20px; background: var(--color-lavender); }
  /* mINion sits inside the tile at top right and the text wraps around it (Ryan, 10 Nov: into the space, and no big gap under the heading) */
  .theinmag-video-watch__intask-minion { float: right; width: 78px; margin: -4px 0 10px 16px; shape-outside: margin-box; }
  .theinmag-video-watch__intask-minion img { display: block; width: 100%; height: auto; transform: rotate(6deg); filter: drop-shadow(0 4px 6px rgba(42, 31, 61, 0.2)); }
  .theinmag-video-watch__intask-h { margin: 0 0 14px; font-family: var(--font-heading); font-weight: 400; font-size: clamp(21px, 2.2vw, 26px); line-height: 1.15; color: var(--color-inky-purple-navy); }
  .theinmag-video-watch__pillars { margin: 0 0 14px; display: grid; gap: 12px; }
  .theinmag-video-watch__pillars dt { font-weight: 700; font-size: 16px; margin: 0 0 2px; }
  .theinmag-video-watch__pillars dd { margin: 0; font-size: 16px; line-height: 1.55; }
  .theinmag-video-watch__textlink { font-weight: 700; color: var(--color-inky-purple-navy); text-underline-offset: 4px; }

  .theinmag-video-watch__fold { border-top: 1px solid rgba(42, 31, 61, 0.14); }
  .theinmag-video-watch__fold:last-of-type { border-bottom: 1px solid rgba(42, 31, 61, 0.14); }
  .theinmag-video-watch__fold summary { cursor: pointer; font-weight: 700; font-size: 16px; padding: 14px 0; min-height: 44px; }
  .theinmag-video-watch__fold-body { font-size: 16px; line-height: 1.7; padding-bottom: 14px; }

  .theinmag-video-watch__runit { border-radius: 20px; padding: 22px 22px 20px; background: #FFFFFF; box-shadow: 0 2px 14px rgba(42, 31, 61, 0.08); }
  .theinmag-video-watch__runit-h { margin: 0 0 12px; font-family: var(--font-heading); font-weight: 400; font-size: 24px; }
  .theinmag-video-watch__runit-label { margin: 0 0 8px; font-size: 13px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-purple-dark); }
  .theinmag-video-watch__needs { list-style: none; margin: 0 0 18px; padding: 0; }
  .theinmag-video-watch__needs li { position: relative; padding: 0 0 0 26px; margin: 0 0 9px; font-size: 15px; line-height: 1.5; }
  .theinmag-video-watch__needs li { padding-left: 20px; }
  .theinmag-video-watch__needs li::before { content: ""; position: absolute; left: 4px; top: 0.55em; width: 8px; height: 8px; border-radius: 50%; background: var(--color-yellow); box-shadow: 0 0 0 2px var(--color-inky-purple-navy); }
  .theinmag-video-watch__runit-btn { width: 100%; justify-content: center; text-align: center; }
  .theinmag-video-watch__runit-email { margin: 14px 0 0; font-size: 14px; font-weight: 600; }
  .theinmag-video-watch__runit-email a { color: var(--color-inky-purple-navy); text-underline-offset: 3px; }
  @media (min-width: 990px) { .theinmag-video-watch__side { position: sticky; top: 120px; } }
{% endstylesheet %}

{% schema %}
{
