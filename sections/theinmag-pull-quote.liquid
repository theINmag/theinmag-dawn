{%- comment -%}
  theinmag-pull-quote
  Full-bleed editorial pull quote on a photo background. Maude-style:
  big white sans on a rich dark photo with a soft scrim so the type
  always passes contrast. Lives between Meet Tam and Reviews on the
  homepage as a social-proof break before the review wall.

  Font default: Inter 700 (editorial / journalistic register, same
  family used on field-notes post titles). Schema toggle lets the
  admin flip to Post Regular for a brand-voice moment.

  Attribution renders as: hyphen + space + name + comma + role. Brand
  rule: hyphens only, never em dashes.
{%- endcomment -%}

{%- liquid
  assign bg_filename = section.settings.background_filename
  assign bg_src = ''
  if bg_filename != blank
    assign bg_src = bg_filename | asset_url
  endif

  assign quote_body = section.settings.quote_body
  assign attribution_name = section.settings.attribution_name
  assign attribution_role = section.settings.attribution_role

  assign heading_font_style = section.settings.heading_font_style | default: 'inter'
  assign scrim_opacity = section.settings.scrim_opacity | default: 45
  assign scrim_decimal = scrim_opacity | times: 0.01

  assign pad_top = section.settings.padding_top | default: 128
  assign pad_bottom = section.settings.padding_bottom | default: 128
-%}

<section
  class="theinmag-pull-quote theinmag-pull-quote--font-{{ heading_font_style }}"
  style="
    --pq-bg: url('{{ bg_src }}');
    --pq-scrim: rgba(20, 14, 30, {{ scrim_decimal }});
    --pq-pt: {{ pad_top }}px;
    --pq-pb: {{ pad_bottom }}px;
  "
  aria-label="Reader quote"
>
  <div class="theinmag-pull-quote__inner">
    <blockquote class="theinmag-pull-quote__quote">
      <p class="theinmag-pull-quote__body">&ldquo;{{ quote_body }}&rdquo;</p>
      {%- if attribution_name != blank -%}
        <footer class="theinmag-pull-quote__attribution">
          <span aria-hidden="true">- </span>{{ attribution_name }}{%- if attribution_role != blank -%}, {{ attribution_role }}{%- endif -%}
        </footer>
      {%- endif -%}
    </blockquote>
  </div>
</section>

{%- stylesheet -%}
  .theinmag-pull-quote {
    position: relative;
    isolation: isolate;
    background-color: #2A1F3D;
    background-image: var(--pq-bg);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    padding: var(--pq-pt) clamp(20px, 5vw, 64px) var(--pq-pb);
    overflow: hidden;
  }

  .theinmag-pull-quote::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--pq-scrim, rgba(20, 14, 30, 0.45));
    z-index: 0;
  }

  .theinmag-pull-quote__inner {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    margin: 0 auto;
    text-align: center;
  }

  .theinmag-pull-quote__quote {
    margin: 0;
    padding: 0;
    border: 0;
    color: inherit;
    font-style: normal;
  }

  .theinmag-pull-quote__body {
    margin: 0;
    color: #FFFFFF;
    font-weight: 700;
    font-style: normal;
    font-size: clamp(22px, 3.2vw, 44px);
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-wrap: balance;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.35);
  }

  .theinmag-pull-quote--font-inter .theinmag-pull-quote__body {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
  }

  .theinmag-pull-quote--font-post .theinmag-pull-quote__body {
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.12;
  }

  .theinmag-pull-quote__attribution {
    margin-top: clamp(20px, 2.4vw, 32px);
    color: #FFFFFF;
    opacity: 0.82;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 500;
    font-size: clamp(13px, 1.2vw, 15px);
    line-height: 1.4;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: no-preference) {
    .theinmag-pull-quote__body,
    .theinmag-pull-quote__attribution {
      opacity: 0;
      transform: translateY(12px);
      animation: theinmag-pull-quote-fade 0.7s ease-out forwards;
    }
    .theinmag-pull-quote__attribution {
      animation-delay: 0.18s;
      opacity: 0;
    }
  }

  @keyframes theinmag-pull-quote-fade {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-pull-quote__body {
      opacity: 1;
      transform: none;
      animation: none;
    }
    .theinmag-pull-quote__attribution {
      opacity: 0.82;
      transform: none;
      animation: none;
    }
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "theINmag pull quote",
  "tag": "section",
  "class": "shopify-section--theinmag-pull-quote",
  "settings": [
    {
      "type": "header",
      "content": "Quote"
    },
    {
      "type": "textarea",
      "id": "quote_body",
      "label": "Quote body",
      "info": "Smart curly quotes are added automatically. No em dashes - hyphens only.",
      "default": "Thank you so much for creating an incredibly diverse, interesting, thoughtful, creative, fun, engaging magazine for our incredibly wonderful children. I'm so proud of what your team has created. My kids are going to absolutely FIZZZZZ."
    },
    {
      "type": "text",
      "id": "attribution_name",
      "label": "Attribution name",
      "default": "Brooke B."
    },
    {
      "type": "text",
      "id": "attribution_role",
      "label": "Attribution role",
      "default": "parent"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "text",
      "id": "background_filename",
      "label": "Background image filename",
      "default": "theinside-homepage-background.jpg"
    },
    {
      "type": "range",
      "id": "scrim_opacity",
      "label": "Scrim darkness",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "heading_font_style",
      "label": "Quote font",
      "options": [
        { "value": "inter", "label": "Inter 700 (editorial)" },
        { "value": "post", "label": "Post Regular (brand voice)" }
      ],
      "default": "inter"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 40,
      "max": 240,
      "step": 8,
      "unit": "px",
      "default": 128
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 40,
      "max": 240,
      "step": 8,
      "unit": "px",
      "default": 128
    }
  ],
  "presets": [
    {
      "name": "Pull quote"
    }
  ]
}
{% endschema %}
