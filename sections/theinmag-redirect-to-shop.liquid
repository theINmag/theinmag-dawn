{%- comment -%}
  theinmag-redirect-to-shop
  Bounces /collections/all to /pages/shop.

  Two failure modes Shopify exhibits that this works around:
    1. templates/collection.all.json overrides are silently ignored
       for the synthetic /collections/all (no real Collection object
       with handle "all" exists in admin).
    2. Shopify admin URL redirects only fire on 404s, not on
       URLs that Shopify natively serves like /collections/all.

  So the fix is to add THIS section to the default
  templates/collection.json (which DOES run on /collections/all) and
  gate the redirect output on collection.handle == 'all' or the URL
  path. On any other collection page the section renders nothing -
  zero-cost on the 99% of collection requests that aren't /all.

  Belt-and-braces: meta refresh (no-JS), JS redirect (modern browsers),
  visible message (slow connections / search engines).
{%- endcomment -%}

{%- liquid
  assign destination = section.settings.destination | default: '/pages/shop'
  assign should_redirect = false
  if collection.handle == 'all'
    assign should_redirect = true
  endif
  assign current_path = request.path | default: ''
  if current_path == '/collections/all'
    assign should_redirect = true
  endif
-%}

{%- if should_redirect -%}
<meta http-equiv="refresh" content="0; url={{ destination }}">
<link rel="canonical" href="{{ destination }}">

<div class="theinmag-redirect-to-shop" role="status" aria-live="polite">
  <p class="theinmag-redirect-to-shop__body">
    Taking you to <a href="{{ destination }}">the shop</a>...
  </p>
</div>

<script>
  window.location.replace({{ destination | json }});
</script>
{%- endif -%}

{%- stylesheet -%}
  .theinmag-redirect-to-shop {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(40px, 8vw, 80px) clamp(16px, 4vw, 32px);
    background-color: var(--color-cream, #FBF6EA);
    color: var(--color-inky-purple-navy, #2A1F3D);
    text-align: center;
  }
  .theinmag-redirect-to-shop__body {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-size: clamp(16px, 1.6vw, 18px);
    line-height: 1.5;
    margin: 0;
  }
  .theinmag-redirect-to-shop__body a {
    color: var(--color-purple-dark, #5D3A7A);
    text-decoration: underline;
    font-weight: 600;
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "theINmag Redirect to shop",
  "tag": "section",
  "class": "theinmag-redirect-to-shop-section",
  "settings": [
    {
      "type": "text",
      "id": "destination",
      "label": "Destination URL",
      "default": "/pages/shop"
    }
  ]
}
{% endschema %}
