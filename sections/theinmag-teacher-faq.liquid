{%- comment -%}
  theinmag-teacher-faq
  Teacher-targeted FAQ accordion for /pages/for-teachers. Built as a
  single-open accordion with FAQPage JSON-LD structured data so the
  Q&As surface as Google rich results.

  Layout: centred heading + narrow column (max 900px) so the answers
  read in an editorial column width. Section bg = peach-light tint
  (matches curriculum-accordion bg for visual continuity).

  Behaviour: only one item open at a time; first item open by default;
  reduced-motion users get an instant snap.

  Hyphens only, never em or en dashes.
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading | default: 'Teacher questions, answered.'
  assign subhead = section.settings.subhead | default: 'The stuff teachers actually ask us.'
  assign compact = section.settings.compact
  assign show_character = section.settings.show_character

  assign bg_image_filename = section.settings.bg_image_filename
  assign bg_image_opacity = section.settings.bg_image_opacity | default: 30
  assign bg_image_opacity_decimal = bg_image_opacity | times: 1.0 | divided_by: 100.0

  comment
    Token substitution: writers can use [[CONSENT_PDF]] in answer
    richtext as a stable placeholder; the section resolves it to
    the live theme asset URL at render time. Keeps the FAQ content
    portable - no hardcoded CDN paths to rot.
  endcomment
  assign consent_pdf_url = 'teachers_consentform.pdf' | asset_url
-%}

<section
  class="theinmag-teacher-faq{% if compact %} theinmag-teacher-faq--compact{% endif %}"
  aria-labelledby="theinmag-teacher-faq-heading-{{ section.id }}"
  style="--tfaq-bg-opacity: {{ bg_image_opacity_decimal }};{% if bg_image_filename != blank %} --tfaq-bg-image: url('{{ bg_image_filename | asset_url }}');{% endif %}"
>
  {%- if bg_image_filename != blank -%}
    <div class="theinmag-teacher-faq__bg-image" aria-hidden="true"></div>
  {%- endif -%}

  <div class="theinmag-teacher-faq__inner">

    <header class="theinmag-teacher-faq__header">
      {%- if show_character -%}
        {% render 'theinmag-character-pool' %}
        <span class="theinmag-teacher-faq__character" data-theinmag-pool-character aria-hidden="true"></span>
      {%- endif -%}

      {%- if heading != blank -%}
        <h2
          id="theinmag-teacher-faq-heading-{{ section.id }}"
          class="theinmag-teacher-faq__heading"
        >
          {{ heading }}
        </h2>
      {%- endif -%}

      {%- if subhead != blank -%}
        <p class="theinmag-teacher-faq__subhead">{{ subhead }}</p>
      {%- endif -%}
    </header>

    <ul class="theinmag-teacher-faq__list" role="list" data-theinmag-teacher-faq>
      {%- for block in section.blocks -%}
        {%- if block.type == 'item' -%}
          {%- liquid
            assign panel_id = 'theinmag-teacher-faq-panel-' | append: section.id | append: '-' | append: forloop.index0
            assign trigger_id = 'theinmag-teacher-faq-trigger-' | append: section.id | append: '-' | append: forloop.index0
            comment
              All items default to closed. Teachers can pick the
              question that matters to them - no item is opinionated
              enough to deserve being open on load.
            endcomment
            assign is_open_str = 'false'
            assign aria_expanded = 'false'
          -%}
          <li
            class="theinmag-teacher-faq__item"
            data-theinmag-faq-item
            data-open="{{ is_open_str }}"
            {{ block.shopify_attributes }}
          >
            <button
              type="button"
              class="theinmag-teacher-faq__trigger"
              data-theinmag-faq-trigger
              id="{{ trigger_id }}"
              aria-expanded="{{ aria_expanded }}"
              aria-controls="{{ panel_id }}"
            >
              <span class="theinmag-teacher-faq__question">{{ block.settings.question }}</span>
              <svg class="theinmag-teacher-faq__plus" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <line x1="8" y1="2" x2="8" y2="14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                <line x1="2" y1="8" x2="14" y2="8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </button>

            <div
              class="theinmag-teacher-faq__panel"
              data-theinmag-faq-panel
              id="{{ panel_id }}"
              role="region"
              aria-labelledby="{{ trigger_id }}"
            >
              <div class="theinmag-teacher-faq__answer">
                {{ block.settings.answer | replace: '[[CONSENT_PDF]]', consent_pdf_url }}
              </div>
            </div>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{%- comment -%}
  FAQPage JSON-LD. Plain text only (strip_html removes any richtext
  formatting). Each item's question + answer becomes a Q&A pair.
  Schema.org FAQPage spec - used by Google for FAQ rich results.
{%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- assign item_count = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'item' -%}
        {%- if item_count > 0 -%},{%- endif -%}
        {
          "@type": "Question",
          "name": {{ block.settings.question | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ block.settings.answer | replace: '[[CONSENT_PDF]]', consent_pdf_url | strip_html | strip_newlines | json }}
          }
        }
        {%- assign item_count = item_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  ]
}
</script>

<script>
(function () {
  var roots = document.querySelectorAll('[data-theinmag-teacher-faq]');
  if (!roots.length) return;

  function prefersReducedMotion() {
    return window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function setItemState(item, open) {
    var trigger = item.querySelector('[data-theinmag-faq-trigger]');
    var panel = item.querySelector('[data-theinmag-faq-panel]');
    if (!trigger || !panel) return;

    if (open) {
      item.setAttribute('data-open', 'true');
      trigger.setAttribute('aria-expanded', 'true');
      panel.style.maxHeight = prefersReducedMotion() ? 'none' : panel.scrollHeight + 'px';
    } else {
      item.setAttribute('data-open', 'false');
      trigger.setAttribute('aria-expanded', 'false');
      panel.style.maxHeight = '';
    }
  }

  Array.prototype.forEach.call(roots, function (root) {
    var items = Array.prototype.slice.call(root.querySelectorAll('[data-theinmag-faq-item]'));
    if (!items.length) return;

    items.forEach(function (item) {
      setItemState(item, item.getAttribute('data-open') === 'true');
    });

    root.addEventListener('click', function (event) {
      var trigger = event.target.closest('[data-theinmag-faq-trigger]');
      if (!trigger || !root.contains(trigger)) return;
      var item = trigger.closest('[data-theinmag-faq-item]');
      if (!item) return;
      var wasOpen = item.getAttribute('data-open') === 'true';
      items.forEach(function (other) { setItemState(other, false); });
      if (!wasOpen) setItemState(item, true);
    });

    var raf = null;
    window.addEventListener('resize', function () {
      if (raf) cancelAnimationFrame(raf);
      raf = requestAnimationFrame(function () {
        items.forEach(function (item) {
          if (item.getAttribute('data-open') === 'true') {
            var panel = item.querySelector('[data-theinmag-faq-panel]');
            if (panel && !prefersReducedMotion()) {
              panel.style.maxHeight = panel.scrollHeight + 'px';
            }
          }
        });
      });
    });
  });
})();
</script>

{% stylesheet %}
  .theinmag-teacher-faq {
    position: relative;
    background-color: #FDECD0;
    padding: clamp(64px, 10vw, 120px) clamp(20px, 5vw, 64px);
    overflow: hidden;
  }

  /* Full-bleed bg image. 2-class selector beats Dawn's
     `div:empty { display: none }` (base.css) which would otherwise
     collapse this decoration-only div. */
  .theinmag-teacher-faq .theinmag-teacher-faq__bg-image {
    display: block;
    position: absolute;
    inset: 0;
    background-image: var(--tfaq-bg-image);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: var(--tfaq-bg-opacity, 0.3);
    pointer-events: none;
    z-index: 0;
  }

  .theinmag-teacher-faq__inner {
    position: relative;
    z-index: 1;
    max-width: 900px;
    margin: 0 auto;
  }

  .theinmag-teacher-faq__header {
    position: relative;
    text-align: center;
    margin-bottom: clamp(48px, 6vw, 80px);
  }

  /* Kid character to the left of the centred heading. Bigger than the
     standard pool character, pops in from the left on scroll. Hidden on
     mobile so it never clashes with the centred heading. */
  .theinmag-teacher-faq__character {
    position: absolute;
    top: clamp(-44px, -2.5vw, -16px);
    left: clamp(0px, 3vw, 56px);
    width: clamp(120px, 13vw, 180px);
    height: auto;
    z-index: 3;
    transform: translateX(-32px) rotate(-7deg);
  }

  .theinmag-teacher-faq__character.is-popped {
    transform: translateX(0) rotate(-7deg);
  }

  @media (max-width: 767px) {
    .theinmag-teacher-faq__character {
      display: none;
    }
  }

  .theinmag-teacher-faq__heading {
    margin: 0;
    font-family: var(--font-heading, 'Post Regular', serif);
    font-weight: 400;
    font-size: clamp(32px, 5vw, 48px);
    line-height: 1.1;
    color: var(--color-text, #2A1F3D);
  }

  .theinmag-teacher-faq__subhead {
    /* Matches the Inter 700 editorial subhead register used elsewhere
       on the page (Competitions heading, curriculum-accordion subhead).
       Caveat is deliberately not used here - reserved for field-notes
       author signatures only. */
    margin: clamp(10px, 1.4vw, 16px) 0 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: clamp(20px, 2.4vw, 26px);
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--color-text, #2A1F3D);
  }

  /* Compact variant - tighter top/bottom space, smaller header gap and a
     lighter, smaller subhead. Opt-in per page so the teachers FAQ keeps
     its roomier default. */
  .theinmag-teacher-faq--compact {
    padding-top: clamp(36px, 5vw, 64px);
    padding-bottom: clamp(36px, 5vw, 64px);
  }

  .theinmag-teacher-faq--compact .theinmag-teacher-faq__header {
    margin-bottom: clamp(24px, 3vw, 40px);
  }

  .theinmag-teacher-faq--compact .theinmag-teacher-faq__subhead {
    font-weight: 500;
    font-size: clamp(15px, 1.7vw, 18px);
    line-height: 1.5;
    color: rgba(42, 31, 61, 0.78);
  }

  .theinmag-teacher-faq__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .theinmag-teacher-faq__item {
    background-color: var(--color-cream, #FBF6EA);
    border: 1px solid rgba(123, 79, 158, 0.15);
    border-radius: var(--radius-sm, 6px);
    overflow: hidden;
    transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .theinmag-teacher-faq__item:hover:not([data-open="true"]) {
    background-color: #FDECD0;
    transform: translateY(-2px);
  }

  .theinmag-teacher-faq__item[data-open="true"] {
    background-color: #ffffff;
    border-color: rgba(123, 79, 158, 0.4);
  }

  .theinmag-teacher-faq__trigger {
    display: flex;
    align-items: center;
    gap: 16px;
    width: 100%;
    padding: 16px 20px;
    min-height: 64px;
    background: transparent;
    border: none;
    color: inherit;
    text-align: left;
    cursor: pointer;
    font: inherit;
  }

  @media (min-width: 600px) {
    .theinmag-teacher-faq__trigger {
      padding: 20px 24px;
      min-height: 72px;
    }
  }

  .theinmag-teacher-faq__question {
    flex: 1 1 auto;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: clamp(16px, 1.8vw, 18px);
    line-height: 1.4;
    color: var(--color-text, #2A1F3D);
  }

  .theinmag-teacher-faq__plus {
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
    color: var(--color-purple-dark, #5D3A7A);
    transition: transform 0.25s ease;
  }

  .theinmag-teacher-faq__item[data-open="true"] .theinmag-teacher-faq__plus {
    transform: rotate(45deg);
  }

  .theinmag-teacher-faq__panel {
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.4s ease;
  }

  .theinmag-teacher-faq__answer {
    padding: 4px 20px 20px;
    opacity: 0;
    transition: opacity 0.3s ease 0.1s;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-text, #2A1F3D);
  }

  @media (min-width: 600px) {
    .theinmag-teacher-faq__answer {
      padding: 4px 24px 24px;
    }
  }

  .theinmag-teacher-faq__item[data-open="true"] .theinmag-teacher-faq__answer {
    opacity: 1;
  }

  .theinmag-teacher-faq__answer p {
    margin: 0 0 12px;
  }

  .theinmag-teacher-faq__answer p:last-child {
    margin-bottom: 0;
  }

  .theinmag-teacher-faq__answer ul,
  .theinmag-teacher-faq__answer ol {
    margin: 0 0 12px;
    padding-left: 20px;
  }

  .theinmag-teacher-faq__answer li {
    margin-bottom: 6px;
  }

  .theinmag-teacher-faq__answer a {
    color: var(--color-purple-dark, #5D3A7A);
    text-decoration: underline;
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-teacher-faq__item,
    .theinmag-teacher-faq__plus,
    .theinmag-teacher-faq__panel,
    .theinmag-teacher-faq__answer {
      transition: none;
    }
    .theinmag-teacher-faq__item:hover {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Teacher FAQ",
  "tag": "section",
  "class": "theinmag-teacher-faq-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "paragraph",
      "content": "Single-open FAQ accordion with FAQPage JSON-LD structured data for Google rich results. First item opens on load."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Teacher questions, answered."
    },
    {
      "type": "text",
      "id": "subhead",
      "label": "Subhead",
      "default": "The stuff teachers actually ask us."
    },
    {
      "type": "checkbox",
      "id": "compact",
      "label": "Compact spacing + smaller subhead",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_character",
      "label": "Show kid character left of the heading",
      "info": "Random kid character pops in to the left of the heading (desktop only).",
      "default": false
    },
    {
      "type": "header",
      "content": "Background image"
    },
    {
      "type": "text",
      "id": "bg_image_filename",
      "label": "Background image filename in /assets/",
      "info": "Optional full-bleed image behind the FAQ cards. Leave blank for plain peach-light bg."
    },
    {
      "type": "range",
      "id": "bg_image_opacity",
      "label": "Background image opacity (%)",
      "info": "Lower = more peach shows through, higher = image dominates.",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Teacher FAQ"
    }
  ]
}
{% endschema %}
