{%- comment -%}
  theinmag-hero (v2)
  Homepage above-the-fold hero. Maude exact pattern.
  - Two paired images side-by-side on desktop, stacked on mobile.
  - All text + CTAs sit on the LEFT image only. Right image is photography-only.
  - White text, left-aligned, lower-left third of the left image.
  - Dark gradient scrim ensures WCAG AA contrast regardless of photo brightness.
  - Trust micro-bar full-width strip below uses peach pair (homepage accent).
  - Mobile-first. No em dashes. Custom properties only.
  Spec: homepage-build-spec.md Section 1.
{%- endcomment -%}

{%- assign image_left = section.settings.image_left -%}
{%- assign image_right = section.settings.image_right -%}
{%- assign image_left_alt = section.settings.image_left_alt | default: 'An Australian child reading theINmag, the magazine for creative kids.' -%}
{%- assign image_right_alt = section.settings.image_right_alt | default: 'A creation by an Australian kid published in theINmag.' -%}

{%- comment -%}
  Wrap the emphasis word with a span so it renders slightly larger.
  Case-sensitive match - if the word appears in the headline it gets
  the bump; otherwise the headline renders as-is.
{%- endcomment -%}
{%- assign headline_html = section.settings.headline -%}
{%- assign emphasis = section.settings.emphasis_word -%}
{%- if emphasis != blank and headline_html contains emphasis -%}
  {%- capture emphasis_wrap -%}<span class="theinmag-hero__headline-emphasis">{{ emphasis }}</span>{%- endcapture -%}
  {%- assign headline_html = headline_html | replace: emphasis, emphasis_wrap -%}
{%- endif -%}

{%- comment -%}
  Wrap "no ads, just creativity" in a nowrap span. When the subhead
  doesn't fit on a single line (mobile), the whole clause stays
  together and wraps to line 2 - putting the break before "no"
  rather than the natural break between "no" and "ads".
{%- endcomment -%}
{%- assign subhead_html = section.settings.subhead -%}
{%- assign subhead_clause = 'no ads, just creativity' -%}
{%- if subhead_html contains subhead_clause -%}
  {%- capture clause_wrap -%}<span class="theinmag-hero__subhead-clause">{{ subhead_clause }}</span>{%- endcapture -%}
  {%- assign subhead_html = subhead_html | replace: subhead_clause, clause_wrap -%}
{%- endif -%}

<section
  class="theinmag-hero"
  aria-labelledby="theinmag-hero-headline-{{ section.id }}"
>
  <div class="theinmag-hero__split">

    {%- comment -%}
      LEFT pane - kid reading photo. Hidden on mobile (artwork is the
      only image at smaller viewports). Carries the gradient scrim
      that boosts text contrast on desktop.
    {%- endcomment -%}
    <div class="theinmag-hero__pane theinmag-hero__pane--left">
      {%- if image_left != blank -%}
        <img
          class="theinmag-hero__image"
          src="{{ image_left | image_url: width: 1600 }}"
          srcset="
            {{ image_left | image_url: width: 600 }} 600w,
            {{ image_left | image_url: width: 900 }} 900w,
            {{ image_left | image_url: width: 1200 }} 1200w,
            {{ image_left | image_url: width: 1600 }} 1600w,
            {{ image_left | image_url: width: 2000 }} 2000w
          "
          sizes="(min-width: 990px) 50vw, 0px"
          width="{{ image_left.width }}"
          height="{{ image_left.height }}"
          alt="{{ image_left_alt | escape }}"
          loading="eager"
          fetchpriority="high"
        >
      {%- else -%}
        <img
          class="theinmag-hero__image"
          src="{{ 'HERO_kid-reading-mag.jpg' | asset_url }}"
          alt="{{ image_left_alt | escape }}"
          loading="eager"
          fetchpriority="high"
        >
      {%- endif -%}

      <div class="theinmag-hero__scrim" aria-hidden="true"></div>
    </div>

    {%- comment -%}
      RIGHT pane - kid creation artwork. Visible at every viewport.
      Carries its own scrim that activates on mobile when the artwork
      is the sole image and content overlays it.
    {%- endcomment -%}
    <div class="theinmag-hero__pane theinmag-hero__pane--right">
      {%- if image_right != blank -%}
        <img
          class="theinmag-hero__image"
          src="{{ image_right | image_url: width: 1600 }}"
          srcset="
            {{ image_right | image_url: width: 600 }} 600w,
            {{ image_right | image_url: width: 900 }} 900w,
            {{ image_right | image_url: width: 1200 }} 1200w,
            {{ image_right | image_url: width: 1600 }} 1600w,
            {{ image_right | image_url: width: 2000 }} 2000w
          "
          sizes="(min-width: 990px) 50vw, 100vw"
          width="{{ image_right.width }}"
          height="{{ image_right.height }}"
          alt="{{ image_right_alt | escape }}"
          loading="eager"
        >
      {%- else -%}
        <img
          class="theinmag-hero__image"
          src="{{ 'HERO_kid-creation-art.jpg' | asset_url }}"
          alt="{{ image_right_alt | escape }}"
          loading="eager"
        >
      {%- endif -%}

      <div class="theinmag-hero__scrim" aria-hidden="true"></div>
    </div>

    {%- comment -%}
      Content (H1, subhead, CTAs) lives at the split level, not inside
      a pane. On desktop it overlays the LEFT pane (kid reading photo).
      On mobile - where the LEFT pane is hidden - it overlays the
      RIGHT pane (artwork). One DOM element, two layouts.
    {%- endcomment -%}
    <div class="theinmag-hero__content">
      <h1
        class="theinmag-hero__headline"
        id="theinmag-hero-headline-{{ section.id }}"
      >
        {{ headline_html }}
      </h1>

      {%- if subhead_html != blank -%}
        <p class="theinmag-hero__subhead">
          {{ subhead_html }}
        </p>
      {%- endif -%}

      {%- comment -%}
        Visual classes deliberately swapped vs the cta_primary/secondary
        setting names: FIRST button (Membership) renders outlined white,
        SECOND button (Send IN content) renders as the yellow stamp.
        Yellow draws attention to the playful, lower-friction action.
      {%- endcomment -%}
      <div class="theinmag-hero__ctas">
        {%- if section.settings.cta_primary_label != blank -%}
          <a
            class="theinmag-btn theinmag-btn--secondary-on-image"
            href="{{ section.settings.cta_primary_link | default: '#' }}"
          >
            {{- section.settings.cta_primary_label -}}
          </a>
        {%- endif -%}
        {%- if section.settings.cta_secondary_label != blank -%}
          <a
            class="theinmag-btn theinmag-btn--primary"
            href="{{ section.settings.cta_secondary_link | default: '#' }}"
          >
            {{- section.settings.cta_secondary_label -}}
          </a>
        {%- endif -%}
      </div>
    </div>

  </div>

  {%- if section.settings.show_trust_bar -%}
    <ul class="theinmag-hero__trust" role="list">
      {%- if section.settings.trust_1 != blank -%}<li>{{ section.settings.trust_1 }}</li>{%- endif -%}
      {%- if section.settings.trust_2 != blank -%}<li>{{ section.settings.trust_2 }}</li>{%- endif -%}
      {%- if section.settings.trust_3 != blank -%}<li>{{ section.settings.trust_3 }}</li>{%- endif -%}
      {%- if section.settings.trust_4 != blank -%}<li>{{ section.settings.trust_4 }}</li>{%- endif -%}
    </ul>
  {%- endif -%}
</section>

{% stylesheet %}
  /* ================================================================
     theinmag-hero (v2 - Maude exact pattern)
     Two-pane split, text on left only, photography on right.
     ================================================================ */

  .theinmag-hero {
    background-color: var(--color-cream);
    position: relative;
    overflow: hidden;
  }

  .theinmag-hero__split {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  @media (min-width: 990px) {
    .theinmag-hero__split {
      grid-template-columns: 1fr 1fr;
      min-height: clamp(560px, 75vh, 800px);
    }
  }

  .theinmag-hero__pane {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
  }

  @media (min-width: 750px) {
    .theinmag-hero__pane { aspect-ratio: 16 / 10; }
  }

  @media (min-width: 990px) {
    .theinmag-hero__pane { aspect-ratio: auto; }
  }

  /* Mobile: hide the kid-reading photo (left pane). Artwork is the
     only hero image; text overlays it directly. */
  @media (max-width: 989px) {
    .theinmag-hero__pane--left { display: none; }
  }

  /* Right-pane scrim is hidden on desktop (artwork stays clean) and
     activated on mobile (where text overlays the artwork and needs
     the contrast boost). Left-pane scrim is the inverse. */
  .theinmag-hero__pane--right .theinmag-hero__scrim { display: none; }
  @media (max-width: 989px) {
    .theinmag-hero__pane--right .theinmag-hero__scrim { display: block; }
  }

  /* Flat darken overlay - applied to BOTH panes so the photos sit at
     a consistent (slightly cooler) brightness. Subtle enough that the
     photo still leads visually, dark enough to take the edge off the
     brightness and help white text on the left pane sit cleanly. */
  .theinmag-hero__pane::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: rgba(42, 31, 61, 0.20);
    z-index: 1;
    pointer-events: none;
  }

  .theinmag-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Dark gradient scrim - left pane only, sits on top of the flat
     darken. Adds extra contrast specifically where the text sits
     (bottom-left), fades to nothing towards top-right so the photo
     still reads. */
  .theinmag-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(42, 31, 61, 0.55) 0%,
      rgba(42, 31, 61, 0.32) 35%,
      rgba(42, 31, 61, 0.05) 65%,
      rgba(42, 31, 61, 0) 80%
    );
    pointer-events: none;
    z-index: 2;
  }

  /* Content is positioned absolute relative to the SPLIT (its parent),
     not a pane. On mobile (left pane hidden) it overlays the artwork.
     On desktop it overlays the left pane via a right: 50% cap to stay
     within the left half of the split. */
  .theinmag-hero__content {
    position: absolute;
    z-index: 3;
    bottom: var(--space-xl);
    left: var(--space-lg);
    right: var(--space-lg);
    color: #ffffff;
    text-align: left;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
  }

  @media (min-width: 750px) {
    .theinmag-hero__content {
      bottom: var(--space-2xl);
      left: var(--space-2xl);
      right: var(--space-2xl);
    }
  }

  @media (min-width: 990px) {
    .theinmag-hero__content {
      bottom: var(--space-3xl);
      left: var(--space-3xl);
      right: 50%;
      padding-right: var(--space-2xl);
    }
  }

  .theinmag-hero__headline {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(44px, 6vw, 64px);
    line-height: 1.05;
    letter-spacing: 0;
    color: #ffffff;
    margin: 0;
    max-width: 18ch;
    /* Honour newlines typed into the Shopify admin headline field
       (e.g. "The magazine\nfor creative kids" gives a 2-line stack). */
    white-space: pre-line;
    /* Layered shadow: tight near-shadow for crisp definition,
       soft wide shadow for atmosphere on busy photos. */
    text-shadow:
      0 1px 2px rgba(0, 0, 0, 0.65),
      0 2px 8px rgba(0, 0, 0, 0.45),
      0 4px 24px rgba(0, 0, 0, 0.30);
  }

  /* Emphasis word treatment - slightly larger, tight line-height so
     the bigger word doesn't push surrounding lines apart. Driven by
     the emphasis_word setting; defaults to "creative". */
  .theinmag-hero__headline-emphasis {
    display: inline-block;
    font-size: 1.15em;
    line-height: 1;
    vertical-align: -0.04em;
  }

  .theinmag-hero__subhead {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: clamp(16px, 1.8vw, 19px);
    line-height: 1.5;
    color: #ffffff;
    margin: 0;
    /* Mobile: tight max-width for readability when stacked.
       Desktop+: removed so the subhead flows on a single line. */
    max-width: 36ch;
    text-shadow:
      0 1px 2px rgba(0, 0, 0, 0.70),
      0 2px 10px rgba(0, 0, 0, 0.45);
  }

  @media (min-width: 750px) {
    .theinmag-hero__subhead { max-width: none; }
  }

  /* Keeps "no ads, just creativity" together as a single unbreakable
     unit. On desktop the whole subhead fits on one line so this has
     no effect. On mobile the clause won't fit alongside the rest of
     the line, so it wraps as a unit - putting the line break BEFORE
     "no" instead of between "no" and "ads". */
  .theinmag-hero__subhead-clause {
    white-space: nowrap;
  }

  .theinmag-hero__ctas {
    display: flex;
    flex-direction: column;
    /* Mobile: content-width pills (not stretched) - feels less heavy
       on a narrow viewport and matches Maude's mobile pattern. */
    align-items: flex-start;
    gap: var(--space-sm);
    margin-top: var(--space-xs);
  }

  @media (min-width: 600px) {
    .theinmag-hero__ctas {
      flex-direction: row;
      flex-wrap: nowrap;
      align-items: center;
      justify-content: flex-start;
      gap: var(--space-md);
    }
  }

  /* ================================================================
     Buttons - locked sticker convention.
     Primary: yellow stamp (per design tokens).
     Secondary-on-image: outlined white. Documented adaptation of the
     outlined-purple secondary for dark photo backgrounds where dark
     purple wouldn't read. Outlined purple is still the default
     everywhere else on the site (cream sections, etc).
     ================================================================ */

  .theinmag-btn {
    display: inline-block;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    border-radius: var(--radius-button);
    cursor: pointer;
    transition: background-color var(--transition-standard),
                color var(--transition-standard),
                box-shadow var(--transition-standard),
                translate var(--transition-standard);
    border: none;
    text-align: center;
    line-height: 1.2;
    min-height: 44px;
    box-sizing: border-box;
  }

  .theinmag-btn--primary {
    font-family: var(--font-heading);
    background-color: var(--color-yellow);
    color: var(--color-inky-purple-navy);
    box-shadow: var(--shadow-button-yellow);
    padding: 12px 22px;
    font-size: 15px;
    font-weight: 400;
  }

  .theinmag-btn--primary:hover,
  .theinmag-btn--primary:focus-visible {
    background-color: var(--color-purple-dark);
    color: #ffffff;
    translate: 0 2px;
    box-shadow: var(--shadow-button-pressed);
    outline: none;
  }

  .theinmag-btn--secondary-on-image {
    font-family: var(--font-body);
    background: transparent;
    color: #ffffff;
    border: 2px solid #ffffff;
    padding: 9px 18px;
    font-size: 13px;
    font-weight: 600;
  }

  .theinmag-btn--secondary-on-image:hover,
  .theinmag-btn--secondary-on-image:focus-visible {
    background-color: #ffffff;
    color: var(--color-inky-purple-navy);
    outline: none;
  }

  @media (min-width: 750px) {
    .theinmag-btn--primary { padding: 16px 32px; font-size: 19px; }
    .theinmag-btn--secondary-on-image { padding: 12px 26px; font-size: 16px; }
  }

  /* ================================================================
     Trust micro-bar - peach pair (homepage accent).
     ================================================================ */

  .theinmag-hero__trust {
    list-style: none;
    margin: 0;
    padding: var(--space-md) var(--space-md);
    background-color: var(--color-peach);
    color: var(--color-sandy-orange-dark);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-align: center;
  }

  .theinmag-hero__trust li {
    display: inline-flex;
    align-items: center;
    padding: 0 var(--space-sm);
    line-height: 1.7;
  }

  /* Pseudo-element separator - looks clean even when items wrap. */
  .theinmag-hero__trust li + li::before {
    content: "·";
    margin-right: var(--space-md);
    font-weight: 700;
    opacity: 0.6;
  }

  @media (min-width: 750px) {
    .theinmag-hero__trust {
      font-size: 14px;
      padding: var(--space-lg) var(--space-md);
    }
    .theinmag-hero__trust li { padding: 0 var(--space-md); }
  }

  /* ================================================================
     Reduced motion.
     ================================================================ */

  @media (prefers-reduced-motion: reduce) {
    .theinmag-btn { transition: background-color 0.01ms, color 0.01ms; }
    .theinmag-btn--primary:hover,
    .theinmag-btn--primary:focus-visible { translate: 0 0; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "theINmag hero",
  "tag": "section",
  "class": "theinmag-hero-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Maude exact pattern: text + CTAs sit on the LEFT image, right image is photography-only. Edit copy and CTAs below; swap images via the image pickers."
    },
    {
      "type": "header",
      "content": "Headline + subhead (left image overlay)"
    },
    {
      "type": "textarea",
      "id": "headline",
      "label": "Headline (H1)",
      "info": "Press Enter to break lines exactly where you want them.",
      "default": "The magazine\nfor creative kids"
    },
    {
      "type": "text",
      "id": "emphasis_word",
      "label": "Word to emphasise (slightly larger)",
      "info": "Case-sensitive. The first match in the headline gets a slightly larger size. Leave blank for no emphasis.",
      "default": "creative"
    },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Subhead",
      "default": "Where Aussie kids get published - no ads, just creativity"
    },
    {
      "type": "header",
      "content": "First button (outlined white)"
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Label",
      "default": "Grab a membership"
    },
    {
      "type": "url",
      "id": "cta_primary_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Second button (yellow stamp)"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Label",
      "default": "Send IN content"
    },
    {
      "type": "url",
      "id": "cta_secondary_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Left image (carries text + CTAs)"
    },
    {
      "type": "paragraph",
      "content": "Real photo of an Australian kid reading theINmag. Falls back to HERO_kid-reading-mag.jpg in /assets/ if not set here."
    },
    {
      "type": "image_picker",
      "id": "image_left",
      "label": "Left image"
    },
    {
      "type": "text",
      "id": "image_left_alt",
      "label": "Left image alt text",
      "info": "Descriptive and keyword-aware. Drives AEO."
    },
    {
      "type": "header",
      "content": "Right image (photography only, no overlay)"
    },
    {
      "type": "paragraph",
      "content": "Real kid creation in warm palette. Falls back to HERO_kid-creation-art.jpg in /assets/ if not set here."
    },
    {
      "type": "image_picker",
      "id": "image_right",
      "label": "Right image"
    },
    {
      "type": "text",
      "id": "image_right_alt",
      "label": "Right image alt text"
    },
    {
      "type": "header",
      "content": "Trust micro-bar"
    },
    {
      "type": "checkbox",
      "id": "show_trust_bar",
      "label": "Show trust micro-bar",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_1",
      "label": "Item 1",
      "default": "Printed sustainably in Australia"
    },
    {
      "type": "text",
      "id": "trust_2",
      "label": "Item 2",
      "default": "100% kid-created"
    },
    {
      "type": "text",
      "id": "trust_3",
      "label": "Item 3",
      "default": "Always ad-free"
    },
    {
      "type": "text",
      "id": "trust_4",
      "label": "Item 4",
      "default": "Tri-annual"
    }
  ],
  "presets": [
    {
      "name": "theINmag hero"
    }
  ]
}
{% endschema %}
