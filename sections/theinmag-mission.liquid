{%- comment -%}
  theinmag-mission
  Sand-coloured band sitting between the hero and the audience tiles.
  Two stacked pieces inside one section:
    1. Feature row + mission statement.
       Four slogans (peach pair: black default, dark sandy orange on
       hover/focus) separated by orange dots. Default state renders the
       brand mission underneath. Hovering or focusing a slogan swaps
       the mission line to a feature-specific sentence.
       Mobile: the slogan row becomes a horizontal scroll-snap carousel
       so users can swipe rather than vertically stack the four items.
    2. Three product link cards (Membership / Latest mag / Build a
       bundle). Default + hover image per card. Whole card is a link.

  The four slogans here intentionally replace the hero's trust micro-bar
  (show_trust_bar is set to false on the hero in index.json) - the
  feature row and the mission statement together are a richer surface
  for the same information immediately below the hero.

  Spec: ../theinmag-docs/theinmag-design-tokens.md (peach pair, Inter 600 subhead size,
  prefers-reduced-motion, no em dashes).
{%- endcomment -%}

{%- liquid
  assign default_message = section.settings.default_message | default: 'Our mission is to empower kids and support parents and teachers.'
  assign feature_blocks = section.blocks | where: 'type', 'feature'
  assign product_blocks = section.blocks | where: 'type', 'product_link'
-%}

{%- comment -%}
  Character is now sourced from the sitewide kid-character pool. The
  per-section character_1/2/3 schema settings were removed in the
  May 10 2026 retrofit - drop new files into /assets/character-N.png
  and bump pool_size in snippets/theinmag-character-pool.liquid.
{%- endcomment -%}
{% render 'theinmag-character-pool' %}

<section class="theinmag-mission" data-theinmag-mission aria-labelledby="theinmag-mission-heading">
  <h2 id="theinmag-mission-heading" class="theinmag-mission__a11y-heading">What makes theINmag different?</h2>

  <div class="theinmag-mission__panel" style="--dots-url: url('{{ 'Dots.png' | asset_url }}');">

  {%- if feature_blocks.size > 0 -%}
    <div class="theinmag-mission__band">
      <ul class="theinmag-mission__features" role="list">
        {%- for block in feature_blocks -%}
          <li class="theinmag-mission__feature" {{ block.shopify_attributes }}>
            <button
              type="button"
              class="theinmag-mission__slogan"
              data-mission-trigger
              data-message="{{ block.settings.hover_message | escape }}"
            >
              {{ block.settings.label }}
            </button>
          </li>
        {%- endfor -%}
      </ul>

      <p
        class="theinmag-mission__statement"
        data-mission-statement
        data-default-message="{{ default_message | escape }}"
        aria-live="polite"
      >
        {{ default_message }}
      </p>
    </div>
  {%- endif -%}

  {%- if product_blocks.size > 0 -%}
    <div class="theinmag-mission__products-wrap">
      <span class="theinmag-mission__character" data-theinmag-pool-character></span>

    <ul class="theinmag-mission__products" role="list">
      {%- for block in product_blocks -%}
        {%- liquid
          assign default_src = ''
          assign hover_src = ''
          # When the block links to a product and has no explicit image
          # set, fall back to that product's own media - keeps cards like
          # the Mag10 pre-order tile showing the real cover without a
          # curated asset having to be uploaded first.
          assign linked_product = nil
          assign block_link = block.settings.link | default: ''
          if block_link contains '/products/'
            assign linked_handle = block_link | split: '/products/' | last | split: '?' | first | split: '#' | first
            assign linked_product = all_products[linked_handle]
          endif
          if block.settings.image != blank
            assign default_src = block.settings.image | image_url: width: 1200
          elsif block.settings.fallback_filename != blank
            assign default_src = block.settings.fallback_filename | asset_url
          elsif linked_product != blank and linked_product.featured_image != blank
            assign default_src = linked_product.featured_image | image_url: width: 1200
          endif
          if block.settings.hover_image != blank
            assign hover_src = block.settings.hover_image | image_url: width: 1200
          elsif block.settings.fallback_hover_filename != blank
            assign hover_src = block.settings.fallback_hover_filename | asset_url
          elsif linked_product != blank and linked_product.featured_image != blank
            assign hover_src = linked_product.featured_image | image_url: width: 1200
          endif
        -%}
        <li class="theinmag-mission__product-item" {{ block.shopify_attributes }}>
          <a class="theinmag-mission__product" href="{{ block.settings.link | default: '#' }}">
            <span class="theinmag-mission__product-frame">
              {%- if default_src != blank -%}
                <img
                  class="theinmag-mission__product-image theinmag-mission__product-image--default"
                  src="{{ default_src }}"
                  alt="{{ block.settings.image_alt | default: block.settings.label }}"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {%- endif -%}
              {%- if hover_src != blank -%}
                <img
                  class="theinmag-mission__product-image theinmag-mission__product-image--hover"
                  src="{{ hover_src }}"
                  alt=""
                  loading="lazy"
                  aria-hidden="true"
                  width="600"
                  height="600"
                >
              {%- endif -%}
              <span class="theinmag-mission__product-label">{{ block.settings.label }}</span>
            </span>
            <div class="theinmag-mission__product-meta">
              {%- if block.settings.tagline != blank -%}
                <span class="theinmag-mission__product-tagline">{{ block.settings.tagline }}</span>
              {%- endif -%}
              {%- if block.settings.price != blank -%}
                <span class="theinmag-mission__product-price">{{ block.settings.price }}</span>
              {%- endif -%}
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.social_proof_text != blank -%}
      <p class="theinmag-mission__social-proof">
        <span class="theinmag-mission__social-proof-stamp">{{ section.settings.social_proof_text }}</span>
      </p>
    {%- endif -%}
    </div>
  {%- endif -%}
  </div>
</section>

{%- stylesheet -%}
  /* ================================================================
     theinmag-mission
     Section uses the peach pair: light peach background (#FCDDB8) with
     dark sandy orange (#D9783A) for accents and hover state. Default
     text is inky purple-navy (#2A1F3D) - the universal cream-pair
     companion that's the default on every section.
     ================================================================ */

  .theinmag-mission {
    --mission-bg: var(--color-peach, #FCDDB8);
    --mission-accent: var(--color-sandy-orange-dark, #D9783A);
    --mission-ink: var(--color-inky-purple-navy, #2A1F3D);

    /* Full-bleed cream wrapper. Top padding is zero so the sand panel
       butts directly against the hero's bottom edge - no cream stripe
       between them. Cream still shows on the sides and below the panel
       so the "frame" effect holds on three sides. */
    background-color: var(--color-cream, #FBF6EA);
    color: var(--mission-ink);
    padding: 0 clamp(16px, 3vw, 32px) clamp(24px, 4vw, 48px);
  }

  /* The sand panel - the "card" that pops out of the cream. Modal-level
     purple-tinted shadow per the design tokens for a more pronounced
     glow than the card token gave (Ryan asked for a stronger pop). The
     shadow on the top edge is clipped by the hero above, but the bottom
     and side glow read clearly against the cream frame. */
  .theinmag-mission__panel {
    position: relative;
    background-color: var(--mission-bg);
    max-width: 1320px;
    margin: 0 auto;
    padding: clamp(24px, 4vw, 56px) clamp(20px, 4vw, 64px);
    box-shadow: 0 8px 32px rgba(123, 79, 158, 0.18);
    /* Clip the dots layer to the panel - the oversized background
       extends beyond panel edges to give the "pattern continues" feel,
       but we don't want it bleeding into the cream gutter outside. */
    overflow: hidden;
  }

  /* ================================================================
     Dots background layer
     A hand-drawn dot trail (Dots.png) sits behind the slogan band and
     product cards. The PNG ships in coral pink, but we use it as a
     mask-image rather than background-image so the dots render in
     whatever colour we paint behind the mask - in this case the peach
     wave overlay token (#F8C99E). This keeps the dot colour in-system
     with the rest of the panel and softer than the sandy-orange accent.

     mask-size auto 140% renders the image taller than the panel so
     the top and bottom edges clip; mask-position right -360px center
     pushes a meaningful chunk of the image past the right edge so
     plenty of dots clip off the right. Pattern reads as continuing in
     all three directions.

     --dots-url is set inline on the panel markup since stylesheet
     blocks can't take Liquid.
     ================================================================ */
  .theinmag-mission__panel::before {
    content: '';
    position: absolute;
    inset: 0;
    /* Peach wave token - the design system's prescribed pattern overlay
       tone for peach surfaces. Lighter than the sandy-orange accent
       which read too dark in the panel; still visibly distinct from the
       peach background. */
    background-color: #F8C99E;
    -webkit-mask-image: var(--dots-url);
    mask-image: var(--dots-url);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: auto 140%;
    mask-size: auto 140%;
    -webkit-mask-position: right -360px center;
    mask-position: right -360px center;
    pointer-events: none;
    z-index: 0;
    opacity: 0.7;
  }

  /* Lift every child of the panel above the dots layer. The panel's
     content (band, products-wrap, the character sticker inside it) is
     the "reading layer"; dots are the texture layer underneath. */
  .theinmag-mission__band,
  .theinmag-mission__products-wrap {
    position: relative;
    z-index: 1;
  }

  .theinmag-mission__a11y-heading {
    /* AEO/accessibility: heading is question-format per CLAUDE.md, but
       the visible UI is the slogan row, so the heading itself is hidden. */
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ================================================================
     Slogan band
     ================================================================ */

  .theinmag-mission__band {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-md);
    text-align: center;
  }

  @media (min-width: 750px) {
    .theinmag-mission__band {
      padding: 0 var(--space-xl);
    }
  }

  /* Slogan band stays centred. Tried nudging the band right of dead-
     centre to balance the character popping up at the products' top-
     left, but at common laptop widths (~960-1100px) any extra left
     padding pushed "Tri-annual" onto a second line - and the user's
     "slogans on one line on desktop" rule wins ties. */

  /* Mobile-first: horizontal scroll-snap so users can swipe through the
     four slogans rather than reading them stacked. The peek of the next
     slogan at the right edge is the "swipe for more" affordance, same
     pattern as the audience tiles. Scrollbar hidden, snap-x mandatory. */
  .theinmag-mission__features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: nowrap;
    gap: var(--space-md);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    /* Bleed the scroll container to the section edges so the first
       slogan sits at the visual margin, not pinned in the centre. */
    margin: 0 calc(-1 * var(--space-md));
    padding: 0 var(--space-md) var(--space-sm);
  }

  .theinmag-mission__features::-webkit-scrollbar {
    display: none;
  }

  .theinmag-mission__feature {
    flex: 0 0 auto;
    scroll-snap-align: start;
    position: relative;
    /* Orange dot separator between feature items, never after the last
       one. ::after pseudo-element so the dot doesn't show up in screen
       reader output as part of the slogan label. */
    padding-right: var(--space-md);
  }

  .theinmag-mission__feature:not(:last-child)::after {
    content: '';
    position: absolute;
    right: -2px;
    top: 50%;
    transform: translateY(-50%);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--mission-accent);
  }

  /* Desktop+: switch to a centred inline row, drop the scroll affordance.
     Spacing kept tight (sm gap + md padding-right = 24px between items)
     so all four slogans fit on one line at common laptop widths. */
  @media (min-width: 750px) {
    .theinmag-mission__features {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: var(--space-sm);
      overflow: visible;
      margin: 0;
      padding: 0;
    }

    .theinmag-mission__feature {
      padding-right: var(--space-md);
    }

    .theinmag-mission__feature:not(:last-child)::after {
      right: -2px;
    }
  }

  .theinmag-mission__slogan {
    /* Reset button defaults so it reads as plain text. */
    appearance: none;
    background: none;
    border: 0;
    padding: 0;
    margin: 0;
    cursor: pointer;
    /* Match the hero subhead exactly per spec - same shape and size. */
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: clamp(16px, 1.8vw, 19px);
    line-height: 1.5;
    letter-spacing: 0;
    color: var(--mission-ink);
    transition: color var(--transition-standard, 0.15s ease);
    /* Whitespace: keep the slogan as one unit on every viewport. */
    white-space: nowrap;
  }

  .theinmag-mission__slogan:hover,
  .theinmag-mission__slogan:focus-visible,
  .theinmag-mission__slogan.is-active {
    color: var(--mission-accent);
    outline: none;
  }

  .theinmag-mission__slogan:focus-visible {
    /* Restore an outline for keyboard users only. */
    outline: 2px dashed var(--mission-accent);
    outline-offset: 4px;
    border-radius: 2px;
  }

  /* ================================================================
     Mission statement
     ================================================================ */

  .theinmag-mission__statement {
    margin: var(--space-lg) auto 0;
    /* Mobile: tight max-width so the line wraps cleanly. Desktop: drop
       the cap so each message lays out on a single line at common widths
       (the longest message is ~75 chars). The panel's max-width still
       constrains the overall area, so the line never runs ridiculously
       wide. */
    max-width: 56ch;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: clamp(16px, 1.8vw, 19px);
    line-height: 1.6;
    color: var(--mission-accent);
    transition: opacity 0.18s ease;
    min-height: 3em;
  }

  @media (min-width: 990px) {
    .theinmag-mission__statement {
      max-width: none;
    }
  }

  .theinmag-mission__statement.is-swapping {
    opacity: 0;
  }

  /* Emphasis inside the mission sentences. Same Post Regular treatment
     as .theinmag-announcement__hook so the two surfaces feel related -
     hand-lettered word lifted out of an Inter line. line-height 0.9 +
     vertical-align keep the bigger Post characters from blowing the
     line-box out. */
  .theinmag-mission__statement strong {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 1.8em;
    line-height: 0.9;
    letter-spacing: 0;
    vertical-align: -0.12em;
    display: inline-block;
    color: inherit;
  }

  /* ================================================================
     Social proof banner - a tight inline-block cream pill sitting
     centred BELOW the products row. Same cream surface and subtle
     card shadow as the product cards above, so it reads as part of
     the same family. Tam's call: above the products competed with
     the slogan band; below feels calmer and lets the cards breathe.
     ================================================================ */

  .theinmag-mission__social-proof {
    margin: clamp(28px, 4vw, 48px) auto 0;
    padding: 0 var(--space-md);
    text-align: center;
  }

  .theinmag-mission__social-proof-stamp {
    display: inline-block;
    background-color: var(--color-cream, #FBF6EA);
    color: var(--color-inky-purple-navy, #2A1F3D);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    /* Match the product tile tagline size so the banner reads as part of
       the same body-copy family. The Post Regular strong inside scales
       off this via 1.8em, keeping the slogan-band emphasis proportion. */
    font-size: 14px;
    line-height: 1.5;
    padding: clamp(10px, 1.4vw, 14px) clamp(20px, 2.6vw, 28px);
    box-shadow: 0 1px 6px rgba(123, 79, 158, 0.06);
    text-align: center;
    max-width: 100%;
  }

  /* Inside the banner, <strong> picks up the same Post Regular emphasis
     used in the slogan band's hover messages above - 1.8em with matching
     line-height and vertical-align nudges so the hand-lettered word lifts
     out of the Inter line without blowing the line-box out. */
  .theinmag-mission__social-proof-stamp strong {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 1.8em;
    line-height: 0.9;
    letter-spacing: 0;
    vertical-align: -0.12em;
    display: inline-block;
    color: inherit;
  }


  /* ================================================================
     Product cards (3-up)
     ================================================================ */

  .theinmag-mission__products {
    list-style: none;
    margin: clamp(32px, 5vw, 56px) auto 0;
    padding: 0 var(--space-md);
    max-width: 1200px;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 750px) {
    .theinmag-mission__products {
      padding: 0 var(--space-xl);
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-xl);
    }
  }

  /* Each product link IS a card now, but a sharp-cornered cream one
     sitting inside the sand panel - so the orange surrounds it and the
     card pops the same way the panel pops out of the page. The image
     fills the top of the card, label overlays the blank top-left space
     the photographer left, tagline + price sit below in cream space.
     Flex column + height:100% makes the card fill its grid cell so all
     three cards in the row land at the same height even when one card's
     meta footer is shorter (e.g. the bundle card with no price). */
  .theinmag-mission__product-item {
    display: flex;
  }
  .theinmag-mission__product {
    display: flex;
    flex-direction: column;
    flex: 1;
    text-decoration: none;
    color: inherit;
    background-color: var(--color-cream, #FBF6EA);
    padding-bottom: clamp(16px, 2vw, 24px);
    transition: transform var(--transition-hover, 0.2s ease), box-shadow var(--transition-hover, 0.2s ease);
    /* Subtle shadow so the card lifts off the sand the same way the
       panel lifts off the page. */
    box-shadow: 0 1px 6px rgba(123, 79, 158, 0.06);
  }

  .theinmag-mission__product:hover,
  .theinmag-mission__product:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 4px 20px rgba(123, 79, 158, 0.15);
    outline: none;
  }

  .theinmag-mission__product:focus-visible {
    box-shadow: 0 0 0 3px var(--mission-accent), 0 4px 20px rgba(123, 79, 158, 0.15);
  }

  .theinmag-mission__product-frame {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .theinmag-mission__product-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity var(--transition-hover, 0.2s ease);
  }

  .theinmag-mission__product-image--hover {
    opacity: 0;
  }

  .theinmag-mission__product:hover .theinmag-mission__product-image--default,
  .theinmag-mission__product:focus-visible .theinmag-mission__product-image--default {
    opacity: 0;
  }

  .theinmag-mission__product:hover .theinmag-mission__product-image--hover,
  .theinmag-mission__product:focus-visible .theinmag-mission__product-image--hover {
    opacity: 1;
  }

  /* Product name sits inside the image, top-left. Relies on the blank
     space photographers left in the corner for legibility - no scrim
     or text-shadow. Inky purple-navy matches the body copy elsewhere. */
  .theinmag-mission__product-label {
    position: absolute;
    top: var(--space-md);
    left: var(--space-md);
    right: var(--space-md);
    margin: 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: clamp(18px, 2.2vw, 22px);
    line-height: 1.3;
    color: var(--mission-ink);
    z-index: 1;
  }

  .theinmag-mission__product-meta {
    /* Sits in the cream card footer with comfortable horizontal padding
       so tagline and price breathe inside the card. */
    padding: clamp(14px, 1.6vw, 20px) clamp(16px, 1.8vw, 24px) 0;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .theinmag-mission__product-tagline {
    flex: 1;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: 14px;
    line-height: 1.5;
    color: var(--mission-ink);
    opacity: 0.85;
  }

  .theinmag-mission__product-price {
    flex: 0 0 auto;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: clamp(15px, 1.5vw, 17px);
    line-height: 1.3;
    color: var(--mission-ink);
    white-space: nowrap;
  }

  /* ================================================================
     Random kid-character sticker
     One of up to three character images is picked at page load by JS.
     The character is anchored to the top-left of the first product card
     (membership) and pokes up from behind it - z-index stack makes the
     card cover the lower half of the character, the rest peeks above.
     Hidden on mobile to avoid the slogan-overlap concern Ryan flagged.
     ================================================================ */

  .theinmag-mission__products-wrap {
    /* Anchor for the absolutely-positioned character sticker. */
    position: relative;
  }

  .theinmag-mission__character {
    display: none;
  }

  /* Show on tablet+ (750px) - the products grid switches to 3-up at this
     breakpoint, which is when "behind the membership tile" makes sense.
     On phones the products stack and the character would overlap items
     below it, so it stays hidden there. */
  @media (min-width: 750px) {
    .theinmag-mission__character {
      display: block;
      position: absolute;
      /* INITIAL state: bottom: calc(100% - X) places the character's
         bottom edge X pixels below the products-wrap top - so most of
         the character is above the products, bottom X tucked behind
         the membership card. Transition on `bottom` lets it slide
         smoothly up to the popped state when scroll triggers it. */
      bottom: calc(100% - clamp(50px, 5vw, 80px));
      left: clamp(-12px, -1vw, 0px);
      width: clamp(100px, 10vw, 150px);
      pointer-events: none;
      z-index: 0;
      animation: theinmag-mission-bob 4s ease-in-out infinite;
      transition: bottom 0.7s cubic-bezier(0.34, 1.4, 0.64, 1), left 0.7s cubic-bezier(0.34, 1.4, 0.64, 1);
    }

    /* POPPED state: triggered when the section comes into view (JS adds
       the class on scroll). Character lifts to sit roughly halfway
       between the top of the sand panel and the membership tile - high
       enough that no part is behind the card, low enough that it feels
       framed by the slogan + product space rather than rocketing into
       the hero. Slight overshoot in the easing gives the "pop" feel. */
    .theinmag-mission__character.is-popped {
      bottom: calc(100% + clamp(8px, 1vw, 20px));
    }

    /* Products sit ABOVE the character so the lower portion of the
       character is hidden behind the membership card. */
    .theinmag-mission__product {
      position: relative;
      z-index: 1;
    }
  }

  /* Reduced-motion: skip the pop and the bob entirely. The character
     just sits in its initial position. */
  @media (prefers-reduced-motion: reduce) {
    .theinmag-mission__character {
      transition: none;
    }
    .theinmag-mission__character.is-popped {
      bottom: calc(100% - clamp(50px, 5vw, 80px));
    }
  }

  .theinmag-mission__character-img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* The sitewide character-pool snippet adds .theinmag-pool-character__img
     with its own bob animation. Mission already has a wrapper-level bob
     animation on .theinmag-mission__character, so we silence the pool's
     img-level bob here to avoid the two animations compounding. */
  .theinmag-mission__character .theinmag-pool-character__img {
    animation: none;
  }

  .theinmag-mission__character-attribution {
    display: block;
    margin-top: 4px;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-size: 11px;
    line-height: 1.3;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--mission-ink);
    opacity: 0.7;
    text-align: center;
  }

  @keyframes theinmag-mission-bob {
    0%, 100% { transform: translateY(0) rotate(-2deg); }
    50% { transform: translateY(-6px) rotate(2deg); }
  }

  /* Reduced motion: kill the fade swap, the card lift, the image cross-
     fade and the character bob. Hover state still works, just without
     transitions. */
  @media (prefers-reduced-motion: reduce) {
    .theinmag-mission__statement,
    .theinmag-mission__product,
    .theinmag-mission__product-image {
      transition: none;
    }

    .theinmag-mission__product:hover,
    .theinmag-mission__product:focus-visible {
      transform: none;
    }

    .theinmag-mission__character {
      animation: none;
    }
  }
{%- endstylesheet -%}

<script>
  (function () {
    const root = document.querySelector('[data-theinmag-mission]');
    if (!root) return;

    const reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ----------------------------------------------------------------
       Slogan hover -> mission swap. No locking - hover/focus shows the
       slogan's message, mouseleave/blur reverts to the default mission.
       On touch, the synthesised mouseenter on tap shows the message
       while the user keeps reading; tapping elsewhere reverts.
       ---------------------------------------------------------------- */
    const statement = root.querySelector('[data-mission-statement]');
    const triggers = root.querySelectorAll('[data-mission-trigger]');

    if (statement && triggers.length) {
      const defaultMessage = statement.dataset.defaultMessage || statement.innerHTML.trim();
      let pendingMessage = null;
      let swapTimer = null;
      let activeTrigger = null;

      function setMessage(message) {
        if (!message || message === statement.innerHTML.trim()) return;

        if (reducedMotion) {
          statement.innerHTML = message;
          return;
        }

        pendingMessage = message;
        statement.classList.add('is-swapping');
        clearTimeout(swapTimer);
        swapTimer = setTimeout(function () {
          statement.innerHTML = pendingMessage;
          statement.classList.remove('is-swapping');
        }, 180);
      }

      function render() {
        triggers.forEach(function (t) { t.classList.toggle('is-active', t === activeTrigger); });
        setMessage(activeTrigger ? activeTrigger.dataset.message : defaultMessage);
      }

      triggers.forEach(function (trigger) {
        const enter = function () { activeTrigger = trigger; render(); };
        const leave = function () { if (activeTrigger === trigger) { activeTrigger = null; render(); } };

        trigger.addEventListener('mouseenter', enter);
        trigger.addEventListener('mouseleave', leave);
        trigger.addEventListener('focus', enter);
        trigger.addEventListener('blur', leave);
      });
    }

    /* ----------------------------------------------------------------
       Character image fill + scroll-pop now handled by the sitewide
       theinmag-character-pool snippet (rendered at the top of this
       section). Removed in the May 10 2026 sitewide retrofit so all
       on-site kid-character pops draw from the same /assets/character-N
       pool rather than per-section image_picker settings. */
  })();
</script>

