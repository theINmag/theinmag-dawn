{%- stylesheet -%}
  .theinmag-article {
    --hero-progress: 0;
    --hero-darken: 0.3;
    --color-cream: #FBF6EA;
    --color-ink: #2A1F3D;
    --color-purple-dark: #5D3A7A;
    --color-teal: #2D6878;
    --color-rule: rgba(42, 31, 61, 0.18);
    background-color: var(--color-cream);
    color: var(--color-ink);
  }

  .theinmag-article__grid {
    display: grid;
    grid-template-columns: 1fr;
    align-items: stretch;
  }

  @media (min-width: 990px) {
    .theinmag-article__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  /* ================================================================
     Cover column - sticky on desktop, natural on mobile
     ================================================================ */
  .theinmag-article__cover-col {
    position: relative;
    background-color: var(--color-ink);
  }

  .theinmag-article__cover-sticky {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  @media (min-width: 750px) {
    .theinmag-article__cover-sticky {
      aspect-ratio: 3 / 4;
    }
  }

  @media (min-width: 990px) {
    .theinmag-article__cover-sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      aspect-ratio: auto;
    }
  }

  .theinmag-article__cover-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(calc(1 - var(--hero-darken) + (var(--hero-progress) * var(--hero-darken))));
    transform: scale(calc(1.04 - (var(--hero-progress) * 0.04)));
    transition: filter 0.05s linear, transform 0.05s linear;
    transform-origin: center center;
    will-change: filter, transform;
  }

  .theinmag-article__cover-placeholder {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #5D3A7A 0%, #C9543E 100%);
  }

  /* ================================================================
     Hero overlay (title + byline + topic on the image)
     White text on a soft scrim - per the white-on-scrim memory, never
     coloured pills on photography surfaces.
     ================================================================ */
  .theinmag-article__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: clamp(24px, 4vw, 56px);
    color: #FFFFFF;
    background: linear-gradient(
      to bottom,
      rgba(20, 14, 30, 0.55) 0%,
      rgba(20, 14, 30, 0.18) 45%,
      rgba(20, 14, 30, 0) 80%
    );
    opacity: calc(1 - var(--hero-progress));
    transform: translateY(calc(var(--hero-progress) * -32px)) scale(calc(1 + (var(--hero-progress) * 0.04)));
    transition: opacity 0.05s linear, transform 0.05s linear;
    transform-origin: left center;
    pointer-events: none;
    text-shadow: 0 1px 12px rgba(20, 14, 30, 0.35);
    will-change: opacity, transform;
  }

  .theinmag-article__overlay-title {
    margin: 0 0 clamp(12px, 1.6vw, 20px);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: clamp(28px, 4.5vw, 52px);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: #FFFFFF;
    max-width: 20ch;
  }

  .theinmag-article__overlay-topic {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: clamp(10px, 1.2vw, 14px);
    opacity: 0.92;
  }

  .theinmag-article__overlay-byline {
    margin: 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 500;
    font-size: clamp(13px, 1.3vw, 15px);
    line-height: 1.4;
    letter-spacing: 0.01em;
    color: #FFFFFF;
    opacity: 0.92;
    max-width: 32ch;
  }

  .theinmag-article__overlay-role {
    margin: 4px 0 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: clamp(12px, 1.15vw, 13px);
    line-height: 1.4;
    letter-spacing: 0.01em;
    color: #FFFFFF;
    opacity: 0.82;
    max-width: 32ch;
  }

  /* ================================================================
     Body column - article content + bylines + Quick answer + about
     ================================================================ */
  .theinmag-article__body-col {
    background-color: var(--color-cream);
    padding: clamp(40px, 6vw, 96px) clamp(40px, 6vw, 96px) clamp(56px, 7vw, 112px) clamp(20px, 4vw, 56px);
  }

  .theinmag-article__body-inner {
    max-width: 64ch;
    margin: 0 auto;
  }

  /* ----- Top byline chip (just topic / read time / date) ----- */
  .theinmag-article__byline-row {
    margin: 0 0 clamp(28px, 3vw, 40px);
    padding-bottom: clamp(20px, 2.4vw, 28px);
    border-bottom: 1px solid var(--color-rule);
  }

  /* Avatar (in About-the-author card) and kid-character avatar
     fallback styles are kept here for the bottom about card. */
  .theinmag-article__avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .theinmag-article__avatar-fallback {
