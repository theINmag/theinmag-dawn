  /* ================================================================
     "more for you." recommendation strip - cream surface (matches the
     article body for cohesion), white tile cards inside for contrast,
     "browse all field notes" outlined-purple secondary CTA on the
     header row for back-to-index navigation.
     ================================================================ */
  .theinmag-article__recommend {
    background-color: var(--color-cream);
    padding: clamp(48px, 6vw, 96px) clamp(20px, 4vw, 56px) clamp(56px, 7vw, 112px);
    border-top: 1px solid var(--color-rule);
