{%- comment -%}
  theinmag-article
  Single field-notes post template. Maude-style two-column editorial:
  cover image sticky on the left, article body scrolls on the right.

  Per-post metafields (namespace `field_notes`, defined in Shopify
  admin under Settings > Custom data > Articles):

    field_notes.quick_answer            (multi-line text, REQUIRED for AEO)
    field_notes.primary_topic           (single line text, e.g. "Creativity")
    field_notes.author_type             (single line text: ryan | tam)
    field_notes.author_role_override    (single line text, optional)
    field_notes.kid_first_name          (single line text - PRESENCE triggers kid mode)
    field_notes.kid_age                 (single line text / integer)
    field_notes.kid_region              (single line text, e.g. "Echuca VIC. Yorta Yorta Country.")
    field_notes.text_type               (single line text: Persuasive | Informative | Entertaining)
    field_notes.recommendation_1_handle (single line text, post handle no slash)
    field_notes.recommendation_2_handle (single line text, post handle no slash)
    field_notes.recommendation_3_handle (single line text, post handle no slash)
    field_notes.read_audience           (single line text: kids | parents | mixed)

  Series-republish metafields (Real Jobs, Real People etc):

    field_notes.guest_name              (single line, e.g. "Mitch G.")
    field_notes.guest_avatar            (file_reference: image - tighter face crop)
    field_notes.series_name             (single line, e.g. "Real Jobs, Real People")
    field_notes.series_strip_text       (multi-line, body of the series strip)
    field_notes.advice_block            (multi-line, closing advice quote)
    field_notes.closing_cta_label       (single line, button label)
    field_notes.closing_cta_url         (URL, button destination)

  When `guest_name` is set the post enters guest mode: the hero
  overlay byline reads "Meet [guest_name]." in Post Regular, the
  about-the-author card is suppressed (cover image carries the photo),
  and `author_role_override` carries the role/location/age line.

  Kid-contributor mode (Real Kids Voices) is triggered by the PRESENCE
  of `kid_first_name` and WINS over both guest mode and author_type.
  The hero shows a series chip (series_name) + a role line. The role
  line auto-composes as "[text_type] piece by [name], age [age].
  [region]", UNLESS `author_role_override` is set, in which case that
  hand-written value wins. There is NO "Meet"/"By" heading. No avatar
  is rendered anywhere and the
  about-the-author card is omitted entirely - the author is the kid,
  who has no author page, bio, or photo (locked privacy rule). The
  Article JSON-LD author becomes a Person named by first name only,
  with no url or sameAs.
{%- endcomment -%}

{%- liquid
  comment
  Strip a single trailing period from sentence-case lowercase headings
  per Ryan's brand decision (2026-05-06, REVERSED 2026-05-18 —
  trailing periods now KEPT on field-notes headings, reads less
  abrupt). Question marks were always kept; this just unifies.
  endcomment
  assign display_title = article.title

  assign primary_topic = article.metafields.field_notes.primary_topic
  if primary_topic == blank
    assign primary_topic = article.tags.first
  endif

  assign quick_answer = article.metafields.field_notes.quick_answer

  assign guest_name = article.metafields.field_notes.guest_name
  assign guest_avatar = article.metafields.field_notes.guest_avatar.value
  assign series_name = article.metafields.field_notes.series_name
  assign series_strip_text = article.metafields.field_notes.series_strip_text
  assign advice_block_text = article.metafields.field_notes.advice_block
  assign closing_cta_label = article.metafields.field_notes.closing_cta_label
  assign closing_cta_url = article.metafields.field_notes.closing_cta_url

  comment
    Guest website link element (2026-09-08). Optional per-guest links to
    the guest's own site (guest_website) and YouTube channel (guest_youtube).
    Rendered as a small editorial line BEFORE the interview questions (see
    the body-injection block below). Blank = nothing shows, so every other
    post is unaffected.
  endcomment
  assign guest_website = article.metafields.field_notes.guest_website
  assign guest_youtube = article.metafields.field_notes.guest_youtube

  comment
    Photo mosaic strip (2026-09-08). field_notes.gallery is a JSON metafield:
    an ordered array of { file, caption, alt } where file is a theme asset
    filename staged flat in assets/ (e.g. rjrp-rachael-01.jpg). Populated =
    the strip renders full-width under the article body, above the
    recommendations. Empty/absent = no strip, so every existing post is
    untouched. NEVER put the post's cover (article.image) or the hero
    portrait in this array; it is the guest's OTHER photos only. The mosaic
    renders with NO heading (removed 2026-09-08): just the tiles.
  endcomment
  assign gallery_photos = article.metafields.field_notes.gallery.value

  comment
    Video companion (2026-08-28): field_notes.youtube_url holds the full
    YouTube link for this post's paired video. Parsed to an id here,
    rendered as a real iframe at the end of the body column plus a
    VideoObject JSON-LD block, so companion posts can rank as video
    results. Blank metafield = nothing renders.
  endcomment
  assign youtube_url = article.metafields.field_notes.youtube_url
  assign youtube_id = ''
  if youtube_url != blank
    if youtube_url contains 'watch?v='
      assign youtube_id = youtube_url | split: 'watch?v=' | last | split: '&' | first
    elsif youtube_url contains 'youtu.be/'
      assign youtube_id = youtube_url | split: 'youtu.be/' | last | split: '?' | first
    elsif youtube_url contains '/embed/'
      assign youtube_id = youtube_url | split: '/embed/' | last | split: '?' | first
    endif
  endif

  comment
    Series hub back-link (2026-08-28): maps this post's primary_topic to
    its series hub page so every post links back up to its collection
    (the cluster loop). Mapping lives in section settings hub_1..hub_3.
  endcomment
  assign series_hub_url = ''
  assign series_hub_label = ''
  assign pt_lc = primary_topic | downcase | strip
  assign hub_1_topic = section.settings.hub_1_topic | downcase | strip
  assign hub_2_topic = section.settings.hub_2_topic | downcase | strip
  assign hub_3_topic = section.settings.hub_3_topic | downcase | strip
  if hub_1_topic != blank and pt_lc == hub_1_topic
    assign series_hub_url = section.settings.hub_1_url
    assign series_hub_label = section.settings.hub_1_label
  elsif hub_2_topic != blank and pt_lc == hub_2_topic
    assign series_hub_url = section.settings.hub_2_url
    assign series_hub_label = section.settings.hub_2_label
  elsif hub_3_topic != blank and pt_lc == hub_3_topic
    assign series_hub_url = section.settings.hub_3_url
    assign series_hub_label = section.settings.hub_3_label
  elsif section.settings.hub_3_match_mode == 'fallback' and section.settings.hub_3_url != blank
    assign series_hub_url = section.settings.hub_3_url
    assign series_hub_label = section.settings.hub_3_label
  endif

  comment
    Guest mode: triggered by guest_name presence, not a separate
    author_type value. Keeps the existing ryan/tam/kid enum simple
    while letting any post opt in to the "Meet [Name]" byline.
  endcomment
  assign is_guest = false
  if guest_name != blank
    assign is_guest = true
    assign guest_first_name = guest_name | split: ' ' | first

    comment
      Guest display name: the friendly name used in the advice label and the
      guest website link. Strips a trailing initial token so "Bridget F."
      reads as "Bridget", while a multi-word name with no initial (e.g.
      "Flying the Nest") is kept whole. guest_first_name alone would wrongly
      cut "Flying the Nest" down to "Flying".
    endcomment
    assign guest_display_name = guest_name | strip
    assign gdn_words = guest_display_name | split: ' '
    assign gdn_last = gdn_words | last
    assign gdn_last_bare = gdn_last | replace: '.', '' | strip
    assign gdn_last_len = gdn_last_bare | size
    if gdn_last_len == 1 and gdn_words.size > 1
      assign gdn_name_len = guest_display_name | size
      assign gdn_last_len_full = gdn_last | size
      assign gdn_keep = gdn_name_len | minus: gdn_last_len_full | minus: 1
      assign guest_display_name = guest_display_name | slice: 0, gdn_keep | strip
    endif
  endif

  assign author_type = article.metafields.field_notes.author_type | downcase
  if author_type == blank
    assign author_type = 'ryan'
  endif

  comment
    Kid-contributor mode: triggered by the presence of
    field_notes.kid_first_name, and it WINS over both guest mode and
    author_type. A kid post shows the kid as author - no founder name,
    no founder bio card, no avatar (locked privacy rule). Forcing
    is_guest false here means every downstream `if is_guest` branch
    yields to kid mode without needing a kid clause of its own.
  endcomment
  assign is_kid = false
  if article.metafields.field_notes.kid_first_name != blank
    assign is_kid = true
    assign is_guest = false
  endif

  comment
    Guest portrait (small circular avatar beside the Quick read card)
    is suppressed in kid mode - kids never get a face/avatar, even if a
    stale guest_avatar lingers from an interim workaround.
  endcomment
  assign show_guest_portrait = false
  if guest_avatar != blank and is_kid == false
    assign show_guest_portrait = true
  endif

  comment
    Audience-aware read time. The default Shopify ~225/250 wpm assumes
    adult skim speed and badly under-counts kid-facing posts (a 950-word
    Real Jobs post should read ~7 min, not ~2). read_audience is an
    optional metafield — kids | parents | mixed — defaulting to mixed.
    Word count divided by the wpm for that audience, rounded up.
  endcomment
  assign read_audience = article.metafields.field_notes.read_audience | downcase
  if read_audience == 'kids'
    assign read_wpm = 125
  elsif read_audience == 'parents'
    assign read_wpm = 220
  else
    assign read_wpm = 170
  endif
  assign words = article.content | strip_html | split: ' ' | size
  assign read_minutes = words | times: 1.0 | divided_by: read_wpm | ceil | at_least: 1
  assign read_time_label = read_minutes | append: ' min read'

  if is_kid
    assign kid_first_name = article.metafields.field_notes.kid_first_name
    assign kid_age = article.metafields.field_notes.kid_age
    assign kid_region = article.metafields.field_notes.kid_region
    assign text_type = article.metafields.field_notes.text_type | strip

    comment
      Role line: "<text_type> piece by <name>, age <age>. <region>".
      e.g. "Persuasive piece by Zanda, age 11. Echuca VIC. Yorta Yorta Country."
      When text_type is blank we fall back to a neutral "Piece by ..."
      (no genre word) so the line never renders a leading blank. The age
      and region segments are each guarded so missing values don't leave
      stray punctuation.
    endcomment
    capture kid_role_line
      if text_type != blank
        echo text_type
        echo ' piece by '
      else
        echo 'Piece by '
      endif
      echo kid_first_name
      if kid_age != blank
        echo ', age '
        echo kid_age
      endif
      echo '.'
      if kid_region != blank
        echo ' '
        echo kid_region
      endif
    endcapture

    comment
      Series chip shown in the hero overlay (e.g. "REAL KIDS VOICES",
      uppercased by CSS). Driven by series_name; falls back to
      primary_topic so the chip slot is never empty on a kid post.
    endcomment
    assign kid_series_chip = series_name
    if kid_series_chip == blank
      assign kid_series_chip = primary_topic
    endif

    comment
      Blank every founder identity field so no Ryan/Tam data can leak
      into a kid post - the byline, schema, and avatar logic all read
      these. author_name is set to the kid's first name for any
      alt/aria fallbacks (no visible "By" byline is rendered).
    endcomment
    assign author_name = kid_first_name
    assign author_legal_name = blank
    assign author_person_id = blank
    assign author_role = blank
    assign author_bio = blank
    assign author_archive_url = blank
    assign author_avatar = blank
    assign author_avatar_filename = blank
    assign author_ig = blank
    assign author_fb = blank
    assign author_yt = blank
  elsif author_type == 'tam'
    assign author_name = section.settings.tam_name | default: 'Tam'
    assign author_legal_name = section.settings.tam_legal_name | default: 'Tam Gow'
    assign author_person_id = section.settings.tam_person_id | default: '/pages/behind-the-mag#tam'
    assign author_role = section.settings.tam_role
    assign author_bio = section.settings.tam_bio
    assign author_archive_url = section.settings.tam_archive_url
    assign author_avatar = section.settings.tam_avatar
    assign author_avatar_filename = section.settings.tam_avatar_filename
    assign author_ig = section.settings.tam_instagram_url
    assign author_fb = section.settings.tam_facebook_url
    assign author_yt = section.settings.tam_youtube_url
  else
    assign author_name = section.settings.ryan_name | default: 'Ryan'
    assign author_legal_name = section.settings.ryan_legal_name | default: 'Ryan Gow'
    assign author_person_id = section.settings.ryan_person_id | default: '/pages/behind-the-mag#ryan'
    assign author_role = section.settings.ryan_role
    assign author_bio = section.settings.ryan_bio
    assign author_archive_url = section.settings.ryan_archive_url
    assign author_avatar = section.settings.ryan_avatar
    assign author_avatar_filename = section.settings.ryan_avatar_filename
    assign author_ig = section.settings.ryan_instagram_url
    assign author_fb = section.settings.ryan_facebook_url
    assign author_yt = section.settings.ryan_youtube_url
  endif

  assign author_role_override = article.metafields.field_notes.author_role_override
  if author_role_override != blank
    assign author_role = author_role_override
    comment
      In kid mode the override also wins the hero role line, letting an
      editor hand-write the exact line (e.g. when text_type isn't set)
      instead of the text_type auto-compose. The text_type-composed
      kid_role_line remains the default whenever the override is blank.
    endcomment
    if is_kid
      assign kid_role_line = author_role_override
    endif
  endif

  if is_kid
    comment
      Kid mode has no "Meet [Name]." or "By [Name]." heading - a kid post
      is about the creation, not learning about a person. The hero shows
      the series chip + the role line only (set above as kid_role_line).
    endcomment
    assign byline_overlay = blank
  elsif is_guest
    comment
      Guest mode overrides the standard byline overlay. Strip a single
      trailing period from guest_name before appending one so values
      like "Mitch G." don't render as "Meet Mitch G..". Inter subheading
      styling is applied via a CSS modifier class (set below).
    endcomment
    assign trimmed_guest = guest_name
    assign guest_last_char = guest_name | slice: -1
    if guest_last_char == '.'
      assign guest_trim_to = guest_name | size | minus: 1
      assign trimmed_guest = guest_name | slice: 0, guest_trim_to
    endif
    assign byline_overlay = 'Meet ' | append: trimmed_guest | append: '.'
  else
    assign byline_overlay = 'By ' | append: author_name
  endif

  comment
    Build the guest website link element HTML (rendered before the questions,
    injected into the body below). Only for guest posts with guest_website set.
    Site + YouTube handle are shown as clean labels; links open in a new tab
    with rel noopener noreferrer (external editorial links).
  endcomment
  assign guest_link_html = ''
  if is_guest and guest_website != blank
    assign gl_site = guest_website | remove_first: 'https://' | remove_first: 'http://' | remove_first: 'www.' | split: '/' | first
    capture guest_link_html
      echo '<aside class="theinmag-article__guest-link" aria-label="Where to find '
      echo guest_display_name
      echo ' online"><h2 class="theinmag-article__guest-link-heading">Come find '
      echo guest_display_name
      echo '.</h2><p class="theinmag-article__guest-link-sub">Here'
      echo "'"
      echo 's where to follow along with their adventures.</p><ul class="theinmag-article__guest-link-list" role="list"><li class="theinmag-article__guest-link-item"><a class="theinmag-article__guest-link-pill" href="'
      echo guest_website
      echo '" target="_blank" rel="noopener noreferrer"><svg class="theinmag-article__guest-link-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><ellipse cx="12" cy="12" rx="3.6" ry="9"/><path d="M3 12h18M4.6 7.5h14.8M4.6 16.5h14.8"/></svg><span class="theinmag-article__guest-link-stack"><span class="theinmag-article__guest-link-platform">Website</span><span class="theinmag-article__guest-link-url">'
      echo gl_site
      echo '</span></span><svg class="theinmag-article__guest-link-arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 17 17 7M9 7h8v8"/></svg></a></li>'
      if guest_youtube != blank
        assign gl_yt = guest_youtube | remove_first: 'https://' | remove_first: 'http://' | remove_first: 'www.'
        if gl_yt contains '/@'
          assign gl_handle_raw = gl_yt | split: '/@' | last | split: '/' | first | split: '?' | first
          assign gl_handle = '@' | append: gl_handle_raw
        else
          assign gl_handle = gl_yt | split: '/' | first
        endif
        echo '<li class="theinmag-article__guest-link-item"><a class="theinmag-article__guest-link-pill" href="'
        echo guest_youtube
        echo '" target="_blank" rel="noopener noreferrer"><svg class="theinmag-article__guest-link-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="2.5" y="5" width="19" height="14" rx="4"/><path d="M10 9v6l5-3z" fill="currentColor" stroke="none"/></svg><span class="theinmag-article__guest-link-stack"><span class="theinmag-article__guest-link-platform">YouTube</span><span class="theinmag-article__guest-link-url">'
        echo gl_handle
        echo '</span></span><svg class="theinmag-article__guest-link-arrow" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 17 17 7M9 7h8v8"/></svg></a></li>'
      endif
      echo '</ul></aside>'
    endcapture
  endif

  assign rec_heading = section.settings.rec_heading | default: "here's some more we thought you might enjoy"

  comment
    JSON metafield - .value returns the parsed array of {question, answer}
    objects. Block renders + FAQPage JSON-LD emits only when populated.
  endcomment
  assign faq_items = article.metafields.field_notes.faq_items.value
  assign faq_heading = section.settings.faq_heading | default: 'Got questions?'
  assign has_faqs = false
  if faq_items != blank and faq_items.size > 0
    assign has_faqs = true
  endif

  assign rec_1_handle = article.metafields.field_notes.recommendation_1_handle
  assign rec_2_handle = article.metafields.field_notes.recommendation_2_handle
  assign rec_3_handle = article.metafields.field_notes.recommendation_3_handle

  assign rec_1 = blank
  assign rec_2 = blank
  assign rec_3 = blank
  if rec_1_handle != blank
    assign rec_1_key = blog.handle | append: '/' | append: rec_1_handle
    assign rec_1 = articles[rec_1_key]
  endif
  if rec_2_handle != blank
    assign rec_2_key = blog.handle | append: '/' | append: rec_2_handle
    assign rec_2 = articles[rec_2_key]
  endif
  if rec_3_handle != blank
    assign rec_3_key = blog.handle | append: '/' | append: rec_3_handle
    assign rec_3 = articles[rec_3_key]
  endif

  assign curated_count = 0
  if rec_1 != blank
    assign curated_count = curated_count | plus: 1
  endif
  if rec_2 != blank
    assign curated_count = curated_count | plus: 1
  endif
  if rec_3 != blank
    assign curated_count = curated_count | plus: 1
  endif

  assign full_url = request.origin | append: article.url
  assign blog_full_url = request.origin | append: blog.url
  assign root_url = request.origin
  assign og_image_url = ''
  if article.image != blank
    assign og_image_url = article.image | image_url: width: 1800
    assign og_image_url = 'https:' | append: og_image_url
    if og_image_url contains 'https:https:'
      assign og_image_url = og_image_url | replace: 'https:https:', 'https:'
    endif
  endif

  assign hero_darken = section.settings.hero_darken | default: 30
  assign hero_darken_decimal = hero_darken | times: 1.0 | divided_by: 100.0
-%}

<article
  class="theinmag-article{% if is_kid %} theinmag-article--kid{% endif %}"
  data-theinmag-article
  data-author-type="{% if is_kid %}kid{% else %}{{ author_type }}{% endif %}"
  style="--hero-darken: {{ hero_darken_decimal }};"
>
  {%- comment -%}
    Hero + body grid. On desktop the left column is sticky (cover
    image), the right column scrolls (body). On mobile they stack.
  {%- endcomment -%}
  <div class="theinmag-article__grid">
    <div class="theinmag-article__cover-col">
      <div class="theinmag-article__cover-sticky" data-cover-sticky>
        {%- if article.image != blank -%}
          <img
            class="theinmag-article__cover-image"
            srcset="
              {% if article.image.width >= 600 %}{{ article.image | image_url: width: 600 }} 600w,{% endif %}
              {% if article.image.width >= 900 %}{{ article.image | image_url: width: 900 }} 900w,{% endif %}
              {% if article.image.width >= 1200 %}{{ article.image | image_url: width: 1200 }} 1200w,{% endif %}
              {% if article.image.width >= 1600 %}{{ article.image | image_url: width: 1600 }} 1600w,{% endif %}
              {{ article.image | image_url: width: 2000 }} 2000w
            "
            sizes="(min-width: 990px) 50vw, 100vw"
            src="{{ article.image | image_url: width: 1200 }}"
            alt="{{ article.image.alt | default: article.title | escape }}"
            loading="eager"
            fetchpriority="high"
            width="{{ article.image.width }}"
            height="{{ article.image.height }}"
          >
        {%- else -%}
          <span class="theinmag-article__cover-placeholder" aria-hidden="true"></span>
        {%- endif -%}

        <div class="theinmag-article__overlay" data-hero-overlay aria-hidden="false">
          <h1 class="theinmag-article__overlay-title">{{ display_title }}</h1>
          {%- if is_kid -%}
            {%- if kid_series_chip != blank -%}
              <span class="theinmag-article__overlay-topic">{{ kid_series_chip }}</span>
            {%- endif -%}
            {%- if kid_role_line != blank -%}
              <p class="theinmag-article__overlay-role theinmag-article__overlay-role--kid">{{ kid_role_line }}</p>
            {%- endif -%}
          {%- else -%}
            {%- if primary_topic != blank -%}
              <span class="theinmag-article__overlay-topic">{{ primary_topic }}</span>
            {%- endif -%}
            {%- if byline_overlay != blank -%}
              <p class="theinmag-article__overlay-byline{% if is_guest %} theinmag-article__overlay-byline--guest{% endif %}">{{ byline_overlay }}</p>
            {%- endif -%}
            {%- if author_role != blank -%}
              <p class="theinmag-article__overlay-role">{{ author_role }}</p>
            {%- endif -%}
          {%- endif -%}
        </div>
      </div>
    </div>

    <div class="theinmag-article__body-col">
      <div class="theinmag-article__body-inner">
        <header class="theinmag-article__byline-row">
          <span class="theinmag-article__byline-meta">
            {%- if primary_topic != blank -%}
              <span class="theinmag-article__byline-topic">{{ primary_topic }}</span>
            {%- endif -%}
            {%- if read_time_label != blank -%}
              <span class="theinmag-article__byline-read">{{ read_time_label }}</span>
            {%- endif -%}
            {%- if article.published_at != blank -%}
              <span class="theinmag-article__byline-date">{{ article.published_at | date: '%b %-d, %Y' }}</span>
            {%- endif -%}
          </span>
        </header>

        {%- comment -%}
          Quick read row: holds the Quick read card + guest portrait
          as siblings. Default flow stacks them column-wise (mobile);
          desktop flips to row so the portrait sits beside the card.
        {%- endcomment -%}
        {%- if quick_answer != blank or show_guest_portrait -%}
          <div class="theinmag-article__quick-row">
            {%- if quick_answer != blank -%}
              <aside class="theinmag-article__quick-read" aria-label="Quick read">
                <span class="theinmag-article__quick-read-label">Quick read</span>
                <div class="theinmag-article__quick-read-body rte">{{ quick_answer }}</div>
                {%- comment -%}
                  Kid attribution under the Quick read card. The hero byline
                  scrolls away, so repeat "Written by [name], age [age].
                  [region]" here where it stays visible alongside the writing.
                {%- endcomment -%}
                {%- if is_kid and kid_first_name != blank -%}
                  <p class="theinmag-article__kid-byline">Written by {{ kid_first_name }}{% if kid_age != blank %}, age {{ kid_age }}{% endif %}{% if kid_region != blank %}. {{ kid_region }}{% endif %}</p>
                {%- endif -%}
              </aside>
            {%- endif -%}

            {%- if show_guest_portrait -%}
              <figure class="theinmag-article__guest-portrait">
                <img
                  class="theinmag-article__guest-portrait-img"
                  src="{{ guest_avatar | image_url: width: 240 }}"
                  alt="{{ guest_name | default: article.title | escape }}"
                  width="120"
                  height="120"
                  loading="lazy"
                >
                {%- if guest_name != blank -%}
                  <figcaption class="theinmag-article__guest-portrait-caption">{{ guest_name }}</figcaption>
                {%- endif -%}
              </figure>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- liquid
          comment
            Real Kids Voices posts open with an editor "A note from Field
            Notes:" paragraph in the body. The kid post should launch
            straight into the kid's own writing - the same context already
            lives in the Quick read card above - so on kid posts we strip
            that leading note paragraph when it's present as the first <p>.
          endcomment
          assign body_content = article.content
          if is_kid
            assign first_seg = body_content | split: '</p>' | first
            if first_seg contains 'note from Field Notes'
              assign note_para = first_seg | append: '</p>'
              assign body_content = body_content | remove_first: note_para
            endif
          endif
        -%}
        <div class="theinmag-article__body rte">
          {%- comment -%}
            The guest "come find them" signpost (guest_link_html) was
            RELOCATED 2026-09-08 out of the body to the foot of the guest
            column (after the advice block, before the series-info card).
            The body now renders exactly as authored.
          {%- endcomment -%}
          {{ body_content }}
        </div>

        {%- if advice_block_text != blank -%}
          <aside class="theinmag-article__advice" aria-label="Advice">
            {%- if is_guest and guest_display_name != blank -%}
              <span class="theinmag-article__advice-label">{{ guest_display_name }}'s advice.</span>
            {%- else -%}
              <span class="theinmag-article__advice-label">A bit of advice.</span>
            {%- endif -%}
            <div class="theinmag-article__advice-body rte">{{ advice_block_text | newline_to_br }}</div>
          </aside>
        {%- endif -%}

        {%- if has_faqs -%}
          <section
            class="theinmag-article__faq"
            data-theinmag-article-faq
            aria-labelledby="theinmag-article-faq-heading"
          >
            <h2 id="theinmag-article-faq-heading" class="theinmag-article__faq-heading">{{ faq_heading }}</h2>
            <ul class="theinmag-article__faq-list" role="list">
              {%- for item in faq_items -%}
                {%- liquid
                  assign panel_id = 'theinmag-article-faq-answer-' | append: section.id | append: '-' | append: forloop.index
                -%}
                <li class="theinmag-article__faq-item">
                  <h3 class="theinmag-article__faq-question-heading">
                    <button
                      type="button"
                      class="theinmag-article__faq-trigger"
                      aria-expanded="false"
                      aria-controls="{{ panel_id }}"
                      data-theinmag-article-faq-trigger
                    >
                      <span class="theinmag-article__faq-question">{{ item.question }}</span>
                      <span class="theinmag-article__faq-caret" aria-hidden="true"></span>
                    </button>
                  </h3>
                  <div
                    id="{{ panel_id }}"
                    class="theinmag-article__faq-answer-wrap"
                    data-theinmag-article-faq-answer
                    data-open="false"
                  >
                    <div class="theinmag-article__faq-answer">
                      {{ item.answer }}
                    </div>
                  </div>
                </li>
              {%- endfor -%}
            </ul>
          </section>
        {%- endif -%}

        {%- comment -%}
          Guest "come find them" signpost, RELOCATED here 2026-09-08 to the
          foot of the guest column: after the advice block, before the
          series-info card. Renders only for guest posts with guest_website
          set (guest_link_html non-blank). Sits as a body-inner sibling; the
          lavender pill card carries its own background and spacing.
        {%- endcomment -%}
        {%- if guest_link_html != blank -%}
          {{ guest_link_html }}
        {%- endif -%}

        {%- comment -%}
          Series strip — sign-off below FAQ on republished-series posts.
          Sits between the FAQ block and the about-author / closing CTA
          stack so it reads as "this was Real Jobs, Real People" rather
          than introducing the post.
        {%- endcomment -%}
        {%- if series_name != blank -%}
          {%- comment -%}
            Real Jobs default (2026-09-08): when series_strip_text is left
            blank on a "Real Jobs, Real People" post, fall back to the
            standard two-sentence blurb so every current and future Real
            Jobs post carries it with no manual metafield step. The guard is
            the exact series_name string, so no other series or post type
            (kid posts, Real Kids Voices, storybooks, standard posts) is
            affected: their strip still shows only what their metafield holds.
          {%- endcomment -%}
          {%- assign series_strip_effective = series_strip_text -%}
          {%- if series_strip_effective == blank and series_name == 'Real Jobs, Real People' -%}
            {%- assign series_strip_effective = 'Every few months we sit down with someone whose work we think kids should know about. In the mag, we call this section Meet the Professional.' -%}
          {%- endif -%}
          <aside class="theinmag-article__series-strip" aria-label="About this series">
            <span class="theinmag-article__series-name">{{ series_name }}</span>
            {%- if series_strip_effective != blank -%}
              <p class="theinmag-article__series-text">{{ series_strip_effective | newline_to_br }}</p>
            {%- endif -%}
          </aside>
        {%- endif -%}

        {%- if is_kid -%}
          {%- comment -%}
            Kid contributor mode: no author bio card at all. The author
            is the kid, and kids have no author page, bio, or avatar on
            the site (locked privacy rule). Attribution lives entirely in
            the hero series chip + role line.
          {%- endcomment -%}
        {%- elsif is_guest -%}
          {%- comment -%}
            Guest mode: skip the about-the-author card. The hero
            overlay byline + role line + cover photo carry attribution.
            A second avatar would feel redundant against the photo.
          {%- endcomment -%}
        {%- else -%}
          <aside class="theinmag-article__about" aria-label="About the author">
            <div class="theinmag-article__about-header">
              <div class="theinmag-article__about-avatar">
                {%- liquid
                  assign about_avatar_url = ''
                  if author_avatar != blank
                    assign about_avatar_url = author_avatar | image_url: width: 240
                  elsif author_avatar_filename != blank
                    assign about_avatar_url = author_avatar_filename | asset_url
                  endif
                -%}
                {%- if about_avatar_url != blank -%}
                  <img
                    src="{{ about_avatar_url }}"
                    alt="{{ author_name | escape }}"
                    width="120"
                    height="120"
                    loading="lazy"
                  >
                {%- else -%}
                  <span class="theinmag-article__avatar-fallback theinmag-article__avatar-fallback--lg" aria-hidden="true">{{ author_name | slice: 0, 1 }}</span>
                {%- endif -%}
              </div>
              <div class="theinmag-article__about-identity">
                <h2 class="theinmag-article__about-name">{{ author_name }}</h2>
                {%- if author_role != blank -%}
                  <p class="theinmag-article__about-role">{{ author_role }}</p>
                {%- endif -%}
              </div>
            </div>

            {%- if author_bio != blank -%}
              <p class="theinmag-article__about-bio">{{ author_bio }}</p>
            {%- endif -%}

            <div class="theinmag-article__about-actions">
              {%- if author_archive_url != blank -%}
                <a class="theinmag-article__about-link" href="{{ author_archive_url }}">More from {{ author_name }}</a>
              {%- endif -%}
              {%- if author_ig != blank or author_fb != blank or author_yt != blank -%}
                <div class="theinmag-article__about-socials">
                  {%- if author_ig != blank -%}
                    <a class="theinmag-article__about-social" href="{{ author_ig }}" aria-label="{{ author_name | escape }} on Instagram" rel="noopener" target="_blank">IG</a>
                  {%- endif -%}
                  {%- if author_fb != blank -%}
                    <a class="theinmag-article__about-social" href="{{ author_fb }}" aria-label="{{ author_name | escape }} on Facebook" rel="noopener" target="_blank">FB</a>
                  {%- endif -%}
                  {%- if author_yt != blank -%}
                    <a class="theinmag-article__about-social" href="{{ author_yt }}" aria-label="{{ author_name | escape }} on YouTube" rel="noopener" target="_blank">YT</a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </aside>
        {%- endif -%}

        {%- if closing_cta_label != blank and closing_cta_url != blank -%}
          <div class="theinmag-article__closing-cta">
            <a class="theinmag-article__closing-cta-link" href="{{ closing_cta_url }}">{{ closing_cta_label }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%}
    Photo mosaic strip (STYLE UPDATE 2026-09-08, Ryan approved). Justified
    rows, Flickr / Google Photos style: every row fills the full viewport
    width, each image keeps its TRUE aspect ratio and the row height varies
    to justify. No cropping, no distortion (protects the book covers and
    their text). The strip is FULL-BLEED (100vw, breaking out of the article
    column), tiles have sharp corners (radius 0) and a thin ~6px cream gutter
    between every image, horizontal and vertical. Renders only when
    field_notes.gallery has entries. Each tile is a button that opens the
    shared lightbox; captions live in the lightbox only. Alt is required on
    every tile. The row geometry (greedy justified rows) is computed in the
    section script below and recomputed on resize; smaller target row height
    on mobile. If a photo object carries numeric `w` and `h` the aspect ratio
    is emitted as data-ar so the layout is correct before the images load;
    otherwise the script probes each image's natural dimensions and lays out
    as they resolve.
  {%- endcomment -%}
  {%- comment -%}
    Feature-mosaic opt-in (2026-09-09). A gallery item may carry
    "feature": true. Its PRESENCE flips this post to the feature layout:
    that tile renders as a large block on the RIGHT spanning N rows, the
    other tiles flow to its left in N justified rows (geometry solved in
    the mosaic script below). The feature item is placed FIRST in the
    array so it leads DOM, lightbox and focus order. No feature flag on
    any item = the post renders as plain justified rows, exactly as
    before, so every other post is untouched.
  {%- endcomment -%}
  {%- assign has_feature = false -%}
  {%- for photo in gallery_photos -%}
    {%- if photo.feature == true or photo.feature == 'true' -%}
      {%- assign has_feature = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if gallery_photos.size > 0 -%}
    <section class="theinmag-article__gallery" aria-label="Photo gallery">
      <div
        class="theinmag-article__gallery-grid"
        data-theinmag-gallery
        {% if has_feature %}data-has-feature="true"{% endif %}
      >
        {%- for photo in gallery_photos -%}
          {%- if photo.file == blank -%}{%- continue -%}{%- endif -%}
          {%- assign photo_src = photo.file | asset_url -%}
          {%- assign photo_alt = photo.alt | default: photo.caption -%}
          {%- assign photo_ar = '' -%}
          {%- if photo.w != blank and photo.h != blank and photo.h != 0 -%}
            {%- assign photo_ar = photo.w | times: 1.0 | divided_by: photo.h -%}
          {%- endif -%}
          {%- assign photo_is_feature = false -%}
          {%- if photo.feature == true or photo.feature == 'true' -%}
            {%- assign photo_is_feature = true -%}
          {%- endif -%}
          <button
            type="button"
            class="theinmag-article__gallery-tile{% if photo_is_feature %} theinmag-article__gallery-tile--feature{% endif %}"
            data-theinmag-gallery-tile
            {% if photo_is_feature %}data-feature="true"{% endif %}
            data-full="{{ photo_src }}"
            data-caption="{{ photo.caption | escape }}"
            {% if photo_ar != blank %}data-ar="{{ photo_ar }}"{% endif %}
            aria-label="View photo: {{ photo_alt | escape }}"
          >
            <img
              class="theinmag-article__gallery-img"
              src="{{ photo_src }}"
              alt="{{ photo_alt | escape }}"
              loading="lazy"
              decoding="async"
            >
            <span class="theinmag-article__gallery-glyph" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
            </span>
          </button>
        {%- endfor -%}
      </div>
    </section>

    <div class="theinmag-article__gallery-lightbox" data-theinmag-gallery-lightbox role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
      <p class="theinmag-article__gallery-lb-count" data-theinmag-gallery-count></p>
      <button type="button" class="theinmag-article__gallery-lb-btn theinmag-article__gallery-lb-close" data-theinmag-gallery-close aria-label="Close photo viewer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"></line><line x1="18" y1="6" x2="6" y2="18"></line></svg>
      </button>
      <button type="button" class="theinmag-article__gallery-lb-btn theinmag-article__gallery-lb-prev" data-theinmag-gallery-prev aria-label="Previous photo">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true"><polyline points="15 6 9 12 15 18"></polyline></svg>
      </button>
      <button type="button" class="theinmag-article__gallery-lb-btn theinmag-article__gallery-lb-next" data-theinmag-gallery-next aria-label="Next photo">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true"><polyline points="9 6 15 12 9 18"></polyline></svg>
      </button>
      <div class="theinmag-article__gallery-lb-stage" data-theinmag-gallery-stage>
        <figure class="theinmag-article__gallery-lb-fig">
          <img class="theinmag-article__gallery-lb-img" data-theinmag-gallery-image alt="">
          <figcaption class="theinmag-article__gallery-lb-cap" data-theinmag-gallery-caption></figcaption>
        </figure>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%}
    Video companion, relocated 2026-09-08 to sit UNDER the photo mosaic (at
    the very bottom of the post, before the recommendations) per Ryan's call.
    Centred in its own container so it does not go full-bleed like the mosaic.
    Renders only when field_notes.youtube_url is set. A VideoObject JSON-LD
    block is emitted alongside so the paired video can rank as a video result.
  {%- endcomment -%}
  {%- if youtube_id != blank -%}
    <div class="theinmag-article__video-standalone">
      <div class="theinmag-article__video-standalone-inner">
        <aside class="theinmag-article__video" aria-label="Video version of this post">
          <h2 class="theinmag-article__video-heading">{{ section.settings.video_heading | default: 'rather watch than read?' }}</h2>
          <div class="theinmag-article__video-frame">
            <iframe
              src="https://www.youtube-nocookie.com/embed/{{ youtube_id }}"
              title="{{ display_title | escape }} (video)"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
            ></iframe>
          </div>
          <a class="theinmag-article__video-link" href="{{ youtube_url }}" target="_blank" rel="noopener">watch on YouTube</a>
        </aside>
      </div>
    </div>

    {%- liquid
      assign video_desc = article.metafields.global.description_tag
      if video_desc == blank
        assign video_desc = quick_answer | strip_html | strip
      endif
      if video_desc == blank
        assign video_desc = display_title
      endif
      assign video_upload = article.published_at | default: article.created_at
    -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "VideoObject",
      "name": {{ display_title | strip_html | strip | json }},
      "description": {{ video_desc | json }},
      "thumbnailUrl": ["https://i.ytimg.com/vi/{{ youtube_id }}/hqdefault.jpg"],
      "uploadDate": {{ video_upload | date: '%Y-%m-%d' | json }},
      "embedUrl": "https://www.youtube-nocookie.com/embed/{{ youtube_id }}",
      "contentUrl": {{ youtube_url | json }},
      "publisher": {
        "@type": "Organization",
        "name": "theINmag",
        "url": {{ root_url | json }}
      }
    }
    </script>
  {%- endif -%}

  <section class="theinmag-article__recommend" aria-labelledby="theinmag-article-rec-heading">
    <div class="theinmag-article__recommend-inner">
      <header class="theinmag-article__recommend-header">
        <h2 id="theinmag-article-rec-heading" class="theinmag-article__recommend-heading">{{ rec_heading }}</h2>
        {%- if series_hub_url != blank and series_hub_label != blank -%}
          <a class="theinmag-article__recommend-link theinmag-article__recommend-link--series" href="{{ series_hub_url }}">
            <span>{{ series_hub_label }}</span>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="13 6 19 12 13 18"></polyline></svg>
          </a>
        {%- endif -%}
        <a class="theinmag-article__recommend-link" href="/blogs/field-notes" aria-label="Browse all field notes">
          <span>browse all field notes</span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="13 6 19 12 13 18"></polyline></svg>
        </a>
      </header>
      <div class="theinmag-article__recommend-grid">
        {%- liquid
          comment
            Four-slot recommendation grid (bumped from 3 -> 4 on
            2026-05-18 - desktop grid already supports 4 columns, the
            cap was purely a Liquid constraint). Slots 1-3 are
            independently curatable via field_notes.recommendation_
            {1,2,3}_handle. Slot 4 always auto-fills. Any blank curated
            slot also auto-fills: same primary_topic newest-first, then
            any recent post. The current article is always excluded.

            Dedupe by article ID — every rendered card's id is appended
            to rendered_ids (comma-delimited, comma-padded so substring
            matches catch only complete entries). No card can appear
            twice, whether the dupe came from a typo in the curated
            handles or a logic gap in the auto-fill.
          endcomment
          assign target = 4
          assign filled_count = 0
          assign rendered_ids = ','
        -%}

        {%- comment -%} Slot 1 — curated {%- endcomment -%}
        {%- if rec_1 != blank -%}
          {%- capture id_check -%},{{ rec_1.id }},{%- endcapture -%}
          {%- unless rendered_ids contains id_check -%}
            {%- render 'theinmag-article-rec-card', rec: rec_1 -%}
            {%- assign rendered_ids = rendered_ids | append: rec_1.id | append: ',' -%}
            {%- assign filled_count = filled_count | plus: 1 -%}
          {%- endunless -%}
        {%- endif -%}

        {%- comment -%} Slot 2 — curated {%- endcomment -%}
        {%- if rec_2 != blank -%}
          {%- capture id_check -%},{{ rec_2.id }},{%- endcapture -%}
          {%- unless rendered_ids contains id_check -%}
            {%- render 'theinmag-article-rec-card', rec: rec_2 -%}
            {%- assign rendered_ids = rendered_ids | append: rec_2.id | append: ',' -%}
            {%- assign filled_count = filled_count | plus: 1 -%}
          {%- endunless -%}
        {%- endif -%}

        {%- comment -%} Slot 3 — curated {%- endcomment -%}
        {%- if rec_3 != blank -%}
          {%- capture id_check -%},{{ rec_3.id }},{%- endcapture -%}
          {%- unless rendered_ids contains id_check -%}
            {%- render 'theinmag-article-rec-card', rec: rec_3 -%}
            {%- assign rendered_ids = rendered_ids | append: rec_3.id | append: ',' -%}
            {%- assign filled_count = filled_count | plus: 1 -%}
          {%- endunless -%}
        {%- endif -%}

        {%- comment -%} Auto-fill step A: same primary_topic, newest-first
          (blog.articles iterates published_at DESC by default). {%- endcomment -%}
        {%- if filled_count < target -%}
          {%- for related in blog.articles -%}
            {%- if filled_count >= target -%}{%- break -%}{%- endif -%}
            {%- if related.id == article.id -%}{%- continue -%}{%- endif -%}
            {%- capture id_check -%},{{ related.id }},{%- endcapture -%}
            {%- if rendered_ids contains id_check -%}{%- continue -%}{%- endif -%}
            {%- liquid
              assign related_topic = related.metafields.field_notes.primary_topic
              if related_topic == blank
                assign related_topic = related.tags.first
              endif
              assign topic_match = false
              if primary_topic != blank and related_topic == primary_topic
                assign topic_match = true
              endif
            -%}
            {%- if topic_match -%}
              {%- render 'theinmag-article-rec-card', rec: related -%}
              {%- assign rendered_ids = rendered_ids | append: related.id | append: ',' -%}
              {%- assign filled_count = filled_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {%- comment -%} Auto-fill step B: any recent post, ID-deduped
          against everything rendered so far. {%- endcomment -%}
        {%- if filled_count < target -%}
          {%- for related in blog.articles -%}
            {%- if filled_count >= target -%}{%- break -%}{%- endif -%}
            {%- if related.id == article.id -%}{%- continue -%}{%- endif -%}
            {%- capture id_check -%},{{ related.id }},{%- endcapture -%}
            {%- if rendered_ids contains id_check -%}{%- continue -%}{%- endif -%}
            {%- render 'theinmag-article-rec-card', rec: related -%}
            {%- assign rendered_ids = rendered_ids | append: related.id | append: ',' -%}
            {%- assign filled_count = filled_count | plus: 1 -%}
          {%- endfor -%}
        {%- endif -%}

        {%- comment -%} Visual placeholder if the grid is still empty
          (no curated picks AND no other posts in the blog). Four cards
          to match the new target; each links to the field-notes index. {%- endcomment -%}
        {%- if filled_count == 0 -%}
          {%- assign placeholder_topics = 'Wellbeing|Creativity|Behind the mag|Outdoors' | split: '|' -%}
          {%- assign placeholder_titles = "the case for boredom|things to draw when you're stuck|behind mag10|100 things to spot on a walk" | split: '|' -%}
          {%- assign placeholder_images = 'blog-image-universal-05.jpg|blog-image-universal-04.jpg|blog-image-universal-08.jpg|blog-image-universal-02.jpg' | split: '|' -%}
          {%- for slot in (0..3) -%}
            {%- liquid
              assign p_topic = placeholder_topics[slot]
              assign p_title = placeholder_titles[slot]
              assign p_image = placeholder_images[slot]
            -%}
            <a class="theinmag-article__rec-card" href="/blogs/field-notes" aria-label="Browse all field notes">
              <span class="theinmag-article__rec-cover">
                <img class="theinmag-article__rec-image" src="{{ p_image | asset_url }}" alt="theINmag field notes - {{ p_title | escape }}" loading="lazy" width="800" height="500">
              </span>
              <span class="theinmag-article__rec-body">
                <span class="theinmag-article__rec-topic">{{ p_topic }}</span>
                <span class="theinmag-article__rec-title">{{ p_title }}</span>
              </span>
            </a>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </section>
</article>

{%- comment -%} Article + BreadcrumbList JSON-LD. We do NOT use Shopify's
  default `article | structured_data` because we want Person schema with
  sameAs socials for Ryan/Tam, a minimal Person (first name only, no url
  or sameAs) for kid contributors, and Quick answer wired into the
  description field. {%- endcomment -%}

{%- liquid
  assign schema_description = quick_answer | strip_html | strip_newlines | escape
  if schema_description == blank
    assign schema_description = article.excerpt | strip_html | escape
  endif
  if schema_description == blank
    assign schema_description = article.content | strip_html | truncatewords: 30 | escape
  endif

  assign org_name = section.settings.org_name | default: 'theINmag'
  assign org_url = section.settings.org_url | default: 'https://theinmag.com.au'
  assign org_logo_url = ''
  if section.settings.org_logo != blank
    assign org_logo_url = section.settings.org_logo | image_url: width: 600
  elsif section.settings.org_logo_filename != blank
    assign org_logo_url = section.settings.org_logo_filename | asset_url
  endif
  if org_logo_url == blank
    assign org_logo_url = 'theINmag_logo.png' | asset_url | prepend: 'https:'
  endif

  comment
    Absolute https avatar URL for the founder author's Person.image
    (E-E-A-T). Mirrors the og_image_url protocol handling. Kids never
    reach this - is_kid authors carry no avatar by the locked privacy rule.
  endcomment
  assign author_image_url = ''
  if author_avatar != blank
    assign author_image_url = author_avatar | image_url: width: 600
  elsif author_avatar_filename != blank
    assign author_image_url = author_avatar_filename | asset_url
  endif
  if author_image_url != blank
    unless author_image_url contains 'http'
      assign author_image_url = author_image_url | prepend: 'https:'
    endunless
    if author_image_url contains 'https:https:'
      assign author_image_url = author_image_url | replace: 'https:https:', 'https:'
    endif
  endif
-%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": {{ full_url | json }}
  },
  "headline": {{ display_title | json }},
  "description": {{ schema_description | json }},
  {%- if article.image != blank -%}
  "image": [
    {{ og_image_url | json }}
  ],
  {%- endif -%}
  "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "author":
  {%- if is_kid -%}
    {%- comment -%}
      Kid contributor: a Person entity named by first name only. No @id,
      no url, no sameAs - kids have no public author page or social
      profiles. This is the schema author for the Article.
    {%- endcomment -%}
    {
      "@type": "Person",
      "name": {{ kid_first_name | json }}
    }
  {%- else -%}
    {
      "@type": "Person",
      {%- comment -%}
        @id consolidates the author entity across the site. name uses
        the legal form (Ryan Gow / Tam Gow) for E-E-A-T entity
        consolidation; the visible byline keeps the Ryan G. / Tam B.
        editorial form via author_name.
      {%- endcomment -%}
      "@id": {{ author_person_id | prepend: root_url | json }},
      "name": {{ author_legal_name | json }}
      {%- if author_image_url != blank -%}
        ,"image": {{ author_image_url | json }}
      {%- endif -%}
      {%- if author_role != blank -%}
        ,"jobTitle": {{ author_role | json }}
      {%- endif -%}
      {%- if author_archive_url != blank -%}
        ,"url": {{ author_archive_url | prepend: root_url | json }}
      {%- endif -%}
      {%- assign sameas_count = 0 -%}
      {%- if author_ig != blank %}{%- assign sameas_count = sameas_count | plus: 1 -%}{% endif -%}
      {%- if author_fb != blank %}{%- assign sameas_count = sameas_count | plus: 1 -%}{% endif -%}
      {%- if author_yt != blank %}{%- assign sameas_count = sameas_count | plus: 1 -%}{% endif -%}
      {%- if sameas_count > 0 -%}
        ,"sameAs": [
          {%- assign first = true -%}
          {%- if author_ig != blank -%}{{ author_ig | json }}{%- assign first = false -%}{%- endif -%}
          {%- if author_fb != blank -%}{%- unless first -%},{%- endunless -%}{{ author_fb | json }}{%- assign first = false -%}{%- endif -%}
          {%- if author_yt != blank -%}{%- unless first -%},{%- endunless -%}{{ author_yt | json }}{%- endif -%}
        ]
      {%- endif -%}
    }
  {%- endif -%},
  "publisher": {
    "@type": "Organization",
    "name": {{ org_name | json }},
    "url": {{ org_url | json }}
    {%- if org_logo_url != blank -%}
      ,"logo": {
        "@type": "ImageObject",
        "url": {{ org_logo_url | json }}
      }
    {%- endif -%}
  }
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": {{ root_url | json }}
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": {{ blog.title | json }},
      "item": {{ blog_full_url | json }}
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": {{ display_title | json }},
      "item": {{ full_url | json }}
    }
  ]
}
</script>

{%- if youtube_id != blank -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": {{ display_title | json }},
  "description": {{ quick_answer | default: article.excerpt_or_content | strip_html | truncate: 300 | json }},
  "thumbnailUrl": "https://i.ytimg.com/vi/{{ youtube_id }}/hqdefault.jpg",
  "uploadDate": {{ article.published_at | date: '%Y-%m-%d' | json }},
  "embedUrl": "https://www.youtube-nocookie.com/embed/{{ youtube_id }}",
  "url": {{ youtube_url | json }}
}
</script>
{%- endif -%}

{%- if has_faqs -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for item in faq_items -%}
      {
        "@type": "Question",
        "name": {{ item.question | strip_html | strip | json }},
        "acceptedAnswer": {
          "@type": "Answer",
          "text": {{ item.answer | strip_html | strip | json }}
        }
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{%- stylesheet -%}
  .theinmag-article {
    --hero-progress: 0;
    --hero-darken: 0.3;
    --color-cream: #FBF6EA;
    --color-ink: #2A1F3D;
    --color-purple-dark: #5D3A7A;
    --color-teal: #2D6878;
    --color-rule: rgba(42, 31, 61, 0.18);
    background-color: var(--color-cream);
    color: var(--color-ink);
  }

  .theinmag-article__grid {
    display: grid;
    grid-template-columns: 1fr;
    align-items: stretch;
  }

  @media (min-width: 990px) {
    .theinmag-article__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  /* ================================================================
     Cover column - sticky on desktop, natural on mobile
     ================================================================ */
  .theinmag-article__cover-col {
    position: relative;
    background-color: var(--color-ink);
  }

  .theinmag-article__cover-sticky {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  @media (min-width: 750px) {
    .theinmag-article__cover-sticky {
      aspect-ratio: 3 / 4;
    }
  }

  @media (min-width: 990px) {
    .theinmag-article__cover-sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      aspect-ratio: auto;
    }
  }

  .theinmag-article__cover-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(calc(1 - var(--hero-darken) + (var(--hero-progress) * var(--hero-darken))));
    transform: scale(calc(1.04 - (var(--hero-progress) * 0.04)));
    transition: filter 0.05s linear, transform 0.05s linear;
    transform-origin: center center;
    will-change: filter, transform;
  }

  /* Real Kids Voices covers are the kid's artwork - anchor the crop to
     the top so the top of the piece (often the subject, e.g. the
     giraffe's head in Mr. Bongo) stays in frame instead of being cropped
     out by the cover fill. */
  .theinmag-article--kid .theinmag-article__cover-image {
    object-position: top center;
  }

  .theinmag-article__cover-placeholder {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #5D3A7A 0%, #C9543E 100%);
  }

  /* ================================================================
     Hero overlay (title + byline + topic on the image)
     White text on a soft scrim - per the white-on-scrim memory, never
     coloured pills on photography surfaces.
     ================================================================ */
  .theinmag-article__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: clamp(24px, 4vw, 56px);
    color: #FFFFFF;
    background: linear-gradient(
      to bottom,
      rgba(20, 14, 30, 0.55) 0%,
      rgba(20, 14, 30, 0.18) 45%,
      rgba(20, 14, 30, 0) 80%
    );
    opacity: calc(1 - var(--hero-progress));
    transform: translateY(calc(var(--hero-progress) * -32px)) scale(calc(1 + (var(--hero-progress) * 0.04)));
    transition: opacity 0.05s linear, transform 0.05s linear;
    transform-origin: left center;
    pointer-events: none;
    text-shadow: 0 1px 12px rgba(20, 14, 30, 0.35);
    will-change: opacity, transform;
  }

  .theinmag-article__overlay-title {
    margin: 0 0 clamp(12px, 1.6vw, 20px);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: clamp(28px, 4.5vw, 52px);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: #FFFFFF;
    max-width: 20ch;
  }

  .theinmag-article__overlay-topic {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: clamp(10px, 1.2vw, 14px);
    opacity: 0.92;
  }

  .theinmag-article__overlay-byline {
    margin: 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 500;
    font-size: clamp(13px, 1.3vw, 15px);
    line-height: 1.4;
    letter-spacing: 0.01em;
    color: #FFFFFF;
    opacity: 0.92;
    max-width: 32ch;
  }

  /* Guest mode "Meet [Name]." byline — Inter 700 at the body-H2
     subheading scale so it reads as a proper editorial subheading
     rather than a stylised moment. Sits over the photo with the
     standard text-shadow scrim from the parent overlay. */
  .theinmag-article__overlay-byline--guest {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: clamp(18px, 1.9vw, 22px);
    line-height: 1.25;
    letter-spacing: -0.005em;
    opacity: 1;
    margin-bottom: 4px;
  }

  .theinmag-article__overlay-role {
    margin: 4px 0 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: clamp(12px, 1.15vw, 13px);
    line-height: 1.4;
    letter-spacing: 0.01em;
    color: #FFFFFF;
    opacity: 0.82;
    max-width: 32ch;
  }

  /* Kid-contributor role line is the sole attribution on the post (no
     "Meet"/"By" heading sits above it), so it reads a touch larger and
     less dim than the founder role line, and gets room to breathe. */
  .theinmag-article__overlay-role--kid {
    margin-top: clamp(8px, 1vw, 12px);
    font-size: clamp(13px, 1.25vw, 15px);
    opacity: 0.95;
    max-width: 46ch;
  }

  /* ================================================================
     Body column - article content + bylines + Quick answer + about
     ================================================================ */
  .theinmag-article__body-col {
    background-color: var(--color-cream);
    padding: clamp(40px, 6vw, 96px) clamp(40px, 6vw, 96px) clamp(56px, 7vw, 112px) clamp(20px, 4vw, 56px);
  }

  .theinmag-article__body-inner {
    max-width: 64ch;
    margin: 0 auto;
  }

  /* ----- Top byline chip (just topic / read time / date) ----- */
  .theinmag-article__byline-row {
    margin: 0 0 clamp(28px, 3vw, 40px);
    padding-bottom: clamp(20px, 2.4vw, 28px);
    border-bottom: 1px solid var(--color-rule);
  }

  /* Avatar styles for the bottom About-the-author card (founders only). */
  .theinmag-article__avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .theinmag-article__avatar-fallback {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: 22px;
    color: var(--color-purple-dark);
  }

  .theinmag-article__avatar-fallback--lg {
    font-size: clamp(28px, 3vw, 36px);
  }

  .theinmag-article__byline-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 500;
    font-size: 13px;
    line-height: 1.3;
    color: var(--color-ink);
    opacity: 0.7;
  }

  .theinmag-article__byline-meta > * + *::before {
    content: '·';
    margin-right: 8px;
    opacity: 0.6;
  }

  .theinmag-article__byline-topic {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 11px;
    font-weight: 600;
    color: var(--color-purple-dark);
    opacity: 1;
  }

  /* ----- Quick read card (white tile with shadow, narrower than body
     for a "feature" feel) ----- */
  .theinmag-article__quick-read {
    margin: 0 auto clamp(28px, 3vw, 40px);
    max-width: 84%;
    padding: clamp(20px, 2.4vw, 28px) clamp(22px, 2.6vw, 32px);
    background-color: #FFFFFF;
    border-radius: 16px;
    box-shadow: 0 2px 14px rgba(123, 79, 158, 0.10);
  }

  .theinmag-article__quick-read-label {
    display: inline-block;
    margin-bottom: clamp(8px, 1vw, 12px);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-purple-dark);
  }

  .theinmag-article__quick-read-body {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-style: italic;
    font-size: clamp(13px, 1.2vw, 14px);
    line-height: 1.55;
    color: var(--color-ink);
  }

  .theinmag-article__quick-read-body p {
    margin: 0 0 0.6em;
  }

  .theinmag-article__quick-read-body p:last-child {
    margin-bottom: 0;
  }

  .theinmag-article__kid-byline {
    margin: clamp(12px, 1.4vw, 16px) 0 0;
    padding-top: clamp(12px, 1.4vw, 16px);
    border-top: 1px solid rgba(123, 79, 158, 0.14);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: clamp(12px, 1.1vw, 13px);
    line-height: 1.5;
    color: var(--color-purple-dark);
  }

  /* ----- Article body (rendered HTML from Shopify RTE) ----- */
  .theinmag-article__body {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: clamp(14px, 1.2vw, 15px);
    line-height: 1.65;
    color: var(--color-ink);
  }

  .theinmag-article__body p {
    margin: 0 0 1.2em;
  }

  .theinmag-article__body h2 {
    margin: 1.6em 0 0.6em;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: clamp(18px, 1.9vw, 22px);
    line-height: 1.25;
    letter-spacing: -0.005em;
    color: var(--color-ink);
  }

  .theinmag-article__body h3 {
    margin: 1.4em 0 0.5em;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: clamp(15px, 1.5vw, 17px);
    line-height: 1.3;
    color: var(--color-ink);
  }

  .theinmag-article__body a {
    color: var(--color-teal);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    transition: color 0.15s ease, text-decoration-thickness 0.15s ease;
  }

  .theinmag-article__body a:hover,
  .theinmag-article__body a:focus-visible {
    color: var(--color-purple-dark);
    text-decoration-thickness: 2px;
  }

  .theinmag-article__body ul,
  .theinmag-article__body ol {
    margin: 0 0 1.2em;
    padding-left: 1.4em;
  }

  .theinmag-article__body li {
    margin-bottom: 0.4em;
  }

  .theinmag-article__body blockquote {
    margin: 1.6em 0;
    padding: 0.4em 0 0.4em 1.2em;
    border-left: 3px solid var(--color-purple-dark);
    font-style: italic;
    color: var(--color-ink);
  }

  .theinmag-article__body img {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
    margin: 1.4em 0;
  }

  .theinmag-article__body figure {
    margin: 1.6em 0;
  }

  .theinmag-article__body figcaption {
    margin-top: 0.6em;
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-ink);
    opacity: 0.7;
    letter-spacing: 0.02em;
  }

  /* ----- About-the-author card (bottom) ----- */
  /* Top row: small circular avatar + name/role stack. Bio + actions
     flow underneath at full card width so long bios don't sit indented
     in a narrow column on mobile. */
  .theinmag-article__about {
    margin: clamp(40px, 5vw, 64px) 0 0;
    padding: clamp(20px, 2.4vw, 28px);
    background-color: #FFFFFF;
    border-radius: 20px;
    box-shadow: 0 2px 12px rgba(123, 79, 158, 0.08);
  }

  .theinmag-article__about-header {
    display: flex;
    align-items: center;
    gap: clamp(12px, 1.6vw, 18px);
    margin-bottom: clamp(14px, 1.6vw, 18px);
  }

  .theinmag-article__about-avatar {
    flex-shrink: 0;
    width: clamp(56px, 6vw, 72px);
    height: clamp(56px, 6vw, 72px);
    border-radius: 9999px;
    overflow: hidden;
    background-color: rgba(93, 58, 122, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .theinmag-article__about-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .theinmag-article__about-identity {
    flex: 1;
    min-width: 0;
  }

  /* Bio + actions indent slightly so the body content starts inside
     the avatar's horizontal extent rather than hugging the card edge. */
  .theinmag-article__about-bio,
  .theinmag-article__about-actions {
    padding-left: clamp(14px, 2vw, 24px);
  }

  .theinmag-article__about-name {
    margin: 0 0 4px;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: clamp(15px, 1.5vw, 17px);
    line-height: 1.25;
    color: var(--color-ink);
  }

  .theinmag-article__about-role {
    margin: 0 0 clamp(8px, 1vw, 12px);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 500;
    font-size: 12px;
    line-height: 1.4;
    color: var(--color-purple-dark);
  }

  .theinmag-article__about-bio {
    margin: 0 0 clamp(12px, 1.4vw, 16px);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: clamp(12px, 1.1vw, 13px);
    line-height: 1.55;
    color: var(--color-ink);
    opacity: 0.85;
  }

  .theinmag-article__about-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(12px, 1.4vw, 18px);
  }

  .theinmag-article__about-link {
    display: inline-flex;
    align-items: center;
    color: var(--color-teal);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: 14px;
    transition: color 0.15s ease, text-decoration-thickness 0.15s ease;
  }

  .theinmag-article__about-link:hover,
  .theinmag-article__about-link:focus-visible {
    color: var(--color-purple-dark);
    text-decoration-thickness: 2px;
  }

  .theinmag-article__about-socials {
    display: flex;
    gap: 8px;
  }

  .theinmag-article__about-social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--color-rule);
    border-radius: 9999px;
    color: var(--color-ink);
    text-decoration: none;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.04em;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .theinmag-article__about-social:hover,
  .theinmag-article__about-social:focus-visible {
    background-color: var(--color-purple-dark);
    color: #FFFFFF;
    border-color: var(--color-purple-dark);
  }

  /* ================================================================
     "more for you." recommendation strip - cream surface (matches the
     article body for cohesion), white tile cards inside for contrast,
     "browse all field notes" outlined-purple secondary CTA on the
     header row for back-to-index navigation.
     ================================================================ */
  .theinmag-article__recommend {
    background-color: var(--color-cream);
    padding: clamp(48px, 6vw, 96px) clamp(20px, 4vw, 56px) clamp(56px, 7vw, 112px);
    border-top: 1px solid var(--color-rule);
  }

  /* On posts with a photo mosaic the lightbox div (only present when the
     mosaic renders) is the recommend section's previous sibling, so this
     suppresses the divider line between mosaic and recommendations without
     touching the body-to-recommendations rule on non-gallery posts. */
  .theinmag-article__gallery-lightbox + .theinmag-article__recommend {
    border-top: none;
  }

  .theinmag-article__recommend-inner {
    max-width: 1320px;
    margin: 0 auto;
  }

  .theinmag-article__recommend-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: clamp(16px, 2vw, 32px);
    margin: 0 0 clamp(32px, 3.5vw, 48px);
    padding: 0 clamp(8px, 2vw, 32px);
  }

  .theinmag-article__recommend-link--series {
    color: var(--color-sage-dark, #4A7C5C);
  }

  /* Inter editorial subhead - friendly conversational sentence,
     not a display wordmark (Post Regular is reserved for brand-
     identity moments, of which the recommendation strip is not one). */
  .theinmag-article__recommend-heading {
    margin: 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: clamp(18px, 2vw, 24px);
    line-height: 1.3;
    letter-spacing: -0.005em;
    color: var(--color-ink);
  }

  .theinmag-article__recommend-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 22px;
    background-color: transparent;
    color: var(--color-purple-dark);
    border: 2px solid var(--color-purple-dark);
    border-radius: 32px;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: clamp(11px, 1.1vw, 13px);
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .theinmag-article__recommend-link:hover,
  .theinmag-article__recommend-link:focus-visible {
    background-color: var(--color-purple-dark);
    color: #FFFFFF;
    outline: none;
  }

  .theinmag-article__recommend-link svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .theinmag-article__recommend-link:hover svg,
  .theinmag-article__recommend-link:focus-visible svg {
    transform: translateX(3px);
  }

  .theinmag-article__recommend-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(14px, 1.6vw, 20px);
  }

  @media (min-width: 600px) {
    .theinmag-article__recommend-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 990px) {
    .theinmag-article__recommend-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* ================================================================
     Headroom: auto-hide site header on scroll-down, show on scroll-up.
     Scoped to article pages because this stylesheet only loads with
     this section. We transform the SECTION WRAPPER (theinmag-header-
     section) - that's the element with position: sticky in the
     header file. Transforming the inner .theinmag-header alone would
     leave the sticky wrapper's empty space visible mid-animation
     (the "blank white" gap).
     ================================================================ */
  .theinmag-header-section {
    /* overflow: clip ensures the sticker's margin-bottom: -6px overhang
       is contained within the wrapper bounds during transform, so the
       whole thing reads as a single rectangle sliding up rather than
       a bar with bits hanging off it that might appear to desync. */
    overflow: clip;
    transition: transform 0.45s ease-out;
  }

  .theinmag-header-section.is-headroom-hidden {
    transform: translate3d(0, -100%, 0);
    pointer-events: none;
  }

  /* ================================================================
     Reduced motion: disable sticky parallax + overlay fade. Image at
     full brightness from the start; overlay text stays visible until
     naturally scrolled past. Header auto-hide is also skipped (the
     JS short-circuits under prefers-reduced-motion).
     ================================================================ */
  @media (prefers-reduced-motion: reduce) {
    .theinmag-article__cover-image {
      filter: none;
      transform: none;
      transition: none;
    }

    .theinmag-article__overlay {
      opacity: 1;
      transform: none;
      transition: none;
    }

    @media (min-width: 990px) {
      .theinmag-article__cover-sticky {
        position: relative;
        height: auto;
        aspect-ratio: 3 / 4;
      }
    }
  }

  /* ================================================================
     Quick row — wraps Quick read card + guest portrait. Mobile:
     normal block flow (each child keeps its own auto-centering and
     bottom margin). Desktop (>=990px): flex row so the portrait
     sits beside the Quick read card rather than below it.
     ================================================================ */
  @media (min-width: 990px) {
    .theinmag-article__quick-row {
      display: flex;
      flex-direction: row-reverse;
      align-items: center;
      justify-content: center;
      gap: clamp(20px, 2.4vw, 36px);
      margin-bottom: clamp(28px, 3vw, 40px);
    }

    .theinmag-article__quick-row .theinmag-article__quick-read {
      margin: 0;
      flex: 1 1 auto;
      max-width: none;
    }

    .theinmag-article__quick-row .theinmag-article__guest-portrait {
      margin: 0;
      flex: 0 0 auto;
    }
  }

  /* ================================================================
     Guest portrait — small circular avatar shown alongside the
     Quick read card (or below on mobile), conditional on
     `field_notes.guest_avatar`. Helps kids connect a face to the
     person they're reading about after the cover image scrolls
     past. Caption uses the guest_name in Caveat (matches the
     brand-voice cursive style for warmth moments per the visual
     style guide).
     ================================================================ */
  .theinmag-article__guest-portrait {
    margin: clamp(8px, 1vw, 12px) auto clamp(28px, 3.2vw, 40px);
    max-width: 84%;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .theinmag-article__guest-portrait-img {
    width: clamp(80px, 8vw, 96px);
    height: clamp(80px, 8vw, 96px);
    border-radius: 9999px;
    object-fit: cover;
    box-shadow: 0 4px 14px rgba(123, 79, 158, 0.15);
  }

  .theinmag-article__guest-portrait-caption {
    margin: clamp(8px, 1vw, 12px) 0 0;
    font-family: var(--font-emphasis, 'Caveat', cursive);
    font-weight: 700;
    font-size: clamp(18px, 1.8vw, 22px);
    line-height: 1;
    color: var(--color-purple-dark);
  }

  /* ================================================================
     Series strip — sits between the byline-row and the Quick read
     card on republished-series posts (Real Jobs, Real People etc).
     Light cream variant differentiated from the body cream so the
     strip reads as meta without breaking the cream surface family.
     ================================================================ */
  .theinmag-article__series-strip {
    margin: 0 0 clamp(28px, 3vw, 40px);
    padding: clamp(18px, 2.4vw, 28px) clamp(20px, 2.6vw, 32px);
    background-color: #F4ECD2;
    border-radius: 12px;
  }

  .theinmag-article__series-name {
    display: block;
    margin-bottom: clamp(6px, 0.8vw, 10px);
    font-family: var(--font-emphasis, 'Caveat', cursive);
    font-weight: 700;
    font-size: clamp(18px, 1.8vw, 22px);
    line-height: 1;
    color: var(--color-purple-dark);
  }

  .theinmag-article__series-text {
    margin: 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: clamp(13px, 1.2vw, 14px);
    line-height: 1.5;
    color: var(--color-ink);
    opacity: 0.85;
  }

  /* ================================================================
     Advice block — sits between the body and the FAQ on republished
     interviews. Light purple per the field-notes visual style guide
     (#f0eaf8 inline-block treatment). Caveat label, Post Regular body
     so the closing line reads with brand-identity weight.
     ================================================================ */
  .theinmag-article__advice {
    margin: clamp(32px, 4vw, 48px) 0 clamp(8px, 1vw, 12px);
    padding: clamp(24px, 3vw, 36px) clamp(24px, 3vw, 36px) clamp(28px, 3.4vw, 40px);
    background-color: #f0eaf8;
    border-radius: 20px;
  }

  .theinmag-article__advice-label {
    display: block;
    margin-bottom: clamp(10px, 1.2vw, 14px);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: clamp(18px, 1.9vw, 22px);
    line-height: 1.25;
    letter-spacing: -0.005em;
    color: var(--color-purple-dark);
  }

  .theinmag-article__advice-body {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: clamp(15px, 1.4vw, 17px);
    line-height: 1.6;
    color: var(--color-ink);
  }

  .theinmag-article__advice-body p {
    margin: 0 0 0.7em;
  }

  .theinmag-article__advice-body p:last-child {
    margin-bottom: 0;
  }

  /* ================================================================
     Closing CTA — yellow pill button below the post body, driven by
     field_notes.closing_cta_label + field_notes.closing_cta_url.
     Matches the homepage yellow CTA convention (yellow fill, dark
     text, purple+white on hover).
     ================================================================ */
  .theinmag-article__closing-cta {
    margin: clamp(32px, 4vw, 48px) 0 clamp(16px, 2vw, 24px);
    text-align: center;
  }

  .theinmag-article__closing-cta-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    background-color: #F9C23C;
    color: #1a1a1a;
    border-radius: 32px;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: clamp(13px, 1.3vw, 15px);
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .theinmag-article__closing-cta-link:hover,
  .theinmag-article__closing-cta-link:focus-visible {
    background-color: var(--color-purple-dark);
    color: #FFFFFF;
    transform: translateY(-1px);
    outline: none;
  }

  /* ================================================================
     Video companion. Reads field_notes.youtube_url; renders a real
     iframe (companion posts should rank as video results) at the end
     of the body column, plus a "watch on YouTube" outlink.
     ================================================================ */

  .theinmag-article__video {
    margin: clamp(40px, 5vw, 64px) 0 clamp(24px, 3vw, 40px);
  }

  .theinmag-article__video-heading {
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-size: clamp(22px, 3vw, 30px);
    margin: 0 0 var(--space-md, 16px);
  }

  .theinmag-article__video-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md, 12px);
    overflow: hidden;
    background: #000000;
    box-shadow: 0 2px 10px rgba(42, 31, 61, 0.15);
  }

  .theinmag-article__video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .theinmag-article__video-link {
    display: inline-block;
    margin-top: var(--space-sm, 8px);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-teal-dark, #2D6878);
    text-decoration: none;
  }

  .theinmag-article__video-link:hover {
    text-decoration: underline;
  }

  /* Video companion relocated below the mosaic: keep it centred and
     column-width rather than full-bleed. */
  .theinmag-article__video-standalone {
    padding: 0 clamp(16px, 5vw, 24px);
  }

  .theinmag-article__video-standalone-inner {
    max-width: 760px;
    margin: 0 auto;
  }

  /* ================================================================
     Guest website link element. Small editorial line rendered after the
     intro and above the first question on guest posts that set
     field_notes.guest_website. Subtle cream card, purple links, yellow
     accent rule. Colourblind-safe: links carry an underline, not colour
     alone.
     ================================================================ */
  .theinmag-article__guest-link {
    margin: clamp(24px, 3.4vw, 36px) 0;
    padding: clamp(18px, 3vw, 26px) clamp(18px, 3.2vw, 28px) clamp(20px, 3vw, 26px);
    background: var(--color-lavender, #E8DEEF);
    border-radius: var(--radius-md, 12px);
  }

  .theinmag-article__guest-link-heading {
    margin: 0 0 4px;
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-synthesis: none;
    font-size: clamp(26px, 3.6vw, 34px);
    line-height: 1.12;
    color: var(--color-inky-purple-navy, #2A1F3D);
    text-wrap: balance;
  }

  .theinmag-article__guest-link-sub {
    margin: 0 0 clamp(14px, 2vw, 18px);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-size: clamp(15px, 1.8vw, 16px);
    line-height: 1.5;
    color: var(--color-inky-purple-navy, #2A1F3D);
  }

  .theinmag-article__guest-link-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 12px;
  }

  .theinmag-article__guest-link-item {
    margin: 0;
    flex: 1 1 240px;
    max-width: 340px;
  }

  .theinmag-article__guest-link-pill {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 56px;
    padding: 10px 14px;
    background: #FDFAF5;
    border: 1.5px solid var(--color-purple-dark, #5D3A7A);
    border-radius: 999px;
    color: var(--color-purple-dark, #5D3A7A);
    text-decoration: none;
    transition: background-color 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .theinmag-article__guest-link-icon,
  .theinmag-article__guest-link-arrow {
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .theinmag-article__guest-link-icon {
    width: 26px;
    height: 26px;
  }

  .theinmag-article__guest-link-arrow {
    width: 18px;
    height: 18px;
    margin-left: auto;
    opacity: 0.85;
  }

  .theinmag-article__guest-link-stack {
    display: flex;
    flex-direction: column;
    min-width: 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
  }

  .theinmag-article__guest-link-platform {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1.2;
    opacity: 0.85;
  }

  .theinmag-article__guest-link-url {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  .theinmag-article__guest-link-pill:hover {
    background: var(--color-purple-dark, #5D3A7A);
    color: #FDFAF5;
    transform: translateY(-1px);
  }

  .theinmag-article__guest-link-pill:focus-visible {
    outline: 3px solid var(--color-yellow, #F9C23C);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-article__guest-link-pill {
      transition: none;
    }
    .theinmag-article__guest-link-pill:hover {
      transform: none;
    }
  }

  @media (max-width: 480px) {
    .theinmag-article__guest-link-item {
      flex-basis: 100%;
      max-width: none;
    }
  }

  /* ================================================================
     Meet the crew: family-member intros inside the body of a guest
     family post (e.g. Flying the Nest). Each name is set in Post Regular
     like the mag, the description in Inter after it.
     ================================================================ */
  .theinmag-article__body .theinmag-article__crew {
    margin: clamp(16px, 2.6vw, 28px) 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(14px, 2vw, 20px) clamp(18px, 3vw, 28px);
  }

  @media (min-width: 640px) {
    .theinmag-article__body .theinmag-article__crew {
      grid-template-columns: 1fr 1fr;
    }
  }

  .theinmag-article__body .theinmag-article__crew p {
    margin: 0;
    font-size: clamp(15px, 1.8vw, 16px);
    line-height: 1.5;
  }

  .theinmag-article__crew-desc {
    display: block;
  }

  .theinmag-article__crew-name {
    display: inline-block;
    margin: 0 0 6px;
    padding: 2px 12px 4px;
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-synthesis: none;
    font-size: clamp(24px, 3vw, 28px);
    line-height: 1.15;
    color: var(--color-purple-dark, #5D3A7A);
    background: var(--color-lavender, #E8DEEF);
    border-radius: 6px;
    transform: rotate(-1.2deg);
  }

  .theinmag-article__body .theinmag-article__crew p:nth-child(even) .theinmag-article__crew-name {
    transform: rotate(1.2deg);
  }

  /* ================================================================
     FAQ block (in-post). Reads field_notes.faq_items metafield.
     Same accordion shape as theinmag-send-in-faq, scoped to the
     article so it can coexist on the same page render.
     ================================================================ */

  .theinmag-article__faq {
    margin: clamp(40px, 5vw, 64px) 0 clamp(32px, 4vw, 48px);
    padding: 0 0 clamp(8px, 1vw, 12px);
  }

  .theinmag-article__faq-heading {
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-size: clamp(24px, 3.4vw, 32px);
    line-height: 1.15;
    margin: 0 0 clamp(16px, 2vw, 24px);
    color: var(--color-ink);
    text-align: center;
    text-wrap: balance;
  }

  .theinmag-article__faq-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-rule);
  }

  .theinmag-article__faq-item {
    border-bottom: 1px solid var(--color-rule);
  }

  .theinmag-article__faq-question-heading {
    margin: 0;
    font: inherit;
  }

  .theinmag-article__faq-trigger {
    appearance: none;
    background: none;
    border: 0;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(12px, 1.5vw, 20px);
    padding: clamp(14px, 1.8vw, 20px) clamp(4px, 1vw, 12px);
    cursor: pointer;
    text-align: left;
    color: var(--color-ink);
    min-height: 56px;
    transition: color 0.15s ease;
  }

  .theinmag-article__faq-trigger:hover,
  .theinmag-article__faq-trigger:focus-visible {
    color: var(--color-purple-dark);
    outline: none;
  }

  .theinmag-article__faq-trigger:focus-visible {
    outline: 2px dashed var(--color-purple-dark);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .theinmag-article__faq-question {
    flex: 1;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: clamp(15px, 1.5vw, 17px);
    line-height: 1.4;
  }

  .theinmag-article__faq-caret {
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
    position: relative;
    transition: transform 0.3s ease;
    color: var(--color-purple-dark);
  }

  .theinmag-article__faq-caret::before,
  .theinmag-article__faq-caret::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 11px;
    height: 2px;
    background-color: currentColor;
    border-radius: 2px;
    transform-origin: 50% 50%;
  }

  .theinmag-article__faq-caret::before {
    left: 1px;
    transform: translateY(-50%) rotate(45deg);
  }

  .theinmag-article__faq-caret::after {
    right: 1px;
    transform: translateY(-50%) rotate(-45deg);
  }

  .theinmag-article__faq-trigger[aria-expanded="true"] .theinmag-article__faq-caret {
    transform: rotate(180deg);
  }

  .theinmag-article__faq-answer-wrap {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .theinmag-article__faq-answer-wrap[data-open="true"] {
    max-height: 1500px;
  }

  .theinmag-article__faq-answer {
    padding: 0 clamp(4px, 1vw, 12px) clamp(16px, 2vw, 22px);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: clamp(14px, 1.4vw, 16px);
    line-height: 1.7;
    color: var(--color-ink);
  }

  .theinmag-article__faq-answer p {
    margin: 0 0 clamp(10px, 1.2vw, 14px);
  }

  .theinmag-article__faq-answer p:last-child {
    margin-bottom: 0;
  }

  .theinmag-article__faq-answer a {
    color: var(--color-teal);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    transition: color 0.15s ease, text-decoration-thickness 0.15s ease;
  }

  .theinmag-article__faq-answer a:hover,
  .theinmag-article__faq-answer a:focus-visible {
    color: var(--color-purple-dark);
    text-decoration-thickness: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-article__faq-caret,
    .theinmag-article__faq-answer-wrap,
    .theinmag-article__faq-trigger {
      transition: none;
    }
  }

  /* ------------------------------------------------------------------ *
   * Photo mosaic strip (guest's other photos) + lightbox.              *
   * Justified rows (Flickr / Google Photos): every row fills the full  *
   * viewport width, each image keeps its true aspect ratio, row height *
   * varies to justify. Full-bleed (100vw), sharp corners, thin ~6px    *
   * cream gutter. Row geometry is computed in JS and recomputed on     *
   * resize; the tile width/height are set inline per image so no crop  *
   * or distortion ever happens (the box matches the image's own ratio).*
   * ------------------------------------------------------------------ */
  .theinmag-article__gallery {
    margin: 0;
    /* Top gap only: a 6px cream band above the first row, matching the GAP
       between tiles, so the mosaic is separated from the article by the same
       fine line that runs between all the images. Left/right stay full-bleed
       (no side padding), so the tiles remain edge to edge. */
    padding: 6px 0 0;
    /* Full-bleed breakout: span the whole viewport width, out of the
       article column. Sitewide html/body overflow-x: clip absorbs any
       scrollbar-width overflow, so this cannot introduce horizontal
       scroll. */
    width: 100vw;
    margin-left: calc(50% - 50vw);
    background: var(--color-cream);
  }

  .theinmag-article__gallery-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 0;
    line-height: 0;
    /* Hidden until the first justified layout is computed, so no
       square/unsized flash. Revealed by data-ready in the script. */
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .theinmag-article__gallery-grid[data-ready='true'] {
    opacity: 1;
  }

  .theinmag-article__gallery-tile {
    display: block;
    flex: 0 0 auto;
    /* width + height set inline by the layout script (px). */
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: var(--color-cream);
    overflow: hidden;
    cursor: zoom-in;
    line-height: 0;
    position: relative;
  }

  .theinmag-article__gallery-img {
    display: block;
    width: 100%;
    height: 100%;
    /* The tile box is sized to this image's own aspect ratio, so the
       fill scales proportionally: no crop, no distortion. */
  }

  .theinmag-article__gallery-tile:hover .theinmag-article__gallery-img,
  .theinmag-article__gallery-tile:focus-visible .theinmag-article__gallery-img {
    filter: brightness(0.9);
    transition: filter 0.18s ease;
  }

  .theinmag-article__gallery-tile:focus-visible {
    outline: 3px solid var(--color-yellow);
    outline-offset: -3px;
    z-index: 2;
  }

  .theinmag-article__gallery-glyph {
    position: absolute;
    right: 10px;
    bottom: 10px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgba(42, 31, 61, 0.72);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: scale(0.8);
    transition: opacity 0.18s ease, transform 0.18s ease;
  }

  .theinmag-article__gallery-glyph svg {
    width: 15px;
    height: 15px;
  }

  .theinmag-article__gallery-tile:hover .theinmag-article__gallery-glyph,
  .theinmag-article__gallery-tile:focus-visible .theinmag-article__gallery-glyph {
    opacity: 1;
    transform: scale(1);
  }

  /* Lightbox */
  .theinmag-article__gallery-lightbox {
    position: fixed;
    inset: 0;
    z-index: 120;
    background: rgba(20, 15, 30, 0.94);
  }

  .theinmag-article__gallery-lightbox[hidden] {
    display: none !important;
  }

  .theinmag-article__gallery-lb-stage {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5vh 6vw;
  }

  .theinmag-article__gallery-lb-fig {
    margin: 0;
    max-width: 100%;
    max-height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .theinmag-article__gallery-lb-img {
    max-width: min(92vw, 1300px);
    max-height: 82vh;
    width: auto;
    height: auto;
    border-radius: 8px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }

  .theinmag-article__gallery-lb-cap {
    margin: 0;
    max-width: 60ch;
    color: #f3ecdd;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-size: 1.6rem;
    line-height: 1.5;
    text-align: center;
  }

  .theinmag-article__gallery-lb-count {
    position: absolute;
    top: 20px;
    left: 24px;
    z-index: 4;
    margin: 0;
    color: #cfc7d6;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-size: 1.4rem;
    letter-spacing: 0.06em;
  }

  .theinmag-article__gallery-lb-btn {
    position: absolute;
    z-index: 4;
    border: 0;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s ease;
  }

  .theinmag-article__gallery-lb-btn svg {
    width: 24px;
    height: 24px;
  }

  .theinmag-article__gallery-lb-btn:hover,
  .theinmag-article__gallery-lb-btn:focus-visible {
    background: rgba(255, 255, 255, 0.24);
    outline: none;
  }

  .theinmag-article__gallery-lb-btn:focus-visible {
    box-shadow: 0 0 0 3px var(--color-yellow);
  }

  .theinmag-article__gallery-lb-close {
    top: 16px;
    right: 20px;
  }

  .theinmag-article__gallery-lb-prev {
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
  }

  .theinmag-article__gallery-lb-next {
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
  }

  @media (max-width: 680px) {
    .theinmag-article__gallery-lb-prev {
      left: 8px;
    }
    .theinmag-article__gallery-lb-next {
      right: 8px;
    }
    .theinmag-article__gallery-lb-img {
      max-height: 74vh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-article__gallery-grid,
    .theinmag-article__gallery-img,
    .theinmag-article__gallery-tile,
    .theinmag-article__gallery-glyph,
    .theinmag-article__gallery-lb-btn {
      transition: none;
    }
  }
{%- endstylesheet -%}

<script>
  (function () {
    var article = document.querySelector('[data-theinmag-article]');
    if (!article) return;

    var prefersReduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* Single rAF-throttled scroll listener doing two things on every
       update: (1) hero overlay fade + cover image brightness via
       --hero-progress custom property (0 at article top, 1 by 30vh
       past); (2) headroom-style auto-hide of the site header on
       scroll-down, show on scroll-up. Tracks the article's rect.top
       (NOT the sticky child's, whose rect.top is glued to 0 during
       the sticky phase). */
    if (!prefersReduced) {
      /* Target the sticky section wrapper, not the inner .theinmag-header
         (which is position: relative inside the wrapper - transforming
         it leaves the wrapper's space empty during the slide). */
      var siteHeader = document.querySelector('.theinmag-header-section');
      var lastScrollY = window.pageYOffset;
      var ticking = false;

      function update() {
        ticking = false;
        var currentY = window.pageYOffset;

        var rect = article.getBoundingClientRect();
        var vh = window.innerHeight || document.documentElement.clientHeight;
        var travel = vh * 0.3;
        if (travel > 0) {
          var scrolled = Math.max(0, -rect.top);
          var progress = Math.min(1, scrolled / travel);
          article.style.setProperty('--hero-progress', progress.toFixed(3));
        }

        if (siteHeader) {
          if (currentY <= 5) {
            siteHeader.classList.remove('is-headroom-hidden');
            lastScrollY = currentY;
          } else {
            var delta = currentY - lastScrollY;
            if (delta > 8) {
              siteHeader.classList.add('is-headroom-hidden');
              lastScrollY = currentY;
            } else if (delta < -8) {
              siteHeader.classList.remove('is-headroom-hidden');
              lastScrollY = currentY;
            }
          }
        }
      }

      function onScroll() {
        if (!ticking) {
          window.requestAnimationFrame(update);
          ticking = true;
        }
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      update();
    }

    /* FAQ accordion. Each trigger toggles its own answer panel via
       aria-expanded + data-open. Multiple panels can be open at once. */
    var faqTriggers = article.querySelectorAll('[data-theinmag-article-faq-trigger]');
    faqTriggers.forEach(function (trigger) {
      trigger.addEventListener('click', function () {
        var expanded = trigger.getAttribute('aria-expanded') === 'true';
        var answer = document.getElementById(trigger.getAttribute('aria-controls'));
        if (!answer) return;
        trigger.setAttribute('aria-expanded', expanded ? 'false' : 'true');
        answer.setAttribute('data-open', expanded ? 'false' : 'true');
      });
    });
  })();
</script>

<script>
  /* Photo mosaic — justified rows (greedy, Flickr / Google Photos style).
     Ported from the reference algorithm Ryan signed off: fill each row at a
     nominal base height, close the row when its natural width reaches the
     container width, then set the row height so the row fills the width
     exactly. Each tile's width/height are written inline so the image box
     always matches the image's own aspect ratio — no crop, no distortion.
     Every row fills the full width, including the last: when the final row
     under-fills (a lone leftover, or one that would have to grow past a sane
     height to fill), tiles are borrowed from the end of the previous row into
     the last row and both are re-justified, so there is never a cream gap on
     the right. Recomputed on resize; smaller base height on mobile. Aspect
     ratios come from data-ar when present (correct before load), otherwise
     from each image's natural dimensions probed on the fly. Does nothing when
     the strip is absent. */
  (function () {
    var grid = document.querySelector('[data-theinmag-gallery]');
    if (!grid) return;
    var tiles = Array.prototype.slice.call(grid.querySelectorAll('[data-theinmag-gallery-tile]'));
    if (!tiles.length) return;

    var GAP = 6;
    var ars = new Array(tiles.length);
    var pending = 0;

    /* Feature mosaic opt-in: the tile carrying data-feature becomes a tall
       block on the right with the rest justified beside it. -1 = no feature
       tile, so this post lays out as plain justified rows exactly as before. */
    var featureIdx = -1;
    for (var fscan = 0; fscan < tiles.length; fscan++) {
      if (tiles[fscan].getAttribute('data-feature') === 'true') { featureIdx = fscan; break; }
    }

    function baseHeight() {
      var w = window.innerWidth || document.documentElement.clientWidth;
      if (w <= 680) return 200;
      if (w <= 989) return 280;
      return 360;
    }

    function containerWidth() {
      /* Lay out to the visible content width (excludes the scrollbar), so
         no tile is hidden under it. The section is 100vw; clip handles the
         rest. */
      return Math.min(grid.clientWidth, document.documentElement.clientWidth);
    }

    /* Plain justified-rows layout (the original engine, unchanged). Used for
       every post with no feature tile, and as the fallback when a feature
       block cannot fit (narrow viewports). */
    function layoutPlain() {
      var cw = containerWidth();
      if (!cw) return;
      var base = baseHeight();

      /* Greedy row packing at the nominal base height: fill a row until its
         natural width reaches the container, then close it. */
      var rows = [], row = [], sumAr = 0;
      for (var i = 0; i < tiles.length; i++) {
        var ar = ars[i] || 1;
        row.push(i);
        sumAr += ar;
        var naturalW = sumAr * base + GAP * (row.length - 1);
        if (naturalW >= cw) { rows.push(row); row = []; sumAr = 0; }
      }
      if (row.length) rows.push(row);

      /* maxH is the target row height: rows aim to sit at or below it, and a
         last row taller than this triggers borrowing. */
      var maxH = base * 1.5;
      function justifiedHeight(idxs) {
        var s = 0;
        for (var j = 0; j < idxs.length; j++) s += (ars[idxs[j]] || 1);
        return (cw - GAP * (idxs.length - 1)) / s;
      }

      /* Last-row balancing. A leftover final row (often a lone image)
         justified to full width would blow up far past a sane height. Rather
         than cap it and leave a big cream gap on the right, borrow tiles from
         the END of the previous row into the FRONT of the last row and
         re-justify, until the last row sits at a reasonable height. A borrow
         is only taken when it would NOT push the previous row past maxH, so
         moving photos down a row can never leave an upper row lopsidedly tall.
         Effect: a couple of photos drop down and both rows fill and balance. */
      while (rows.length >= 2 && justifiedHeight(rows[rows.length - 1]) > maxH) {
        var prevRow = rows[rows.length - 2];
        if (prevRow.length <= 1) break;
        var trialPrev = prevRow.slice(0, prevRow.length - 1);
        if (justifiedHeight(trialPrev) > maxH) break;
        rows[rows.length - 1].unshift(prevRow.pop());
      }

      for (var r = 0; r < rows.length; r++) {
        var idxs = rows[r];
        var rowAr = 0;
        for (var k = 0; k < idxs.length; k++) rowAr += (ars[idxs[k]] || 1);
        var avail = cw - GAP * (idxs.length - 1);
        var isLast = (r === rows.length - 1);
        /* Every row of two or more images fills the full width, so there is
           never a cream gap on the right, even when the last row ends a
           little taller than the rest. The ONLY thing that ever leaves a gap
           is a gallery of a SINGLE image: stretched to full width it would be
           grotesquely tall, so a lone image is capped and sits left. Any
           multi-image leftover has already been rehomed by the borrowing
           above, so it never reaches this. */
        var fillWidth = true;
        var H = avail / rowAr;
        if (isLast && idxs.length === 1 && H > maxH) { H = maxH; fillWidth = false; }
        H = Math.round(H);

        var wsum = 0;
        for (var k2 = 0; k2 < idxs.length; k2++) {
          var ti = idxs[k2];
          var w = Math.round((ars[ti] || 1) * H);
          /* Full-width rows: the last tile absorbs rounding so the tile
             widths sum to exactly avail (cw minus the flex gaps) and the
             row never wraps early or falls short. Track widths only; the
             6px gaps are added by flex, not counted here. The capped
             fallback row is left-aligned, so it skips this. */
          if (fillWidth && k2 === idxs.length - 1) { w = avail - wsum; }
          wsum += w;
          tiles[ti].style.width = w + 'px';
          tiles[ti].style.height = H + 'px';
        }
      }

      if (pending === 0) grid.setAttribute('data-ready', 'true');
    }

    /* ---- Feature-block engine (ported from the reference solve). A feature
       tile spans N justified rows on the RIGHT; the other tiles fill N rows to
       its LEFT. Closed form: every left row and the feature meet the same total
       height, and each row fills (containerWidth - GAP - featureWidth) exactly,
       so edges meet with no cropping (every box keeps its image's own ratio).
       N is 3 on desktop/tablet, 2 on phone, and falls back N -> N-1 -> ... when
       the block cannot fit, ending at plain rows (feature just the first tile)
       so a phone never gets an absurdly tall feature. ---- */

    function arSum(idxs) {
      var s = 0;
      for (var j = 0; j < idxs.length; j++) s += (ars[idxs[j]] || 1);
      return s;
    }

    /* Per-breakpoint params: base = plain-row target height, cb = companion
       target height beside the feature, rows = rows beside, share = max
       fraction of the width the feature may take before a row is dropped. */
    function bpParams(cw) {
      if (cw <= 680) return { base: 200, cb: 170, rows: 2, share: 1.0 };
      if (cw <= 989) return { base: 280, cb: 200, rows: 3, share: 0.55 };
      return { base: 360, cb: 260, rows: 3, share: 0.55 };
    }

    /* Greedy row fill at nominal height h (for the plain rows under a block). */
    function packRow(idxs, width, h) {
      var out = [], s = 0;
      for (var k = 0; k < idxs.length; k++) {
        var i = idxs[k];
        out.push(i);
        s += (ars[i] || 1);
        if (s * h + GAP * (out.length - 1) >= width) break;
      }
      return out;
    }

    function jhf(idxs, cw) {
      return (cw - GAP * (idxs.length - 1)) / arSum(idxs);
    }

    /* Closed-form solve for a block of N left rows beside the feature.
       Returns { Hf, fw, H:[per-row heights] } as floats. */
    function solveBlock(arF, rowsArr, cw) {
      var K = cw - GAP, n = rowsArr.length, A = [], g = [];
      for (var j = 0; j < n; j++) { A.push(arSum(rowsArr[j])); g.push(GAP * (rowsArr[j].length - 1)); }
      var num = GAP * (n - 1), den = 1;
      for (var j2 = 0; j2 < n; j2++) { num += (K - g[j2]) / A[j2]; den += arF * (1 / A[j2]); }
      var Hf = num / den, fw = arF * Hf, H = [];
      for (var j3 = 0; j3 < n; j3++) H.push((K - fw - g[j3]) / A[j3]);
      return { Hf: Hf, fw: fw, H: H };
    }

    /* Split idxs (order kept) into n contiguous rows with sum-of-ratios as even
       as possible, always leaving at least one tile per remaining row. */
    function partition(idxs, n) {
      var total = arSum(idxs), target = total / n;
      var rowsP = [], row = [], s = 0;
      for (var k = 0; k < idxs.length; k++) {
        var i = idxs[k];
        var leftTiles = idxs.length - k;
        var leftRows = n - rowsP.length;
        if (row.length && leftRows > 1 &&
            (Math.abs(s + (ars[i] || 1) - target) > Math.abs(s - target) || leftTiles <= leftRows - 1)) {
          rowsP.push(row); row = []; s = 0;
        }
        row.push(i); s += (ars[i] || 1);
      }
      rowsP.push(row);
      return rowsP;
    }

    /* Choose how many companions sit beside the feature and split them into n
       rows. Returns { rows, rest } or null when a block of n rows is not viable
       (feature would hog the width, or no room for even a narrow companion). */
    function planBlock(arF, others, cw, cb, n, share) {
      if (others.length < n) return null;
      var fw0 = arF * (n * cb + GAP * (n - 1));
      var rem = cw - GAP - fw0;
      if (fw0 > share * cw) return null;
      if (rem < 0.4 * cb) return null;
      var want = n * rem;
      var m = 0, W = 0;
      while (m < others.length && W < want) { W += (ars[others[m]] || 1) * cb + GAP; m++; }
      var candsSet = {};
      candsSet[Math.max(n, m - 1)] = 1;
      candsSet[Math.max(n, m)] = 1;
      var cands = Object.keys(candsSet).map(Number).sort(function (a, b) { return a - b; });
      var best = null;
      for (var c = 0; c < cands.length; c++) {
        var mc = Math.min(cands[c], others.length);
        var rws = partition(others.slice(0, mc), n);
        var sol = solveBlock(arF, rws, cw);
        var mn = Infinity, mx = -Infinity;
        for (var q = 0; q < sol.H.length; q++) { var hv = sol.H[q]; if (hv < mn) mn = hv; if (hv > mx) mx = hv; }
        var evenness = (mn > 0) ? mx / mn : Infinity;
        var Wmc = 0;
        for (var q2 = 0; q2 < mc; q2++) Wmc += (ars[others[q2]] || 1) * cb;
        Wmc += GAP * (mc - n);
        var s0 = Math.round(evenness * 1000) / 1000, s1 = Math.abs(Wmc - want);
        if (best === null || s0 < best.s0 || (s0 === best.s0 && s1 < best.s1)) {
          best = { s0: s0, s1: s1, rows: rws, rest: others.slice(mc) };
        }
      }
      return best ? { rows: best.rows, rest: best.rest } : null;
    }

    /* Full feature layout: returns { boxes:[{idx,x,y,w,h}], total } in px, or
       null when even a 2-row block will not fit (caller falls back to plain). */
    function layoutFeature(cw) {
      var p = bpParams(cw), base = p.base, cb = p.cb, maxH = base * 1.5;
      var others = [];
      for (var i = 0; i < tiles.length; i++) { if (i !== featureIdx) others.push(i); }
      var arF = ars[featureIdx] || 1;

      var n = p.rows, plan = null;
      while (n >= 2 && plan === null) { plan = planBlock(arF, others, cw, cb, n, p.share); if (plan === null) n--; }
      if (plan === null) return null;

      var brows = plan.rows, rest = plan.rest.slice();

      /* Plain rows for the remainder (if any) at the normal base height. */
      var rows = [];
      while (rest.length) { var rr = packRow(rest, cw, base); rows.push(rr); rest = rest.slice(rr.length); }

      /* Last-row balancing, borrowing from block row N when the previous row IS
         block row N (re-solved so the block never goes past maxH). */
      var lastBlock = brows[brows.length - 1];
      function prevOf(k) { return k > 0 ? rows[k - 1] : lastBlock; }
      while (rows.length && jhf(rows[rows.length - 1], cw) > maxH) {
        var prev = prevOf(rows.length - 1);
        if (prev.length <= 1) break;
        var trial = prev.slice(0, prev.length - 1);
        if (prev === lastBlock) {
          var tb = brows.slice(0, brows.length - 1); tb.push(trial);
          var solT = solveBlock(arF, tb, cw);
          if (solT.H[solT.H.length - 1] > maxH) break;
        } else if (jhf(trial, cw) > maxH) {
          break;
        }
        rows[rows.length - 1].unshift(prev.pop());
      }

      /* Emit the block: feature on the right, left rows justified to fill the
         remaining width; the last tile in each row absorbs rounding so edges
         meet exactly. */
      var boxes = [], y = 0;
      var sol = solveBlock(arF, brows, cw);
      var H = sol.H.map(function (h) { return Math.round(h); });
      var Hf = 0;
      for (var a = 0; a < H.length; a++) Hf += H[a];
      Hf += GAP * (H.length - 1);
      var fw = Math.round(arF * Hf);
      var fx = cw - fw, x0 = 0;              /* feature on the RIGHT */
      boxes.push({ idx: featureIdx, x: fx, y: y, w: fw, h: Hf });
      var rowW = cw - fw - GAP, yy = y;
      for (var b = 0; b < brows.length; b++) {
        var r = brows[b], Hr = H[b], x = x0;
        for (var k = 0; k < r.length; k++) {
          var ti = r[k], w = Math.round((ars[ti] || 1) * Hr);
          if (k === r.length - 1) w = x0 + rowW - x;   /* absorb rounding */
          boxes.push({ idx: ti, x: x, y: yy, w: w, h: Hr });
          x += w + GAP;
        }
        yy += Hr + GAP;
      }
      y += Hf + GAP;

      /* Plain rows below the block (only when there was a remainder). */
      for (var rr2 = 0; rr2 < rows.length; rr2++) {
        var r2 = rows[rr2], avail = cw - GAP * (r2.length - 1), Hr2 = avail / arSum(r2), fill = true;
        if (r2.length === 1 && Hr2 > maxH) { Hr2 = maxH; fill = false; }
        Hr2 = Math.round(Hr2);
        var x2 = 0;
        for (var k2 = 0; k2 < r2.length; k2++) {
          var ti2 = r2[k2], w2 = Math.round((ars[ti2] || 1) * Hr2);
          if (fill && k2 === r2.length - 1) w2 = cw - x2;
          boxes.push({ idx: ti2, x: x2, y: y, w: w2, h: Hr2 });
          x2 += w2 + GAP;
        }
        y += Hr2 + GAP;
      }

      return { boxes: boxes, total: y - GAP };
    }

    /* Reset any absolute positioning left by a prior feature-mode pass, so a
       resize down into the plain fallback returns tiles to normal flex flow. */
    function clearAbsolute() {
      grid.style.position = '';
      grid.style.height = '';
      for (var i = 0; i < tiles.length; i++) {
        var s = tiles[i].style;
        s.position = ''; s.left = ''; s.top = '';
      }
    }

    /* Dispatcher: feature post -> try the feature block, else plain rows. A
       post with no feature tile goes straight to the untouched plain engine. */
    function layout() {
      var cw = containerWidth();
      if (!cw) return;
      if (featureIdx >= 0) {
        var res = layoutFeature(cw);
        if (res) {
          grid.style.position = 'relative';
          grid.style.height = res.total + 'px';
          for (var b = 0; b < res.boxes.length; b++) {
            var bx = res.boxes[b], st = tiles[bx.idx].style;
            st.position = 'absolute';
            st.left = bx.x + 'px';
            st.top = bx.y + 'px';
            st.width = bx.w + 'px';
            st.height = bx.h + 'px';
          }
          if (pending === 0) grid.setAttribute('data-ready', 'true');
          return;
        }
        clearAbsolute();   /* block would not fit: fall back to plain rows */
      }
      layoutPlain();
    }

    /* Resolve aspect ratios: data-ar first (correct before load), else the
       image's natural size, probed via a detached Image so the layout is
       not blocked by lazy loading. */
    tiles.forEach(function (tile, i) {
      var d = parseFloat(tile.getAttribute('data-ar'));
      if (d && d > 0) { ars[i] = d; return; }
      var img = tile.querySelector('img');
      if (img && img.naturalWidth && img.naturalHeight) {
        ars[i] = img.naturalWidth / img.naturalHeight;
        return;
      }
      pending++;
      var probe = new Image();
      probe.onload = probe.onerror = function () {
        ars[i] = (probe.naturalWidth && probe.naturalHeight)
          ? probe.naturalWidth / probe.naturalHeight
          : 1;
        pending--;
        layout();
      };
      probe.src = tile.getAttribute('data-full')
        || (img && (img.currentSrc || img.src));
    });

    /* First paint with whatever is known; probes refine it as they land. */
    layout();
    /* Safety reveal in case a probe never fires. */
    window.setTimeout(function () { grid.setAttribute('data-ready', 'true'); }, 1500);

    var rt;
    window.addEventListener('resize', function () {
      window.clearTimeout(rt);
      rt = window.setTimeout(layout, 120);
    }, { passive: true });
  })();
</script>

<script>
  /* Photo mosaic lightbox. Reads photo data straight off the rendered
     tiles (data-full + data-caption), so it needs no server-injected JS
     array and simply does nothing when the strip is absent. Mechanics
     ported from the approved prototype: prev/next/close, counter, Esc +
     arrow keys, click-scrim close, basic touch swipe, focus moved on open
     and restored on close. Controls sit above the backdrop (z-index 4 vs
     stage 1) so a control click never falls through and closes it. */
  (function () {
    var grid = document.querySelector('[data-theinmag-gallery]');
    var lb = document.querySelector('[data-theinmag-gallery-lightbox]');
    if (!grid || !lb) return;

    var tiles = Array.prototype.slice.call(grid.querySelectorAll('[data-theinmag-gallery-tile]'));
    if (!tiles.length) return;

    var lbImg = lb.querySelector('[data-theinmag-gallery-image]');
    var lbCap = lb.querySelector('[data-theinmag-gallery-caption]');
    var lbCount = lb.querySelector('[data-theinmag-gallery-count]');
    var btnClose = lb.querySelector('[data-theinmag-gallery-close]');
    var btnPrev = lb.querySelector('[data-theinmag-gallery-prev]');
    var btnNext = lb.querySelector('[data-theinmag-gallery-next]');
    var stage = lb.querySelector('[data-theinmag-gallery-stage]');

    var photos = tiles.map(function (tile) {
      return {
        src: tile.getAttribute('data-full'),
        cap: tile.getAttribute('data-caption') || ''
      };
    });

    var idx = 0;
    var lastFocus = null;
    var single = photos.length < 2;
    if (single) {
      if (btnPrev) btnPrev.hidden = true;
      if (btnNext) btnNext.hidden = true;
    }

    function render() {
      var p = photos[idx];
      lbImg.src = p.src;
      lbImg.alt = p.cap;
      lbCap.textContent = p.cap;
      lbCap.hidden = p.cap === '';
      lbCount.textContent = (idx + 1) + ' / ' + photos.length;
    }

    function open(i) {
      idx = i;
      lastFocus = document.activeElement;
      render();
      lb.hidden = false;
      document.body.style.overflow = 'hidden';
      btnClose.focus();
    }

    function close() {
      lb.hidden = true;
      document.body.style.overflow = '';
      if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
    }

    function next() { idx = (idx + 1) % photos.length; render(); }
    function prev() { idx = (idx - 1 + photos.length) % photos.length; render(); }

    tiles.forEach(function (tile, i) {
      tile.addEventListener('click', function () { open(i); });
    });

    btnClose.addEventListener('click', close);
    if (btnNext) btnNext.addEventListener('click', next);
    if (btnPrev) btnPrev.addEventListener('click', prev);

    lb.addEventListener('click', function (e) {
      if (e.target === lb || e.target === stage) close();
    });

    document.addEventListener('keydown', function (e) {
      if (lb.hidden) return;
      if (e.key === 'Escape') close();
      else if (!single && e.key === 'ArrowRight') next();
      else if (!single && e.key === 'ArrowLeft') prev();
    });

    var touchX = 0;
    lb.addEventListener('touchstart', function (e) {
      touchX = e.changedTouches[0].clientX;
    }, { passive: true });
    lb.addEventListener('touchend', function (e) {
      if (single) return;
      var dx = e.changedTouches[0].clientX - touchX;
      if (Math.abs(dx) > 50) { dx < 0 ? next() : prev(); }
    }, { passive: true });
  })();
</script>

