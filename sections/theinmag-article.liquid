{%- comment -%}
  theinmag-article
  Single field-notes post template. Maude-style two-column editorial:
  cover image sticky on the left, article body scrolls on the right.

  Per-post metafields (namespace `field_notes`, defined in Shopify
  admin under Settings > Custom data > Articles):

    field_notes.quick_answer            (multi-line text, REQUIRED for AEO)
    field_notes.primary_topic           (single line text, e.g. "Creativity")
    field_notes.author_type             (single line text: ryan | tam | kid)
    field_notes.author_role_override    (single line text, optional)
    field_notes.kid_first_name          (single line text, if author_type=kid)
    field_notes.kid_age                 (integer, if author_type=kid)
    field_notes.kid_region              (single line text, e.g. "Fremantle WA")
    field_notes.recommendation_1_handle (single line text, post handle no slash)
    field_notes.recommendation_1_blurb  (single line text, italic connective)
    field_notes.recommendation_2_handle / _blurb
    field_notes.recommendation_3_handle / _blurb
{%- endcomment -%}

{%- liquid
  comment
  Strip a single trailing period from sentence-case lowercase headings
  per Ryan's brand decision (2026-05-06). Question marks are kept.
  endcomment
  assign display_title = article.title
  assign last_char = display_title | slice: -1
  if last_char == '.'
    assign trim_to = display_title | size | minus: 1
    assign display_title = display_title | slice: 0, trim_to
  endif

  assign primary_topic = article.metafields.field_notes.primary_topic
  if primary_topic == blank
    assign primary_topic = article.tags.first
  endif

  assign quick_answer = article.metafields.field_notes.quick_answer

  assign author_type = article.metafields.field_notes.author_type | downcase
  if author_type == blank
    assign author_type = 'ryan'
  endif

  assign words = article.content | strip_html | split: ' ' | size
  assign read_minutes = words | divided_by: 225 | at_least: 1
  assign read_time_label = read_minutes | append: ' min read'

  if author_type == 'tam'
    assign author_name = section.settings.tam_name | default: 'Tam'
    assign author_legal_name = section.settings.tam_legal_name | default: 'Tam Gow'
    assign author_person_id = section.settings.tam_person_id | default: '/our-story#tam'
    assign author_role = section.settings.tam_role
    assign author_bio = section.settings.tam_bio
    assign author_archive_url = section.settings.tam_archive_url
    assign author_avatar = section.settings.tam_avatar
    assign author_avatar_filename = section.settings.tam_avatar_filename
    assign author_ig = section.settings.tam_instagram_url
    assign author_fb = section.settings.tam_facebook_url
    assign author_yt = section.settings.tam_youtube_url
  elsif author_type == 'kid'
    assign kid_first_name = article.metafields.field_notes.kid_first_name
    assign kid_age = article.metafields.field_notes.kid_age
    assign kid_region = article.metafields.field_notes.kid_region
    capture author_name
      echo 'By '
      echo kid_first_name
      if kid_age != blank
        echo ', age '
        echo kid_age
      endif
      if kid_region != blank
        echo ' - '
        echo kid_region
      endif
    endcapture
    assign author_legal_name = blank
    assign author_person_id = blank
    assign author_role = blank
    assign author_bio = blank
    assign author_archive_url = blank
  else
    assign author_name = section.settings.ryan_name | default: 'Ryan'
    assign author_legal_name = section.settings.ryan_legal_name | default: 'Ryan Gow'
    assign author_person_id = section.settings.ryan_person_id | default: '/our-story#ryan'
    assign author_role = section.settings.ryan_role
    assign author_bio = section.settings.ryan_bio
    assign author_archive_url = section.settings.ryan_archive_url
    assign author_avatar = section.settings.ryan_avatar
    assign author_avatar_filename = section.settings.ryan_avatar_filename
    assign author_ig = section.settings.ryan_instagram_url
    assign author_fb = section.settings.ryan_facebook_url
    assign author_yt = section.settings.ryan_youtube_url
  endif

  assign author_role_override = article.metafields.field_notes.author_role_override
  if author_role_override != blank
    assign author_role = author_role_override
  endif

  if author_type == 'kid'
    assign byline_overlay = author_name
  else
    assign byline_overlay = 'By ' | append: author_name
  endif

  assign rec_heading = section.settings.rec_heading | default: "here's some more we thought you might enjoy"

  assign rec_1_handle = article.metafields.field_notes.recommendation_1_handle
  assign rec_2_handle = article.metafields.field_notes.recommendation_2_handle
  assign rec_3_handle = article.metafields.field_notes.recommendation_3_handle
  assign rec_1_blurb  = article.metafields.field_notes.recommendation_1_blurb
  assign rec_2_blurb  = article.metafields.field_notes.recommendation_2_blurb
  assign rec_3_blurb  = article.metafields.field_notes.recommendation_3_blurb

  assign rec_1 = blank
  assign rec_2 = blank
  assign rec_3 = blank
  if rec_1_handle != blank
    assign rec_1_key = blog.handle | append: '/' | append: rec_1_handle
    assign rec_1 = articles[rec_1_key]
  endif
  if rec_2_handle != blank
    assign rec_2_key = blog.handle | append: '/' | append: rec_2_handle
    assign rec_2 = articles[rec_2_key]
  endif
  if rec_3_handle != blank
    assign rec_3_key = blog.handle | append: '/' | append: rec_3_handle
    assign rec_3 = articles[rec_3_key]
  endif

  assign curated_count = 0
  if rec_1 != blank
    assign curated_count = curated_count | plus: 1
  endif
  if rec_2 != blank
    assign curated_count = curated_count | plus: 1
  endif
  if rec_3 != blank
    assign curated_count = curated_count | plus: 1
  endif

  assign full_url = request.origin | append: article.url
  assign blog_full_url = request.origin | append: blog.url
  assign root_url = request.origin
  assign og_image_url = ''
  if article.image != blank
    assign og_image_url = article.image | image_url: width: 1800
    assign og_image_url = 'https:' | append: og_image_url
    if og_image_url contains 'https:https:'
      assign og_image_url = og_image_url | replace: 'https:https:', 'https:'
    endif
  endif

  assign hero_darken = section.settings.hero_darken | default: 30
  assign hero_darken_decimal = hero_darken | times: 1.0 | divided_by: 100.0

  assign kid_character_count = 0
  for i in (1..3)
    assign img_key = 'kid_character_' | append: i
    assign filename_key = 'kid_character_' | append: i | append: '_filename'
    if section.settings[img_key] != blank or section.settings[filename_key] != blank
      assign kid_character_count = kid_character_count | plus: 1
    endif
  endfor
-%}

<article
  class="theinmag-article{% if author_type == 'kid' %} theinmag-article--kid{% endif %}"
  data-theinmag-article
  data-author-type="{{ author_type }}"
  style="--hero-darken: {{ hero_darken_decimal }};"
>
  {%- comment -%}
    Hero + body grid. On desktop the left column is sticky (cover
    image), the right column scrolls (body). On mobile they stack.
  {%- endcomment -%}
  <div class="theinmag-article__grid">
    <div class="theinmag-article__cover-col">
      <div class="theinmag-article__cover-sticky" data-cover-sticky>
        {%- if article.image != blank -%}
          <img
            class="theinmag-article__cover-image"
            srcset="
              {% if article.image.width >= 600 %}{{ article.image | image_url: width: 600 }} 600w,{% endif %}
              {% if article.image.width >= 900 %}{{ article.image | image_url: width: 900 }} 900w,{% endif %}
              {% if article.image.width >= 1200 %}{{ article.image | image_url: width: 1200 }} 1200w,{% endif %}
              {% if article.image.width >= 1600 %}{{ article.image | image_url: width: 1600 }} 1600w,{% endif %}
              {{ article.image | image_url: width: 2000 }} 2000w
            "
            sizes="(min-width: 990px) 50vw, 100vw"
            src="{{ article.image | image_url: width: 1200 }}"
            alt="{{ article.image.alt | default: article.title | escape }}"
            loading="eager"
            fetchpriority="high"
            width="{{ article.image.width }}"
            height="{{ article.image.height }}"
          >
        {%- else -%}
          <span class="theinmag-article__cover-placeholder" aria-hidden="true"></span>
        {%- endif -%}

        <div class="theinmag-article__overlay" data-hero-overlay aria-hidden="false">
          <h1 class="theinmag-article__overlay-title">{{ display_title }}</h1>
          {%- if primary_topic != blank -%}
            <span class="theinmag-article__overlay-topic">{{ primary_topic }}</span>
          {%- endif -%}
          {%- if byline_overlay != blank -%}
            <p class="theinmag-article__overlay-byline">{{ byline_overlay }}</p>
          {%- endif -%}
          {%- if author_type != 'kid' and author_role != blank -%}
            <p class="theinmag-article__overlay-role">{{ author_role }}</p>
          {%- endif -%}
        </div>
      </div>
    </div>

    <div class="theinmag-article__body-col">
      <div class="theinmag-article__body-inner">
        <header class="theinmag-article__byline-row">
          <span class="theinmag-article__byline-meta">
            {%- if primary_topic != blank -%}
              <span class="theinmag-article__byline-topic">{{ primary_topic }}</span>
            {%- endif -%}
            {%- if read_time_label != blank -%}
              <span class="theinmag-article__byline-read">{{ read_time_label }}</span>
            {%- endif -%}
            {%- if article.published_at != blank -%}
              <span class="theinmag-article__byline-date">{{ article.published_at | date: '%b %-d, %Y' }}</span>
            {%- endif -%}
          </span>
        </header>

        {%- if quick_answer != blank -%}
          <aside class="theinmag-article__quick-read" aria-label="Quick read">
            <span class="theinmag-article__quick-read-label">Quick read</span>
            <div class="theinmag-article__quick-read-body rte">{{ quick_answer }}</div>
          </aside>
        {%- endif -%}

        <div class="theinmag-article__body rte">
          {{ article.content }}
        </div>

        {%- if author_type != 'kid' -%}
          <aside class="theinmag-article__about" aria-label="About the author">
            <div class="theinmag-article__about-header">
              <div class="theinmag-article__about-avatar">
                {%- liquid
                  assign about_avatar_url = ''
                  if author_avatar != blank
                    assign about_avatar_url = author_avatar | image_url: width: 240
                  elsif author_avatar_filename != blank
                    assign about_avatar_url = author_avatar_filename | asset_url
                  endif
                -%}
                {%- if about_avatar_url != blank -%}
                  <img
                    src="{{ about_avatar_url }}"
                    alt="{{ author_name | escape }}"
                    width="120"
                    height="120"
                    loading="lazy"
                  >
                {%- else -%}
                  <span class="theinmag-article__avatar-fallback theinmag-article__avatar-fallback--lg" aria-hidden="true">{{ author_name | slice: 0, 1 }}</span>
                {%- endif -%}
              </div>
              <div class="theinmag-article__about-identity">
                <h2 class="theinmag-article__about-name">{{ author_name }}</h2>
                {%- if author_role != blank -%}
                  <p class="theinmag-article__about-role">{{ author_role }}</p>
                {%- endif -%}
              </div>
            </div>

            {%- if author_bio != blank -%}
              <p class="theinmag-article__about-bio">{{ author_bio }}</p>
            {%- endif -%}

            <div class="theinmag-article__about-actions">
              {%- if author_archive_url != blank -%}
                <a class="theinmag-article__about-link" href="{{ author_archive_url }}">More from {{ author_name }}</a>
              {%- endif -%}
              {%- if author_ig != blank or author_fb != blank or author_yt != blank -%}
                <div class="theinmag-article__about-socials">
                  {%- if author_ig != blank -%}
                    <a class="theinmag-article__about-social" href="{{ author_ig }}" aria-label="{{ author_name | escape }} on Instagram" rel="noopener" target="_blank">IG</a>
                  {%- endif -%}
                  {%- if author_fb != blank -%}
                    <a class="theinmag-article__about-social" href="{{ author_fb }}" aria-label="{{ author_name | escape }} on Facebook" rel="noopener" target="_blank">FB</a>
                  {%- endif -%}
                  {%- if author_yt != blank -%}
                    <a class="theinmag-article__about-social" href="{{ author_yt }}" aria-label="{{ author_name | escape }} on YouTube" rel="noopener" target="_blank">YT</a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </aside>
        {%- else -%}
          {%- comment -%}
            Kid attribution: name + age + region only. No "more from"
            link. Per Ryan's locked brand-safety rule, we don't surface
            kid history or build per-kid archive pages.
          {%- endcomment -%}
          <aside class="theinmag-article__about theinmag-article__about--kid" aria-label="About the contributor">
            <div class="theinmag-article__about-header">
              <div class="theinmag-article__about-avatar">
                <span
                  class="theinmag-article__kid-character theinmag-article__kid-character--lg"
                  data-theinmag-kid-character
                  data-character-count="{{ kid_character_count }}"
                  {% for i in (1..3) %}
                    {%- liquid
                      assign img_key = 'kid_character_' | append: i
                      assign filename_key = 'kid_character_' | append: i | append: '_filename'
                      assign data_key = 'data-character-' | append: i
                      assign url_value = ''
                      if section.settings[img_key] != blank
                        assign url_value = section.settings[img_key] | image_url: width: 320
                      elsif section.settings[filename_key] != blank
                        assign url_value = section.settings[filename_key] | asset_url
                      endif
                    -%}
                    {%- if url_value != blank -%}
                      {{ data_key }}="{{ url_value }}"
                    {%- endif -%}
                  {% endfor %}
                  aria-hidden="true"
                ></span>
              </div>
              <div class="theinmag-article__about-identity">
                <h2 class="theinmag-article__about-name">{{ kid_first_name }}{% if kid_age != blank %}, age {{ kid_age }}{% endif %}</h2>
                {%- if kid_region != blank -%}
                  <p class="theinmag-article__about-role">{{ kid_region }}</p>
                {%- endif -%}
              </div>
            </div>
            <p class="theinmag-article__about-bio">A creation from a kid published in theINmag. We feature contributors by first name, age, and region only.</p>
          </aside>
        {%- endif -%}
      </div>
    </div>
  </div>

  <section class="theinmag-article__recommend" aria-labelledby="theinmag-article-rec-heading">
    <div class="theinmag-article__recommend-inner">
      <header class="theinmag-article__recommend-header">
        <h2 id="theinmag-article-rec-heading" class="theinmag-article__recommend-heading">{{ rec_heading }}</h2>
        <a class="theinmag-article__recommend-link" href="/blogs/field-notes" aria-label="Browse all field notes">
          <span>browse all field notes</span>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="13 6 19 12 13 18"></polyline></svg>
        </a>
      </header>
      <div class="theinmag-article__recommend-grid">
        {%- liquid
          assign target = 4
          assign filled_count = 0
        -%}

        {%- comment -%} Step 1: curated picks (up to 3 metafield slots) {%- endcomment -%}
        {%- if rec_1 != blank and filled_count < target -%}
          {%- render 'theinmag-article-rec-card', rec: rec_1, blurb: rec_1_blurb -%}
          {%- assign filled_count = filled_count | plus: 1 -%}
        {%- endif -%}
        {%- if rec_2 != blank and filled_count < target -%}
          {%- render 'theinmag-article-rec-card', rec: rec_2, blurb: rec_2_blurb -%}
          {%- assign filled_count = filled_count | plus: 1 -%}
        {%- endif -%}
        {%- if rec_3 != blank and filled_count < target -%}
          {%- render 'theinmag-article-rec-card', rec: rec_3, blurb: rec_3_blurb -%}
          {%- assign filled_count = filled_count | plus: 1 -%}
        {%- endif -%}

        {%- comment -%} Step 2: algorithmic - same primary_topic, exclude
          current article and curated handles. {%- endcomment -%}
        {%- if filled_count < target -%}
          {%- for related in blog.articles -%}
            {%- if filled_count >= target -%}{%- break -%}{%- endif -%}
            {%- if related.id == article.id -%}{%- continue -%}{%- endif -%}
            {%- liquid
              assign related_topic = related.metafields.field_notes.primary_topic
              if related_topic == blank
                assign related_topic = related.tags.first
              endif
              assign topic_match = false
              if primary_topic != blank and related_topic == primary_topic
                assign topic_match = true
              endif
              assign already_curated = false
              if rec_1_handle != blank and related.handle == rec_1_handle
                assign already_curated = true
              endif
              if rec_2_handle != blank and related.handle == rec_2_handle
                assign already_curated = true
              endif
              if rec_3_handle != blank and related.handle == rec_3_handle
                assign already_curated = true
              endif
            -%}
            {%- if topic_match and already_curated == false -%}
              {%- render 'theinmag-article-rec-card', rec: related, blurb: blank -%}
              {%- assign filled_count = filled_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {%- comment -%} Step 3: algorithmic - any recent post,
          exclude current, curated, and topic-matched already shown. {%- endcomment -%}
        {%- if filled_count < target -%}
          {%- for related in blog.articles -%}
            {%- if filled_count >= target -%}{%- break -%}{%- endif -%}
            {%- if related.id == article.id -%}{%- continue -%}{%- endif -%}
            {%- liquid
              assign related_topic = related.metafields.field_notes.primary_topic
              if related_topic == blank
                assign related_topic = related.tags.first
              endif
              assign already_shown = false
              if primary_topic != blank and related_topic == primary_topic
                assign already_shown = true
              endif
              if rec_1_handle != blank and related.handle == rec_1_handle
                assign already_shown = true
              endif
              if rec_2_handle != blank and related.handle == rec_2_handle
                assign already_shown = true
              endif
              if rec_3_handle != blank and related.handle == rec_3_handle
                assign already_shown = true
              endif
            -%}
            {%- unless already_shown -%}
              {%- render 'theinmag-article-rec-card', rec: related, blurb: blank -%}
              {%- assign filled_count = filled_count | plus: 1 -%}
            {%- endunless -%}
          {%- endfor -%}
        {%- endif -%}

        {%- comment -%} Step 4: visual placeholder if grid is still
          empty. Sits as a teaser of what the section will look like
          once more posts exist. Each card links back to field notes. {%- endcomment -%}
        {%- if filled_count == 0 -%}
          {%- assign placeholder_topics = 'Wellbeing|Creativity|Behind the mag|Numeracy' | split: '|' -%}
          {%- assign placeholder_titles = "the case for boredom|things to draw when you're stuck|behind mag10|the open numeracy task" | split: '|' -%}
          {%- assign placeholder_blurbs = "Screens-and-YouTube isn't the cause of the dip - it's the symptom.|Five prompts for the kid who just told you they're 'bad at art.'|The messy truth of how an issue actually comes together.|Where to start if you've never run an open task before." | split: '|' -%}
          {%- assign placeholder_images = 'blog-image-universal-05.jpg|blog-image-universal-04.jpg|blog-image-universal-08.jpg|blog-image-universal-02.jpg' | split: '|' -%}
          {%- for slot in (0..3) -%}
            {%- liquid
              assign p_topic = placeholder_topics[slot]
              assign p_title = placeholder_titles[slot]
              assign p_blurb = placeholder_blurbs[slot]
              assign p_image = placeholder_images[slot]
            -%}
            <a class="theinmag-article__rec-card" href="/blogs/field-notes" aria-label="Browse all field notes">
              <span class="theinmag-article__rec-cover">
                <img class="theinmag-article__rec-image" src="{{ p_image | asset_url }}" alt="" loading="lazy" width="800" height="500">
              </span>
              <span class="theinmag-article__rec-body">
                <span class="theinmag-article__rec-topic">{{ p_topic }}</span>
                <span class="theinmag-article__rec-title">{{ p_title }}</span>
                <span class="theinmag-article__rec-blurb">{{ p_blurb }}</span>
              </span>
            </a>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </section>
</article>

{%- comment -%} Article + BreadcrumbList JSON-LD. We do NOT use Shopify's
  default `article | structured_data` because we want Person schema with
  sameAs socials for Ryan/Tam, name string only for kid contributors,
  and Quick answer wired into the description field. {%- endcomment -%}

{%- liquid
  assign schema_description = quick_answer | strip_html | strip_newlines | escape
  if schema_description == blank
    assign schema_description = article.excerpt | strip_html | escape
  endif
  if schema_description == blank
    assign schema_description = article.content | strip_html | truncatewords: 30 | escape
  endif

  assign org_name = section.settings.org_name | default: 'theINmag'
  assign org_url = section.settings.org_url | default: 'https://theinmag.com.au'
  assign org_logo_url = ''
  if section.settings.org_logo != blank
    assign org_logo_url = section.settings.org_logo | image_url: width: 600
  elsif section.settings.org_logo_filename != blank
    assign org_logo_url = section.settings.org_logo_filename | asset_url
  endif
-%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": {{ full_url | json }}
  },
  "headline": {{ display_title | json }},
  "description": {{ schema_description | json }},
  {%- if article.image != blank -%}
  "image": [
    {{ og_image_url | json }}
  ],
  {%- endif -%}
  "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "author":
  {%- if author_type == 'kid' -%}
    {{ kid_first_name | json }}
  {%- else -%}
    {
      "@type": "Person",
      {%- comment -%}
        @id consolidates the author entity across the site. name uses
        the legal form (Ryan Gow / Tam Gow) for E-E-A-T entity
        consolidation; the visible byline keeps the Ryan G. / Tam B.
        editorial form via author_name.
      {%- endcomment -%}
      "@id": {{ author_person_id | prepend: root_url | json }},
      "name": {{ author_legal_name | json }}
      {%- if author_role != blank -%}
        ,"jobTitle": {{ author_role | json }}
      {%- endif -%}
      {%- if author_archive_url != blank -%}
        ,"url": {{ author_archive_url | prepend: root_url | json }}
      {%- endif -%}
      {%- assign sameas_count = 0 -%}
      {%- if author_ig != blank %}{%- assign sameas_count = sameas_count | plus: 1 -%}{% endif -%}
      {%- if author_fb != blank %}{%- assign sameas_count = sameas_count | plus: 1 -%}{% endif -%}
      {%- if author_yt != blank %}{%- assign sameas_count = sameas_count | plus: 1 -%}{% endif -%}
      {%- if sameas_count > 0 -%}
        ,"sameAs": [
          {%- assign first = true -%}
          {%- if author_ig != blank -%}{{ author_ig | json }}{%- assign first = false -%}{%- endif -%}
          {%- if author_fb != blank -%}{%- unless first -%},{%- endunless -%}{{ author_fb | json }}{%- assign first = false -%}{%- endif -%}
          {%- if author_yt != blank -%}{%- unless first -%},{%- endunless -%}{{ author_yt | json }}{%- endif -%}
        ]
      {%- endif -%}
    }
  {%- endif -%},
  "publisher": {
    "@type": "Organization",
    "name": {{ org_name | json }},
    "url": {{ org_url | json }}
    {%- if org_logo_url != blank -%}
      ,"logo": {
        "@type": "ImageObject",
        "url": {{ org_logo_url | json }}
      }
    {%- endif -%}
  }
}
</script>

