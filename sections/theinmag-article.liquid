    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: clamp(16px, 2vw, 32px);
    margin: 0 0 clamp(32px, 3.5vw, 48px);
    padding: 0 clamp(8px, 2vw, 32px);
  }

  /* Inter editorial subhead - friendly conversational sentence,
     not a display wordmark (Post Regular is reserved for brand-
     identity moments, of which the recommendation strip is not one). */
  .theinmag-article__recommend-heading {
    margin: 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: clamp(18px, 2vw, 24px);
    line-height: 1.3;
    letter-spacing: -0.005em;
    color: var(--color-ink);
  }

  .theinmag-article__recommend-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 22px;
    background-color: transparent;
    color: var(--color-purple-dark);
    border: 2px solid var(--color-purple-dark);
    border-radius: 32px;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: clamp(11px, 1.1vw, 13px);
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .theinmag-article__recommend-link:hover,
  .theinmag-article__recommend-link:focus-visible {
    background-color: var(--color-purple-dark);
    color: #FFFFFF;
    outline: none;
  }

  .theinmag-article__recommend-link svg {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .theinmag-article__recommend-link:hover svg,
  .theinmag-article__recommend-link:focus-visible svg {
    transform: translateX(3px);
  }

  .theinmag-article__recommend-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(14px, 1.6vw, 20px);
  }

  @media (min-width: 600px) {
    .theinmag-article__recommend-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 990px) {
    .theinmag-article__recommend-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* ================================================================
     Headroom: auto-hide site header on scroll-down, show on scroll-up.
     Scoped to article pages because this stylesheet only loads with
     this section. We transform the SECTION WRAPPER (theinmag-header-
     section) - that's the element with position: sticky in the
     header file. Transforming the inner .theinmag-header alone would
     leave the sticky wrapper's empty space visible mid-animation
     (the "blank white" gap).
     ================================================================ */
  .theinmag-header-section {
    /* overflow: clip ensures the sticker's margin-bottom: -6px overhang
       is contained within the wrapper bounds during transform, so the
       whole thing reads as a single rectangle sliding up rather than
       a bar with bits hanging off it that might appear to desync. */
    overflow: clip;
    transition: transform 0.45s ease-out;
  }

  .theinmag-header-section.is-headroom-hidden {
    transform: translate3d(0, -100%, 0);
    pointer-events: none;
  }

  /* ================================================================
     Reduced motion: disable sticky parallax + overlay fade. Image at
     full brightness from the start; overlay text stays visible until
     naturally scrolled past. Header auto-hide is also skipped (the
     JS short-circuits under prefers-reduced-motion).
     ================================================================ */
  @media (prefers-reduced-motion: reduce) {
    .theinmag-article__cover-image {
      filter: none;
      transform: none;
      transition: none;
    }

    .theinmag-article__overlay {
      opacity: 1;
      transform: none;
      transition: none;
    }

    @media (min-width: 990px) {
      .theinmag-article__cover-sticky {
        position: relative;
        height: auto;
        aspect-ratio: 3 / 4;
      }
    }
  }
{%- endstylesheet -%}

<script>
  (function () {
    var article = document.querySelector('[data-theinmag-article]');
    if (!article) return;

    var prefersReduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* Single rAF-throttled scroll listener doing two things on every
       update: (1) hero overlay fade + cover image brightness via
       --hero-progress custom property (0 at article top, 1 by 30vh
       past); (2) headroom-style auto-hide of the site header on
       scroll-down, show on scroll-up. Tracks the article's rect.top
       (NOT the sticky child's, whose rect.top is glued to 0 during
       the sticky phase). */
    if (!prefersReduced) {
      /* Target the sticky section wrapper, not the inner .theinmag-header
         (which is position: relative inside the wrapper - transforming
         it leaves the wrapper's space empty during the slide). */
      var siteHeader = document.querySelector('.theinmag-header-section');
      var lastScrollY = window.pageYOffset;
      var ticking = false;

      function update() {
        ticking = false;
        var currentY = window.pageYOffset;

        var rect = article.getBoundingClientRect();
        var vh = window.innerHeight || document.documentElement.clientHeight;
        var travel = vh * 0.3;
        if (travel > 0) {
          var scrolled = Math.max(0, -rect.top);
          var progress = Math.min(1, scrolled / travel);
          article.style.setProperty('--hero-progress', progress.toFixed(3));
        }

        if (siteHeader) {
          if (currentY <= 5) {
            siteHeader.classList.remove('is-headroom-hidden');
            lastScrollY = currentY;
          } else {
            var delta = currentY - lastScrollY;
            if (delta > 8) {
              siteHeader.classList.add('is-headroom-hidden');
              lastScrollY = currentY;
            } else if (delta < -8) {
              siteHeader.classList.remove('is-headroom-hidden');
              lastScrollY = currentY;
            }
          }
        }
      }

      function onScroll() {
        if (!ticking) {
          window.requestAnimationFrame(update);
          ticking = true;
        }
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      update();
    }

    /* Random kid character. Pool of up to 3 images shipped via section
       settings; one is picked at page load. Pattern matches
       sections/theinmag-mission.liquid (reference_kid_character_pattern
       memory). No scroll-pop here - just static. */
    var characters = article.querySelectorAll('[data-theinmag-kid-character]');
    characters.forEach(function (el) {
      var count = parseInt(el.getAttribute('data-character-count') || '0', 10);
      if (!count) return;
      var pool = [];
      for (var i = 1; i <= 3; i++) {
        var url = el.getAttribute('data-character-' + i);
        if (url) pool.push(url);
      }
      if (!pool.length) return;
      var pick = pool[Math.floor(Math.random() * pool.length)];
      el.style.backgroundImage = "url('" + pick + "')";
    });
  })();
</script>

{% schema %}
{
  "name": "field notes article",
  "tag": "section",
  "class": "theinmag-article-section",
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "range",
      "id": "hero_darken",
      "label": "Hero image darkening",
