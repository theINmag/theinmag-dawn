{%- comment -%}
  theinmag-header
  Site-wide chrome that sits between the announcement bar (above) and
  the page content (below). Replaces Dawn's stock header.

  Layout:
  - Desktop (>= 990px): three-zone grid.
      [sticker + logo]   [nav (Shop / INfo / Gallery / Blog / Freebies)]   [cart + Send IN content]
    INfo opens a dropdown on hover/focus.
  - Mobile (< 990px):
      [sticker + logo]   [cart + hamburger]
    Hamburger opens a full slide drawer that mirrors the live mobile site:
    full logo top, stacked flat nav (INfo's sub-pages render inline as
    siblings - no accordion), yellow Send IN content stamp, three
    socials at the bottom.

  Sticky behaviour: always-on. Subtle shadow appears once scrolled past 0.
  Hide-on-scroll-down was rejected: too clever for a grandparent + kid
  audience, and keeping the persistent CTA always visible supports the
  6 -> 8-10% conversion goal.

  Account icon: deliberately not rendered. Membership is conceptually
  separate from a Shopify customer login - showing a person icon invites
  the exact "where do I log in?" confusion Ryan flagged.

  Dropdown items (INfo) live as schema blocks so admin can add Stockists
  / Where we'll be next without a code edit. The five top-level nav
  items are hardcoded as label/link settings - that structure is locked.

  Spec: ../theinmag-docs/theinmag-design-tokens.md "Navigation language".
{%- endcomment -%}

{%- liquid
  assign sticker = section.settings.sticker_image
  assign logo = section.settings.logo_image
  assign logo_full = section.settings.logo_image_full

  assign cta_label = section.settings.cta_label | default: 'Send IN content'
  assign cta_link = section.settings.cta_link | default: '/pages/send-in-content'

  assign instagram_url = section.settings.instagram_url
  assign facebook_url = section.settings.facebook_url
  assign youtube_url = section.settings.youtube_url

  assign cart_count = cart.item_count
-%}

<header
  class="theinmag-header"
  data-theinmag-header
  role="banner"
>
  {%- comment -%}
    Flat flex row. Order on desktop:
      [sticker] [INfo Gallery Blog Freebies] ........ [logo] [Shop] [cart] [CTA]
    The desktop nav has margin-right:auto, which shoves the right cluster
    over to the far right. On mobile the nav + Shop + CTA are hidden and
    [logo] gets the auto margin instead, giving:
      [sticker] [logo] ........ [cart] [hamburger]
  {%- endcomment -%}
  <div class="theinmag-header__inner">

    <a class="theinmag-header__sticker-link" href="{{ routes.root_url }}" aria-label="theINmag - made by kids, for kids">
      {%- if sticker != blank -%}
        <img
          class="theinmag-header__sticker"
          src="{{ sticker | image_url: width: 400 }}"
          alt="Made by kids, for kids"
          loading="eager"
        >
      {%- else -%}
        <img
          class="theinmag-header__sticker"
          src="{{ 'madebykids_logo.svg' | asset_url }}"
          alt="Made by kids, for kids"
          loading="eager"
        >
      {%- endif -%}
    </a>

    {%- comment -%}
      Desktop primary nav (left cluster, after sticker). Holds INfo
      dropdown + Gallery / Blog / Freebies. Shop is rendered separately
      on the right side, hard up against the cart.
    {%- endcomment -%}
    <nav class="theinmag-header__nav" aria-label="Primary">
      <ul class="theinmag-header__nav-list" role="list">

        {%- comment -%}
          INfo dropdown trigger is a button (it doesn't navigate, it
          reveals a panel). CSS shows the panel on :hover and
          :focus-within; JS toggles aria-expanded + outside-click +
          Escape close.
        {%- endcomment -%}
        <li class="theinmag-header__nav-item theinmag-header__nav-item--has-dropdown" data-dropdown>
          <button
            type="button"
            class="theinmag-header__nav-link theinmag-header__dropdown-trigger"
            aria-haspopup="true"
            aria-expanded="false"
            data-dropdown-trigger
          >
            {{ section.settings.nav_2_label | default: 'INfo' }}
            <svg class="theinmag-header__caret" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
              <path d="M7 10l5 5 5-5z"></path>
            </svg>
          </button>

          {%- if section.blocks.size > 0 -%}
            <div class="theinmag-header__dropdown" data-dropdown-panel>
              <ul class="theinmag-header__dropdown-list" role="list">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'dropdown_item' -%}
                    <li {{ block.shopify_attributes }}>
                      <a
                        class="theinmag-header__dropdown-link"
                        href="{{ block.settings.link | default: '#' }}"
                      >
                        {{ block.settings.label }}
                      </a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        </li>

        <li class="theinmag-header__nav-item">
          <a class="theinmag-header__nav-link" href="{{ section.settings.nav_3_link | default: '/pages/gallery' }}">
            {{ section.settings.nav_3_label | default: 'Gallery' }}
          </a>
        </li>

        <li class="theinmag-header__nav-item">
          <a class="theinmag-header__nav-link" href="{{ section.settings.nav_4_link | default: '/blogs/field-notes' }}">
            {{ section.settings.nav_4_label | default: 'Field notes' }}
          </a>
        </li>

        <li class="theinmag-header__nav-item">
          <a class="theinmag-header__nav-link" href="{{ section.settings.nav_5_link | default: '/pages/freebies' }}">
            {{ section.settings.nav_5_label | default: 'Freebies' }}
          </a>
        </li>

      </ul>
    </nav>

    {%- comment -%} RIGHT cluster - logo + Shop + cart + persistent CTA. {%- endcomment -%}
    <a class="theinmag-header__logo-link" href="{{ routes.root_url }}" aria-label="theINmag home">
      {%- if logo != blank -%}
        <img
          class="theinmag-header__logo"
          src="{{ logo | image_url: width: 600 }}"
          alt="theINmag"
          loading="eager"
          fetchpriority="high"
        >
      {%- else -%}
        <img
          class="theinmag-header__logo"
          src="{{ 'header_logo.svg' | asset_url }}"
          alt="theINmag"
          loading="eager"
          fetchpriority="high"
        >
      {%- endif -%}
    </a>

    <a class="theinmag-header__shop-link" href="{{ section.settings.nav_1_link | default: '/collections/all' }}">
      {{ section.settings.nav_1_label | default: 'Shop' }}
    </a>

    <a
      class="theinmag-header__cart"
      href="{{ routes.cart_url }}"
      aria-label="Cart{% if cart_count > 0 %}, {{ cart_count }} item{% if cart_count != 1 %}s{% endif %}{% endif %}"
    >
      <svg class="theinmag-header__cart-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M5 7h14l-1.2 12.2A2 2 0 0 1 15.81 21H8.19a2 2 0 0 1-1.99-1.8L5 7Z"></path>
        <path d="M9 7V5.5a3 3 0 0 1 6 0V7"></path>
      </svg>
      {%- if cart_count > 0 -%}
        <span class="theinmag-header__cart-count" data-cart-count>{{ cart_count }}</span>
      {%- endif -%}
    </a>

    <a class="theinmag-btn theinmag-btn--primary theinmag-header__cta" href="{{ cta_link }}">
      {{ cta_label }}
    </a>

    <button
      type="button"
      class="theinmag-header__hamburger"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="theinmag-drawer"
      data-drawer-open
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true" focusable="false">
        <line x1="4" y1="7" x2="20" y2="7"></line>
        <line x1="4" y1="12" x2="20" y2="12"></line>
        <line x1="4" y1="17" x2="20" y2="17"></line>
      </svg>
    </button>

  </div>
</header>

{%- comment -%}
  Mobile drawer. Lives outside the sticky header so transforms inside
  it can't get clipped by header overflow. Hidden by default; opens
  with a slide-down + fade and traps focus while open.
{%- endcomment -%}
<aside
  id="theinmag-drawer"
  class="theinmag-drawer"
  data-drawer
  aria-hidden="true"
  aria-label="Site menu"
>
  <div class="theinmag-drawer__overlay" data-drawer-close></div>

  <div class="theinmag-drawer__panel" role="dialog" aria-modal="true" aria-label="Site menu">

    <button
      type="button"
      class="theinmag-drawer__close"
      aria-label="Close menu"
      data-drawer-close
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
        <line x1="6" y1="6" x2="18" y2="18"></line>
        <line x1="18" y1="6" x2="6" y2="18"></line>
      </svg>
    </button>

    <a class="theinmag-drawer__logo-link" href="{{ routes.root_url }}" aria-label="theINmag home">
      {%- if logo_full != blank -%}
        <img
          class="theinmag-drawer__logo"
          src="{{ logo_full | image_url: width: 600 }}"
          alt="theINmag - made by kids, for kids"
          loading="lazy"
        >
      {%- else -%}
        <img
          class="theinmag-drawer__logo"
          src="{{ 'full_logo.svg' | asset_url }}"
          alt="theINmag - made by kids, for kids"
          loading="lazy"
        >
      {%- endif -%}
    </a>

    {%- comment -%}
      Drawer nav is FLAT - no accordion. INfo is a small group label
      and its sub-items appear inline as their own tappable links.
      Matches the live mobile drawer's flat list aesthetic and avoids
      a tap-to-expand step.
    {%- endcomment -%}
    <nav class="theinmag-drawer__nav" aria-label="Primary mobile">
      <ul class="theinmag-drawer__list" role="list">

        <li>
          <a class="theinmag-drawer__link" href="{{ section.settings.nav_1_link | default: '/collections/all' }}">
            {{ section.settings.nav_1_label | default: 'Shop' }}
          </a>
        </li>

        {%- if section.blocks.size > 0 -%}
          <li class="theinmag-drawer__group">
            <span class="theinmag-drawer__group-label" aria-hidden="true">{{ section.settings.nav_2_label | default: 'INfo' }}</span>
            <ul class="theinmag-drawer__sublist" role="list" aria-label="{{ section.settings.nav_2_label | default: 'INfo' }} pages">
              {%- for block in section.blocks -%}
                {%- if block.type == 'dropdown_item' -%}
                  <li {{ block.shopify_attributes }}>
                    <a class="theinmag-drawer__sublink" href="{{ block.settings.link | default: '#' }}">
                      {{ block.settings.label }}
                    </a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </li>
        {%- endif -%}

        <li>
          <a class="theinmag-drawer__link" href="{{ section.settings.nav_3_link | default: '/pages/gallery' }}">
            {{ section.settings.nav_3_label | default: 'Gallery' }}
          </a>
        </li>

        <li>
          <a class="theinmag-drawer__link" href="{{ section.settings.nav_4_link | default: '/blogs/field-notes' }}">
            {{ section.settings.nav_4_label | default: 'Field notes' }}
          </a>
        </li>

        <li>
          <a class="theinmag-drawer__link" href="{{ section.settings.nav_5_link | default: '/pages/freebies' }}">
            {{ section.settings.nav_5_label | default: 'Freebies' }}
          </a>
        </li>

      </ul>
    </nav>

    <a class="theinmag-btn theinmag-btn--primary theinmag-drawer__cta" href="{{ cta_link }}">
      {{ cta_label }}
    </a>

    {%- if instagram_url != blank or facebook_url != blank or youtube_url != blank -%}
      <ul class="theinmag-drawer__socials" role="list" aria-label="Follow theINmag">
        {%- if instagram_url != blank -%}
          <li>
            <a class="theinmag-drawer__social-link" href="{{ instagram_url }}" target="_blank" rel="noopener noreferrer" aria-label="theINmag on Instagram">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" focusable="false">
                <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                <circle cx="12" cy="12" r="4"></circle>
                <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"></circle>
              </svg>
            </a>
          </li>
        {%- endif -%}
        {%- if facebook_url != blank -%}
          <li>
            <a class="theinmag-drawer__social-link" href="{{ facebook_url }}" target="_blank" rel="noopener noreferrer" aria-label="theINmag on Facebook">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                <path d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.7c0-.9.3-1.5 1.6-1.5h1.7V4.3a23 23 0 0 0-2.5-.1c-2.5 0-4.2 1.5-4.2 4.3v2.4H7.4V14h2.7v8h3.4Z"></path>
              </svg>
            </a>
          </li>
        {%- endif -%}
        {%- if youtube_url != blank -%}
          <li>
            <a class="theinmag-drawer__social-link" href="{{ youtube_url }}" target="_blank" rel="noopener noreferrer" aria-label="theINmag on YouTube">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                <path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8ZM10 15V9l5.2 3-5.2 3Z"></path>
              </svg>
            </a>
          </li>
        {%- endif -%}
      </ul>
    {%- endif -%}

  </div>
</aside>

{% stylesheet %}
  /* ================================================================
     theinmag-header
     Sticky always-on. Flat flex row at every breakpoint.

     Desktop order:
       [sticker] [INfo Gallery Blog Freebies] ........ [logo] [Shop] [cart] [CTA]
     The .nav element gets margin-right:auto, which is the flex idiom
     for "push everything after me to the far right." Hamburger is
     hidden, all the rest are visible.

     Mobile order:
       [sticker] [logo] ........ [cart] [hamburger]
     Nav, Shop link, CTA all hidden. The .logo-link gets margin-right:auto
     instead, pushing cart + hamburger over to the right.
     ================================================================ */

  /* Sticky lives on the SECTION WRAPPER class (set via schema "class"
     field). Dawn's sticky relies on a JS-added class that our custom
     header doesn't inherit, so we make the wrapper sticky directly.
     Margin + padding zeroed on the wrapper so nothing leaks below the
     header into the hero. */
  /* Two-class selector beats Dawn's base.css rule
     `.shopify-section-group-header-group { z-index: 4 }` which has only
     one class of specificity and would otherwise win the cascade. The
     dropdown panel was being painted at z-index 4 because of that. */
  .shopify-section.theinmag-header-section {
    position: sticky;
    top: 0;
    /* z-index 90 keeps the INfo dropdown above sections below the
       header. Stays below the mobile drawer at z-index 100 so drawer
       overlay still wins on open. isolation: isolate forces a stacking
       context independent of z-index ordering. overflow: visible
       guarantees the dropdown panel can paint outside the header's
       bounds even if a parent rule tries to clip it. */
    z-index: 90;
    isolation: isolate;
    overflow: visible;
    margin: 0;
    padding: 0;
    line-height: 0;
  }

  .theinmag-header {
    position: relative;
    background-color: var(--color-cream);
    transition: box-shadow var(--transition-standard);
    /* Reset the line-height: 0 from the wrapper for the actual content. */
    line-height: 1.4;
  }

  .theinmag-header.is-scrolled {
    box-shadow: 0 2px 12px rgba(42, 31, 61, 0.08);
  }

  .theinmag-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    /* Small vertical padding so the row breathes - the gap-to-hero
       fix happens at the section/wrapper level, not by stripping
       header padding. */
    padding: 6px var(--space-md);
    max-width: 1440px;
    margin: 0 auto;
  }

  @media (min-width: 750px) {
    .theinmag-header__inner {
      gap: var(--space-md);
      padding: 8px var(--space-xl);
    }
  }

  @media (min-width: 990px) {
    .theinmag-header__inner {
      gap: var(--space-lg);
    }
  }

  /* ================================================================
     Sticker - left edge, significantly bigger than v1.
     SVG is wide (viewBox 600x240, ~2.5:1) so widths translate to
     visually substantial heights without dominating the row.
     ================================================================ */

  .theinmag-header__sticker-link {
    display: inline-flex;
    align-items: center;
    line-height: 0;
    flex-shrink: 0;
    /* Bleed the bubble past the inner's left + bottom padding so it
       sits flush against the header's bottom-left corner, matching the
       existing theinmag.com.au header. align-self overrides the inner's
       align-items: center so the sticker hugs the bottom edge.

       The SVG asset's viewBox is cropped tight to the visible scribble
       (left/right/bottom = 0% padding), so the negative margins simply
       cancel the inner element's padding -- no fudge factor required. */
    align-self: flex-end;
    margin-left: calc(-1 * var(--space-md));
    margin-bottom: -6px;
  }

  @media (min-width: 750px) {
    .theinmag-header__sticker-link {
      margin-left: calc(-1 * var(--space-xl));
      margin-bottom: -8px;
    }
  }

  .theinmag-header__sticker {
    display: block;
    width: 100px;
    height: auto;
    transition: transform var(--transition-hover);
  }

  @media (min-width: 750px) {
    .theinmag-header__sticker { width: 150px; }
  }

  @media (min-width: 990px) {
    .theinmag-header__sticker { width: 180px; }
  }

  @media (min-width: 1200px) {
    .theinmag-header__sticker { width: 210px; }
  }

  .theinmag-header__sticker-link:hover .theinmag-header__sticker,
  .theinmag-header__sticker-link:focus-visible .theinmag-header__sticker {
    transform: rotate(-2deg) scale(1.03);
  }

  /* ================================================================
     Logo - lives in the right cluster on desktop, in the left
     cluster (just after sticker) on mobile. On mobile it grabs the
     auto margin so cart + hamburger get pushed to the far right.
     ================================================================ */

  .theinmag-header__logo-link {
    display: inline-flex;
    align-items: center;
    line-height: 0;
    flex-shrink: 0;
    margin-right: auto;
  }

  @media (min-width: 990px) {
    .theinmag-header__logo-link {
      margin-right: 0;
    }
  }

  .theinmag-header__logo {
    display: block;
    width: 120px;
    height: auto;
  }

  @media (min-width: 750px) {
    .theinmag-header__logo { width: 150px; }
  }

  @media (min-width: 990px) {
    .theinmag-header__logo { width: 180px; }
  }

  /* ================================================================
     Desktop primary nav (left cluster, after sticker).
     Hidden on mobile - the drawer carries the same items.
     margin-right: auto on the nav itself shoves the right cluster
     (logo, Shop, cart, CTA) to the far right.
     ================================================================ */

  .theinmag-header__nav {
    display: none;
  }

  @media (min-width: 990px) {
    .theinmag-header__nav {
      display: block;
      margin-right: auto;
      margin-left: var(--space-md);
    }
  }

  .theinmag-header__nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: var(--space-lg);
  }

  .theinmag-header__nav-item {
    position: relative;
  }

  .theinmag-header__nav-link {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 16px;
    color: var(--color-inky-purple-navy);
    text-decoration: none;
    padding: 8px 4px;
    line-height: 1.2;
    background: transparent;
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: color var(--transition-standard);
    white-space: nowrap;
  }

  .theinmag-header__nav-link:hover,
  .theinmag-header__nav-link:focus-visible {
    color: var(--color-purple-dark);
    outline: none;
  }

  /* Dropdown trigger caret rotates 180deg when expanded. */
  .theinmag-header__caret {
    width: 14px;
    height: 14px;
    transition: transform var(--transition-standard);
  }

  .theinmag-header__dropdown-trigger[aria-expanded="true"] .theinmag-header__caret {
    transform: rotate(180deg);
  }

  /* ================================================================
     INfo dropdown panel
     ================================================================ */

  .theinmag-header__dropdown {
    position: absolute;
    top: 100%;
    left: -16px;
    min-width: 220px;
    background-color: var(--color-cream);
    border-radius: var(--radius-lg);
    box-shadow: 0 8px 28px rgba(42, 31, 61, 0.12);
    padding: var(--space-sm);
    margin-top: var(--space-sm);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity var(--transition-standard),
                transform var(--transition-standard),
                visibility 0s linear var(--transition-standard);
    /* High z-index inside the header section's own stacking context.
       Combined with isolation:isolate on the section wrapper, this
       guarantees the dropdown paints above any neighbouring section. */
    z-index: 9999;
  }

  /* Show on hover OR keyboard focus OR explicit aria-expanded.
     :focus-within keeps the panel open while a child link is focused. */
  .theinmag-header__nav-item--has-dropdown:hover .theinmag-header__dropdown,
  .theinmag-header__nav-item--has-dropdown:focus-within .theinmag-header__dropdown,
  .theinmag-header__nav-item--has-dropdown.is-open .theinmag-header__dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition: opacity var(--transition-standard),
                transform var(--transition-standard),
                visibility 0s;
  }

  .theinmag-header__dropdown-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .theinmag-header__dropdown-link {
    display: block;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 15px;
    color: var(--color-inky-purple-navy);
    text-decoration: none;
    padding: 10px 14px;
    border-radius: var(--radius-md);
    transition: background-color var(--transition-standard),
                color var(--transition-standard);
    white-space: nowrap;
  }

  .theinmag-header__dropdown-link:hover,
  .theinmag-header__dropdown-link:focus-visible {
    background-color: var(--color-lavender);
    color: var(--color-purple-dark);
    outline: none;
  }

  /* ================================================================
     Shop link - lives on the right, hard up against the cart.
     Desktop only. On mobile, Shop is in the drawer.
     ================================================================ */

  .theinmag-header__shop-link {
    display: none;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 16px;
    color: var(--color-inky-purple-navy);
    text-decoration: none;
    padding: 8px 4px;
    line-height: 1.2;
    transition: color var(--transition-standard);
    white-space: nowrap;
  }

  .theinmag-header__shop-link:hover,
  .theinmag-header__shop-link:focus-visible {
    color: var(--color-purple-dark);
    outline: none;
  }

  @media (min-width: 990px) {
    .theinmag-header__shop-link {
      display: inline-flex;
      align-items: center;
    }
  }

  /* ================================================================
     Cart icon
     ================================================================ */

  .theinmag-header__cart {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--color-inky-purple-navy);
    text-decoration: none;
    border-radius: var(--radius-pill);
    transition: color var(--transition-standard),
                background-color var(--transition-standard);
  }

  .theinmag-header__cart:hover,
  .theinmag-header__cart:focus-visible {
    color: var(--color-purple-dark);
    background-color: var(--color-lavender);
    outline: none;
  }

  .theinmag-header__cart-icon {
    width: 24px;
    height: 24px;
  }

  .theinmag-header__cart-count {
    position: absolute;
    top: -2px;
    right: -2px;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: var(--radius-pill);
    background-color: var(--color-yellow);
    color: var(--color-inky-purple-navy);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 11px;
    line-height: 18px;
    text-align: center;
    box-shadow: 0 1px 0 var(--color-yellow-shadow);
  }

  /* Persistent CTA - desktop only. Phone + tablet use the drawer
     CTA at the bottom of the menu. The chained .theinmag-btn class
     bumps specificity past the base .theinmag-btn { display: inline-flex }
     so the hide actually wins. */
  .theinmag-btn.theinmag-header__cta {
    display: none;
  }

  @media (min-width: 990px) {
    .theinmag-btn.theinmag-header__cta {
      display: inline-flex;
      padding: 14px 28px;
      font-size: 18px;
    }
  }

  /* Hamburger - visible below 990px. Less rounded (rectangle with
     soft corners), tighter shadow than v1. The button keeps a 44px
     touch-target via padding around a smaller icon. */
  .theinmag-header__hamburger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background-color: var(--color-yellow);
    color: var(--color-inky-purple-navy);
    border: none;
    border-radius: 8px;
    box-shadow: 0 2px 0 var(--color-yellow-shadow);
    cursor: pointer;
    transition: background-color var(--transition-standard),
                color var(--transition-standard),
                box-shadow var(--transition-standard),
                translate var(--transition-standard);
  }

  .theinmag-header__hamburger:hover,
  .theinmag-header__hamburger:focus-visible {
    background-color: var(--color-purple-dark);
    color: #ffffff;
    translate: 0 1px;
    box-shadow: 0 1px 0 #4A2D62;
    outline: none;
  }

  .theinmag-header__hamburger svg {
    width: 20px;
    height: 20px;
  }

  @media (min-width: 990px) {
    .theinmag-header__hamburger {
      display: none;
    }
  }

  /* ================================================================
     Mobile drawer
     Hidden by default. Slides down + fades in. Locks body scroll.
     ================================================================ */

  .theinmag-drawer {
    position: fixed;
    inset: 0;
    z-index: 100;
    visibility: hidden;
    pointer-events: none;
  }

  .theinmag-drawer.is-open {
    visibility: visible;
    pointer-events: auto;
  }

  .theinmag-drawer__overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(42, 31, 61, 0.4);
    opacity: 0;
    transition: opacity var(--transition-hover);
  }

  .theinmag-drawer.is-open .theinmag-drawer__overlay {
    opacity: 1;
  }

  .theinmag-drawer__panel {
    position: absolute;
    inset: 0;
    background-color: var(--color-cream);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--space-2xl) var(--space-lg) var(--space-xl);
    overflow-y: auto;
    transform: translateY(-12px);
    opacity: 0;
    transition: transform var(--transition-hover),
                opacity var(--transition-hover);
  }

  .theinmag-drawer.is-open .theinmag-drawer__panel {
    transform: translateY(0);
    opacity: 1;
  }

  .theinmag-drawer__close {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    border-radius: var(--radius-pill);
    color: var(--color-inky-purple-navy);
    cursor: pointer;
    transition: background-color var(--transition-standard);
  }

  .theinmag-drawer__close:hover,
  .theinmag-drawer__close:focus-visible {
    background-color: var(--color-lavender);
    outline: none;
  }

  .theinmag-drawer__close svg {
    width: 24px;
    height: 24px;
  }

  .theinmag-drawer__logo-link {
    display: inline-flex;
    margin-top: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .theinmag-drawer__logo {
    display: block;
    width: clamp(180px, 55vw, 260px);
    height: auto;
  }

  .theinmag-drawer__nav {
    width: 100%;
    margin-bottom: var(--space-2xl);
  }

  .theinmag-drawer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Generous breathing room between items - matches the live site's
       mobile drawer where each link gets its own visual line of space. */
    gap: var(--space-xl);
  }

  .theinmag-drawer__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 22px;
    color: var(--color-inky-purple-navy);
    text-decoration: none;
    padding: 4px 12px;
    line-height: 1.2;
    transition: color var(--transition-standard);
  }

  .theinmag-drawer__link:hover,
  .theinmag-drawer__link:focus-visible {
    color: var(--color-purple-dark);
    outline: none;
  }

  /* INfo group - the label sits as a quiet section heading and the
     sub-pages render directly underneath as their own tappable links.
     No accordion. Gives the drawer a flat, scannable feel. */
  .theinmag-drawer__group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  .theinmag-drawer__group-label {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .theinmag-drawer__sublist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  .theinmag-drawer__sublink {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 19px;
    color: var(--color-inky-purple-navy);
    text-decoration: none;
    padding: 4px 12px;
    transition: color var(--transition-standard);
  }

  .theinmag-drawer__sublink:hover,
  .theinmag-drawer__sublink:focus-visible {
    color: var(--color-purple-dark);
    outline: none;
  }

  .theinmag-drawer__cta {
    margin-bottom: var(--space-xl);
    padding: 14px 32px;
    font-size: 16px;
  }

  .theinmag-drawer__socials {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xl);
  }

  .theinmag-drawer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--color-inky-purple-navy);
    border-radius: var(--radius-pill);
    transition: color var(--transition-standard),
                background-color var(--transition-standard);
  }

  .theinmag-drawer__social-link:hover,
  .theinmag-drawer__social-link:focus-visible {
    color: var(--color-purple-dark);
    background-color: var(--color-lavender);
    outline: none;
  }

  .theinmag-drawer__social-link svg {
    width: 26px;
    height: 26px;
  }

  /* Body scroll lock while drawer is open. JS toggles the class. */
  body.theinmag-drawer-open {
    overflow: hidden;
  }

  /* Reduced motion - kill the slide, keep the fade. Sticky shadow
     transition is already a colour change so no override needed. */
  @media (prefers-reduced-motion: reduce) {
    .theinmag-drawer__panel,
    .theinmag-drawer__overlay,
    .theinmag-header__dropdown,
    .theinmag-header__sticker,
    .theinmag-header__caret {
      transition-duration: 0.01ms;
    }

    .theinmag-header__sticker-link:hover .theinmag-header__sticker,
    .theinmag-header__sticker-link:focus-visible .theinmag-header__sticker {
      transform: none;
    }
  }
{% endstylesheet %}

<script>
  (function () {
    var header = document.querySelector('[data-theinmag-header]');
    if (!header) return;

    /* ----- Sticky shadow once scrolled ----- */
    var setScrolled = function () {
      if (window.scrollY > 4) {
        header.classList.add('is-scrolled');
      } else {
        header.classList.remove('is-scrolled');
      }
    };
    setScrolled();
    window.addEventListener('scroll', setScrolled, { passive: true });

    /* ----- Desktop INfo dropdown - keyboard support + outside click -----
       CSS handles hover/focus-within natively. JS adds: aria-expanded
       toggle for screen readers, click-toggle for touch users on
       desktop, Escape to close, click outside to close. */
    var dropdown = header.querySelector('[data-dropdown]');
    var dropdownTrigger = header.querySelector('[data-dropdown-trigger]');

    if (dropdown && dropdownTrigger) {
      var openDropdown = function () {
        dropdown.classList.add('is-open');
        dropdownTrigger.setAttribute('aria-expanded', 'true');
      };
      var closeDropdown = function () {
        dropdown.classList.remove('is-open');
        dropdownTrigger.setAttribute('aria-expanded', 'false');
      };
      var toggleDropdown = function () {
        if (dropdown.classList.contains('is-open')) closeDropdown();
        else openDropdown();
      };

      dropdownTrigger.addEventListener('click', function (e) {
        e.preventDefault();
        toggleDropdown();
      });

      dropdownTrigger.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
          closeDropdown();
          dropdownTrigger.focus();
        }
      });

      dropdown.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
          closeDropdown();
          dropdownTrigger.focus();
        }
      });

      document.addEventListener('click', function (e) {
        if (!dropdown.contains(e.target)) closeDropdown();
      });
    }

    /* ----- Mobile drawer - open/close, focus trap, body scroll lock ----- */
    var drawer = document.querySelector('[data-drawer]');
    var openButton = header.querySelector('[data-drawer-open]');
    var closeButtons = drawer ? drawer.querySelectorAll('[data-drawer-close]') : [];

    if (drawer && openButton) {
      var lastFocused = null;

      var getFocusable = function () {
        return drawer.querySelectorAll(
          'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
        );
      };

      var openDrawer = function () {
        lastFocused = document.activeElement;
        drawer.classList.add('is-open');
        drawer.setAttribute('aria-hidden', 'false');
        openButton.setAttribute('aria-expanded', 'true');
        document.body.classList.add('theinmag-drawer-open');
        var focusable = getFocusable();
        if (focusable.length > 0) {
          window.setTimeout(function () { focusable[0].focus(); }, 50);
        }
      };

      var closeDrawer = function () {
        drawer.classList.remove('is-open');
        drawer.setAttribute('aria-hidden', 'true');
        openButton.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('theinmag-drawer-open');
        if (lastFocused && lastFocused.focus) lastFocused.focus();
      };

      openButton.addEventListener('click', openDrawer);
      closeButtons.forEach(function (btn) {
        btn.addEventListener('click', closeDrawer);
      });

      /* Close on link tap inside the drawer (so navigation feels clean). */
      drawer.querySelectorAll('a[href]').forEach(function (link) {
        link.addEventListener('click', function () {
          closeDrawer();
        });
      });

      drawer.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
          closeDrawer();
          return;
        }
        /* Focus trap - keep Tab cycling inside the drawer. */
        if (e.key !== 'Tab') return;
        var focusable = getFocusable();
        if (focusable.length === 0) return;
        var first = focusable[0];
        var last = focusable[focusable.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      });
    }

  })();
</script>

