  "tag": "section",
  "class": "theinmag-workshop-booking-section",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Caloundra · Saturday 19 September" },
