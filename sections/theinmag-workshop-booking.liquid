    { "type": "textarea", "id": "subhead", "label": "Subhead", "default": "Free workshop for creative kids, filled with art, storytelling, and magazines. An inspiring session encouraging kids to follow their passions and interests." },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image", "info": "Lead with a real photo or kid creation. Defaults to HERO_kid-creation-art.jpg." },
    { "type": "image_picker", "id": "camera_image", "label": "Camera crew photo (Lauren)" },
    { "type": "header", "content": "How the morning runs (carousel photos)" },
    { "type": "image_picker", "id": "flow_image_1", "label": "Step 1: Have a flick" },
    { "type": "image_picker", "id": "flow_image_2", "label": "Step 2: Meet the mINions" },
    { "type": "image_picker", "id": "flow_image_3", "label": "Step 3: Tell a story" },
    { "type": "image_picker", "id": "flow_image_4", "label": "Step 4: Make your own" },
    { "type": "image_picker", "id": "flow_image_5", "label": "Step 5: Relaxed wrap-up" },
    { "type": "header", "content": "Booking engine" },
    { "type": "text", "id": "worker_url", "label": "Worker URL", "default": "https://theinmag-workshop-booking.heyhey-53f.workers.dev", "info": "The theinmag-workshop-booking Cloudflare Worker base URL." }
  ],
  "presets": [
    { "name": "theINmag Workshop booking" }
  ]
}
{% endschema %}
