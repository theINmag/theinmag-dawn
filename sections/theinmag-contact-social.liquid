{%- comment -%}
  theinmag-contact-social
  Section 4 of /pages/contact. The "come hang with us" moment - the
  bit Ryan wants to POP. Big tappable social buttons (>= 60px tall on
  mobile), each filled with a brand-pair dark companion so the buttons
  carry the colour work and the section bg stays calm off-white.

  No Instagram embed, no newsletter signup. Just the headline + three
  buttons. Newsletter lives in the footer; embed would slow the page
  down for a marginal trust gain.
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading

  assign instagram_url = section.settings.instagram_url
  assign instagram_handle = section.settings.instagram_handle
  assign facebook_url = section.settings.facebook_url
  assign facebook_handle = section.settings.facebook_handle
  assign youtube_url = section.settings.youtube_url
  assign youtube_handle = section.settings.youtube_handle

  assign section_style = '--cts-pt: ' | append: section.settings.padding_top | append: 'px; --cts-pb: ' | append: section.settings.padding_bottom | append: 'px;'
-%}

<section
  class="theinmag-contact-social"
  data-theinmag-contact-social
  aria-labelledby="theinmag-contact-social-heading"
  style="{{ section_style }}"
>
  <div class="theinmag-contact-social__inner">
    {%- if heading != blank -%}
      <h2 id="theinmag-contact-social-heading" class="theinmag-contact-social__heading">{{ heading }}</h2>
    {%- endif -%}

    <ul class="theinmag-contact-social__buttons" role="list" aria-label="Follow theINmag on social">
      {%- if instagram_url != blank -%}
        <li>
          <a
            class="theinmag-contact-social__btn theinmag-contact-social__btn--instagram"
            href="{{ instagram_url }}"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="theinmag-contact-social__btn-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" focusable="false">
                <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                <circle cx="12" cy="12" r="4"></circle>
                <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"></circle>
              </svg>
            </span>
            <span class="theinmag-contact-social__btn-text">
              <span class="theinmag-contact-social__btn-platform">Instagram</span>
              {%- if instagram_handle != blank -%}
                <span class="theinmag-contact-social__btn-handle">{{ instagram_handle }}</span>
              {%- endif -%}
            </span>
          </a>
        </li>
      {%- endif -%}
      {%- if facebook_url != blank -%}
        <li>
          <a
            class="theinmag-contact-social__btn theinmag-contact-social__btn--facebook"
            href="{{ facebook_url }}"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="theinmag-contact-social__btn-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor" focusable="false">
                <path d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.7c0-.9.3-1.5 1.6-1.5h1.7V4.3a23 23 0 0 0-2.5-.1c-2.5 0-4.2 1.5-4.2 4.3v2.4H7.4V14h2.7v8h3.4Z"></path>
              </svg>
            </span>
            <span class="theinmag-contact-social__btn-text">
              <span class="theinmag-contact-social__btn-platform">Facebook</span>
              {%- if facebook_handle != blank -%}
                <span class="theinmag-contact-social__btn-handle">{{ facebook_handle }}</span>
              {%- endif -%}
            </span>
          </a>
        </li>
      {%- endif -%}
      {%- if youtube_url != blank -%}
        <li>
          <a
            class="theinmag-contact-social__btn theinmag-contact-social__btn--youtube"
            href="{{ youtube_url }}"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="theinmag-contact-social__btn-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor" focusable="false">
                <path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8ZM10 15V9l5.2 3-5.2 3Z"></path>
            </svg>
            </span>
            <span class="theinmag-contact-social__btn-text">
              <span class="theinmag-contact-social__btn-platform">YouTube</span>
              {%- if youtube_handle != blank -%}
                <span class="theinmag-contact-social__btn-handle">{{ youtube_handle }}</span>
              {%- endif -%}
            </span>
          </a>
        </li>
      {%- endif -%}
    </ul>
  </div>
</section>

{%- stylesheet -%}
  /* ================================================================
     theinmag-contact-social
     "Come hang with us!" - the page's POP moment. Off-white surface
     so the saturated brand-companion fills on the buttons do all the
     colour work.
     ================================================================ */

  .theinmag-contact-social {
    background-color: #FDFAF5;
    color: var(--color-inky-purple-navy, #2A1F3D);
    padding: var(--cts-pt, 56px) clamp(16px, 4vw, 32px) var(--cts-pb, 64px);
    position: relative;
  }

  @media (min-width: 750px) {
    .theinmag-contact-social {
      padding-top: calc(var(--cts-pt, 56px) * 1.3);
      padding-bottom: calc(var(--cts-pb, 64px) * 1.3);
    }
  }

  .theinmag-contact-social__inner {
    max-width: 1080px;
    margin: 0 auto;
    text-align: center;
  }

  .theinmag-contact-social__heading {
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-size: clamp(34px, 6vw, 52px);
    line-height: 1.05;
    letter-spacing: 0;
    margin: 0 0 clamp(22px, 3vw, 36px);
    color: var(--color-inky-purple-navy, #2A1F3D);
    text-wrap: balance;
  }

  .theinmag-contact-social__buttons {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(12px, 1.6vw, 16px);
  }

  @media (min-width: 750px) {
    .theinmag-contact-social__buttons {
      flex-direction: row;
      justify-content: center;
      align-items: stretch;
      gap: clamp(14px, 1.8vw, 20px);
    }
    .theinmag-contact-social__buttons > li {
      flex: 1 1 0;
      max-width: 320px;
      display: flex;
    }
  }

  /* Base button - colour fill comes from --instagram-bg / --facebook-bg
     / --youtube-bg modifier rules below. White icon + white text on
     each saturated dark companion fill. */
  .theinmag-contact-social__btn {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    min-height: 64px;
    padding: 14px 18px;
    border-radius: var(--radius-lg, 20px);
    text-decoration: none;
    color: #FFFFFF;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    box-sizing: border-box;
    box-shadow: 0 4px 14px rgba(42, 31, 61, 0.12);
    transition: transform var(--transition-hover, 0.2s ease),
                box-shadow var(--transition-hover, 0.2s ease),
                filter var(--transition-hover, 0.2s ease);
    text-align: left;
  }

  @media (min-width: 750px) {
    .theinmag-contact-social__btn {
      min-height: 72px;
      padding: 16px 22px;
      gap: 16px;
    }
  }

  .theinmag-contact-social__btn:hover,
  .theinmag-contact-social__btn:focus-visible {
    transform: translateY(-3px);
    box-shadow: 0 8px 22px rgba(42, 31, 61, 0.2);
    filter: brightness(1.06);
    outline: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-contact-social__btn { transition: none; }
    .theinmag-contact-social__btn:hover,
    .theinmag-contact-social__btn:focus-visible { transform: none; }
  }

  .theinmag-contact-social__btn-icon {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
  }

  @media (min-width: 750px) {
    .theinmag-contact-social__btn-icon { width: 36px; height: 36px; }
  }

  .theinmag-contact-social__btn-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .theinmag-contact-social__btn-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .theinmag-contact-social__btn-platform {
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-size: clamp(18px, 1.8vw, 22px);
    line-height: 1.1;
    color: #FFFFFF;
  }

  .theinmag-contact-social__btn-handle {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 500;
    font-size: clamp(13px, 1.2vw, 15px);
    line-height: 1.2;
    color: rgba(255, 255, 255, 0.88);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Brand-companion fills - all from the locked design tokens. The
     saturated dark companions hit WCAG AA white-on-colour contrast. */
  .theinmag-contact-social__btn--instagram { background-color: var(--color-purple-dark, #5D3A7A); }
  .theinmag-contact-social__btn--facebook  { background-color: var(--color-teal-dark, #2D6878); }
  .theinmag-contact-social__btn--youtube   { background-color: var(--color-sage-dark, #4A7C5C); }
{%- endstylesheet -%}

{% schema %}
{
  "name": "theINmag Contact social",
  "tag": "section",
  "class": "theinmag-contact-social-section",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Come hang with us!"
    },
    {
      "type": "header",
      "content": "Instagram"
    },
    {
      "type": "text",
      "id": "instagram_url",
      "label": "URL",
      "default": "https://www.instagram.com/the.inmag/"
    },
    {
      "type": "text",
      "id": "instagram_handle",
      "label": "Display handle",
      "default": "@the.inmag"
    },
    {
      "type": "header",
      "content": "Facebook"
    },
    {
      "type": "text",
      "id": "facebook_url",
      "label": "URL",
      "default": "https://www.facebook.com/theINmagazine"
    },
    {
      "type": "text",
      "id": "facebook_handle",
      "label": "Display handle",
      "default": "@theINmagazine"
    },
    {
      "type": "header",
      "content": "YouTube"
    },
    {
      "type": "text",
      "id": "youtube_url",
      "label": "URL",
      "default": "https://www.youtube.com/@Branchingout-tnr"
    },
    {
      "type": "text",
      "id": "youtube_handle",
      "label": "Display handle",
      "default": "@Branchingout-tnr"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "theINmag Contact social"
    }
  ]
}
{% endschema %}
