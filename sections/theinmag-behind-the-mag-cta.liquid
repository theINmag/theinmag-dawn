{%- comment -%}
  theinmag-behind-the-mag-cta
  Page-closer split CTA. Single overarching heading + two equally-
  weighted cards. Both cards use the yellow stamp primary button
  because the section heading carries the lead - the user has read
  the whole story by now and is ready to act.

  Peach-pair section ("Have a go" colour - inviting, low-pressure)
  with a kid character peeking between the cards on desktop.
{%- endcomment -%}

{%- comment -%}
  Heading has no default filter on purpose. Liquid treats an empty
  string as blank, so a default would re-populate it from a
  template-blank value and defeat the if-blank guard around the H2.
  Template now controls this directly; blank means hidden.
{%- endcomment -%}

{%- liquid
  assign cards = section.blocks | where: 'type', 'cta_card'
  assign heading = section.settings.heading
  assign aeo_heading = section.settings.aeo_heading | default: 'How can your kid be in theINmag?'

  assign bg_src = ''
  if section.settings.background_image != blank
    assign bg_src = section.settings.background_image | image_url: width: 2400
  elsif section.settings.background_filename != blank
    assign bg_src = section.settings.background_filename | asset_url
  endif

  assign section_style = ''
  if bg_src != blank
    assign section_style = "--bm-cta-bg: url('" | append: bg_src | append: "');"
  endif
-%}

<section
  class="theinmag-bm-cta{% if bg_src != blank %} theinmag-bm-cta--has-bg{% endif %}"
  data-theinmag-bm-cta
  aria-labelledby="theinmag-bm-cta-heading"
  style="{{ section_style }}"
>
  <span class="visually-hidden">{{ aeo_heading }}</span>

  <div class="theinmag-bm-cta__inner">
    {%- if heading != blank -%}
      <h2 id="theinmag-bm-cta-heading" class="theinmag-bm-cta__heading">{{ heading }}</h2>
    {%- endif -%}

    <div class="theinmag-bm-cta__row">
      <ul class="theinmag-bm-cta__cards" role="list">
        {%- for block in cards -%}
          {%- liquid
            assign card_src = ''
            if block.settings.image != blank
              assign card_src = block.settings.image | image_url: width: 1600
            elsif block.settings.fallback_filename != blank
              assign card_src = block.settings.fallback_filename | asset_url
            endif
          -%}
          {%- assign card_color = block.settings.color | default: 'peach' -%}
          {%- assign btn_style = block.settings.button_style | default: 'yellow_stamp' -%}
          <li class="theinmag-bm-cta__card-item" {{ block.shopify_attributes }}>
            <article class="theinmag-bm-cta__card theinmag-bm-cta__card--{{ card_color }}">
              <div class="theinmag-bm-cta__card-media">
                {%- if card_src != blank -%}
                  <img
                    src="{{ card_src }}"
                    alt="{{ block.settings.image_alt | default: block.settings.heading | escape }}"
                    loading="lazy"
                    width="1200"
                    height="900"
                  >
                {%- else -%}
                  <div class="theinmag-bm-cta__card-placeholder" aria-hidden="true"></div>
                {%- endif -%}
              </div>

              <div class="theinmag-bm-cta__card-body">
                {%- if block.settings.heading != blank -%}
                  <h3 class="theinmag-bm-cta__card-heading">{{ block.settings.heading }}</h3>
                {%- endif -%}
                {%- if block.settings.body != blank -%}
                  <p class="theinmag-bm-cta__card-text">{{ block.settings.body }}</p>
                {%- endif -%}
                {%- if block.settings.button_label != blank -%}
                  <a class="theinmag-bm-cta__btn theinmag-bm-cta__btn--{{ btn_style }}" href="{{ block.settings.link | default: '#' }}">
                    {{ block.settings.button_label }}
                  </a>
                {%- endif -%}
              </div>
            </article>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{%- stylesheet -%}
  .theinmag-bm-cta {
    background-color: var(--color-cream, #FBF6EA);
    color: var(--color-inky-purple-navy, #2A1F3D);
    padding: clamp(28px, 4.5vw, 56px) clamp(20px, 5vw, 48px);
    position: relative;
    overflow: hidden;
  }
  /* Optional editor-supplied section background image. Mirrors the
     pattern already used on the story, quiz and crew sections. */
  .theinmag-bm-cta--has-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--bm-cta-bg);
    background-size: cover;
    background-position: center;
    pointer-events: none;
    z-index: 0;
    /* Faded so the kid-drawn pattern reads as a soft watermark
       rather than a competing full-strength surface. Cream section
       bg shows through. */
    opacity: 0.32;
  }
  .theinmag-bm-cta__inner {
    position: relative;
    z-index: 1;
  }

  .theinmag-bm-cta__inner {
    /* Capped at 720 so the two cards sit at ~340px each and read
       as product tiles, not banner blocks. */
    max-width: 720px;
    margin: 0 auto;
  }

  .theinmag-bm-cta__heading {
    margin: 0 0 clamp(20px, 3vw, 32px);
    text-align: center;
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-size: clamp(28px, 4.6vw, 44px);
    line-height: 1.05;
    letter-spacing: 0;
    color: var(--color-sandy-orange-dark, #D9783A);
    text-wrap: balance;
  }

  .theinmag-bm-cta__row {
    position: relative;
  }

  .theinmag-bm-cta__cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(20px, 3vw, 32px);
  }

  @media (min-width: 750px) {
    .theinmag-bm-cta__cards {
      grid-template-columns: 1fr 1fr;
    }
  }

  .theinmag-bm-cta__card-item { margin: 0; display: flex; }

  /* Card defaults. Tightened to read more product-tile than
     editorial-article: sharp corners (border-radius: 0), reduced
     padding, smaller body type. The image keeps its weight but
     the surrounding card chrome compresses. */
  .theinmag-bm-cta__card {
    display: flex;
    flex-direction: column;
    flex: 1;
    border-radius: 0;
    overflow: hidden;
    box-shadow: 0 2px 10px rgba(42, 31, 61, 0.10);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    background-color: #FFFFFF;
  }
  .theinmag-bm-cta__card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 22px rgba(42, 31, 61, 0.16);
  }

  /* Pair-colour card variants. Each modifier sets the body bg and the
     placeholder gradient. Headings + text adopt the pair's dark
     companion via per-modifier overrides below. */
  .theinmag-bm-cta__card--peach { background-color: var(--color-peach, #FCDDB8); }
  .theinmag-bm-cta__card--lavender { background-color: var(--color-lavender, #E8DEEF); }
  .theinmag-bm-cta__card--mint { background-color: var(--color-mint, #D6EAD9); }
  .theinmag-bm-cta__card--sky { background-color: var(--color-sky, #C9E5E8); }
  .theinmag-bm-cta__card--coral { background-color: var(--color-salmon, #FBE0D6); }
  .theinmag-bm-cta__card--cream { background-color: var(--color-cream, #FBF6EA); }

  .theinmag-bm-cta__card-media {
    /* Squared-up aspect (1/1) for a product-tile read rather than the
       wider editorial 16/10 the cards had before. */
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: rgba(255, 255, 255, 0.4);
  }

  .theinmag-bm-cta__card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Placeholder gradient picks up the card's own colour pair. */
  .theinmag-bm-cta__card-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.5) 0%, rgba(255, 255, 255, 0.15) 100%);
  }

  .theinmag-bm-cta__card-body {
    padding: clamp(14px, 1.8vw, 22px) clamp(16px, 2vw, 24px) clamp(16px, 2.2vw, 26px);
    display: flex;
    flex-direction: column;
    gap: clamp(6px, 0.9vw, 10px);
    flex: 1;
    align-items: center;
    text-align: center;
  }

  /* Card heading: Inter 700 editorial (was Post Regular). The Post
     stack across the page was reading as too much hand-lettering
     by the time the reader hit the closing CTAs - Inter brings the
     headlines back into a direct, product-tile register. */
  .theinmag-bm-cta__card-heading {
    margin: 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: clamp(17px, 1.9vw, 20px);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-inky-purple-navy, #2A1F3D);
  }
  .theinmag-bm-cta__card--peach .theinmag-bm-cta__card-heading { color: var(--color-sandy-orange-dark, #D9783A); }
  .theinmag-bm-cta__card--lavender .theinmag-bm-cta__card-heading { color: var(--color-purple-dark, #5D3A7A); }
  .theinmag-bm-cta__card--mint .theinmag-bm-cta__card-heading { color: var(--color-sage-dark, #4A7C5C); }
  .theinmag-bm-cta__card--sky .theinmag-bm-cta__card-heading { color: var(--color-teal-dark, #2D6878); }
  .theinmag-bm-cta__card--coral .theinmag-bm-cta__card-heading { color: var(--color-coral-dark, #C9543E); }
  .theinmag-bm-cta__card--cream .theinmag-bm-cta__card-heading { color: var(--color-purple-dark, #5D3A7A); }

  .theinmag-bm-cta__card-text {
    margin: 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-size: clamp(13px, 1.3vw, 14px);
    line-height: 1.5;
    color: var(--color-inky-purple-navy, #2A1F3D);
    opacity: 0.88;
    max-width: 36ch;
  }

  /* Shared button base - both yellow_stamp and outlined_purple share
     identical padding/font-size/line-height so the two cards' buttons
     render at exactly the same height. Variant modifiers below swap
     colour, font, and shadow.

     The outlined variant uses an inset box-shadow for the "border" so
     the 2px outline doesn't add to the box height (a real `border`
     property would have made the outlined button 4px taller than the
     yellow). */
  .theinmag-bm-cta__btn {
    display: inline-block;
    align-self: center;
    /* margin-top: auto pushes the button to the bottom of the
       flex-column card body, so paired cards (e.g. Send IN + Grab a
       Membership) align their buttons at the same y position even
       when their body text wraps to different line counts. */
    margin-top: auto;
    font-size: 14px;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    text-decoration: none;
    padding: 12px 22px;
    border: 0;
    border-radius: var(--radius-button, 32px);
    transition: background-color 0.15s ease, color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }

  /* Yellow stamp (primary). Post Regular per design tokens. The
     offset shadow extends below the box but doesn't change the box
     height, so the outlined sibling still matches.

     Font size is bumped above the 14px shared base so the primary
     button text feels chunkier without enlarging the button itself -
     padding tightens vertically to compensate, keeping the overall
     button height in line with the outlined-purple sibling. */
  .theinmag-bm-cta__btn--yellow_stamp {
    background-color: var(--color-yellow, #F9C23C);
    color: var(--color-inky-purple-navy, #2A1F3D);
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-size: 18px;
    padding: 9px 22px;
    box-shadow: 0 3px 0 var(--color-yellow-shadow, #D4A02E);
  }
  .theinmag-bm-cta__btn--yellow_stamp:hover {
    background-color: var(--color-purple-dark, #5D3A7A);
    color: #FFFFFF;
    transform: translateY(2px);
    box-shadow: 0 1px 0 #4A2D62;
  }
  .theinmag-bm-cta__btn--yellow_stamp:focus-visible {
    background-color: var(--color-purple-dark, #5D3A7A);
    color: #FFFFFF;
    box-shadow: 0 3px 0 #4A2D62, 0 0 0 3px var(--color-yellow, #F9C23C);
    outline: none;
  }

  /* Outlined-purple (secondary) per design tokens. Inter 600 + inset
     "border" so the box height matches the yellow stamp exactly. */
  .theinmag-bm-cta__btn--outlined_purple {
    background-color: transparent;
    color: var(--color-purple-dark, #5D3A7A);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    box-shadow: inset 0 0 0 2px var(--color-purple-dark, #5D3A7A);
  }
  .theinmag-bm-cta__btn--outlined_purple:hover {
    background-color: var(--color-purple-dark, #5D3A7A);
    color: #FFFFFF;
    box-shadow: inset 0 0 0 2px var(--color-purple-dark, #5D3A7A);
  }
  .theinmag-bm-cta__btn--outlined_purple:focus-visible {
    background-color: var(--color-purple-dark, #5D3A7A);
    color: #FFFFFF;
    box-shadow: inset 0 0 0 2px var(--color-purple-dark, #5D3A7A), 0 0 0 3px var(--color-yellow, #F9C23C);
    outline: none;
  }

  /* Kid character peeks between the two cards on desktop. Hidden on
     mobile - cards stack so there's no "between." */
  .theinmag-bm-cta__character {
    display: none;
  }

  @media (min-width: 990px) {
    .theinmag-bm-cta__character {
      display: block;
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -55%);
      width: clamp(112px, 11.2vw, 155px);
      z-index: 2;
      pointer-events: none;
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-bm-cta__card,
    .theinmag-bm-cta__btn {
      transition: none;
    }
    .theinmag-bm-cta__card:hover {
      transform: none;
    }
    .theinmag-bm-cta__btn:hover,
    .theinmag-bm-cta__btn:focus-visible {
      transform: none;
    }
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "theINmag BM final CTA",
  "tag": "section",
  "class": "theinmag-bm-cta-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Overarching heading (H2)", "info": "Leave blank to hide the H2 entirely." },
    { "type": "text", "id": "aeo_heading", "label": "Visually-hidden secondary H2 (question form)" },
    { "type": "header", "content": "Section background (optional)" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "text", "id": "background_filename", "label": "Background fallback filename" }
  ],
  "blocks": [
    {
      "type": "cta_card",
      "name": "CTA card",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "heading", "label": "Card heading (H3)" },
        { "type": "textarea", "id": "body", "label": "Body" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            { "value": "yellow_stamp", "label": "Yellow stamp (primary)" },
            { "value": "outlined_purple", "label": "Outlined purple (secondary)" }
          ],
          "default": "yellow_stamp"
        },
        {
          "type": "select",
          "id": "color",
          "label": "Card colour pair",
          "options": [
            { "value": "peach", "label": "Peach (have-a-go orange)" },
            { "value": "lavender", "label": "Lavender (primary purple)" },
            { "value": "mint", "label": "Mint (kids / fresh)" },
            { "value": "sky", "label": "Sky (callout teal)" },
            { "value": "coral", "label": "Coral (warmth)" },
            { "value": "cream", "label": "Cream (universal)" }
          ],
          "default": "peach"
        },
        { "type": "image_picker", "id": "image", "label": "Card image" },
        { "type": "text", "id": "fallback_filename", "label": "Fallback filename" },
        { "type": "text", "id": "image_alt", "label": "Image alt text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "theINmag BM final CTA",
      "settings": {
        "heading": "Your kid could be in the next issue.",
        "aeo_heading": "How can your kid be in theINmag?"
      },
      "blocks": [
        {
          "type": "cta_card",
          "settings": {
            "heading": "Send something in",
            "body": "Drawings, stories, photos, jokes, maths puzzles, anything. If they made it and they're proud of it, send it IN.",
            "button_label": "Send IN a creation",
            "link": "/pages/send-in",
            "fallback_filename": "behind-the-mag-cta-send-in.jpg",
            "image_alt": "A pile of kid creations ready to be sent in to theINmag."
          }
        },
        {
          "type": "cta_card",
          "settings": {
            "heading": "Grab a Membership",
            "body": "Three issues a year, straight to your letterbox. Never miss one.",
            "button_label": "Get a Membership",
            "link": "/products/theinmag-membership",
            "fallback_filename": "behind-the-mag-cta-membership.jpg",
            "image_alt": "A theINmag membership pack landing in an Aussie letterbox."
          }
        }
      ]
    }
  ]
}
{% endschema %}
