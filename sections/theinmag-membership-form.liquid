{%- comment -%}
  theinmag-membership-form
  Stage 2a plumbing for /products/membership.

  Reads three shop-level metafields:
    theinmag.current_issue_number          (single-line text, e.g. "Mag09")
    theinmag.current_issue_print_in_stock  (boolean)
    theinmag.next_release_date             (date)

  Renders:
    - Format tile-buttons (Print / Digital / Combo)
    - Length tile-buttons (4-Issue / 8-Issue / Rolling)
    - Starting Issue tile-buttons (Current / Next)
    - Dynamic price
    - Add to Cart form posting three hidden line item properties:
        properties[_starting_mag]
        properties[_remaining_after_first]
        properties[_mags_included]

  Stage 2a is plumbing only. Visual polish (UGC, FAQ, trust overlays,
  sticky mobile bar, hero photo, cross-sells) all land in Stage 2b.

  Starting Issue visibility logic:
    - Format = Print or Combo AND print_in_stock = false -> only "next"
    - Otherwise -> both options visible

  Mag-number math assumes "MagNN" zero-padded two-digit format.
  Holds until Mag99 (year ~2048 at 3 issues/year), reassess then.
{%- endcomment -%}

{%- liquid
  assign current_issue = shop.metafields.theinmag.current_issue_number.value | default: 'Mag09'
  assign print_in_stock = shop.metafields.theinmag.current_issue_print_in_stock.value
  assign next_release_value = shop.metafields.theinmag.next_release_date.value
  assign next_release_formatted = next_release_value | date: '%-d %B %Y'

  assign current_num_str = current_issue | remove: 'Mag'
  assign current_num = current_num_str | times: 1
  assign next_num = current_num | plus: 1
  if next_num < 10
    assign next_issue = 'Mag0' | append: next_num
  else
    assign next_issue = 'Mag' | append: next_num
  endif

  assign first_variant = product.selected_or_first_available_variant

  if print_in_stock
    assign print_stock_attr = 'true'
  else
    assign print_stock_attr = 'false'
  endif

  assign section_style = '--tmf-pt: ' | append: section.settings.padding_top | append: 'px; --tmf-pb: ' | append: section.settings.padding_bottom | append: 'px;'
-%}

<section
  class="theinmag-membership-form"
  data-theinmag-membership-form
  data-current-issue="{{ current_issue }}"
  data-next-issue="{{ next_issue }}"
  data-print-in-stock="{{ print_stock_attr }}"
  aria-labelledby="theinmag-membership-form-heading"
  style="{{ section_style }}"
>
  <div class="theinmag-membership-form__inner">

    <h1 id="theinmag-membership-form-heading" class="theinmag-membership-form__heading">
      {{ product.title }}
    </h1>

    <div class="theinmag-membership-form__price" data-price-display>
      {{ first_variant.price | money }}
    </div>

    <form
      action="{{ routes.cart_add_url }}"
      method="post"
      enctype="multipart/form-data"
      class="theinmag-membership-form__form"
      data-membership-form
    >
      <input type="hidden" name="id" data-variant-id-input value="{{ first_variant.id }}">
      <input type="hidden" name="quantity" value="1">
      <input type="hidden" name="properties[_starting_mag]" data-prop-starting-mag value="{{ current_issue }}">
      <input type="hidden" name="properties[_remaining_after_first]" data-prop-remaining value="3">
      <input type="hidden" name="properties[_mags_included]" data-prop-mags-included value="">

      <fieldset class="theinmag-membership-form__fieldset">
        <legend class="theinmag-membership-form__legend">How would you like to read?</legend>
        <div class="theinmag-membership-form__tiles" role="radiogroup" data-option-name="format">
          <button type="button" class="theinmag-membership-form__tile" data-value="Print" aria-pressed="true">Print</button>
          <button type="button" class="theinmag-membership-form__tile" data-value="Digital" aria-pressed="false">Digital</button>
          <button type="button" class="theinmag-membership-form__tile" data-value="Combo" aria-pressed="false">Combo</button>
        </div>
      </fieldset>

      <fieldset class="theinmag-membership-form__fieldset">
        <legend class="theinmag-membership-form__legend">How many?</legend>
        <div class="theinmag-membership-form__tiles" role="radiogroup" data-option-name="length">
          <button type="button" class="theinmag-membership-form__tile" data-value="4-Issue" aria-pressed="true">4-Issue</button>
          <button type="button" class="theinmag-membership-form__tile" data-value="8-Issue" aria-pressed="false">8-Issue</button>
          <button type="button" class="theinmag-membership-form__tile" data-value="Rolling" aria-pressed="false">Rolling</button>
        </div>
      </fieldset>

      <fieldset class="theinmag-membership-form__fieldset">
        <legend class="theinmag-membership-form__legend">When should it start?</legend>
        <div class="theinmag-membership-form__tiles theinmag-membership-form__tiles--stacked" role="radiogroup" data-option-name="starting">
          <button type="button" class="theinmag-membership-form__tile theinmag-membership-form__tile--starting" data-value="current" data-requires-print-stock="true" aria-pressed="true">
            <span class="theinmag-membership-form__tile-title">Start with the current issue</span>
            <span class="theinmag-membership-form__tile-sub">{{ current_issue }}</span>
          </button>
          <button type="button" class="theinmag-membership-form__tile theinmag-membership-form__tile--starting" data-value="next" aria-pressed="false">
            <span class="theinmag-membership-form__tile-title">Start with the next issue</span>
            <span class="theinmag-membership-form__tile-sub">{{ next_issue }} - drops {{ next_release_formatted }}</span>
          </button>
        </div>
      </fieldset>

      <button type="submit" class="theinmag-membership-form__cta">
        Add to cart
      </button>

    </form>
  </div>

  <script type="application/json" data-membership-variants>
    [
      {%- for v in product.variants -%}
        {"id": {{ v.id }}, "option1": {{ v.option1 | json }}, "option2": {{ v.option2 | json }}, "price": {{ v.price }}, "available": {{ v.available }}}{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  </script>
</section>

<style>
  .shopify-section.theinmag-membership-form-section { background: var(--color-cream); }

  .theinmag-membership-form {
    padding: var(--tmf-pt, 56px) var(--space-lg) var(--tmf-pb, 56px);
    background: var(--color-cream);
    color: var(--color-inky-purple-navy);
  }

  .theinmag-membership-form__inner {
    max-width: 640px;
    margin: 0 auto;
  }

  .theinmag-membership-form__heading {
    font-family: var(--font-heading);
    color: var(--color-inky-purple-navy);
    font-size: clamp(28px, 5vw, 40px);
    line-height: 1.15;
    margin: 0 0 var(--space-md);
  }

  .theinmag-membership-form__price {
    font-family: var(--font-heading);
    color: var(--color-purple-dark);
    font-size: clamp(24px, 4vw, 32px);
    line-height: 1.2;
    margin: 0 0 var(--space-xl);
  }

  .theinmag-membership-form__form { display: block; }

  .theinmag-membership-form__fieldset {
    border: 0;
    padding: 0;
    margin: 0 0 var(--space-xl);
  }

  .theinmag-membership-form__legend {
    font-family: var(--font-body);
    font-weight: 600;
    color: var(--color-inky-purple-navy);
    font-size: 16px;
    padding: 0;
    margin: 0 0 var(--space-sm);
  }

  .theinmag-membership-form__tiles {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .theinmag-membership-form__tiles--stacked { flex-direction: column; }

  .theinmag-membership-form__tile {
    flex: 1 1 calc(33.333% - 7px);
    min-height: 56px;
    padding: 14px 16px;
    background: transparent;
    border: 2px solid var(--color-purple-dark);
    border-radius: var(--radius-button);
    color: var(--color-purple-dark);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 15px;
    text-align: center;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .theinmag-membership-form__tile:hover { background: var(--color-lavender); }

  .theinmag-membership-form__tile[aria-pressed='true'] {
    background: var(--color-purple-dark);
    color: #fff;
  }

  .theinmag-membership-form__tile[hidden] { display: none; }

  .theinmag-membership-form__tile--starting {
    flex: 1 1 100%;
    text-align: left;
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .theinmag-membership-form__tile-title { font-weight: 700; font-size: 16px; }
  .theinmag-membership-form__tile-sub { font-weight: 400; font-size: 14px; opacity: 0.9; }

  .theinmag-membership-form__cta {
    width: 100%;
    margin-top: var(--space-md);
    background: var(--color-yellow);
    color: var(--color-inky-purple-navy);
    font-family: var(--font-heading);
    font-size: 18px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    padding: 16px 28px;
    border: 0;
    border-radius: var(--radius-button);
    box-shadow: 0 4px 0 var(--color-yellow-shadow);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }

  .theinmag-membership-form__cta:hover {
    background: var(--color-purple-dark);
    color: #fff;
    transform: translateY(2px);
    box-shadow: 0 2px 0 #4A2D62;
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-membership-form__cta:hover {
      transform: none;
      box-shadow: 0 4px 0 var(--color-yellow-shadow);
    }
  }
</style>

<script src="{{ 'theinmag-membership-form.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Membership form",
  "tag": "section",
  "class": "shopify-section theinmag-membership-form-section",
  "settings": [
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 96,
      "step": 4,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 96,
      "step": 4,
      "default": 56,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Membership form"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
