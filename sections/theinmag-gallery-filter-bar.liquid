{%- comment -%}
  theinmag-gallery-filter-bar
  Combined header strip for /pages/gallery. Per Ryan's 18 May Round 2:
  the H1 + subhead live on the LEFT, the search input + category
  dropdown live on the RIGHT. Mobile stacks them vertically.

  Absorbs what used to be the hero section, so this file also:
    - Loads the page-wide gallery CSS + JS
    - Emits the page-level JSON-LD (BreadcrumbList + WebPage)

  The hero section file (theinmag-gallery-hero.liquid) stays on disk
  for posterity but is no longer wired into page.gallery.json.

  No `position: sticky` here anymore - sticking a strip that contains
  the H1 would pin the title to the viewport, which is wrong. The
  whole header strip just scrolls naturally now.
{%- endcomment -%}

{{ 'theinmag-gallery.css' | asset_url | stylesheet_tag }}
<script src="{{ 'theinmag-gallery.js' | asset_url }}" defer></script>

{%- comment -%}
  Sitewide kid-character pool - renders the pool's init script. Any
  <span data-theinmag-pool-character> marker inside this section will
  get filled with a random character from /assets/character-N.png.
{%- endcomment -%}
{% render 'theinmag-character-pool' %}

{%- liquid
  assign heading = section.settings.heading
  assign subhead = section.settings.subhead
  assign show_disclaimer = section.settings.show_disclaimer
  assign disclaimer_text = section.settings.disclaimer_text
  assign placeholders = ''
  if section.settings.search_placeholder_1 != blank
    assign placeholders = placeholders | append: section.settings.search_placeholder_1 | append: '|||'
  endif
  if section.settings.search_placeholder_2 != blank
    assign placeholders = placeholders | append: section.settings.search_placeholder_2 | append: '|||'
  endif
  if section.settings.search_placeholder_3 != blank
    assign placeholders = placeholders | append: section.settings.search_placeholder_3
  endif
-%}

<section
  class="theinmag-gallery-filter-bar"
  data-theinmag-gallery-filter-bar
  data-placeholders="{{ placeholders | escape }}"
  aria-labelledby="theinmag-gallery-heading"
>
  <div class="theinmag-gallery-filter-bar__inner">
    <div class="theinmag-gallery-filter-bar__card">
      <div class="theinmag-gallery-filter-bar__row">
        <div class="theinmag-gallery-filter-bar__character" aria-hidden="true">
          <span data-theinmag-pool-character></span>
        </div>

        <div class="theinmag-gallery-filter-bar__titles">
          {%- if heading != blank -%}
            <h1 id="theinmag-gallery-heading" class="theinmag-gallery-filter-bar__heading">{{ heading }}</h1>
          {%- endif -%}
          {%- if subhead != blank -%}
            <p class="theinmag-gallery-filter-bar__subhead">{{ subhead }}</p>
          {%- endif -%}
        </div>

        <div class="theinmag-gallery-filter-bar__controls-wrap">
          <div class="theinmag-gallery-filter-bar__controls">
            <div class="theinmag-gallery-filter-bar__search">
              <label class="visually-hidden" for="theinmag-gallery-search">Search creations</label>
              <span class="theinmag-gallery-filter-bar__search-icon" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.5"/>
                  <line x1="10.5" y1="10.5" x2="14" y2="14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </span>
              <input
                id="theinmag-gallery-search"
                class="theinmag-gallery-filter-bar__search-input"
                type="search"
                autocomplete="off"
                placeholder="{{ section.settings.search_placeholder_1 | default: 'Search by name...' }}"
                data-theinmag-gallery-search
              />
            </div>

            <div class="theinmag-gallery-filter-bar__sort">
              <label class="visually-hidden" for="theinmag-gallery-category">Filter by category</label>
              <select id="theinmag-gallery-category" class="theinmag-gallery-filter-bar__sort-select" data-theinmag-gallery-category>
                <option value="all">All creations</option>
                <option value="art">Art</option>
                <option value="writing">Writing</option>
                <option value="photo">Photos</option>
                <option value="puzzle">Puzzles</option>
                <option value="hobby">Hobbies</option>
                <option value="wondering">Wonderings</option>
              </select>
              <span class="theinmag-gallery-filter-bar__sort-chevron" aria-hidden="true">&#9662;</span>
            </div>
          </div>

          {%- comment -%}
            Search scope line. It sits HERE, as a sibling of the controls row
            inside __controls-wrap (a flex COLUMN), and shares the slot with the
            disclaimer below: exactly one of the two is ever visible, so the bar
            keeps its height and shape either way.

            It must NOT go inside __controls, which is a flex ROW. Putting it there
            on 2026-09-04 made it a third flex item beside the search box and the
            category select, stole 351px of the row, and visibly reshaped the whole
            cream banner. Ryan caught it on desktop; I had only tested at 375px,
            where the row wraps and the fault is invisible.

            Says WHICH set is being searched, because a kid who types their name
            and sees nothing needs to know whether that means "not here" or "still
            loading". Filled by JS, empty and hidden until someone searches.
            aria-live so a screen reader hears the scope change too.
          {%- endcomment -%}
          <p
            class="theinmag-gallery-filter-bar__search-scope"
            data-theinmag-gallery-search-scope
            aria-live="polite"
          ></p>

          {%- comment -%}
            data-theinmag-gallery-disclaimer: the JS hides this line while a search
            is running. Its copy opens with the browse window ("Last 3 months"),
            which stopped being true during a search on 2026-09-04, when search
            began reaching every published creation. Two lines contradicting each
            other, one saying 3 months and one saying all 2,790, is worse than
            either alone, so the windowed line stands down while search is active.
          {%- endcomment -%}
          {%- if show_disclaimer and disclaimer_text != blank -%}
            <p class="theinmag-gallery-filter-bar__disclaimer" data-theinmag-gallery-disclaimer>{{ disclaimer_text }}</p>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{%- comment -%} Page-level JSON-LD - BreadcrumbList + WebPage {%- endcomment -%}
{%- assign page_origin = request.origin | default: 'https://theinmag.com.au' -%}
{%- assign page_url = page_origin | append: '/pages/gallery' -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": {{ page_origin | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Gallery",
        "item": {{ page_url | json }}
      }
    ]
  }
</script>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": {{ heading | default: 'Real kids. Real creations.' | json }},
    "description": {{ subhead | default: 'Live from across Australia.' | json }},
    "url": {{ page_url | json }},
    "mainEntityOfPage": {{ page_url | json }},
    "isPartOf": {
      "@type": "WebSite",
      "name": "theINmag",
      "url": {{ page_origin | json }}
    }
  }
</script>

{% schema %}
{
  "name": "theINmag Gallery filter",
  "tag": "section",
  "class": "theinmag-gallery-filter-bar-section",
  "settings": [
    {
      "type": "header",
      "content": "Headline"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Real kids. Real creations."
    },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Subhead",
      "default": "Live submissions from across Australia."
    },
    {
      "type": "header",
      "content": "Search placeholders"
    },
    {
      "type": "text",
      "id": "search_placeholder_1",
      "label": "Placeholder 1",
      "default": "Search a name, town or topic..."
    },
    {
      "type": "text",
      "id": "search_placeholder_2",
      "label": "Placeholder 2",
      "default": "Search your own name..."
    },
    {
      "type": "text",
      "id": "search_placeholder_3",
      "label": "Placeholder 3",
      "default": "Try 'dragons' or 'beach'..."
    },
    {
      "type": "header",
      "content": "Disclaimer line"
    },
    {
      "type": "checkbox",
      "id": "show_disclaimer",
      "label": "Show disclaimer",
      "default": true
    },
    {
      "type": "textarea",
      "id": "disclaimer_text",
      "label": "Disclaimer copy",
      "default": "Six months of recent creations, newest first. Search by name or town to find one."
    }
  ],
  "presets": [
    {
      "name": "theINmag Gallery filter"
    }
  ]
}
{% endschema %}
