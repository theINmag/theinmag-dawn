{%- comment -%}
  theinmag-you-may-also-like
  Curated upsell row for the bottom of the product page. Four slots, in
  order: Snack Pack, Membership, Digital Stack, and the current issue
  (driven by the shop.metafields.theinmag.current_issue_number metafield,
  so it auto-updates each drop).

  If the visitor is currently ON one of those four products, that slot
  swaps to the previous issue (the one numbered below current) so the row
  never just points back at the page you're already on.

  Replaces the old generic "cross-sells" mission block on the PDP.
{%- endcomment -%}

{%- liquid
  assign issues_collection_handle = section.settings.issues_collection | default: 'single-issues'
  assign all_issues = collections[issues_collection_handle].products

  # Slot 4 = the CURRENT issue, driven by the shop.metafields.theinmag.current_issue_number
  # metafield (stored like "Mag09") that the rest of the site already uses for the current-
  # issue badge. Update that one metafield each drop and this slot moves itself - no theme
  # edit, no per-issue sort.
  #
  # NOTE: the old approach sorted the collection by 'metafields.single_mag.issue_number.value'
  # and took the top item. Liquid's `sort` filter silently ignores deep metafield paths
  # (see feedback_liquid_sort_deep_metafield_path), so that sort was a no-op and the slot
  # was really just showing the last product in the collection's manual order. Fixed here.
  #
  # previous_issue (the issue numbered one below current) is the fallback used when the
  # visitor is already on the current-issue page, so the row never points back at itself.
  assign current_issue_code = shop.metafields.theinmag.current_issue_number.value | default: 'Mag09'
  assign current_issue_handle = current_issue_code | downcase
  assign latest_issue = all_products[current_issue_handle]
  assign current_issue_num = current_issue_code | remove: 'Mag' | remove: 'mag' | times: 1
  assign previous_issue_num = current_issue_num | minus: 1
  if previous_issue_num < 10
    assign previous_issue_handle = 'mag0' | append: previous_issue_num
  else
    assign previous_issue_handle = 'mag' | append: previous_issue_num
  endif
  assign previous_issue = all_products[previous_issue_handle]

  # The two curated bundles. Snack Pack carries a Print variant; the
  # Digital Stack does not - that is how we tell them apart.
  assign snack_pack = nil
  assign digital_stack = nil
  for issue in all_issues
    assign inum = issue.metafields.single_mag.issue_number.value | default: 0
    if inum <= 0
      assign issue_has_print = false
      for v in issue.variants
        if v.option1 == 'Print'
          assign issue_has_print = true
        endif
      endfor
      if issue_has_print
        assign snack_pack = issue
      else
        assign digital_stack = issue
      endif
    endif
  endfor

  assign membership_product = all_products[section.settings.membership_handle]

  # Four slots in display order. If the current product fills a slot,
  # swap that slot for the previous issue so the row stays useful.
  assign slot_1 = snack_pack
  assign slot_2 = membership_product
  assign slot_3 = digital_stack
  assign slot_4 = latest_issue
  if slot_1 != blank and slot_1.handle == product.handle
    assign slot_1 = previous_issue
  endif
  if slot_2 != blank and slot_2.handle == product.handle
    assign slot_2 = previous_issue
  endif
  if slot_3 != blank and slot_3.handle == product.handle
    assign slot_3 = previous_issue
  endif
  if slot_4 != blank and slot_4.handle == product.handle
    assign slot_4 = previous_issue
  endif

  assign section_style = '--tmyml-pt: ' | append: section.settings.padding_top | append: 'px; --tmyml-pb: ' | append: section.settings.padding_bottom | append: 'px;'
-%}

<section
  class="theinmag-you-may-also-like"
  style="{{ section_style }}"
  aria-labelledby="theinmag-yml-heading"
>
  <div class="theinmag-you-may-also-like__inner">
    <h2 id="theinmag-yml-heading" class="theinmag-you-may-also-like__heading">
      {{ section.settings.heading | default: 'You may also like' }}
    </h2>
    <ul class="theinmag-you-may-also-like__grid" role="list">
      {%- if slot_1 != blank -%}{%- render 'theinmag-yml-card', product: slot_1, blurb: section.settings.digital_stack_blurb -%}{%- endif -%}
      {%- if slot_2 != blank -%}{%- render 'theinmag-yml-card', product: slot_2, blurb: section.settings.digital_stack_blurb -%}{%- endif -%}
      {%- if slot_3 != blank -%}{%- render 'theinmag-yml-card', product: slot_3, blurb: section.settings.digital_stack_blurb -%}{%- endif -%}
      {%- if slot_4 != blank -%}{%- render 'theinmag-yml-card', product: slot_4, blurb: section.settings.digital_stack_blurb -%}{%- endif -%}
    </ul>
  </div>

  {%- comment -%}
    Membership picker popup + shared tile-add handler. Rendered once per
    page here (the YML row is product-template only, so this never collides
    with the inline add-handlers still living in shop-grid / cart-featured /
    funnel-strip). The popup mounts its own [data-membership-popup-trigger]
    listener; the Membership tile's "Join the club" button just sets that
    attribute. Popup silently no-ops if the membership product is missing.
  {%- endcomment -%}
  {% render 'theinmag-membership-popup', membership_product: membership_product %}
</section>

<script src="{{ 'theinmag-tile-add.js' | asset_url }}" defer></script>

{% stylesheet %}
  .theinmag-you-may-also-like {
    background-color: var(--color-cream);
    padding: var(--tmyml-pt, 72px) var(--space-lg) var(--tmyml-pb, 72px);
  }

  .theinmag-you-may-also-like__inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .theinmag-you-may-also-like__heading {
    margin: 0 0 var(--space-lg);
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(28px, 4vw, 40px);
    line-height: 1.05;
    color: var(--color-inky-purple-navy);
    text-align: center;
  }

  .theinmag-you-may-also-like__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }
  @media (max-width: 749px) {
    .theinmag-you-may-also-like__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .theinmag-you-may-also-like__item {
    display: flex;
  }

  .theinmag-you-may-also-like__card {
    display: flex;
    flex-direction: column;
    width: 100%;
    text-decoration: none;
    background: #ffffff;
    border-radius: var(--radius-lg, 12px);
    overflow: hidden;
    box-shadow: 0 2px 10px rgba(42, 31, 61, 0.08);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .theinmag-you-may-also-like__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(42, 31, 61, 0.16);
  }

  .theinmag-you-may-also-like__cover {
    display: block;
    aspect-ratio: 1 / 1;
    background-color: var(--color-cream);
    overflow: hidden;
  }
  .theinmag-you-may-also-like__cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  .theinmag-you-may-also-like__cover-link {
    display: block;
  }

  .theinmag-you-may-also-like__title-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .theinmag-you-may-also-like__title-link:hover .theinmag-you-may-also-like__title,
  .theinmag-you-may-also-like__title-link:focus-visible .theinmag-you-may-also-like__title {
    color: var(--color-purple-dark, #5D3A7A);
  }

  .theinmag-you-may-also-like__title {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 16px;
    line-height: 1.2;
    color: var(--color-inky-purple-navy);
    padding: 14px 16px 0;
  }

  /* Optional one-line descriptor (e.g. the Digital Stack tile, which has a
     single price and benefits from a "what is this" line). */
  .theinmag-you-may-also-like__blurb {
    margin: 6px 16px 0;
    font-family: var(--font-body);
    font-size: 12.5px;
    line-height: 1.4;
    color: rgba(42, 31, 61, 0.62);
  }

  /* Buy area, pinned to the bottom of the card. */
  .theinmag-you-may-also-like__buy {
    margin-top: auto;
    padding: 8px 16px 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  /* Membership "from" prices (labelled, two lines). */
  .theinmag-you-may-also-like__price {
    font-family: var(--font-body);
    font-size: 14px;
    color: rgba(42, 31, 61, 0.78);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .theinmag-you-may-also-like__price-line {
    font-weight: 600;
    line-height: 1.35;
  }
  .theinmag-you-may-also-like__price-label {
    font-weight: 500;
    color: rgba(42, 31, 61, 0.55);
  }

  /* Add-to-cart rows (Print / Digital). Mirrors the /shop tile row. */
  .theinmag-you-may-also-like__row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--color-inky-purple-navy);
  }
  .theinmag-you-may-also-like__row--solo {
    grid-template-columns: 1fr auto;
  }
  .theinmag-you-may-also-like__row.is-sold-out {
    opacity: 0.5;
  }

  .theinmag-you-may-also-like__format {
    font-weight: 500;
  }
  .theinmag-you-may-also-like__row-price {
    font-weight: 600;
    color: rgba(42, 31, 61, 0.82);
  }
  .theinmag-you-may-also-like__soldout {
    justify-self: end;
    font-weight: 600;
    font-size: 12px;
    color: var(--color-sandy-orange-dark, #D9783A);
  }

  .theinmag-you-may-also-like__add {
    appearance: none;
    background: transparent;
    border: 1.5px solid var(--color-purple-dark, #5D3A7A);
    color: var(--color-purple-dark, #5D3A7A);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 13px;
    padding: 6px 14px;
    border-radius: var(--radius-pill, 9999px);
    cursor: pointer;
    min-height: 36px;
    /* Sized to fit "Added ✓" so the row doesn't reflow on the label flip. */
    min-width: 84px;
    text-align: center;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .theinmag-you-may-also-like__add:hover,
  .theinmag-you-may-also-like__add:focus-visible {
    background-color: var(--color-purple-dark, #5D3A7A);
    color: #ffffff;
    outline: none;
  }

  /* Membership CTA - yellow stamp colour (CTA-only per brand rules). */
  .theinmag-you-may-also-like__join {
    appearance: none;
    background-color: var(--color-yellow);
    border: none;
    color: var(--color-inky-purple-navy);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 14px;
    padding: 11px 14px;
    border-radius: var(--radius-pill, 9999px);
    cursor: pointer;
    min-height: 42px;
    margin-top: 2px;
    transition: filter 0.2s ease;
  }
  .theinmag-you-may-also-like__join:hover,
  .theinmag-you-may-also-like__join:focus-visible {
    filter: brightness(0.94);
    outline: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-you-may-also-like__add,
    .theinmag-you-may-also-like__join {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "You may also like",
  "tag": "section",
  "class": "shopify-section theinmag-you-may-also-like-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Curated upsell row: Snack Pack, Membership, Digital Stack, and the current issue (read from the current_issue_number metafield, so it auto-updates each drop). If the visitor is on one of those, that slot swaps to the previous issue."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "collection",
      "id": "issues_collection",
      "label": "Issues collection"
    },
    {
      "type": "text",
      "id": "membership_handle",
      "label": "Membership product handle",
      "default": "membership"
    },
    {
      "type": "text",
      "id": "digital_stack_blurb",
      "label": "Digital Stack blurb",
      "info": "One-line descriptor shown on the Digital Stack tile (single price, so it has room for a what-is-this line). Leave blank to hide.",
      "default": "Every issue we've made, digital, straight to your inbox."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 128,
      "step": 4,
      "default": 72,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 128,
      "step": 4,
      "default": 72,
      "unit": "px"
    }
  ],
  "presets": [
    { "name": "You may also like" }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
