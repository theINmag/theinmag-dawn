{%- comment -%}
  theinmag-stockist-kit-band (Webster, 2026-10-24)
  The "inky shelf": a slim dark band under the /pages/instock hero that hands
  stockists to the stockist kit. Concept by Fable, picked by Ryan's brief
  ("up high, minimal writing, suit the kit page"). It borrows the kit hero's
  look: inky ground, the three newest covers fanned and peeking up from the
  band's bottom edge, Post heading, one yellow stamp button.
  Sits BELOW the hero so "Become a stockist" keeps the first word.
  Covers are automatic: newest three in the issues collection.
{%- endcomment -%}

{%- liquid
  assign coll = collections[section.settings.issues_collection]
  assign nums = ''
  for p in coll.products limit: 50
    assign n = p.metafields.single_mag.issue_number.value | plus: 0
    if n > 0 and p.featured_image
      assign padded = n | prepend: '000' | slice: -3, 3
      assign nums = nums | append: padded | append: ':' | append: p.handle | append: ','
    endif
  endfor
  assign issue_keys = nums | split: ',' | sort | reverse
  assign kit_url = section.settings.kit_url | default: '/pages/stockist-kit'
-%}

<section class="kb" aria-labelledby="kb-h-{{ section.id }}">
  <a class="kb__inner" href="{{ kit_url }}">
    <span class="kb__shelf" aria-hidden="true">
      {%- for key in issue_keys limit: 3 -%}
        {%- assign h = key | split: ':' | last -%}
        {%- assign p = all_products[h] -%}
        <span class="kb__cover kb__cover--{{ forloop.index }}">
          {{ p.featured_image | image_url: width: 420 | image_tag: alt: '', loading: 'lazy', widths: '210, 420', sizes: '210px' }}
        </span>
      {%- endfor -%}
    </span>
    <span class="kb__copy">
      <span id="kb-h-{{ section.id }}" class="kb__h">{{ section.settings.heading }}</span>
      <span class="kb__line">{{ section.settings.line }}</span>
      <span class="kb__btn">{{ section.settings.button }}</span>
    </span>
  </a>
</section>

<style>
  .kb { background: var(--color-inky-purple-navy, #2A1F3D); color: var(--color-cream, #FBF6EA); overflow: hidden; }
  .kb__inner {
    max-width: 1320px; margin: 0 auto; padding: 0 clamp(16px, 4vw, 48px);
    display: grid; grid-template-columns: 1fr; color: inherit; text-decoration: none;
  }
  .kb__shelf { position: relative; height: 150px; display: block; }
  .kb__cover {
    position: absolute; bottom: -70px; left: 50%; width: 150px;
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.45), 0 8px 16px rgba(0, 0, 0, 0.3);
    transition: transform 0.3s ease-out;
  }
  .kb__cover img { display: block; width: 100%; height: auto; }
  .kb__cover--1 { z-index: 3; transform: translateX(-50%) rotate(-3deg); }
  .kb__cover--2 { z-index: 2; transform: translateX(-4%) rotate(7deg); }
  .kb__cover--3 { z-index: 1; transform: translateX(-96%) rotate(-10deg); }
  .kb__copy { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; padding: 28px 0 32px; }
  .kb .kb__h {
    font-family: var(--font-heading); font-weight: 400; font-synthesis: none; text-transform: uppercase;
    font-size: clamp(30px, 4vw, 42px); line-height: 1; color: var(--color-cream, #FBF6EA);
  }
  .kb__line { font: 400 15px/1.5 var(--font-body); opacity: 0.72; }
  .kb__btn {
    margin-top: 6px; display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 24px;
    background: var(--color-yellow, #F9C23C); color: var(--color-inky-purple-navy, #2A1F3D);
    border-radius: var(--radius-button, 32px); box-shadow: 0 4px 0 var(--color-yellow-shadow, #D4A02E);
    font: 700 15px/1 var(--font-body); transition: transform 0.2s ease;
  }
  .kb__inner:hover .kb__btn, .kb__inner:focus-visible .kb__btn { transform: translateY(-2px); }
  .kb__inner:focus-visible { outline: 3px solid var(--color-yellow, #F9C23C); outline-offset: -3px; }
  .kb__inner:hover .kb__cover--1 { transform: translateX(-50%) translateY(-6px) rotate(-4deg); }
  .kb__inner:hover .kb__cover--2 { transform: translateX(-2%) translateY(-6px) rotate(9deg); }
  .kb__inner:hover .kb__cover--3 { transform: translateX(-98%) translateY(-6px) rotate(-12deg); }
  @media (max-width: 749px) {
    /* Phones (Ryan, 24 Oct): copy and button first, covers underneath,
       peeking up from the band's bottom edge. Button keeps its own width. */
    .kb__copy { order: 1; padding-bottom: 20px; }
    .kb__shelf { order: 2; overflow: hidden; height: 120px; }
    .kb__cover { width: 130px; bottom: -95px; }
  }
  @media (min-width: 750px) {
    .kb__inner { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); align-items: center; min-height: 170px; }
    .kb__shelf { height: 170px; }
    .kb__cover { width: 190px; bottom: -95px; }
    .kb__copy { padding: 28px 0; }
  }
  @media (prefers-reduced-motion: reduce) { .kb__cover, .kb__btn { transition: none; } }
</style>

{% schema %}
{
  "name": "Stockist kit band",
  "tag": "div",
  "class": "theinmag-stockist-kit-band-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your stockist kit" },
    { "type": "text", "id": "line", "label": "Line", "default": "Photos, clips, logos and words, ready to use." },
    { "type": "text", "id": "button", "label": "Button", "default": "Open the kit" },
    { "type": "text", "id": "kit_url", "label": "Kit page URL", "default": "/pages/stockist-kit" },
    { "type": "text", "id": "issues_collection", "label": "Issues collection handle", "default": "single-issues" }
  ],
  "presets": [ { "name": "Stockist kit band" } ]
}
{% endschema %}
