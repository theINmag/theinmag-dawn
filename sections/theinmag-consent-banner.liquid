{%- comment -%}
  theinmag-consent-banner
  Slim full-bleed announcement band - icon + headline + button on a
  yellow ground. Sits in-page (not sticky) on /pages/for-teachers,
  pulling the eye to the parental consent form.

  Button has a subtle wobble micro-animation every 6s (transform-only,
  GPU friendly); the band itself shifts a couple of warm yellows over
  4s for ambient liveliness. Both motions respect prefers-reduced-
  motion.

  Hyphens only, never em or en dashes.
{%- endcomment -%}

{%- liquid
  assign icon = section.settings.icon
  assign headline = section.settings.headline | default: 'One form. One year. Sorted.'
  assign button_label = section.settings.button_label | default: 'Grab the consent form'

  assign button_url = section.settings.button_url
  if button_url == blank
    assign button_url = 'theinmag-classroom-consent-form.pdf' | asset_url
  endif

  assign bg_color = section.settings.bg_color | default: '#F9C23C'
  assign button_color = section.settings.button_color | default: '#5D3A7A'
  assign enable_wobble = section.settings.enable_wobble
-%}

<section
  class="theinmag-consent-banner{% if enable_wobble %} theinmag-consent-banner--wobble{% endif %}"
  style="--cb-bg: {{ bg_color }}; --cb-btn: {{ button_color }};"
  role="region"
  aria-label="Parental consent form"
>
  <div class="theinmag-consent-banner__inner">
    {%- if icon != blank -%}
      <img
        class="theinmag-consent-banner__icon"
        src="{{ icon | image_url: width: 48 }}"
        width="24"
        height="24"
        alt=""
        aria-hidden="true"
        loading="lazy"
      >
    {%- else -%}
      <svg class="theinmag-consent-banner__icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
        <rect x="6" y="4" width="12" height="17" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.6"/>
        <rect x="9.5" y="2.5" width="5" height="3" rx="0.6" fill="currentColor"/>
        <line x1="9" y1="11" x2="15" y2="11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        <line x1="9" y1="14" x2="15" y2="14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        <line x1="9" y1="17" x2="13" y2="17" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
      </svg>
    {%- endif -%}

    {%- if headline != blank -%}
      <p class="theinmag-consent-banner__headline">{{ headline }}</p>
    {%- endif -%}

    {%- if button_label != blank -%}
      <a
        class="theinmag-consent-banner__button"
        href="{{ button_url }}"
        aria-label="Download the parental consent form PDF"
      >
        {{- button_label -}}
      </a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .theinmag-consent-banner {
    background-color: var(--cb-bg, #F9C23C);
    color: var(--color-text, #1a1a1a);
    width: 100%;
    height: 52px;
    display: flex;
    align-items: center;
    padding: 0;
  }

  @media (min-width: 768px) {
    .theinmag-consent-banner--wobble {
      animation: theinmag-consent-banner-bg 4s ease-in-out infinite;
    }
  }

  @keyframes theinmag-consent-banner-bg {
    0%, 100% { background-color: var(--cb-bg, #F9C23C); }
    50% { background-color: #F8BD30; }
  }

  .theinmag-consent-banner__inner {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .theinmag-consent-banner__icon {
    flex: 0 0 auto;
    width: 24px;
    height: 24px;
    color: var(--color-text, #1a1a1a);
  }

  .theinmag-consent-banner__headline {
    margin: 0;
    margin-right: 8px;
    font-family: var(--font-heading, 'Post Regular', serif);
    font-weight: 400;
    font-size: 18px;
    line-height: 1.2;
    color: var(--color-text, #1a1a1a);
    white-space: nowrap;
  }

  .theinmag-consent-banner__button {
    flex: 0 0 auto;
    display: inline-block;
    padding: 8px 20px;
    border-radius: var(--radius-pill, 9999px);
    background-color: var(--cb-btn, #5D3A7A);
    color: #ffffff;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: 14px;
    line-height: 1.2;
    text-decoration: none;
    transform-origin: center;
    transition: background-color 0.2s ease, transform 0.1s ease;
  }

  .theinmag-consent-banner--wobble .theinmag-consent-banner__button {
    animation: theinmag-consent-banner-wobble 6s ease-in-out infinite;
  }

  @keyframes theinmag-consent-banner-wobble {
    0%, 90%, 100% { transform: rotate(0); }
    92% { transform: rotate(-1.5deg); }
    94% { transform: rotate(1.5deg); }
    96% { transform: rotate(-1deg); }
    98% { transform: rotate(0.5deg); }
  }

  .theinmag-consent-banner__button:hover,
  .theinmag-consent-banner__button:focus-visible {
    background-color: var(--color-text, #1a1a1a);
    color: #ffffff;
  }

  .theinmag-consent-banner__button:active {
    transform: scale(0.97);
  }

  .theinmag-consent-banner__button:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
  }

  /* Mobile: two rows (icon + headline on top, button below). Banner
     auto-sizes around the stacked content; min-height keeps the 64px
     floor from the brief. Headline drops to 14px so the row fits. */
  @media (max-width: 767px) {
    .theinmag-consent-banner {
      height: auto;
      min-height: 64px;
      padding: 8px 0;
    }

    .theinmag-consent-banner__inner {
      flex-direction: column;
      gap: 8px;
    }

    .theinmag-consent-banner__headline {
      margin-right: 0;
      font-size: 14px;
      white-space: normal;
      text-align: center;
    }

    .theinmag-consent-banner__icon {
      display: none;
    }

    .theinmag-consent-banner__button {
      padding: 6px 16px;
      font-size: 13px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-consent-banner--wobble,
    .theinmag-consent-banner--wobble .theinmag-consent-banner__button {
      animation: none;
    }
    .theinmag-consent-banner__button {
      transition: background-color 0.01ms;
    }
    .theinmag-consent-banner__button:active {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Consent banner",
  "tag": "section",
  "class": "theinmag-consent-banner-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Slim full-bleed announcement band. Icon + one-line headline + pill button. Wobble + ambient bg shift run unless prefers-reduced-motion is set."
    },
    {
      "type": "image_picker",
      "id": "icon",
      "label": "Icon (optional)",
      "info": "24x24 image. Falls back to a built-in clipboard SVG when blank."
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "One form. One year. Sorted."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Grab the consent form"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL",
      "info": "Leave blank to default to /assets/theinmag-classroom-consent-form.pdf"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background colour",
      "default": "#F9C23C"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button colour",
      "default": "#5D3A7A"
    },
    {
      "type": "checkbox",
      "id": "enable_wobble",
      "label": "Enable wobble + bg-shift animations",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Consent banner"
    }
  ]
}
{% endschema %}
