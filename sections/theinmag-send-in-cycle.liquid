{%- comment -%}
  theinmag-send-in-cycle
  Section 3 of /pages/send-in. Single-row accordion (closed by
  default). Header is the question; tap reveals the wheel image
  alongside a plain-language explainer.

  Submissions are ALWAYS open - the framing is "we read everything
  and consider it for the next issue", not "submissions close on
  date X". The wheel image lives in /assets/sendincontent_submissionwheel.jpg
  (Ryan's existing asset).

  Note: an earlier version of this section dynamically calculated
  "your creation could be in Mag XX, dropping DD Month YYYY" using a
  120-day cutoff + walk-forward from an editor-set anchor. Ryan
  pulled that on 2026-05-07 - too specific, creates a staleness risk
  if the anchor isn't bumped on release day. The reusable date-cycle
  pattern is preserved in the pattern library at §4.9 for future use.
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading
  assign explainer = section.settings.explainer
  assign disclaimer = section.settings.disclaimer

  assign section_style = '--sic-pt: ' | append: section.settings.padding_top | append: 'px; --sic-pb: ' | append: section.settings.padding_bottom | append: 'px;'

  assign panel_id = 'theinmag-send-in-cycle-panel-' | append: section.id
-%}

<section
  class="theinmag-send-in-cycle"
  data-theinmag-send-in-cycle
  aria-labelledby="theinmag-send-in-cycle-heading"
  style="{{ section_style }}"
>
  <div class="theinmag-send-in-cycle__inner">
    <h2 class="theinmag-send-in-cycle__heading" id="theinmag-send-in-cycle-heading">
      <button
        type="button"
        class="theinmag-send-in-cycle__trigger"
        aria-expanded="false"
        aria-controls="{{ panel_id }}"
        data-theinmag-send-in-cycle-trigger
      >
        <span class="theinmag-send-in-cycle__heading-text">{{ heading }}</span>
        <span class="theinmag-send-in-cycle__caret" aria-hidden="true"></span>
      </button>
    </h2>

    <div
      id="{{ panel_id }}"
      class="theinmag-send-in-cycle__panel-wrap"
      data-theinmag-send-in-cycle-panel
      data-open="false"
    >
      <div class="theinmag-send-in-cycle__panel">
        <div class="theinmag-send-in-cycle__wheel-wrap">
          <img
            class="theinmag-send-in-cycle__wheel"
            src="{{ 'sendincontent_submissionwheel.jpg' | asset_url }}"
            alt="theINmag submission wheel showing the three issues a year - February, June and October"
            width="800"
            height="800"
            loading="lazy"
          >
        </div>
        <div class="theinmag-send-in-cycle__copy">
          <div class="theinmag-send-in-cycle__explainer">
            {{ explainer }}
          </div>
          {%- if disclaimer != blank -%}
            <div class="theinmag-send-in-cycle__disclaimer">{{ disclaimer }}</div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{%- stylesheet -%}
  /* ================================================================
     theinmag-send-in-cycle
     Warm off-white background to alternate with cream-pair sections
     above and below. Single-row accordion - heading is the question,
     panel reveals the wheel + explainer.
     ================================================================ */

  .theinmag-send-in-cycle {
    background-color: #FDFAF5;
    color: var(--color-inky-purple-navy, #2A1F3D);
    padding: var(--sic-pt, 56px) clamp(16px, 4vw, 32px) var(--sic-pb, 56px);
    position: relative;
  }

  .theinmag-send-in-cycle__inner {
    max-width: 960px;
    margin: 0 auto;
    border-top: 1px solid rgba(42, 31, 61, 0.12);
    border-bottom: 1px solid rgba(42, 31, 61, 0.12);
  }

  /* H2 wrapper carries semantic weight; the <button> child does the
     visible work - matches the FAQ accordion convention (5xx FAQ
     pattern, theinmag-faq.liquid). */
  .theinmag-send-in-cycle__heading {
    margin: 0;
    font: inherit;
  }

  .theinmag-send-in-cycle__trigger {
    appearance: none;
    background: none;
    border: 0;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(12px, 1.5vw, 20px);
    padding: clamp(20px, 2.4vw, 28px) clamp(8px, 1.5vw, 16px);
    cursor: pointer;
    text-align: left;
    color: var(--color-inky-purple-navy, #2A1F3D);
    min-height: 56px;
    transition: color var(--transition-standard, 0.15s ease);
  }

  .theinmag-send-in-cycle__trigger:hover,
  .theinmag-send-in-cycle__trigger:focus-visible {
    color: var(--color-purple-dark, #5D3A7A);
    outline: none;
  }

  .theinmag-send-in-cycle__trigger:focus-visible {
    outline: 2px dashed var(--color-purple-dark, #5D3A7A);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .theinmag-send-in-cycle__heading-text {
    flex: 1;
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-size: clamp(22px, 3.4vw, 32px);
    line-height: 1.15;
    letter-spacing: 0;
  }

  /* Caret matches the FAQ pattern - two stroked lines forming a
     chevron, rotates 0 -> 180deg on expand. */
  .theinmag-send-in-cycle__caret {
    flex: 0 0 auto;
    width: 22px;
    height: 22px;
    position: relative;
    transition: transform 0.3s ease;
    color: var(--color-purple-dark, #5D3A7A);
  }

  .theinmag-send-in-cycle__caret::before,
  .theinmag-send-in-cycle__caret::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 12px;
    height: 2px;
    background-color: currentColor;
    border-radius: 2px;
    transform-origin: 50% 50%;
  }

  .theinmag-send-in-cycle__caret::before {
    left: 1px;
    transform: translateY(-50%) rotate(45deg);
  }

  .theinmag-send-in-cycle__caret::after {
    right: 1px;
    transform: translateY(-50%) rotate(-45deg);
  }

  .theinmag-send-in-cycle__trigger[aria-expanded="true"] .theinmag-send-in-cycle__caret {
    transform: rotate(180deg);
  }

  /* Panel - max-height transition for the reveal. Same approach as
     the FAQ accordion (grid 0fr trick is fragile across engines). */
  .theinmag-send-in-cycle__panel-wrap {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .theinmag-send-in-cycle__panel-wrap[data-open="true"] {
    max-height: 1800px;
  }

  .theinmag-send-in-cycle__panel {
    padding: 0 clamp(8px, 1.5vw, 16px) clamp(28px, 3vw, 36px);
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 2.4vw, 28px);
  }

  @media (min-width: 750px) {
    .theinmag-send-in-cycle__panel {
      flex-direction: row;
      align-items: center;
      gap: clamp(24px, 3vw, 40px);
    }
  }

  /* Wheel - static image, displayed at a comfortable size on both
     mobile (centred, full width up to ~360px) and desktop (left
     column, square crop). */
  .theinmag-send-in-cycle__wheel-wrap {
    flex: 0 0 auto;
    align-self: center;
    width: 100%;
    max-width: 360px;
  }

  @media (min-width: 750px) {
    .theinmag-send-in-cycle__wheel-wrap {
      max-width: 380px;
    }
  }

  .theinmag-send-in-cycle__wheel {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 50%;
  }

  .theinmag-send-in-cycle__copy {
    flex: 1 1 auto;
    min-width: 0;
  }

  .theinmag-send-in-cycle__explainer {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: clamp(15px, 1.5vw, 17px);
    line-height: 1.6;
    color: var(--color-inky-purple-navy, #2A1F3D);
  }

  .theinmag-send-in-cycle__explainer p {
    margin: 0 0 clamp(10px, 1.2vw, 14px);
  }

  .theinmag-send-in-cycle__explainer p:last-child {
    margin-bottom: 0;
  }

  .theinmag-send-in-cycle__explainer strong {
    color: var(--color-purple-dark, #5D3A7A);
    font-weight: 600;
  }

  .theinmag-send-in-cycle__disclaimer {
    margin: clamp(16px, 2vw, 20px) 0 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-style: italic;
    font-size: clamp(13px, 1.3vw, 14px);
    line-height: 1.6;
    color: var(--color-inky-purple-navy, #2A1F3D);
    opacity: 0.7;
  }

  .theinmag-send-in-cycle__disclaimer p {
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-send-in-cycle__caret,
    .theinmag-send-in-cycle__panel-wrap {
      transition: none;
    }
  }
{%- endstylesheet -%}

<script>
  (function () {
    var root = document.querySelector('[data-theinmag-send-in-cycle]');
    if (!root) return;

    var trigger = root.querySelector('[data-theinmag-send-in-cycle-trigger]');
    var panel = root.querySelector('[data-theinmag-send-in-cycle-panel]');
    if (!trigger || !panel) return;

    trigger.addEventListener('click', function () {
      var expanded = trigger.getAttribute('aria-expanded') === 'true';
      trigger.setAttribute('aria-expanded', expanded ? 'false' : 'true');
      panel.setAttribute('data-open', expanded ? 'false' : 'true');
    });
  })();
</script>

{% schema %}
{
  "name": "theINmag Send IN cycle",
  "tag": "section",
  "class": "theinmag-send-in-cycle-section",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "When will my creation be in the mag?"
    },
    {
      "type": "header",
      "content": "Body copy"
    },
    {
      "type": "richtext",
      "id": "explainer",
      "label": "Explainer (rich text)",
      "default": "<p>theINmag drops three times a year - February, June, and October.</p><p>Submissions are always open. Send yours in any time and we'll consider it for the next issue.</p><p>Want to make sure your kid never misses one? <strong>Members get every new mag delivered straight to their door.</strong></p>"
    },
    {
      "type": "richtext",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "<p>We can't publish every creation - there are more incredible kids than there are pages. If yours doesn't make this issue, it might still appear in the gallery, on socials, or in a future mag.</p>"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "theINmag Send IN cycle"
    }
  ]
}
{% endschema %}
