{%- comment -%}
  theinmag-membership-chooser
  Decision-first landing for /pages/membership (v3.3 Combo split). Routes
  the visitor to the right Membership: Print / Digital / Combo. Each card =
  image + format name + one-line subhead + a live price ladder (one row per
  Length, price pulled from the actual product variants so it never goes
  stale). Each length row deep-links to that product's PDP with the
  format + length pre-selected (?format=&length=), so the buyer still lands
  on the PDP and picks current-vs-next issue (the _starting_mag step) before
  checkout - we don't add straight to cart and skip that.

  Print + Digital read from the `membership` product (option1 = Format,
  option2 = Length). Combo reads from `membership-combo` (option1 = Length,
  no Rolling). Cards are blocks so copy/images stay admin-editable; prices
  + links are derived, not typed. Design system: 6.4 (decision-first) +
  6.6 product-link card language. Tokens only - purple primary, yellow
  accent, cream ground.

  NOTE: a card's price rows only render once its product is ACTIVE +
  published to the Online Store channel (all_products only returns those).
  Combo prices appear once the Combo product is live.
{%- endcomment -%}

{%- liquid
  assign section_style = '--tmc-pt: ' | append: section.settings.padding_top | append: 'px; --tmc-pb: ' | append: section.settings.padding_bottom | append: 'px;'
  assign length_order = '4-Issue,8-Issue,Rolling' | split: ','
-%}

<section
  class="theinmag-membership-chooser"
  aria-labelledby="theinmag-membership-chooser-heading"
  style="{{ section_style }}"
>
  <div class="theinmag-membership-chooser__inner">

    <header class="theinmag-membership-chooser__head">
      {%- assign heading_html = section.settings.heading | replace: 'theINmag', 'the<span class="theinmag-in">IN</span>mag' -%}
      <h1 id="theinmag-membership-chooser-heading" class="theinmag-membership-chooser__heading">{{ heading_html }}</h1>
      {%- if section.settings.subhead != blank -%}
        <p class="theinmag-membership-chooser__subhead">{{ section.settings.subhead }}</p>
      {%- endif -%}
    </header>

    <ul class="theinmag-membership-chooser__cards" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_img = ''
          if block.settings.image != blank
            assign card_img = block.settings.image | image_url: width: 800
          elsif block.settings.fallback_filename != blank
            assign card_img = block.settings.fallback_filename | asset_url
          endif
          assign fmt = block.settings.format
          assign prod = all_products[block.settings.product_handle]
          # Where the row links to can differ from where prices are read: the
          # Combo card reads prices from the membership-combo product but links
          # to the unified PDP (/products/membership?format=Combo).
          assign link_handle = block.settings.link_handle | default: block.settings.product_handle
          assign link_fmt = block.settings.link_format | default: block.settings.format
        -%}
        <li class="theinmag-membership-chooser__card" {{ block.shopify_attributes }}>
          <div class="theinmag-membership-chooser__card-frame">
            {%- if card_img != blank -%}
              <img class="theinmag-membership-chooser__card-img" src="{{ card_img }}" alt="{{ block.settings.image_alt | escape }}" loading="lazy" width="800" height="600">
            {%- endif -%}
            {%- if block.settings.badge != blank -%}
              <span class="theinmag-membership-chooser__card-badge">{{ block.settings.badge }}</span>
            {%- endif -%}
          </div>
          <div class="theinmag-membership-chooser__card-body">
            <span class="theinmag-membership-chooser__card-label">{{ block.settings.label }}</span>
            {%- if block.settings.subhead != blank -%}
              <span class="theinmag-membership-chooser__card-sub">{{ block.settings.subhead }}</span>
            {%- endif -%}

            <ul class="theinmag-membership-chooser__plans" role="list">
              {%- for len in length_order -%}
                {%- assign match = false -%}
                {%- for v in prod.variants -%}
                  {%- if fmt != blank and v.option1 == fmt and v.option2 == len -%}
                    {%- assign match = v -%}{%- break -%}
                  {%- elsif fmt == blank and v.option1 == len -%}
                    {%- assign match = v -%}{%- break -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- if match -%}
                  {%- if link_fmt != blank -%}
                    {%- capture row_link -%}/products/{{ link_handle }}?format={{ link_fmt | url_encode }}&length={{ len | url_encode }}{%- endcapture -%}
                  {%- else -%}
                    {%- capture row_link -%}/products/{{ link_handle }}?length={{ len | url_encode }}{%- endcapture -%}
                  {%- endif -%}
                  {%- assign is_best = false -%}
                  {%- if len == '8-Issue' -%}{%- assign is_best = true -%}{%- endif -%}
                  <li>
                    <a
                      class="theinmag-membership-chooser__plan{% if is_best %} theinmag-membership-chooser__plan--best{% endif %}"
                      href="{{ row_link }}"
                      aria-label="{{ block.settings.label | escape }} {{ len }} membership - {{ match.price | money }}{% if len == 'Rolling' %} per drop{% endif %}"
                    >
                      <span class="theinmag-membership-chooser__plan-name">
                        {{ len }}
                        {%- if is_best -%}<span class="theinmag-membership-chooser__plan-tag">Best value</span>{%- endif -%}
                      </span>
                      <span class="theinmag-membership-chooser__plan-price">
                        {{ match.price | money_without_trailing_zeros }}{%- if len == 'Rolling' -%}<span class="theinmag-membership-chooser__plan-per">/drop</span>{%- endif -%}
                      </span>
                    </a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        </li>
      {%- endfor -%}
    </ul>

  </div>
</section>

{% stylesheet %}
  .theinmag-membership-chooser {
    background-color: var(--color-cream);
    color: var(--color-inky-purple-navy);
    padding: var(--tmc-pt, 72px) var(--space-lg) var(--tmc-pb, 80px);
  }

  .theinmag-membership-chooser__inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .theinmag-membership-chooser__head {
    text-align: center;
    /* Wide enough that the subhead sits on one line on desktop; it still
       wraps gracefully on tablet/mobile. */
    max-width: 800px;
    margin: 0 auto var(--space-xl);
  }

  .theinmag-membership-chooser__heading {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(30px, 5vw, 46px);
    line-height: 1.05;
    color: var(--color-inky-purple-navy);
    margin: 0 0 var(--space-sm);
  }

  .theinmag-membership-chooser__subhead {
    font-family: var(--font-body);
    font-size: clamp(15px, 1.7vw, 16px);
    line-height: 1.5;
    color: var(--color-inky-purple-navy);
    opacity: 0.82;
    margin: 0;
  }

  .theinmag-membership-chooser__cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 750px) {
    .theinmag-membership-chooser__cards {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-md);
      align-items: stretch;
    }
  }

  .theinmag-membership-chooser__card {
    margin: 0;
    display: flex;
    flex-direction: column;
    background: #FFFFFF;
    border: 2px solid transparent;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 6px 20px rgba(42, 31, 61, 0.10);
  }

  .theinmag-membership-chooser__card-frame {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: rgba(42, 31, 61, 0.05);
    overflow: hidden;
  }
  .theinmag-membership-chooser__card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .theinmag-membership-chooser__card-badge {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    background: var(--color-purple-dark);
    color: var(--color-cream);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: 9999px;
  }

  .theinmag-membership-chooser__card-body {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    padding: var(--space-md) var(--space-md) var(--space-lg);
    text-align: center;
  }

  .theinmag-membership-chooser__card-label {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(22px, 2.6vw, 26px);
    line-height: 1.1;
    color: var(--color-inky-purple-navy);
    margin: 0 0 6px;
  }

  .theinmag-membership-chooser__card-sub {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.45;
    color: var(--color-inky-purple-navy);
    opacity: 0.8;
    margin: 0 0 var(--space-md);
  }

  /* Live price ladder - one tappable row per Length. Rows are the CTAs;
     each deep-links to the PDP with the format + length pre-selected. The
     auto-margin-top pins the ladder to the card foot so cards with longer
     subheads keep their ladders aligned. */
  .theinmag-membership-chooser__plans {
    list-style: none;
    margin: auto 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
  }
  .theinmag-membership-chooser__plans li { margin: 0; }

  .theinmag-membership-chooser__plan {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    width: 100%;
    padding: 7px 16px;
    border: 1.5px solid var(--color-soft-pink);
    border-radius: var(--radius-pill);
    text-decoration: none;
    color: var(--color-inky-purple-navy);
    font-family: var(--font-body);
    transition: background var(--transition-standard), border-color var(--transition-standard), transform var(--transition-standard);
  }
  .theinmag-membership-chooser__plan:hover,
  .theinmag-membership-chooser__plan:focus-visible {
    border-color: var(--color-purple-dark);
    background: rgba(93, 58, 122, 0.07);
    outline: none;
  }
  /* All rows share one resting style - the "Best value" chip is the only
     thing that marks the 8-Issue row (no border/shadow accent). */

  /* Cap the row width on desktop so the selectors don't stretch the full
     card width and read as over-long bars. Full width on mobile. */
  @media (min-width: 750px) {
    .theinmag-membership-chooser__plan {
      max-width: 240px;
      margin-left: auto;
      margin-right: auto;
    }
  }

  .theinmag-membership-chooser__plan-name {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    font-size: 14px;
  }
  .theinmag-membership-chooser__plan-tag {
    background: var(--color-yellow);
    color: var(--color-inky-purple-navy);
    font-weight: 700;
    font-size: 9px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 9999px;
  }
  .theinmag-membership-chooser__plan-price {
    font-weight: 700;
    font-size: 14px;
    white-space: nowrap;
  }
  .theinmag-membership-chooser__plan-per {
    font-weight: 500;
    font-size: 11px;
    opacity: 0.7;
    margin-left: 1px;
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-membership-chooser__plan { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Membership chooser",
  "tag": "section",
  "class": "shopify-section theinmag-membership-chooser-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pick your Membership"
    },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Subhead",
      "default": "Never miss an issue. Three drops a year, direct to your kid's letterbox - or inbox."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 128,
      "step": 4,
      "default": 72,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 128,
      "step": 4,
      "default": 80,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "option",
      "name": "Membership option",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "fallback_filename",
          "label": "Fallback image filename (in /assets)",
          "info": "Used if no image is picked above. e.g. membership-hero-print.jpg"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Format name"
        },
        {
          "type": "text",
          "id": "subhead",
          "label": "One-line subhead"
        },
        {
          "type": "text",
          "id": "product_handle",
          "label": "Product handle (prices read from here)",
          "info": "e.g. membership or membership-combo"
        },
        {
          "type": "text",
          "id": "format",
          "label": "Format option value",
          "info": "Print or Digital for the membership product. Leave blank for single-option products like the Combo."
        },
        {
          "type": "text",
          "id": "link_handle",
          "label": "Link product handle (optional)",
          "info": "Where the rows link to, if different from the price product. e.g. Combo reads prices from membership-combo but links to membership."
        },
        {
          "type": "text",
          "id": "link_format",
          "label": "Link format value (optional)",
          "info": "Format param for the link, if different from above. e.g. Combo."
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge (optional)",
          "info": "Small chip on the image, e.g. Save 10%"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Membership chooser",
      "blocks": [
        {
          "type": "option",
          "settings": {
            "fallback_filename": "membership-hero-print.jpg",
            "image_alt": "A printed theINmag issue in a child's hands.",
            "label": "Print",
            "subhead": "The real mag in their hands, every drop.",
            "product_handle": "membership",
            "format": "Print"
          }
        },
        {
          "type": "option",
          "settings": {
            "fallback_filename": "membership-hero-digital.jpg",
            "image_alt": "theINmag read on a tablet screen.",
            "label": "Digital",
            "subhead": "Instant, anywhere, on any screen.",
            "product_handle": "membership",
            "format": "Digital"
          }
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["page"]
  }
}
{% endschema %}
