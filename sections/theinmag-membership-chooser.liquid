{%- comment -%}
  theinmag-membership-chooser
  Decision-first landing for /pages/membership (v3.3 Combo split). Routes
  the visitor to the right Membership: Print / Digital / Combo. Each card =
  image + format name + one-line subhead + "From $XX" + CTA. The Combo card
  is featured (purple border + "Save 10%" badge) as the value pick.

  Print + Digital both route to /products/membership (the unified Print +
  Digital PDP); Combo routes to its own /products/membership-combo bundle
  product. Cards are blocks so copy/links/images stay admin-editable.
  Design system: 6.4 (decision-first) framing + 6.6 product-link card
  language. Tokens only - purple primary, yellow CTA, cream ground.
{%- endcomment -%}

{%- liquid
  assign section_style = '--tmc-pt: ' | append: section.settings.padding_top | append: 'px; --tmc-pb: ' | append: section.settings.padding_bottom | append: 'px;'
-%}

<section
  class="theinmag-membership-chooser"
  aria-labelledby="theinmag-membership-chooser-heading"
  style="{{ section_style }}"
>
  <div class="theinmag-membership-chooser__inner">

    <header class="theinmag-membership-chooser__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="theinmag-membership-chooser__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- assign heading_html = section.settings.heading | replace: 'theINmag', 'the<span class="theinmag-in">IN</span>mag' -%}
      <h1 id="theinmag-membership-chooser-heading" class="theinmag-membership-chooser__heading">{{ heading_html }}</h1>
      {%- if section.settings.subhead != blank -%}
        <p class="theinmag-membership-chooser__subhead">{{ section.settings.subhead }}</p>
      {%- endif -%}
    </header>

    <ul class="theinmag-membership-chooser__cards" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_img = ''
          if block.settings.image != blank
            assign card_img = block.settings.image | image_url: width: 800
          elsif block.settings.fallback_filename != blank
            assign card_img = block.settings.fallback_filename | asset_url
          endif
          assign is_featured = block.settings.featured
        -%}
        <li
          class="theinmag-membership-chooser__card{% if is_featured %} theinmag-membership-chooser__card--featured{% endif %}"
          {{ block.shopify_attributes }}
        >
          <a class="theinmag-membership-chooser__card-link" href="{{ block.settings.link | default: '#' }}" aria-label="{{ block.settings.label | escape }} Membership - {{ block.settings.cta_label | escape }}">
            <span class="theinmag-membership-chooser__card-frame">
              {%- if card_img != blank -%}
                <img class="theinmag-membership-chooser__card-img" src="{{ card_img }}" alt="{{ block.settings.image_alt | escape }}" loading="lazy" width="800" height="600">
              {%- endif -%}
              {%- if block.settings.badge != blank -%}
                <span class="theinmag-membership-chooser__card-badge">{{ block.settings.badge }}</span>
              {%- endif -%}
            </span>
            <span class="theinmag-membership-chooser__card-body">
              <span class="theinmag-membership-chooser__card-label">{{ block.settings.label }}</span>
              {%- if block.settings.subhead != blank -%}
                <span class="theinmag-membership-chooser__card-sub">{{ block.settings.subhead }}</span>
              {%- endif -%}
              {%- if block.settings.price != blank -%}
                <span class="theinmag-membership-chooser__card-price">{{ block.settings.price }}</span>
              {%- endif -%}
              <span class="theinmag-membership-chooser__card-cta">{{ block.settings.cta_label | default: 'Choose this' }}</span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>

  </div>
</section>

{% stylesheet %}
  .theinmag-membership-chooser {
    background-color: var(--color-cream);
    color: var(--color-inky-purple-navy);
    padding: var(--tmc-pt, 72px) var(--space-lg) var(--tmc-pb, 80px);
  }

  .theinmag-membership-chooser__inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .theinmag-membership-chooser__head {
    text-align: center;
    max-width: 640px;
    margin: 0 auto var(--space-xl);
  }

  .theinmag-membership-chooser__eyebrow {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-purple-dark);
    margin: 0 0 var(--space-xs);
  }

  .theinmag-membership-chooser__heading {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(30px, 5vw, 46px);
    line-height: 1.05;
    color: var(--color-inky-purple-navy);
    margin: 0 0 var(--space-sm);
  }

  .theinmag-membership-chooser__subhead {
    font-family: var(--font-body);
    font-size: clamp(15px, 1.8vw, 17px);
    line-height: 1.5;
    color: var(--color-inky-purple-navy);
    opacity: 0.82;
    margin: 0;
  }

  .theinmag-membership-chooser__cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 750px) {
    .theinmag-membership-chooser__cards {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-md);
      align-items: stretch;
    }
  }

  .theinmag-membership-chooser__card {
    margin: 0;
    display: flex;
  }

  .theinmag-membership-chooser__card-link {
    display: flex;
    flex-direction: column;
    width: 100%;
    background: #FFFFFF;
    border: 2px solid transparent;
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 6px 20px rgba(42, 31, 61, 0.10);
    transition: transform var(--transition-standard), box-shadow var(--transition-standard), border-color var(--transition-standard);
  }
  .theinmag-membership-chooser__card-link:hover,
  .theinmag-membership-chooser__card-link:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px rgba(42, 31, 61, 0.18);
    outline: none;
  }

  /* Featured (Combo) card - purple frame + a touch more lift so it reads
     as the value pick. */
  .theinmag-membership-chooser__card--featured .theinmag-membership-chooser__card-link {
    border-color: var(--color-purple-dark);
    box-shadow: 0 10px 28px rgba(93, 58, 122, 0.20);
  }

  .theinmag-membership-chooser__card-frame {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: rgba(42, 31, 61, 0.05);
    overflow: hidden;
  }
  .theinmag-membership-chooser__card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .theinmag-membership-chooser__card-badge {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    background: var(--color-purple-dark);
    color: var(--color-cream);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: 9999px;
  }

  .theinmag-membership-chooser__card-body {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    padding: var(--space-md) var(--space-md) var(--space-lg);
    text-align: center;
  }

  .theinmag-membership-chooser__card-label {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(22px, 2.6vw, 26px);
    line-height: 1.1;
    color: var(--color-inky-purple-navy);
    margin: 0 0 6px;
  }

  .theinmag-membership-chooser__card-sub {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.45;
    color: var(--color-inky-purple-navy);
    opacity: 0.8;
    margin: 0 0 var(--space-sm);
  }

  .theinmag-membership-chooser__card-price {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 16px;
    color: var(--color-inky-purple-navy);
    margin: 0 0 var(--space-md);
  }

  /* Yellow sticker CTA - locked convention. Auto-margin-top pins it to the
     card foot so cards of unequal copy length keep their CTAs aligned. */
  .theinmag-membership-chooser__card-cta {
    margin-top: auto;
    align-self: center;
    display: inline-block;
    background: var(--color-yellow);
    color: var(--color-inky-purple-navy);
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    padding: 10px 22px;
    border-radius: var(--radius-button);
    box-shadow: var(--shadow-button-yellow);
    transition: background var(--transition-standard), color var(--transition-standard), translate var(--transition-standard), box-shadow var(--transition-standard);
  }
  .theinmag-membership-chooser__card-link:hover .theinmag-membership-chooser__card-cta,
  .theinmag-membership-chooser__card-link:focus-visible .theinmag-membership-chooser__card-cta {
    background: var(--color-purple-dark);
    color: #FFFFFF;
    box-shadow: var(--shadow-button-pressed);
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-membership-chooser__card-link:hover,
    .theinmag-membership-chooser__card-link:focus-visible {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Membership chooser",
  "tag": "section",
  "class": "shopify-section theinmag-membership-chooser-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "theINmag Membership"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pick your Membership."
    },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Subhead",
      "default": "Never miss an issue. Three drops a year, direct to your kid's letterbox - or inbox."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 128,
      "step": 4,
      "default": 72,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 128,
      "step": 4,
      "default": 80,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "option",
      "name": "Membership option",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "fallback_filename",
          "label": "Fallback image filename (in /assets)",
          "info": "Used if no image is picked above. e.g. membership-hero-print.jpg"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Format name"
        },
        {
          "type": "text",
          "id": "subhead",
          "label": "One-line subhead"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price line",
          "info": "e.g. From $89"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "CTA label"
        },
        {
          "type": "text",
          "id": "link",
          "label": "Link (path)",
          "info": "e.g. /products/membership"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge (optional)",
          "info": "Small chip on the image, e.g. Save 10%"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Feature this card (purple frame)",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Membership chooser",
      "blocks": [
        {
          "type": "option",
          "settings": {
            "fallback_filename": "membership-hero-print.jpg",
            "image_alt": "A printed theINmag issue in a child's hands.",
            "label": "Print",
            "subhead": "The real mag in their hands, every drop.",
            "price": "From $89",
            "cta_label": "Choose Print",
            "link": "/products/membership"
          }
        },
        {
          "type": "option",
          "settings": {
            "fallback_filename": "membership-hero-digital.jpg",
            "image_alt": "theINmag read on a tablet screen.",
            "label": "Digital",
            "subhead": "Instant, anywhere, on any screen.",
            "price": "From $37.95",
            "cta_label": "Choose Digital",
            "link": "/products/membership"
          }
        },
        {
          "type": "option",
          "settings": {
            "fallback_filename": "membership-hero-combo.jpg",
            "image_alt": "The printed theINmag plus its digital edition.",
            "label": "Combo",
            "subhead": "Both formats. 10% off the pair.",
            "price": "From $115",
            "cta_label": "Choose Combo",
            "link": "/products/membership-combo",
            "badge": "Save 10%",
            "featured": true
          }
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["page"]
  }
}
{% endschema %}
