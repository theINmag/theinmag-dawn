{%- comment -%}
  theinmag-stockists-hero
  The /pages/stockists hub. Two-column split:
    Left 2/3: full-bleed Leaflet map of Australia (left edge bleeds
              past the cream background to the viewport edge on desktop).
    Right 1/3: header + search + state filter + scrollable stockist
               list + "Become a stockist" CTA.

  Data: a JSON <script> block in the markup. v1 hardcoded; later swapped
  for a Liquid loop over shop.metaobjects.stockist (synced daily from a
  Google Sheet by the theinmag-stockists-sync repo). Field names match
  the metaobject schema exactly so the swap is one-for-one.

  Modal lives in the sibling section theinmag-stockists-modal. The
  "become a stockist" button here dispatches a global CustomEvent
  ('theinmag-stockists:open-modal') that the modal section listens for.

  Leaflet is vendored locally at /assets/leaflet.{js,css} (v1.9.4) so
  there is no third-party CDN fetch on every page view. Tiles come from
  CartoDB Voyager (warm cream palette matching the theinmag bg).
{%- endcomment -%}

<link rel="stylesheet" href="{{ 'leaflet.css' | asset_url }}">
<script src="{{ 'leaflet.js' | asset_url }}" defer></script>

<section
  class="theinmag-stockists"
  data-theinmag-stockists
  data-view="map"
  aria-labelledby="theinmag-stockists-h1"
>
  {%- comment -%} Visually-hidden H1 for AEO. The visible heading on the right column is the H2. {%- endcomment -%}
  <h1 id="theinmag-stockists-h1" class="theinmag-stockists__sr">Where to buy theINmag in Australia</h1>

  <div class="theinmag-stockists__stage">

    {%- comment -%} ----- Left: full-bleed Leaflet map column ----- {%- endcomment -%}
    <div class="theinmag-stockists__map-col">
      <div
        class="theinmag-stockists__map"
        data-stockists-map
        id="theinmag-stockists-map"
        role="application"
        aria-label="Map of theINmag stockists across Australia"
      ></div>
      {%- comment -%}
        Mobile-only CTA overlay — pinned to the bottom of the map column
        on mobile so the apply path is visible above the fold (without
        this it sits at the bottom of the panel after the cards list,
        which means scrolling past every stockist to find it).
        Hidden on desktop (the panel CTA covers desktop).
      {%- endcomment -%}
      <a
        class="theinmag-stockists__cta theinmag-stockists__cta--map-overlay"
        href="/pages/become-a-stockist"
      >
        Become a stockist
      </a>
    </div>

    {%- comment -%} ----- Right: header + filters + list + CTA ----- {%- endcomment -%}
    <aside class="theinmag-stockists__panel" aria-label="Stockist list">
      <header class="theinmag-stockists__panel-head">
        <h2 class="theinmag-stockists__heading">Find a stockist near you</h2>
        <p class="theinmag-stockists__sub">Our stockists really care about growing creative community in their patch of Australia. Find your nearest one - or order online.</p>
      </header>

      <div class="theinmag-stockists__filters" data-stockists-filters>
        <label class="theinmag-stockists__search-wrap">
          <span class="theinmag-stockists__sr">Search by suburb or postcode</span>
          <span class="theinmag-stockists__search-icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          </span>
          <input
            type="search"
            class="theinmag-stockists__search"
            data-stockists-search
            placeholder="Suburb or postcode"
            autocomplete="off"
            inputmode="search"
          >
        </label>

        <select class="theinmag-stockists__select" data-stockists-state-filter aria-label="Filter by state">
          <option value="all">All states</option>
          <option value="ACT">ACT</option>
          <option value="NSW">NSW</option>
          <option value="NT">NT</option>
          <option value="QLD">QLD</option>
          <option value="SA">SA</option>
          <option value="TAS">TAS</option>
          <option value="VIC">VIC</option>
          <option value="WA">WA</option>
        </select>
      </div>

      <p class="theinmag-stockists__radius-info" data-stockists-radius-info hidden></p>

      <div class="theinmag-stockists__list-wrap">
        <ul class="theinmag-stockists__list" data-stockists-list aria-live="polite"></ul>
        <p class="theinmag-stockists__list-empty" data-stockists-empty hidden>
          No stockists found near that search. We're growing fast - check back soon, or apply to stock theINmag yourself below.
        </p>
      </div>

      <div class="theinmag-stockists__cta-wrap">
        <a
          class="theinmag-stockists__cta"
          href="/pages/become-a-stockist"
        >
          Become a stockist
        </a>
      </div>
    </aside>

  </div>

  {%- comment -%}
    Live stockist data sourced from Shopify metaobjects (type: stockist).
    The metaobjects are populated daily at 6am by the theinmag-stockists-sync
    repo (Google Sheet → Shopify Admin API). The Sheet at GOOGLE_SHEET_ID
    is the editable source of truth. Field names here match the metaobject
    schema so this loop is the only swap point if data shape changes.
  {%- endcomment -%}
  <script type="application/json" data-stockists-data>
  [
    {%- for s in shop.metaobjects.stockist.values -%}
      {%- unless forloop.first -%},{%- endunless -%}
      {
        "id": {{ s.system.handle | json }},
        "shop_name": {{ s.shop_name.value | default: '' | json }},
        "type": {{ s.type.value | default: '' | json }},
        "street_address": {{ s.street_address.value | default: '' | json }},
        "suburb": {{ s.suburb.value | default: '' | json }},
        "state": {{ s.state.value | default: '' | json }},
        "postcode": {{ s.postcode.value | default: '' | json }},
        "latitude": {{ s.latitude.value | default: 0 }},
        "longitude": {{ s.longitude.value | default: 0 }},
        "contact_name": {{ s.contact_name.value | default: '' | json }},
        "contact_phone": {{ s.contact_phone.value | default: '' | json }},
        "instagram_handle": {{ s.instagram_handle.value | default: '' | json }},
        "website_url": {{ s.website_url.value | default: '' | json }}
      }
    {%- endfor -%}
  ]
  </script>
</section>

{%- stylesheet -%}
  /* ================================================================
     theinmag-stockists-hero
     Two-column split. Left = full-bleed map. Right = header + list +
     CTA. Desktop fits 100vh with no page scroll - the right column
     scrolls internally. Mobile collapses (toggle pattern added in a
     later step).

     Specificity-prefix pattern (.theinmag-stockists .child) is used on
     overrides so we beat Dawn's base.css cascade where needed (per
     the dawn-empty-div / dawn-header-group-zindex notes).
  ================================================================ */

  .theinmag-stockists {
    --st-purple-light: #E8DEEF;
    --st-purple-dark: #5D3A7A;
    --st-coral-light: #FBE0D6;
    --st-coral-dark: #C9543E;
    --st-peach-light: #FCDDB8;
    --st-peach-dark: #D9783A;
    --st-mint-light: #D6EAD9;
    --st-mint-dark: #4A7C5C;
    --st-cream: #FBF6EA;
    --st-cream-dark: #2A1F3D;
    --st-sky-light: #C9E5E8;
    --st-sky-dark: #2D6878;
    --st-yellow: #F9C23C;
    --st-yellow-shadow: #D4A02E;
    --st-purple-press: #4A2D62;

    /* Header height assumption matches the rest of the build (competitions
       uses calc(100vh - 80px) too). The site header is ~80px tall on
       both mobile + desktop. */
    --st-header-h: 80px;

    background-color: var(--st-cream);
    color: var(--st-cream-dark);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    /* Bleed the section to the viewport edges so the map can run
       edge-to-edge on the left. The page wrapper above adds no
       horizontal padding to sections by default in Dawn, but we set
       width here defensively so the section is locked to the
       viewport. */
    width: 100%;
  }

  .theinmag-stockists__sr {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ----- Stage: 100vh on desktop, single column on mobile ----- */
  .theinmag-stockists__stage {
    position: relative;
    /* Mobile-first: stack vertically. Mobile toggle replaces this in
       step 6, but step 1 just shows them stacked so the layout works
       cold without JS. */
    display: flex;
    flex-direction: column;
    min-height: calc(100dvh - var(--st-header-h));
  }

  @media (min-width: 990px) {
    /* Desktop: two columns, 2fr 1fr, exactly viewport height (minus
       header). The map column bleeds full-height. */
    .theinmag-stockists__stage {
      display: grid;
      grid-template-columns: 2fr 1fr;
      height: calc(100vh - var(--st-header-h));
      min-height: 0;
      max-height: 1000px;
    }
  }

  /* ----- Left column: full-bleed map placeholder ----- */
  .theinmag-stockists__map-col {
    position: relative;
    background-color: var(--st-purple-light);
    /* Mobile: short hero strip just so step-1 layout reads. The real
       map fills full height via the toggle pattern in step 6. */
    height: 40vh;
    min-height: 280px;
  }

  /* Mobile-only CTA overlay pinned to the bottom of the map column.
     Hidden on desktop (the in-panel CTA covers that). z-index sits
     above Leaflet's tile + marker panes (max ~700) and below popups. */
  .theinmag-stockists__cta--map-overlay {
    display: none;
  }
  @media (max-width: 989px) {
    .theinmag-stockists__cta--map-overlay {
      display: inline-flex;
      position: absolute;
      left: 16px;
      right: 16px;
      bottom: 16px;
      z-index: 1000;
      box-shadow: 0 6px 18px rgba(42, 31, 61, 0.35),
                  0 4px 0 var(--st-yellow-shadow);
    }
  }

  @media (min-width: 990px) {
    .theinmag-stockists__map-col {
      height: 100%;
      min-height: 0;
    }
  }

  .theinmag-stockists__map {
    position: absolute;
    inset: 0;
    background-color: var(--st-purple-light);
  }
  /* Leaflet's tile pane sits on top of the bg-color above, so this is
     just a fallback while tiles load. */
  .theinmag-stockists__map.leaflet-container {
    background-color: var(--st-purple-light);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
  }

  /* ----- Custom map markers (Leaflet divIcon) ----- */
  .theinmag-stockists__marker {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2.5px solid #FFFFFF;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
    background-color: var(--st-purple-dark);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
    cursor: pointer;
  }
  .theinmag-stockists__marker[data-type="bookshop"]  { background-color: var(--st-purple-dark); }
  .theinmag-stockists__marker[data-type="newsagent"] { background-color: var(--st-coral-dark); }
  .theinmag-stockists__marker[data-type="gallery"]   { background-color: var(--st-mint-dark); }
  .theinmag-stockists__marker[data-type="cafe"]      { background-color: var(--st-peach-dark); }
  .theinmag-stockists__marker[data-type="gift_shop"] { background-color: var(--st-sky-dark); }
  .theinmag-stockists__marker.is-active,
  .theinmag-stockists__marker:hover {
    transform: scale(1.25);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
    border-color: var(--st-yellow);
  }

  /* Leaflet popup styling — match the cream/dark palette */
  .leaflet-popup-content-wrapper {
    background-color: var(--st-cream);
    color: var(--st-cream-dark);
    border-radius: 14px;
    box-shadow: 0 6px 20px rgba(123, 79, 158, 0.18);
  }
  .leaflet-popup-tip { background-color: var(--st-cream); }
  .leaflet-popup-content {
    margin: 12px 14px;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-size: 13.5px;
    line-height: 1.45;
  }
  .leaflet-popup-content .theinmag-popup__name {
    display: block;
    font-weight: 700;
    font-size: 14.5px;
    margin-bottom: 2px;
    color: var(--st-cream-dark);
  }
  .leaflet-popup-content .theinmag-popup__addr {
    color: var(--st-cream-dark);
    opacity: 0.78;
  }
  .leaflet-control-attribution {
    background: rgba(251, 246, 234, 0.8) !important;
    color: var(--st-cream-dark) !important;
    font-size: 10.5px !important;
  }
  .leaflet-control-attribution a {
    color: var(--st-purple-dark) !important;
  }
  .leaflet-control-zoom a {
    background-color: var(--st-cream) !important;
    color: var(--st-cream-dark) !important;
    border-color: rgba(42, 31, 61, 0.16) !important;
  }
  .leaflet-control-zoom a:hover {
    background-color: var(--st-purple-light) !important;
    color: var(--st-purple-dark) !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-stockists__marker { transition: none; }
    .theinmag-stockists__marker.is-active,
    .theinmag-stockists__marker:hover { transform: none; }
  }

  /* ----- Right column: panel ----- */
  .theinmag-stockists__panel {
    display: flex;
    flex-direction: column;
    gap: clamp(8px, 1vw, 12px);
    padding: clamp(16px, 2.4vw, 24px) clamp(14px, 2.4vw, 22px);
    background-color: var(--st-cream);
    min-height: 0;
  }

  @media (min-width: 990px) {
    .theinmag-stockists__panel {
      height: 100%;
      overflow: hidden;
      padding: clamp(14px, 1.4vw, 22px) clamp(16px, 1.4vw, 22px) clamp(12px, 1.2vw, 18px);
    }
  }

  .theinmag-stockists__panel-head {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .theinmag-stockists__heading {
    margin: 0;
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-size: clamp(22px, 2.4vw, 30px);
    line-height: 1.15;
    letter-spacing: 0;
    color: var(--st-cream-dark);
  }

  .theinmag-stockists__sub {
    margin: 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-size: clamp(13px, 0.95vw, 14.5px);
    line-height: 1.45;
    color: var(--st-cream-dark);
    opacity: 0.78;
  }

  .theinmag-stockists__radius-info {
    margin: 0;
    padding: 6px 10px;
    background-color: var(--st-purple-light);
    color: var(--st-purple-dark);
    font-size: 12px;
    line-height: 1.35;
    border-radius: 8px;
    font-weight: 500;
  }
  .theinmag-stockists__radius-info[hidden] { display: none; }

  /* ----- Filters: search input + state dropdown ----- */
  .theinmag-stockists__filters {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: clamp(8px, 1vw, 12px);
    align-items: stretch;
  }

  .theinmag-stockists__search-wrap {
    position: relative;
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .theinmag-stockists__search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    color: var(--st-cream-dark);
    opacity: 0.55;
    pointer-events: none;
  }

  .theinmag-stockists__search,
  .theinmag-stockists__select {
    width: 100%;
    height: 38px;
    padding: 0 14px;
    border: 1.5px solid rgba(42, 31, 61, 0.16);
    background-color: #FFFFFF;
    color: var(--st-cream-dark);
    border-radius: 12px;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-size: 14px;
    line-height: 1.2;
    appearance: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .theinmag-stockists__search {
    padding-left: 36px;
  }
  .theinmag-stockists__search::placeholder {
    color: var(--st-cream-dark);
    opacity: 0.45;
  }
  .theinmag-stockists__search:focus,
  .theinmag-stockists__select:focus {
    outline: none;
    border-color: var(--st-purple-dark);
    box-shadow: 0 0 0 3px rgba(93, 58, 122, 0.18);
  }

  .theinmag-stockists__select {
    padding-right: 32px;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8' viewBox='0 0 12 8' fill='none'><path d='M1 1.5L6 6.5L11 1.5' stroke='%232A1F3D' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'/></svg>");
    background-repeat: no-repeat;
    background-position: right 12px center;
    cursor: pointer;
    min-width: 110px;
  }

  /* ----- List ----- */
  .theinmag-stockists__list-wrap {
    display: flex;
    flex-direction: column;
    min-height: 0;
    flex: 1 1 auto;
  }

  .theinmag-stockists__list {
    list-style: none;
    margin: 0;
    padding: 4px 4px 8px 4px;
    display: flex;
    flex-direction: column;
    gap: clamp(8px, 0.8vw, 10px);
    min-height: 0;
  }

  /* On desktop the list takes the remaining height and scrolls internally */
  @media (min-width: 990px) {
    .theinmag-stockists__list {
      flex: 1 1 auto;
      overflow-y: auto;
      min-height: 0;
      /* Custom scrollbar - subtle */
      scrollbar-width: thin;
      scrollbar-color: rgba(93, 58, 122, 0.3) transparent;
    }
    .theinmag-stockists__list::-webkit-scrollbar { width: 6px; }
    .theinmag-stockists__list::-webkit-scrollbar-thumb {
      background-color: rgba(93, 58, 122, 0.3);
      border-radius: 3px;
    }
  }

  .theinmag-stockists__list-empty {
    margin: 16px 4px;
    padding: 16px;
    text-align: center;
    color: var(--st-cream-dark);
    opacity: 0.65;
    font-size: 13.5px;
    line-height: 1.5;
  }

  /* ----- Stockist card ----- */
  .theinmag-stockists__card {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: clamp(8px, 0.9vw, 12px);
    background-color: var(--st-cream);
    border: 1px solid rgba(42, 31, 61, 0.06);
    border-radius: 16px;
    padding: clamp(10px, 1vw, 13px) clamp(12px, 1.2vw, 15px);
    box-shadow: 0 2px 12px rgba(123, 79, 158, 0.08);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
    cursor: pointer;
    position: relative;
  }
  .theinmag-stockists__card:hover,
  .theinmag-stockists__card.is-active {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(123, 79, 158, 0.16);
    border-color: rgba(93, 58, 122, 0.18);
  }
  .theinmag-stockists__card.is-active {
    border-color: var(--st-purple-dark);
  }

  .theinmag-stockists__card-body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .theinmag-stockists__card-name {
    margin: 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.25;
    color: var(--st-cream-dark);
  }

  .theinmag-stockists__card-chip {
    align-self: flex-start;
    margin-top: 2px;
    padding: 3px 9px;
    background-color: var(--st-purple-light);
    color: var(--st-purple-dark);
    font-size: 10.5px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 6px;
  }
  .theinmag-stockists__card[data-type="bookshop"] .theinmag-stockists__card-chip {
    background-color: var(--st-purple-light); color: var(--st-purple-dark);
  }
  .theinmag-stockists__card[data-type="newsagent"] .theinmag-stockists__card-chip {
    background-color: var(--st-coral-light); color: var(--st-coral-dark);
  }
  .theinmag-stockists__card[data-type="gallery"] .theinmag-stockists__card-chip {
    background-color: var(--st-mint-light); color: var(--st-mint-dark);
  }
  .theinmag-stockists__card[data-type="cafe"] .theinmag-stockists__card-chip {
    background-color: var(--st-peach-light); color: var(--st-peach-dark);
  }
  .theinmag-stockists__card[data-type="gift_shop"] .theinmag-stockists__card-chip {
    background-color: var(--st-sky-light); color: var(--st-sky-dark);
  }

  .theinmag-stockists__card-address,
  .theinmag-stockists__card-contact {
    margin: 0;
    font-size: 13px;
    line-height: 1.45;
    color: var(--st-cream-dark);
    opacity: 0.78;
  }
  .theinmag-stockists__card-contact {
    opacity: 0.62;
    font-size: 12.5px;
  }

  .theinmag-stockists__card-maps {
    align-self: flex-start;
    margin-top: 4px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--st-sky-dark);
    font-size: 12.5px;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }
  .theinmag-stockists__card-maps:hover {
    color: var(--st-purple-dark);
  }

  /* Right side: stacked icon links */
  .theinmag-stockists__card-icons {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: center;
    justify-content: flex-start;
    align-self: start;
  }
  .theinmag-stockists__card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: var(--st-purple-light);
    color: var(--st-purple-dark);
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }
  .theinmag-stockists__card-icon:hover,
  .theinmag-stockists__card-icon:focus-visible {
    background-color: var(--st-purple-dark);
    color: #FFFFFF;
    outline: none;
    transform: translateY(-1px);
  }
  .theinmag-stockists__card-icon svg {
    width: 14px;
    height: 14px;
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-stockists__card,
    .theinmag-stockists__card-icon {
      transition: none;
    }
    .theinmag-stockists__card:hover,
    .theinmag-stockists__card.is-active,
    .theinmag-stockists__card-icon:hover {
      transform: none;
    }
  }

  /* ----- "Become a stockist" CTA - yellow stamp button (design tokens) ----- */
  .theinmag-stockists__cta-wrap {
    margin-top: auto;
    padding-top: clamp(8px, 1vw, 12px);
  }

  .theinmag-stockists__cta {
    appearance: none;
    border: 0;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 11px 24px;
    background-color: var(--st-yellow);
    color: var(--st-cream-dark);
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-size: clamp(17px, 1.3vw, 21px);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none; /* the CTA is an <a> now — kill the underline */
    border-radius: 28px;
    box-shadow: 0 4px 0 var(--st-yellow-shadow);
    transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }

  @media (min-width: 750px) {
    .theinmag-stockists__cta {
      padding: 12px 28px;
    }
  }

  .theinmag-stockists__cta:hover,
  .theinmag-stockists__cta:focus-visible {
    background-color: var(--st-purple-dark);
    color: #FFFFFF;
    transform: translateY(2px);
    box-shadow: 0 2px 0 var(--st-purple-press);
    outline: none;
  }
  .theinmag-stockists__cta:focus-visible {
    box-shadow: 0 0 0 3px var(--st-purple-dark), 0 2px 0 var(--st-purple-press);
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-stockists__cta { transition: none; }
    .theinmag-stockists__cta:hover,
    .theinmag-stockists__cta:focus-visible { transform: none; }
  }
{%- endstylesheet -%}

{%- javascript -%}
  (function () {
    var section = document.querySelector('[data-theinmag-stockists]');
    if (!section) return;

    var dataNode = section.querySelector('[data-stockists-data]');
    var listNode = section.querySelector('[data-stockists-list]');
    var emptyNode = section.querySelector('[data-stockists-empty]');
    var stateFilter = section.querySelector('[data-stockists-state-filter]');
    var searchInput = section.querySelector('[data-stockists-search]');
    var mapEl = section.querySelector('[data-stockists-map]');
    var radiusInfoNode = section.querySelector('[data-stockists-radius-info]');

    var map = null;
    var markerByStockistId = {};
    var radiusOverlay = null;
    var AU_BOUNDS = [[-44.0, 113.0], [-10.0, 154.0]];
    var RADIUS_KM = 80;
    var geocodeCache = {};
    var searchDebounce = null;

    // Sync the panel height to the actual rendered top header (announcement
    // bar + main header). Without this the panel uses calc(100vh - 80px)
    // which doesn't account for the announcement bar — CTA gets clipped.
    // Query every section in the header group rather than naming them by
    // class — section classes are theme-author-controlled (see schema)
    // and brittle. The group class is set by Shopify and stable.
    function syncHeaderHeight() {
      var groupSections = document.querySelectorAll('.shopify-section-group-header-group');
      var h = 0;
      groupSections.forEach(function (el) {
        var r = el.getBoundingClientRect();
        if (r.top < window.innerHeight) h += r.height;
      });
      if (h > 0) section.style.setProperty('--st-header-h', h + 'px');
    }
    syncHeaderHeight();
    window.addEventListener('resize', syncHeaderHeight);
    window.addEventListener('load', syncHeaderHeight);
    setTimeout(syncHeaderHeight, 250);

    var stockists = [];
    if (dataNode) {
      try { stockists = JSON.parse(dataNode.textContent || '[]'); }
      catch (e) { console.warn('[stockists] data parse failed', e); }
    }

    // SVG icon factory - kept inline so we don't ship a separate sprite
    // for three icons. Returns an HTML string (safe - no user input).
    function icon(name) {
      switch (name) {
        case 'instagram':
          return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5" ry="5"></rect><path d="M16 11.4a4 4 0 1 1-7.9 1.2 4 4 0 0 1 7.9-1.2z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>';
        case 'globe':
          return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><line x1="3" y1="12" x2="21" y2="12"></line><path d="M12 3a14 14 0 0 1 0 18 14 14 0 0 1 0-18z"></path></svg>';
        case 'phone':
          return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.6a2 2 0 0 1-.5 2.1L8 9.6a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.8.3 1.7.5 2.6.6a2 2 0 0 1 1.7 2z"></path></svg>';
        case 'maps-arrow':
          return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" width="12" height="12"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="13 6 19 12 13 18"></polyline></svg>';
      }
      return '';
    }

    // Phone link uses tel: with non-digit chars stripped (Aussie numbers
    // tend to render with spaces). We keep the human label readable.
    function telHref(raw) {
      return 'tel:' + (raw || '').replace(/[^0-9+]/g, '');
    }

    function escapeHtml(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    function typeLabel(t) {
      switch (t) {
        case 'gift_shop': return 'Gift shop';
        case 'newsagent': return 'Newsagent';
        case 'bookshop':  return 'Bookshop';
        case 'gallery':   return 'Gallery';
        case 'cafe':      return 'Cafe';
        default:          return 'Other';
      }
    }

    function renderCard(s) {
      var addressLine1 = escapeHtml(s.street_address || '');
      var addressLine2 = [s.suburb, s.state, s.postcode].filter(Boolean).map(escapeHtml).join(' ');
      var contactLine = s.contact_name
        ? '<p class="theinmag-stockists__card-contact">Contact ' + escapeHtml(s.contact_name) + '</p>'
        : '';

      var icons = '';
      if (s.instagram_handle) {
        icons += '<a class="theinmag-stockists__card-icon" href="https://instagram.com/' + encodeURIComponent(s.instagram_handle) + '" target="_blank" rel="noopener noreferrer" aria-label="' + escapeHtml(s.shop_name) + ' on Instagram">' + icon('instagram') + '</a>';
      }
      if (s.website_url) {
        icons += '<a class="theinmag-stockists__card-icon" href="' + escapeHtml(s.website_url) + '" target="_blank" rel="noopener noreferrer" aria-label="' + escapeHtml(s.shop_name) + ' website">' + icon('globe') + '</a>';
      }
      if (s.contact_phone) {
        icons += '<a class="theinmag-stockists__card-icon" href="' + escapeHtml(telHref(s.contact_phone)) + '" aria-label="Call ' + escapeHtml(s.shop_name) + '">' + icon('phone') + '</a>';
      }

      var mapsHref = 'https://www.google.com/maps/search/?api=1&query=' + s.latitude + ',' + s.longitude;

      return (
        '<li class="theinmag-stockists__card" data-stockist-id="' + escapeHtml(s.id) + '" data-type="' + escapeHtml(s.type) + '" data-state="' + escapeHtml(s.state) + '" tabindex="0">' +
          '<div class="theinmag-stockists__card-body">' +
            '<h3 class="theinmag-stockists__card-name">' + escapeHtml(s.shop_name) + '</h3>' +
            '<span class="theinmag-stockists__card-chip">' + escapeHtml(typeLabel(s.type)) + '</span>' +
            '<p class="theinmag-stockists__card-address">' + addressLine1 + (addressLine2 ? '<br>' + addressLine2 : '') + '</p>' +
            contactLine +
            '<a class="theinmag-stockists__card-maps" href="' + mapsHref + '" target="_blank" rel="noopener noreferrer">Open in Google Maps ' + icon('maps-arrow') + '</a>' +
          '</div>' +
          '<div class="theinmag-stockists__card-icons">' + icons + '</div>' +
        '</li>'
      );
    }

    function render(list) {
      if (!listNode) return;
      if (!list.length) {
        listNode.innerHTML = '';
        if (emptyNode) emptyNode.hidden = false;
        return;
      }
      if (emptyNode) emptyNode.hidden = true;
      listNode.innerHTML = list.map(renderCard).join('');
    }

    function sortAlpha(a, b) {
      return a.shop_name.localeCompare(b.shop_name);
    }

    // Great-circle distance between two lat/lng points, kilometres.
    function haversineKm(lat1, lng1, lat2, lng2) {
      var R = 6371;
      var dLat = (lat2 - lat1) * Math.PI / 180;
      var dLng = (lng2 - lng1) * Math.PI / 180;
      var a = Math.sin(dLat / 2) * Math.sin(dLat / 2)
            + Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180)
            * Math.sin(dLng / 2) * Math.sin(dLng / 2);
      return 2 * R * Math.asin(Math.min(1, Math.sqrt(a)));
    }

    // Geocode any Australian-anchored query (postcode, suburb, town) to
    // lat/lng + a short display label via Nominatim (OpenStreetMap).
    // Cached in memory so repeat searches are instant. Falls back to
    // null on failure — caller treats null as "fall back to text
    // contains-match".
    function geocodeQuery(q) {
      var key = q.toLowerCase().trim();
      if (geocodeCache[key] !== undefined) return Promise.resolve(geocodeCache[key]);
      // countrycodes=au is the documented Nominatim way to constrain by
      // country (ISO 3166-1 alpha-2). The country=Australia param turns
      // out to be unreliable — returns empty for "bendigo" alone.
      var url = 'https://nominatim.openstreetmap.org/search?countrycodes=au&q='
              + encodeURIComponent(q) + '&format=json&limit=1';
      return fetch(url, { headers: { 'Accept': 'application/json' } })
        .then(function (r) { return r.ok ? r.json() : []; })
        .then(function (arr) {
          if (!arr || !arr[0]) { geocodeCache[key] = null; return null; }
          var first = arr[0];
          var label = String(first.display_name || '').split(',')[0].trim() || q;
          var result = {
            center: { lat: parseFloat(first.lat), lng: parseFloat(first.lon) },
            label: label,
          };
          geocodeCache[key] = result;
          return result;
        })
        .catch(function () { geocodeCache[key] = null; return null; });
    }

    function clearRadiusOverlay() {
      if (radiusOverlay && map) { map.removeLayer(radiusOverlay); }
      radiusOverlay = null;
    }
    function drawRadiusOverlay(center, radiusKm) {
      if (!map || !window.L) return;
      clearRadiusOverlay();
      radiusOverlay = L.circle([center.lat, center.lng], {
        radius: radiusKm * 1000,
        color: '#5D3A7A',
        weight: 1.5,
        dashArray: '4 4',
        fillColor: '#E8DEEF',
        fillOpacity: 0.15,
        interactive: false,
      }).addTo(map);
    }

    function setRadiusInfo(text) {
      if (!radiusInfoNode) return;
      if (text) {
        radiusInfoNode.textContent = text;
        radiusInfoNode.hidden = false;
      } else {
        radiusInfoNode.textContent = '';
        radiusInfoNode.hidden = true;
      }
    }

    // Routing: any query of 3+ characters tries Nominatim geocode first
    // (works for postcodes AND town/suburb names — the input placeholder
    // promises both). On a hit we radius-search 80 km from the geocoded
    // point, sorted by distance ascending. On a miss we fall back to a
    // text contains-match against shop name / suburb / postcode. Empty
    // and very short queries (1-2 chars) skip geocoding to avoid noisy
    // matches and keep us under Nominatim's 1-req/sec policy.
    function applyFilters() {
      var st = stateFilter ? stateFilter.value : 'all';
      var q = (searchInput && searchInput.value || '').trim();

      if (q.length >= 3) {
        geocodeQuery(q).then(function (geo) {
          if (geo && geo.center) {
            applyRadiusFilter(st, geo.center, RADIUS_KM, geo.label || q);
          } else {
            applyTextFilter(st, q.toLowerCase());
          }
        });
        return;
      }

      applyTextFilter(st, q.toLowerCase());
    }

    function applyTextFilter(st, qLower) {
      clearRadiusOverlay();
      setRadiusInfo('');
      var filtered = stockists.filter(function (s) {
        if (st !== 'all' && s.state !== st) return false;
        if (qLower) {
          var hay = (s.shop_name + ' ' + s.suburb + ' ' + s.postcode).toLowerCase();
          if (hay.indexOf(qLower) === -1) return false;
        }
        return true;
      });
      filtered.sort(sortAlpha);
      render(filtered);
      renderMarkers(filtered);
    }

    function applyRadiusFilter(st, center, radiusKm, label) {
      drawRadiusOverlay(center, radiusKm);
      var withDist = stockists
        .filter(function (s) { return st === 'all' || s.state === st; })
        .map(function (s) {
          var lat = parseFloat(s.latitude), lng = parseFloat(s.longitude);
          if (!isFinite(lat) || !isFinite(lng)) return null;
          return { s: s, d: haversineKm(center.lat, center.lng, lat, lng) };
        })
        .filter(function (x) { return x && x.d <= radiusKm; })
        .sort(function (a, b) { return a.d - b.d; });
      var filtered = withDist.map(function (x) { return x.s; });
      var n = filtered.length;
      var msg = n === 0
        ? 'No stockists within ' + radiusKm + ' km of ' + label + '.'
        : 'Showing ' + n + ' stockist' + (n === 1 ? '' : 's') + ' within ' + radiusKm + ' km of ' + label + '.';
      setRadiusInfo(msg);
      render(filtered);
      // In radius mode we suppress renderMarkers' own auto-fly and frame
      // the map to the full radius circle instead — that way the user
      // sees the search-area scale, not just the matched markers.
      renderMarkers(filtered, { skipFly: true });
      if (map && radiusOverlay) {
        map.flyToBounds(radiusOverlay.getBounds(), { padding: [30, 30], duration: 0.6 });
      }
    }

    // ===== Leaflet map =====

    // Wait for the deferred /assets/leaflet.js to expose window.L. Polling
    // beats DOMContentLoaded here because Dawn concatenates section JS into
    // a bundle whose execution order vs. <script defer> tags is brittle.
    function ensureLeaflet(cb) {
      if (window.L) { cb(); return; }
      var n = 0, max = 100; // 5s at 50ms
      var t = setInterval(function () {
        if (window.L) { clearInterval(t); cb(); return; }
        if (++n > max) { clearInterval(t); console.warn('[stockists] Leaflet failed to load'); }
      }, 50);
    }

    function buildMarkerIcon(type) {
      return L.divIcon({
        className: '',
        html: '<div class="theinmag-stockists__marker" data-type="' + escapeHtml(type) + '"></div>',
        iconSize: [28, 28],
        iconAnchor: [14, 14],
        popupAnchor: [0, -14],
      });
    }

    function popupHtml(s) {
      var line2 = [s.suburb, s.state, s.postcode].filter(Boolean).map(escapeHtml).join(' ');
      var lines = [escapeHtml(s.street_address || ''), line2].filter(Boolean);
      return (
        '<span class="theinmag-popup__name">' + escapeHtml(s.shop_name) + '</span>' +
        '<span class="theinmag-popup__addr">' + lines.join('<br>') + '</span>'
      );
    }

    function initMap() {
      if (map || !mapEl) return;
      map = L.map(mapEl, {
        zoomControl: true,
        scrollWheelZoom: true,
        attributionControl: true,
      }).fitBounds(AU_BOUNDS);
      L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
        subdomains: 'abcd',
        maxZoom: 19,
      }).addTo(map);
    }

    function clearMarkers() {
      Object.keys(markerByStockistId).forEach(function (id) {
        var m = markerByStockistId[id];
        if (m && map) map.removeLayer(m);
        delete markerByStockistId[id];
      });
    }

    function renderMarkers(list, opts) {
      if (!map) return; // first call may run before Leaflet is ready
      opts = opts || {};
      clearMarkers();
      var bounds = [];
      list.forEach(function (s) {
        var lat = parseFloat(s.latitude);
        var lng = parseFloat(s.longitude);
        if (!isFinite(lat) || !isFinite(lng)) return;
        var m = L.marker([lat, lng], { icon: buildMarkerIcon(s.type) }).addTo(map);
        m.bindPopup(popupHtml(s));
        m.on('click', function () { activateStockist(s.id, { fromMap: true }); });
        markerByStockistId[s.id] = m;
        bounds.push([lat, lng]);
      });
      if (opts.skipFly) return;
      if (!bounds.length) return; // filter cleared everything; keep prior view
      if (bounds.length === 1) {
        map.flyTo(bounds[0], Math.max(map.getZoom(), 9), { duration: 0.6 });
      } else {
        map.flyToBounds(bounds, { padding: [40, 40], maxZoom: 12, duration: 0.6 });
      }
    }

    function activateStockist(id, opts) {
      opts = opts || {};
      // Highlight card
      if (listNode) {
        var cards = listNode.querySelectorAll('.theinmag-stockists__card');
        cards.forEach(function (c) {
          c.classList.toggle('is-active', c.getAttribute('data-stockist-id') === id);
        });
        var activeCard = listNode.querySelector('[data-stockist-id="' + id + '"]');
        if (activeCard && !opts.fromCard) {
          activeCard.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        }
      }
      // Highlight marker dot
      Object.keys(markerByStockistId).forEach(function (mid) {
        var m = markerByStockistId[mid];
        var iconEl = m && m.getElement && m.getElement();
        var dot = iconEl && iconEl.querySelector('.theinmag-stockists__marker');
        if (dot) dot.classList.toggle('is-active', mid === id);
      });
      // From-card click flies + opens popup; from-map click only highlights
      // (popup opens via Leaflet's own click handler).
      if (opts.fromCard) {
        var marker = markerByStockistId[id];
        if (marker && map) {
          map.flyTo(marker.getLatLng(), Math.max(map.getZoom(), 9), { duration: 0.6 });
          marker.openPopup();
        }
      }
    }

    // Card click → activate (skip inner link/button clicks so Maps/IG/etc.
    // still work)
    if (listNode) {
      listNode.addEventListener('click', function (e) {
        if (e.target.closest('a, button')) return;
        var card = e.target.closest('.theinmag-stockists__card');
        if (!card) return;
        var id = card.getAttribute('data-stockist-id');
        if (id) activateStockist(id, { fromCard: true });
      });
    }

    if (stateFilter) stateFilter.addEventListener('change', applyFilters);
    if (searchInput) searchInput.addEventListener('input', function () {
      // Debounce to keep us under Nominatim's 1-req/sec policy when the
      // user types a postcode digit-by-digit, and to avoid jittery UI on
      // text searches.
      clearTimeout(searchDebounce);
      searchDebounce = setTimeout(applyFilters, 300);
    });

    applyFilters();

    ensureLeaflet(function () {
      initMap();
      applyFilters(); // re-run so renderMarkers paints onto the now-ready map
    });

    // (The "Become a stockist" CTA is a plain <a href> to
    // /pages/become-a-stockist now — no JS needed. The sibling
    // theinmag-stockists-modal section is no longer used by this page
    // but its file remains for any future modal-style use.)
  })();
{%- endjavascript -%}

{% schema %}
{
  "name": "Stockists hero",
  "tag": "section",
  "class": "shopify-section--theinmag-stockists",
  "settings": []
}
{% endschema %}
