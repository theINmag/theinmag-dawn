{%- comment -%}
  theinmag-newsletter-page
  Hero section of /pages/newsletter. Lavender pair, e-mag cover tilted
  left of the form, sitewide kid-character pool slot peeking from behind
  the cover. Posts to Klaviyo list SMGVLB via the client subscription
  API (same flow as theinmag-flyout-newsletter). TEST_MODE in
  assets/theinmag-newsletter-page.js stays true until launch.

  Composed below in templates/page.newsletter.json with the "what's IN
  it" trio (theinmag-newsletter-whats-in) and the reused press band.

  Assets used: e-mag_cover.jpg.
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading
  assign subhead = section.settings.subhead
  assign button_text = section.settings.button_text
  assign success_heading = section.settings.success_heading
  assign success_body = section.settings.success_body
  assign trust_microcopy = section.settings.trust_microcopy

  capture in_span
    echo '<span class="theinmag-in">IN</span>'
  endcapture
  assign heading_html = heading | replace: 'IN', in_span
  # Subhead stays plain text - the oversized .theinmag-in lift is
  # Post-font only (per feedback_enlarged_in_post_font_only memory).
  # Inter body copy keeps IN at normal size in caps.
  assign subhead_html = subhead

  assign section_style = '--nlh-pt: ' | append: section.settings.padding_top | append: 'px; --nlh-pb: ' | append: section.settings.padding_bottom | append: 'px;'
-%}

{%- comment -%} Render the sitewide character pool once for this page. {%- endcomment -%}
{% render 'theinmag-character-pool' %}

<section
  class="theinmag-newsletter-hero"
  data-theinmag-newsletter-page
  data-klaviyo-public-key="QT6Qj3"
  data-klaviyo-list-id="SMGVLB"
  aria-labelledby="theinmag-newsletter-hero-heading"
  style="{{ section_style }}"
>
  {% render 'theinmag-section-bg', opacity: 0.28 %}

  <div class="theinmag-newsletter-hero__inner">
    <div class="theinmag-newsletter-hero__media">
      <img
        class="theinmag-newsletter-hero__cover"
        src="{{ 'e-mag_cover.jpg' | asset_url }}"
        alt="The free theINmag e-mag cover, made by Aussie kids."
        width="320"
        height="430"
        loading="eager"
        fetchpriority="high"
      >
    </div>

    <div class="theinmag-newsletter-hero__copy">
      {%- if heading != blank -%}
        <h1 id="theinmag-newsletter-hero-heading" class="theinmag-newsletter-hero__heading">
          {{ heading_html }}
        </h1>
      {%- endif -%}

      {%- if subhead != blank -%}
        <p class="theinmag-newsletter-hero__subhead">{{ subhead_html }}</p>
      {%- endif -%}

      <div class="theinmag-newsletter-hero__form-state" data-theinmag-newsletter-form-state>
        <form class="theinmag-newsletter-hero__form" data-theinmag-newsletter-form novalidate>
          <label class="theinmag-newsletter-hero__visually-hidden" for="theinmag-newsletter-first-name">First name (optional)</label>
          <input
            type="text"
            id="theinmag-newsletter-first-name"
            name="first_name"
            class="theinmag-newsletter-hero__input"
            placeholder="First name (optional)"
            autocomplete="given-name"
          >

          <label class="theinmag-newsletter-hero__visually-hidden" for="theinmag-newsletter-email">Your email</label>
          <input
            type="email"
            id="theinmag-newsletter-email"
            name="email"
            class="theinmag-newsletter-hero__input"
            placeholder="Your email"
            autocomplete="email"
            required
            aria-describedby="theinmag-newsletter-error"
          >

          <div class="theinmag-newsletter-hero__form-footer">
            {%- if trust_microcopy != blank -%}
              <p class="theinmag-newsletter-hero__fineprint">{{ trust_microcopy }}</p>
            {%- endif -%}

            <button
              type="submit"
              class="theinmag-btn theinmag-btn--primary theinmag-newsletter-hero__submit"
              data-theinmag-newsletter-submit
              aria-label="{{ button_text | escape }}"
            >
              <svg
                class="theinmag-newsletter-hero__submit-icon"
                width="22"
                height="22"
                viewBox="0 0 24 24"
                aria-hidden="true"
                focusable="false"
              >
                <path
                  d="M3 11.5 21 3l-6 18-3.6-7.4L3 11.5z"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linejoin="round"
                  stroke-linecap="round"
                />
              </svg>
            </button>
          </div>

          <p
            class="theinmag-newsletter-hero__error"
            id="theinmag-newsletter-error"
            data-theinmag-newsletter-error
            hidden
          ></p>
        </form>
      </div>

      <div
        class="theinmag-newsletter-hero__success-state"
        data-theinmag-newsletter-success-state
        hidden
        aria-live="polite"
      >
        <h2 class="theinmag-newsletter-hero__success-heading">{{ success_heading }}</h2>
        <p class="theinmag-newsletter-hero__success-body">{{ success_body }}</p>
      </div>
    </div>
  </div>

  {%- comment -%}
    Kid character peeks IN from the right edge of the section.
    Sits outside the .__inner grid so it can clip the right edge
    via the section's overflow:hidden. Hidden on mobile so it
    doesn't overlap the stacked form.
  {%- endcomment -%}
  <span
    class="theinmag-newsletter-hero__character"
    data-theinmag-pool-character
    aria-hidden="true"
  ></span>
</section>

<script src="{{ 'theinmag-newsletter-page.js' | asset_url }}" defer></script>

{%- comment -%} Page-level JSON-LD - BreadcrumbList + WebPage {%- endcomment -%}
{%- assign page_origin = request.origin | default: 'https://theinmag.com.au' -%}
{%- assign page_url = page_origin | append: '/pages/newsletter' -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": {{ page_origin | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Newsletter",
        "item": {{ page_url | json }}
      }
    ]
  }
</script>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": {{ heading | default: 'The FREE e-mag, IN your inbox.' | json }},
    "description": {{ subhead | strip_newlines | default: 'Plus a monthly hit of kid creativity, straight to your INbox.' | json }},
    "url": {{ page_url | json }},
    "mainEntityOfPage": {{ page_url | json }},
    "isPartOf": {
      "@type": "WebSite",
      "name": "theINmag",
      "url": {{ page_origin | json }}
    }
  }
</script>

{%- stylesheet -%}
  /* ================================================================
     theinmag-newsletter-hero
     Lavender pair (purple) hero. e-mag cover left, form right.
     Sticker-stack with the character pool peeking from behind the
     cover. Section-bg snippet adds the watercolour texture layer.
     ================================================================ */

  .theinmag-newsletter-hero {
    background-color: var(--color-lavender, #E8DEEF);
    color: var(--color-inky-purple-navy, #2A1F3D);
    padding: var(--nlh-pt, 72px) clamp(16px, 4vw, 32px) var(--nlh-pb, 96px);
    position: relative;
    overflow: hidden;
    min-height: clamp(560px, 72vh, 760px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .theinmag-newsletter-hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
  }

  @media (min-width: 750px) {
    .theinmag-newsletter-hero__inner {
      grid-template-columns: minmax(260px, 380px) 1fr;
    }
  }

  /* --- Media column: e-mag cover + character peek --- */

  .theinmag-newsletter-hero__media {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 0;
  }

  .theinmag-newsletter-hero__cover {
    position: relative;
    z-index: 2;
    width: clamp(200px, 44vw, 320px);
    height: auto;
    border-radius: 6px;
    box-shadow:
      0 18px 44px rgba(42, 31, 61, 0.22),
      0 6px 14px rgba(42, 31, 61, 0.14);
    transform: rotate(-3.5deg);
  }

  /* Kid character sits in the right gutter of the section, fully
     visible (not clipped) and sized as a small accent so the form
     stays the focus. Pool snippet handles the random pick + bob. */
  .theinmag-newsletter-hero__character {
    position: absolute;
    z-index: 2;
    right: clamp(20px, 3vw, 64px);
    bottom: clamp(48px, 6vw, 104px);
    width: clamp(108px, 13vw, 160px);
    height: auto;
    display: block;
    pointer-events: none;
  }

  @media (max-width: 749px) {
    /* Stacked layout on mobile - character would overlap the form,
       so hide it. Sitewide pattern (mission section also hides on
       mobile per the design system §5.1). */
    .theinmag-newsletter-hero__character {
      display: none;
    }
  }

  /* --- Copy column --- */

  .theinmag-newsletter-hero__copy {
    text-align: center;
  }

  @media (min-width: 750px) {
    .theinmag-newsletter-hero__copy {
      text-align: left;
    }
  }

  .theinmag-newsletter-hero__heading {
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-size: clamp(36px, 6.4vw, 60px);
    line-height: 1.04;
    margin: 0 0 clamp(10px, 1.4vw, 16px);
    color: var(--color-purple-dark, #5D3A7A);
    text-wrap: balance;
  }

  .theinmag-newsletter-hero__subhead {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 500;
    font-size: clamp(16px, 1.6vw, 19px);
    line-height: 1.45;
    margin: 0 0 clamp(22px, 2.6vw, 30px);
    color: var(--color-inky-purple-navy, #2A1F3D);
    max-width: 44ch;
    /* Honour admin line breaks - same pattern as the homepage hero
       headline (per design-system §6.1). Lets the template split the
       subhead at the comma without an HTML <br>. */
    white-space: pre-line;
  }

  /* Editorial hang indent on desktop: heading stays flush to the
     column edge, body block (subhead + form + success state) tucks
     in slightly so the headline reads as a pull-out. Mobile keeps
     everything centred. */
  @media (min-width: 750px) {
    .theinmag-newsletter-hero__subhead,
    .theinmag-newsletter-hero__form-state,
    .theinmag-newsletter-hero__success-state {
      margin-left: clamp(14px, 1.4vw, 24px);
    }
  }

  @media (max-width: 749px) {
    .theinmag-newsletter-hero__subhead {
      margin-inline: auto;
    }
  }

  /* --- Form --- */

  .theinmag-newsletter-hero__form {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    max-width: 460px;
    margin: 0 auto;
  }

  @media (min-width: 750px) {
    .theinmag-newsletter-hero__form {
      margin: 0;
    }
  }

  .theinmag-newsletter-hero__input {
    width: 100%;
    padding: 13px 16px;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-size: 16px;
    line-height: 1.4;
    color: var(--color-inky-purple-navy, #2A1F3D);
    background: #FFFFFF;
    border: 1.5px solid rgba(93, 58, 122, 0.32);
    border-radius: 10px;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .theinmag-newsletter-hero__input:focus {
    outline: none;
    border-color: var(--color-purple-dark, #5D3A7A);
    box-shadow: 0 0 0 3px rgba(93, 58, 122, 0.18);
  }

  .theinmag-newsletter-hero__input[aria-invalid="true"] {
    border-color: #B33A3A;
  }

  /* Form footer: fineprint on the left, icon-only submit on the
     right - the button's right edge lines up with the email field's
     right edge because the row sits inside the same 460px-capped
     .__form grid track. */
  .theinmag-newsletter-hero__form-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 2px;
  }

  /* Icon-only submit as a circle. Sized to match the email input
     height so it sits in line with the field's bottom edge. */
  .theinmag-newsletter-hero__submit {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    aspect-ratio: 1;
  }

  .theinmag-newsletter-hero__submit-icon {
    display: block;
    flex: none;
  }

  .theinmag-newsletter-hero__submit:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .theinmag-newsletter-hero__error {
    margin: 4px 0 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-size: 14px;
    color: #B33A3A;
  }

  .theinmag-newsletter-hero__fineprint {
    margin: 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-size: 13px;
    line-height: 1.4;
    color: rgba(42, 31, 61, 0.65);
    letter-spacing: 0.01em;
  }

  /* --- Success state --- */

  .theinmag-newsletter-hero__success-heading {
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-size: clamp(28px, 4.6vw, 40px);
    line-height: 1.1;
    margin: 0 0 12px;
    color: var(--color-purple-dark, #5D3A7A);
  }

  .theinmag-newsletter-hero__success-body {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-size: clamp(15px, 1.4vw, 17px);
    line-height: 1.5;
    margin: 0;
    color: var(--color-inky-purple-navy, #2A1F3D);
  }

  .theinmag-newsletter-hero__visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-newsletter-hero__input { transition: none; }
    .theinmag-newsletter-hero__cover { transform: none; }
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "theINmag Newsletter hero",
  "tag": "section",
  "class": "theinmag-newsletter-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "The FREE e-mag, IN your inbox.",
      "info": "Wrap the brand-pun IN by writing it in capitals - section will style it automatically."
    },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Subhead",
      "default": "Plus a monthly hit of kid creativity,\nstraight to your INbox.",
      "info": "Press Enter to force a line break."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Submit button text",
      "default": "Send IN my e-mag"
    },
    {
      "type": "text",
      "id": "trust_microcopy",
      "label": "Trust microcopy",
      "default": "Unsubscribe anytime"
    },
    {
      "type": "header",
      "content": "Success state"
    },
    {
      "type": "text",
      "id": "success_heading",
      "label": "Success heading",
      "default": "You're IN!"
    },
    {
      "type": "textarea",
      "id": "success_body",
      "label": "Success body",
      "default": "Your e-mag is on its way. Get cosy and have a flick through."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "theINmag Newsletter hero"
    }
  ]
}
{% endschema %}
