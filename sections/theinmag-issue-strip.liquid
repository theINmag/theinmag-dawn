{%- comment -%}
  theinmag-issue-strip
  Horizontal navigation strip for the top of the product page. Each
  tile links straight to that product's page - this is the old
  single-mags picker reimagined as honest navigation (real URLs, one
  product per page, no in-page content swapping).

  Order (Ryan's call, revised 2026-08-12: stack promoted from last to
  second - the best-margin product was buried at the end of the row):
    1. Membership
    2. Digital Stack
    3. Snack Pack
    4. Pre-sale magazine(s) - the is_pre_order one(s)
    5. The rest of the magazines, newest-first

  Rendered in five filtered passes rather than one re-sorted array -
  slice/where/concat on product arrays proved unreliable, so each pass
  is a plain filtered loop. Bundles are told apart from magazines by
  is_pre_order OR a positive issue_number (Mag10's issue_number can be
  blank during pre-sale, so is_pre_order is the reliable mag signal);
  Snack Pack has a Print variant, Digital Stack does not.

  The current product's tile is highlighted - bigger, rectangular,
  bold label - so you can see the whole cover of the one you're on.
{%- endcomment -%}

{%- liquid
  assign issues_collection_handle = section.settings.issues_collection | default: 'single-issues'
  assign issues = collections[issues_collection_handle].products
  # Shopify's `sort` filter can't traverse the deep metafield path
  # `metafields.single_mag.issue_number.value` - it resolves as nil so the
  # sort silently no-ops, leaving raw collection order (the magazines came
  # out unordered). Build a zero-padded numeric sort key per product and
  # sort the key strings instead (fixed 3-digit width => string sort ==
  # numeric). The five passes below filter this ordered handle list; pass 4
  # (the rest of the magazines) relies on it for newest-first order.
  assign sort_keys = ''
  for issue in issues
    assign iss_num = issue.metafields.single_mag.issue_number.value | default: 0
    assign shifted = iss_num | plus: 100
    if shifted < 100
      assign padded = '0' | append: shifted
    else
      assign padded = shifted
    endif
    assign sort_keys = sort_keys | append: padded | append: '~' | append: issue.handle | append: ','
  endfor
  assign sort_keys = sort_keys | split: ',' | sort | reverse
  assign sorted_handles = ''
  for sk in sort_keys
    assign sk_parts = sk | split: '~'
    if sk_parts.size > 1
      assign sorted_handles = sorted_handles | append: sk_parts[1] | append: ','
    endif
  endfor
  assign sorted_handles = sorted_handles | split: ','
  assign membership_product = all_products[section.settings.membership_handle]
  assign section_style = '--tmis-pt: ' | append: section.settings.padding_top | append: 'px; --tmis-pb: ' | append: section.settings.padding_bottom | append: 'px;'

  # Dark-shelf style (2026-08-11, Ryan's concept 3): the strip becomes an
  # inky gallery band - white-framed covers with a slight scatter, labels
  # in white, digital tiles undimmed, and the Digital Stack rendered as a
  # fanned end-cap with a yellow value sticker. Default stays "classic" so
  # the single-issue PDPs are untouched until Ryan flips them; only the
  # membership template sets style: shelf.
  assign strip_style = section.settings.style | default: 'classic'

  # Fan end-cap data: the three newest real magazines' covers (sorted_handles
  # is already newest-first) plus the issue count for the sticker copy.
  assign fan_urls = ''
  assign stack_issue_count = 0
  if strip_style == 'shelf'
    for sorted_handle in sorted_handles
      assign fan_issue = issues | where: 'handle', sorted_handle | first
      if fan_issue == blank
        continue
      endif
      assign fan_inum = fan_issue.metafields.single_mag.issue_number.value | default: 0
      if fan_inum > 0
        assign stack_issue_count = stack_issue_count | plus: 1
        if stack_issue_count <= 3 and fan_issue.featured_image != blank
          assign fan_one = fan_issue.featured_image | image_url: width: 280
          if fan_urls == blank
            assign fan_urls = fan_one
          else
            assign fan_urls = fan_urls | append: '|' | append: fan_one
          endif
        endif
      endif
    endfor
  endif
  assign fan_covers = fan_urls | split: '|'
-%}

{%- if sorted_handles.size > 0 -%}
<section
  class="theinmag-issue-strip{% if strip_style == 'shelf' %} theinmag-issue-strip--shelf{% endif %}"
  style="{{ section_style }}"
  aria-label="Browse theINmag issues"
  data-active-format="Print"
  data-theinmag-issue-strip
>
  <div class="theinmag-issue-strip__inner">
    {%- comment -%}
      Heading + subline share one centred row (Ryan, 2026-08-12: the
      stacked pair made the dark band too tall). Wraps naturally on
      narrow screens.
    {%- endcomment -%}
    <div class="theinmag-issue-strip__head">
      {%- if section.settings.heading != blank -%}
        <p class="theinmag-issue-strip__heading">{{ section.settings.heading }}</p>
      {%- endif -%}
      {%- if strip_style == 'shelf' and section.settings.subline != blank -%}
        <p class="theinmag-issue-strip__subline">{{ section.settings.subline }}</p>
      {%- endif -%}
    </div>
    <ol class="theinmag-issue-strip__list" role="list">
      {%- comment -%} 1. Membership {%- endcomment -%}
      {%- if membership_product != blank -%}
        {%- render 'theinmag-issue-strip-tile', product: membership_product, current_handle: product.handle -%}
      {%- endif -%}

      {%- comment -%} 2. Digital Stack - bundle (not pre-order, no positive issue number) with NO Print variant {%- endcomment -%}
      {%- for sorted_handle in sorted_handles -%}
        {%- assign issue = issues | where: 'handle', sorted_handle | first -%}
        {%- if issue == blank -%}{%- continue -%}{%- endif -%}
        {%- liquid
          assign inum = issue.metafields.single_mag.issue_number.value | default: 0
          assign is_pre = issue.metafields.theinmag.is_pre_order | default: false
          assign has_print = false
          for v in issue.variants
            if v.option1 == 'Print'
              assign has_print = true
            endif
          endfor
        -%}
        {%- if is_pre == false and inum <= 0 and has_print == false -%}
          {%- if strip_style == 'shelf' and fan_covers.size > 0 -%}
            {%- comment -%}
              Shelf mode: the Digital Stack stops being a dimmed tile and
              becomes a fanned end-cap of the three newest covers with a
              yellow value sticker. Count + price read live from the
              product so the sticker survives the $65 price change and
              each new drop without a theme edit.
            {%- endcomment -%}
            <li class="theinmag-issue-strip__item theinmag-issue-strip__item--stack{% if issue.handle == product.handle %} is-current{% endif %}">
              <a class="theinmag-issue-strip__link" href="{{ issue.url }}" {% if issue.handle == product.handle %}aria-current="page"{% endif %}>
                <span class="theinmag-issue-strip__fan" aria-hidden="true">
                  {%- for fan_src in fan_covers reversed -%}
                    <img class="theinmag-issue-strip__fan-img theinmag-issue-strip__fan-img--{{ forloop.index }}" src="{{ fan_src }}" alt="" loading="lazy" width="100" height="130">
                  {%- endfor -%}
                  <span class="theinmag-issue-strip__fan-badge">All {{ stack_issue_count }}<br>{{ issue.price | money_without_trailing_zeros }}</span>
                </span>
                <span class="theinmag-issue-strip__label theinmag-issue-strip__label--stack">Digital Stack</span>
              </a>
            </li>
          {%- else -%}
            {%- render 'theinmag-issue-strip-tile', product: issue, current_handle: product.handle -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%} 3. Snack Pack - bundle (not pre-order, no positive issue number) WITH a Print variant {%- endcomment -%}
      {%- for sorted_handle in sorted_handles -%}
        {%- assign issue = issues | where: 'handle', sorted_handle | first -%}
        {%- if issue == blank -%}{%- continue -%}{%- endif -%}
        {%- liquid
          assign inum = issue.metafields.single_mag.issue_number.value | default: 0
          assign is_pre = issue.metafields.theinmag.is_pre_order | default: false
          assign has_print = false
          for v in issue.variants
            if v.option1 == 'Print'
              assign has_print = true
            endif
          endfor
        -%}
        {%- if is_pre == false and inum <= 0 and has_print -%}
          {%- render 'theinmag-issue-strip-tile', product: issue, current_handle: product.handle -%}
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%} 4. Pre-sale magazine(s) {%- endcomment -%}
      {%- for sorted_handle in sorted_handles -%}
        {%- assign issue = issues | where: 'handle', sorted_handle | first -%}
        {%- if issue == blank -%}{%- continue -%}{%- endif -%}
        {%- assign is_pre = issue.metafields.theinmag.is_pre_order | default: false -%}
        {%- if is_pre -%}
          {%- render 'theinmag-issue-strip-tile', product: issue, current_handle: product.handle -%}
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%} 5. The rest of the magazines, newest-first {%- endcomment -%}
      {%- for sorted_handle in sorted_handles -%}
        {%- assign issue = issues | where: 'handle', sorted_handle | first -%}
        {%- if issue == blank -%}{%- continue -%}{%- endif -%}
        {%- liquid
          assign inum = issue.metafields.single_mag.issue_number.value | default: 0
          assign is_pre = issue.metafields.theinmag.is_pre_order | default: false
        -%}
        {%- if is_pre == false and inum > 0 -%}
          {%- render 'theinmag-issue-strip-tile', product: issue, current_handle: product.handle -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if strip_style == 'shelf' -%}
        {%- liquid
          # Shelf buddy (Ryan, 2026-08-12 v2): a NEW kid character every
          # page load, like the sitewide pool. Liquid alone cannot do
          # per-visit randomness under Shopify's full-page cache, so the
          # section emits SIX candidate URLs (spread through the 53-strong
          # pool from an epoch seed) and the section JS random-picks one
          # per load. The server-rendered src is candidate 1, so no-JS
          # visitors still get a character.
          assign buddy_seed = 'now' | date: '%s' | times: 1
          assign buddy_pool = ''
          for bi in (0..5)
            assign buddy_index = bi | times: 9 | plus: buddy_seed | modulo: 53 | plus: 1
            assign buddy_filename = 'character-' | append: buddy_index | append: '.png'
            assign buddy_one = buddy_filename | asset_url
            if buddy_pool == blank
              assign buddy_pool = buddy_one
            else
              assign buddy_pool = buddy_pool | append: '|' | append: buddy_one
            endif
          endfor
          assign buddy_first = buddy_pool | split: '|' | first
        -%}
        <li class="theinmag-issue-strip__item theinmag-issue-strip__buddy" aria-hidden="true" data-buddy-pool="{{ buddy_pool | escape }}">
          <img class="theinmag-issue-strip__buddy-img" data-buddy-img src="{{ buddy_first }}" alt="" width="52" height="52">
        </li>
      {%- endif -%}
    </ol>
  </div>
</section>
{%- endif -%}

{% stylesheet %}
  .theinmag-issue-strip {
    background-color: #FFFFFF;
    padding: var(--tmis-pt, 24px) var(--space-lg) var(--tmis-pb, 24px);
    overflow-x: hidden;
  }

  .theinmag-issue-strip__inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .theinmag-issue-strip__heading {
    margin: 0 0 10px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-inky-purple-navy);
    text-align: center;
  }

  .theinmag-issue-strip__list {
    list-style: none;
    margin: 0;
    /* 12px top padding accommodates the current-tile outline (3px + 2px offset
       = 5px above the cover) plus the 2px hover translateY lift, with buffer.
       Without it overflow-x:auto silently clips overflow-y too and the pink
       frame loses its top edge. */
    padding: 12px 4px 4px;
    display: flex;
    flex-wrap: nowrap;
    align-items: flex-start;
    gap: var(--space-sm);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .theinmag-issue-strip__list::-webkit-scrollbar { display: none; }

  /* Desktop: keep the row centred when it fits, scroll when it doesn't
     (no clipped start), and never wrap to a second line. */
  @media (min-width: 750px) {
    .theinmag-issue-strip__list {
      width: max-content;
      max-width: 100%;
      margin-inline: auto;
    }
  }

  .theinmag-issue-strip__item {
    flex: 0 0 auto;
    scroll-snap-align: start;
  }
  /* Current tile sits above neighbours so its pink frame can't be visually
     overlapped by an adjacent tile during hover lift. */
  .theinmag-issue-strip__item.is-current {
    position: relative;
    z-index: 2;
  }

  .theinmag-issue-strip__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    transition: transform 0.2s ease;
  }
  .theinmag-issue-strip__link:hover {
    transform: translateY(-2px);
  }

  /* Non-current tile: portrait thumbnail to match magazine cover aspect ratio.
     Bundles like Membership / Snack Pack / Digital Stack have squarer source
     images and get cropped to portrait by object-fit:cover. */
  .theinmag-issue-strip__cover {
    width: 62px;
    height: 82px;
    overflow: hidden;
    background-color: var(--color-cream);
    box-shadow: 0 2px 8px rgba(42, 31, 61, 0.10);
    display: block;
    transition: box-shadow 0.2s ease;
  }
  .theinmag-issue-strip__cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  /* Current tile: noticeably bigger + soft-pink frame as the "you're here"
     cue. Same portrait aspect ratio as inactive tiles for visual rhythm. */
  .theinmag-issue-strip__item.is-current .theinmag-issue-strip__cover {
    width: 92px;
    height: 122px;
    box-shadow: 0 4px 16px rgba(123, 79, 158, 0.30);
    outline: 3px solid var(--color-soft-pink);
    outline-offset: 2px;
  }

  /* Label: not bold by default, bold for the current product. */
  .theinmag-issue-strip__label {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 400;
    color: var(--color-inky-purple-navy);
    line-height: 1.1;
    text-align: center;
  }
  .theinmag-issue-strip__item.is-current .theinmag-issue-strip__label {
    font-weight: 700;
  }

  /* Pre-order sub-label - sits under the pre-sale issue's tile. Stacks the
     "Pre-order" tag over the drop date so the timing is clear from the strip. */
  .theinmag-issue-strip__presale {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    font-family: var(--font-body);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-purple-dark);
    line-height: 1;
  }
  .theinmag-issue-strip__presale-date {
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 0.04em;
    opacity: 0.75;
  }

  /* Print-sold-out single magazines + digital-only products: dimmed cover +
     label so the row reads "click in for Digital." Still fully clickable. */
  .theinmag-issue-strip__item.is-print-sold-out .theinmag-issue-strip__cover,
  .theinmag-issue-strip__item.is-digital-only .theinmag-issue-strip__cover {
    opacity: 0.45;
  }
  .theinmag-issue-strip__item.is-print-sold-out .theinmag-issue-strip__label,
  .theinmag-issue-strip__item.is-digital-only .theinmag-issue-strip__label {
    opacity: 0.6;
  }

  /* Digital-only sub-label - shown under tile when print is sold out OR product
     has no print variant. Same visual treatment as the pre-order chip. */
  .theinmag-issue-strip__digital-only {
    font-family: var(--font-body);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-purple-dark);
    line-height: 1;
  }

  /* Current-issue sub-label - flags the latest mag wherever the strip
     appears (keyed to the shop current_issue metafield, not the page). */
  .theinmag-issue-strip__current {
    font-family: var(--font-body);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-coral-dark);
    line-height: 1;
  }

  /* Digital cover image - hidden by default, revealed when the section is in
     Digital format mode AND the tile has a digital iPad-mockup available. */
  .theinmag-issue-strip__cover-img--digital {
    display: none;
  }
  .theinmag-issue-strip[data-active-format='Digital'] .theinmag-issue-strip__item[data-has-digital-media='true'] .theinmag-issue-strip__cover-img--print {
    display: none;
  }
  .theinmag-issue-strip[data-active-format='Digital'] .theinmag-issue-strip__item[data-has-digital-media='true'] .theinmag-issue-strip__cover-img--digital {
    display: block;
  }

  /* In Digital mode the sold-out / digital-only cues stop applying because
     Digital is always in stock. Restore full opacity + hide the sub-label. */
  .theinmag-issue-strip[data-active-format='Digital'] .theinmag-issue-strip__item.is-print-sold-out .theinmag-issue-strip__cover,
  .theinmag-issue-strip[data-active-format='Digital'] .theinmag-issue-strip__item.is-digital-only .theinmag-issue-strip__cover {
    opacity: 1;
  }
  .theinmag-issue-strip[data-active-format='Digital'] .theinmag-issue-strip__item.is-print-sold-out .theinmag-issue-strip__label,
  .theinmag-issue-strip[data-active-format='Digital'] .theinmag-issue-strip__item.is-digital-only .theinmag-issue-strip__label {
    opacity: 1;
  }
  .theinmag-issue-strip[data-active-format='Digital'] .theinmag-issue-strip__digital-only {
    display: none;
  }

  /* First-paint flash fix: <html data-theinmag-format="Digital"> is set by
     an inline <head> script reading sessionStorage BEFORE the picker
     renders. These rules mirror the .theinmag-issue-strip[data-active-format]
     rules above so the picker shows the right covers / opacity / sub-label
     from the very first paint, instead of flashing Print then swapping. */
  html[data-theinmag-format='Digital'] .theinmag-issue-strip__item[data-has-digital-media='true'] .theinmag-issue-strip__cover-img--print {
    display: none;
  }
  html[data-theinmag-format='Digital'] .theinmag-issue-strip__item[data-has-digital-media='true'] .theinmag-issue-strip__cover-img--digital {
    display: block;
  }
  html[data-theinmag-format='Digital'] .theinmag-issue-strip__item.is-print-sold-out .theinmag-issue-strip__cover,
  html[data-theinmag-format='Digital'] .theinmag-issue-strip__item.is-digital-only .theinmag-issue-strip__cover {
    opacity: 1;
  }
  html[data-theinmag-format='Digital'] .theinmag-issue-strip__item.is-print-sold-out .theinmag-issue-strip__label,
  html[data-theinmag-format='Digital'] .theinmag-issue-strip__item.is-digital-only .theinmag-issue-strip__label {
    opacity: 1;
  }
  html[data-theinmag-format='Digital'] .theinmag-issue-strip__digital-only {
    display: none;
  }

  @media (max-width: 480px) {
    .theinmag-issue-strip__cover {
      width: 48px;
      height: 64px;
    }
    .theinmag-issue-strip__item.is-current .theinmag-issue-strip__cover {
      width: 72px;
      height: 96px;
      outline-width: 2px;
    }
    .theinmag-issue-strip__label {
      font-size: 10px;
    }
    .theinmag-issue-strip__presale {
      font-size: 8px;
    }
  }

  /* ================================================================
     Dark shelf (style: shelf). The strip becomes an inky gallery band:
     Post heading in white, covers in white frames with a slight
     alternating scatter, current tile keeps the soft-pink frame, and
     nothing is dimmed - on a dark shelf a digital issue is a glowing
     cover, not a faded one. Scoped entirely under the modifier class so
     classic strips render byte-identically.
     ================================================================ */
  .theinmag-issue-strip--shelf {
    background-color: var(--color-inky-purple-navy);
  }
  .theinmag-issue-strip__head {
    display: flex;
    align-items: baseline;
    justify-content: center;
    flex-wrap: wrap;
    column-gap: 14px;
    row-gap: 2px;
  }
  .theinmag-issue-strip__head .theinmag-issue-strip__heading {
    margin: 0;
  }
  .theinmag-issue-strip--shelf .theinmag-issue-strip__heading {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(15px, 1.8vw, 19px);
    letter-spacing: 0.1em;
    text-transform: none;
    color: #FFFFFF;
  }
  .theinmag-issue-strip__subline {
    margin: 0;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.75);
    text-align: center;
  }
  .theinmag-issue-strip--shelf .theinmag-issue-strip__list {
    /* Tight: Ryan flagged the band as too tall. The 10px top still
       clears the current-tile outline + hover lift. 12px inline +
       scroll-padding stops the snap from pulling the first tile's pink
       outline outside the clip box on phones (it snapped 6px left and
       the frame's left edge vanished). */
    padding: 10px 12px 8px;
    gap: 10px;
    scroll-padding-inline: 12px;
  }
  .theinmag-issue-strip--shelf .theinmag-issue-strip__cover {
    background-color: #FFFFFF;
    padding: 3px;
    border-radius: 3px;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.35);
    box-sizing: content-box;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  /* Gallery scatter: gentle alternating tilt, straightened on hover and
     on the current tile so the "you are here" frame reads square. */
  .theinmag-issue-strip--shelf .theinmag-issue-strip__item:nth-child(odd) .theinmag-issue-strip__cover {
    transform: rotate(-2deg);
  }
  .theinmag-issue-strip--shelf .theinmag-issue-strip__item:nth-child(even) .theinmag-issue-strip__cover {
    transform: rotate(1.6deg);
  }
  .theinmag-issue-strip--shelf .theinmag-issue-strip__link:hover .theinmag-issue-strip__cover,
  .theinmag-issue-strip--shelf .theinmag-issue-strip__item.is-current .theinmag-issue-strip__cover {
    transform: rotate(0);
  }
  .theinmag-issue-strip--shelf .theinmag-issue-strip__item.is-current .theinmag-issue-strip__cover {
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.45);
    /* Slightly smaller "you are here" tile than classic (92x122): the
       dark band was reading too tall with the full-size bump. */
    width: 80px;
    height: 106px;
  }
  .theinmag-issue-strip--shelf .theinmag-issue-strip__label {
    color: #FFFFFF;
  }
  .theinmag-issue-strip--shelf .theinmag-issue-strip__current {
    color: var(--color-soft-pink);
  }
  .theinmag-issue-strip--shelf .theinmag-issue-strip__presale {
    color: var(--color-soft-pink);
  }
  .theinmag-issue-strip--shelf .theinmag-issue-strip__digital-only {
    color: rgba(255, 255, 255, 0.65);
  }
  /* Undim: a dark shelf never fades a cover. */
  .theinmag-issue-strip--shelf .theinmag-issue-strip__item.is-print-sold-out .theinmag-issue-strip__cover,
  .theinmag-issue-strip--shelf .theinmag-issue-strip__item.is-digital-only .theinmag-issue-strip__cover,
  .theinmag-issue-strip--shelf .theinmag-issue-strip__item.is-print-sold-out .theinmag-issue-strip__label,
  .theinmag-issue-strip--shelf .theinmag-issue-strip__item.is-digital-only .theinmag-issue-strip__label {
    opacity: 1;
  }

  /* Digital Stack fan end-cap. Sized off the base cover box (62x82,
     48x64 under 480px) so it scales with the rest of the row. */
  .theinmag-issue-strip__fan {
    position: relative;
    display: block;
    width: 96px;
    height: 96px;
  }
  .theinmag-issue-strip__fan-img {
    position: absolute;
    bottom: 0;
    width: 62px;
    height: 82px;
    object-fit: cover;
    object-position: top center;
    background-color: #FFFFFF;
    padding: 2px;
    border-radius: 3px;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.35);
    box-sizing: content-box;
  }
  /* Covers render reversed (oldest first) so the newest issue lands on
     top of the pile. --1 is the bottom of the fan, --3 the top. */
  .theinmag-issue-strip__fan-img--1 { left: 0; transform: rotate(-8deg); }
  .theinmag-issue-strip__fan-img--2 { left: 12px; bottom: 2px; transform: rotate(-1deg); }
  .theinmag-issue-strip__fan-img--3 { left: 26px; bottom: 1px; transform: rotate(7deg); }
  .theinmag-issue-strip__fan-badge {
    position: absolute;
    top: -2px;
    right: -4px;
    z-index: 2;
    background-color: var(--color-yellow);
    box-shadow: 0 2px 0 var(--color-yellow-shadow);
    color: var(--color-inky-purple-navy);
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 10px;
    line-height: 1.15;
    letter-spacing: 0.04em;
    text-align: center;
    padding: 5px 8px;
    border-radius: var(--radius-pill);
    transform: rotate(8deg);
  }
  .theinmag-issue-strip__label--stack {
    font-weight: 700;
  }
  .theinmag-issue-strip--shelf .theinmag-issue-strip__item--stack .theinmag-issue-strip__link:hover .theinmag-issue-strip__fan-img,
  .theinmag-issue-strip--shelf .theinmag-issue-strip__item--stack.is-current .theinmag-issue-strip__fan-img {
    transform: rotate(0);
  }

  /* Shelf buddy: kid character at the end of the row, vertically
     centred in the band (Ryan, 2026-08-12 round 2: bigger, centred).
     OVERLAP-PROOF BY CONSTRUCTION: it is a normal flex item in the
     row (never absolutely positioned), so at ANY viewport it occupies
     its own slot after Mag01 - tablets and phones scroll the row, they
     cannot push it over the covers. Keep it that way. */
  .theinmag-issue-strip__buddy {
    align-self: center;
    flex: 0 0 auto;
  }
  .theinmag-issue-strip__buddy-img {
    display: block;
    width: 76px;
    height: auto;
    animation: theinmag-strip-buddy-bob 4s ease-in-out infinite;
  }
  @keyframes theinmag-strip-buddy-bob {
    0%, 100% { transform: translateY(0) rotate(-2deg); }
    50% { transform: translateY(-4px) rotate(2deg); }
  }
  @media (max-width: 480px) {
    .theinmag-issue-strip__buddy-img { width: 56px; }
  }

  @media (max-width: 480px) {
    .theinmag-issue-strip__fan {
      width: 78px;
      height: 78px;
    }
    .theinmag-issue-strip__fan-img {
      width: 48px;
      height: 64px;
    }
    .theinmag-issue-strip__fan-img--2 { left: 10px; }
    .theinmag-issue-strip__fan-img--3 { left: 21px; }
    .theinmag-issue-strip__fan-badge {
      font-size: 9px;
      padding: 4px 7px;
    }
  }
{% endstylesheet %}

{% javascript %}
  /* Listen for the single-mags-hero Format toggle and mirror the active
     format onto each issue-strip section so the picker tiles can swap
     between print covers and iPad-mockup digital covers via CSS.

     The hero's toggle markup is:
       <div data-variant-group>
         <button data-variant-format="Print" aria-pressed="true">...</button>
         <button data-variant-format="Digital" aria-pressed="false">...</button>
       </div>

     We don't own that markup so we passively listen for clicks on it. If
     the hero isn't on the page (e.g. /products/membership which has its
     own picker but no single-mags-hero), there's nothing to listen for
     and the section stays in default "Print" mode. */
  (function () {
    function syncStrips(format) {
      var strips = document.querySelectorAll('[data-theinmag-issue-strip]');
      for (var i = 0; i < strips.length; i++) {
        strips[i].setAttribute('data-active-format', format);
      }
    }

    function init() {
      /* SHELF BUDDY: fresh character every page load (Ryan, 2026-08-12).
         Server renders candidate 1; JS re-rolls from the emitted pool so
         even a cached page shows a different kid per visit. */
      var buddyHosts = document.querySelectorAll('[data-buddy-pool]');
      for (var b = 0; b < buddyHosts.length; b++) {
        var pool = (buddyHosts[b].getAttribute('data-buddy-pool') || '').split('|');
        var img = buddyHosts[b].querySelector('[data-buddy-img]');
        if (img && pool.length > 1) {
          img.src = pool[Math.floor(Math.random() * pool.length)];
        }
      }

      /* MEMBERSHIP PAGE SYNC (2026-08-12). The membership page has no
         single-mags-hero, so the strip used to follow the sticky
         sessionStorage format from a PREVIOUS page while the membership
         form sat on Print - Ryan caught the mismatch (Print selected,
         digital covers showing). Here the form is the source of truth:
         sync the strip AND the sitewide sticky format to whatever pill
         is pressed, at load and on every toggle. */
      var memberPills = document.querySelector('[data-theinmag-membership-form] [data-option-name="format"]');
      if (memberPills) {
        var syncFromMembership = function () {
          var pressed = memberPills.querySelector('[data-value][aria-pressed="true"]');
          var fmt = pressed && pressed.dataset.value === 'Digital' ? 'Digital' : 'Print';
          syncStrips(fmt);
          document.documentElement.setAttribute('data-theinmag-format', fmt);
          try { sessionStorage.setItem('theinmag.activeFormat', fmt); } catch (e) { /* private mode */ }
        };
        syncFromMembership();
        memberPills.addEventListener('click', function (event) {
          if (!event.target.closest('[data-value]')) return;
          /* Let the form's own JS flip aria-pressed first. */
          setTimeout(syncFromMembership, 0);
        });
        /* Belt-and-braces: the form JS can flip format without a click
           (e.g. forcing Digital when Print sells out). */
        var pillObserver = new MutationObserver(syncFromMembership);
        var pills = memberPills.querySelectorAll('[data-value]');
        for (var k = 0; k < pills.length; k++) {
          pillObserver.observe(pills[k], { attributes: true, attributeFilter: ['aria-pressed'] });
        }
      }

      var group = document.querySelector('[data-variant-group]');
      if (!group) return;

      // Pick up any format that's already pressed at load (e.g. Print sold out
      // → JS bumps to Digital before our listener fires).
      var pressed = group.querySelector('[data-variant-format][aria-pressed="true"]');
      if (pressed && pressed.dataset.variantFormat) {
        syncStrips(pressed.dataset.variantFormat);
      }

      group.addEventListener('click', function (event) {
        var tile = event.target.closest('[data-variant-format]');
        if (!tile || !tile.dataset.variantFormat) return;
        syncStrips(tile.dataset.variantFormat);
      });

      // Belt-and-braces: the hero's own JS may flip aria-pressed without a
      // click event (e.g. when forcing Digital on a sold-out Print). Watch
      // for that and re-sync.
      var observer = new MutationObserver(function (mutations) {
        for (var i = 0; i < mutations.length; i++) {
          var target = mutations[i].target;
          if (target.getAttribute('aria-pressed') === 'true' && target.dataset.variantFormat) {
            syncStrips(target.dataset.variantFormat);
            return;
          }
        }
      });
      var tiles = group.querySelectorAll('[data-variant-format]');
      for (var j = 0; j < tiles.length; j++) {
        observer.observe(tiles[j], { attributes: true, attributeFilter: ['aria-pressed'] });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Issue strip",
  "tag": "section",
  "class": "shopify-section theinmag-issue-strip-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Horizontal nav strip for the top of product pages. Each tile links straight to that product's page. Order: Membership, Snack Pack, the pre-sale issue, the rest of the magazines newest-first, then Digital Stack."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (optional)",
      "default": "So many issues..."
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "classic", "label": "Classic (white)" },
        { "value": "shelf", "label": "Dark shelf" }
      ],
      "default": "classic",
      "info": "Dark shelf: inky band, white-framed covers, Digital Stack fan end-cap. Classic is unchanged."
    },
    {
      "type": "text",
      "id": "subline",
      "label": "Subline (dark shelf only)",
      "info": "Optional line under the heading, e.g. Start with whichever issue you like."
    },
    {
      "type": "collection",
      "id": "issues_collection",
      "label": "Issues collection"
    },
    {
      "type": "text",
      "id": "membership_handle",
      "label": "Membership product handle",
      "default": "membership"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 96,
      "step": 4,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 96,
      "step": 4,
      "default": 24,
      "unit": "px"
    }
  ],
  "presets": [
    { "name": "Issue strip" }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
