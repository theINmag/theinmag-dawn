{%- comment -%}
  theinmag-behind-the-mag-quiz
  "Match the kid to the maker." Three-column quiz on a 3D tablet
  card: adults grid LEFT, target boxes MIDDLE, kids grid RIGHT. User
  taps an adult tile to fill the Adult target box, then taps the
  matching kid (or two kids for paired blocks) to fill the Kid box.
  On a correct match: confetti + fact card overlay appears, matched
  tiles disappear from the grids. Click anywhere on the document and
  the fact dismisses; target boxes clear; the user keeps going with
  whoever's left.

  Wrong matches reset silently (no "Nope" reveal in this design).
  Discovery-based: the user works it out.

  Skip-to-team button at the bottom of the card toggles an accordion
  that reveals all 9 bios stacked underneath. The quiz card stays
  visible above so the user can collapse and resume.

  Reveal cards live as real DOM (hidden until shown) so crawlers
  index every team member's bio for AEO regardless of the visible
  visit path.
{%- endcomment -%}

{%- liquid
  assign reveal_blocks = section.blocks | where: 'type', 'reveal_card'
  assign heading = section.settings.heading | default: 'Match the kid to the maker'
  assign intro_1 = section.settings.intro_1
  assign intro_2 = section.settings.intro_2
  assign skip_label = section.settings.skip_label | default: 'Skip the quiz · just show me the team'
  assign aeo_heading = section.settings.aeo_heading | default: 'Who is on the theINmag team?'
  assign all_done_message = section.settings.all_done_message | default: "Nice work, you've met the whole team."
  assign target_adult_label = section.settings.target_adult_label | default: 'Adult'
  assign target_kid_label = section.settings.target_kid_label | default: 'Kid'

  assign bg_src = ''
  if section.settings.background_image != blank
    assign bg_src = section.settings.background_image | image_url: width: 2400
  elsif section.settings.background_filename != blank
    assign bg_src = section.settings.background_filename | asset_url
  endif

  assign section_style = ''
  if bg_src != blank
    assign section_style = "--bm-quiz-bg: url('" | append: bg_src | append: "');"
  endif
-%}

<section
  class="theinmag-bm-quiz{% if bg_src != blank %} theinmag-bm-quiz--has-bg{% endif %}"
  data-theinmag-bm-quiz
  aria-labelledby="theinmag-bm-quiz-heading"
  data-all-done-message="{{ all_done_message | escape }}"
  style="{{ section_style }}"
>
  <h2 class="theinmag-bm-quiz__a11y-heading">{{ aeo_heading }}</h2>

  <div class="theinmag-bm-quiz__tablet" data-bm-quiz-tablet>
    <header class="theinmag-bm-quiz__head">
      <h2 id="theinmag-bm-quiz-heading" class="theinmag-bm-quiz__heading">{{ heading }}</h2>
      {%- if intro_1 != blank -%}
        <p class="theinmag-bm-quiz__intro">{{ intro_1 }}</p>
      {%- endif -%}
      {%- if intro_2 != blank -%}
        <p class="theinmag-bm-quiz__intro">{{ intro_2 }}</p>
      {%- endif -%}
    </header>

    <div class="theinmag-bm-quiz__board" data-bm-quiz-board>
      <div class="theinmag-bm-quiz__column theinmag-bm-quiz__column--adults">
        <p class="theinmag-bm-quiz__col-label">Adults</p>
        <ul class="theinmag-bm-quiz__tiles" role="list" data-bm-quiz-adults>
          {%- for block in reveal_blocks -%}
            {%- liquid
              assign adult_src = ''
              if block.settings.adult_image != blank
                assign adult_src = block.settings.adult_image | image_url: width: 600
              elsif block.settings.adult_fallback_filename != blank
                assign adult_src = block.settings.adult_fallback_filename | asset_url
              endif
              assign is_paired = false
              if block.settings.kid_2_name != blank
                assign is_paired = true
              endif
            -%}
            <li class="theinmag-bm-quiz__tile-item" {{ block.shopify_attributes }}>
              <button
                type="button"
                class="theinmag-bm-quiz__tile theinmag-bm-quiz__tile--adult"
                data-bm-quiz-adult
                data-block-id="{{ block.id }}"
                data-paired="{{ is_paired }}"
                data-photo-src="{{ adult_src | escape }}"
                data-label="{{ block.settings.adult_label | escape }}"
                aria-label="Pick {{ block.settings.adult_label | escape }} as the adult"
              >
                <span class="theinmag-bm-quiz__tile-frame">
                  {%- if adult_src != blank -%}
                    <img src="{{ adult_src }}" alt="{{ block.settings.adult_label | escape }}" loading="lazy" width="300" height="300">
                  {%- else -%}
                    <span class="theinmag-bm-quiz__tile-placeholder" aria-hidden="true"></span>
                  {%- endif -%}
                </span>
              </button>
            </li>
          {%- endfor -%}
        </ul>
      </div>

      <div class="theinmag-bm-quiz__column theinmag-bm-quiz__column--targets">
        <div class="theinmag-bm-quiz__targets" data-bm-quiz-targets>
          <div class="theinmag-bm-quiz__target theinmag-bm-quiz__target--adult" data-bm-quiz-target-adult>
            <span class="theinmag-bm-quiz__target-label">{{ target_adult_label }}</span>
            <div class="theinmag-bm-quiz__target-frame" data-bm-quiz-target-adult-frame></div>
          </div>

          <div class="theinmag-bm-quiz__target theinmag-bm-quiz__target--kid" data-bm-quiz-target-kid>
            <span class="theinmag-bm-quiz__target-label">{{ target_kid_label }}</span>
            <div class="theinmag-bm-quiz__target-stack" data-bm-quiz-target-kid-stack>
              <div class="theinmag-bm-quiz__target-frame" data-bm-quiz-target-kid-frame data-slot="0"></div>
              <div class="theinmag-bm-quiz__target-frame theinmag-bm-quiz__target-frame--secondary" data-bm-quiz-target-kid-frame data-slot="1" hidden></div>
            </div>
          </div>
        </div>

        <div class="theinmag-bm-quiz__status" data-bm-quiz-status aria-live="polite"></div>
      </div>

      <div class="theinmag-bm-quiz__column theinmag-bm-quiz__column--kids">
        <p class="theinmag-bm-quiz__col-label">Kids</p>
        <ul class="theinmag-bm-quiz__tiles" role="list" data-bm-quiz-kids>
          {%- for block in reveal_blocks -%}
            {%- liquid
              assign kid_1_src = ''
              if block.settings.kid_1_image != blank
                assign kid_1_src = block.settings.kid_1_image | image_url: width: 600
              elsif block.settings.kid_1_fallback_filename != blank
                assign kid_1_src = block.settings.kid_1_fallback_filename | asset_url
              endif
            -%}
            <li class="theinmag-bm-quiz__tile-item">
              <button
                type="button"
                class="theinmag-bm-quiz__tile theinmag-bm-quiz__tile--kid"
                data-bm-quiz-kid
                data-block-id="{{ block.id }}"
                data-kid-name="{{ block.settings.kid_1_name | escape }}"
                data-photo-src="{{ kid_1_src | escape }}"
                aria-label="Pick this kid"
              >
                <span class="theinmag-bm-quiz__tile-frame">
                  {%- if kid_1_src != blank -%}
                    <img src="{{ kid_1_src }}" alt="A kid version of one theINmag team member." loading="lazy" width="300" height="300">
                  {%- else -%}
                    <span class="theinmag-bm-quiz__tile-placeholder" aria-hidden="true"></span>
                  {%- endif -%}
                </span>
              </button>
            </li>
          {%- endfor -%}
          {%- for block in reveal_blocks -%}
            {%- if block.settings.kid_2_name != blank -%}
              {%- liquid
                assign kid_2_src = ''
                if block.settings.kid_2_image != blank
                  assign kid_2_src = block.settings.kid_2_image | image_url: width: 600
                elsif block.settings.kid_2_fallback_filename != blank
                  assign kid_2_src = block.settings.kid_2_fallback_filename | asset_url
                endif
              -%}
              <li class="theinmag-bm-quiz__tile-item">
                <button
                  type="button"
                  class="theinmag-bm-quiz__tile theinmag-bm-quiz__tile--kid"
                  data-bm-quiz-kid
                  data-block-id="{{ block.id }}"
                  data-kid-name="{{ block.settings.kid_2_name | escape }}"
                  data-photo-src="{{ kid_2_src | escape }}"
                  aria-label="Pick this kid"
                >
                  <span class="theinmag-bm-quiz__tile-frame">
                    {%- if kid_2_src != blank -%}
                      <img src="{{ kid_2_src }}" alt="A kid version of one theINmag team member." loading="lazy" width="300" height="300">
                    {%- else -%}
                      <span class="theinmag-bm-quiz__tile-placeholder" aria-hidden="true"></span>
                    {%- endif -%}
                  </span>
                </button>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>

    <footer class="theinmag-bm-quiz__foot">
      <button
        type="button"
        class="theinmag-bm-quiz__skip"
        data-bm-quiz-skip
        aria-expanded="false"
        aria-controls="theinmag-bm-quiz-roster"
      >
        {{ skip_label }}
      </button>
    </footer>
  </div>

  <div
    id="theinmag-bm-quiz-roster"
    class="theinmag-bm-quiz__roster"
    data-bm-quiz-roster
    hidden
  >
    {%- for block in reveal_blocks -%}
      {%- liquid
        assign adult_src = ''
        if block.settings.adult_image != blank
          assign adult_src = block.settings.adult_image | image_url: width: 600
        elsif block.settings.adult_fallback_filename != blank
          assign adult_src = block.settings.adult_fallback_filename | asset_url
        endif

        assign kid_1_src = ''
        if block.settings.kid_1_image != blank
          assign kid_1_src = block.settings.kid_1_image | image_url: width: 600
        elsif block.settings.kid_1_fallback_filename != blank
          assign kid_1_src = block.settings.kid_1_fallback_filename | asset_url
        endif

        assign kid_2_src = ''
        if block.settings.kid_2_image != blank
          assign kid_2_src = block.settings.kid_2_image | image_url: width: 600
        elsif block.settings.kid_2_fallback_filename != blank
          assign kid_2_src = block.settings.kid_2_fallback_filename | asset_url
        endif
      -%}
      <article
        class="theinmag-bm-quiz__reveal"
        data-bm-quiz-reveal
        data-block-id="{{ block.id }}"
      >
        <div class="theinmag-bm-quiz__reveal-photos">
          <div class="theinmag-bm-quiz__reveal-then">
            {%- if kid_1_src != blank -%}
              <img src="{{ kid_1_src }}" alt="{{ block.settings.kid_1_name | escape }} as a kid.">
            {%- endif -%}
            {%- if kid_2_src != blank -%}
              <img src="{{ kid_2_src }}" alt="{{ block.settings.kid_2_name | escape }} as a kid.">
            {%- endif -%}
          </div>
          <div class="theinmag-bm-quiz__reveal-arrow" aria-hidden="true">→</div>
          <div class="theinmag-bm-quiz__reveal-now">
            {%- if adult_src != blank -%}
              <img src="{{ adult_src }}" alt="{{ block.settings.adult_label | escape }} now.">
            {%- endif -%}
          </div>
        </div>
        <div class="theinmag-bm-quiz__reveal-copy">
          <h3 class="theinmag-bm-quiz__reveal-name">{{ block.settings.adult_label }}</h3>
          {%- if block.settings.adult_role != blank -%}
            <p class="theinmag-bm-quiz__reveal-role">{{ block.settings.adult_role }}</p>
          {%- endif -%}
          {%- if block.settings.bio != blank -%}
            <p class="theinmag-bm-quiz__reveal-bio">{{ block.settings.bio }}</p>
          {%- endif -%}
          {%- if block.settings.fun_fact != blank -%}
            <p class="theinmag-bm-quiz__reveal-fun-fact"><em>Fun fact:</em> {{ block.settings.fun_fact }}</p>
          {%- endif -%}
        </div>
      </article>
    {%- endfor -%}
  </div>

  <div class="theinmag-bm-quiz__fact-overlay" data-bm-quiz-fact-overlay hidden aria-hidden="true">
    <div class="theinmag-bm-quiz__fact-card" data-bm-quiz-fact-card></div>
  </div>

  <p class="theinmag-bm-quiz__all-done" data-bm-quiz-all-done hidden>
    {{ all_done_message }}
  </p>
</section>

{%- stylesheet -%}
  /* ================================================================
     theinmag-bm-quiz
     3D-tablet-card quiz that fills most of the viewport. Three
     columns: adults | target boxes + status | kids. Mobile stacks
     them: adults > targets > kids.
     ================================================================ */
  .theinmag-bm-quiz {
    background-color: var(--color-lavender, #E8DEEF);
    color: var(--color-inky-purple-navy, #2A1F3D);
    padding: clamp(40px, 6vw, 80px) clamp(16px, 4vw, 32px);
    position: relative;
    overflow: hidden;
  }
  .theinmag-bm-quiz--has-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--bm-quiz-bg);
    background-size: cover;
    background-position: center;
    pointer-events: none;
    z-index: 0;
    opacity: 0.6;
  }
  .theinmag-bm-quiz__a11y-heading {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ================================================================
     The 3D tablet. Layered shadow stack gives the lifted feel - large
     soft shadow underneath, tighter near shadow, plus a subtle inset
     bevel highlight on the top edge. Cream surface so the photos
     pop.
     ================================================================ */
  .theinmag-bm-quiz__tablet {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    background-color: #FFFFFF;
    border-radius: 28px;
    padding: clamp(28px, 4vw, 48px) clamp(20px, 3vw, 40px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.9),
      inset 0 -1px 0 rgba(42, 31, 61, 0.04),
      0 30px 60px rgba(42, 31, 61, 0.18),
      0 12px 24px rgba(42, 31, 61, 0.12),
      0 4px 8px rgba(42, 31, 61, 0.08);
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 3vw, 36px);
  }

  .theinmag-bm-quiz__head {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: clamp(8px, 1vw, 12px);
  }

  .theinmag-bm-quiz__heading {
    margin: 0;
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-size: clamp(28px, 4.4vw, 44px);
    line-height: 1.1;
    color: var(--color-purple-dark, #5D3A7A);
  }

  .theinmag-bm-quiz__intro {
    margin: 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: clamp(15px, 1.6vw, 17px);
    line-height: 1.55;
    color: var(--color-inky-purple-navy, #2A1F3D);
    max-width: 60ch;
    margin-left: auto;
    margin-right: auto;
  }

  /* ================================================================
     Board: 3 columns on desktop. Mobile: stacked.
     ================================================================ */
  .theinmag-bm-quiz__board {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(20px, 3vw, 32px);
    align-items: start;
  }

  @media (min-width: 750px) {
    .theinmag-bm-quiz__board {
      grid-template-columns: minmax(0, 1fr) minmax(180px, 0.55fr) minmax(0, 1fr);
      gap: clamp(20px, 2.4vw, 32px);
    }
  }

  .theinmag-bm-quiz__column {
    display: flex;
    flex-direction: column;
    gap: clamp(10px, 1.4vw, 14px);
  }

  /* On mobile, force the order: adults > targets > kids. */
  .theinmag-bm-quiz__column--adults { order: 1; }
  .theinmag-bm-quiz__column--targets { order: 2; }
  .theinmag-bm-quiz__column--kids { order: 3; }
  @media (min-width: 750px) {
    .theinmag-bm-quiz__column--adults,
    .theinmag-bm-quiz__column--targets,
    .theinmag-bm-quiz__column--kids { order: unset; }
  }

  .theinmag-bm-quiz__col-label {
    margin: 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-purple-dark, #5D3A7A);
    text-align: center;
  }

  /* ================================================================
     Tiles - the photos in each grid.
     ================================================================ */
  .theinmag-bm-quiz__tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(8px, 1.2vw, 12px);
  }

  @media (min-width: 750px) {
    .theinmag-bm-quiz__column--kids .theinmag-bm-quiz__tiles {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .theinmag-bm-quiz__tile-item { margin: 0; }

  .theinmag-bm-quiz__tile {
    appearance: none;
    background: none;
    border: 0;
    padding: 0;
    margin: 0;
    width: 100%;
    cursor: pointer;
    transition: transform 0.18s ease, opacity 0.3s ease;
  }
  .theinmag-bm-quiz__tile:hover {
    transform: translateY(-2px);
  }

  .theinmag-bm-quiz__tile-frame {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 12px;
    background-color: var(--color-wave-purple, #C9B5DB);
    box-shadow: 0 1px 6px rgba(123, 79, 158, 0.12);
    outline: 3px solid transparent;
    transition: outline-color 0.15s ease, box-shadow 0.18s ease;
  }
  .theinmag-bm-quiz__tile-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .theinmag-bm-quiz__tile-placeholder {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--color-wave-purple, #C9B5DB) 0%, var(--color-lavender, #E8DEEF) 100%);
  }
  .theinmag-bm-quiz__tile:hover .theinmag-bm-quiz__tile-frame {
    box-shadow: 0 6px 16px rgba(123, 79, 158, 0.25);
  }
  .theinmag-bm-quiz__tile:focus-visible {
    outline: none;
  }
  .theinmag-bm-quiz__tile:focus-visible .theinmag-bm-quiz__tile-frame {
    outline-color: var(--color-purple-dark, #5D3A7A);
    outline-offset: 3px;
  }
  .theinmag-bm-quiz__tile.is-active .theinmag-bm-quiz__tile-frame {
    outline-color: var(--color-yellow, #F9C23C);
    outline-offset: 3px;
    box-shadow: 0 6px 18px rgba(249, 194, 60, 0.45);
  }

  /* Resolved tiles disappear from the grid - opacity fade then
     display:none after the transition (handled in JS). */
  .theinmag-bm-quiz__tile.is-resolved {
    opacity: 0;
    pointer-events: none;
    transform: scale(0.85);
  }

  /* ================================================================
     Target zone (middle column): two greyed-out boxes that fill in
     when the user picks an adult or kid.
     ================================================================ */
  .theinmag-bm-quiz__targets {
    display: flex;
    flex-direction: column;
    gap: clamp(12px, 1.4vw, 18px);
    align-items: center;
  }

  .theinmag-bm-quiz__target {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    width: 100%;
    max-width: 180px;
  }

  .theinmag-bm-quiz__target-label {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-purple-dark, #5D3A7A);
  }

  .theinmag-bm-quiz__target-stack {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .theinmag-bm-quiz__target-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 14px;
    background-color: var(--color-lavender, #E8DEEF);
    border: 2px dashed rgba(93, 58, 122, 0.35);
    overflow: hidden;
    transition: border-color 0.2s ease, background-color 0.2s ease, transform 0.18s ease;
  }
  .theinmag-bm-quiz__target-frame.is-filled {
    border-style: solid;
    border-color: var(--color-purple-dark, #5D3A7A);
    background-color: #FFFFFF;
  }
  .theinmag-bm-quiz__target-frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: theinmag-bm-quiz-target-pop 0.22s ease both;
  }
  @keyframes theinmag-bm-quiz-target-pop {
    from { transform: scale(0.7); opacity: 0; }
    to   { transform: scale(1); opacity: 1; }
  }

  /* ================================================================
     Status line + skip button + foot.
     ================================================================ */
  .theinmag-bm-quiz__status {
    min-height: 1.4em;
    text-align: center;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 500;
    font-size: clamp(13px, 1.4vw, 14px);
    color: var(--color-purple-dark, #5D3A7A);
  }

  .theinmag-bm-quiz__foot {
    display: flex;
    justify-content: center;
    padding-top: clamp(8px, 1.4vw, 16px);
  }

  .theinmag-bm-quiz__skip {
    appearance: none;
    background-color: transparent;
    color: var(--color-purple-dark, #5D3A7A);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: clamp(13px, 1.4vw, 14px);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border: 2px solid var(--color-purple-dark, #5D3A7A);
    border-radius: 32px;
    padding: 10px 22px;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .theinmag-bm-quiz__skip:hover {
    background-color: var(--color-purple-dark, #5D3A7A);
    color: #FFFFFF;
  }
  .theinmag-bm-quiz__skip:focus-visible {
    outline: 3px solid var(--color-yellow, #F9C23C);
    outline-offset: 2px;
  }
  .theinmag-bm-quiz__skip[aria-expanded="true"] {
    background-color: var(--color-purple-dark, #5D3A7A);
    color: #FFFFFF;
  }

  /* ================================================================
     Roster (accordion): all 9 reveal cards stacked. Hidden by default,
     toggled by the Skip button.
     ================================================================ */
  .theinmag-bm-quiz__roster {
    position: relative;
    z-index: 1;
    max-width: 880px;
    margin: clamp(28px, 4vw, 40px) auto 0;
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 2.4vw, 24px);
  }

  .theinmag-bm-quiz__reveal {
    background-color: #FFFFFF;
    border-radius: 16px;
    padding: clamp(20px, 3vw, 28px);
    box-shadow: 0 4px 18px rgba(123, 79, 158, 0.12);
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(14px, 1.8vw, 20px);
  }
  @media (min-width: 750px) {
    .theinmag-bm-quiz__reveal {
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
      align-items: center;
    }
  }
  .theinmag-bm-quiz__reveal-photos {
    display: flex;
    align-items: center;
    gap: clamp(8px, 1.2vw, 12px);
  }
  .theinmag-bm-quiz__reveal-then,
  .theinmag-bm-quiz__reveal-now {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }
  .theinmag-bm-quiz__reveal-photos img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 12px;
    background-color: var(--color-lavender, #E8DEEF);
  }
  .theinmag-bm-quiz__reveal-arrow {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: clamp(20px, 2.4vw, 26px);
    color: var(--color-purple-dark, #5D3A7A);
    flex: 0 0 auto;
  }
  .theinmag-bm-quiz__reveal-copy {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .theinmag-bm-quiz__reveal-name {
    margin: 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: clamp(20px, 2.4vw, 24px);
    line-height: 1.2;
    color: var(--color-inky-purple-navy, #2A1F3D);
  }
  .theinmag-bm-quiz__reveal-role {
    margin: 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 500;
    font-size: clamp(13px, 1.3vw, 14px);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-purple-dark, #5D3A7A);
  }
  .theinmag-bm-quiz__reveal-bio {
    margin: 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-size: clamp(15px, 1.5vw, 16px);
    line-height: 1.6;
    color: var(--color-inky-purple-navy, #2A1F3D);
  }
  .theinmag-bm-quiz__reveal-fun-fact {
    margin: 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-size: clamp(14px, 1.4vw, 15px);
    line-height: 1.5;
    color: var(--color-inky-purple-navy, #2A1F3D);
    opacity: 0.78;
  }
  .theinmag-bm-quiz__reveal-fun-fact em {
    font-style: italic;
    font-weight: 600;
  }

  /* ================================================================
     Fact card overlay - shown on a correct match.
     ================================================================ */
  .theinmag-bm-quiz__fact-overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(42, 31, 61, 0.5);
    z-index: 9000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(16px, 4vw, 32px);
    animation: theinmag-bm-quiz-fact-fade 0.18s ease both;
  }
  @keyframes theinmag-bm-quiz-fact-fade {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  .theinmag-bm-quiz__fact-card {
    background-color: #FFFFFF;
    border-radius: 20px;
    padding: clamp(24px, 3vw, 36px);
    max-width: 720px;
    width: 100%;
    max-height: 86vh;
    overflow-y: auto;
    box-shadow:
      0 30px 60px rgba(42, 31, 61, 0.32),
      0 12px 24px rgba(42, 31, 61, 0.18);
    animation: theinmag-bm-quiz-fact-pop 0.28s cubic-bezier(0.34, 1.4, 0.64, 1) both;
  }
  @keyframes theinmag-bm-quiz-fact-pop {
    from { transform: scale(0.86); opacity: 0; }
    to   { transform: scale(1); opacity: 1; }
  }

  /* The fact card hosts a clone of the matching reveal card, so it
     reuses the reveal styles. */
  .theinmag-bm-quiz__fact-card .theinmag-bm-quiz__reveal {
    box-shadow: none;
    padding: 0;
    background-color: transparent;
  }

  .theinmag-bm-quiz__all-done {
    position: relative;
    z-index: 1;
    margin: clamp(28px, 4vw, 44px) auto 0;
    max-width: 640px;
    text-align: center;
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-size: clamp(22px, 3vw, 30px);
    line-height: 1.25;
    color: var(--color-purple-dark, #5D3A7A);
  }

  /* ================================================================
     Confetti burst - same CSS keyframe approach as before.
     ================================================================ */
  .theinmag-bm-quiz__confetti {
    position: fixed;
    pointer-events: none;
    z-index: 9001;
    width: 0;
    height: 0;
  }
  .theinmag-bm-quiz__confetti-bit {
    position: absolute;
    left: 0;
    top: 0;
    width: 8px;
    height: 12px;
    border-radius: 2px;
    transform-origin: center;
    animation: theinmag-bm-quiz-confetti 800ms cubic-bezier(0.2, 0.8, 0.4, 1) forwards;
  }
  @keyframes theinmag-bm-quiz-confetti {
    0%   { transform: translate(0, 0) rotate(0deg); opacity: 1; }
    100% { transform: translate(var(--dx, 0), var(--dy, 0)) rotate(var(--rot, 540deg)); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-bm-quiz__tile,
    .theinmag-bm-quiz__tile-frame,
    .theinmag-bm-quiz__target-frame,
    .theinmag-bm-quiz__skip,
    .theinmag-bm-quiz__fact-overlay,
    .theinmag-bm-quiz__fact-card {
      transition: none;
      animation: none;
    }
    .theinmag-bm-quiz__tile:hover {
      transform: none;
    }
  }
{%- endstylesheet -%}

<script>
  (function () {
    var root = document.querySelector('[data-theinmag-bm-quiz]');
    if (!root) return;

    var tablet = root.querySelector('[data-bm-quiz-tablet]');
    var board = root.querySelector('[data-bm-quiz-board]');
    var statusEl = root.querySelector('[data-bm-quiz-status]');
    var skipBtn = root.querySelector('[data-bm-quiz-skip]');
    var roster = root.querySelector('[data-bm-quiz-roster]');
    var allDoneEl = root.querySelector('[data-bm-quiz-all-done]');
    var factOverlay = root.querySelector('[data-bm-quiz-fact-overlay]');
    var factCard = root.querySelector('[data-bm-quiz-fact-card]');
    var targetAdultFrame = root.querySelector('[data-bm-quiz-target-adult-frame]');
    var targetKidFrames = root.querySelectorAll('[data-bm-quiz-target-kid-frame]');

    var adults = Array.prototype.slice.call(root.querySelectorAll('[data-bm-quiz-adult]'));
    var kids = Array.prototype.slice.call(root.querySelectorAll('[data-bm-quiz-kid]'));
    var reveals = Array.prototype.slice.call(root.querySelectorAll('[data-bm-quiz-reveal]'));

    if (!adults.length || !kids.length) return;

    var prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var allDoneMessage = root.getAttribute('data-all-done-message') || "Nice work, you've met the whole team.";

    /* State */
    var selectedAdult = null;          // <button>
    var selectedKids = [];             // [<button>...]
    var requiredKids = 1;
    var resolvedBlockIds = {};
    var factOpen = false;

    /* Shuffle the kid grid via CSS `order`. Real DOM stays in source
       order so screen readers / crawlers see a stable sequence. */
    var kidLis = Array.prototype.map.call(kids, function (k) { return k.parentElement; });
    var shuffleIdx = kidLis.map(function (_, i) { return i; });
    for (var s = shuffleIdx.length - 1; s > 0; s--) {
      var t = Math.floor(Math.random() * (s + 1));
      var tmp = shuffleIdx[s]; shuffleIdx[s] = shuffleIdx[t]; shuffleIdx[t] = tmp;
    }
    kidLis.forEach(function (li, i) { if (li) li.style.order = shuffleIdx[i]; });

    function setStatus(text) {
      if (statusEl) statusEl.textContent = text || '';
    }

    function clearTargetFrame(frame) {
      if (!frame) return;
      while (frame.firstChild) frame.removeChild(frame.firstChild);
      frame.classList.remove('is-filled');
    }

    function fillTargetFrame(frame, photoSrc) {
      clearTargetFrame(frame);
      if (!photoSrc) return;
      var img = document.createElement('img');
      img.src = photoSrc;
      img.alt = '';
      img.setAttribute('aria-hidden', 'true');
      frame.appendChild(img);
      frame.classList.add('is-filled');
    }

    function showSecondKidFrame(show) {
      if (targetKidFrames.length < 2) return;
      var second = targetKidFrames[1];
      if (show) {
        second.hidden = false;
      } else {
        second.hidden = true;
        clearTargetFrame(second);
      }
    }

    function resetSelection() {
      selectedAdult = null;
      selectedKids = [];
      requiredKids = 1;
      adults.forEach(function (a) { a.classList.remove('is-active'); });
      kids.forEach(function (k) { k.classList.remove('is-active'); });
      clearTargetFrame(targetAdultFrame);
      Array.prototype.forEach.call(targetKidFrames, clearTargetFrame);
      showSecondKidFrame(false);
      setStatus('');
    }

    function getRevealCard(blockId) {
      for (var i = 0; i < reveals.length; i++) {
        if (reveals[i].getAttribute('data-block-id') === blockId) return reveals[i];
      }
      return null;
    }

    function lockBlock(blockId) {
      resolvedBlockIds[blockId] = true;
      adults.forEach(function (a) {
        if (a.getAttribute('data-block-id') === blockId) {
          a.classList.add('is-resolved');
          a.setAttribute('aria-disabled', 'true');
          // Remove from layout after the fade so the grid reflows.
          setTimeout(function () { if (a.parentElement) a.parentElement.style.display = 'none'; }, 320);
        }
      });
      kids.forEach(function (k) {
        if (k.getAttribute('data-block-id') === blockId) {
          k.classList.add('is-resolved');
          k.setAttribute('aria-disabled', 'true');
          setTimeout(function () { if (k.parentElement) k.parentElement.style.display = 'none'; }, 320);
        }
      });
    }

    function checkAllDone() {
      var done = adults.every(function (a) {
        return resolvedBlockIds[a.getAttribute('data-block-id')];
      });
      if (done) {
        if (board) board.style.display = 'none';
        if (skipBtn) skipBtn.style.display = 'none';
        if (allDoneEl) {
          allDoneEl.removeAttribute('hidden');
          allDoneEl.textContent = allDoneMessage;
        }
      }
    }

    /* Confetti burst at a screen point. */
    var confettiColors = ['#F9C23C', '#E8DEEF', '#FCDDB8', '#5D3A7A', '#FBE0D6'];
    function burstConfetti(cx, cy) {
      if (prefersReducedMotion) return;
      var container = document.createElement('div');
      container.className = 'theinmag-bm-quiz__confetti';
      container.setAttribute('aria-hidden', 'true');
      container.style.left = cx + 'px';
      container.style.top = cy + 'px';
      document.body.appendChild(container);
      var n = 10;
      for (var i = 0; i < n; i++) {
        var bit = document.createElement('span');
        bit.className = 'theinmag-bm-quiz__confetti-bit';
        var angle = (Math.PI * 2 * i) / n + (Math.random() - 0.5) * 0.5;
        var dist = 70 + Math.random() * 50;
        var dx = Math.cos(angle) * dist;
        var dy = Math.sin(angle) * dist - 30;
        bit.style.setProperty('--dx', dx + 'px');
        bit.style.setProperty('--dy', dy + 'px');
        bit.style.setProperty('--rot', (Math.random() * 720 - 360) + 'deg');
        bit.style.background = confettiColors[i % confettiColors.length];
        container.appendChild(bit);
      }
      setTimeout(function () { if (container.parentNode) container.parentNode.removeChild(container); }, 1000);
    }

    var factCanDismiss = false;
    function showFact(blockId) {
      var src = getRevealCard(blockId);
      if (!src || !factCard || !factOverlay) return;
      // Clone the reveal card content into the fact card.
      while (factCard.firstChild) factCard.removeChild(factCard.firstChild);
      var clone = src.cloneNode(true);
      factCard.appendChild(clone);
      factOverlay.hidden = false;
      factOverlay.setAttribute('aria-hidden', 'false');
      factOpen = true;
      // Defer enabling click-anywhere-dismiss until the current event
      // loop turn completes. Otherwise the same click that opened the
      // fact (kid tile -> bubble -> document) would dismiss it.
      factCanDismiss = false;
      setTimeout(function () { factCanDismiss = true; }, 0);
    }

    function dismissFact() {
      if (!factOpen) return;
      factOpen = false;
      factOverlay.hidden = true;
      factOverlay.setAttribute('aria-hidden', 'true');
      while (factCard && factCard.firstChild) factCard.removeChild(factCard.firstChild);
      resetSelection();
    }

    /* Click-anywhere dismiss. Per spec: "click anywhere else the fact
       disappears." factCanDismiss guards against the same click that
       opened the fact triggering its own dismiss via bubble-up. */
    document.addEventListener('click', function (evt) {
      if (!factOpen || !factCanDismiss) return;
      dismissFact();
    });
    document.addEventListener('keydown', function (evt) {
      if (factOpen && (evt.key === 'Escape' || evt.key === 'Esc')) {
        dismissFact();
      }
    });

    function onAdultClick(adult, evt) {
      if (factOpen) return; // dismiss handler will fire first via document-level
      var blockId = adult.getAttribute('data-block-id');
      if (resolvedBlockIds[blockId]) return;

      // If clicking the already-selected adult: deselect.
      if (selectedAdult === adult) {
        adult.classList.remove('is-active');
        selectedAdult = null;
        clearTargetFrame(targetAdultFrame);
        showSecondKidFrame(false);
        // Re-evaluate kid required count back to 1.
        requiredKids = 1;
        return;
      }

      // Switch selection to this adult.
      adults.forEach(function (a) { a.classList.remove('is-active'); });
      adult.classList.add('is-active');
      selectedAdult = adult;
      fillTargetFrame(targetAdultFrame, adult.getAttribute('data-photo-src'));
      requiredKids = adult.getAttribute('data-paired') === 'true' ? 2 : 1;
      showSecondKidFrame(requiredKids === 2);

      // Trim kid selections to required count if we now need fewer.
      if (selectedKids.length > requiredKids) {
        var excess = selectedKids.slice(requiredKids);
        excess.forEach(function (k) { k.classList.remove('is-active'); });
        selectedKids = selectedKids.slice(0, requiredKids);
        Array.prototype.forEach.call(targetKidFrames, function (f, i) {
          if (i >= requiredKids) clearTargetFrame(f);
        });
      }

      maybeResolve();
    }

    function onKidClick(kid, evt) {
      if (factOpen) return;
      var blockId = kid.getAttribute('data-block-id');
      if (resolvedBlockIds[blockId]) return;

      // Already-selected kid: deselect.
      var existingIdx = selectedKids.indexOf(kid);
      if (existingIdx >= 0) {
        kid.classList.remove('is-active');
        selectedKids.splice(existingIdx, 1);
        // Re-render kid target frames.
        Array.prototype.forEach.call(targetKidFrames, function (f) { clearTargetFrame(f); });
        selectedKids.forEach(function (k, i) {
          var f = targetKidFrames[i];
          if (f) fillTargetFrame(f, k.getAttribute('data-photo-src'));
        });
        showSecondKidFrame(requiredKids === 2);
        return;
      }

      // Add this kid to the selection.
      if (selectedKids.length >= requiredKids) {
        // Replace the most recent kid - swap behavior so the user can
        // change their mind on the second pick of a paired flow.
        var oldKid = selectedKids[selectedKids.length - 1];
        oldKid.classList.remove('is-active');
        selectedKids[selectedKids.length - 1] = kid;
      } else {
        selectedKids.push(kid);
      }

      kid.classList.add('is-active');

      // Re-fill kid target frames in order.
      Array.prototype.forEach.call(targetKidFrames, function (f) { clearTargetFrame(f); });
      selectedKids.forEach(function (k, i) {
        var f = targetKidFrames[i];
        if (f) fillTargetFrame(f, k.getAttribute('data-photo-src'));
      });
      showSecondKidFrame(requiredKids === 2);

      maybeResolve();
    }

    function maybeResolve() {
      if (!selectedAdult) return;
      if (selectedKids.length < requiredKids) return;

      var adultBlockId = selectedAdult.getAttribute('data-block-id');
      var allMatch = selectedKids.every(function (k) {
        return k.getAttribute('data-block-id') === adultBlockId;
      });

      if (allMatch) {
        // Correct match. Lock the block, confetti, show fact card.
        var rect = targetAdultFrame.getBoundingClientRect();
        var cx = rect.left + rect.width / 2;
        var cy = rect.top + rect.height / 2;
        burstConfetti(cx, cy);

        lockBlock(adultBlockId);
        showFact(adultBlockId);
        checkAllDone();
        // Note: dismissFact runs on next document click and calls
        // resetSelection(), which clears target frames + active states.
      } else {
        // Wrong - silent reset per spec. Brief shake on the adult target.
        if (!prefersReducedMotion && targetAdultFrame) {
          targetAdultFrame.animate(
            [{ transform: 'translateX(0)' }, { transform: 'translateX(-6px)' }, { transform: 'translateX(6px)' }, { transform: 'translateX(0)' }],
            { duration: 240, easing: 'ease-in-out' }
          );
        }
        setTimeout(resetSelection, 220);
      }
    }

    adults.forEach(function (a) {
      a.addEventListener('click', function (evt) { onAdultClick(a, evt); });
    });
    kids.forEach(function (k) {
      k.addEventListener('click', function (evt) { onKidClick(k, evt); });
    });

    /* Skip-to-team toggles the roster accordion. */
    if (skipBtn && roster) {
      skipBtn.addEventListener('click', function (evt) {
        evt.stopPropagation();
        var expanded = skipBtn.getAttribute('aria-expanded') === 'true';
        skipBtn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
        if (expanded) {
          roster.hidden = true;
        } else {
          roster.hidden = false;
          if (!prefersReducedMotion) {
            roster.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      });
    }

    /* Stop click-anywhere-dismiss from firing on quiz-tablet inner
       interactions. Without this, every tile click would also dismiss
       a fact - but actually the spec wants dismiss-on-any-click, so
       we let it. The tile click handler returns early when factOpen
       is true. */
  })();
</script>

{% schema %}
{
  "name": "theINmag BM quiz",
  "tag": "section",
  "class": "theinmag-bm-quiz-section",
  "settings": [
    { "type": "header", "content": "Section copy" },
    { "type": "text", "id": "heading", "label": "Heading (H2)" },
    { "type": "textarea", "id": "intro_1", "label": "Intro paragraph 1" },
    { "type": "textarea", "id": "intro_2", "label": "Intro paragraph 2" },
    { "type": "text", "id": "skip_label", "label": "Skip / show team toggle label" },
    { "type": "text", "id": "aeo_heading", "label": "Visually-hidden H2 (question form)" },
    { "type": "header", "content": "Target box labels" },
    { "type": "text", "id": "target_adult_label", "label": "Adult target label" },
    { "type": "text", "id": "target_kid_label", "label": "Kid target label" },
    { "type": "header", "content": "Quiz strings" },
    { "type": "text", "id": "all_done_message", "label": "All-revealed message" },
    { "type": "header", "content": "Section background (optional)" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    { "type": "text", "id": "background_filename", "label": "Background fallback filename" }
  ],
  "blocks": [
    {
      "type": "reveal_card",
      "name": "Reveal card",
      "limit": 12,
      "settings": [
        { "type": "header", "content": "Adult tile (combined for paired cards)" },
        { "type": "text", "id": "adult_label", "label": "Adult name(s)" },
        { "type": "text", "id": "adult_role", "label": "Role" },
        { "type": "image_picker", "id": "adult_image", "label": "Adult photo" },
        { "type": "text", "id": "adult_fallback_filename", "label": "Adult photo fallback filename" },
        { "type": "header", "content": "Kid 1" },
        { "type": "text", "id": "kid_1_name", "label": "Kid 1 name" },
        { "type": "image_picker", "id": "kid_1_image", "label": "Kid 1 photo" },
        { "type": "text", "id": "kid_1_fallback_filename", "label": "Kid 1 photo fallback filename" },
        { "type": "header", "content": "Kid 2 (paired cards only)" },
        { "type": "text", "id": "kid_2_name", "label": "Kid 2 name", "info": "Leave blank for solo cards." },
        { "type": "image_picker", "id": "kid_2_image", "label": "Kid 2 photo" },
        { "type": "text", "id": "kid_2_fallback_filename", "label": "Kid 2 photo fallback filename" },
        { "type": "header", "content": "Bio" },
        { "type": "textarea", "id": "bio", "label": "Bio (2-3 sentences)" },
        { "type": "textarea", "id": "fun_fact", "label": "Fun fact" }
      ]
    }
  ],
  "presets": [
    {
      "name": "theINmag BM quiz",
      "settings": {
        "heading": "Match the kid to the maker",
        "intro_1": "These are the friendly faces behind every issue.",
        "intro_2": "See if you can match the image of them as a kid to them grown-up.",
        "skip_label": "Skip the quiz · just show me the team",
        "aeo_heading": "Who is on the theINmag team?",
        "target_adult_label": "Adult",
        "target_kid_label": "Kid",
        "all_done_message": "Nice work, you've met the whole team."
      }
    }
  ]
}
{% endschema %}
