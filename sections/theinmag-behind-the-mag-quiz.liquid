{%- comment -%}
  theinmag-behind-the-mag-quiz
  "Match the kid to the maker." Two grids (adults on top, kids below)
  and 9 reveal cards rendered as real DOM (hidden until matched / skip).
  Real DOM = bios are crawlable for AEO; JS is a presentation layer.

  Each reveal card lives as a block with:
    - adult label + role + photo (one combined photo for paired cards)
    - kid 1 name + photo (always)
    - kid 2 name + photo (optional, for paired cards)
    - bio + fun fact
  The kid grid renders 1 tile per solo block, 2 tiles per paired block
  (so a 9-block default gives 11 kid tiles for 9 adult tiles).

  Stage 1 (this file):
    - Static structure - all markup, no interactivity
    - All bios in DOM with `hidden` so crawlers index them
    - Skip button is rendered but inert

  Stage 3 will add:
    - State machine (kid-first selection, paired/solo logic)
    - Wrong + correct reveal flows ("Nope - that's actually [pair]")
    - Confetti micro-animation on correct match
    - Skip-to-team behaviour (unhide all, hide grid)
    - Shuffle the kid-grid order on load so the quiz isn't trivial
    - All-revealed completion message
{%- endcomment -%}

{%- liquid
  assign reveal_blocks = section.blocks | where: 'type', 'reveal_card'
  assign heading = section.settings.heading | default: 'Match the kid to the maker'
  assign intro_1 = section.settings.intro_1
  assign intro_2 = section.settings.intro_2
  assign skip_label = section.settings.skip_label | default: 'Skip the quiz - just show me the team'
  assign aeo_heading = section.settings.aeo_heading | default: 'Who is on the theINmag team?'

  assign all_done_message = section.settings.all_done_message | default: "Nice work, you've met the whole team."
  assign paired_hint = section.settings.paired_hint | default: 'Nice - now find the other kid.'
-%}

<section
  class="theinmag-bm-quiz"
  data-theinmag-bm-quiz
  aria-labelledby="theinmag-bm-quiz-heading"
  data-paired-hint="{{ paired_hint | escape }}"
  data-all-done-message="{{ all_done_message | escape }}"
>
  <h2 class="theinmag-bm-quiz__a11y-heading">{{ aeo_heading }}</h2>

  <div class="theinmag-bm-quiz__head">
    <div class="theinmag-bm-quiz__head-copy">
      <h2 id="theinmag-bm-quiz-heading" class="theinmag-bm-quiz__heading">{{ heading }}</h2>
      {%- if intro_1 != blank -%}
        <p class="theinmag-bm-quiz__intro">{{ intro_1 }}</p>
      {%- endif -%}
      {%- if intro_2 != blank -%}
        <p class="theinmag-bm-quiz__intro">{{ intro_2 }}</p>
      {%- endif -%}
    </div>

    <span class="theinmag-bm-quiz__character" data-theinmag-pool-character></span>

    <button
      type="button"
      class="theinmag-bm-quiz__skip"
      data-bm-quiz-skip
      disabled
    >
      {{ skip_label }}
    </button>
  </div>

  <div class="theinmag-bm-quiz__board" data-bm-quiz-board>

    <div class="theinmag-bm-quiz__grid theinmag-bm-quiz__grid--adults">
      <p class="theinmag-bm-quiz__grid-label">Now</p>
      <ul class="theinmag-bm-quiz__tiles" role="list" data-bm-quiz-adults>
        {%- for block in reveal_blocks -%}
          {%- liquid
            assign adult_src = ''
            if block.settings.adult_image != blank
              assign adult_src = block.settings.adult_image | image_url: width: 800
            elsif block.settings.adult_fallback_filename != blank
              assign adult_src = block.settings.adult_fallback_filename | asset_url
            endif
            assign is_paired = false
            if block.settings.kid_2_name != blank
              assign is_paired = true
            endif
          -%}
          <li class="theinmag-bm-quiz__tile-item" {{ block.shopify_attributes }}>
            <button
              type="button"
              class="theinmag-bm-quiz__tile theinmag-bm-quiz__tile--adult"
              data-bm-quiz-adult
              data-block-id="{{ block.id }}"
              data-paired="{{ is_paired }}"
              aria-label="Tap once you've found {%- if is_paired -%}the kids{%- else -%}the kid{%- endif -%} who grew into {{ block.settings.adult_label | escape }}"
            >
              <span class="theinmag-bm-quiz__tile-frame">
                {%- if adult_src != blank -%}
                  <img src="{{ adult_src }}" alt="{{ block.settings.adult_label | escape }}" loading="lazy" width="400" height="400">
                {%- else -%}
                  <span class="theinmag-bm-quiz__tile-placeholder" aria-hidden="true"></span>
                {%- endif -%}
              </span>
              <span class="theinmag-bm-quiz__tile-label">{{ block.settings.adult_label }}</span>
            </button>
          </li>
        {%- endfor -%}
      </ul>
    </div>

    <div class="theinmag-bm-quiz__grid theinmag-bm-quiz__grid--kids">
      <p class="theinmag-bm-quiz__grid-label">Then</p>
      <ul class="theinmag-bm-quiz__tiles" role="list" data-bm-quiz-kids>
        {%- comment -%}
          Render kid_1 for every block first, then kid_2 for paired
          blocks. Stage 3 shuffles the visual order via CSS `order`.
        {%- endcomment -%}
        {%- for block in reveal_blocks -%}
          {%- liquid
            assign kid_1_src = ''
            if block.settings.kid_1_image != blank
              assign kid_1_src = block.settings.kid_1_image | image_url: width: 600
            elsif block.settings.kid_1_fallback_filename != blank
              assign kid_1_src = block.settings.kid_1_fallback_filename | asset_url
            endif
          -%}
          <li class="theinmag-bm-quiz__tile-item">
            <button
              type="button"
              class="theinmag-bm-quiz__tile theinmag-bm-quiz__tile--kid"
              data-bm-quiz-kid
              data-block-id="{{ block.id }}"
              data-kid-name="{{ block.settings.kid_1_name | escape }}"
              aria-label="Kid photo of {{ block.settings.kid_1_name | escape }}"
            >
              <span class="theinmag-bm-quiz__tile-frame">
                {%- if kid_1_src != blank -%}
                  <img src="{{ kid_1_src }}" alt="A kid version of one theINmag team member." loading="lazy" width="300" height="300">
                {%- else -%}
                  <span class="theinmag-bm-quiz__tile-placeholder" aria-hidden="true"></span>
                {%- endif -%}
              </span>
            </button>
          </li>
        {%- endfor -%}
        {%- for block in reveal_blocks -%}
          {%- if block.settings.kid_2_name != blank -%}
            {%- liquid
              assign kid_2_src = ''
              if block.settings.kid_2_image != blank
                assign kid_2_src = block.settings.kid_2_image | image_url: width: 600
              elsif block.settings.kid_2_fallback_filename != blank
                assign kid_2_src = block.settings.kid_2_fallback_filename | asset_url
              endif
            -%}
            <li class="theinmag-bm-quiz__tile-item">
              <button
                type="button"
                class="theinmag-bm-quiz__tile theinmag-bm-quiz__tile--kid"
                data-bm-quiz-kid
                data-block-id="{{ block.id }}"
                data-kid-name="{{ block.settings.kid_2_name | escape }}"
                aria-label="Kid photo of {{ block.settings.kid_2_name | escape }}"
              >
                <span class="theinmag-bm-quiz__tile-frame">
                  {%- if kid_2_src != blank -%}
                    <img src="{{ kid_2_src }}" alt="A kid version of one theINmag team member." loading="lazy" width="300" height="300">
                  {%- else -%}
                    <span class="theinmag-bm-quiz__tile-placeholder" aria-hidden="true"></span>
                  {%- endif -%}
                </span>
              </button>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>

    {%- comment -%}
      Status / hint area - tells the user what to do next or what just
      happened. Polite live region so screen readers announce changes
      without being interrupting.
    {%- endcomment -%}
    <div class="theinmag-bm-quiz__status" data-bm-quiz-status aria-live="polite"></div>

  </div>

  <div class="theinmag-bm-quiz__reveals" data-bm-quiz-reveals>
    {%- for block in reveal_blocks -%}
      {%- liquid
        assign adult_src = ''
        if block.settings.adult_image != blank
          assign adult_src = block.settings.adult_image | image_url: width: 800
        elsif block.settings.adult_fallback_filename != blank
          assign adult_src = block.settings.adult_fallback_filename | asset_url
        endif

        assign kid_1_src = ''
        if block.settings.kid_1_image != blank
          assign kid_1_src = block.settings.kid_1_image | image_url: width: 600
        elsif block.settings.kid_1_fallback_filename != blank
          assign kid_1_src = block.settings.kid_1_fallback_filename | asset_url
        endif

        assign kid_2_src = ''
        if block.settings.kid_2_image != blank
          assign kid_2_src = block.settings.kid_2_image | image_url: width: 600
        elsif block.settings.kid_2_fallback_filename != blank
          assign kid_2_src = block.settings.kid_2_fallback_filename | asset_url
        endif
      -%}
      <article
        class="theinmag-bm-quiz__reveal"
        data-bm-quiz-reveal
        data-block-id="{{ block.id }}"
        hidden
      >
        <div class="theinmag-bm-quiz__reveal-photos">
          <div class="theinmag-bm-quiz__reveal-then">
            {%- if kid_1_src != blank -%}
              <img src="{{ kid_1_src }}" alt="{{ block.settings.kid_1_name | escape }} as a kid.">
            {%- endif -%}
            {%- if kid_2_src != blank -%}
              <img src="{{ kid_2_src }}" alt="{{ block.settings.kid_2_name | escape }} as a kid.">
            {%- endif -%}
          </div>
          <div class="theinmag-bm-quiz__reveal-arrow" aria-hidden="true">→</div>
          <div class="theinmag-bm-quiz__reveal-now">
            {%- if adult_src != blank -%}
              <img src="{{ adult_src }}" alt="{{ block.settings.adult_label | escape }} now.">
            {%- endif -%}
          </div>
        </div>

        <div class="theinmag-bm-quiz__reveal-copy">
          <h3 class="theinmag-bm-quiz__reveal-name" id="theinmag-bm-quiz-reveal-{{ block.id }}-name">
            {{ block.settings.adult_label }}
          </h3>
          {%- if block.settings.adult_role != blank -%}
            <p class="theinmag-bm-quiz__reveal-role">{{ block.settings.adult_role }}</p>
          {%- endif -%}
          {%- if block.settings.bio != blank -%}
            <p class="theinmag-bm-quiz__reveal-bio">{{ block.settings.bio }}</p>
          {%- endif -%}
          {%- if block.settings.fun_fact != blank -%}
            <p class="theinmag-bm-quiz__reveal-fun-fact"><em>Fun fact:</em> {{ block.settings.fun_fact }}</p>
          {%- endif -%}
        </div>
      </article>
    {%- endfor -%}
  </div>

  <p class="theinmag-bm-quiz__all-done" data-bm-quiz-all-done hidden>
    {{ all_done_message }}
  </p>
</section>

{%- stylesheet -%}
  /* ================================================================
     theinmag-bm-quiz
     Lavender (purple-pair) feature surface. Two stacked grids of
     square photo tiles + a reveal column below. Reveal cards live as
     real DOM with `hidden` until matched. Skip button reveals all in
     a stacked column.
     ================================================================ */

  .theinmag-bm-quiz {
    background-color: var(--color-lavender, #E8DEEF);
    color: var(--color-inky-purple-navy, #2A1F3D);
    padding: clamp(56px, 8vw, 112px) clamp(20px, 5vw, 48px);
    position: relative;
    overflow: hidden;
  }

  .theinmag-bm-quiz__a11y-heading {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .theinmag-bm-quiz__head {
    position: relative;
    max-width: 1080px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(12px, 2vw, 18px);
  }

  @media (min-width: 750px) {
    .theinmag-bm-quiz__head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: clamp(20px, 3vw, 32px);
      align-items: end;
    }
    .theinmag-bm-quiz__head-copy { grid-column: 1; }
    .theinmag-bm-quiz__skip { grid-column: 2; align-self: end; }
  }

  .theinmag-bm-quiz__heading {
    margin: 0;
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-size: clamp(30px, 5vw, 48px);
    line-height: 1.1;
    letter-spacing: 0;
    color: var(--color-purple-dark, #5D3A7A);
  }

  .theinmag-bm-quiz__intro {
    margin: clamp(8px, 1vw, 12px) 0 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: clamp(16px, 1.7vw, 18px);
    line-height: 1.6;
    color: var(--color-inky-purple-navy, #2A1F3D);
    max-width: 56ch;
  }

  .theinmag-bm-quiz__character {
    position: absolute;
    top: clamp(-12px, -1vw, 0px);
    right: clamp(8px, 3vw, 24px);
    width: clamp(60px, 8vw, 90px);
    pointer-events: none;
  }

  @media (min-width: 750px) {
    .theinmag-bm-quiz__character {
      display: none;
    }
  }

  /* Skip button - secondary outlined-purple per design tokens. Not
     yellow - that would compete with the final-CTA stamps below. */
  .theinmag-bm-quiz__skip {
    appearance: none;
    background-color: transparent;
    color: var(--color-purple-dark, #5D3A7A);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: clamp(13px, 1.4vw, 14px);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border: 2px solid var(--color-purple-dark, #5D3A7A);
    border-radius: 32px;
    padding: 11px 22px;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
    align-self: flex-start;
  }

  .theinmag-bm-quiz__skip:hover:not([disabled]) {
    background-color: var(--color-purple-dark, #5D3A7A);
    color: #FFFFFF;
  }
  .theinmag-bm-quiz__skip:focus-visible:not([disabled]) {
    background-color: var(--color-purple-dark, #5D3A7A);
    color: #FFFFFF;
    outline: 3px solid var(--color-yellow, #F9C23C);
    outline-offset: 2px;
  }

  .theinmag-bm-quiz__skip[disabled] {
    opacity: 0.55;
    cursor: not-allowed;
  }

  /* ================================================================
     Board - holds the two grids + status line.
     ================================================================ */
  .theinmag-bm-quiz__board {
    max-width: 1080px;
    margin: clamp(28px, 4vw, 44px) auto 0;
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 3vw, 32px);
  }

  .theinmag-bm-quiz__grid-label {
    margin: 0 0 clamp(10px, 1.4vw, 14px);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-purple-dark, #5D3A7A);
    opacity: 0.7;
  }

  .theinmag-bm-quiz__tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(8px, 1.4vw, 14px);
  }

  @media (min-width: 600px) {
    .theinmag-bm-quiz__tiles {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  @media (min-width: 990px) {
    .theinmag-bm-quiz__grid--adults .theinmag-bm-quiz__tiles {
      grid-template-columns: repeat(9, 1fr);
    }
    .theinmag-bm-quiz__grid--kids .theinmag-bm-quiz__tiles {
      /* 11 kids = awkward odd count. 11-up looks fine on wide screens
         but tightens cell size; if cells go too small, the eye fails to
         tell tile-1 from tile-2. Cap at 11 cols and let mobile wrap. */
      grid-template-columns: repeat(11, 1fr);
    }
  }

  .theinmag-bm-quiz__tile-item { margin: 0; }

  .theinmag-bm-quiz__tile {
    appearance: none;
    background: none;
    border: 0;
    padding: 0;
    margin: 0;
    width: 100%;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    transition: transform 0.15s ease;
  }

  .theinmag-bm-quiz__tile:hover {
    transform: translateY(-2px);
  }

  .theinmag-bm-quiz__tile-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 12px;
    background-color: var(--color-wave-purple, #C9B5DB);
    box-shadow: 0 1px 6px rgba(123, 79, 158, 0.1);
    transition: box-shadow 0.15s ease, outline-color 0.15s ease;
    outline: 3px solid transparent;
  }

  .theinmag-bm-quiz__tile-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .theinmag-bm-quiz__tile-placeholder {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--color-wave-purple, #C9B5DB) 0%, var(--color-lavender, #E8DEEF) 100%);
  }

  .theinmag-bm-quiz__tile:hover .theinmag-bm-quiz__tile-frame {
    box-shadow: 0 4px 14px rgba(123, 79, 158, 0.22);
  }

  .theinmag-bm-quiz__tile:focus-visible {
    outline: none;
  }
  .theinmag-bm-quiz__tile:focus-visible .theinmag-bm-quiz__tile-frame {
    outline-color: var(--color-purple-dark, #5D3A7A);
    outline-offset: 3px;
  }

  /* Active state - tile is "primed" awaiting its match. Stage 3 toggles
     the .is-active class on click. */
  .theinmag-bm-quiz__tile.is-active .theinmag-bm-quiz__tile-frame {
    outline-color: var(--color-yellow, #F9C23C);
    outline-offset: 3px;
    box-shadow: 0 6px 18px rgba(249, 194, 60, 0.4);
  }

  /* Resolved state - tile is locked, mostly faded out. */
  .theinmag-bm-quiz__tile.is-resolved {
    opacity: 0.32;
    cursor: default;
    pointer-events: none;
  }

  .theinmag-bm-quiz__tile.is-resolved .theinmag-bm-quiz__tile-frame {
    box-shadow: none;
    outline: none;
  }

  /* Optional checkmark on resolved adult tiles */
  .theinmag-bm-quiz__tile--adult.is-resolved .theinmag-bm-quiz__tile-frame::after {
    content: '✓';
    position: absolute;
    top: 6px;
    right: 6px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background-color: var(--color-sage-dark, #4A7C5C);
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .theinmag-bm-quiz__tile-label {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: clamp(11px, 1.2vw, 13px);
    line-height: 1.2;
    color: var(--color-inky-purple-navy, #2A1F3D);
    text-align: center;
    word-break: break-word;
  }

  /* ================================================================
     Status / hint line. Hidden when empty (Stage 3 fills text content).
     ================================================================ */
  .theinmag-bm-quiz__status {
    min-height: 1.5em;
    text-align: center;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 500;
    font-size: clamp(14px, 1.5vw, 16px);
    color: var(--color-purple-dark, #5D3A7A);
  }

  /* ================================================================
     Reveal cards
     Live as real DOM (visible to crawlers) but `hidden` until matched
     or the user hits Skip. Stack vertically when revealed.
     ================================================================ */
  .theinmag-bm-quiz__reveals {
    max-width: 880px;
    margin: clamp(28px, 4vw, 44px) auto 0;
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 2.4vw, 24px);
  }

  .theinmag-bm-quiz__reveal {
    background-color: #FFFFFF;
    border-radius: 16px;
    padding: clamp(20px, 3vw, 32px);
    box-shadow: 0 4px 18px rgba(123, 79, 158, 0.14);
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(16px, 2vw, 24px);
    /* Subtle entrance animation - CSS only so reduced-motion users get
       the instant version automatically. */
    animation: theinmag-bm-quiz-reveal-in 0.35s ease both;
  }

  @media (min-width: 750px) {
    .theinmag-bm-quiz__reveal {
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
      align-items: center;
    }
  }

  .theinmag-bm-quiz__reveal-photos {
    display: flex;
    align-items: center;
    gap: clamp(8px, 1.4vw, 14px);
  }

  .theinmag-bm-quiz__reveal-then,
  .theinmag-bm-quiz__reveal-now {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }

  .theinmag-bm-quiz__reveal-photos img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 12px;
    background-color: var(--color-lavender, #E8DEEF);
  }

  .theinmag-bm-quiz__reveal-arrow {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: clamp(20px, 2.4vw, 26px);
    color: var(--color-purple-dark, #5D3A7A);
    flex: 0 0 auto;
  }

  .theinmag-bm-quiz__reveal-copy {
    display: flex;
    flex-direction: column;
    gap: clamp(6px, 1vw, 10px);
  }

  .theinmag-bm-quiz__reveal-name {
    margin: 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: clamp(20px, 2.4vw, 24px);
    line-height: 1.2;
    color: var(--color-inky-purple-navy, #2A1F3D);
  }

  .theinmag-bm-quiz__reveal-role {
    margin: 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 500;
    font-size: clamp(13px, 1.3vw, 14px);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-purple-dark, #5D3A7A);
  }

  .theinmag-bm-quiz__reveal-bio {
    margin: 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-size: clamp(15px, 1.6vw, 16px);
    line-height: 1.6;
    color: var(--color-inky-purple-navy, #2A1F3D);
    opacity: 0.92;
  }

  .theinmag-bm-quiz__reveal-fun-fact {
    margin: 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-size: clamp(14px, 1.4vw, 15px);
    line-height: 1.5;
    color: var(--color-inky-purple-navy, #2A1F3D);
    opacity: 0.78;
  }

  .theinmag-bm-quiz__reveal-fun-fact em {
    font-style: italic;
    font-weight: 600;
  }

  .theinmag-bm-quiz__all-done {
    margin: clamp(28px, 4vw, 44px) auto 0;
    max-width: 640px;
    text-align: center;
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-size: clamp(22px, 3vw, 30px);
    line-height: 1.25;
    color: var(--color-purple-dark, #5D3A7A);
  }

  @keyframes theinmag-bm-quiz-reveal-in {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Adult tile in "pair in progress" state - one of two kids has been
     found correctly. Visual nudge to draw the eye to "find the other
     kid." Subtle pulse, not a parade. */
  .theinmag-bm-quiz__tile.is-pair-progress .theinmag-bm-quiz__tile-frame {
    outline-color: var(--color-yellow, #F9C23C);
    outline-offset: 3px;
    animation: theinmag-bm-quiz-pair-pulse 1.4s ease-in-out infinite;
  }

  @keyframes theinmag-bm-quiz-pair-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(249, 194, 60, 0.5); }
    50%      { box-shadow: 0 0 0 10px rgba(249, 194, 60, 0); }
  }

  /* ================================================================
     Confetti burst on correct match. Vanilla CSS keyframe, no JS lib.
     Each bit gets random --dx/--dy/--rot via inline style; the keyframe
     interpolates to those values. Six to eight bits per burst.
     ================================================================ */
  .theinmag-bm-quiz__confetti {
    position: fixed;
    pointer-events: none;
    z-index: 9999;
    width: 0;
    height: 0;
  }

  .theinmag-bm-quiz__confetti-bit {
    position: absolute;
    left: 0;
    top: 0;
    width: 8px;
    height: 12px;
    border-radius: 2px;
    transform-origin: center;
    animation: theinmag-bm-quiz-confetti 700ms cubic-bezier(0.2, 0.8, 0.4, 1) forwards;
  }

  @keyframes theinmag-bm-quiz-confetti {
    0% {
      transform: translate(0, 0) rotate(0deg);
      opacity: 1;
    }
    100% {
      transform: translate(var(--dx, 0), var(--dy, 0)) rotate(var(--rot, 540deg));
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-bm-quiz__tile,
    .theinmag-bm-quiz__tile-frame {
      transition: none;
    }
    .theinmag-bm-quiz__tile:hover {
      transform: none;
    }
    .theinmag-bm-quiz__reveal {
      animation: none;
    }
    .theinmag-bm-quiz__tile.is-pair-progress .theinmag-bm-quiz__tile-frame {
      animation: none;
    }
  }
{%- endstylesheet -%}

<script>
  /* ================================================================
     Quiz state machine - kid-first selection, paired/solo logic,
     correct + wrong reveals, skip-to-team, confetti burst.
     ================================================================ */
  (function () {
    var root = document.querySelector('[data-theinmag-bm-quiz]');
    if (!root) return;

    var board = root.querySelector('[data-bm-quiz-board]');
    var statusEl = root.querySelector('[data-bm-quiz-status]');
    var skipBtn = root.querySelector('[data-bm-quiz-skip]');
    var revealsContainer = root.querySelector('[data-bm-quiz-reveals]');
    var allDoneEl = root.querySelector('[data-bm-quiz-all-done]');
    var kidGrid = root.querySelector('[data-bm-quiz-kids]');

    var adults = Array.prototype.slice.call(root.querySelectorAll('[data-bm-quiz-adult]'));
    var kids = Array.prototype.slice.call(root.querySelectorAll('[data-bm-quiz-kid]'));
    var reveals = Array.prototype.slice.call(root.querySelectorAll('[data-bm-quiz-reveal]'));

    if (!adults.length || !kids.length) return;

    var prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var pairedHint = root.getAttribute('data-paired-hint') || 'Nice - now find the other kid.';
    var allDoneMessage = root.getAttribute('data-all-done-message') || "Nice work, you've met the whole team.";

    /* State */
    var primedKid = null;
    var pairsInProgress = {};            // adult blockId -> [kid el, kid el]
    var resolvedBlockIds = {};           // blockId -> true once revealed

    /* ----------------------------------------------------------------
       Shuffle the kid grid via CSS `order` so the quiz isn't trivial.
       Real DOM stays in block order (helpful for screen readers reading
       in source order); only the visual layout is randomised.
       ---------------------------------------------------------------- */
    if (kidGrid) {
      var indices = kids.map(function (_, i) { return i; });
      for (var s = indices.length - 1; s > 0; s--) {
        var t = Math.floor(Math.random() * (s + 1));
        var tmp = indices[s]; indices[s] = indices[t]; indices[t] = tmp;
      }
      kids.forEach(function (kid, i) {
        var li = kid.parentElement;
        if (li) li.style.order = indices[i];
      });
    }

    /* Enable the skip button now that JS is running. */
    if (skipBtn) skipBtn.disabled = false;

    function setStatus(text) {
      if (!statusEl) return;
      statusEl.textContent = text || '';
    }

    function unprimeKid() {
      if (primedKid) {
        primedKid.classList.remove('is-active');
        primedKid.setAttribute('aria-pressed', 'false');
      }
      primedKid = null;
    }

    function unprimeAllAdultActive() {
      adults.forEach(function (a) {
        a.classList.remove('is-active');
        a.setAttribute('aria-pressed', 'false');
      });
    }

    function primeKid(kid) {
      unprimeKid();
      primedKid = kid;
      kid.classList.add('is-active');
      kid.setAttribute('aria-pressed', 'true');
      setStatus('Now tap who you reckon they grew into.');
    }

    function getRevealCard(blockId) {
      for (var i = 0; i < reveals.length; i++) {
        if (reveals[i].getAttribute('data-block-id') === blockId) return reveals[i];
      }
      return null;
    }

    function getAdultByBlockId(blockId) {
      for (var i = 0; i < adults.length; i++) {
        if (adults[i].getAttribute('data-block-id') === blockId) return adults[i];
      }
      return null;
    }

    function getKidsByBlockId(blockId) {
      return kids.filter(function (k) { return k.getAttribute('data-block-id') === blockId; });
    }

    function revealCard(card) {
      if (!card) return;
      card.removeAttribute('hidden');
      if (!prefersReducedMotion) {
        try {
          card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        } catch (e) { /* older browsers ignore options */ }
      }
    }

    function lockBlock(blockId) {
      resolvedBlockIds[blockId] = true;
      var blockKids = getKidsByBlockId(blockId);
      blockKids.forEach(function (k) {
        k.classList.add('is-resolved');
        k.classList.remove('is-active');
        k.setAttribute('aria-disabled', 'true');
      });
      var adult = getAdultByBlockId(blockId);
      if (adult) {
        adult.classList.add('is-resolved');
        adult.classList.remove('is-active');
        adult.classList.remove('is-pair-progress');
        adult.setAttribute('aria-disabled', 'true');
      }
      delete pairsInProgress[blockId];
    }

    function checkAllDone() {
      var done = adults.every(function (a) {
        return resolvedBlockIds[a.getAttribute('data-block-id')];
      });
      if (done) {
        if (board) board.style.display = 'none';
        if (skipBtn) skipBtn.style.display = 'none';
        if (allDoneEl) {
          allDoneEl.removeAttribute('hidden');
          allDoneEl.textContent = allDoneMessage;
        }
      }
    }

    /* ----------------------------------------------------------------
       Confetti burst at the centre of the matched adult tile.
       ---------------------------------------------------------------- */
    var confettiColors = ['#F9C23C', '#E8DEEF', '#FCDDB8', '#5D3A7A', '#FBE0D6'];

    function burstConfetti(anchor) {
      if (prefersReducedMotion || !anchor) return;
      var rect = anchor.getBoundingClientRect();
      var cx = rect.left + rect.width / 2;
      var cy = rect.top + rect.height / 2;

      var container = document.createElement('div');
      container.className = 'theinmag-bm-quiz__confetti';
      container.setAttribute('aria-hidden', 'true');
      container.style.left = cx + 'px';
      container.style.top = cy + 'px';
      document.body.appendChild(container);

      var n = 8;
      for (var i = 0; i < n; i++) {
        var bit = document.createElement('span');
        bit.className = 'theinmag-bm-quiz__confetti-bit';
        var angle = (Math.PI * 2 * i) / n + (Math.random() - 0.5) * 0.6;
        var dist = 50 + Math.random() * 40;
        var dx = Math.cos(angle) * dist;
        var dy = Math.sin(angle) * dist - 26; // upward bias
        bit.style.setProperty('--dx', dx + 'px');
        bit.style.setProperty('--dy', dy + 'px');
        bit.style.setProperty('--rot', (Math.random() * 720 - 360) + 'deg');
        bit.style.background = confettiColors[i % confettiColors.length];
        container.appendChild(bit);
      }

      setTimeout(function () {
        if (container.parentNode) container.parentNode.removeChild(container);
      }, 900);
    }

    /* ----------------------------------------------------------------
       Click handlers
       ---------------------------------------------------------------- */
    function onKidClick(kid) {
      var blockId = kid.getAttribute('data-block-id');
      if (resolvedBlockIds[blockId]) return;
      if (kid.classList.contains('is-resolved')) return;

      if (primedKid === kid) {
        // Tapping a primed kid again unprimes it.
        unprimeKid();
        setStatus('');
        return;
      }
      primeKid(kid);
    }

    function onAdultClick(adult) {
      var adultBlockId = adult.getAttribute('data-block-id');
      if (resolvedBlockIds[adultBlockId]) return;

      if (!primedKid) {
        setStatus('Tap a kid first.');
        return;
      }

      var kidBlockId = primedKid.getAttribute('data-block-id');
      var kidEl = primedKid;
      var kidName = kidEl.getAttribute('data-kid-name') || '';
      unprimeKid();

      if (kidBlockId === adultBlockId) {
        /* CORRECT match for this adult */
        var isPaired = adult.getAttribute('data-paired') === 'true';

        if (!isPaired) {
          // Solo - immediate full reveal.
          lockBlock(adultBlockId);
          revealCard(getRevealCard(adultBlockId));
          burstConfetti(adult);
          setStatus("Yes - that's the one.");
          checkAllDone();
          return;
        }

        // Paired - track progress.
        var found = pairsInProgress[adultBlockId] || [];
        found.push(kidEl);
        pairsInProgress[adultBlockId] = found;
        kidEl.classList.add('is-resolved');
        kidEl.setAttribute('aria-disabled', 'true');

        if (found.length >= 2) {
          // Pair complete.
          lockBlock(adultBlockId);
          revealCard(getRevealCard(adultBlockId));
          burstConfetti(adult);
          setStatus("Yes - that's both of them.");
          checkAllDone();
        } else {
          // First of two found.
          adult.classList.add('is-pair-progress');
          adult.setAttribute('aria-pressed', 'true');
          burstConfetti(adult);
          setStatus(pairedHint);
        }
        return;
      }

      /* WRONG: kid belongs to a different block. Reveal the kid's
         actual block (so the user learns who that kid grew into).
         Lock the kid's whole block. The wrong adult stays available. */
      var correctBlockId = kidBlockId;
      var correctRevealCard = getRevealCard(correctBlockId);
      var correctName = '';
      if (correctRevealCard) {
        var nameEl = correctRevealCard.querySelector('.theinmag-bm-quiz__reveal-name');
        if (nameEl) correctName = nameEl.textContent.trim();
      }

      lockBlock(correctBlockId);
      revealCard(correctRevealCard);
      // The wrong adult might have been mid-pair from a previous match;
      // that progress survives the wrong attempt.
      adult.classList.remove('is-active');

      setStatus("Nope - that's actually " + correctName + '.');
      checkAllDone();
    }

    adults.forEach(function (a) {
      a.setAttribute('aria-pressed', 'false');
      a.addEventListener('click', function () { onAdultClick(a); });
    });
    kids.forEach(function (k) {
      k.setAttribute('aria-pressed', 'false');
      k.addEventListener('click', function () { onKidClick(k); });
    });

    /* ----------------------------------------------------------------
       Skip-to-team: reveal everything, hide the board.
       ---------------------------------------------------------------- */
    function skipQuiz() {
      adults.forEach(function (a) {
        var bid = a.getAttribute('data-block-id');
        if (!resolvedBlockIds[bid]) {
          lockBlock(bid);
        }
      });
      reveals.forEach(function (r) { r.removeAttribute('hidden'); });
      if (board) board.style.display = 'none';
      if (skipBtn) skipBtn.style.display = 'none';
      if (allDoneEl) {
        allDoneEl.removeAttribute('hidden');
        allDoneEl.textContent = allDoneMessage;
      }
    }

    if (skipBtn) {
      skipBtn.addEventListener('click', skipQuiz);
    }
  })();
</script>

