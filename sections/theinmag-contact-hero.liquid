{%- comment -%}
  theinmag-contact-hero
  Section 1 of /pages/contact. Small, on-brand purple band - the page's
  visual page-start beneath the sticky header. Lavender bg + dark purple
  heading is the canonical purple pair (design tokens + Principle 16).
  Capped at ~30vh on desktop so the form below is the real focus.

  Page-level JSON-LD (BreadcrumbList + WebPage) lives at the bottom of
  this file because the hero is always the first section on the page.
  Same anchor pattern as theinmag-send-in-hero.
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading
  assign subhead = section.settings.subhead
  assign bg_filename = section.settings.bg_filename
  assign bg_url = ''
  if bg_filename != blank
    assign bg_filename = bg_filename | strip
    assign bg_url = bg_filename | asset_url
  endif

  assign heading_html = heading
  capture emphasis_wrap
    echo '<span class="theinmag-contact-hero__heading-emphasis">IN</span>'
  endcapture
  assign heading_html = heading_html | replace_first: 'IN', emphasis_wrap

  assign section_style = '--cth-pt: ' | append: section.settings.padding_top | append: 'px; --cth-pb: ' | append: section.settings.padding_bottom | append: 'px;'
  if bg_url != blank
    assign section_style = section_style | append: ' --cth-bg: url(' | append: bg_url | append: ');'
  endif
-%}

<section
  class="theinmag-contact-hero{% if bg_url != blank %} theinmag-contact-hero--has-bg{% endif %}"
  data-theinmag-contact-hero
  aria-labelledby="theinmag-contact-hero-heading"
  style="{{ section_style }}"
>
  <div class="theinmag-contact-hero__inner">
    {%- if heading != blank -%}
      <h1 id="theinmag-contact-hero-heading" class="theinmag-contact-hero__heading">{{ heading_html }}</h1>
    {%- endif -%}

    {%- if subhead != blank -%}
      <p class="theinmag-contact-hero__subhead">{{ subhead }}</p>
    {%- endif -%}
  </div>
</section>

{%- comment -%} Page-level JSON-LD - BreadcrumbList + WebPage {%- endcomment -%}
{%- assign page_origin = request.origin | default: 'https://theinmag.com.au' -%}
{%- assign page_url = page_origin | append: '/pages/contact' -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": {{ page_origin | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Contact",
        "item": {{ page_url | json }}
      }
    ]
  }
</script>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": {{ heading | default: 'Get IN touch' | json }},
    "description": {{ subhead | default: 'Got a question for theINmag? Drop us a line, or email heyhey@theinmag.com.au. We read every message and usually reply within 2 business days.' | json }},
    "url": {{ page_url | json }},
    "mainEntityOfPage": {{ page_url | json }},
    "isPartOf": {
      "@type": "WebSite",
      "name": "theINmag",
      "url": {{ page_origin | json }}
    }
  }
</script>

{%- stylesheet -%}
  /* ================================================================
     theinmag-contact-hero
     Lavender band - purple pair (light bg + dark companion). Short
     vertical stretch (~30vh desktop, less on mobile) so the form
     section below is the page's real centre of gravity.
     ================================================================ */

  .theinmag-contact-hero {
    background-color: var(--color-lavender, #E8DEEF);
    color: var(--color-purple-dark, #5D3A7A);
    padding: var(--cth-pt, 48px) clamp(16px, 4vw, 32px) var(--cth-pb, 40px);
    position: relative;
    min-height: clamp(180px, 26vh, 240px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Kid-art watercolour bg sits on top of the lavender fallback. Cover
     keeps the wave shape filling the band at every aspect ratio. */
  .theinmag-contact-hero--has-bg {
    background-image: var(--cth-bg);
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
  }

  @media (min-width: 750px) {
    .theinmag-contact-hero {
      min-height: clamp(220px, 30vh, 320px);
      padding-top: calc(var(--cth-pt, 48px) * 1.4);
      padding-bottom: calc(var(--cth-pb, 40px) * 1.2);
    }
  }

  .theinmag-contact-hero__inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(10px, 1.4vw, 16px);
  }

  .theinmag-contact-hero__heading {
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-size: clamp(34px, 6.5vw, 56px);
    line-height: 1.05;
    letter-spacing: 0;
    margin: 0;
    color: var(--color-purple-dark, #5D3A7A);
    /* Keep "Get IN touch" together on narrow phones - the brand pun
       loses its bite if "Get" wraps away from "IN". */
    text-wrap: balance;
  }

  /* Brand-pun "IN" emphasis - same colour as the rest of the heading,
     just a touch larger so the brand pun lands without colour-clashing
     against the watercolour. */
  .theinmag-contact-hero__heading-emphasis {
    display: inline-block;
    font-size: 1.18em;
    line-height: 1;
    vertical-align: -0.04em;
  }

  .theinmag-contact-hero__subhead {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: clamp(15px, 1.5vw, 17px);
    line-height: 1.5;
    color: var(--color-inky-purple-navy, #2A1F3D);
    opacity: 0.9;
    /* Wide enough that "We read every message. Usually reply within 2
       business days." stays on one line at desktop AND on the Pixel 6
       (412px) viewport - tested both. No max-width clamp because the
       parent .theinmag-contact-hero__inner already caps at 720px. */
    max-width: none;
    margin: 0;
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "theINmag Contact hero",
  "tag": "section",
  "class": "theinmag-contact-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Get IN touch"
    },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Subhead",
      "default": "We read every message. We do our best to reply within two days.",
      "info": "Sits on one line at desktop. Wraps to two balanced lines on mobile."
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "text",
      "id": "bg_filename",
      "label": "Background image filename",
      "default": "contact_header.jpg",
      "info": "File inside theme assets/. Lavender shows as fallback if blank or missing."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "theINmag Contact hero"
    }
  ]
}
{% endschema %}
