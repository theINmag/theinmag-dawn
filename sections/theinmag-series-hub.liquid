{%- comment -%}
  theinmag-series-hub
  Reusable landing page section for a field notes series (Real Kids
  Voices, Real Jobs Real People, teaching and home). One section powers
  every hub; each page template instantiates it with its own settings.

  Structure top to bottom:
    1. Header: small field notes logo eyebrow (links back to the blog
       index), H1 in query language, positioning copy, optional search.
    2. Pinned row ("start here."): curated article blocks.
    3. Post grid: auto-populated from the blog by primary_topic match.
       When group blocks exist, posts render grouped by the
       field_notes.text_type metafield (the PIE split) with a written
       intro per group; posts without a matching group land in the
       catch-all group at the end.
    4. Optional resource card + lightbox (e.g. the PIE poster).
    5. Optional CTA band (send IN, freebies, shop).
    6. Sibling strip ("looking for something else?") so a reader who
       landed on the wrong hub can hop across, never dead-end.

  Matching: topic_match holds comma-separated primary_topic values;
  match_mode 'include' keeps them, 'exclude' keeps everything else.
  NOTE: reads the first 50 posts of the blog (Liquid page cap). Revisit
  with pagination once the blog passes ~50 posts.

  Schema: BreadcrumbList + CollectionPage with an ItemList of the posts.
  Deliberately no kid names, ages or towns in the JSON-LD (same rule as
  the gallery): titles and URLs only.
{%- endcomment -%}

{%- liquid
  assign blog_handle = section.settings.blog_handle | default: 'field-notes'
  assign hub_blog = blogs[blog_handle]

  assign heading = section.settings.heading
  assign intro = section.settings.intro
  assign eyebrow_label = section.settings.eyebrow_label
  assign logo_filename = section.settings.logo_filename | default: 'fieldnotes_logo.png'

  assign topic_match = section.settings.topic_match | downcase
  assign match_mode = section.settings.match_mode | default: 'include'
  assign topic_arr = topic_match | split: ','

  assign show_search = section.settings.show_search
  assign search_placeholder = section.settings.search_placeholder | default: 'search these posts...'
  assign empty_state_text = section.settings.empty_state_text | default: 'Nothing matches that search yet. Try a different word.'

  assign bg_color = section.settings.background_color | default: '#FBF6EA'
  assign bg_src = ''
  if section.settings.background_image != blank
    assign bg_src = section.settings.background_image | image_url: width: 2400
  elsif section.settings.background_filename != blank
    assign bg_src = section.settings.background_filename | asset_url
  endif

  assign pinned_heading = section.settings.pinned_heading | default: 'start here.'
  assign ungrouped_heading = section.settings.ungrouped_heading

  comment
    Collect pinned handles first so the auto grid can skip them.
    Comma-padded string dedupe, same pattern as the article rec grid.
  endcomment
  assign pinned_handles = ','
  for block in section.blocks
    if block.type == 'pinned' and block.settings.article != blank
      assign pinned_handles = pinned_handles | append: block.settings.article.handle | append: ','
    endif
  endfor

  comment
    Build the matched article handle list, newest first (blog order).
  endcomment
  assign matched_handles = ''
  for hub_article in hub_blog.articles limit: 50
    assign a_topic = hub_article.metafields.field_notes.primary_topic | downcase | strip
    assign in_list = false
    for t in topic_arr
      assign t_clean = t | strip
      if t_clean != '' and t_clean == a_topic
        assign in_list = true
      endif
    endfor
    assign keep = false
    if match_mode == 'include' and in_list
      assign keep = true
    elsif match_mode == 'exclude' and in_list == false
      assign keep = true
    endif
    if keep
      assign matched_handles = matched_handles | append: hub_article.handle | append: ','
    endif
  endfor
  assign matched_arr = matched_handles | split: ','

  assign has_groups = false
  for block in section.blocks
    if block.type == 'group'
      assign has_groups = true
    endif
  endfor

  comment
    background_wash lays a semi-opaque cream layer over the pattern via
    a gradient in the same background-image, softening contrast and
    saturation. 0 = pattern at full strength.
  endcomment
  assign bg_wash = section.settings.background_wash | default: 0
  assign wash_alpha = bg_wash | divided_by: 100.0

  capture hub_style
    echo '--series-hub-bg-color: '
    echo bg_color
    echo ';'
    if bg_src != blank
      echo ' --series-hub-bg-image: '
      if bg_wash > 0
        echo 'linear-gradient(rgba(251, 246, 234, '
        echo wash_alpha
        echo '), rgba(251, 246, 234, '
        echo wash_alpha
        echo ')), '
      endif
      echo "url('"
      echo bg_src
      echo "');"
    endif
  endcapture
-%}

{%- comment -%} One card, reused everywhere below via capture-per-article. {%- endcomment -%}

<section
  class="theinmag-series-hub{% if bg_src != blank %} theinmag-series-hub--has-bg{% endif %}{% if section.settings.background_tile %} theinmag-series-hub--bg-tile{% endif %}"
  data-theinmag-series-hub
  aria-labelledby="theinmag-series-hub-heading"
  style="{{ hub_style }}"
>
  <div class="theinmag-series-hub__inner">

    <header class="theinmag-series-hub__header">
      <a class="theinmag-series-hub__eyebrow" href="{{ hub_blog.url | default: '/blogs/field-notes' }}">
        <img
          src="{{ logo_filename | asset_url }}"
          alt="field notes"
          class="theinmag-series-hub__eyebrow-logo"
          width="800"
          height="320"
          loading="eager"
        >
        {%- if eyebrow_label != blank -%}
          <span class="theinmag-series-hub__eyebrow-label">{{ eyebrow_label }}</span>
        {%- endif -%}
      </a>

      {%- if heading != blank -%}
        <h1 id="theinmag-series-hub-heading" class="theinmag-series-hub__heading">{{ heading }}</h1>
      {%- endif -%}

      {%- if intro != blank -%}
        <div class="theinmag-series-hub__intro">{{ intro }}</div>
      {%- endif -%}

      {%- if show_search -%}
        <form class="theinmag-series-hub__search" role="search" data-hub-search onsubmit="return false;">
          <label class="visually-hidden" for="theinmag-series-hub-input">Search this collection</label>
          <span class="theinmag-series-hub__search-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
              <circle cx="11" cy="11" r="7"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </span>
          <input
            id="theinmag-series-hub-input"
            type="search"
            class="theinmag-series-hub__input"
            placeholder="{{ search_placeholder | escape }}"
            autocomplete="off"
            data-hub-input
          >
        </form>
      {%- endif -%}
    </header>

    {%- comment -%} 2. Pinned row {%- endcomment -%}
    {%- assign pinned_count = 0 -%}
    {%- capture pinned_cards -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'pinned' and block.settings.article != blank -%}
          {%- assign pa = block.settings.article -%}
          {%- render 'theinmag-series-hub-card', article: pa, variant: 'pinned', pin_note: block.settings.note, shopify_attrs: block.shopify_attributes -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'pinned' and block.settings.article != blank -%}
        {%- assign pinned_count = pinned_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if pinned_count > 0 -%}
      <div class="theinmag-series-hub__pinned">
        <h2 class="theinmag-series-hub__group-heading">{{ pinned_heading }}</h2>
        <div class="theinmag-series-hub__pinned-row">
          {{ pinned_cards }}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} 3. Post grid, grouped or flat {%- endcomment -%}
    {%- if has_groups -%}
      {%- assign grouped_handles = ',' -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'group' -%}
          {%- assign group_value = block.settings.text_type | downcase | strip -%}
          {%- capture group_cards -%}
            {%- for h in matched_arr -%}
              {%- if h == blank -%}{%- continue -%}{%- endif -%}
              {%- assign needle = ',' | append: h | append: ',' -%}
              {%- if pinned_handles contains needle -%}{%- continue -%}{%- endif -%}
              {%- assign ga = articles[h] -%}
              {%- if ga == blank -%}{%- continue -%}{%- endif -%}
              {%- assign a_type = ga.metafields.field_notes.text_type | downcase | strip -%}
              {%- if a_type == group_value -%}
                {%- render 'theinmag-series-hub-card', article: ga, variant: 'grid' -%}
                {%- assign grouped_handles = grouped_handles | append: h | append: ',' -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endcapture -%}
          {%- assign group_cards_stripped = group_cards | strip -%}
          {%- if group_cards_stripped != blank -%}
            <div class="theinmag-series-hub__group" data-hub-group {{ block.shopify_attributes }}>
              <h2 class="theinmag-series-hub__group-heading">{{ block.settings.heading }}</h2>
              {%- if block.settings.copy != blank -%}
                <p class="theinmag-series-hub__group-copy">{{ block.settings.copy }}</p>
              {%- endif -%}
              <div class="theinmag-series-hub__grid">
                {{ group_cards }}
              </div>
            </div>
          {%- elsif block.settings.show_when_empty -%}
            <div class="theinmag-series-hub__group" data-hub-group {{ block.shopify_attributes }}>
              <h2 class="theinmag-series-hub__group-heading">{{ block.settings.heading }}</h2>
              {%- if block.settings.copy != blank -%}
                <p class="theinmag-series-hub__group-copy">{{ block.settings.copy }}</p>
              {%- endif -%}
              {%- if block.settings.empty_copy != blank -%}
                <p class="theinmag-series-hub__group-empty">{{ block.settings.empty_copy }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%} Catch-all: matched posts no group claimed. {%- endcomment -%}
      {%- capture leftover_cards -%}
        {%- for h in matched_arr -%}
          {%- if h == blank -%}{%- continue -%}{%- endif -%}
          {%- assign needle = ',' | append: h | append: ',' -%}
          {%- if pinned_handles contains needle -%}{%- continue -%}{%- endif -%}
          {%- if grouped_handles contains needle -%}{%- continue -%}{%- endif -%}
          {%- assign la = articles[h] -%}
          {%- if la == blank -%}{%- continue -%}{%- endif -%}
          {%- render 'theinmag-series-hub-card', article: la, variant: 'grid' -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- assign leftover_stripped = leftover_cards | strip -%}
      {%- if leftover_stripped != blank -%}
        <div class="theinmag-series-hub__group" data-hub-group>
          {%- if ungrouped_heading != blank -%}
            <h2 class="theinmag-series-hub__group-heading">{{ ungrouped_heading }}</h2>
          {%- endif -%}
          <div class="theinmag-series-hub__grid">
            {{ leftover_cards }}
          </div>
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="theinmag-series-hub__group" data-hub-group>
        <div class="theinmag-series-hub__grid">
          {%- for h in matched_arr -%}
            {%- if h == blank -%}{%- continue -%}{%- endif -%}
            {%- assign needle = ',' | append: h | append: ',' -%}
            {%- if pinned_handles contains needle -%}{%- continue -%}{%- endif -%}
            {%- assign fa = articles[h] -%}
            {%- if fa == blank -%}{%- continue -%}{%- endif -%}
            {%- render 'theinmag-series-hub-card', article: fa, variant: 'grid' -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    <p class="theinmag-series-hub__empty" data-hub-empty hidden>{{ empty_state_text }}</p>

    {%- comment -%} 4. Resource card + lightbox {%- endcomment -%}
    {%- if section.settings.resource_heading != blank and section.settings.resource_image != blank -%}
      <aside class="theinmag-series-hub__resource">
        <div class="theinmag-series-hub__resource-body">
          <h2 class="theinmag-series-hub__resource-heading">{{ section.settings.resource_heading }}</h2>
          {%- if section.settings.resource_copy != blank -%}
            <p class="theinmag-series-hub__resource-copy">{{ section.settings.resource_copy }}</p>
          {%- endif -%}
          <button type="button" class="theinmag-series-hub__resource-button" data-hub-resource-open>
            {{ section.settings.resource_button_label | default: 'have a look' }}
          </button>
        </div>
        <button type="button" class="theinmag-series-hub__resource-thumb" data-hub-resource-open aria-label="Open {{ section.settings.resource_heading | escape }}">
          <img
            src="{{ section.settings.resource_image | image_url: width: 600 }}"
            alt="{{ section.settings.resource_image_alt | default: section.settings.resource_heading | escape }}"
            loading="lazy"
            width="600"
            height="450"
          >
        </button>
      </aside>

      <dialog class="theinmag-series-hub__lightbox" data-hub-resource-dialog>
        <button type="button" class="theinmag-series-hub__lightbox-close" data-hub-resource-close aria-label="Close">&times;</button>
        <img
          src="{{ section.settings.resource_image | image_url: width: 1800 }}"
          alt="{{ section.settings.resource_image_alt | default: section.settings.resource_heading | escape }}"
          loading="lazy"
        >
        {%- if section.settings.resource_download_url != blank -%}
          <a class="theinmag-series-hub__lightbox-download" href="{{ section.settings.resource_download_url }}" target="_blank" rel="noopener">
            {{ section.settings.resource_download_label | default: 'download the poster' }}
          </a>
        {%- endif -%}
      </dialog>
    {%- endif -%}

    {%- comment -%} 5. CTA band {%- endcomment -%}
    {%- if section.settings.cta_heading != blank -%}
      <aside class="theinmag-series-hub__cta">
        <div class="theinmag-series-hub__cta-body">
          <h2 class="theinmag-series-hub__cta-heading">{{ section.settings.cta_heading }}</h2>
          {%- if section.settings.cta_copy != blank -%}
            <p class="theinmag-series-hub__cta-copy">{{ section.settings.cta_copy }}</p>
          {%- endif -%}
        </div>
        {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
          <a class="theinmag-series-hub__cta-button" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a>
        {%- endif -%}
      </aside>
    {%- endif -%}

    {%- comment -%} 6. Sibling strip {%- endcomment -%}
    {%- assign sibling_count = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'sibling' -%}
        {%- assign sibling_count = sibling_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if sibling_count > 0 -%}
      <nav class="theinmag-series-hub__siblings" aria-label="Other field notes collections">
        <span class="theinmag-series-hub__siblings-label">{{ section.settings.siblings_label | default: 'looking for something else?' }}</span>
        <div class="theinmag-series-hub__siblings-links">
          {%- for block in section.blocks -%}
            {%- if block.type == 'sibling' -%}
              <a href="{{ block.settings.url }}" class="theinmag-series-hub__sibling" {{ block.shopify_attributes }}>{{ block.settings.label }} &rarr;</a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </nav>
    {%- endif -%}

  </div>
</section>

{%- comment -%} JSON-LD: BreadcrumbList + CollectionPage. No kid details. {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | append: '/' | json }} },
    { "@type": "ListItem", "position": 2, "name": "Field notes", "item": {{ shop.url | append: hub_blog.url | json }} },
    { "@type": "ListItem", "position": 3, "name": {{ page.title | json }}, "item": {{ shop.url | append: page.url | json }} }
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": {{ page.title | json }},
  "url": {{ shop.url | append: page.url | json }},
  "description": {{ intro | strip_html | truncate: 300 | json }},
  "isFamilyFriendly": true,
  "publisher": {
    "@type": "Organization",
    "name": "theINmag",
    "url": {{ shop.url | json }}
  },
  "hasPart": {
    "@type": "ItemList",
    "itemListElement": [
      {%- assign li = 0 -%}
      {%- for h in matched_arr -%}
        {%- if h == blank -%}{%- continue -%}{%- endif -%}
        {%- assign sa = articles[h] -%}
        {%- if sa == blank -%}{%- continue -%}{%- endif -%}
        {%- assign li = li | plus: 1 -%}
        {%- if li > 1 -%},{%- endif -%}
        { "@type": "ListItem", "position": {{ li }}, "name": {{ sa.title | json }}, "url": {{ shop.url | append: sa.url | json }} }
      {%- endfor -%}
    ]
  }
}
</script>

{%- stylesheet -%}
  .theinmag-series-hub {
    background-color: var(--series-hub-bg-color, #FBF6EA);
    padding: var(--space-2xl, 48px) 0 var(--space-3xl, 64px);
    color: var(--color-inky-purple-navy, #2A1F3D);
  }

  .theinmag-series-hub--has-bg {
    background-image: var(--series-hub-bg-image);
    background-position: top center;
    background-size: cover;
    background-repeat: no-repeat;
  }

  /* Tiled mode: for drawn pattern assets (the sandy kid pattern), which
     read as texture at ~640px tiles but as giant blurry shapes at
     cover scale. */
  .theinmag-series-hub--bg-tile {
    background-size: 640px auto;
    background-repeat: repeat;
  }

  .theinmag-series-hub__inner {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 var(--space-md, 16px);
  }

  /* --- Header --- */

  .theinmag-series-hub__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm, 8px);
    text-decoration: none;
    color: inherit;
  }

  .theinmag-series-hub__eyebrow-logo {
    width: 110px;
    height: auto;
    display: block;
  }

  .theinmag-series-hub__eyebrow-label {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .theinmag-series-hub__heading {
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-size: clamp(32px, 5vw, 52px);
    line-height: 1.08;
    margin: var(--space-md, 16px) 0 0;
    max-width: 22ch;
  }

  .theinmag-series-hub__intro {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 16px;
    line-height: 1.6;
    max-width: 62ch;
    margin-top: var(--space-md, 16px);
  }

  .theinmag-series-hub__intro p {
    margin: 0 0 0.8em;
  }

  .theinmag-series-hub__intro p:last-child {
    margin-bottom: 0;
  }

  /* --- Search (footer-input style, matches the archive) --- */

  .theinmag-series-hub__search {
    position: relative;
    max-width: 420px;
    margin-top: var(--space-lg, 24px);
  }

  .theinmag-series-hub__search-icon {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 18px;
    height: 18px;
    opacity: 0.6;
  }

  .theinmag-series-hub__search-icon svg {
    width: 100%;
    height: 100%;
  }

  .theinmag-series-hub__input {
    width: 100%;
    border: none;
    border-bottom: 2px solid var(--color-inky-purple-navy, #2A1F3D);
    background: transparent;
    padding: 10px 4px 10px 28px;
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 15px;
    color: inherit;
    border-radius: 0;
  }

  .theinmag-series-hub__input:focus {
    outline: none;
    border-bottom-color: var(--color-sage-dark, #4A7C5C);
  }

  /* --- Groups + grid --- */

  .theinmag-series-hub__pinned,
  .theinmag-series-hub__group {
    margin-top: var(--space-2xl, 48px);
  }

  .theinmag-series-hub__group-heading {
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-size: clamp(22px, 3.4vw, 32px);
    margin: 0 0 var(--space-sm, 8px);
  }

  .theinmag-series-hub__group-copy {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 15px;
    line-height: 1.6;
    max-width: 62ch;
    margin: 0 0 var(--space-lg, 24px);
    opacity: 0.85;
  }

  .theinmag-series-hub__group-empty {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 14px;
    font-style: italic;
    opacity: 0.7;
  }

  .theinmag-series-hub__pinned-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md, 16px);
  }

  .theinmag-series-hub__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md, 16px);
  }

  @media (min-width: 750px) {
    .theinmag-series-hub__pinned-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .theinmag-series-hub__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1200px) {
    .theinmag-series-hub__pinned-row {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .theinmag-series-hub__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .theinmag-series-hub__empty {
    font-family: var(--font-body, 'Inter', sans-serif);
    margin-top: var(--space-xl, 32px);
  }

  /* --- Cards (snippet theinmag-series-hub-card; CSS lives here because
         snippet-level stylesheet blocks are not reliably extracted) --- */

  .theinmag-series-hub__card {
    display: flex;
    flex-direction: column;
    background: #FFFFFF;
    border-radius: var(--radius-md, 12px);
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(42, 31, 61, 0.10);
    text-decoration: none;
    color: var(--color-inky-purple-navy, #2A1F3D);
    transition: transform 160ms ease, box-shadow 160ms ease;
  }

  .theinmag-series-hub__card:hover,
  .theinmag-series-hub__card:focus-visible {
    transform: translateY(-3px);
    box-shadow: 0 6px 16px rgba(42, 31, 61, 0.16);
  }

  .theinmag-series-hub__card-cover {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--color-lavender, #E8DEEF);
  }

  .theinmag-series-hub__card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .theinmag-series-hub__card-image--top {
    object-position: top center;
  }

  .theinmag-series-hub__card-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--color-lavender, #E8DEEF);
  }

  .theinmag-series-hub__card-body {
