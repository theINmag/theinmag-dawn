{%- comment -%}
  theinmag-series-hub  (v2, 2026-08-31 premium rebuild)
  Landing page section for a field notes series. v1 was functionally
  right and visually flat (text-first header, wide search input, small
  uniform boxed cards). v2 follows the measured research on Maude, The
  Modern House, IGNANT and Colossal:

    1. Full-bleed HERO: the series' best artwork edge to edge, title
       and one line ON the image. Under 20 words before the art.
    2. UTILITY ROW: group names as quiet inline text links plus a
       collapsed "search" toggle. Search never parks a wide input in
       the layout.
    3. FEATURED ROW (ungrouped hubs): one large 4:3 lead beside two
       stacked 16:9 pieces (Maude's asymmetric row).
    4. GROUPS (the PIE hub): heading + one line, then lead + stacked
       pair, remainder as natural-aspect masonry (Colossal: artwork is
       never cropped). Lead side alternates per group. Empty groups do
       not render at all.
    5. Optional full-bleed INTERRUPT between groups (pull-line over a
       striking artwork, credited).
    6. Quiet ABOUT block near the foot (the positioning copy lives
       here, not in the hero), editorial CTA, sibling links.

  No boxes, borders, shadows or buttons on pieces anywhere: image plus
  caption only.

  Matching: topic_match holds comma-separated primary_topic values;
  match_mode 'include' keeps them, 'exclude' keeps everything else.
  Reads the first 50 posts of the blog (Liquid cap): revisit past 50.

  Schema: BreadcrumbList + CollectionPage ItemList. Titles and URLs
  only, never kid details in JSON-LD (gallery rule).
{%- endcomment -%}

{%- liquid
  assign blog_handle = section.settings.blog_handle | default: 'field-notes'
  assign hub_blog = blogs[blog_handle]

  assign heading = section.settings.heading
  assign hero_line = section.settings.hero_line
  assign intro = section.settings.intro
  assign eyebrow_label = section.settings.eyebrow_label
  assign logo_filename = section.settings.logo_filename | default: 'fieldnotes_logo.png'

  assign topic_match = section.settings.topic_match | downcase
  assign match_mode = section.settings.match_mode | default: 'include'
  assign topic_arr = topic_match | split: ','

  assign show_search = section.settings.show_search
  assign search_placeholder = section.settings.search_placeholder | default: 'search these pieces...'
  assign empty_state_text = section.settings.empty_state_text | default: 'Nothing matches that search yet. Try a different word.'

  assign bg_color = section.settings.background_color | default: '#FBF6EA'
  assign bg_src = ''
  if section.settings.background_image != blank
    assign bg_src = section.settings.background_image | image_url: width: 2400
  elsif section.settings.background_filename != blank
    assign bg_src = section.settings.background_filename | asset_url
  endif
  assign bg_wash = section.settings.background_wash | default: 0
  assign wash_alpha = bg_wash | divided_by: 100.0

  comment
    Featured picks: 'pinned' blocks, in order. The first becomes the
    lead of the featured row on ungrouped hubs.
  endcomment
  assign pinned_handles = ','
  for block in section.blocks
    if block.type == 'pinned' and block.settings.article != blank
      assign pinned_handles = pinned_handles | append: block.settings.article.handle | append: ','
    endif
  endfor

  comment
    Matched handles, newest first, with featured picks promoted to the
    front so size ranking follows curation.
  endcomment
  assign matched_handles = ''
  for hub_article in hub_blog.articles limit: 50
    assign a_topic = hub_article.metafields.field_notes.primary_topic | downcase | strip
    assign in_list = false
    for t in topic_arr
      assign t_clean = t | strip
      if t_clean != '' and t_clean == a_topic
        assign in_list = true
      endif
    endfor
    assign keep = false
    if match_mode == 'include' and in_list
      assign keep = true
    elsif match_mode == 'exclude' and in_list == false
      assign keep = true
    endif
    if keep
      assign matched_handles = matched_handles | append: hub_article.handle | append: ','
    endif
  endfor

  assign ordered_handles = ''
  for block in section.blocks
    if block.type == 'pinned' and block.settings.article != blank
      assign needle = ',' | append: block.settings.article.handle | append: ','
      assign padded = ',' | append: matched_handles
      if padded contains needle
        assign ordered_handles = ordered_handles | append: block.settings.article.handle | append: ','
      endif
    endif
  endfor
  assign matched_arr = matched_handles | split: ','
  for h in matched_arr
    if h == blank
      continue
    endif
    assign needle = ',' | append: h | append: ','
    assign padded = ',' | append: ordered_handles
    unless padded contains needle
      assign ordered_handles = ordered_handles | append: h | append: ','
    endunless
  endfor
  assign ordered_arr = ordered_handles | split: ','

  assign has_groups = false
  for block in section.blocks
    if block.type == 'group'
      assign has_groups = true
    endif
  endfor

  comment
    Hero image: picker wins, then hero_article's cover, then the first
    ordered piece's cover.
  endcomment
  assign hero_src = ''
  assign hero_alt = heading
  assign hero_top = false
  if section.settings.hero_image != blank
    assign hero_src = section.settings.hero_image | image_url: width: 2400
    assign hero_alt = section.settings.hero_image.alt | default: heading
  elsif section.settings.hero_filename != blank
    assign hero_src = section.settings.hero_filename | asset_url
    assign hero_alt = section.settings.hero_credit | default: heading
  elsif section.settings.hero_article != blank and section.settings.hero_article.image != blank
    assign hero_src = section.settings.hero_article.image | image_url: width: 2400
    assign hero_alt = section.settings.hero_article.image.alt | default: heading
    if section.settings.hero_article.metafields.field_notes.kid_first_name != blank
      assign hero_top = true
    endif
  else
    for h in ordered_arr
      if h == blank
        continue
      endif
      assign ha = articles[h]
      if ha != blank and ha.image != blank
        assign hero_src = ha.image | image_url: width: 2400
        assign hero_alt = ha.image.alt | default: heading
        if ha.metafields.field_notes.kid_first_name != blank
          assign hero_top = true
        endif
        break
      endif
    endfor
  endif

  capture hub_style
    echo '--series-hub-bg-color: '
    echo bg_color
    echo ';'
    if bg_src != blank
      echo ' --series-hub-bg-image: '
      if bg_wash > 0
        echo 'linear-gradient(rgba(251, 246, 234, '
        echo wash_alpha
        echo '), rgba(251, 246, 234, '
        echo wash_alpha
        echo ')), '
      endif
      echo "url('"
      echo bg_src
      echo "');"
    endif
  endcapture

  comment
    Interrupt image: asset filename or picker.
  endcomment
  assign interrupt_src = ''
  if section.settings.interrupt_image != blank
    assign interrupt_src = section.settings.interrupt_image | image_url: width: 2400
  elsif section.settings.interrupt_filename != blank
    assign interrupt_src = section.settings.interrupt_filename | asset_url
  endif
-%}

<section
  class="theinmag-series-hub{% if bg_src != blank %} theinmag-series-hub--has-bg{% endif %}{% if section.settings.background_tile %} theinmag-series-hub--bg-tile{% endif %}"
  data-theinmag-series-hub
  aria-labelledby="theinmag-series-hub-heading"
  style="{{ hub_style }}"
>

  {%- comment -%} 1. HERO, full-bleed. Two modes: 'cover' fills the
      band edge to edge (landscape art); 'panel' stands a portrait
      artwork full-height and uncropped on the right with the text on
      the patterned ground beside it (the IGNANT move, for the 4:5
      blog covers). {%- endcomment -%}
  {%- assign hero_mode = section.settings.hero_mode | default: 'cover' -%}
  <div class="theinmag-series-hub__hero{% if hero_mode == 'panel' %} theinmag-series-hub__hero--panel{% endif %}">
    {%- if hero_src != blank -%}
      <img
        class="theinmag-series-hub__hero-image{% if hero_top %} theinmag-series-hub__hero-image--top{% endif %}"
        {% if section.settings.hero_focus_y != blank %}style="object-position: 50% {{ section.settings.hero_focus_y }}%;"{% endif %}
        src="{{ hero_src }}"
        alt="{{ hero_alt | escape }}"
        loading="eager"
        fetchpriority="high"
        width="2400"
        height="1200"
      >
    {%- endif -%}
    <span class="theinmag-series-hub__hero-scrim" aria-hidden="true"></span>
    <a class="theinmag-series-hub__eyebrow" href="{{ hub_blog.url | default: '/blogs/field-notes' }}">
      <img
        src="{{ logo_filename | asset_url }}"
        alt="field notes"
        class="theinmag-series-hub__eyebrow-logo"
        width="800"
        height="320"
        loading="eager"
      >
      {%- if eyebrow_label != blank -%}
        <span class="theinmag-series-hub__eyebrow-label">{{ eyebrow_label }}</span>
      {%- endif -%}
    </a>
    <div class="theinmag-series-hub__hero-content">
      {%- if heading != blank -%}
        {%- liquid
          comment
            Optional heading emphasis: heading_emphasis names a phrase
            inside the heading rendered slightly larger (the section
            5.5 split-on-keyword move).
          endcomment
          assign h_em = section.settings.heading_emphasis
        -%}
        <h1 id="theinmag-series-hub-heading" class="theinmag-series-hub__heading">
          {%- if h_em != blank and heading contains h_em -%}
            {%- assign h_parts = heading | split: h_em -%}
            {{- h_parts[0] -}}<span class="theinmag-series-hub__heading-em{% if section.settings.heading_break %} theinmag-series-hub__heading-em--newline{% endif %}">{{ h_em }}</span>{{- h_parts[1] -}}
          {%- else -%}
            {{- heading -}}
          {%- endif -%}
        </h1>
      {%- endif -%}
      {%- if hero_line != blank -%}
        <p class="theinmag-series-hub__hero-line">{{ hero_line }}</p>
      {%- endif -%}
      {%- if section.settings.hero_line_2 != blank -%}
        <p class="theinmag-series-hub__hero-line theinmag-series-hub__hero-line--second">{{ section.settings.hero_line_2 }}</p>
      {%- endif -%}
    </div>
    {%- if section.settings.hero_credit != blank -%}
      <span class="theinmag-series-hub__hero-credit">{{ section.settings.hero_credit }}</span>
    {%- endif -%}
  </div>

  {%- comment -%} 2. UTILITY ROW {%- endcomment -%}
  {%- liquid
    assign nav_count = 0
    for block in section.blocks
      if block.type == 'group'
        assign nav_count = nav_count | plus: 1
      endif
    endfor
  -%}
  <div class="theinmag-series-hub__inner">
    <div class="theinmag-series-hub__utility">
      {%- if has_groups -%}
        <nav class="theinmag-series-hub__toggle" aria-label="Filter pieces by text type" data-hub-toggle>
          <button type="button" class="theinmag-series-hub__chip is-active" data-text-type-filter="all">all</button>
          {%- for block in section.blocks -%}
            {%- if block.type == 'group' -%}
              <button type="button" class="theinmag-series-hub__chip" data-text-type-filter="{{ block.settings.text_type | downcase | strip }}">{{ block.settings.nav_label | default: block.settings.text_type }}</button>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}
      {%- if show_search -%}
        <form class="theinmag-series-hub__search" role="search" onsubmit="return false;">
          <label class="visually-hidden" for="theinmag-series-hub-input">Search this collection</label>
          <span class="theinmag-series-hub__search-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
              <circle cx="11" cy="11" r="7"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </span>
          <input
            id="theinmag-series-hub-input"
            type="search"
            class="theinmag-series-hub__input"
            placeholder="{{ search_placeholder | escape }}"
            autocomplete="off"
            data-hub-input
          >
        </form>
      {%- endif -%}
    </div>

    {%- comment -%} 3 + 4. PIECES. Grouped hubs render ONE continuous
        library of every piece (the flick-through), filtered live by
        the text-type chips and the search box together. {%- endcomment -%}
    {%- if has_groups -%}
      <div class="theinmag-series-hub__group" data-hub-group>
        <div class="theinmag-series-hub__masonry">
          {%- for h in ordered_arr -%}
            {%- if h == blank -%}{%- continue -%}{%- endif -%}
            {%- assign la = articles[h] -%}
            {%- if la == blank -%}{%- continue -%}{%- endif -%}
            {%- render 'theinmag-series-hub-card', article: la, variant: 'natural' -%}
          {%- endfor -%}
        </div>
      </div>

    {%- else -%}
      {%- comment -%} Ungrouped: featured row, optional interrupt, masonry. {%- endcomment -%}
      {%- assign real_count = 0 -%}
      {%- for h in ordered_arr -%}
        {%- if h != blank -%}{%- assign real_count = real_count | plus: 1 -%}{%- endif -%}
      {%- endfor -%}

      <div class="theinmag-series-hub__group" data-hub-group>
        <div class="theinmag-series-hub__row">
          <div class="theinmag-series-hub__row-lead">
            {%- assign li = 0 -%}
            {%- for h in ordered_arr -%}
              {%- if h == blank -%}{%- continue -%}{%- endif -%}
              {%- assign li = li | plus: 1 -%}
              {%- if li == 1 -%}
                {%- assign la = articles[h] -%}
                {%- render 'theinmag-series-hub-card', article: la, variant: 'lead' -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
          {%- if real_count > 1 -%}
            <div class="theinmag-series-hub__row-side">
              {%- assign li = 0 -%}
              {%- for h in ordered_arr -%}
                {%- if h == blank -%}{%- continue -%}{%- endif -%}
                {%- assign li = li | plus: 1 -%}
                {%- if li == 2 or li == 3 -%}
                  {%- assign sa = articles[h] -%}
                  {%- render 'theinmag-series-hub-card', article: sa, variant: 'small' -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- if interrupt_src != blank -%}
        {%- render 'theinmag-series-hub-interrupt', src: interrupt_src, line: section.settings.interrupt_line, credit: section.settings.interrupt_credit -%}
      {%- endif -%}

      {%- if real_count > 3 -%}
        <div class="theinmag-series-hub__group" data-hub-group>
          <div class="theinmag-series-hub__masonry">
            {%- assign li = 0 -%}
            {%- for h in ordered_arr -%}
              {%- if h == blank -%}{%- continue -%}{%- endif -%}
              {%- assign li = li | plus: 1 -%}
              {%- if li > 3 -%}
                {%- assign na = articles[h] -%}
                {%- render 'theinmag-series-hub-card', article: na, variant: 'natural' -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}

    <p class="theinmag-series-hub__empty" data-hub-empty hidden>{{ empty_state_text }}</p>

    {%- comment -%} Resource card + lightbox (the PIE poster slot) {%- endcomment -%}
    {%- if section.settings.resource_heading != blank and section.settings.resource_image != blank -%}
      <aside class="theinmag-series-hub__resource">
        <div class="theinmag-series-hub__resource-body">
          <h2 class="theinmag-series-hub__resource-heading">{{ section.settings.resource_heading }}</h2>
          {%- if section.settings.resource_copy != blank -%}
            <p class="theinmag-series-hub__resource-copy">{{ section.settings.resource_copy }}</p>
          {%- endif -%}
          <button type="button" class="theinmag-series-hub__resource-button" data-hub-resource-open>
            {{ section.settings.resource_button_label | default: 'have a look' }}
          </button>
        </div>
        <button type="button" class="theinmag-series-hub__resource-thumb" data-hub-resource-open aria-label="Open {{ section.settings.resource_heading | escape }}">
          <img
            src="{{ section.settings.resource_image | image_url: width: 600 }}"
            alt="{{ section.settings.resource_image_alt | default: section.settings.resource_heading | escape }}"
            loading="lazy"
            width="600"
            height="450"
          >
        </button>
      </aside>

      <dialog class="theinmag-series-hub__lightbox" data-hub-resource-dialog>
        <button type="button" class="theinmag-series-hub__lightbox-close" data-hub-resource-close aria-label="Close">&times;</button>
        <img
          src="{{ section.settings.resource_image | image_url: width: 1800 }}"
          alt="{{ section.settings.resource_image_alt | default: section.settings.resource_heading | escape }}"
          loading="lazy"
        >
        {%- if section.settings.resource_download_url != blank -%}
          <a class="theinmag-series-hub__lightbox-download" href="{{ section.settings.resource_download_url }}" target="_blank" rel="noopener">
            {{ section.settings.resource_download_label | default: 'download the poster' }}
          </a>
        {%- endif -%}
      </dialog>
    {%- endif -%}

    {%- comment -%} ABOUT: the positioning copy, quiet, near the foot {%- endcomment -%}
    {%- if intro != blank -%}
      <aside class="theinmag-series-hub__about">
        {%- if section.settings.about_heading != blank -%}
          <h2 class="theinmag-series-hub__about-heading">{{ section.settings.about_heading }}</h2>
        {%- endif -%}
        <div class="theinmag-series-hub__about-body">{{ intro }}</div>
      </aside>
    {%- endif -%}

    {%- comment -%} FAQ: genuine searcher questions, native accordions so
        every answer stays in the DOM for AI engines. {%- endcomment -%}
    {%- assign faq_count = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'faq' -%}
        {%- assign faq_count = faq_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if faq_count > 0 -%}
      <section class="theinmag-series-hub__faq" aria-labelledby="theinmag-series-hub-faq-heading">
        <h2 id="theinmag-series-hub-faq-heading" class="theinmag-series-hub__faq-heading">{{ section.settings.faq_heading | default: 'Questions teachers ask us.' }}</h2>
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq' -%}
            <details class="theinmag-series-hub__faq-item" {{ block.shopify_attributes }}>
              <summary class="theinmag-series-hub__faq-question">
                <h3 class="theinmag-series-hub__faq-question-text">{{ block.settings.question }}</h3>
                <span class="theinmag-series-hub__faq-chevron" aria-hidden="true">&#9662;</span>
              </summary>
              <div class="theinmag-series-hub__faq-answer">{{ block.settings.answer }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </section>
    {%- endif -%}

    {%- comment -%} CTA, editorial {%- endcomment -%}
    {%- if section.settings.cta_heading != blank -%}
      <aside class="theinmag-series-hub__cta">
        <div class="theinmag-series-hub__cta-body">
          <h2 class="theinmag-series-hub__cta-heading">{{ section.settings.cta_heading }}</h2>
          {%- if section.settings.cta_copy != blank -%}
            <p class="theinmag-series-hub__cta-copy">{{ section.settings.cta_copy }}</p>
          {%- endif -%}
        </div>
        {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
          <a class="theinmag-series-hub__cta-button" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label }}</a>
        {%- endif -%}
      </aside>
    {%- endif -%}

    {%- comment -%} Sibling strip {%- endcomment -%}
    {%- assign sibling_count = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'sibling' -%}
        {%- assign sibling_count = sibling_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if sibling_count > 0 -%}
      <nav class="theinmag-series-hub__siblings" aria-label="Other field notes collections">
        <span class="theinmag-series-hub__siblings-label">{{ section.settings.siblings_label | default: 'looking for something else?' }}</span>
        <div class="theinmag-series-hub__siblings-links">
          {%- for block in section.blocks -%}
            {%- if block.type == 'sibling' -%}
              <a href="{{ block.settings.url }}" class="theinmag-series-hub__sibling" {{ block.shopify_attributes }}>{{ block.settings.label }} &rarr;</a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </nav>
    {%- endif -%}

  </div>
</section>

{%- if faq_count > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- assign fi = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'faq' -%}
        {%- assign fi = fi | plus: 1 -%}
        {%- if fi > 1 -%},{%- endif -%}
        {
          "@type": "Question",
          "name": {{ block.settings.question | strip_html | strip | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ block.settings.answer | strip_html | strip | json }}
          }
        }
      {%- endif -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{%- comment -%} JSON-LD: BreadcrumbList + CollectionPage. No kid details. {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | append: '/' | json }} },
    { "@type": "ListItem", "position": 2, "name": "Field notes", "item": {{ shop.url | append: hub_blog.url | json }} },
    { "@type": "ListItem", "position": 3, "name": {{ page.title | json }}, "item": {{ shop.url | append: page.url | json }} }
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": {{ page.title | json }},
  "url": {{ shop.url | append: page.url | json }},
  "description": {{ intro | strip_html | truncate: 300 | json }},
  "isFamilyFriendly": true,
  "publisher": {
    "@type": "Organization",
    "name": "theINmag",
    "url": {{ shop.url | json }}
  },
  "hasPart": {
    "@type": "ItemList",
    "itemListElement": [
      {%- assign li = 0 -%}
      {%- for h in matched_arr -%}
        {%- if h == blank -%}{%- continue -%}{%- endif -%}
        {%- assign sa = articles[h] -%}
        {%- if sa == blank -%}{%- continue -%}{%- endif -%}
        {%- assign li = li | plus: 1 -%}
        {%- if li > 1 -%},{%- endif -%}
        { "@type": "ListItem", "position": {{ li }}, "name": {{ sa.title | json }}, "url": {{ shop.url | append: sa.url | json }} }
      {%- endfor -%}
    ]
  }
}
</script>

{%- stylesheet -%}
  .theinmag-series-hub {
    background-color: var(--series-hub-bg-color, #FBF6EA);
    padding: 0 0 var(--space-3xl, 64px);
    color: var(--color-inky-purple-navy, #2A1F3D);
  }

  .theinmag-series-hub--has-bg {
    background-image: var(--series-hub-bg-image);
    background-position: top center;
    background-size: cover;
    background-repeat: no-repeat;
  }

  .theinmag-series-hub--bg-tile {
    background-size: 640px auto;
    background-repeat: repeat;
  }

  .theinmag-series-hub__inner {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 var(--space-md, 16px);
  }

  /* ---- 1. Hero: full-bleed, art first ---- */

  .theinmag-series-hub__hero {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    height: clamp(480px, 74vh, 840px);
    overflow: hidden;
    background: var(--color-inky-purple-navy, #2A1F3D);
  }

  .theinmag-series-hub__hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .theinmag-series-hub__hero-image--top {
    object-position: top center;
  }

  .theinmag-series-hub__hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(42, 31, 61, 0.14) 0%, rgba(42, 31, 61, 0.14) 40%, rgba(42, 31, 61, 0.78) 100%);
    pointer-events: none;
  }

  .theinmag-series-hub__hero-content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 var(--space-md, 16px) clamp(28px, 4vw, 56px);
  }

  /* Logo pinned top-right of the artwork, big enough to own the corner. */
  .theinmag-series-hub__eyebrow {
    position: absolute;
    top: clamp(36px, 5vw, 64px);
    left: 0;
    right: 0;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 var(--space-md, 16px);
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-sm, 8px);
    text-decoration: none;
    color: #FFFFFF;
    width: 100%;
    pointer-events: none;
  }

  .theinmag-series-hub__eyebrow-logo {
    width: clamp(140px, 16vw, 230px);
    height: auto;
    display: block;
    filter: brightness(0) invert(1) drop-shadow(0 1px 3px rgba(0, 0, 0, 0.55));
    opacity: 0.95;
    pointer-events: auto;
  }

  .theinmag-series-hub__eyebrow-label {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.85;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.55);
  }

  .theinmag-series-hub__heading {
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-size: clamp(38px, 6vw, 64px);
    line-height: 1.05;
    margin: var(--space-sm, 8px) 0 0;
    max-width: 20ch;
    color: #FFFFFF;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.65), 0 2px 8px rgba(0, 0, 0, 0.45), 0 4px 24px rgba(0, 0, 0, 0.30);
  }

  @media (min-width: 990px) {
    .theinmag-series-hub__heading {
      max-width: none;
    }
  }

  .theinmag-series-hub__heading-em {
    font-size: 1.18em;
    white-space: nowrap;
  }

  .theinmag-series-hub__heading-em--newline {
    display: block;
  }

  .theinmag-series-hub__hero-line--second {
    margin-top: 2px;
  }

  /* ---- Panel mode: portrait art full height and UNCROPPED beside the
          text, everything inside the normal 1320px page grid (no
          full-bleed, no dead middle on wide screens). Ink text, no
          scrim, logo top-left in its natural colour. ---- */

  .theinmag-series-hub__hero--panel {
    background: transparent;
    width: 100%;
    max-width: 1320px;
    height: auto;
    margin: 0 auto;
    padding: clamp(20px, 3vw, 36px) var(--space-md, 16px) var(--space-xl, 32px);
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    grid-template-areas:
      "logo logo"
      "text art";
    column-gap: clamp(32px, 5vw, 80px);
    row-gap: var(--space-lg, 24px);
    align-items: center;
    overflow: visible;
  }

  .theinmag-series-hub__hero--panel .theinmag-series-hub__hero-image {
    position: static;
    grid-area: art;
    justify-self: end;
    width: auto;
    max-width: 100%;
    height: clamp(380px, 56vh, 600px);
    object-fit: contain;
    object-position: right center;
  }

  .theinmag-series-hub__hero--panel .theinmag-series-hub__hero-scrim {
    display: none;
  }

  .theinmag-series-hub__hero--panel .theinmag-series-hub__eyebrow {
    position: static;
    grid-area: logo;
    justify-content: flex-start;
    padding: 0;
    margin: 0;
  }

  .theinmag-series-hub__hero--panel .theinmag-series-hub__eyebrow-logo {
    filter: none;
  }

  .theinmag-series-hub__hero--panel .theinmag-series-hub__hero-content {
    position: static;
    grid-area: text;
    padding: 0;
    max-width: none;
    margin: 0;
  }

  .theinmag-series-hub__hero--panel .theinmag-series-hub__heading,
  .theinmag-series-hub__hero--panel .theinmag-series-hub__hero-line {
    color: var(--color-inky-purple-navy, #2A1F3D);
    text-shadow: none;
  }

  .theinmag-series-hub__hero--panel .theinmag-series-hub__hero-line {
    opacity: 0.85;
  }

  .theinmag-series-hub__hero--panel .theinmag-series-hub__hero-credit {
    position: static;
    grid-area: art;
    align-self: end;
    justify-self: end;
    transform: translateY(calc(100% + 6px));
    color: var(--color-inky-purple-navy, #2A1F3D);
    text-shadow: none;
    opacity: 0.65;
  }

  @media (max-width: 749px) {
    .theinmag-series-hub__hero--panel {
      grid-template-columns: 1fr;
      grid-template-areas:
        "logo"
        "art"
        "text";
      row-gap: var(--space-md, 16px);
    }

    .theinmag-series-hub__hero--panel .theinmag-series-hub__hero-image {
      justify-self: center;
      height: auto;
      width: 100%;
      max-height: 52vh;
    }

    .theinmag-series-hub__hero--panel .theinmag-series-hub__hero-credit {
      justify-self: center;
      transform: none;
    }
  }

  .theinmag-series-hub__hero-credit {
    position: absolute;
    right: var(--space-md, 16px);
    bottom: var(--space-sm, 8px);
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: #FFFFFF;
    opacity: 0.8;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.55);
  }

  .theinmag-series-hub__hero-line {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: clamp(15px, 1.8vw, 18px);
    font-weight: 500;
    color: #FFFFFF;
    opacity: 0.95;
    margin: var(--space-sm, 8px) 0 0;
    max-width: 62ch;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.55), 0 2px 8px rgba(0, 0, 0, 0.35);
  }

  /* ---- 2. Utility row: the big text-type toggle (same voice as the
          blog index's all/kids/adults chips) plus a visible search. ---- */

  .theinmag-series-hub__utility {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md, 16px) var(--space-xl, 32px);
    padding: var(--space-lg, 24px) 0 var(--space-md, 16px);
    border-bottom: 1px solid rgba(42, 31, 61, 0.16);
  }

  .theinmag-series-hub__toggle {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: clamp(16px, 2.4vw, 32px);
  }

  .theinmag-series-hub__chip {
    background: none;
    border: 0;
    padding: 4px 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 500;
    font-size: clamp(20px, 2.4vw, 28px);
    line-height: 1;
    letter-spacing: -0.005em;
    color: var(--color-inky-purple-navy, #2A1F3D);
    opacity: 0.42;
    cursor: pointer;
    transition: opacity 0.15s ease, font-weight 0.15s ease;
  }

  .theinmag-series-hub__chip:hover,
  .theinmag-series-hub__chip:focus-visible {
    opacity: 0.85;
    outline: none;
  }

  .theinmag-series-hub__chip:focus-visible {
    outline: 2px solid var(--color-purple-dark, #5D3A7A);
    outline-offset: 3px;
  }

  .theinmag-series-hub__chip.is-active {
    opacity: 1;
    font-weight: 700;
  }

  .theinmag-series-hub__search {
    position: relative;
    flex: 1 1 260px;
    max-width: 420px;
  }

  .theinmag-series-hub__search-icon {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 18px;
    height: 18px;
    opacity: 0.6;
  }

  .theinmag-series-hub__search-icon svg {
    width: 100%;
    height: 100%;
  }

  .theinmag-series-hub__input {
    width: 100%;
    border: none;
    border-bottom: 2px solid var(--color-inky-purple-navy, #2A1F3D);
    background: transparent;
    padding: 10px 4px 10px 28px;
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 15px;
    color: inherit;
    border-radius: 0;
  }

  .theinmag-series-hub__input:focus {
    outline: none;
    border-bottom-color: var(--color-sage-dark, #4A7C5C);
  }

  /* ---- 3 + 4. Pieces: no chrome, ranked by size ---- */

  .theinmag-series-hub__group {
    margin-top: clamp(40px, 6vw, 72px);
  }

  .theinmag-series-hub__group-heading {
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-size: clamp(24px, 3.4vw, 34px);
    margin: 0 0 var(--space-xs, 4px);
  }

  .theinmag-series-hub__group-copy {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 15px;
    line-height: 1.55;
    max-width: 62ch;
    margin: 0 0 var(--space-lg, 24px);
    opacity: 0.85;
  }

  .theinmag-series-hub__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(24px, 3vw, 40px);
    margin-top: var(--space-lg, 24px);
  }

  @media (min-width: 900px) {
    .theinmag-series-hub__row {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      align-items: start;
    }

    .theinmag-series-hub__row--flip {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    }

    .theinmag-series-hub__row--flip .theinmag-series-hub__row-lead {
      order: 2;
    }

    .theinmag-series-hub__row--flip .theinmag-series-hub__row-side {
      order: 1;
    }
  }

  .theinmag-series-hub__row-side {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 2.5vw, 32px);
  }

  @media (min-width: 900px) {
    .theinmag-series-hub__row-side {
      grid-template-columns: 1fr;
      align-content: start;
    }
  }

  .theinmag-series-hub__masonry {
    columns: 2;
    column-gap: clamp(20px, 2.5vw, 32px);
    margin-top: clamp(28px, 4vw, 48px);
  }

  @media (min-width: 750px) {
    .theinmag-series-hub__masonry {
      columns: 3;
    }
  }

  /* Piece: image + caption, nothing else. */

  .theinmag-series-hub__piece {
    display: block;
    text-decoration: none;
    color: var(--color-inky-purple-navy, #2A1F3D);
  }

  .theinmag-series-hub__masonry .theinmag-series-hub__piece {
    break-inside: avoid;
    margin-bottom: clamp(28px, 4vw, 44px);
  }

  .theinmag-series-hub__piece-frame {
    display: block;
    overflow: hidden;
  }

  .theinmag-series-hub__piece--lead .theinmag-series-hub__piece-frame {
    aspect-ratio: 4 / 3;
  }

  .theinmag-series-hub__piece--small .theinmag-series-hub__piece-frame {
    aspect-ratio: 16 / 9;
  }

  .theinmag-series-hub__piece-frame .theinmag-series-hub__piece-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 400ms ease;
  }

  .theinmag-series-hub__piece-image--top {
    object-position: top center;
  }

  .theinmag-series-hub__piece-image--natural {
    width: 100%;
    height: auto;
    display: block;
  }

  .theinmag-series-hub__piece:hover .theinmag-series-hub__piece-frame .theinmag-series-hub__piece-image,
  .theinmag-series-hub__piece:focus-visible .theinmag-series-hub__piece-frame .theinmag-series-hub__piece-image {
    transform: scale(1.03);
  }

  .theinmag-series-hub__piece:hover .theinmag-series-hub__piece-title,
  .theinmag-series-hub__piece:focus-visible .theinmag-series-hub__piece-title {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1.5px;
  }

  .theinmag-series-hub__piece-caption {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--space-sm, 8px) 0 0;
  }

  .theinmag-series-hub__piece-chip {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-sage-dark, #4A7C5C);
  }

  .theinmag-series-hub__piece-title {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-weight: 700;
    font-size: 17px;
    line-height: 1.3;
  }

  .theinmag-series-hub__piece--lead .theinmag-series-hub__piece-title {
    font-size: clamp(20px, 2.2vw, 26px);
  }

  .theinmag-series-hub__piece-excerpt {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 15px;
    line-height: 1.5;
    opacity: 0.8;
    max-width: 60ch;
  }

  .theinmag-series-hub__piece-byline {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 13px;
    opacity: 0.7;
  }

  .theinmag-series-hub__empty {
    font-family: var(--font-body, 'Inter', sans-serif);
    margin-top: var(--space-xl, 32px);
  }

  /* ---- Full-bleed interrupt (snippet theinmag-series-hub-interrupt;
          CSS lives here, snippet stylesheets are unreliable) ---- */

  .theinmag-series-hub__interrupt {
    position: relative;
    width: 100vw;
    margin: clamp(48px, 7vw, 96px) calc(50% - 50vw) 0;
    height: clamp(320px, 52vh, 560px);
    overflow: hidden;
    background: var(--color-inky-purple-navy, #2A1F3D);
  }

  .theinmag-series-hub__interrupt-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .theinmag-series-hub__interrupt-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(42, 31, 61, 0.10) 0%, rgba(42, 31, 61, 0.10) 45%, rgba(42, 31, 61, 0.62) 100%);
    pointer-events: none;
  }

  .theinmag-series-hub__interrupt-line {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(40px, 6vw, 72px);
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 var(--space-md, 16px);
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-size: clamp(26px, 4vw, 44px);
    line-height: 1.15;
    color: #FFFFFF;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.65), 0 2px 8px rgba(0, 0, 0, 0.45), 0 4px 24px rgba(0, 0, 0, 0.30);
  }

  .theinmag-series-hub__interrupt-credit {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(14px, 2vw, 24px);
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 var(--space-md, 16px);
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: #FFFFFF;
    opacity: 0.85;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.55);
  }

  /* ---- Resource card + lightbox ---- */

  .theinmag-series-hub__resource {
    margin-top: clamp(48px, 6vw, 80px);
    padding-top: var(--space-xl, 32px);
    border-top: 1px solid rgba(42, 31, 61, 0.16);
    display: flex;
    flex-direction: column;
    gap: var(--space-md, 16px);
  }

  @media (min-width: 750px) {
    .theinmag-series-hub__resource {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-xl, 32px);
    }
  }

  .theinmag-series-hub__resource-heading {
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-size: clamp(20px, 3vw, 28px);
    margin: 0 0 var(--space-xs, 4px);
  }

  .theinmag-series-hub__resource-copy {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 15px;
    line-height: 1.6;
    max-width: 52ch;
    margin: 0 0 var(--space-md, 16px);
  }

  .theinmag-series-hub__resource-button {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 14px;
    font-weight: 700;
    background: var(--color-yellow, #F9C23C);
    color: var(--color-inky-purple-navy, #2A1F3D);
    border: none;
    border-radius: 999px;
    padding: 12px 24px;
    cursor: pointer;
    box-shadow: 0 3px 0 var(--color-yellow-shadow, #D4A02E);
  }

  .theinmag-series-hub__resource-thumb {
    border: none;
    background: none;
    padding: 0;
    cursor: pointer;
    flex: 0 0 auto;
  }

  .theinmag-series-hub__resource-thumb img {
    display: block;
    width: 200px;
    max-width: 100%;
    height: auto;
    transform: rotate(-2deg);
    box-shadow: 0 2px 10px rgba(42, 31, 61, 0.15);
  }

  .theinmag-series-hub__lightbox {
    border: none;
    border-radius: var(--radius-md, 12px);
    padding: var(--space-md, 16px);
    max-width: min(92vw, 900px);
    background: #FFFFFF;
  }

  .theinmag-series-hub__lightbox::backdrop {
    background: rgba(42, 31, 61, 0.7);
  }

  .theinmag-series-hub__lightbox img {
    max-width: 100%;
    max-height: 76vh;
    height: auto;
    display: block;
    margin: 0 auto;
  }

  .theinmag-series-hub__lightbox-close {
    position: absolute;
    top: 8px;
    right: 12px;
    border: none;
    background: none;
    font-size: 28px;
    line-height: 1;
    cursor: pointer;
    color: var(--color-inky-purple-navy, #2A1F3D);
  }

  .theinmag-series-hub__lightbox-download {
    display: inline-block;
    margin-top: var(--space-md, 16px);
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 14px;
    font-weight: 700;
    background: var(--color-yellow, #F9C23C);
    color: var(--color-inky-purple-navy, #2A1F3D);
    border-radius: 999px;
    padding: 10px 22px;
    text-decoration: none;
    box-shadow: 0 3px 0 var(--color-yellow-shadow, #D4A02E);
  }

  /* ---- About + CTA + siblings: quiet editorial foot ---- */

  .theinmag-series-hub__about {
    margin: clamp(48px, 6vw, 80px) auto 0;
    padding-top: var(--space-xl, 32px);
    border-top: 1px solid rgba(42, 31, 61, 0.16);
    max-width: 62ch;
    text-align: center;
  }

  .theinmag-series-hub__about-heading {
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-size: clamp(18px, 2.4vw, 24px);
    margin: 0 0 var(--space-sm, 8px);
  }

  .theinmag-series-hub__about-body {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 15px;
    line-height: 1.65;
    opacity: 0.85;
    /* No single-word last lines on the centred block; balance evens
       the heading. Both degrade silently where unsupported. */
    text-wrap: pretty;
  }

  .theinmag-series-hub__about-heading {
    text-wrap: balance;
  }

  .theinmag-series-hub__about-body p {
    margin: 0 0 0.8em;
  }

  .theinmag-series-hub__about-body p:last-child {
    margin-bottom: 0;
  }

  /* ---- FAQ: native details/summary, answers always in the DOM ---- */

  .theinmag-series-hub__faq {
    margin: clamp(40px, 5vw, 64px) auto 0;
    padding-top: var(--space-xl, 32px);
    border-top: 1px solid rgba(42, 31, 61, 0.16);
    max-width: 72ch;
  }

  .theinmag-series-hub__faq-heading {
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-size: clamp(22px, 3.2vw, 30px);
    margin: 0 0 var(--space-md, 16px);
    text-align: center;
  }

  .theinmag-series-hub__faq-item {
    border-bottom: 1px solid rgba(42, 31, 61, 0.14);
  }

  .theinmag-series-hub__faq-question {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md, 16px);
    padding: 14px 2px;
    font-family: var(--font-body, 'Inter', sans-serif);
    font-weight: 600;
    font-size: 16px;
    cursor: pointer;
    list-style: none;
  }

  .theinmag-series-hub__faq-question::-webkit-details-marker {
    display: none;
  }

  .theinmag-series-hub__faq-question-text {
    font-family: inherit;
    font-weight: inherit;
    font-size: inherit;
    line-height: 1.4;
    margin: 0;
  }

  .theinmag-series-hub__faq-chevron {
    flex: 0 0 auto;
    transition: transform 180ms ease;
  }

  .theinmag-series-hub__faq-item[open] .theinmag-series-hub__faq-chevron {
    transform: rotate(180deg);
  }

  .theinmag-series-hub__faq-answer {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 15px;
    line-height: 1.6;
    padding: 0 2px 16px;
    opacity: 0.85;
    max-width: 62ch;
  }

  .theinmag-series-hub__faq-answer p {
    margin: 0 0 0.7em;
  }

