<script>
  (function () {
    var section = document.querySelector('[data-theinmag-series-hub]');
    if (!section) return;

    /* Combined filtering: the text-type chips and the search box work
       together. A piece shows when it matches the active chip AND the
       query. */
    var input = section.querySelector('[data-hub-input]');
    var chips = section.querySelectorAll('[data-text-type-filter]');
    var cards = section.querySelectorAll('[data-hub-card]');
    var groups = section.querySelectorAll('[data-hub-group]');
    var empty = section.querySelector('[data-hub-empty]');
    var activeType = 'all';

    function applyFilters() {
      var q = input ? input.value.trim().toLowerCase() : '';
      var visible = 0;
      cards.forEach(function (card) {
        var hay = card.getAttribute('data-search-hay') || '';
        var type = (card.getAttribute('data-text-type') || '').toLowerCase();
        var typeOk = activeType === 'all' || type === activeType;
        var queryOk = q === '' || hay.indexOf(q) !== -1;
        var show = typeOk && queryOk;
        card.hidden = !show;
        if (show) visible++;
      });
      groups.forEach(function (group) {
        var any = group.querySelector('[data-hub-card]:not([hidden])');
        group.hidden = !any;
      });
      if (empty) empty.hidden = visible > 0;
    }

    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        activeType = (chip.getAttribute('data-text-type-filter') || 'all').toLowerCase();
        chips.forEach(function (c) {
          c.classList.toggle('is-active', c === chip);
        });
        applyFilters();
      });
    });

    if (input) input.addEventListener('input', applyFilters);

    /* Resource lightbox. */
    var dialog = section.querySelector('[data-hub-resource-dialog]');
    if (dialog && typeof dialog.showModal === 'function') {
      section.querySelectorAll('[data-hub-resource-open]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          dialog.showModal();
        });
      });
      var close = dialog.querySelector('[data-hub-resource-close]');
      if (close) {
        close.addEventListener('click', function () {
          dialog.close();
        });
      }
      dialog.addEventListener('click', function (e) {
        if (e.target === dialog) dialog.close();
      });
    }
  })();
</script>

