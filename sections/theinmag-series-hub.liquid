      align-items: center;
      justify-content: space-between;
    }
  }

  .theinmag-series-hub__cta-heading {
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-size: clamp(22px, 3.4vw, 30px);
    margin: 0 0 var(--space-xs, 4px);
    color: inherit;
  }

  .theinmag-series-hub__cta-copy {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 15px;
    line-height: 1.55;
    max-width: 56ch;
    margin: 0;
    opacity: 0.9;
  }

  .theinmag-series-hub__cta-button {
    flex: 0 0 auto;
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 15px;
    font-weight: 700;
    background: var(--color-yellow, #F9C23C);
    color: var(--color-inky-purple-navy, #2A1F3D);
    border-radius: 999px;
    padding: 14px 28px;
    text-decoration: none;
    box-shadow: 0 3px 0 var(--color-yellow-shadow, #D4A02E);
    white-space: nowrap;
  }

  /* --- Sibling strip --- */

  .theinmag-series-hub__siblings {
    margin-top: var(--space-2xl, 48px);
    padding-top: var(--space-lg, 24px);
    border-top: 1px solid rgba(42, 31, 61, 0.18);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm, 8px);
  }

  @media (min-width: 750px) {
    .theinmag-series-hub__siblings {
      flex-direction: row;
      align-items: baseline;
      gap: var(--space-lg, 24px);
    }
  }

  .theinmag-series-hub__siblings-label {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 14px;
    font-weight: 600;
    opacity: 0.75;
  }

  .theinmag-series-hub__siblings-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md, 16px);
  }

  .theinmag-series-hub__sibling {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 14px;
    font-weight: 700;
    color: var(--color-sage-dark, #4A7C5C);
    text-decoration: none;
  }

  .theinmag-series-hub__sibling:hover {
    text-decoration: underline;
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-series-hub__resource-button:hover {
      transform: none;
    }
    .theinmag-series-hub__resource-thumb img {
      transform: none;
    }
  }
{%- endstylesheet -%}

<script>
  (function () {
    var section = document.querySelector('[data-theinmag-series-hub]');
    if (!section) return;

    /* Live search: filter cards by data-search-hay, hide emptied groups. */
    var input = section.querySelector('[data-hub-input]');
    if (input) {
      var cards = section.querySelectorAll('[data-hub-card]');
      var groups = section.querySelectorAll('[data-hub-group]');
      var pinnedWrap = section.querySelector('.theinmag-series-hub__pinned');
      var empty = section.querySelector('[data-hub-empty]');

      input.addEventListener('input', function () {
        var q = input.value.trim().toLowerCase();
        var visible = 0;
        cards.forEach(function (card) {
          var hay = card.getAttribute('data-search-hay') || '';
          var show = q === '' || hay.indexOf(q) !== -1;
          card.hidden = !show;
          if (show) visible++;
        });
        groups.forEach(function (group) {
          var any = group.querySelector('[data-hub-card]:not([hidden])');
          group.hidden = !any;
        });
        if (pinnedWrap) {
          var anyPinned = pinnedWrap.querySelector('[data-hub-card]:not([hidden])');
          pinnedWrap.hidden = !anyPinned;
        }
        if (empty) empty.hidden = visible > 0;
      });
    }

    /* Resource lightbox. */
    var dialog = section.querySelector('[data-hub-resource-dialog]');
    if (dialog && typeof dialog.showModal === 'function') {
      section.querySelectorAll('[data-hub-resource-open]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          dialog.showModal();
        });
      });
      var close = dialog.querySelector('[data-hub-resource-close]');
      if (close) {
        close.addEventListener('click', function () {
          dialog.close();
        });
      }
      dialog.addEventListener('click', function (e) {
        if (e.target === dialog) dialog.close();
      });
    }
  })();
</script>

