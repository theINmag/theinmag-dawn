{%- comment -%}
  theinmag-send-in-hero
  Section 1 of /pages/send-in. Sets the warmth before the kid hits
  the form. Caveat eyebrow -> Post Regular H1 -> Inter subhead ->
  one focused image (kid creation or character) with a real named
  attribution -> single yellow sticker CTA that anchors to the form.

  Page-level JSON-LD (BreadcrumbList + WebPage) lives at the bottom
  of this file - hero is always present, so it's the safest anchor.

  CTA scroll behaviour uses the sticky-header-aware offset pattern
  (pattern library 5.5) so the form lands BELOW the sticky header,
  not behind it.
{%- endcomment -%}

{%- liquid
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign subhead = section.settings.subhead
  assign hero_image = section.settings.hero_image
  assign hero_image_alt = section.settings.hero_image_alt
  assign attribution = section.settings.attribution
  assign cta_label = section.settings.cta_label
  assign cta_anchor = section.settings.cta_anchor

  assign section_style = '--sih-pt: ' | append: section.settings.padding_top | append: 'px; --sih-pb: ' | append: section.settings.padding_bottom | append: 'px;'
-%}

<section
  class="theinmag-send-in-hero"
  data-theinmag-send-in-hero
  aria-labelledby="theinmag-send-in-hero-heading"
  style="{{ section_style }}"
>
  <div class="theinmag-send-in-hero__inner">
    {%- if eyebrow != blank -%}
      <p class="theinmag-send-in-hero__eyebrow">{{ eyebrow }}</p>
    {%- endif -%}

    {%- if heading != blank -%}
      <h1 id="theinmag-send-in-hero-heading" class="theinmag-send-in-hero__heading">{{ heading }}</h1>
    {%- endif -%}

    {%- if subhead != blank -%}
      <p class="theinmag-send-in-hero__subhead">{{ subhead }}</p>
    {%- endif -%}

    {%- if hero_image != blank -%}
      <figure class="theinmag-send-in-hero__figure">
        <div class="theinmag-send-in-hero__image-wrap">
          {{ hero_image | image_url: width: 1200 | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '400, 600, 800, 1000, 1200',
            sizes: '(min-width: 750px) 480px, 80vw',
            class: 'theinmag-send-in-hero__image',
            alt: hero_image_alt
          }}
        </div>
        {%- if attribution != blank -%}
          <figcaption class="theinmag-send-in-hero__attribution">{{ attribution }}</figcaption>
        {%- endif -%}
      </figure>
    {%- endif -%}

    {%- if cta_label != blank and cta_anchor != blank -%}
      <a
        class="theinmag-btn theinmag-btn--primary theinmag-send-in-hero__cta"
        href="{{ cta_anchor }}"
        data-theinmag-send-in-hero-cta
      >{{ cta_label }}</a>
    {%- endif -%}
  </div>
</section>

{%- comment -%} Page-level JSON-LD - BreadcrumbList + WebPage {%- endcomment -%}
{%- assign page_origin = request.origin | default: 'https://theinmag.com.au' -%}
{%- assign page_url = page_origin | append: '/pages/send-in' -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": {{ page_origin | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Send IN",
        "item": {{ page_url | json }}
      }
    ]
  }
</script>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": {{ heading | default: 'Send IN your creation' | json }},
    "description": {{ subhead | default: 'Real kids. Real creations. Three issues a year. Yours could be next.' | json }},
    "url": {{ page_url | json }},
    "mainEntityOfPage": {{ page_url | json }},
    "isPartOf": {
      "@type": "WebSite",
      "name": "theINmag",
      "url": {{ page_origin | json }}
    }
  }
</script>

{%- stylesheet -%}
  /* ================================================================
     theinmag-send-in-hero
     Cream warm off-white background (#FDFAF5 - this page's "card"
     companion to the locked cream #FBF6EA used in even sections).
     Generous vertical breathing room - this is the visual page-start
     beneath the sticky header.
     ================================================================ */

  .theinmag-send-in-hero {
    background-color: #FDFAF5;
    color: var(--color-inky-purple-navy, #2A1F3D);
    padding: var(--sih-pt, 64px) clamp(16px, 4vw, 32px) var(--sih-pb, 48px);
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 750px) {
    .theinmag-send-in-hero {
      padding-top: calc(var(--sih-pt, 64px) * 1.5);
      padding-bottom: calc(var(--sih-pb, 48px) * 1.33);
    }
  }

  .theinmag-send-in-hero__inner {
    position: relative;
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(14px, 2vw, 20px);
  }

  /* Caveat eyebrow - small, yellow, hand-lettered. Sits above the H1
     like a stamp. Capital-IN preserved by writing the default text
     literally; visitors should never see it lowercased. */
  .theinmag-send-in-hero__eyebrow {
    font-family: var(--font-emphasis, 'Caveat', cursive);
    font-weight: 700;
    font-size: clamp(20px, 2.4vw, 26px);
    line-height: 1;
    color: var(--color-yellow, #F9C23C);
    margin: 0;
    letter-spacing: 0.01em;
    /* Subtle text-shadow lifts yellow off the cream background - low
       contrast against #FDFAF5 otherwise. Same pattern memory note:
       white-on-scrim is for photography, but here the colour itself
       is the issue, so a faint inky shadow does the lifting. */
    text-shadow: 0 1px 0 rgba(42, 31, 61, 0.06);
  }

  .theinmag-send-in-hero__heading {
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-size: clamp(34px, 6.5vw, 60px);
    line-height: 1.05;
    letter-spacing: 0;
    margin: 0;
    color: var(--color-inky-purple-navy, #2A1F3D);
    /* Stops "Send IN your creation" from breaking awkwardly between
       "Send" and "IN" on narrow phones - keep the brand pun together. */
    text-wrap: balance;
  }

  .theinmag-send-in-hero__subhead {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: clamp(16px, 1.6vw, 18px);
    line-height: 1.6;
    color: var(--color-inky-purple-navy, #2A1F3D);
    opacity: 0.85;
    max-width: 52ch;
    margin: 0;
  }

  /* ================================================================
     Image - one focused kid creation or character. Floats gently
     unless reduced motion is set. The figure carries the attribution
     so screen readers announce the credit alongside the image.
     ================================================================ */

  .theinmag-send-in-hero__figure {
    margin: clamp(8px, 1.4vw, 16px) 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(8px, 1vw, 12px);
  }

  /* Wrap exists so the float animation lives on the wrap, not the
     <img> itself - keeps Dawn's image_tag classes / sizing untouched.
     Specificity-prefix to dodge Dawn's div:empty rule (it's not empty
     here, but the prefix is the safe convention). */
  .theinmag-send-in-hero .theinmag-send-in-hero__image-wrap {
    width: clamp(220px, 60vw, 480px);
    animation: theinmag-send-in-hero-float 3s ease-in-out infinite;
  }

  .theinmag-send-in-hero__image {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-lg, 20px);
  }

  .theinmag-send-in-hero__attribution {
    font-family: var(--font-emphasis, 'Caveat', cursive);
    font-weight: 700;
    font-size: clamp(15px, 1.4vw, 17px);
    line-height: 1.3;
    color: var(--color-purple-dark, #5D3A7A);
    margin: 0;
    max-width: 36ch;
    text-align: center;
  }

  /* ================================================================
     CTA - locked sticker convention from theinmag-base.css. Anchor
     scroll handled by JS below for sticky-header offset.
     ================================================================ */

  .theinmag-send-in-hero__cta {
    margin-top: clamp(8px, 1.4vw, 16px);
  }

  /* ================================================================
     Float keyframes. Kept short (-8px) so it reads as "the creation
     is alive on the page" not "the page is fidgeting".
     ================================================================ */

  @keyframes theinmag-send-in-hero-float {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-8px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-send-in-hero .theinmag-send-in-hero__image-wrap {
      animation: none;
    }
  }
{%- endstylesheet -%}

<script>
  (function () {
    var cta = document.querySelector('[data-theinmag-send-in-hero-cta]');
    if (!cta) return;

    cta.addEventListener('click', function (evt) {
      var href = cta.getAttribute('href') || '';
      if (href.charAt(0) !== '#') return;
      var target = document.querySelector(href);
      if (!target) return;

      evt.preventDefault();
      var header = document.querySelector('.theinmag-header-section') || document.querySelector('header[role="banner"]');
      var headerH = header ? header.offsetHeight : 0;
      var top = target.getBoundingClientRect().top + window.pageYOffset - headerH - 12;
      var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: Math.max(0, top), behavior: prefersReducedMotion ? 'auto' : 'smooth' });

      /* Move keyboard focus to the target so tab order resumes from
         the form, not from the hero CTA the user just pressed. */
      target.setAttribute('tabindex', '-1');
      target.focus({ preventScroll: true });
    });
  })();
</script>

{% schema %}
{
  "name": "theINmag Send IN hero",
  "tag": "section",
  "class": "theinmag-send-in-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Send IN",
      "info": "Caveat hand-lettered, sits above the headline."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Send IN your creation"
    },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Subhead",
      "default": "Real kids. Real creations. Three issues a year. Yours could be next."
    },
    {
      "type": "header",
      "content": "Hero image"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image",
      "info": "One focused kid creation or character. JPG under 400KB. Filename prefix HERO_send-in-."
    },
    {
      "type": "text",
      "id": "hero_image_alt",
      "label": "Hero image alt text",
      "info": "Descriptive and keyword-aware. Example: Watercolour painting of a galah by Maya M., age 9, from Fremantle WA."
    },
    {
      "type": "text",
      "id": "attribution",
      "label": "Attribution caption",
      "info": "Format: First name + initial, age, town and state. Example: Maya M., age 9 | Fremantle WA."
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Jump to the form ↓"
    },
    {
      "type": "text",
      "id": "cta_anchor",
      "label": "Anchor target",
      "default": "#send-in-form",
      "info": "Anchor on this page. Default lands on the JotForm section."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "theINmag Send IN hero"
    }
  ]
}
{% endschema %}
