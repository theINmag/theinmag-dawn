{%- comment -%}
  theinmag-video-row  (2026-10-20, Webster)
  A row of video cards read from snippets/theinmag-videos-data. Used:
    - twice on the /pages/videos hub (one per show, as its chapter)
    - at the foot of every watch page ("more videos", current excluded)
    - on the homepage and the parents / homeschoolers / teachers pages
      with show = latest_each: the newest LIVE video of each series, so
      those pages update themselves the moment a new record goes live
  Archetype: show header (logo + question H2 + one line) over a card
  rail. Desktop 3-up grid; phone a scroll-snap rail with a peek of the
  next card (design system 3.5). Cards are real DOM, never JS-injected.

  Background is one of the pair-lights or cream. Body text stays
  inky-purple-navy on every ground (mint pair-dark fails AA at body
  size, design system 2.1).

  Background "forest" (#2c634f, the green of the YouTube overlays) is
  the Picnic Planning chapter: cream text on it is 6.5:1 (AA), yellow 4.3:1 (large text only, so yellow is used only for the big wordmark).
  The Picnic logo is Quentin's animated WebP (logo_filename) with a still
  PNG for reduced motion (logo_static_filename); its tagline is WHITE, so
  it is only ever used on the forest ground. Blank = a Post wordmark. The Field Notes
  logo is sage and sits bare on cream, larger since round 2.

  Hover preview (pointer devices only): cards whose record has a
  preview_url get a muted looping <video> on hover / focus, loaded on
  first hover, never on touch. "sound on" unmutes after a real click,
  which is the only way browsers allow audio.
{%- endcomment -%}
{%- liquid
  capture vdata
    render 'theinmag-videos-data'
  endcapture
  assign records = vdata | strip | split: '@@'
  assign now_ts = 'now' | date: '%s'
  assign now_num = now_ts | plus: 0
  assign force_live = section.settings.preview_as_live
  assign show_filter = section.settings.show
  assign limit = section.settings.limit | default: 6
  assign mobile_cap = section.settings.mobile_limit | default: 0
  assign bg = section.settings.background | default: 'cream'
  assign exclude_handle = ''
  if section.settings.exclude_current and template.name == 'page'
    comment
      Same resolution as theinmag-video-watch: the page's own handle when
      it is a video, otherwise (draft preview only) preview_handle, then the
      first record. Reads the watch section's preview_handle via its own
      matching setting here.
    endcomment
    assign exclude_handle = records | first | split: '^^' | first | strip
    if section.settings.preview_handle != blank
      assign exclude_handle = section.settings.preview_handle
    endif
    for r in records
      assign rh = r | split: '^^' | first | strip
      if rh == page.handle
        assign exclude_handle = rh
        break
      endif
    endfor
  endif
  assign shown = 0
  assign seen_shows = ''
-%}

<section
  id="{{ section.settings.anchor | default: section.id }}"
  class="theinmag-video-row theinmag-video-row--{{ bg }}{% if show_filter == 'latest_each' %} theinmag-video-row--pair{% endif %}{% if section.settings.bg_image_filename != blank %} theinmag-video-row--has-bg{% endif %}{% if section.settings.bg_image_filename != blank and section.settings.bg_fade %} theinmag-video-row--fade{% endif %}{% if section.settings.promo %} theinmag-video-row--promo{% if section.settings.promo_video_url != blank %} theinmag-video-row--promo-video{% endif %}{% endif %}"
  style="--vrow-pt: {{ section.settings.padding_top }}px; --vrow-pb: {{ section.settings.padding_bottom }}px;{% if section.settings.bg_image_filename != blank %} --vrow-bg-colour: {{ section.settings.bg_colour | default: '#FFD99B' }}; --vrow-bg-image: linear-gradient(rgba(251, 246, 234, {{ section.settings.bg_wash | default: 0 | divided_by: 100.0 }}), rgba(251, 246, 234, {{ section.settings.bg_wash | default: 0 | divided_by: 100.0 }})), url('{{ section.settings.bg_image_filename | asset_url }}');{% endif %}"
  {% if section.settings.heading != blank %}aria-labelledby="vrow-h-{{ section.id }}"{% endif %}
>
  {%- if section.settings.decor -%}
    <span class="theinmag-video-row__decor theinmag-video-row__decor--rings" aria-hidden="true" style="--decor-mask: url('{{ 'FAQ_HollowCircles.png' | asset_url }}');"></span>
    <span class="theinmag-video-row__decor theinmag-video-row__decor--dots" aria-hidden="true" style="--decor-mask: url('{{ 'Dots.png' | asset_url | append: '&width=600' }}');"></span>
  {%- endif -%}
  {%- if section.settings.promo -%}
    {%- comment -%}
      Promo band (2026-11-06, Ryan): the hub's whiteboard loop behind a short pitch and the newest cards,
      used on the homepage and the three for pages to send people to /pages/videos. The loop loads only
      when the band scrolls near the viewport; reduced motion keeps the still. Pause button = hub's icon.
    {%- endcomment -%}
    {%- if section.settings.promo_video_url != blank -%}
    <div class="theinmag-video-row__promo-media" aria-hidden="true">
      <picture>
        {%- if section.settings.promo_still_wide != blank -%}<source media="(min-width: 750px)" srcset="{{ section.settings.promo_still_wide | asset_url }}">{%- endif -%}
        <img class="theinmag-video-row__promo-still" src="{{ section.settings.promo_still | default: 'videos-hero-whiteboard-loop.jpg' | asset_url }}" width="1080" height="1350" loading="lazy" alt="">
      </picture>
      {%- if section.settings.promo_video_url != blank -%}
        <video class="theinmag-video-row__promo-video" muted loop playsinline preload="none" data-promo-video data-src="{{ section.settings.promo_video_url }}"{% if section.settings.promo_video_mobile_url != blank %} data-src-mobile="{{ section.settings.promo_video_mobile_url }}"{% endif %}></video>
      {%- endif -%}
      <span class="theinmag-video-row__promo-scrim"></span>
    </div>
    {%- endif -%}
    {%- if section.settings.promo_video_url != blank -%}
      <button type="button" class="theinmag-video-row__promo-pause" data-promo-pause aria-pressed="false" hidden>
        <svg class="theinmag-video-row__pp-icon theinmag-video-row__pp-icon--pause" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><rect x="6" y="5" width="4" height="14" rx="1.2" fill="#FFFFFF"/><rect x="14" y="5" width="4" height="14" rx="1.2" fill="#FFFFFF"/></svg>
        <svg class="theinmag-video-row__pp-icon theinmag-video-row__pp-icon--play" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M8 5.5v13l11-6.5z" fill="#FFFFFF"/></svg>
        <span class="visually-hidden" data-promo-pause-label>Pause background video</span>
      </button>
    {%- endif -%}
  {%- endif -%}
  <div class="theinmag-video-row__inner">
    <header class="theinmag-video-row__header">
      <div class="theinmag-video-row__brand">
      {%- if section.settings.logo == 'picnic' -%}
        {%- if section.settings.logo_filename != blank -%}
          {%- comment -%} Animated WebP (tagline flicks between handwritten fonts); still PNG for reduced motion. White tagline: forest ground only. {%- endcomment -%}
          <picture class="theinmag-video-row__logo theinmag-video-row__logo--picnic">
            {%- if section.settings.logo_static_filename != blank -%}
              <source media="(prefers-reduced-motion: reduce)" srcset="{{ section.settings.logo_static_filename | asset_url }}">
            {%- endif -%}
            <img src="{{ section.settings.logo_filename | asset_url }}" width="600" height="516" loading="lazy" alt="Picnic Planning: rich, open tasks">
          </picture>
        {%- else -%}
          <span class="theinmag-video-row__wordmark" aria-hidden="true">Picnic<br>Planning</span>
        {%- endif -%}
        {%- if section.settings.character_ids != blank -%}
          {%- comment -%}
            Random kid-drawn mINion beside the logo, a different one each load.
            ONLY the vetted list in character_ids (names checked against
            theinmag-pat/signatures/minion-signature-previews.html, 20 Oct
            2026): 35 Axolotl, 37 Chick, 38 Purple square, 10 Dragon, 20 Cat,
            47 Kiwi, 26 Carrot. Never 16 (Wind-up bomb) or 53. Decorative:
            empty alt, aria-hidden. Bob animation is off for reduced motion
            (the sitewide blanket rule in base.css also covers it).
          {%- endcomment -%}
          {%- liquid
            assign char_urls = ''
            assign char_ids = section.settings.character_ids | split: ','
            for cid in char_ids
              assign cfile = 'character-' | append: cid | strip | append: '.png'
              assign curl = cfile | asset_url
              assign char_urls = char_urls | append: curl | append: '|'
            endfor
          -%}
          <span class="theinmag-video-row__char" aria-hidden="true" data-video-char="{{ char_urls }}">
            <img alt="" width="600" height="600" loading="lazy" hidden>
          </span>
        {%- endif -%}
      {%- elsif section.settings.logo == 'fieldnotes' -%}
        <span class="theinmag-video-row__logo theinmag-video-row__logo--fieldnotes">
          <img src="{{ 'fieldnotes_logo_sage.png' | asset_url }}" width="800" height="320" loading="lazy" alt="Field Notes">
        </span>
      {%- endif -%}
      </div>
      <div class="theinmag-video-row__heading-wrap">
        {%- if section.settings.promo and section.settings.promo_eyebrow != blank -%}
          <p class="theinmag-video-row__eyebrow">{{ section.settings.promo_eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 id="vrow-h-{{ section.id }}" class="theinmag-video-row__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- comment -%} Phones show the opening lines only, with "read more" (Ryan, 6 Nov: get to the videos faster). Desktop shows it all. {%- endcomment -%}
        <div class="theinmag-video-row__blurb" id="vrow-blurb-{{ section.id }}" data-vrow-blurb>
          {%- if section.settings.intro != blank -%}
            <p class="theinmag-video-row__intro theinmag-video-row__intro--first">{{ section.settings.intro }}</p>
          {%- endif -%}
          {%- if section.settings.intro_2 != blank -%}
            <p class="theinmag-video-row__intro theinmag-video-row__intro--second">{{ section.settings.intro_2 }}</p>
          {%- endif -%}
          {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
            {%- if section.settings.promo -%}
              <a class="theinmag-btn theinmag-btn--primary theinmag-video-row__promo-cta" href="{{ section.settings.link_url }}">{{ section.settings.link_label }}</a>
            {%- else -%}
              {%- if section.settings.link_button -%}
                <a class="theinmag-btn theinmag-btn--secondary" href="{{ section.settings.link_url }}">{{ section.settings.link_label }}</a>
              {%- else -%}
                <a class="theinmag-video-row__more" href="{{ section.settings.link_url }}">{{ section.settings.link_label }} <span aria-hidden="true">&rarr;</span></a>
              {%- endif -%}
            {%- endif -%}
          {%- endif -%}
        </div>
        {%- if section.settings.intro != blank and section.settings.promo != true -%}
          <button type="button" class="theinmag-video-row__toggle" aria-expanded="false" aria-controls="vrow-blurb-{{ section.id }}" data-vrow-toggle>read more</button>
        {%- endif -%}
      </div>
    </header>

    <div class="theinmag-video-row__rail" role="list">
      {%- comment -%} Two passes: live videos first (newest at top of the data file), then the ones still to come. {%- endcomment -%}
      {%- for pass in (1..2) -%}
      {%- for rec in records -%}
        {%- liquid
          assign f = rec | split: '^^'
          assign r_handle = f[0] | strip
          if r_handle == exclude_handle
            continue
          endif
          if f[2] == 'start'
            continue
          endif
          assign r_live_ts = f[4] | date: '%s' | plus: 0
          assign r_coming = false
          if force_live != true and now_num < r_live_ts
            assign r_coming = true
          endif
          if pass == 1 and r_coming
            continue
          endif
          if pass == 2 and r_coming == false
            continue
          endif
          if show_filter == 'latest_each'
            if seen_shows contains f[2]
              continue
            endif
            assign seen_shows = seen_shows | append: f[2] | append: ','
          elsif show_filter != 'all' and f[2] != show_filter
            continue
          endif
          if shown >= limit
            break
          endif
          assign shown = shown | plus: 1
        -%}
        <div class="theinmag-video-row__item{% if mobile_cap > 0 and shown > mobile_cap %} theinmag-video-row__item--desktop-only{% endif %}" role="listitem">
          {%- render 'theinmag-video-card', rec: rec, now_ts: now_ts, force_live: force_live -%}
        </div>
      {%- endfor -%}
      {%- endfor -%}
    </div>
    <p class="theinmag-video-row__empty" data-video-empty hidden>No videos here match that yet. Try another word.</p>
  </div>
</section>

<script>
  /* Cached pages: flip "out soon" cards to live once their time passes. */
  (function () {
    var now = Date.now() / 1000;
    document.querySelectorAll('#{{ section.settings.anchor | default: section.id }} .theinmag-video-card.is-coming').forEach(function (c) {
      var t = parseInt(c.getAttribute('data-live-from'), 10);
      if (t && now >= t) c.classList.remove('is-coming');
    });
  })();

  /* Random vetted character per load. */
  (function () {
    (function () {
      var root = document.getElementById('{{ section.settings.anchor | default: section.id }}');
      var v = root && root.querySelector('[data-promo-video]');
      if (!v) return;
      var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (still) return;
      var phone = window.matchMedia && window.matchMedia('(max-width: 749px)').matches;
      var src = (phone && v.getAttribute('data-src-mobile')) || v.getAttribute('data-src');
      var pb = root.querySelector('[data-promo-pause]');
      var userPaused = false;
      function start() {
        if (!v.src) { v.src = src; }
        if (!userPaused) { var p = v.play(); if (p && p.catch) p.catch(function () {}); }
      }
      v.addEventListener('playing', function () { v.classList.add('is-playing'); if (pb) pb.hidden = false; });
      if (pb) pb.addEventListener('click', function () {
        var lab = pb.querySelector('[data-promo-pause-label]');
        if (v.paused) { userPaused = false; v.play(); pb.setAttribute('aria-pressed', 'false'); lab.textContent = 'Pause background video'; }
        else { userPaused = true; v.pause(); pb.setAttribute('aria-pressed', 'true'); lab.textContent = 'Play background video'; }
      });
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (es) {
          es.forEach(function (e) { if (e.isIntersecting) start(); else if (v.src && !v.paused) v.pause(); });
        }, { rootMargin: '200px 0px' }).observe(root);
      } else { start(); }
    })();
    document.querySelectorAll('#{{ section.settings.anchor | default: section.id }} [data-vrow-toggle]').forEach(function (btn) {
      var blurb = document.getElementById(btn.getAttribute('aria-controls'));
      if (!blurb) return;
      btn.addEventListener('click', function () {
        var open = blurb.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        btn.textContent = open ? 'read less' : 'read more';
      });
    });
    document.querySelectorAll('#{{ section.settings.anchor | default: section.id }} [data-video-char]').forEach(function (slot) {
      var urls = slot.getAttribute('data-video-char').split('|').filter(Boolean);
      if (!urls.length) return;
      var img = slot.querySelector('img');
      img.src = urls[Math.floor(Math.random() * urls.length)];
      img.hidden = false;
    });
  })();

  /* Hover preview: one shared handler for every row on the page. */
  (function () {
    if (window.__theinmagVideoHover) return;
    window.__theinmagVideoHover = true;
    var fine = window.matchMedia && window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    var still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!fine || still) return;
    function ensure(card) {
      var v = card.querySelector('video.theinmag-video-card__clip');
      if (v) return v;
      v = document.createElement('video');
      v.className = 'theinmag-video-card__clip';
      v.muted = true; v.loop = true; v.playsInline = true; v.preload = 'auto';
      v.setAttribute('aria-hidden', 'true');
      v.src = card.getAttribute('data-preview');
      card.querySelector('.theinmag-video-card__media').appendChild(v);
      return v;
    }
    function start(card) {
      if (card.classList.contains('is-coming')) return;
      var v = ensure(card);
      var p = v.play();
      if (p && p.catch) p.catch(function () {});
      card.classList.add('is-previewing');
      var b = card.querySelector('.theinmag-video-card__sound');
      if (b) b.hidden = false;
    }
    function stop(card) {
      var v = card.querySelector('video.theinmag-video-card__clip');
      if (v) { v.pause(); v.muted = true; }
      card.classList.remove('is-previewing');
      var b = card.querySelector('.theinmag-video-card__sound');
      if (b) { b.hidden = true; b.setAttribute('aria-pressed', 'false'); b.querySelector('span').textContent = 'sound on'; }
    }
    document.querySelectorAll('.theinmag-video-card[data-preview]').forEach(function (card) {
      card.addEventListener('mouseenter', function () { start(card); });
      card.addEventListener('mouseleave', function () { stop(card); });
      card.addEventListener('focusin', function () { start(card); });
      card.addEventListener('focusout', function (e) { if (!card.contains(e.relatedTarget)) stop(card); });
      var b = card.querySelector('.theinmag-video-card__sound');
      if (b) b.addEventListener('click', function () {
        var v = ensure(card);
        v.muted = !v.muted;
        b.setAttribute('aria-pressed', v.muted ? 'false' : 'true');
        b.querySelector('span').textContent = v.muted ? 'sound on' : 'sound off';
      });
    });
  })();
</script>

{% stylesheet %}
  .theinmag-video-row {
    position: relative;
    background-color: var(--color-cream);
    color: var(--color-inky-purple-navy);
    padding: var(--vrow-pt, 64px) 0 var(--vrow-pb, 72px);
  }
  .theinmag-video-row--mint { background-color: var(--color-mint); }
  .theinmag-video-row--lavender { background-color: var(--color-lavender); }
  .theinmag-video-row--sky { background-color: var(--color-sky); }
  /* The YouTube overlay green, used only for the Picnic Planning chapter. */
  .theinmag-video-row--forest {
    --vrow-forest: #2c634f;
    background-color: var(--vrow-forest);
    color: var(--color-cream);
  }
  .theinmag-video-row--forest .theinmag-video-row__heading,
  .theinmag-video-row--forest .theinmag-video-row__intro,
  .theinmag-video-row--forest .theinmag-video-row__more,
  .theinmag-video-row--forest .theinmag-video-row__empty { color: var(--color-cream); }
  .theinmag-video-row--forest .theinmag-video-row__more:focus-visible { outline: 3px solid var(--color-cream); outline-offset: 3px; }

  /* Decor (2026-11-06, Ryan): the site's own hollow rings (FAQ) and dot trail,
     recoloured per ground with a mask and kept faint, tucked into corners. */
  .theinmag-video-row { overflow: hidden; }
  /* Drawn-pattern ground, same treatment as the field notes blog index
     (theinmag-blog-index-editorial): colour under a 640px tile with a cream wash. */
  .theinmag-video-row--has-bg {
    background-color: var(--vrow-bg-colour);
    background-image: var(--vrow-bg-image);
    background-size: auto, 640px auto;
    background-repeat: repeat;
  }
  /* Optional: cream at the top fading into the pattern below. */
  .theinmag-video-row--fade.theinmag-video-row--has-bg {
    background-image: linear-gradient(to bottom, rgb(251, 246, 234) 0%, rgba(251, 246, 234, 0) 70%), var(--vrow-bg-image);
    background-size: auto, auto, 640px auto;
  }
  .theinmag-video-row__decor {
    position: absolute;
    z-index: 0;
    pointer-events: none;
    background-color: var(--decor-colour, var(--color-sage-dark));
    opacity: var(--decor-opacity, 0.5);
    -webkit-mask: var(--decor-mask) center / contain no-repeat;
    mask: var(--decor-mask) center / contain no-repeat;
  }
  .theinmag-video-row__decor--rings { width: clamp(200px, 26vw, 400px); aspect-ratio: 803 / 736; top: -90px; right: -120px; }
  .theinmag-video-row__decor--dots { width: clamp(150px, 18vw, 280px); aspect-ratio: 1; bottom: -40px; left: -50px; transform: rotate(18deg); }
  .theinmag-video-row--forest .theinmag-video-row__decor--rings { --decor-colour: #CFEADB; --decor-opacity: 0.9; }
  .theinmag-video-row--forest .theinmag-video-row__decor--dots { --decor-colour: #F4E04D; --decor-opacity: 0.16; }
  .theinmag-video-row--cream .theinmag-video-row__decor--rings { --decor-colour: var(--color-sage-dark); --decor-opacity: 0.55; }
  .theinmag-video-row--cream .theinmag-video-row__decor--dots { --decor-colour: var(--color-wave-peach); --decor-opacity: 0.45; }
  .theinmag-video-row__inner { position: relative; z-index: 1; }

  /* ---------- promo band (homepage + for pages) ---------- */
  .theinmag-video-row--promo-video {
    background-color: #1b1426;
    color: var(--color-cream);
    min-height: clamp(620px, 88vh, 860px);
    display: flex;
    align-items: flex-end;
  }
  .theinmag-video-row--promo .theinmag-video-row__inner { width: 100%; }
  .theinmag-video-row__promo-media { position: absolute; inset: 0; z-index: 0; }
  .theinmag-video-row__promo-still,
  .theinmag-video-row__promo-video {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; object-position: 50% 0%;
  }
  .theinmag-video-row__promo-video { opacity: 0; transition: opacity 0.6s ease; }
  .theinmag-video-row__promo-video.is-playing { opacity: 1; }
  .theinmag-video-row__promo-scrim {
    position: absolute; inset: 0;
    background:
      linear-gradient(to top, rgba(20, 14, 30, 0.92) 0%, rgba(20, 14, 30, 0.72) 42%, rgba(20, 14, 30, 0.2) 72%, rgba(20, 14, 30, 0.05) 100%),
      linear-gradient(to right, rgba(20, 14, 30, 0.55) 0%, rgba(20, 14, 30, 0) 60%);
  }
  .theinmag-video-row--promo-video .theinmag-video-row__heading,
  .theinmag-video-row--promo-video .theinmag-video-row__intro,
  .theinmag-video-row--promo-video .theinmag-video-row__empty { color: var(--color-cream); text-shadow: 0 2px 12px rgba(0, 0, 0, 0.35); }
  .theinmag-video-row--forest .theinmag-video-row__eyebrow { color: var(--color-cream); }
  .theinmag-video-row--promo .theinmag-video-row__heading { font-size: clamp(32px, 5vw, 56px); line-height: 1.08; max-width: 18ch; }
  .theinmag-video-row--promo .theinmag-video-row__intro { font-size: clamp(17px, 1.7vw, 20px); max-width: 44ch; }
  .theinmag-video-row__eyebrow {
    font-family: var(--font-body); font-weight: 700; font-size: 13px; letter-spacing: 0.08em;
    text-transform: uppercase; margin: 0 0 10px; color: inherit;
  }
  .theinmag-video-row__promo-cta { margin-top: 8px; }
  @media (max-width: 749px) {
    /* phones: the pitch sits high, over the bright window in the clip, so darken evenly */
    .theinmag-video-row--promo-video .theinmag-video-row__promo-scrim { background: linear-gradient(to bottom, rgba(20, 14, 30, 0.6) 0%, rgba(20, 14, 30, 0.72) 50%, rgba(20, 14, 30, 0.88) 100%); }
  }
  .theinmag-video-row__promo-pause {
    position: absolute; z-index: 2; top: clamp(12px, 2vw, 24px); right: clamp(12px, 2vw, 24px);
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; padding: 0; border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.35); background: rgba(30, 26, 36, 0.45);
    -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px); cursor: pointer;
  }
  .theinmag-video-row__promo-pause[hidden] { display: none; }
  .theinmag-video-row__promo-pause:hover { background: rgba(30, 26, 36, 0.7); }
  .theinmag-video-row__promo-pause:focus-visible { outline: 3px solid var(--color-yellow); outline-offset: 3px; }
  .theinmag-video-row__pp-icon { display: block; }
  .theinmag-video-row__pp-icon--play { display: none; }
  .theinmag-video-row__promo-pause[aria-pressed="true"] .theinmag-video-row__pp-icon--pause { display: none; }
  .theinmag-video-row__promo-pause[aria-pressed="true"] .theinmag-video-row__pp-icon--play { display: block; }
  .theinmag-video-row__inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 clamp(16px, 3vw, 32px);
  }

  .theinmag-video-row__header {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: clamp(20px, 3vw, 32px);
  }
  .theinmag-video-row__brand { display: flex; align-items: center; gap: 8px; flex: 0 0 auto; }
  .theinmag-video-row__brand:empty { display: none; }
  .theinmag-video-row__logo { display: block; width: 168px; flex: 0 0 auto; }
  .theinmag-video-row__logo--fieldnotes { width: 240px; margin: -16px 0 -8px -12px; }
  .theinmag-video-row__logo--picnic { width: 200px; }
  .theinmag-video-row__logo--picnic img { display: block; width: 100%; height: auto; }
  .theinmag-video-row__wordmark {
    display: block;
    flex: 0 0 auto;
    font-family: var(--font-heading);
    font-size: clamp(40px, 6vw, 64px);
    line-height: 0.95;
    color: var(--color-yellow);
    rotate: -3deg;
  }
  .theinmag-video-row__intro--second { font-weight: 600; }
  .theinmag-video-row__char {
    display: block;
    flex: 0 0 auto;
    width: 96px;
    align-self: center;
    margin-left: -8px;
  }
  .theinmag-video-row__char img {
    display: block;
    width: 100%;
    height: auto;
    /* white sticker edge so dark drawings (kiwi, square) read on the forest green */
    filter: drop-shadow(2px 0 0 #FFFFFF) drop-shadow(-2px 0 0 #FFFFFF) drop-shadow(0 2px 0 #FFFFFF) drop-shadow(0 -2px 0 #FFFFFF) drop-shadow(0 6px 10px rgba(0, 0, 0, 0.25));
    animation: theinmag-vrow-bob 4s ease-in-out infinite;
  }
  @keyframes theinmag-vrow-bob {
    0%, 100% { transform: translateY(0) rotate(-2deg); }
    50% { transform: translateY(-5px) rotate(2deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .theinmag-video-row__char img { animation: none; }
  }
  .theinmag-video-row__empty {
    font-family: var(--font-body);
    font-size: 16px;
    margin: 8px 0 0;
  }
  .theinmag-video-row__logo img { display: block; width: 100%; height: auto; }
  .theinmag-video-row__heading {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(26px, 4.5vw, 40px);
    line-height: 1.15;
    margin: 0 0 8px;
    text-wrap: pretty;
  }
  .theinmag-video-row__intro {
    font-family: var(--font-body);
    font-size: clamp(16px, 1.6vw, 18px);
    line-height: 1.6;
    max-width: 60ch;
    margin: 0 0 10px;
  }
  .theinmag-video-row__toggle { display: none; }
  @media (max-width: 749px) {
    .theinmag-video-row:not(.theinmag-video-row--promo) .theinmag-video-row__blurb:not(.is-open) .theinmag-video-row__intro--first {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      margin-bottom: 4px;
    }
    .theinmag-video-row:not(.theinmag-video-row--promo) .theinmag-video-row__blurb:not(.is-open) .theinmag-video-row__intro--second,
    .theinmag-video-row:not(.theinmag-video-row--promo) .theinmag-video-row__blurb:not(.is-open) .theinmag-video-row__more { display: none; }
    .theinmag-video-row__toggle {
      display: inline-block;
      min-height: 44px;
      padding: 0;
      border: 0;
      background: none;
      color: inherit;
      font-family: var(--font-body);
      font-weight: 600;
      font-size: 15px;
      text-decoration: underline;
      text-underline-offset: 4px;
      cursor: pointer;
    }
  }
  .theinmag-video-row__more {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 15px;
    color: var(--color-inky-purple-navy);
    text-underline-offset: 4px;
  }

  /* Phone: scroll-snap rail with a peek of the next card. */
  .theinmag-video-row__rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 82%;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-left: clamp(16px, 3vw, 32px);
    margin: 0 calc(-1 * clamp(16px, 3vw, 32px));
    padding: 4px clamp(16px, 3vw, 32px) 12px;
    scrollbar-width: none;
  }
  .theinmag-video-row__rail::-webkit-scrollbar { display: none; }
  .theinmag-video-row__item { scroll-snap-align: start; min-width: 0; }
  @media (max-width: 749px) { .theinmag-video-row__item--desktop-only { display: none; } }

  @media (min-width: 750px) {
    .theinmag-video-row__header {
      flex-direction: row;
      align-items: center;
      gap: 32px;
    }
    .theinmag-video-row .theinmag-video-row__logo--fieldnotes { width: 360px; margin: -28px -8px -20px -24px; }
    .theinmag-video-row .theinmag-video-row__logo--picnic { width: 260px; }
    .theinmag-video-row .theinmag-video-row__char { width: 140px; margin-left: -24px; }
    .theinmag-video-row--pair .theinmag-video-row__rail.theinmag-video-row__rail { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 860px; }
    .theinmag-video-row .theinmag-video-row__rail {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-columns: auto;
      overflow: visible;
      margin: 0;
      padding: 0;
      gap: clamp(20px, 2.4vw, 32px);
    }
  }

  /* ---------- card (snippets/theinmag-video-card) ---------- */
  .theinmag-video-card { position: relative; height: 100%; }
  .theinmag-video-card__clip {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--transition-hover);
  }
  .theinmag-video-card.is-previewing .theinmag-video-card__clip { opacity: 1; }
  .theinmag-video-card.is-previewing .theinmag-video-card__play { opacity: 0; }
  .theinmag-video-card__sound {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    min-height: 44px;
    padding: 0 14px;
    border: 0;
    border-radius: var(--radius-pill);
    background: rgba(0, 0, 0, 0.62);
    color: #FFFFFF;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 13px;
    cursor: pointer;
  }
  .theinmag-video-card__sound[hidden] { display: none; }
  .theinmag-video-card__sound:focus-visible { outline: 3px solid #FFFFFF; outline-offset: 2px; }
  .theinmag-video-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #FFFFFF;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    color: var(--color-inky-purple-navy);
    text-decoration: none;
    transition: translate var(--transition-hover), box-shadow var(--transition-hover);
  }
  .theinmag-video-card__link:hover,
  .theinmag-video-card__link:focus-visible {
    translate: 0 -4px;
    box-shadow: var(--shadow-card-hover);
  }
  .theinmag-video-card__link:focus-visible {
    outline: 3px solid var(--color-inky-purple-navy);
    outline-offset: 3px;
  }
  .theinmag-video-card__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    background: var(--color-inky-purple-navy);
  }
  .theinmag-video-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .theinmag-video-card__play {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    display: block;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.18));
    transition: scale var(--transition-hover);
  }
  .theinmag-video-card__play svg { display: block; }
  .theinmag-video-card__link:hover .theinmag-video-card__play { scale: 1.06; }
  .theinmag-video-card__play svg rect { transition: fill-opacity var(--transition-hover); }
  .theinmag-video-card__link:hover .theinmag-video-card__play svg rect,
  .theinmag-video-card__link:focus-visible .theinmag-video-card__play svg rect { fill-opacity: 0.78; }

  /* "out Thu 5 Nov": white text on a dark scrim, never a coloured pill. */
  .theinmag-video-card__soon {
    display: none;
    position: absolute;
    inset: auto 0 0 0;
    padding: 36px 14px 12px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.72), rgba(0, 0, 0, 0));
  }
  .theinmag-video-card__soon-text {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.02em;
    color: #FFFFFF;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.5);
  }
  .theinmag-video-card.is-coming .theinmag-video-card__soon { display: block; }
  .theinmag-video-card.is-coming .theinmag-video-card__play { display: none; }

  .theinmag-video-card__body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 18px 20px;
  }
  .theinmag-video-card__meta {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-inky-purple-navy);
    opacity: 0.75;
  }
  .theinmag-video-card__title {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(18px, 1.8vw, 20px);
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin: 0;
    text-wrap: pretty;
  }
  .theinmag-video-card__line {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.5;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Video row",
  "tag": "div",
  "class": "theinmag-video-row-section",
  "settings": [
    { "type": "select", "id": "show", "label": "Which videos", "default": "all",
      "options": [
        { "value": "all", "label": "All, newest first" },
        { "value": "picnic", "label": "Picnic Planning" },
        { "value": "fieldnotes", "label": "Field Notes" },
        { "value": "latest_each", "label": "Newest of each series (homepage, for pages)" }
      ] },
    { "type": "range", "id": "limit", "label": "Max cards", "min": 1, "max": 12, "step": 1, "default": 6 },
    { "type": "range", "id": "mobile_limit", "label": "Max cards on phones", "min": 0, "max": 12, "step": 1, "default": 0, "info": "0 = same as Max cards. Cards past this number are hidden on phones only." },
    { "type": "checkbox", "id": "exclude_current", "label": "Hide the video this watch page is about", "default": false },
    { "type": "select", "id": "logo", "label": "Show logo", "default": "none",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "picnic", "label": "Picnic Planning" },
        { "value": "fieldnotes", "label": "Field Notes" }
      ] },
    { "type": "text", "id": "heading", "label": "Heading (phrase as a question)" },
    { "type": "textarea", "id": "intro", "label": "One line under the heading" },
    { "type": "textarea", "id": "intro_2", "label": "Second line (bold)" },
    { "type": "text", "id": "logo_filename", "label": "Picnic Planning logo (asset filename)", "info": "Blank shows a text wordmark." },
    { "type": "text", "id": "logo_static_filename", "label": "Picnic Planning logo still (reduced motion)" },
    { "type": "text", "id": "character_ids", "label": "Character ids beside the Picnic logo", "info": "Comma list of vetted character-N.png numbers. Check each NAME first; never 16 (bomb) or 53." },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "text", "id": "link_url", "label": "Link URL" },
    { "type": "checkbox", "id": "decor", "label": "Faint rings and dots in the corners", "default": false },
    { "type": "checkbox", "id": "link_button", "label": "Show the link as a button", "default": false },
    { "type": "header", "content": "Promo band (homepage + for pages)" },
    { "type": "checkbox", "id": "promo", "label": "Promo band: video background, big pitch, button", "default": false },
    { "type": "text", "id": "promo_eyebrow", "label": "Promo eyebrow" },
    { "type": "text", "id": "promo_video_url", "label": "Promo video (desktop, wide MP4 URL)" },
    { "type": "text", "id": "promo_video_mobile_url", "label": "Promo video (phones, tall MP4 URL)" },
    { "type": "text", "id": "promo_still", "label": "Promo still (tall, asset filename)", "default": "videos-hero-whiteboard-loop.jpg" },
    { "type": "text", "id": "promo_still_wide", "label": "Promo still (wide, asset filename)", "default": "videos-hero-whiteboard-loop-wide.jpg" },
    { "type": "text", "id": "bg_image_filename", "label": "Pattern background (asset filename)", "info": "Drawn-pattern image tiled at 640px, like the blog index (teacher_backgroundFAQ.jpg). Blank = plain colour." },
    { "type": "color", "id": "bg_colour", "label": "Colour under the pattern", "default": "#FFD99B" },
    { "type": "range", "id": "bg_wash", "label": "Cream wash over the pattern", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 55 },
    { "type": "checkbox", "id": "bg_fade", "label": "Fade from cream into the pattern", "default": false, "info": "Needs a pattern background. Cream at the top, pattern showing through at the bottom." },
    { "type": "select", "id": "background", "label": "Background", "default": "cream",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "mint", "label": "Light mint green" },
        { "value": "lavender", "label": "Light lavender" },
        { "value": "sky", "label": "Light sky blue" },
        { "value": "forest", "label": "Forest green (YouTube overlay green)" }
      ] },
    { "type": "text", "id": "anchor", "label": "Anchor id (for in-page links)" },
    { "type": "text", "id": "preview_handle", "label": "Draft preview: video the watch page is showing", "info": "Match the watch section's preview handle. Leave blank on live." },
    { "type": "checkbox", "id": "preview_as_live", "label": "Draft preview: show every video as live", "default": false,
      "info": "Draft review only. Leave OFF on the live theme." },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "presets": [ { "name": "Video row" } ]
}
{% endschema %}
