{%- comment -%}
  theinmag-behind-the-mag-hero
  Field-notes-article-style split hero: drone hero image fills the
  left column with the H1 overlaid bottom-left in white sans-serif
  (matches the visual register of the field-notes blog post hero).
  Right column carries a "Quick Read"-style card with Ryan's personal
  hook copy + a hand-lettered Caveat signature. Kid character pops
  above the personal note - sized so it reads as a friendly tag
  rather than dominating the card. (2026-05-11 sizing pass.)

  Absorbed the standalone hook section in the May 10 2026 redesign -
  hook copy now lives inside the right-hand card so the eye flows
  H1 (left, big, on image) -> personal note (right, smaller, in card)
  -> signature, all in one viewport without a separate section break.

  Pattern source: theinmag-article (field-notes article hero).

  Carries page-level JSON-LD: BreadcrumbList + AboutPage + Person
  for Ryan and Tam.
{%- endcomment -%}

{%- liquid
  assign image_src = ''
  if section.settings.image != blank
    assign image_src = section.settings.image | image_url: width: 2400
  elsif section.settings.fallback_filename != blank
    assign image_src = section.settings.fallback_filename | asset_url
  endif

  assign image_alt = section.settings.image_alt | default: 'Aerial drone shot of theINmag founders Ryan and Tam standing in front of their self-converted home-on-wheels van.'

  assign eyebrow = section.settings.eyebrow | default: 'Behind the mag'
  assign headline = section.settings.headline | default: 'It started with a kid sending a drawing to the local paper'
  assign byline_caption = section.settings.byline_caption

  assign hook_para_1 = section.settings.hook_paragraph_1
  assign hook_para_2 = section.settings.hook_paragraph_2
  assign hook_para_3 = section.settings.hook_paragraph_3
  assign signature = section.settings.signature | default: 'Ryan'
  assign signature_role = section.settings.signature_role | default: 'Co-founder'

  assign page_origin = request.origin | default: 'https://theinmag.com.au'
  assign page_url = page_origin | append: '/pages/behind-the-mag'
-%}

<section
  class="theinmag-bm-hero"
  data-theinmag-bm-hero
  aria-labelledby="theinmag-bm-hero-heading"
>
  {%- comment -%}
    Sitewide character pool gets rendered once per page. Top of the
    hero is the natural spot - all behind-the-mag character slots
    then read from the same shuffled list.
  {%- endcomment -%}
  {% render 'theinmag-character-pool' %}

  <div class="theinmag-bm-hero__grid">
    <div class="theinmag-bm-hero__cover-col">
      <div class="theinmag-bm-hero__cover">
        {%- if image_src != blank -%}
          <img
            class="theinmag-bm-hero__cover-image"
            src="{{ image_src }}"
            alt="{{ image_alt | escape }}"
            width="2400"
            height="1600"
            fetchpriority="high"
          >
        {%- else -%}
          <span class="theinmag-bm-hero__cover-placeholder" aria-hidden="true"></span>
        {%- endif -%}

        {%- comment -%}
          Bottom gradient scrim so the H1 stays legible regardless of
          the photo's bottom-edge content. Fades to fully transparent
          at ~55% up so the founders' faces stay un-darkened.
        {%- endcomment -%}
        <div class="theinmag-bm-hero__scrim" aria-hidden="true"></div>

        <div class="theinmag-bm-hero__overlay">
          {%- if eyebrow != blank -%}
            <span class="theinmag-bm-hero__overlay-eyebrow">{{ eyebrow }}</span>
          {%- endif -%}
          <h1 id="theinmag-bm-hero-heading" class="theinmag-bm-hero__overlay-title">{{ headline }}</h1>
          {%- if byline_caption != blank -%}
            <p class="theinmag-bm-hero__overlay-caption">{{ byline_caption }}</p>
          {%- endif -%}
        </div>
      </div>

    </div>

    <div class="theinmag-bm-hero__body-col">
      <div class="theinmag-bm-hero__body-inner">
        <span class="theinmag-bm-hero__character" data-theinmag-pool-character></span>
        <aside class="theinmag-bm-hero__quick-read" aria-label="Personal note from Ryan">
          <span class="theinmag-bm-hero__quick-read-label">Personal note</span>
          <div class="theinmag-bm-hero__quick-read-body">
            {%- if hook_para_1 != blank -%}<p>{{ hook_para_1 }}</p>{%- endif -%}
            {%- if hook_para_2 != blank -%}<p class="theinmag-bm-hero__quick-read-emph">{{ hook_para_2 }}</p>{%- endif -%}
            {%- if hook_para_3 != blank -%}<p>{{ hook_para_3 }}</p>{%- endif -%}
          </div>

          {%- if signature != blank -%}
            <div class="theinmag-bm-hero__signature">
              <span class="theinmag-bm-hero__signature-name">{{ signature }}</span>
              {%- if signature_role != blank -%}
                <span class="theinmag-bm-hero__signature-role">{{ signature_role }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
        </aside>
      </div>
    </div>
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ page_origin | json }} },
    { "@type": "ListItem", "position": 2, "name": "Behind the mag", "item": {{ page_url | json }} }
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "Behind the mag - the story of theINmag",
  "description": "How a kid sending drawings to the local paper grew up to make a magazine for every Aussie kid. The story, the team, the why - all in one place.",
  "url": {{ page_url | json }},
  "mainEntityOfPage": {{ page_url | json }},
  "isPartOf": {
    "@type": "WebSite",
    "name": "theINmag",
    "url": {{ page_origin | json }}
  },
  "about": {
    "@type": "Organization",
    "name": "theINmag",
    "url": {{ page_origin | json }},
    "founder": [
      {
        "@type": "Person",
        "name": "Ryan",
        "jobTitle": "Co-founder, theINmag",
        "url": {{ page_url | append: '#ryan' | json }}
      },
      {
        "@type": "Person",
        "name": "Tam",
        "jobTitle": "Co-founder, theINmag",
        "url": {{ page_url | append: '#tam' | json }}
      }
    ]
  }
}
</script>

{%- stylesheet -%}
  /* ================================================================
     theinmag-bm-hero
     Split-screen field-notes-style hero. Cover image on the left with
     overlaid H1; right column carries the Quick Read card + signature.
     ================================================================ */

  .theinmag-bm-hero {
    background-color: var(--color-cream, #FBF6EA);
    color: var(--color-inky-purple-navy, #2A1F3D);
    padding: 0 0 clamp(40px, 5vw, 64px);
    position: relative;
  }

  /* Full-bleed grid: image runs viewport-edge to viewport-edge with
     no gutter on the left or top. Body column has internal padding so
     the personal-note card breathes against the section background. */
  .theinmag-bm-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    align-items: stretch;
    position: relative;
  }

  @media (min-width: 990px) {
    .theinmag-bm-hero {
      /* Section fills the first desktop viewport - image + card both
         visible without scrolling, next section peeks at the bottom
         when scrolled. */
      min-height: 100vh;
      padding-bottom: 0;
    }
    .theinmag-bm-hero__grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: 0;
      min-height: 100vh;
      align-items: center;
    }
  }

  /* ================================================================
     Cover column - drone image + H1 overlaid in the SKY (top-left).
     Image runs full-bleed to the section edges; on desktop the
     column fills 100vh so the entire hero moment lives in one
     viewport.
     ================================================================ */
  .theinmag-bm-hero__cover-col {
    position: relative;
  }

  .theinmag-bm-hero__cover {
    position: relative;
    overflow: hidden;
    border-radius: 0;
    background-color: var(--color-inky-purple-navy, #2A1F3D);
    aspect-ratio: 4 / 5;
  }

  @media (min-width: 750px) {
    .theinmag-bm-hero__cover {
      aspect-ratio: 1 / 1;
    }
  }

  @media (min-width: 990px) {
    .theinmag-bm-hero__cover {
      aspect-ratio: auto;
      height: 100vh;
      min-height: 560px;
    }
  }

  .theinmag-bm-hero__cover-image,
  .theinmag-bm-hero__cover-placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Anchor toward the upper-third of the photo so the sky stays in
       view (the H1 needs that real estate). */
    object-position: 50% 30%;
  }

  .theinmag-bm-hero__cover-placeholder {
    background: linear-gradient(135deg, #5D3A7A 0%, #2A1F3D 100%);
  }

  /* No scrim on the photo - per Ryan's call. The H1 carries its own
     glow halo (text-shadow) for legibility against the sky. */
  .theinmag-bm-hero__scrim {
    display: none;
  }

  /* H1 anchored at the TOP of the image (sits in the sky portion of
     the drone shot). White Inter 700 with a soft glow halo - layered
     dark text-shadows so the white reads cleanly on bright sky. */
  .theinmag-bm-hero__overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: auto;
    padding: clamp(20px, 4vw, 40px);
    color: #FFFFFF;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: clamp(8px, 1vw, 12px);
  }

  .theinmag-bm-hero__overlay-eyebrow {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: clamp(11px, 1.1vw, 13px);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.92);
    text-shadow:
      0 0 12px rgba(0, 0, 0, 0.5),
      0 2px 6px rgba(0, 0, 0, 0.35);
  }

  /* Field-notes register - Inter 700, large, tight tracking. Glow
     halo via layered text-shadows so the white H1 reads clean on
     a pale sky. */
  .theinmag-bm-hero__overlay-title {
    margin: 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: clamp(28px, 4.6vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.005em;
    color: #FFFFFF;
    /* Glow halo: layered dark text-shadows blur out from the type so
       the white characters always have a soft contrasting backdrop
       regardless of where exactly they sit on the sky. */
    text-shadow:
      0 0 18px rgba(0, 0, 0, 0.48),
      0 0 36px rgba(0, 0, 0, 0.32),
      0 0 60px rgba(0, 0, 0, 0.22),
      0 2px 8px rgba(0, 0, 0, 0.4);
    text-wrap: balance;
    max-width: 18ch;
  }

  .theinmag-bm-hero__overlay-caption {
    margin: 4px 0 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: clamp(13px, 1.3vw, 15px);
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 0 12px rgba(0, 0, 0, 0.5), 0 2px 6px rgba(0, 0, 0, 0.35);
    max-width: 36ch;
  }

  /* ================================================================
     Kid character pop
     ================================================================
     Sits above the personal note's top edge, peeking down into the
     Quick Read card. Anchored to the body-inner wrapper (set
     position:relative below) so it follows the personal note's
     position rather than the section padding.

     Sizing history (2026-05-11):
       1. Original launch: clamp(70px, 10vw, 120px)
       2. Bumped +40% per Ryan: clamp(98px, 14vw, 170px)
       3. Trimmed -30% per Ryan: clamp(69px, 9.8vw, 119px) - the
          current setting. Reads as a friendly tag near the card
          edge rather than a dominant element on the page.

     Top offset is negative so the character pops UP above the
     body-inner top edge - the section bg picks up the visible
     part above the white card.
     ================================================================ */
  .theinmag-bm-hero__character {
    position: absolute;
    top: clamp(-120px, -10vw, -80px);
    right: clamp(8px, 3vw, 28px);
    width: clamp(69px, 9.8vw, 119px);
    z-index: 4;
  }

  @media (max-width: 479px) {
    .theinmag-bm-hero__character {
      display: none;
    }
  }

  /* ================================================================
     Body column - Quick Read card + signature. Vertically centred
     against the cover image on desktop so it sits in the middle of
     the first viewport when the page loads.
     ================================================================ */
  .theinmag-bm-hero__body-col {
    display: flex;
    align-items: center;
    padding: clamp(24px, 4vw, 40px) clamp(20px, 4vw, 40px);
  }

  @media (min-width: 990px) {
    .theinmag-bm-hero__body-col {
      /* Asymmetric padding shifts the centred card upward in the
         viewport - more bottom than top so align-items:center lands
         the card above the geometric middle. */
      padding-top: clamp(24px, 3vw, 40px);
      padding-right: clamp(40px, 5vw, 72px);
      padding-bottom: clamp(96px, 12vw, 160px);
      padding-left: clamp(40px, 5vw, 72px);
    }
  }

  .theinmag-bm-hero__body-inner {
    width: 100%;
    /* Anchor for the absolutely-positioned kid character that pops
       up above the personal note. */
    position: relative;
  }

  /* Quick Read card. White surface, soft purple-tinted shadow, a
     small caps "Personal note" label up top. Body copy is smaller
     than the hero H1 so the eye lands on the H1 first, then crosses
     to the card. */
  .theinmag-bm-hero__quick-read {
    background-color: #FFFFFF;
    border-radius: 14px;
    padding: clamp(20px, 2.6vw, 32px) clamp(20px, 2.6vw, 32px) clamp(24px, 3vw, 36px);
    box-shadow: 0 4px 18px rgba(123, 79, 158, 0.12);
    display: flex;
    flex-direction: column;
    gap: clamp(12px, 1.4vw, 18px);
  }

  .theinmag-bm-hero__quick-read-label {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-purple-dark, #5D3A7A);
  }

  .theinmag-bm-hero__quick-read-body {
    display: flex;
    flex-direction: column;
    gap: clamp(8px, 1.2vw, 12px);
  }

  .theinmag-bm-hero__quick-read-body p {
    margin: 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    /* Smaller than a typical hero subhead - the H1 carries the volume.
       Dropped one tier from the round-2 size per Ryan's feedback that
       the note was reading too loud. */
    font-size: clamp(13px, 1.2vw, 15px);
    line-height: 1.6;
    color: var(--color-inky-purple-navy, #2A1F3D);
  }

  .theinmag-bm-hero__quick-read-body .theinmag-bm-hero__quick-read-emph {
    font-weight: 600;
  }

  /* Signature row - hand-lettered Caveat for the name (matches the
     field-notes blog author signature treatment), Inter caption
     underneath with the role in small caps. */
  .theinmag-bm-hero__signature {
    margin-top: clamp(8px, 1vw, 12px);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .theinmag-bm-hero__signature-name {
    font-family: var(--font-emphasis, 'Caveat', cursive);
    font-weight: 700;
    font-size: clamp(28px, 3.2vw, 36px);
    line-height: 1;
    color: var(--color-purple-dark, #5D3A7A);
  }

  .theinmag-bm-hero__signature-role {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-inky-purple-navy, #2A1F3D);
    opacity: 0.7;
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "theINmag BM hero",
  "tag": "section",
  "class": "theinmag-bm-hero-section",
  "settings": [
    { "type": "header", "content": "Hero image (left column)" },
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "fallback_filename", "label": "Fallback filename", "info": "e.g. HERO_behind-the-mag-van.jpg" },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "header", "content": "Overlay text (on image)" },
    { "type": "text", "id": "eyebrow", "label": "Small eyebrow" },
    { "type": "text", "id": "headline", "label": "Headline (H1)" },
    { "type": "text", "id": "byline_caption", "label": "Caption (small, optional)" },
    { "type": "header", "content": "Personal note (right column)" },
    { "type": "textarea", "id": "hook_paragraph_1", "label": "Paragraph 1" },
    { "type": "textarea", "id": "hook_paragraph_2", "label": "Paragraph 2 (emphasis)" },
    { "type": "textarea", "id": "hook_paragraph_3", "label": "Paragraph 3" },
    { "type": "text", "id": "signature", "label": "Signature name" },
    { "type": "text", "id": "signature_role", "label": "Signature role / caption" }
  ],
  "presets": [
    {
      "name": "theINmag BM hero",
      "settings": {
        "fallback_filename": "HERO_behind-the-mag-van.jpg",
        "image_alt": "Aerial drone shot of theINmag founders Ryan and Tam standing in front of their self-converted home-on-wheels van.",
        "eyebrow": "Behind the mag",
        "headline": "It started with a kid sending a drawing to the local paper",
        "byline_caption": "",
        "hook_paragraph_1": "I was the kid who sent stuff in everywhere. Drawings to the local paper. Stories to anyone who'd take them. One day they printed something I made.",
        "hook_paragraph_2": "I still remember exactly how it felt.",
        "hook_paragraph_3": "Now I'm trying to give that feeling to every Aussie kid I can find.",
        "signature": "Ryan",
        "signature_role": "Co-founder"
      }
    }
  ]
}
{% endschema %}
