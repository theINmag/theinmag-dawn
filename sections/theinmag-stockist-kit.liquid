    background: rgba(42, 31, 61, 0.72); color: #fff; font: 600 13px/1 var(--font-body); text-decoration: none;
    opacity: 0; transform: translateY(6px); transition: opacity 0.25s ease, transform 0.25s ease;
  }
  a:hover > .sk-tile-cta, a:focus-visible > .sk-tile-cta, .sk-tile-cta--on { opacity: 1; transform: none; }
  @media (hover: none) { .sk-tile-cta { opacity: 1; transform: none; } }
  .sk-meta { font: 400 12px/1.3 var(--font-body); letter-spacing: 0.02em; opacity: 0.6; }
  .sk-flag {
    position: absolute; top: 12px; left: 12px; padding: 6px 10px; border-radius: var(--radius-sm, 6px);
    background: var(--sk-ink); color: var(--sk-paper); font: 700 11px/1 var(--font-body); letter-spacing: 0.08em; text-transform: uppercase;
  }

  /* 01 Covers: gallery wall, newest cover large */
  .sk-covers { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(20px, 3vw, 40px) clamp(14px, 2.4vw, 32px); }
  .sk-cover { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .sk-cover--lead { grid-column: 1 / -1; }
  .sk-cover__media { position: relative; display: block; box-shadow: 0 18px 36px rgba(42, 31, 61, 0.18), 0 4px 10px rgba(42, 31, 61, 0.1); transition: transform 0.35s cubic-bezier(.2, .7, .2, 1), box-shadow 0.35s ease; }
  .sk-cover__media:hover { transform: translateY(-6px); box-shadow: 0 28px 48px rgba(42, 31, 61, 0.24), 0 8px 16px rgba(42, 31, 61, 0.12); }
  .sk-cover__media img { width: 100%; height: auto; }
  .sk-cover__cap { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
  .sk-cover__name { font: 700 16px/1.2 var(--font-body); }

  .sk-cover-fill { display: none; }
  .sk-cover-fill[data-rem-m="1"] { display: block; grid-column: span 1; }
  .sk-cover-fill__btn {
    width: 100%; height: 100%; min-height: 220px; border: 0; cursor: pointer; text-align: left;
    background: var(--sk-ink); color: var(--sk-paper); padding: clamp(18px, 2.4vw, 32px);
    display: flex; flex-direction: column; justify-content: space-between; gap: 12px;
    transition: background-color 0.3s ease;
  }
  .sk-cover-fill__btn:hover, .sk-cover-fill__btn:focus-visible { background: var(--color-purple-dark, #5D3A7A); }
  .sk-cover-fill__num { font: 700 clamp(64px, 8vw, 120px)/0.9 var(--font-body); letter-spacing: -0.04em; color: var(--sk-pink); }
  .sk-cover-fill__label { font: 500 16px/1.3 var(--font-body); }
  .sk-cover-fill__go { display: inline-flex; align-items: center; gap: 8px; font: 700 15px/1 var(--font-body); }
  .sk-cover-fill__btn span { color: inherit; }

  /* 02 Ready to post: one even row height, each tile at its true shape
     (square post, 9:16 story, round sticker), so stories are never cropped. */
  .sk-social { --row: clamp(200px, 46vw, 300px); list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: clamp(14px, 2.4vw, 28px); align-items: flex-end; }
  .sk-social__tile { flex: 0 0 auto; width: calc(var(--row) * var(--ar)); }
  .sk-social__media { position: relative; display: block; overflow: hidden; aspect-ratio: var(--ar); box-shadow: 0 14px 30px rgba(42, 31, 61, 0.16); }
  .sk-social__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s cubic-bezier(.2, .7, .2, 1); }
  .sk-social__media:hover img { transform: scale(1.03); }
  .sk-social__tile--round .sk-social__media { box-shadow: none; overflow: visible; }
  .sk-social__tile--round .sk-social__media img { object-fit: contain; filter: drop-shadow(0 12px 22px rgba(42, 31, 61, 0.2)); }
  .sk-social__cap { margin: 10px 0 0; font: 600 13px/1.3 var(--font-body); display: flex; flex-direction: column; gap: 2px; }

  /* 03 Photos: 4px grout, sharp edges */
  .sk-mosaic { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: clamp(140px, 42vw, 240px); gap: 4px; }
  .sk-mosaic__cell { position: relative; min-width: 0; }
