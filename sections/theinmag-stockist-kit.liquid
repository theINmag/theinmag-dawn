    font: 700 14px/1 var(--font-body); color: var(--sk-ink); cursor: pointer;
  }
  .sk-more:hover, .sk-more:focus-visible { background: var(--sk-ink); color: var(--sk-paper); }
  /* See more: only the first --show items until expanded. Phones swipe the
     clip rail instead, so every clip stays on it there. */
  /* Collapsed: a fixed-height window with a soft fade, so every column ends
     on the same line whatever the photos are (hiding items by count left
     ragged gaps). See all removes the cap. */
  .sk-feed:not(.is-expanded) {
    max-height: 1180px; overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, #000 82%, transparent);
    mask-image: linear-gradient(to bottom, #000 82%, transparent);
  }
  .sk-feed + .sk-more { margin-top: 20px; }
  .sk-subhead__btns { display: flex; gap: 8px; flex-wrap: wrap; }
  .sk-masonry__media--clip { aspect-ratio: 9 / 16; background: var(--sk-ink); }
  .sk-masonry__media--clip video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .sk-sub { margin: 0 0 14px; font: 700 15px/1.3 var(--font-body); display: flex; gap: 10px; align-items: baseline; }
  .sk-reels {
    list-style: none; margin: 0 calc(-1 * var(--sk-gut)) clamp(32px, 5vw, 56px); padding: 0 var(--sk-gut) 8px;
    display: grid; grid-auto-flow: column; grid-auto-columns: 62vw; gap: 12px;
    overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
  }
  .sk-reels::-webkit-scrollbar { display: none; }
  .sk-reel { scroll-snap-align: start; min-width: 0; }
  .sk-reel__media { position: relative; aspect-ratio: 9 / 16; overflow: hidden; background: var(--sk-ink); }
  .sk-reel__media video { width: 100%; height: 100%; object-fit: cover; }
  .sk-reel__cap { margin: 8px 0 0; font: 500 13px/1.3 var(--font-body); }
  .sk-masonry { list-style: none; margin: 0; padding: 0; columns: 2; column-gap: 8px; }
  .sk-masonry__item { break-inside: avoid; margin: 0 0 8px; }
  .sk-masonry__media { position: relative; display: block; overflow: hidden; }
  .sk-masonry__media img { width: 100%; height: auto; transition: transform 0.6s cubic-bezier(.2, .7, .2, 1); }
  .sk-masonry__media:hover img { transform: scale(1.03); }
  .sk-reels + .sk-more { display: none; }
  @media (min-width: 750px) {
    .sk-reels { margin: 0 0 16px; padding: 0; grid-auto-flow: row; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 16px; overflow: visible; }
    .sk-reels:not(.is-expanded) > li:nth-child(n + 6) { display: none; }
    .sk-reels + .sk-more { display: block; }
    .sk-feed:not(.is-expanded) { max-height: 1400px; }
    .sk-masonry { columns: 3; column-gap: 12px; }
    .sk-masonry__item { margin-bottom: 12px; }
  }
  @media (min-width: 1100px) { .sk-masonry { columns: 4; } }

  .sk-pv-hit { position: absolute; inset: 0; z-index: 1; width: 100%; height: 100%; border: 0; padding: 0; background: transparent; cursor: zoom-in; }
  .sk-masonry__media { cursor: zoom-in; }
  .sk-masonry__media--clip .sk-tile-cta { z-index: 2; }
  .sk-lb {
    width: 100vw; max-width: 100vw; height: 100dvh; max-height: 100dvh; margin: 0; padding: 0; border: 0;
    background: rgba(20, 14, 31, 0.94); color: var(--sk-paper);
  }
  .sk-lb::backdrop { background: rgba(20, 14, 31, 0.6); }
  .sk-lb[open] { display: flex; flex-direction: column; }
  .sk-lb__stage { flex: 1 1 auto; min-height: 0; display: flex; align-items: center; justify-content: center; padding: 56px 16px 8px; }
  .sk-lb__stage img, .sk-lb__stage video { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5); }
  .sk-lb__bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 12px 16px calc(16px + env(safe-area-inset-bottom)); }
  .sk-lb__count { font: 500 14px/1 var(--font-body); opacity: 0.75; }
  .sk-lb__close, .sk-lb__nav {
    position: absolute; width: 48px; height: 48px; border-radius: 50%; border: 0; cursor: pointer;
    background: rgba(251, 246, 234, 0.14); color: var(--sk-paper); font: 400 26px/1 var(--font-body);
    display: flex; align-items: center; justify-content: center;
  }
  .sk-lb__close:hover, .sk-lb__nav:hover, .sk-lb__close:focus-visible, .sk-lb__nav:focus-visible { background: rgba(251, 246, 234, 0.28); }
  .sk-lb__close { top: 12px; right: 12px; font-size: 32px; }
  .sk-lb__nav { top: 50%; transform: translateY(-50%); }
  .sk-lb__nav--prev { left: 12px; }
  .sk-lb__nav--next { right: 12px; }
  @media (max-width: 749px) { .sk-lb__nav { top: auto; bottom: calc(76px + env(safe-area-inset-bottom)); transform: none; } }
  .sk-toast {
    position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%); z-index: 50; margin: 0;
    padding: 12px 18px; border-radius: 12px; background: var(--sk-ink); color: var(--sk-paper);
    font: 500 14px/1.4 var(--font-body); max-width: calc(100vw - 32px);
  }

  @media (min-width: 750px) {
    .sk-head { grid-template-columns: 64px minmax(0, 1fr) auto; }
    .sk-head__note { grid-column: 2 / 3; }
    .sk-head .sk-btn { grid-column: 3; grid-row: 1 / 3; align-self: end; }
    .sk-covers { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .sk-cover--lead { grid-column: span 2; grid-row: span 2; }
    /* Four tiles (square, story, square, story = 3.125 squares wide) fill the
       first row edge to edge; the second row lands within a few px. */
    .sk-social { --row: calc((min(100vw, var(--sk-max)) - 2 * var(--sk-gut) - 3 * 28px) / 3.125); gap: 28px; }
    .sk-cover-fill, .sk-cover-fill[data-rem-m="1"] { display: none; }
    .sk-cover-fill:not([data-rem-d="0"]) { display: block; grid-column: span var(--rem-d); }
    .sk-mosaic { grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: clamp(160px, 18vw, 260px); }
    .sk-mosaic__cell--large { grid-column: span 2; grid-row: span 2; }
    .sk-mosaic__cell--wide { grid-column: span 2; }
    .sk-logos { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .sk-word { grid-template-columns: 140px minmax(0, 1fr) auto; }
    .sk-foot__rules { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 48px; }
  }
  @media (min-width: 990px) {
    .sk-hero__inner { grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); }
  }
  @media (prefers-reduced-motion: reduce) {
    .sk *, .sk *::before, .sk *::after { transition: none !important; }
  }
</style>

