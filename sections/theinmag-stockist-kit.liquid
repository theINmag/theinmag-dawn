  .sk-mosaic__media { position: absolute; inset: 0; display: block; overflow: hidden; background: #ddd; }
  .sk-mosaic__media img, .sk-mosaic__media video { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s cubic-bezier(.2, .7, .2, 1); }
  a.sk-mosaic__media:hover img { transform: scale(1.04); }

  /* 04 Logos: hairline specimen grid */
  .sk-logos { list-style: none; margin: 0; padding: 1px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--sk-rule); }
  .sk-logo { background: #fff; }
  .sk-logo--dark { background: var(--sk-ink); color: var(--sk-paper); }
  .sk-logo__link { display: flex; flex-direction: column; height: 100%; color: inherit; text-decoration: none; }
  .sk-logo__stage { display: flex; align-items: center; justify-content: center; aspect-ratio: 1 / 1; padding: 16%; }
  .sk-logo__stage img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; transition: transform 0.4s cubic-bezier(.2, .7, .2, 1); }
  .sk-logo__link:hover .sk-logo__stage img { transform: scale(1.05); }
  .sk-logo__cap { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-top: auto; padding: 12px 14px; border-top: 1px solid var(--sk-rule); font: 500 13px/1.3 var(--font-body); }
  .sk-logo__dl { display: inline-flex; align-items: center; gap: 4px; font-weight: 700; white-space: nowrap; }
  .sk-logo__link:hover .sk-logo__dl { text-decoration: underline; text-underline-offset: 3px; }

  /* 05 Words */
  .sk-words { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--sk-rule); }
  .sk-word { display: grid; gap: 10px 24px; padding: 22px 0; border-bottom: 1px solid var(--sk-rule); align-items: start; }
  .sk-word__label { margin: 0; font: 600 12px/1.2 var(--font-body); letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-purple-dark, #5D3A7A); }
