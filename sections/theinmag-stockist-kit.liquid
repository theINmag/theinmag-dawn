  }
  .sk-eyebrow {
    margin: 0 0 18px; font: 600 12px/1 var(--font-body); letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--sk-pink);
  }
  .sk .sk-hero__h1 {
    color: var(--sk-paper);
    margin: 0 0 20px; font-family: var(--font-heading); font-weight: 400; font-synthesis: none;
    font-size: clamp(44px, 8vw, 96px); line-height: 0.98; letter-spacing: -0.01em;
  }
  .sk .sk-hero__lede { color: var(--sk-paper); margin: 0 0 32px; max-width: 34ch; font: 400 clamp(16px, 1.6vw, 19px)/1.55 var(--font-body); opacity: 0.86; }
  .sk-hero__actions { margin-bottom: clamp(32px, 5vw, 56px); }
  .sk-hero__index {
    list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid rgba(251, 246, 234, 0.2);
  }
  .sk-hero__index li { border-bottom: 1px solid rgba(251, 246, 234, 0.2); }
  .sk-hero__index a {
    display: flex; gap: 12px; align-items: baseline; padding: 14px 0; min-height: 44px;
    color: var(--sk-paper); text-decoration: none; font: 500 15px/1.2 var(--font-body);
  }
  .sk-hero__index a span { font: 400 12px/1 var(--font-body); letter-spacing: 0.08em; color: var(--sk-pink); }
  .sk-hero__index a:hover, .sk-hero__index a:focus-visible { color: var(--sk-pink); }
  .sk-hero__stage { position: relative; aspect-ratio: 1 / 1; max-width: 640px; width: 100%; justify-self: center; }
  .sk-hero__cover {
    position: absolute; width: 58%; top: 50%; left: 50%;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.45), 0 10px 20px rgba(0, 0, 0, 0.3);
    transition: transform 0.5s cubic-bezier(.2, .7, .2, 1);
  }
  .sk-hero__cover img { width: 100%; height: auto; }
  .sk-hero__cover--1 { z-index: 3; transform: translate(-50%, -50%) rotate(-3deg); }
  .sk-hero__cover--2 { z-index: 2; transform: translate(-12%, -56%) rotate(7deg); opacity: 0.92; }
  .sk-hero__cover--3 { z-index: 1; transform: translate(-90%, -44%) rotate(-11deg); opacity: 0.8; }

  /* Buttons */
  .sk-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    min-height: 48px; padding: 0 22px; border-radius: var(--radius-button, 32px);
    font: 700 15px/1 var(--font-body); cursor: pointer; text-decoration: none; white-space: nowrap;
    transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }
  .sk-btn:disabled { opacity: 0.6; cursor: progress; }
  .sk-btn--stamp {
    background: var(--color-yellow, #F9C23C); color: var(--sk-ink); border: 0;
    box-shadow: 0 4px 0 var(--color-yellow-shadow, #D4A02E);
  }
  .sk-btn--stamp:hover { transform: translateY(-2px); }
  .sk-btn--line { background: transparent; color: var(--sk-ink); border: 1.5px solid var(--sk-ink); }
  .sk-btn--line:hover, .sk-btn--line:focus-visible { background: var(--sk-ink); color: var(--sk-paper); }
  .sk-btn--sm { min-height: 40px; padding: 0 16px; font-size: 14px; }
  .sk-link {
    align-self: flex-start; background: none; border: 0; padding: 6px 0; min-height: 32px; cursor: pointer;
    font: 600 13px/1.2 var(--font-body); color: var(--sk-ink); text-decoration: underline; text-underline-offset: 3px;
  }

  /* Groups */
  .sk-group { max-width: var(--sk-max); margin: 0 auto; padding: clamp(56px, 8vw, 112px) var(--sk-gut) 0; }
  .sk-group--tint { max-width: none; background: var(--color-lavender, #E8DEEF); margin-top: clamp(56px, 8vw, 112px); padding-bottom: clamp(56px, 8vw, 112px); }
  .sk-group--tint > * { max-width: calc(var(--sk-max) - 2 * var(--sk-gut)); margin-left: auto; margin-right: auto; }
  .sk-head {
    display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 18px; row-gap: 10px; align-items: baseline;
    border-top: 1.5px solid var(--sk-ink); padding-top: 18px; margin-bottom: clamp(24px, 4vw, 44px);
  }
  .sk-head__num { font: 400 13px/1 var(--font-body); letter-spacing: 0.12em; color: var(--color-purple-dark, #5D3A7A); }
  .sk .sk-head__h2 { color: var(--sk-ink); margin: 0; font: 700 clamp(30px, 4.4vw, 52px)/1 var(--font-body); letter-spacing: -0.025em; }
  .sk-head__note { grid-column: 1 / -1; margin: 0; max-width: 52ch; font: 400 15px/1.5 var(--font-body); opacity: 0.75; }
  .sk-head .sk-btn { grid-column: 1 / -1; justify-self: start; }

  /* Shared tile download chip: white on scrim */
  .sk-tile-cta {
    position: absolute; left: 12px; bottom: 12px; z-index: 2;
