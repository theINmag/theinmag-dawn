{%- comment -%}
  theinmag-for-parents-pillars
  Section 2 of /pages/for-parents - diptych + break + trio.

  Three-zone layout from a flat block list:
   1. Diptych: first two `pillar` blocks where weight = hero. Side-by-
      side desktop, stacked mobile. Inter 700 headlines with optional
      single-word Caveat emphasis lift (`.theinmag-emphasis`).
   2. Breathing slot: first `kid_creation_break` block. Full-bleed
      kid creation image with bottom-right attribution caption.
   3. Trio: first three `pillar` blocks where weight = standard.
      Smaller typography, no Caveat lift.

  Decoupled from theinmag-membership-pillars.liquid (sticky-nav reveal
  pattern) - this is a card-grid pattern that's fundamentally different
  visual architecture. Membership PDP keeps its section unchanged.

  Section bg = cream + optional watermark PNG (e.g. kid-leaves_bottom_right)
  at low opacity, parallax-fixed.
{%- endcomment -%}

{%- liquid
  comment
    Heading defaults to plain Inter 700; [[IN]] / [[EM]] / [[/EM]]
    tokens strip to no-op. Switch heading_style_post ON to render the
    heading in Post Regular, centred, with [[IN]] wrapped in
    .theinmag-in for the brand-pun lift (design system 5.4 - reserved
    for brand-pun moments like "IN the classroom").
    Card headlines + body always render plain Inter 700.
  endcomment
  assign heading_raw = section.settings.heading | default: ''
  assign heading_style_post = section.settings.heading_style_post
  if heading_style_post
    assign heading = heading_raw | replace: '[[IN]]', '<span class="theinmag-in">IN</span>'
    assign heading_modifier = ' theinmag-for-parents-pillars__heading--post'
    assign header_modifier = ' theinmag-for-parents-pillars__header--centered'
  else
    assign heading = heading_raw | replace: '[[IN]]', 'IN'
    assign heading_modifier = ''
    assign header_modifier = ''
  endif
  assign intro_text = section.settings.intro_text
  assign watermark_filename = section.settings.watermark_filename
  assign watermark_opacity = section.settings.watermark_opacity | default: 10
  assign watermark_opacity_decimal = watermark_opacity | times: 1.0 | divided_by: 100.0

  assign bg_image_filename = section.settings.bg_image_filename
  assign bg_image_opacity = section.settings.bg_image_opacity | default: 30
  assign bg_image_opacity_decimal = bg_image_opacity | times: 1.0 | divided_by: 100.0

  comment
    Count + locate blocks by type/weight via flag pattern (Liquid's
    `concat` filter requires array operands; concatenating single
    block objects silently no-ops, which broke v1 of this section).
    Render passes below iterate section.blocks directly with inline
    filters - no pre-partitioned arrays needed.
  endcomment
  assign hero_count = 0
  assign standard_count = 0
  assign break_block = blank
  for block in section.blocks
    if block.type == 'pillar'
      if block.settings.weight == 'hero'
        assign hero_count = hero_count | plus: 1
      else
        assign standard_count = standard_count | plus: 1
      endif
    elsif block.type == 'kid_creation_break'
      if break_block == blank
        assign break_block = block
      endif
    endif
  endfor
-%}

<section
  class="theinmag-for-parents-pillars"
  aria-labelledby="theinmag-for-parents-pillars-heading-{{ section.id }}"
  style="--theinmag-fpp-watermark-opacity: {{ watermark_opacity_decimal }};{% if watermark_filename != blank %} --theinmag-fpp-watermark: url('{{ watermark_filename | asset_url }}');{% endif %} --theinmag-fpp-bg-opacity: {{ bg_image_opacity_decimal }};{% if bg_image_filename != blank %} --theinmag-fpp-bg-image: url('{{ bg_image_filename | asset_url }}');{% endif %}"
>
  {%- if bg_image_filename != blank -%}
    <div class="theinmag-for-parents-pillars__bg-image" aria-hidden="true"></div>
  {%- endif -%}

  {%- if watermark_filename != blank -%}
    <div class="theinmag-for-parents-pillars__watermark" aria-hidden="true"></div>
  {%- endif -%}

  <div class="theinmag-for-parents-pillars__inner">
    <header class="theinmag-for-parents-pillars__header{{ header_modifier }}">
      {%- if heading_style_post -%}
        {% render 'theinmag-character-pool' %}
        <span class="theinmag-for-parents-pillars__character-right" data-theinmag-pool-character aria-hidden="true"></span>
      {%- endif -%}

      {%- if heading != blank -%}
        <h2
          id="theinmag-for-parents-pillars-heading-{{ section.id }}"
          class="theinmag-for-parents-pillars__heading{{ heading_modifier }}"
        >
          {{ heading }}
        </h2>
      {%- endif -%}

      {%- if intro_text != blank -%}
        <p class="theinmag-for-parents-pillars__intro">{{ intro_text }}</p>
      {%- endif -%}
    </header>

    {%- if hero_count > 0 -%}
      <div class="theinmag-for-parents-pillars__diptych">
        {%- for block in section.blocks -%}
          {%- if block.type == 'pillar' and block.settings.weight == 'hero' -%}
            {%- liquid
              comment
                Strip the legacy [[EM]]...[[/EM]] tokens to plain text -
                Caveat cherry-magenta emphasis is reserved for field-notes
                author signatures, not pillar headlines.
              endcomment
              assign headline_raw = block.settings.headline | default: ''
              assign headline_html = headline_raw | replace: '[[EM]]', '' | replace: '[[/EM]]', ''
            -%}
            <div class="theinmag-for-parents-pillars__card theinmag-for-parents-pillars__card--hero" {{ block.shopify_attributes }}>
              {%- if block.settings.accent_filename != blank -%}
                {%- assign accent_op = block.settings.accent_opacity | default: 35 | divided_by: 100.0 -%}
                <img
                  class="theinmag-for-parents-pillars__accent theinmag-for-parents-pillars__accent--{{ block.settings.accent_position | default: 'top-right' }}"
                  src="{{ block.settings.accent_filename | asset_url }}"
                  alt=""
                  aria-hidden="true"
                  loading="lazy"
                  style="--theinmag-fpp-accent-opacity: {{ accent_op }};"
                >
              {%- endif -%}

              {%- if block.settings.eyebrow != blank -%}
                <p class="theinmag-for-parents-pillars__eyebrow">{{ block.settings.eyebrow }}</p>
              {%- endif -%}

              {%- if headline_html != blank -%}
                <p class="theinmag-for-parents-pillars__headline theinmag-for-parents-pillars__headline--hero">{{ headline_html }}</p>
              {%- endif -%}

              {%- if block.settings.body != blank -%}
                <p class="theinmag-for-parents-pillars__body">{{ block.settings.body }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%}
      Capture the break markup so we can render it either between
      diptych + trio (canonical, when a diptych exists above) or
      after the trio (when there's no diptych, e.g. /pages/for-teachers
      where the section opens straight with the trio).
    {%- endcomment -%}
    {%- capture break_html -%}
      {%- if break_block != blank -%}
        {%- assign break_image = break_block.settings.image -%}
        {%- assign break_filename = break_block.settings.image_filename -%}
        {%- assign break_alt = break_block.settings.image_alt | default: 'Kid creation from a recent issue of theINmag.' -%}
        {%- assign break_caption = break_block.settings.caption -%}
        <figure class="theinmag-for-parents-pillars__break" {{ break_block.shopify_attributes }}>
          {%- if break_image != blank -%}
            <img
              class="theinmag-for-parents-pillars__break-image"
              src="{{ break_image | image_url: width: 1600 }}"
              srcset="
                {{ break_image | image_url: width: 600 }} 600w,
                {{ break_image | image_url: width: 900 }} 900w,
                {{ break_image | image_url: width: 1200 }} 1200w,
                {{ break_image | image_url: width: 1600 }} 1600w
              "
              sizes="(min-width: 990px) 1120px, 90vw"
              width="{{ break_image.width }}"
              height="{{ break_image.height }}"
              alt="{{ break_alt | escape }}"
              loading="lazy"
            >
          {%- elsif break_filename != blank -%}
            <img
              class="theinmag-for-parents-pillars__break-image"
              src="{{ break_filename | asset_url }}"
              alt="{{ break_alt | escape }}"
              loading="lazy"
            >
          {%- else -%}
            <div class="theinmag-for-parents-pillars__break-placeholder" aria-label="Placeholder for the breathing-slot kid creation image (TBC asset)">
              <span>TBC<br>Kid creation</span>
            </div>
          {%- endif -%}

          {%- if break_caption != blank -%}
            <figcaption class="theinmag-for-parents-pillars__break-caption">{{ break_caption }}</figcaption>
          {%- endif -%}
        </figure>
      {%- endif -%}
    {%- endcapture -%}

    {%- if break_block != blank and hero_count > 0 -%}
      {{ break_html }}
    {%- endif -%}

    {%- if standard_count > 0 -%}
      <div class="theinmag-for-parents-pillars__trio">
        {%- for block in section.blocks -%}
          {%- if block.type == 'pillar' and block.settings.weight != 'hero' -%}
            <div class="theinmag-for-parents-pillars__card theinmag-for-parents-pillars__card--standard" {{ block.shopify_attributes }}>
              {%- if block.settings.accent_filename != blank -%}
                {%- assign accent_op = block.settings.accent_opacity | default: 35 | divided_by: 100.0 -%}
                <img
                  class="theinmag-for-parents-pillars__accent theinmag-for-parents-pillars__accent--{{ block.settings.accent_position | default: 'top-right' }}"
                  src="{{ block.settings.accent_filename | asset_url }}"
                  alt=""
                  aria-hidden="true"
                  loading="lazy"
                  style="--theinmag-fpp-accent-opacity: {{ accent_op }};"
                >
              {%- endif -%}

              {%- if block.settings.eyebrow != blank -%}
                <p class="theinmag-for-parents-pillars__eyebrow">{{ block.settings.eyebrow }}</p>
              {%- endif -%}

              {%- if block.settings.headline != blank -%}
                <p class="theinmag-for-parents-pillars__headline theinmag-for-parents-pillars__headline--standard">{{ block.settings.headline }}</p>
              {%- endif -%}

              {%- if block.settings.body != blank -%}
                <p class="theinmag-for-parents-pillars__body">{{ block.settings.body }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if break_block != blank and hero_count == 0 -%}
      {{ break_html }}
    {%- endif -%}
  </div>
</section>

{%- stylesheet -%}
  .theinmag-for-parents-pillars {
    position: relative;
    background-color: var(--color-cream, #FBF6EA);
    color: var(--color-inky-purple-navy, #2A1F3D);
    padding: clamp(64px, 10vw, 120px) clamp(20px, 5vw, 64px);
    overflow: hidden;
  }

  .theinmag-for-parents-pillars__watermark {
    position: absolute;
    inset: auto 0 0 auto;
    width: clamp(280px, 35vw, 520px);
    height: clamp(280px, 35vw, 520px);
    background-image: var(--theinmag-fpp-watermark);
    background-repeat: no-repeat;
    background-position: bottom right;
    background-size: contain;
    background-attachment: fixed;
    opacity: var(--theinmag-fpp-watermark-opacity, 0.1);
    pointer-events: none;
    z-index: 0;
  }

  /* Full-bleed bg image. Sits behind cards + heading at configured
     opacity so cream still feels like the dominant tone. Cards stay
     white so they pop off the patterned bg.
     2-class selector beats Dawn's `div:empty { display: none }` rule
     (base.css:471) - this div is decoration-only with no children. */
  .theinmag-for-parents-pillars .theinmag-for-parents-pillars__bg-image {
    display: block;
    position: absolute;
    inset: 0;
    background-image: var(--theinmag-fpp-bg-image);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: var(--theinmag-fpp-bg-opacity, 0.3);
    pointer-events: none;
    z-index: 0;
  }

  .theinmag-for-parents-pillars__inner {
    position: relative;
    z-index: 1;
    max-width: 1180px;
    margin: 0 auto;
  }

  /* Header runs full inner width so the heading + intro sit on a
     single line on desktop (Ryan's call - the previous 60ch cap was
     forcing both onto 2 lines and breaking the editorial rhythm). */
  .theinmag-for-parents-pillars__header {
    max-width: none;
    margin: 0 0 clamp(40px, 5vw, 64px);
  }

  .theinmag-for-parents-pillars__heading {
    margin: 0 0 clamp(14px, 1.5vw, 18px);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: clamp(28px, 4.5vw, 40px);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-inky-purple-navy, #2A1F3D);
    /* text-wrap: balance removed - it was forcing a 2-line break.
       Single-line on desktop is the goal here. */
  }

  .theinmag-for-parents-pillars__intro {
    margin: 0;
    max-width: none;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: clamp(15px, 1.6vw, 17px);
    line-height: 1.6;
    color: rgba(42, 31, 61, 0.78);
  }

  /* Post Regular + centred variant. Opt-in via section setting
     heading_style_post - reserved for brand-pun headings ("IN the
     classroom", "INside the magazine"). The .theinmag-in span (1.4em)
     does the IN lift on top of Post Regular. Compresses top padding +
     all the internal heading-subhead-cards gaps so the centred
     treatment reads as one tight unit and doesn't float in cream. */
  .theinmag-for-parents-pillars__header--centered {
    position: relative;
    text-align: center;
    margin-bottom: clamp(16px, 2vw, 24px);
  }

  /* Kid character on the right of the heading. Pops in from off-screen
     right via translateX(60px) -> translateX(0). Slightly bigger than
     the curriculum-accordion character (clamp 100-150px vs 79-121px)
     to balance the centred Post Regular heading. Hidden on mobile to
     avoid clashing with the wrapping heading text. */
  .theinmag-for-parents-pillars__character-right {
    position: absolute;
    top: 50%;
    right: clamp(8px, 4vw, 56px);
    width: clamp(100px, 12vw, 150px);
    height: auto;
    z-index: 3;
    transform: translateY(-50%) translateX(60px) rotate(6deg);
    transform-origin: center;
  }

  .theinmag-for-parents-pillars__character-right.is-popped {
    transform: translateY(-50%) translateX(0) rotate(6deg);
  }

  @media (max-width: 767px) {
    .theinmag-for-parents-pillars__character-right {
      display: none;
    }
  }

  .theinmag-for-parents-pillars:has(.theinmag-for-parents-pillars__header--centered) {
    padding-top: clamp(32px, 5vw, 60px);
  }

  .theinmag-for-parents-pillars__heading--post {
    font-family: var(--font-heading, 'Post Regular', serif);
    font-weight: 400;
    font-size: clamp(40px, 6vw, 64px);
    line-height: 1.1;
    letter-spacing: 0;
    margin-bottom: clamp(2px, 0.4vw, 6px);
  }

  .theinmag-for-parents-pillars__header--centered .theinmag-for-parents-pillars__intro {
    max-width: 75ch;
    margin-left: auto;
    margin-right: auto;
  }

  /* ================================================================
     Diptych - 2 hero pillars, side-by-side desktop, stacked mobile.
     ================================================================ */

  .theinmag-for-parents-pillars__diptych {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(28px, 4vw, 48px);
    margin: 0 0 clamp(40px, 6vw, 72px);
  }

  @media (min-width: 990px) {
    .theinmag-for-parents-pillars__diptych {
      grid-template-columns: 1fr 1fr;
      gap: clamp(40px, 5vw, 64px);
    }
  }

  /* ================================================================
     Trio - 3 standard pillars, side-by-side desktop, stacked mobile.
     ================================================================ */

  .theinmag-for-parents-pillars__trio {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(24px, 3vw, 36px);
    margin: clamp(40px, 6vw, 72px) 0 0;
  }

  @media (min-width: 990px) {
    .theinmag-for-parents-pillars__trio {
      grid-template-columns: repeat(3, 1fr);
      gap: clamp(28px, 3.5vw, 44px);
    }
  }

  /* ================================================================
     Card (shared shape for both diptych + trio cards)
     ================================================================ */

  .theinmag-for-parents-pillars__card {
    position: relative;
    background-color: #ffffff;
    border-radius: var(--radius-lg, 20px);
    padding: clamp(24px, 3vw, 36px);
    /* overflow: hidden clips the big accent artwork at the card edge -
       gives the "slightly bleeding off the corner, contained per tile"
       feel without letting the artwork escape into other layout. */
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(42, 31, 61, 0.06);
  }

  .theinmag-for-parents-pillars__card--hero {
    padding: clamp(28px, 3.5vw, 44px);
  }

  /* Accent artwork - large, subtle ghost in a card corner.
     ~10x the original 32-60px size. Slightly bleeds past the corner
     and gets clipped by the card's overflow: hidden (above) so it
     never escapes the tile. Per-block opacity (set via inline style
     from block.settings.accent_opacity) - kid-leaves PNGs are
     naturally darker and read well at ~0.18; rainbow/bundle PNGs
     are lighter and need ~0.35 to land. Static - no animation. */

  .theinmag-for-parents-pillars__accent {
    position: absolute;
    width: clamp(180px, 28vw, 320px);
    height: auto;
    pointer-events: none;
    opacity: var(--theinmag-fpp-accent-opacity, 0.35);
    /* z-index 0 so card text sits cleanly on top. */
    z-index: 0;
  }

  /* Card content needs a stacking context above the accent. */
  .theinmag-for-parents-pillars__eyebrow,
  .theinmag-for-parents-pillars__headline,
  .theinmag-for-parents-pillars__body {
    position: relative;
    z-index: 1;
  }

  /* Each corner pushes the artwork slightly past the edge (~25% of
     its own width) so the corner of the artwork sits roughly at the
     card corner and the rest bleeds off (then gets clipped). */
  .theinmag-for-parents-pillars__accent--top-right {
    top: -10%;
    right: -10%;
  }

  .theinmag-for-parents-pillars__accent--top-left {
    top: -10%;
    left: -10%;
  }

  .theinmag-for-parents-pillars__accent--bottom-right {
    bottom: -10%;
    right: -10%;
  }

  .theinmag-for-parents-pillars__accent--bottom-left {
    bottom: -10%;
    left: -10%;
  }

  /* Card typography */

  .theinmag-for-parents-pillars__eyebrow {
    margin: 0 0 clamp(10px, 1.2vw, 14px);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 500;
    font-size: 11px;
    line-height: 1.4;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(123, 79, 158, 0.85);
  }

  .theinmag-for-parents-pillars__headline {
    margin: 0 0 clamp(12px, 1.5vw, 16px);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-inky-purple-navy, #2A1F3D);
    text-wrap: balance;
  }

  .theinmag-for-parents-pillars__headline--hero {
    font-size: clamp(24px, 3.4vw, 32px);
    line-height: 1.2;
  }

  .theinmag-for-parents-pillars__headline--standard {
    font-size: clamp(20px, 2.4vw, 24px);
    line-height: 1.25;
  }

  .theinmag-for-parents-pillars__body {
    margin: 0;
    max-width: 36ch;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: clamp(14px, 1.5vw, 16px);
    line-height: 1.7;
    color: var(--color-inky-purple-navy, #2A1F3D);
  }

  /* ================================================================
     Breathing slot - full-bleed kid creation with bottom-right caption.
     ================================================================ */

  .theinmag-for-parents-pillars__break {
    position: relative;
    margin: clamp(40px, 6vw, 72px) auto;
    max-width: 880px;
    text-align: center;
  }

  /* Transparent PNG floats on the cream section bg - no frame, no
     border-radius, no crop. Natural aspect of the source image. */
  .theinmag-for-parents-pillars__break-image {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
    background: transparent;
    border-radius: 0;
  }

  .theinmag-for-parents-pillars__break-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: rgba(123, 79, 158, 0.15);
    color: rgba(123, 79, 158, 0.65);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 500;
    font-size: 14px;
    line-height: 1.4;
    text-align: center;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: var(--radius-lg, 20px);
  }

  .theinmag-for-parents-pillars__break-caption {
    position: absolute;
    right: clamp(16px, 2vw, 24px);
    bottom: clamp(16px, 2vw, 24px);
    margin: 0;
    padding: 6px 12px;
    font-family: var(--font-heading, 'Post Regular', serif);
    font-weight: 400;
    font-size: clamp(14px, 1.4vw, 16px);
    line-height: 1.3;
    color: #ffffff;
    background-color: rgba(20, 14, 30, 0.55);
    border-radius: 999px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.45);
  }

  /* Full-bleed treatment when the break is the section's final element
     (i.e. rendered after the trio because there's no diptych above it -
     /pages/for-teachers pattern). The figure escapes both the inner's
     max-width AND the section's horizontal padding, and we collapse
     the section's bottom padding so the image hugs the next section.
     for-parents is unaffected: its break sits between diptych and
     trio so it's never :last-child. */
  .theinmag-for-parents-pillars__inner > .theinmag-for-parents-pillars__break:last-child {
    max-width: none;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    margin-bottom: 0;
  }

  .theinmag-for-parents-pillars__inner > .theinmag-for-parents-pillars__break:last-child .theinmag-for-parents-pillars__break-image {
    max-width: none;
    border-radius: 0;
  }

  .theinmag-for-parents-pillars:has(> .theinmag-for-parents-pillars__inner > .theinmag-for-parents-pillars__break:last-child) {
    padding-bottom: 0;
  }

  /* Mobile: accent artwork scales down with the smaller card width
     so it stays in proportion. Same relative size + opacity treatment. */
  @media (max-width: 749px) {
    .theinmag-for-parents-pillars__accent {
      width: clamp(140px, 40vw, 220px);
    }
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "For parents pillars",
  "tag": "section",
  "class": "theinmag-for-parents-pillars-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Diptych (2 hero pillars) + breathing slot (kid creation) + trio (3 standard pillars). Card order in the editor controls render order. Heading + headlines render plain Inter 700; the .theinmag-in and Caveat emphasis classes are not used here (reserved for Post brand moments + field-notes signatures respectively)."
    },
    {
      "type": "textarea",
