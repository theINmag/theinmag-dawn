{%- comment -%}
  theinmag-behind-the-mag-see-more
  Two-card row pointing to Branching Out (YouTube) and the @the.inmag
  Instagram. Asymmetric 2/3 + 1/3 split on desktop so each card matches
  its platform's native aspect: Branching Out fills the wider tile with
  a 16:9 YouTube facade (click to play inline); Instagram sits in the
  narrower tile with a 4:5 portrait image and a link button.

  Cards live as blocks; the schema's youtube_video_id setting flips a
  card from "image link" to "click-to-play video facade." When set,
  the card renders the YouTube poster + play overlay; clicking swaps
  in an autoplaying iframe in place. The "Visit channel" button stays
  visible underneath as a separate, secondary action.

  Asset specs:
    - YouTube facade card image: 1920x1080 (16:9), <300KB
    - Instagram card image: 1080x1350 (4:5 portrait), <250KB
{%- endcomment -%}

{%- liquid
  assign cards = section.blocks | where: 'type', 'social_card'
  assign heading = section.settings.heading | default: 'See more of us.'
  assign aeo_heading = section.settings.aeo_heading | default: 'Where can you follow theINmag?'
-%}

<section
  class="theinmag-bm-see-more"
  data-theinmag-bm-see-more
  aria-labelledby="theinmag-bm-see-more-heading"
>
  <div class="theinmag-bm-see-more__inner">
    <div class="theinmag-bm-see-more__head">
      <h2 id="theinmag-bm-see-more-heading" class="theinmag-bm-see-more__heading">{{ heading }}</h2>
      <span class="theinmag-bm-see-more__a11y-heading">{{ aeo_heading }}</span>
    </div>

    <ul class="theinmag-bm-see-more__cards" role="list">
      {%- for block in cards -%}
        {%- liquid
          assign card_src = ''
          if block.settings.image != blank
            assign card_src = block.settings.image | image_url: width: 1920
          elsif block.settings.fallback_filename != blank
            assign card_src = block.settings.fallback_filename | asset_url
          endif

          assign yt_input = block.settings.youtube_video_id | strip
          assign yt_id = ''
          if yt_input contains 'youtu'
            assign url_after_v = yt_input | split: 'v=' | last | split: '&' | first
            if url_after_v != yt_input
              assign yt_id = url_after_v
            else
              assign yt_id = yt_input | split: 'youtu.be/' | last | split: '?' | first
            endif
          else
            assign yt_id = yt_input
          endif

          assign is_video_card = false
          if yt_id != blank
            assign is_video_card = true
          endif

          assign platform_class = ''
          assign aspect_class = 'theinmag-bm-see-more__card--landscape'
          case block.settings.platform
            when 'youtube'
              assign platform_class = 'theinmag-bm-see-more__card--youtube'
              assign aspect_class = 'theinmag-bm-see-more__card--landscape'
            when 'instagram'
              assign platform_class = 'theinmag-bm-see-more__card--instagram'
              assign aspect_class = 'theinmag-bm-see-more__card--portrait'
          endcase
        -%}
        <li class="theinmag-bm-see-more__card-item theinmag-bm-see-more__card-item--{{ block.settings.size | default: 'wide' }}" {{ block.shopify_attributes }}>
          <article class="theinmag-bm-see-more__card {{ platform_class }} {{ aspect_class }}">

            {%- if is_video_card -%}
              {%- comment -%}
                Video facade card. The poster is a button that swaps in
                an autoplaying YouTube iframe on click. The "Visit
                channel" link sits below as a separate secondary
                action (no wrapper anchor on the whole card here).
              {%- endcomment -%}
              <div
                class="theinmag-bm-see-more__card-media"
                data-bm-see-more-video
                data-yt-id="{{ yt_id | escape }}"
              >
                <button
                  type="button"
                  class="theinmag-bm-see-more__poster"
                  data-bm-see-more-trigger
                  aria-label="Play video: {{ block.settings.heading | escape }}"
                >
                  {%- if card_src != blank -%}
                    <img
                      src="{{ card_src }}"
                      alt="{{ block.settings.image_alt | default: block.settings.heading | escape }}"
                      loading="lazy"
                      width="1920"
                      height="1080"
                    >
                  {%- else -%}
                    <span class="theinmag-bm-see-more__card-placeholder" aria-hidden="true"></span>
                  {%- endif -%}
                  <span class="theinmag-bm-see-more__play" aria-hidden="true">
                    <svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <circle cx="32" cy="32" r="32" fill="#F9C23C"/>
                      <polygon points="26 20 46 32 26 44" fill="#2A1F3D"/>
                    </svg>
                  </span>
                  {%- if block.settings.platform != blank -%}
                    <span class="theinmag-bm-see-more__platform" aria-hidden="true">
                      {%- case block.settings.platform -%}
                        {%- when 'youtube' -%}
                          <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.6 3.6 12 3.6 12 3.6s-7.6 0-9.4.5A3 3 0 0 0 .5 6.2C0 8 0 12 0 12s0 4 .5 5.8a3 3 0 0 0 2.1 2.1c1.8.5 9.4.5 9.4.5s7.6 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.8.5-5.8.5-5.8s0-4-.5-5.8zM9.6 15.6V8.4l6.4 3.6-6.4 3.6z" fill="currentColor"/>
                          </svg>
                        {%- when 'instagram' -%}
                          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="18" height="18" rx="5" ry="5"></rect>
                            <path d="M16 11.4a4 4 0 1 1-7.9 1.2 4 4 0 0 1 7.9-1.2z"></path>
                            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                          </svg>
                      {%- endcase -%}
                    </span>
                  {%- endif -%}
                </button>
              </div>

              <div class="theinmag-bm-see-more__card-body">
                {%- if block.settings.heading != blank -%}
                  <h3 class="theinmag-bm-see-more__card-heading">{{ block.settings.heading }}</h3>
                {%- endif -%}
                {%- if block.settings.subheading != blank -%}
                  <p class="theinmag-bm-see-more__card-subheading">{{ block.settings.subheading }}</p>
                {%- endif -%}
                {%- if block.settings.body != blank -%}
                  <p class="theinmag-bm-see-more__card-text">{{ block.settings.body }}</p>
                {%- endif -%}
                {%- if block.settings.link != blank and block.settings.button_label != blank -%}
                  <a
                    class="theinmag-bm-see-more__btn theinmag-bm-see-more__btn--solo"
                    href="{{ block.settings.link }}"
                    rel="noopener"
                    target="_blank"
                  >{{ block.settings.button_label }}</a>
                {%- endif -%}
              </div>

            {%- else -%}
              {%- comment -%}
                Static image-link card. Whole card is a click target via
                an absolute-positioned anchor; aria-label combines
                button text + heading.
              {%- endcomment -%}
              <a
                class="theinmag-bm-see-more__card-link"
                href="{{ block.settings.link }}"
                rel="noopener"
                target="_blank"
                aria-label="{{ block.settings.button_label | default: 'View profile' }}: {{ block.settings.heading | escape }}"
              ></a>

              <div class="theinmag-bm-see-more__card-media">
                {%- if card_src != blank -%}
                  <img
                    src="{{ card_src }}"
                    alt="{{ block.settings.image_alt | default: block.settings.heading | escape }}"
                    loading="lazy"
                    width="1080"
                    height="1350"
                  >
                {%- else -%}
                  <div class="theinmag-bm-see-more__card-placeholder" aria-hidden="true"></div>
                {%- endif -%}

                {%- if block.settings.platform != blank -%}
                  <span class="theinmag-bm-see-more__platform" aria-hidden="true">
                    {%- case block.settings.platform -%}
                      {%- when 'youtube' -%}
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.6 3.6 12 3.6 12 3.6s-7.6 0-9.4.5A3 3 0 0 0 .5 6.2C0 8 0 12 0 12s0 4 .5 5.8a3 3 0 0 0 2.1 2.1c1.8.5 9.4.5 9.4.5s7.6 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.8.5-5.8.5-5.8s0-4-.5-5.8zM9.6 15.6V8.4l6.4 3.6-6.4 3.6z" fill="currentColor"/>
                        </svg>
                      {%- when 'instagram' -%}
                        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <rect x="3" y="3" width="18" height="18" rx="5" ry="5"></rect>
                          <path d="M16 11.4a4 4 0 1 1-7.9 1.2 4 4 0 0 1 7.9-1.2z"></path>
                          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                        </svg>
                    {%- endcase -%}
                  </span>
                {%- endif -%}
              </div>

              <div class="theinmag-bm-see-more__card-body">
                {%- if block.settings.heading != blank -%}
                  <h3 class="theinmag-bm-see-more__card-heading">{{ block.settings.heading }}</h3>
                {%- endif -%}
                {%- if block.settings.subheading != blank -%}
                  <p class="theinmag-bm-see-more__card-subheading">{{ block.settings.subheading }}</p>
                {%- endif -%}
                {%- if block.settings.body != blank -%}
                  <p class="theinmag-bm-see-more__card-text">{{ block.settings.body }}</p>
                {%- endif -%}
                {%- if block.settings.button_label != blank -%}
                  <span class="theinmag-bm-see-more__btn">{{ block.settings.button_label }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}

          </article>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

<script>
  (function () {
    var frames = document.querySelectorAll('[data-bm-see-more-video]');
    if (!frames.length) return;
    Array.prototype.forEach.call(frames, function (frame) {
      var trigger = frame.querySelector('[data-bm-see-more-trigger]');
      if (!trigger) return;
      trigger.addEventListener('click', function () {
        var ytId = frame.getAttribute('data-yt-id') || '';
        if (!ytId) return;
        var iframe = document.createElement('iframe');
        iframe.className = 'theinmag-bm-see-more__iframe';
        iframe.src = 'https://www.youtube-nocookie.com/embed/' + encodeURIComponent(ytId)
          + '?autoplay=1&rel=0&modestbranding=1&playsinline=1';
        iframe.title = trigger.getAttribute('aria-label') || 'theINmag video';
        iframe.setAttribute('frameborder', '0');
        iframe.setAttribute('allow', 'autoplay; encrypted-media; picture-in-picture');
        iframe.setAttribute('allowfullscreen', '');
        frame.replaceChild(iframe, trigger);
      });
    });
  })();
</script>

{%- stylesheet -%}
  .theinmag-bm-see-more {
    background-color: var(--color-cream, #FBF6EA);
    color: var(--color-inky-purple-navy, #2A1F3D);
    padding: clamp(56px, 8vw, 104px) clamp(20px, 5vw, 48px);
  }

  .theinmag-bm-see-more__a11y-heading {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .theinmag-bm-see-more__inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .theinmag-bm-see-more__head {
    text-align: center;
    margin-bottom: clamp(24px, 4vw, 40px);
  }

  .theinmag-bm-see-more__heading {
    margin: 0;
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-size: clamp(32px, 5vw, 48px);
    line-height: 1.1;
    color: var(--color-inky-purple-navy, #2A1F3D);
  }

  /* Mobile: stacked. Desktop: 2/3 + 1/3 split. align-items:start so a
     shorter Instagram card doesn't stretch to match the taller video
     card. */
  .theinmag-bm-see-more__cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(16px, 2.5vw, 28px);
    align-items: start;
  }

  @media (min-width: 750px) {
    .theinmag-bm-see-more__cards {
      grid-template-columns: 2fr 1fr;
    }
  }

  .theinmag-bm-see-more__card-item {
    margin: 0;
    display: flex;
  }

  .theinmag-bm-see-more__card {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 1;
    background-color: #FFFFFF;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(123, 79, 158, 0.1);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .theinmag-bm-see-more__card:hover,
  .theinmag-bm-see-more__card:focus-within {
    transform: translateY(-3px);
    box-shadow: 0 8px 22px rgba(123, 79, 158, 0.18);
  }

  /* Card-link only renders on non-video cards. */
  .theinmag-bm-see-more__card-link {
    position: absolute;
    inset: 0;
    z-index: 2;
  }
  .theinmag-bm-see-more__card-link:focus-visible {
    outline: 3px solid var(--color-purple-dark, #5D3A7A);
    outline-offset: -3px;
    border-radius: 16px;
  }

  /* ================================================================
     Card media. Aspect varies by platform: landscape 16:9 (YouTube),
     portrait 4:5 (Instagram). Class set in Liquid based on platform.
     ================================================================ */
  .theinmag-bm-see-more__card-media {
    position: relative;
    overflow: hidden;
    background-color: var(--color-lavender, #E8DEEF);
  }

  .theinmag-bm-see-more__card--landscape .theinmag-bm-see-more__card-media {
    aspect-ratio: 16 / 9;
  }
  .theinmag-bm-see-more__card--portrait .theinmag-bm-see-more__card-media {
    aspect-ratio: 4 / 5;
  }

  .theinmag-bm-see-more__card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .theinmag-bm-see-more__card:hover .theinmag-bm-see-more__card-media img {
    transform: scale(1.03);
  }

  .theinmag-bm-see-more__card-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--color-lavender, #E8DEEF) 0%, var(--color-wave-purple, #C9B5DB) 100%);
    display: block;
  }

  /* ================================================================
     Video facade poster (Branching Out card)
     ================================================================ */
  .theinmag-bm-see-more__poster {
    appearance: none;
    border: 0;
    margin: 0;
    padding: 0;
    background: none;
    width: 100%;
    height: 100%;
    cursor: pointer;
    position: relative;
    display: block;
  }
  .theinmag-bm-see-more__poster:focus-visible {
    outline: 3px solid var(--color-yellow, #F9C23C);
    outline-offset: -3px;
  }
  .theinmag-bm-see-more__poster img {
    filter: brightness(0.9);
  }
  .theinmag-bm-see-more__poster:hover img {
    filter: brightness(0.82);
    transform: scale(1.02);
  }
  .theinmag-bm-see-more__play {
    position: absolute;
    top: 50%;
    left: 50%;
    width: clamp(56px, 7vw, 80px);
    height: clamp(56px, 7vw, 80px);
    transform: translate(-50%, -50%);
    pointer-events: none;
    transition: transform 0.2s ease;
    filter: drop-shadow(0 6px 18px rgba(0, 0, 0, 0.35));
  }
  .theinmag-bm-see-more__poster:hover .theinmag-bm-see-more__play {
    transform: translate(-50%, -50%) scale(1.06);
  }
  .theinmag-bm-see-more__play svg {
    width: 100%;
    height: 100%;
  }

  .theinmag-bm-see-more__iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  /* ================================================================
     Platform stamp + body
     ================================================================ */
  .theinmag-bm-see-more__platform {
    position: absolute;
    top: 12px;
    left: 12px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.96);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
    z-index: 3;
    pointer-events: none;
  }
  .theinmag-bm-see-more__platform svg {
    width: 20px;
    height: 20px;
  }
  .theinmag-bm-see-more__card--youtube .theinmag-bm-see-more__platform { color: #FF0000; }
  .theinmag-bm-see-more__card--instagram .theinmag-bm-see-more__platform { color: #E1306C; }

  .theinmag-bm-see-more__card-body {
    padding: clamp(20px, 2.4vw, 28px);
    display: flex;
    flex-direction: column;
    gap: clamp(8px, 1vw, 12px);
  }

  .theinmag-bm-see-more__card-heading {
    margin: 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: clamp(20px, 2.2vw, 24px);
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--color-inky-purple-navy, #2A1F3D);
  }

  .theinmag-bm-see-more__card-subheading {
    margin: 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 500;
    font-size: clamp(14px, 1.4vw, 15px);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-purple-dark, #5D3A7A);
  }

  .theinmag-bm-see-more__card-text {
    margin: 0;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-size: clamp(15px, 1.6vw, 16px);
    line-height: 1.6;
    color: var(--color-inky-purple-navy, #2A1F3D);
    opacity: 0.9;
  }

  /* Button: span on non-video cards (whole-card-link triggers it),
     real <a> on video cards (separate from the play action). */
  .theinmag-bm-see-more__btn {
    display: inline-block;
    align-self: flex-start;
    margin-top: clamp(6px, 1vw, 10px);
    background-color: transparent;
    color: var(--color-purple-dark, #5D3A7A);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 600;
    font-size: clamp(13px, 1.4vw, 14px);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border: 2px solid var(--color-purple-dark, #5D3A7A);
    border-radius: 32px;
    padding: 10px 22px;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .theinmag-bm-see-more__card:hover .theinmag-bm-see-more__btn,
  .theinmag-bm-see-more__card:focus-within .theinmag-bm-see-more__btn {
    background-color: var(--color-purple-dark, #5D3A7A);
    color: #FFFFFF;
  }
  /* Solo button (on video cards) needs its own focus styling since the
     card-level focus-within doesn't apply (no wrapper anchor). */
  .theinmag-bm-see-more__btn--solo:focus-visible {
    background-color: var(--color-purple-dark, #5D3A7A);
    color: #FFFFFF;
    outline: 3px solid var(--color-yellow, #F9C23C);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-bm-see-more__card,
    .theinmag-bm-see-more__card-media img,
    .theinmag-bm-see-more__poster img,
    .theinmag-bm-see-more__play,
    .theinmag-bm-see-more__btn {
      transition: none;
    }
    .theinmag-bm-see-more__card:hover {
      transform: none;
    }
    .theinmag-bm-see-more__card:hover .theinmag-bm-see-more__card-media img,
    .theinmag-bm-see-more__poster:hover img {
      transform: none;
    }
    .theinmag-bm-see-more__poster:hover .theinmag-bm-see-more__play {
      transform: translate(-50%, -50%);
    }
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "theINmag BM see more",
  "tag": "section",
  "class": "theinmag-bm-see-more-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Section heading (H2)" },
    { "type": "text", "id": "aeo_heading", "label": "Visually-hidden secondary H2 (question form)" }
  ],
  "blocks": [
    {
      "type": "social_card",
      "name": "Social card",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "platform",
          "label": "Platform",
          "options": [
            { "value": "youtube", "label": "YouTube" },
            { "value": "instagram", "label": "Instagram" },
            { "value": "other", "label": "Other" }
          ],
          "default": "youtube"
        },
        { "type": "text", "id": "heading", "label": "Card heading (H3)" },
        { "type": "text", "id": "subheading", "label": "Sub-heading" },
        { "type": "textarea", "id": "body", "label": "Body" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "header",
          "content": "Inline video (YouTube only)"
        },
        {
          "type": "text",
          "id": "youtube_video_id",
          "label": "YouTube URL or video ID",
          "info": "Optional. When set, the card becomes a click-to-play YouTube facade. Leave blank to render as a static image link."
        },
        { "type": "header", "content": "Card image" },
        { "type": "image_picker", "id": "image", "label": "Card image" },
        {
          "type": "text",
          "id": "fallback_filename",
          "label": "Fallback filename",
          "info": "YouTube cards: 1920x1080 (16:9, <300KB). Instagram cards: 1080x1350 (4:5 portrait, <250KB)."
        },
        { "type": "text", "id": "image_alt", "label": "Image alt text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "theINmag BM see more",
      "settings": {
        "heading": "See more of us.",
        "aeo_heading": "Where can you follow theINmag?"
      },
      "blocks": [
        {
          "type": "social_card",
          "settings": {
            "platform": "youtube",
            "heading": "Branching Out",
            "subheading": "Adventures from the road.",
            "body": "Branching Out is our YouTube channel where we share our travels, the places we land, and what Nora's up to.",
            "button_label": "Visit channel on YouTube",
            "link": "https://www.youtube.com/@Branchingout-tnr",
            "youtube_video_id": "",
