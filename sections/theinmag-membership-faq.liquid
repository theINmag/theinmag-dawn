{%- comment -%}
  theinmag-membership-faq (Stage 2c: block type renamed to faq_item)
  4 accordion entries from membership-pdp-copy.md FAQ_1 through FAQ_4.
  Includes FAQPage JSON-LD with question and answer pairs for AEO.

  Accordion pattern: <h3><button aria-expanded></button></h3> + panel.
  One panel can be open at a time. Click anywhere on the row to toggle.
  Reduced-motion: max-height transition disabled.

  Per the page playbook (sec 8.5), data attribute is page-scoped
  ({page}-faq-trigger) so multiple FAQ instances don't collide on JS.

  Spec: ../theinmag-docs/membership-pdp-copy.md FAQ_1-4
  AEO: ../theinmag-docs/theinmag-design-tokens.md "AEO requirements"
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading | default: 'Common Membership questions'
  assign items = section.blocks | where: 'type', 'faq_item'
  assign section_style = '--tmfaq-pt: ' | append: section.settings.padding_top | append: 'px; --tmfaq-pb: ' | append: section.settings.padding_bottom | append: 'px;'
-%}

<section
  class="theinmag-membership-faq"
  data-theinmag-membership-faq
  aria-labelledby="theinmag-membership-faq-heading"
  style="{{ section_style }}"
>
  <div class="theinmag-membership-faq__inner">
    <h2 id="theinmag-membership-faq-heading" class="theinmag-membership-faq__heading">
      {{ heading }}
    </h2>

    {%- if items.size > 0 -%}
      <ul class="theinmag-membership-faq__list" role="list">
        {%- for block in items -%}
          {%- liquid
            assign q = block.settings.question
            assign a = block.settings.answer
            assign uid = section.id | append: '-' | append: forloop.index
          -%}
          <li class="theinmag-membership-faq__item" {{ block.shopify_attributes }}>
            <h3 class="theinmag-membership-faq__q">
              <button
                type="button"
                class="theinmag-membership-faq__trigger"
                data-membership-faq-trigger
                aria-expanded="false"
                aria-controls="theinmag-membership-faq-panel-{{ uid }}"
                id="theinmag-membership-faq-trigger-{{ uid }}"
              >
                <span class="theinmag-membership-faq__q-text">{{ q }}</span>
                <span class="theinmag-membership-faq__caret" aria-hidden="true"></span>
              </button>
            </h3>
            <div
              class="theinmag-membership-faq__panel"
              id="theinmag-membership-faq-panel-{{ uid }}"
              role="region"
              aria-labelledby="theinmag-membership-faq-trigger-{{ uid }}"
              data-open="false"
            >
              <div class="theinmag-membership-faq__answer">{{ a }}</div>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in items -%}
        {
          "@type": "Question",
          "name": {{ block.settings.question | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ block.settings.answer | strip_html | strip | json }}
          }
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
</script>

{% stylesheet %}
  .theinmag-membership-faq {
    background-color: var(--color-lavender);
    color: var(--color-inky-purple-navy);
    padding: var(--tmfaq-pt, 72px) var(--space-lg) var(--tmfaq-pb, 72px);
  }

  .theinmag-membership-faq__inner {
    max-width: 760px;
    margin: 0 auto;
  }

  .theinmag-membership-faq__heading {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(28px, 4.5vw, 40px);
    line-height: 1.15;
    color: var(--color-purple-dark);
    margin: 0 0 var(--space-xl);
    text-align: center;
  }

  .theinmag-membership-faq__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(93, 58, 122, 0.18);
  }

  .theinmag-membership-faq__item {
    border-bottom: 1px solid rgba(93, 58, 122, 0.18);
  }

  .theinmag-membership-faq__q {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 17px;
    line-height: 1.4;
  }

  .theinmag-membership-faq__trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    background: transparent;
    border: 0;
    padding: var(--space-lg) 0;
    color: var(--color-inky-purple-navy);
    font: inherit;
    text-align: left;
    cursor: pointer;
    min-height: 56px;
  }

  .theinmag-membership-faq__q-text { flex: 1; }

  /* Plus/minus caret rendered via pseudo-elements so we don't need an
     SVG asset. Rotates 90deg on expand. */
  .theinmag-membership-faq__caret {
    position: relative;
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
    display: inline-block;
  }
  .theinmag-membership-faq__caret::before,
  .theinmag-membership-faq__caret::after {
    content: '';
    position: absolute;
    background-color: var(--color-purple-dark);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .theinmag-membership-faq__caret::before {
    top: 50%;
    left: 0;
    right: 0;
    height: 2px;
    transform: translateY(-50%);
  }
  .theinmag-membership-faq__caret::after {
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    transform: translateX(-50%);
  }
  .theinmag-membership-faq__trigger[aria-expanded='true'] .theinmag-membership-faq__caret::after {
    transform: translateX(-50%) scaleY(0);
    opacity: 0;
  }

  .theinmag-membership-faq__panel {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }
  .theinmag-membership-faq__panel[data-open='true'] {
    max-height: 1500px;
  }

  /* Preserve textarea paragraph breaks via white-space: pre-line.
     Author writes blank lines in the editor; CSS treats those as
     paragraph spacing without us splitting in Liquid (which can't
     handle multi-line string literals inside assign/filters). */
  .theinmag-membership-faq__answer {
    padding: 0 0 var(--space-lg);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-inky-purple-navy);
    white-space: pre-line;
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-membership-faq__panel { transition: none; }
    .theinmag-membership-faq__caret::before,
    .theinmag-membership-faq__caret::after { transition: none; }
  }
{% endstylesheet %}

<script>
  (function () {
    const root = document.querySelector('[data-theinmag-membership-faq]');
    if (!root) return;

    const triggers = root.querySelectorAll('[data-membership-faq-trigger]');
    triggers.forEach(function (trigger) {
      trigger.addEventListener('click', function () {
        const expanded = trigger.getAttribute('aria-expanded') === 'true';
        const panelId = trigger.getAttribute('aria-controls');
        const panel = panelId ? document.getElementById(panelId) : null;

        /* Close any other open panels first - one-at-a-time pattern. */
        triggers.forEach(function (other) {
          if (other !== trigger && other.getAttribute('aria-expanded') === 'true') {
            other.setAttribute('aria-expanded', 'false');
            const otherPanelId = other.getAttribute('aria-controls');
            const otherPanel = otherPanelId ? document.getElementById(otherPanelId) : null;
            if (otherPanel) otherPanel.setAttribute('data-open', 'false');
          }
        });

        trigger.setAttribute('aria-expanded', expanded ? 'false' : 'true');
        if (panel) panel.setAttribute('data-open', expanded ? 'false' : 'true');
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Membership FAQ",
  "tag": "section",
  "class": "shopify-section theinmag-membership-faq-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (H2)",
      "default": "Common Membership questions"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 128,
      "step": 4,
      "default": 72,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 128,
      "step": 4,
      "default": 72,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ item",
      "limit": 12,
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "info": "Blank line separates paragraphs."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Membership FAQ",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "When will my first mag arrive?",
            "answer": "Depends on what you pick at the top. If you choose \"start with the current issue\" and it's in stock, your mag ships within three business days. If you choose \"start with the next issue\", you'll receive it in the week after the release date (15 February, 15 June, or 15 October). Either way, we'll email you the moment it ships.\n\nIf you went Digital or Combo, the digital PDF lands the day each issue drops. No waiting for the post."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Can I cancel a Rolling Membership?",
            "answer": "Yes - log into your account on theinmag.com.au and cancel in two clicks. No emails, no phone calls, no \"you must give 90 days' notice\" nonsense. Any issues you've already been charged for still ship to you, and the renewals stop from the next drop onwards.\n\n4-Issue and 8-Issue Memberships are paid upfront for the issues you've committed to, so they're not cancellable mid-run - but they also don't auto-renew. When the last issue ships, that's the end of it."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What's the difference between Combo and buying Print plus Digital separately?",
            "answer": "Two things. First, price - Combo is 10% off the bundled total of buying both formats as separate Memberships. Second, it's one purchase, one renewal, one account. No juggling two Memberships that don't quite align.\n\nCombo earns its keep for three kinds of customer: teachers (digital for the classroom, print for the reading corner), grandparents (print to send to the grandkids, digital to read along over FaceTime), and families who like having different ways to access the mag - perfect for when you're travelling, have kids in different rooms, or want to share across devices.\n\nIf only one format suits you, the regular Print or Digital Membership is the right pick. Combo earns its keep when you actually need both."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What if my kid's already got the current issue? Can I start with the next one?",
            "answer": "Yes - that's exactly what the \"Start with the next issue\" option is for. You'll skip the current issue and your Membership begins with the next one when it drops. You won't be charged anything extra to wait - the price is the same either way."
          }
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
