{%- comment -%}
  theinmag-for-parents-comps
  Section 4 of /pages/for-parents - competitions snapshot.

  Mirrors the /pages/competitions visual exactly: same tile + featured
  card markup, same category colour palette, same day-rotating bg
  pool (section_background_competitions1/2/3.jpg via day-of-year
  modulo). Layout is L/R FLIPPED from competitions page:
    LEFT (1/3 on desktop): featured "top picks" card (large, square)
    RIGHT (2/3 on desktop): 2 long horizontal tiles - currently OPEN
                            comps (live-now > opens-in > soon fallback).

  Auto-populated. Featured defaults to banabae-artists (Ryan's pick)
  but can be overridden per section. Right column never needs touching -
  it tracks whatever's currently open in competitions-database.csv.

  NOTE on Liquid comments: inside `{%- liquid -%}` blocks, use either
  a multi-line `comment ... endcomment` block, or a `#` line comment.
  Do NOT use single-line `comment X endcomment` - the parser sees the
  comment as unclosed and the whole section fails to push.
{%- endcomment -%}

{%- include 'theinmag-competitions-data' -%}

{%- liquid
  assign heading = section.settings.heading | default: 'Something for your kid to aim at.'
  assign subhead = section.settings.subhead
  assign all_cta_label = section.settings.all_cta_label
  assign all_cta_link = section.settings.all_cta_link
  assign audience_token = section.settings.audience_token | default: 'parents'
  assign filter_to_tier1 = section.settings.filter_to_tier1
  assign featured_id_setting = section.settings.featured_id | default: 'banabae-artists'

  # Background pool: 3 day-rotated images, same defaults as
  # /pages/competitions so visual treatment matches across surfaces.
  assign bg_pool_str = section.settings.bg_filename_1 | default: 'section_background_competitions1.jpg'
  assign bg_pool_str = bg_pool_str | append: '|'
  assign bg2 = section.settings.bg_filename_2 | default: 'section_background_competitions2.jpg'
  assign bg_pool_str = bg_pool_str | append: bg2 | append: '|'
  assign bg3 = section.settings.bg_filename_3 | default: 'section_background_competitions3.jpg'
  assign bg_pool_str = bg_pool_str | append: bg3
  assign bg_pool = bg_pool_str | split: '|'
  assign day_index = 'now' | date: '%j' | times: 1 | modulo: bg_pool.size
  assign bg_filename = bg_pool[day_index]
  assign bg_url = bg_filename | asset_url

  # Resolve featured comp index. Default is the configured featured_id
  # (e.g. banabae-artists). Fallback to spotlight_ids[0] if that ID
  # isn't in the database, then to index 0.
  assign featured_idx = -1
  for cid in comp_ids
    if cid == featured_id_setting
      assign featured_idx = forloop.index0
      break
    endif
  endfor
  if featured_idx < 0 and spotlight_ids.size > 0
    for cid in comp_ids
      if cid == spotlight_ids[0]
        assign featured_idx = forloop.index0
        break
      endif
    endfor
  endif
  if featured_idx < 0
    assign featured_idx = 0
  endif

  # Right column accumulator: comma-joined CSV of indices.
  assign right_csv = ''
  assign right_count = 0
  assign total = comp_ids.size

  # Pass 1: live-now (highest priority).
  for i in (0..total)
    if i >= total
      break
    endif
    if right_count >= 2
      break
    endif
    if i == featured_idx
      continue
    endif
    assign st = comp_tile_states[i]
    if st != 'live-now'
      continue
    endif
    assign aud = comp_audiences[i] | default: 'all'
    assign tier = comp_cross_tiers[i] | default: ''
    assign aud_match = false
    if aud contains audience_token or aud contains 'all'
      assign aud_match = true
    endif
    assign tier_match = true
    if filter_to_tier1
      assign tier_match = false
      if tier contains 'Tier 1'
        assign tier_match = true
      endif
    endif
    if aud_match and tier_match
      if right_csv == ''
        assign right_csv = i | append: ''
      else
        assign right_csv = right_csv | append: ',' | append: i
      endif
      assign right_count = right_count | plus: 1
    endif
  endfor

  # Pass 2: opens-in (if we still need more).
  for i in (0..total)
    if i >= total
      break
    endif
    if right_count >= 2
      break
    endif
    if i == featured_idx
      continue
    endif
    assign st = comp_tile_states[i]
    if st != 'opens-in'
      continue
    endif
    assign aud = comp_audiences[i] | default: 'all'
    assign tier = comp_cross_tiers[i] | default: ''
    assign aud_match = false
    if aud contains audience_token or aud contains 'all'
      assign aud_match = true
    endif
    assign tier_match = true
    if filter_to_tier1
      assign tier_match = false
      if tier contains 'Tier 1'
        assign tier_match = true
      endif
    endif
    if aud_match and tier_match
      if right_csv == ''
        assign right_csv = i | append: ''
      else
        assign right_csv = right_csv | append: ',' | append: i
      endif
      assign right_count = right_count | plus: 1
    endif
  endfor

  # Pass 3: soon (TBC) as last-resort fallback.
  for i in (0..total)
    if i >= total
      break
    endif
    if right_count >= 2
      break
    endif
    if i == featured_idx
      continue
    endif
    assign st = comp_tile_states[i]
    if st != 'soon'
      continue
    endif
    assign aud = comp_audiences[i] | default: 'all'
    assign tier = comp_cross_tiers[i] | default: ''
    assign aud_match = false
    if aud contains audience_token or aud contains 'all'
      assign aud_match = true
    endif
    assign tier_match = true
    if filter_to_tier1
      assign tier_match = false
      if tier contains 'Tier 1'
        assign tier_match = true
      endif
    endif
    if aud_match and tier_match
      if right_csv == ''
        assign right_csv = i | append: ''
      else
        assign right_csv = right_csv | append: ',' | append: i
      endif
      assign right_count = right_count | plus: 1
    endif
  endfor

  assign right_indices = right_csv | split: ','

  assign featured_cat = comp_category_slugs[featured_idx]
  assign featured_url = comp_websites[featured_idx]
  if featured_url == blank
    assign featured_url = '#'
  endif
-%}

<section
  class="theinmag-for-parents-comps theinmag-comps"
  aria-labelledby="theinmag-for-parents-comps-heading-{{ section.id }}"
  style="--theinmag-fpc-bg: url('{{ bg_url }}');"
>
  <div class="theinmag-for-parents-comps__bg" aria-hidden="true"></div>

  <div class="theinmag-for-parents-comps__inner">
    <header class="theinmag-for-parents-comps__header">
      {%- if heading != blank -%}
        <h2
          id="theinmag-for-parents-comps-heading-{{ section.id }}"
          class="theinmag-for-parents-comps__heading"
        >
          {{ heading }}
        </h2>
      {%- endif -%}

      {%- if subhead != blank -%}
        <p class="theinmag-for-parents-comps__subhead">{{ subhead }}</p>
      {%- endif -%}
    </header>

    <div class="theinmag-for-parents-comps__grid">
      {%- comment -%} LEFT: featured top-picks tile. {%- endcomment -%}
      <aside class="theinmag-for-parents-comps__featured-col">
        <a
          class="theinmag-comps__featured-card theinmag-comps__featured-card--{{ featured_cat }} is-active"
          href="{{ featured_url }}"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="theinmag-comps__featured-cover">
            <span class="theinmag-comps__featured-badge">top picks</span>
            {%- assign featured_logo = comp_logos[featured_idx] -%}
            {%- if featured_logo != blank -%}
              <img class="theinmag-comps__featured-logo" src="{{ featured_logo | asset_url }}" alt="" loading="lazy" width="240" height="240">
            {%- else -%}
              <span class="theinmag-comps__featured-letter">{{ comp_letters[featured_idx] }}</span>
            {%- endif -%}
          </span>
          <span class="theinmag-comps__featured-body">
            <span class="theinmag-comps__featured-chip">{{ comp_categories[featured_idx] | downcase }}</span>
            <span class="theinmag-comps__featured-title">{{ comp_names[featured_idx] }}</span>
            <span class="theinmag-comps__featured-pitch">{{ comp_pitches[featured_idx] }}</span>
            <span class="theinmag-comps__featured-cta">enter <span class="theinmag-comps__arrow">&rarr;</span></span>
          </span>
        </a>
      </aside>

      {%- comment -%} RIGHT: 2 long horizontal tiles (currently open). {%- endcomment -%}
      <div class="theinmag-for-parents-comps__list-col">
        {%- if right_indices.size > 0 -%}
          {%- for idx_str in right_indices -%}
            {%- liquid
              assign idx = idx_str | plus: 0
              assign tile_state = comp_tile_states[idx]
              assign cat_slug = comp_category_slugs[idx]
              assign comp_name = comp_names[idx]
              assign comp_pitch = comp_pitches[idx]
              assign comp_close = comp_closing_dates[idx]
              assign comp_when = comp_when_text[idx]
              assign comp_where = comp_wheres[idx]
              assign comp_cost = comp_costs[idx]
              assign comp_url = comp_websites[idx]
              if comp_url == blank
                assign comp_url = '#'
              endif
              assign comp_letter = comp_letters[idx]
              assign comp_logo = comp_logos[idx]
            -%}
            <a
              class="theinmag-comps__tile theinmag-comps__tile--{{ cat_slug }}"
              href="{{ comp_url }}"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="theinmag-comps__tile-cover" aria-hidden="true">
                {%- if comp_logo != blank -%}
                  <img class="theinmag-comps__tile-logo" src="{{ comp_logo | asset_url }}" alt="" loading="lazy" width="120" height="120">
                {%- else -%}
                  <span class="theinmag-comps__tile-letter">{{ comp_letter }}</span>
                {%- endif -%}
              </span>
              <span class="theinmag-comps__tile-body">
                <span class="theinmag-comps__tile-chip">{{ comp_categories[idx] | downcase }}</span>
                <span class="theinmag-comps__tile-title">{{ comp_name }}</span>
                <span class="theinmag-comps__tile-pitch">{{ comp_pitch }}</span>
                <span class="theinmag-comps__tile-meta">
                  {%- if tile_state == 'soon' -%}
                    <span class="theinmag-comps__tile-meta-item">{{ comp_when | default: 'opening soon' }}</span>
                  {%- else -%}
                    <span class="theinmag-comps__tile-meta-item">closes {{ comp_close }}</span>
                  {%- endif -%}
                  <span class="theinmag-comps__tile-meta-item">{{ comp_cost }}</span>
                  <span class="theinmag-comps__tile-meta-item">{{ comp_where }}</span>
                </span>
                <span class="theinmag-comps__tile-state theinmag-comps__tile-state--{{ tile_state }}">
                  {%- case tile_state -%}
                    {%- when 'live-now' -%}<span class="theinmag-comps__dot"></span> live now
                    {%- when 'opens-in' -%}<span class="theinmag-comps__dot"></span> opens soon
                    {%- when 'soon' -%}<span class="theinmag-comps__dot"></span> registrations opening soon
                  {%- endcase -%}
                </span>
              </span>
              <span class="theinmag-comps__tile-cta" aria-hidden="true">enter <span class="theinmag-comps__arrow">&rarr;</span></span>
            </a>
          {%- endfor -%}
        {%- else -%}
          <p class="theinmag-for-parents-comps__empty">
            No matching open competitions right now. Check back soon - or browse the full hub.
          </p>
        {%- endif -%}
      </div>
    </div>

    {%- if all_cta_label != blank -%}
      <div class="theinmag-for-parents-comps__cta-wrap">
        <a class="theinmag-btn theinmag-btn--secondary-on-image" href="{{ all_cta_link | default: '/pages/competitions' }}">
          {{ all_cta_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{%- stylesheet -%}
  /* ================================================================
     theinmag-for-parents-comps
     Re-uses the .theinmag-comps__featured-card + .theinmag-comps__tile
     CSS family from sections/theinmag-competitions.liquid - duplicated
     here because Shopify only includes a section's stylesheet when
     that section is rendered, and the For Parents page doesn't include
     the competitions section. Tokens + class names kept identical so
     visual parity is automatic.
     ================================================================ */

  .theinmag-for-parents-comps {
    --comps-purple-light: #E8DEEF;
    --comps-purple-dark: #5D3A7A;
    --comps-coral-light: #FBE0D6;
    --comps-coral-dark: #C9543E;
    --comps-peach-light: #FCDDB8;
    --comps-peach-dark: #D9783A;
    --comps-mint-light: #D6EAD9;
    --comps-mint-dark: #4A7C5C;
    --comps-cream: #FBF6EA;
    --comps-cream-dark: #2A1F3D;
    --comps-sky-light: #C9E5E8;
    --comps-sky-dark: #2D6878;
    --comps-yellow: #F9C23C;

    position: relative;
    background-color: var(--comps-cream);
    color: var(--comps-cream-dark);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    padding: clamp(48px, 8vw, 96px) clamp(20px, 5vw, 64px);
    overflow: hidden;
  }

  /* 2-class selector beats Dawn's `div:empty { display: none }` rule. */
  .theinmag-for-parents-comps .theinmag-for-parents-comps__bg {
    display: block;
    position: absolute;
    inset: 0;
    background-image: var(--theinmag-fpc-bg);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0.55;
    pointer-events: none;
    z-index: 0;
  }

  .theinmag-for-parents-comps__inner {
    position: relative;
    z-index: 1;
    max-width: 1320px;
    margin: 0 auto;
  }

  .theinmag-for-parents-comps__header {
    margin: 0 0 clamp(28px, 4vw, 40px);
    max-width: 60ch;
  }

  .theinmag-for-parents-comps__heading {
    margin: 0 0 clamp(12px, 1.5vw, 16px);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: clamp(28px, 4vw, 36px);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--comps-cream-dark);
    text-wrap: balance;
  }

  .theinmag-for-parents-comps__subhead {
    margin: 0;
    max-width: 60ch;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 400;
    font-size: clamp(15px, 1.6vw, 17px);
    line-height: 1.6;
    color: rgba(42, 31, 61, 0.78);
  }

  .theinmag-for-parents-comps__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(16px, 2vw, 24px);
  }

  @media (min-width: 990px) {
    .theinmag-for-parents-comps__grid {
      grid-template-columns: 1fr 2fr;
      gap: clamp(20px, 2.5vw, 32px);
      align-items: stretch;
    }
  }

  .theinmag-for-parents-comps__featured-col {
    position: relative;
    min-height: 340px;
  }

  @media (min-width: 990px) {
    .theinmag-for-parents-comps__featured-col {
      min-height: 100%;
    }
  }

  .theinmag-for-parents-comps__list-col {
    display: flex;
    flex-direction: column;
    gap: clamp(12px, 1.4vw, 18px);
  }

  /* ----- Featured card (lifted from theinmag-competitions.liquid) ----- */

  .theinmag-comps__featured-card {
    position: relative;
    inset: 0;
    display: flex;
    flex-direction: column;
    background-color: var(--comps-cream);
    border-radius: 22px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 6px 24px rgba(123, 79, 158, 0.16);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
    height: 100%;
    min-height: 340px;
  }

  .theinmag-comps__featured-card:hover,
  .theinmag-comps__featured-card:focus-visible {
    outline: none;
    box-shadow: 0 8px 32px rgba(123, 79, 158, 0.22);
    transform: translateY(-2px);
  }

  .theinmag-comps__featured-cover {
    position: relative;
    flex: 0 0 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--comps-coral-light);
    min-height: 160px;
  }

  .theinmag-comps__featured-card--art .theinmag-comps__featured-cover { background-color: var(--comps-coral-light); }
  .theinmag-comps__featured-card--writing .theinmag-comps__featured-cover { background-color: var(--comps-mint-light); }
  .theinmag-comps__featured-card--photofilm .theinmag-comps__featured-cover { background-color: var(--comps-sky-light); }
  .theinmag-comps__featured-card--stem .theinmag-comps__featured-cover { background-color: var(--comps-purple-light); }
  .theinmag-comps__featured-card--performance .theinmag-comps__featured-cover { background-color: var(--comps-peach-light); }
  .theinmag-comps__featured-card--social-good .theinmag-comps__featured-cover { background-color: #F2EBD8; }

  .theinmag-comps__featured-letter {
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-size: clamp(72px, 9vw, 120px);
    line-height: 1;
    color: var(--comps-purple-dark);
  }
  .theinmag-comps__featured-card--art .theinmag-comps__featured-letter { color: var(--comps-coral-dark); }
  .theinmag-comps__featured-card--writing .theinmag-comps__featured-letter { color: var(--comps-mint-dark); }
  .theinmag-comps__featured-card--photofilm .theinmag-comps__featured-letter { color: var(--comps-sky-dark); }
  .theinmag-comps__featured-card--performance .theinmag-comps__featured-letter { color: var(--comps-peach-dark); }

  .theinmag-comps__featured-logo {
    width: clamp(120px, 16vw, 200px);
    height: clamp(120px, 16vw, 200px);
    object-fit: contain;
    padding: clamp(8px, 1vw, 14px);
    background-color: #FFF;
    border-radius: 12px;
  }

  .theinmag-comps__featured-badge {
    position: absolute;
    top: clamp(10px, 1.4vw, 14px);
    left: clamp(10px, 1.4vw, 14px);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    padding: 5px 12px;
    background-color: var(--comps-cream);
    color: var(--comps-cream-dark);
    border: 1.5px solid var(--comps-cream-dark);
    border-radius: 20px;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: lowercase;
    transform: rotate(-2deg);
    box-shadow: 0 2px 0 rgba(42, 31, 61, 0.85);
  }

  .theinmag-comps__featured-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: clamp(16px, 1.6vw, 22px);
    flex: 1 1 auto;
  }

  .theinmag-comps__featured-chip {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--comps-purple-dark);
    opacity: 0.78;
  }
  .theinmag-comps__featured-card--art .theinmag-comps__featured-chip { color: var(--comps-coral-dark); }
  .theinmag-comps__featured-card--writing .theinmag-comps__featured-chip { color: var(--comps-mint-dark); }
  .theinmag-comps__featured-card--photofilm .theinmag-comps__featured-chip { color: var(--comps-sky-dark); }
  .theinmag-comps__featured-card--performance .theinmag-comps__featured-chip { color: var(--comps-peach-dark); }

  .theinmag-comps__featured-title {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: clamp(18px, 1.8vw, 22px);
    line-height: 1.2;
    color: var(--comps-cream-dark);
  }

  .theinmag-comps__featured-pitch {
    font-size: 14px;
    line-height: 1.55;
    color: var(--comps-cream-dark);
    opacity: 0.82;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .theinmag-comps__featured-cta {
    margin-top: auto;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--comps-purple-dark);
  }

  /* ----- List tile (lifted from theinmag-competitions.liquid) ----- */

  .theinmag-comps__tile {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: clamp(12px, 1.4vw, 18px);
    background-color: var(--comps-cream);
    border-radius: 20px;
    padding: clamp(12px, 1.4vw, 18px);
    text-decoration: none;
    color: inherit;
    box-shadow: 0 2px 12px rgba(123, 79, 158, 0.08);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    align-items: center;
    position: relative;
  }
  @media (min-width: 600px) {
    .theinmag-comps__tile {
      grid-template-columns: 130px 1fr auto;
      padding: clamp(14px, 1.6vw, 20px);
    }
  }
  .theinmag-comps__tile:hover,
  .theinmag-comps__tile:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(123, 79, 158, 0.18);
    outline: none;
  }
  .theinmag-comps__tile:focus-visible {
    box-shadow: 0 0 0 3px var(--comps-purple-dark), 0 6px 20px rgba(123, 79, 158, 0.18);
  }

  .theinmag-comps__tile-cover {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
    border-radius: 14px;
    overflow: hidden;
    background-color: var(--comps-purple-light);
    width: 100%;
    height: 100%;
  }
  .theinmag-comps__tile-letter {
    font-family: var(--font-heading, 'Post Regular', Georgia, serif);
    font-weight: 400;
    font-size: clamp(40px, 5vw, 60px);
    line-height: 1;
    color: var(--comps-purple-dark);
  }
  .theinmag-comps__tile-logo {
    display: block;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    padding: clamp(6px, 0.8vw, 12px);
    background-color: #FFF;
  }

  .theinmag-comps__tile--art .theinmag-comps__tile-cover { background-color: var(--comps-coral-light); }
  .theinmag-comps__tile--art .theinmag-comps__tile-letter { color: var(--comps-coral-dark); }
  .theinmag-comps__tile--writing .theinmag-comps__tile-cover { background-color: var(--comps-mint-light); }
  .theinmag-comps__tile--writing .theinmag-comps__tile-letter { color: var(--comps-mint-dark); }
  .theinmag-comps__tile--photofilm .theinmag-comps__tile-cover { background-color: var(--comps-sky-light); }
  .theinmag-comps__tile--photofilm .theinmag-comps__tile-letter { color: var(--comps-sky-dark); }
  .theinmag-comps__tile--stem .theinmag-comps__tile-cover { background-color: var(--comps-purple-light); }
  .theinmag-comps__tile--stem .theinmag-comps__tile-letter { color: var(--comps-purple-dark); }
  .theinmag-comps__tile--performance .theinmag-comps__tile-cover { background-color: var(--comps-peach-light); }
  .theinmag-comps__tile--performance .theinmag-comps__tile-letter { color: var(--comps-peach-dark); }
  .theinmag-comps__tile--social-good .theinmag-comps__tile-cover { background-color: #F2EBD8; }

  .theinmag-comps__tile-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .theinmag-comps__tile-chip {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--comps-purple-dark);
    opacity: 0.78;
  }
  .theinmag-comps__tile--art .theinmag-comps__tile-chip { color: var(--comps-coral-dark); }
  .theinmag-comps__tile--writing .theinmag-comps__tile-chip { color: var(--comps-mint-dark); }
  .theinmag-comps__tile--photofilm .theinmag-comps__tile-chip { color: var(--comps-sky-dark); }
  .theinmag-comps__tile--performance .theinmag-comps__tile-chip { color: var(--comps-peach-dark); }

  .theinmag-comps__tile-title {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: clamp(15px, 1.5vw, 18px);
    line-height: 1.2;
    color: var(--comps-cream-dark);
  }
  .theinmag-comps__tile-pitch {
    font-size: 13px;
    line-height: 1.45;
    color: var(--comps-cream-dark);
    opacity: 0.8;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .theinmag-comps__tile-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    margin-top: 2px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--comps-cream-dark);
    opacity: 0.62;
  }
  .theinmag-comps__tile-meta-item:not(:last-child)::after {
    content: ' \00B7';
    margin-left: 6px;
    opacity: 0.5;
  }
  .theinmag-comps__tile-state {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-top: 4px;
  }
  .theinmag-comps__dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    display: inline-block;
  }
  .theinmag-comps__tile-state--live-now { color: var(--comps-mint-dark); }
  .theinmag-comps__tile-state--live-now .theinmag-comps__dot { background-color: var(--comps-mint-dark); }
  .theinmag-comps__tile-state--opens-in { color: var(--comps-peach-dark); }
  .theinmag-comps__tile-state--opens-in .theinmag-comps__dot { background-color: var(--comps-peach-dark); }
  .theinmag-comps__tile-state--soon { color: var(--comps-purple-dark); }
  .theinmag-comps__tile-state--soon .theinmag-comps__dot { background-color: var(--comps-purple-dark); }

  .theinmag-comps__tile-cta {
    align-self: center;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--comps-purple-dark);
    white-space: nowrap;
  }

  .theinmag-comps__arrow {
    display: inline-block;
    margin-left: 4px;
  }

  .theinmag-for-parents-comps__cta-wrap {
    margin-top: clamp(28px, 4vw, 40px);
    text-align: center;
  }

  .theinmag-for-parents-comps__empty {
    padding: clamp(24px, 3vw, 32px);
    background-color: var(--comps-cream);
    border-radius: 16px;
    text-align: center;
    font-size: 14px;
    color: rgba(42, 31, 61, 0.7);
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-comps__featured-card,
    .theinmag-comps__tile {
      transition: none;
    }
    .theinmag-comps__featured-card:hover,
    .theinmag-comps__featured-card:focus-visible,
    .theinmag-comps__tile:hover,
    .theinmag-comps__tile:focus-visible {
      transform: none;
    }
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "For parents comps",
  "tag": "section",
  "class": "theinmag-for-parents-comps-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "1+2 flipped layout: featured top-picks tile on the left (1/3), 2 long horizontal tiles on the right (2/3) showing currently-open comps. Falls back to opens-soon, then registrations-opening-soon. Auto-populated from competitions-database.csv - no manual touching."
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Something for your kid to aim at."
    },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Subhead",
      "default": "We comb through every Australian kids' competition worth entering - art, writing, photography, science - and curate the best ones into a single hub."
    },
    {
      "type": "header",
      "content": "Featured tile (left, 1/3)"
    },
    {
      "type": "text",
      "id": "featured_id",
      "label": "Featured comp ID",
      "info": "Comp ID from competitions-database.csv. Default: banabae-artists.",
      "default": "banabae-artists"
    },
    {
      "type": "header",
      "content": "Right column filters"
    },
    {
      "type": "text",
      "id": "audience_token",
      "label": "Audience token",
      "info": "Comps whose Audience column contains this token OR 'all' will match. Use 'parents', 'teachers', 'homeschoolers', 'kids', or 'all'.",
      "default": "parents"
    },
    {
      "type": "checkbox",
      "id": "filter_to_tier1",
      "label": "Filter to Tier 1 comps only",
      "default": false
    },
    {
      "type": "header",
      "content": "Section-level CTA"
    },
    {
      "type": "text",
      "id": "all_cta_label",
      "label": "Button label",
      "default": "See all current competitions"
    },
    {
      "type": "url",
      "id": "all_cta_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Day-rotating background (3-image pool)"
    },
    {
      "type": "paragraph",
      "content": "Defaults match /pages/competitions exactly - section background rotates daily across these three images."
    },
    {
      "type": "text",
      "id": "bg_filename_1",
      "label": "Background 1 filename",
      "default": "section_background_competitions1.jpg"
    },
    {
      "type": "text",
      "id": "bg_filename_2",
      "label": "Background 2 filename",
      "default": "section_background_competitions2.jpg"
    },
    {
      "type": "text",
      "id": "bg_filename_3",
      "label": "Background 3 filename",
      "default": "section_background_competitions3.jpg"
    }
  ],
  "presets": [
    {
      "name": "For parents comps"
    }
  ]
}
{% endschema %}
