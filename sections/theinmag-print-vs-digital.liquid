{%- comment -%}
  theinmag-print-vs-digital
  Side-by-side PRINT vs DIGITAL comparison for /pages/for-homeschoolers.
  Replaces the single-column "Built to be shared" split-tile on the
  audience pages with a two-column compare.

  Layout: centred eyebrow, then two columns (thumbnail + heading + tick
  bullets + CTA) side-by-side on desktop, stacked on mobile (first block
  first). A full-width centred closing line sits below both columns.

  Bullets are entered one-per-line in each column's Bullets textarea and
  split on render. Tick icon matches theinmag-split-tile (mint-dark).

  Standalone section so the shared theinmag-split-tile stays untouched.
  Hyphens only, never em or en dashes.
{%- endcomment -%}

{%- liquid
  assign eyebrow = section.settings.eyebrow
  assign closing_line = section.settings.closing_line

  assign bg = section.settings.bg_color | default: 'cream'
  assign bg_var = '--color-cream'
  case bg
    when 'cream'
      assign bg_var = '--color-cream'
    when 'white'
      assign bg_var = '--color-white'
    when 'lavender'
      assign bg_var = '--color-lavender'
    when 'peach'
      assign bg_var = '--color-peach'
    when 'mint'
      assign bg_var = '--color-mint'
    when 'sky'
      assign bg_var = '--color-sky'
  endcase

  assign pt = section.settings.padding_top | default: 80
  assign pb = section.settings.padding_bottom | default: 80
-%}

<section
  class="theinmag-pvd"
  aria-labelledby="theinmag-pvd-eyebrow-{{ section.id }}"
  style="--pvd-bg: var({{ bg_var }}, #FBF6EA); --pvd-pt: {{ pt }}px; --pvd-pb: {{ pb }}px;"
>
  <div class="theinmag-pvd__inner">
    {%- if eyebrow != blank -%}
      <p class="theinmag-pvd__eyebrow" id="theinmag-pvd-eyebrow-{{ section.id }}">{{ eyebrow }}</p>
    {%- endif -%}

    <div class="theinmag-pvd__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'column' -%}
          {%- liquid
            assign col_image = block.settings.image
            assign col_filename = block.settings.image_filename
            assign col_alt = block.settings.image_alt | default: ''
            assign bullet_rows = block.settings.bullets | newline_to_br | split: '<br />'
          -%}
          <article class="theinmag-pvd__col" {{ block.shopify_attributes }}>
            <div class="theinmag-pvd__col-media">
              {%- if col_image != blank -%}
                <img
                  class="theinmag-pvd__col-image"
                  src="{{ col_image | image_url: width: 400 }}"
                  srcset="{{ col_image | image_url: width: 200 }} 200w, {{ col_image | image_url: width: 400 }} 400w"
                  sizes="160px"
                  width="{{ col_image.width }}"
                  height="{{ col_image.height }}"
                  alt="{{ col_alt | escape }}"
                  loading="lazy"
                >
              {%- elsif col_filename != blank -%}
                <img
                  class="theinmag-pvd__col-image"
                  src="{{ col_filename | asset_url }}"
                  alt="{{ col_alt | escape }}"
                  loading="lazy"
                >
              {%- else -%}
                <div class="theinmag-pvd__col-placeholder" aria-hidden="true"><span>TBC</span></div>
              {%- endif -%}
            </div>

            {%- if block.settings.heading != blank -%}
              <h3 class="theinmag-pvd__col-heading">{{ block.settings.heading }}</h3>
            {%- endif -%}

            {%- if bullet_rows.size > 0 -%}
              <ul class="theinmag-pvd__bullets" role="list">
                {%- for row in bullet_rows -%}
                  {%- assign row_text = row | strip -%}
                  {%- if row_text != blank -%}
                    <li class="theinmag-pvd__bullet">
                      <svg class="theinmag-pvd__check" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                        <circle cx="10" cy="10" r="10" fill="currentColor" opacity="0.12"/>
                        <path d="M5.5 10.5l3 3 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                      <span class="theinmag-pvd__bullet-text">{{ row_text }}</span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}

            {%- if block.settings.cta_label != blank -%}
              <div class="theinmag-pvd__cta">
                <a class="theinmag-btn theinmag-btn--primary" href="{{ block.settings.cta_link | default: '#' }}">
                  {{- block.settings.cta_label -}}
                </a>
              </div>
            {%- endif -%}
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if closing_line != blank -%}
      <p class="theinmag-pvd__closing">{{ closing_line }}</p>
    {%- endif -%}
  </div>
</section>

{%- stylesheet -%}
  .theinmag-pvd {
    background-color: var(--pvd-bg, #FBF6EA);
    color: var(--color-inky-purple-navy, #2A1F3D);
    padding: var(--pvd-pt, 80px) clamp(20px, 5vw, 64px) var(--pvd-pb, 80px);
  }

  .theinmag-pvd__inner {
    max-width: 1180px;
    margin: 0 auto;
  }

  .theinmag-pvd__eyebrow {
    margin: 0 0 clamp(20px, 2.5vw, 32px);
    text-align: center;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 500;
    font-size: 12px;
    line-height: 1.4;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(123, 79, 158, 0.85);
  }

  .theinmag-pvd__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(20px, 3vw, 32px);
  }

  @media (min-width: 768px) {
    .theinmag-pvd__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .theinmag-pvd__col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    background-color: #ffffff;
    border-radius: var(--radius-lg, 20px);
    padding: clamp(28px, 3.5vw, 44px);
    box-shadow: 0 2px 12px rgba(42, 31, 61, 0.06);
  }

  .theinmag-pvd__col-media {
    width: clamp(96px, 14vw, 140px);
    margin-bottom: clamp(16px, 2vw, 24px);
  }

  .theinmag-pvd__col-image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .theinmag-pvd__col-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: rgba(123, 79, 158, 0.12);
    border-radius: var(--radius-md, 12px);
    color: rgba(123, 79, 158, 0.65);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .theinmag-pvd__col-heading {
    margin: 0 0 clamp(14px, 1.8vw, 20px);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 700;
    font-size: clamp(22px, 2.6vw, 28px);
    line-height: 1.15;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-inky-purple-navy, #2A1F3D);
  }

  .theinmag-pvd__bullets {
    list-style: none;
    margin: 0 0 clamp(20px, 2.5vw, 28px);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(10px, 1.2vw, 14px);
    width: 100%;
  }

  .theinmag-pvd__bullet {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    color: var(--color-inky-purple-navy, #2A1F3D);
  }

  .theinmag-pvd__check {
    flex: 0 0 auto;
    width: 22px;
    height: 22px;
    color: var(--color-mint-dark, #4A8B72);
    margin-top: 2px;
  }

  .theinmag-pvd__bullet-text {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 500;
    font-size: clamp(14px, 1.5vw, 16px);
    line-height: 1.5;
  }

  .theinmag-pvd__cta {
    margin-top: auto;
  }

  .theinmag-pvd__closing {
    margin: clamp(28px, 4vw, 44px) auto 0;
    max-width: 60ch;
    text-align: center;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 500;
    font-size: clamp(16px, 1.8vw, 19px);
    line-height: 1.6;
    color: var(--color-inky-purple-navy, #2A1F3D);
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "Print vs digital",
  "tag": "section",
  "class": "theinmag-print-vs-digital-section",
  "max_blocks": 2,
  "settings": [
    {
      "type": "paragraph",
      "content": "Two-column PRINT vs DIGITAL comparison. Add two Column blocks (first renders first / left). Bullets: one per line."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (centred)",
      "default": "Print or digital?"
    },
    {
      "type": "textarea",
      "id": "closing_line",
      "label": "Closing line (full width, centred)"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "bg_color",
      "label": "Section background",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "white", "label": "White" },
        { "value": "lavender", "label": "Lavender" },
        { "value": "peach", "label": "Peach" },
        { "value": "mint", "label": "Mint" },
        { "value": "sky", "label": "Sky" }
      ],
      "default": "cream"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (px)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (px)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "info": "e.g. PRINT or DIGITAL."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Thumbnail"
        },
        {
          "type": "text",
          "id": "image_filename",
          "label": "Fallback filename in /assets/"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "textarea",
          "id": "bullets",
          "label": "Bullets (one per line)"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Print vs digital",
      "blocks": [
        { "type": "column" },
        { "type": "column" }
      ]
    }
  ]
}
{% endschema %}
