{%- comment -%}
  theinmag-print-vs-digital
  Side-by-side PRINT vs DIGITAL comparison for /pages/for-homeschoolers.
  Replaces the single-column "Built to be shared" split-tile on the
  audience pages with a two-column compare.

  Layout: centred eyebrow, then two image-led tiles side-by-side on desktop
  (stacked on mobile, first block first) with an optional Post-font "VS"
  divider between them. Each tile = full-bleed image filling the top with the
  PRINT / DIGITAL heading overlaid (white-on-scrim, Post font), then tick
  bullets + CTA below. The CTA can enlarge one word (cta_emphasis) in Post
  font. A full-width centred closing line sits below both tiles.

  Bullets are entered one-per-line in each column's Bullets textarea and
  split on render. Tick icon matches theinmag-split-tile (mint-dark).

  Standalone section so the shared theinmag-split-tile stays untouched.
  Hyphens only, never em or en dashes.
{%- endcomment -%}

{%- liquid
  assign eyebrow = section.settings.eyebrow
  assign closing_line = section.settings.closing_line
  assign show_versus = section.settings.show_versus
  assign versus_label = section.settings.versus_label | default: 'VS'

  assign bg = section.settings.bg_color | default: 'cream'
  assign bg_var = '--color-cream'
  case bg
    when 'cream'
      assign bg_var = '--color-cream'
    when 'white'
      assign bg_var = '--color-white'
    when 'lavender'
      assign bg_var = '--color-lavender'
    when 'peach'
      assign bg_var = '--color-peach'
    when 'mint'
      assign bg_var = '--color-mint'
    when 'sky'
      assign bg_var = '--color-sky'
  endcase

  assign pt = section.settings.padding_top | default: 80
  assign pb = section.settings.padding_bottom | default: 80
-%}

<section
  class="theinmag-pvd"
  aria-labelledby="theinmag-pvd-eyebrow-{{ section.id }}"
  style="--pvd-bg: var({{ bg_var }}, #FBF6EA); --pvd-pt: {{ pt }}px; --pvd-pb: {{ pb }}px;"
>
  <div class="theinmag-pvd__inner">
    {%- if eyebrow != blank -%}
      <p class="theinmag-pvd__eyebrow" id="theinmag-pvd-eyebrow-{{ section.id }}">{{ eyebrow }}</p>
    {%- endif -%}

    <div class="theinmag-pvd__grid{% if show_versus %} theinmag-pvd__grid--versus{% endif %}">
      {%- for block in section.blocks -%}
        {%- if block.type == 'column' -%}
          {%- liquid
            assign col_image = block.settings.image
            assign col_filename = block.settings.image_filename
            assign col_alt = block.settings.image_alt | default: ''
            assign bullet_rows = block.settings.bullets | newline_to_br | split: '<br />'
            assign cta_label = block.settings.cta_label
            assign cta_em = block.settings.cta_emphasis
            if cta_em != blank and cta_label != blank
              assign cta_em_html = '<span class="theinmag-pvd__cta-em">' | append: cta_em | append: '</span>'
              assign cta_label = cta_label | replace: cta_em, cta_em_html
            endif
          -%}
          <article class="theinmag-pvd__col" {{ block.shopify_attributes }}>
            <div class="theinmag-pvd__col-media">
              {%- if col_image != blank -%}
                <img
                  class="theinmag-pvd__col-image"
                  src="{{ col_image | image_url: width: 800 }}"
                  srcset="{{ col_image | image_url: width: 500 }} 500w, {{ col_image | image_url: width: 800 }} 800w, {{ col_image | image_url: width: 1100 }} 1100w"
                  sizes="(min-width: 768px) 45vw, 90vw"
                  width="{{ col_image.width }}"
                  height="{{ col_image.height }}"
                  alt="{{ col_alt | escape }}"
                  loading="lazy"
                >
              {%- elsif col_filename != blank -%}
                <img
                  class="theinmag-pvd__col-image"
                  src="{{ col_filename | asset_url }}"
                  alt="{{ col_alt | escape }}"
                  loading="lazy"
                >
              {%- else -%}
                <div class="theinmag-pvd__col-placeholder" aria-hidden="true"><span>TBC</span></div>
              {%- endif -%}

              {%- if block.settings.heading != blank -%}
                <h3 class="theinmag-pvd__col-heading">{{ block.settings.heading }}</h3>
              {%- endif -%}
            </div>

            <div class="theinmag-pvd__col-body">
              {%- if bullet_rows.size > 0 -%}
                <ul class="theinmag-pvd__bullets" role="list">
                  {%- for row in bullet_rows -%}
                    {%- assign row_text = row | strip -%}
                    {%- if row_text != blank -%}
                      <li class="theinmag-pvd__bullet">
                        <svg class="theinmag-pvd__check" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                          <circle cx="10" cy="10" r="10" fill="currentColor" opacity="0.12"/>
                          <path d="M5.5 10.5l3 3 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span class="theinmag-pvd__bullet-text">{{ row_text }}</span>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}

              {%- if cta_label != blank -%}
                <div class="theinmag-pvd__cta">
                  <a class="theinmag-btn theinmag-btn--primary" href="{{ block.settings.cta_link | default: '#' }}">
                    <span class="theinmag-pvd__cta-label">{{ cta_label }}</span>
                  </a>
                </div>
              {%- endif -%}
            </div>
          </article>

          {%- if show_versus and forloop.first and section.blocks.size > 1 -%}
            <div class="theinmag-pvd__vs" aria-hidden="true"><span>{{ versus_label }}</span></div>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if closing_line != blank -%}
      <p class="theinmag-pvd__closing">{{ closing_line }}</p>
    {%- endif -%}
  </div>
</section>

{%- stylesheet -%}
  .theinmag-pvd {
    background-color: var(--pvd-bg, #FBF6EA);
    color: var(--color-inky-purple-navy, #2A1F3D);
    padding: var(--pvd-pt, 80px) clamp(20px, 5vw, 64px) var(--pvd-pb, 80px);
  }

  /* Mobile: tighten the top gap so the spread above sits closer. */
  @media (max-width: 749px) {
    .theinmag-pvd {
      padding-top: 40px;
    }
  }

  .theinmag-pvd__inner {
    max-width: 1180px;
    margin: 0 auto;
  }

  .theinmag-pvd__eyebrow {
    margin: 0 0 clamp(20px, 2.5vw, 32px);
    text-align: center;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 500;
    font-size: 12px;
    line-height: 1.4;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(123, 79, 158, 0.85);
  }

  .theinmag-pvd__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(16px, 2.5vw, 28px);
    align-items: stretch;
  }

  @media (min-width: 768px) {
    .theinmag-pvd__grid {
      grid-template-columns: 1fr 1fr;
    }

    /* Versus layout: two tiles sit close together; the VS is taken out of
       flow and centred on the seam so it bridges and slightly overlaps
       both tiles. */
    .theinmag-pvd__grid--versus {
      position: relative;
      grid-template-columns: 1fr 1fr;
      gap: clamp(48px, 6vw, 96px);
    }

    .theinmag-pvd__grid--versus .theinmag-pvd__vs {
      position: absolute;
      top: 50%;
      left: 50%;
      width: auto;
      transform: translate(-50%, -50%);
      z-index: 5;
      padding: 0;
      pointer-events: none;
    }
  }

  /* Post-font divider. In-flow between the stacked cards on mobile;
     absolutely centred over the seam on desktop (rules above). */
  .theinmag-pvd__vs {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(4px, 1vw, 8px) 0;
  }

  .theinmag-pvd__vs span {
    font-family: var(--font-heading, 'Post Regular', serif);
    font-weight: 400;
    font-size: clamp(100px, 12.5vw, 170px);
    line-height: 1;
    color: #ffffff;
    text-shadow: 0 4px 18px rgba(0, 0, 0, 0.4), 0 2px 6px rgba(0, 0, 0, 0.45), 0 1px 2px rgba(0, 0, 0, 0.5);
    animation: theinmag-pvd-vs-float 4s ease-in-out infinite;
  }

  /* Constant, really-subtle float + micro-wobble - no periodic shake. */
  @keyframes theinmag-pvd-vs-float {
    0%, 100% { transform: rotate(-7deg) translateY(3px); }
    50% { transform: rotate(-4deg) translateY(-4px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .theinmag-pvd__vs span { animation: none; transform: rotate(-6deg); }
  }

  .theinmag-pvd__col {
    display: flex;
    flex-direction: column;
    background-color: #ffffff;
    border-radius: var(--radius-lg, 20px);
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(42, 31, 61, 0.06);
  }

  /* Image fills the top of the tile; the PRINT / DIGITAL heading sits on
     top of it, white-on-scrim for readability over any photo. */
  .theinmag-pvd__col-media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .theinmag-pvd__col-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.58) 0%,
      rgba(0, 0, 0, 0.18) 38%,
      rgba(0, 0, 0, 0) 62%
    );
    pointer-events: none;
    z-index: 1;
  }

  .theinmag-pvd__col-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .theinmag-pvd__col-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background-color: rgba(123, 79, 158, 0.12);
    color: rgba(123, 79, 158, 0.65);
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .theinmag-pvd__col-heading {
    position: absolute;
    z-index: 2;
    left: clamp(20px, 3vw, 32px);
    right: clamp(20px, 3vw, 32px);
    bottom: clamp(14px, 2.2vw, 22px);
    margin: 0;
    font-family: var(--font-heading, 'Post Regular', serif);
    font-weight: 400;
    font-size: clamp(40px, 6vw, 60px);
    line-height: 1;
    letter-spacing: 0;
    color: #ffffff;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.7), 0 2px 8px rgba(0, 0, 0, 0.65), 0 1px 2px rgba(0, 0, 0, 0.6);
  }

  /* On desktop, the first tile's heading (PRINT) sits bottom-right and the
     second (DIGITAL) stays bottom-left, so the labels read
     "PRINT  vs  DIGITAL" across the central divider. */
  @media (min-width: 768px) {
    .theinmag-pvd__col:first-of-type .theinmag-pvd__col-heading {
      text-align: right;
    }
  }

  .theinmag-pvd__col-body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(24px, 3vw, 36px);
  }

  .theinmag-pvd__bullets {
    list-style: none;
    margin: 0 0 clamp(20px, 2.5vw, 28px);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(10px, 1.2vw, 14px);
    width: 100%;
  }

  .theinmag-pvd__bullet {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    color: var(--color-inky-purple-navy, #2A1F3D);
  }

  .theinmag-pvd__check {
    flex: 0 0 auto;
    width: 22px;
    height: 22px;
    color: var(--color-mint-dark, #4A8B72);
    margin-top: 2px;
  }

  .theinmag-pvd__bullet-text {
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 500;
    font-size: clamp(13px, 1.4vw, 15px);
    line-height: 1.5;
  }

  .theinmag-pvd__cta {
    margin-top: auto;
  }

  /* Enlarge just the PRINT / DIGITAL word inside the button, in Post font,
     without changing the button box. line-height:1 keeps the button height
     stable despite the larger glyphs. */
  .theinmag-pvd__cta-em {
    font-family: var(--font-heading, 'Post Regular', serif);
    font-size: 1.3em;
    line-height: 1;
  }

  .theinmag-pvd__closing {
    margin: clamp(28px, 4vw, 44px) auto 0;
    max-width: 60ch;
    text-align: center;
    font-family: var(--font-body, 'Inter', system-ui, sans-serif);
    font-weight: 500;
    font-size: clamp(16px, 1.8vw, 19px);
    line-height: 1.6;
    color: var(--color-inky-purple-navy, #2A1F3D);
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "Print vs digital",
  "tag": "section",
  "class": "theinmag-print-vs-digital-section",
  "max_blocks": 2,
  "settings": [
    {
      "type": "paragraph",
      "content": "Two-column PRINT vs DIGITAL comparison. Add two Column blocks (first renders first / left). Bullets: one per line."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (centred)",
      "default": "Print or digital?"
    },
    {
      "type": "textarea",
      "id": "closing_line",
      "label": "Closing line (full width, centred)"
    },
    {
      "type": "checkbox",
      "id": "show_versus",
      "label": "Show VS divider between the two tiles",
      "default": true
    },
    {
      "type": "text",
      "id": "versus_label",
      "label": "Divider text",
      "default": "VS"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "bg_color",
      "label": "Section background",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "white", "label": "White" },
        { "value": "lavender", "label": "Lavender" },
        { "value": "peach", "label": "Peach" },
        { "value": "mint", "label": "Mint" },
        { "value": "sky", "label": "Sky" }
      ],
      "default": "cream"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (px)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (px)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading (overlaid on image)",
          "info": "e.g. Print or Digital. Renders large in Post font over the image."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (fills the top of the tile)"
        },
        {
          "type": "text",
          "id": "image_filename",
          "label": "Fallback filename in /assets/"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "textarea",
          "id": "bullets",
          "label": "Bullets (one per line)"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label"
        },
        {
          "type": "text",
          "id": "cta_emphasis",
          "label": "Button word to enlarge (Post font)",
          "info": "A word inside the label, e.g. print. Rendered larger in Post font. Must match the label's spelling/case exactly."
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Print vs digital",
      "blocks": [
        { "type": "column" },
        { "type": "column" }
      ]
    }
  ]
}
{% endschema %}
