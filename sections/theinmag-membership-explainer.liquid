{%- comment -%}
  theinmag-membership-explainer
  The main editorial sell block from membership-pdp-copy.md
  [EXPLAINER_BLOCK]. Three short paragraphs on cream with a bolded
  lead-in for the first line. Inter body, centred copy, generous
  whitespace.

  Spec: ../theinmag-docs/membership-pdp-copy.md EXPLAINER_BLOCK
{%- endcomment -%}

{%- liquid
  assign lead_in = section.settings.lead_in
  assign paragraph_1 = section.settings.paragraph_1
  assign paragraph_2 = section.settings.paragraph_2
  assign paragraph_3 = section.settings.paragraph_3
  assign section_style = '--tmex-pt: ' | append: section.settings.padding_top | append: 'px; --tmex-pb: ' | append: section.settings.padding_bottom | append: 'px;'
-%}

<section
  class="theinmag-membership-explainer"
  aria-labelledby="theinmag-membership-explainer-heading"
  style="{{ section_style }}"
>
  <div class="theinmag-membership-explainer__inner">
    {%- if lead_in != blank -%}
      <h2 id="theinmag-membership-explainer-heading" class="theinmag-membership-explainer__lead">
        {{ lead_in }}
      </h2>
    {%- endif -%}

    {%- if paragraph_1 != blank -%}
      <p class="theinmag-membership-explainer__paragraph">{{ paragraph_1 }}</p>
    {%- endif -%}
    {%- if paragraph_2 != blank -%}
      <p class="theinmag-membership-explainer__paragraph">{{ paragraph_2 }}</p>
    {%- endif -%}
    {%- if paragraph_3 != blank -%}
      <p class="theinmag-membership-explainer__paragraph theinmag-membership-explainer__paragraph--closer">{{ paragraph_3 }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .theinmag-membership-explainer {
    background-color: var(--color-cream);
    color: var(--color-inky-purple-navy);
    padding: var(--tmex-pt, 80px) var(--space-lg) var(--tmex-pb, 80px);
  }

  .theinmag-membership-explainer__inner {
    max-width: 56ch;
    margin: 0 auto;
    text-align: center;
  }

  .theinmag-membership-explainer__lead {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(28px, 5vw, 40px);
    line-height: 1.15;
    color: var(--color-inky-purple-navy);
    margin: 0 0 var(--space-xl);
  }

  .theinmag-membership-explainer__paragraph {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: clamp(17px, 2vw, 19px);
    line-height: 1.65;
    color: var(--color-inky-purple-navy);
    margin: 0 0 var(--space-lg);
  }

  .theinmag-membership-explainer__paragraph--closer {
    font-weight: 500;
    color: var(--color-purple-dark);
    margin-bottom: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Membership explainer",
  "tag": "section",
  "class": "shopify-section theinmag-membership-explainer-section",
  "settings": [
    {
      "type": "text",
      "id": "lead_in",
      "label": "Lead-in heading",
      "default": "Real kids fill every page. Yours could be next."
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "Paragraph 1",
      "default": "theINmag is 100% kid-created. Real names, real towns, real creations - writing, art, photography, maths puzzles, comics, the works. Every issue is 120+ pages of stuff your kid will actually flick through, not scroll past."
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Paragraph 2",
      "default": "A Membership locks in the next few drops at the best per-issue price, and unlocks first dibs when your kid sends their own creation IN. Three releases a year - mid February, mid June, mid October. No ads. No subscriptions you forget to cancel. Just a really good magazine, three times a year."
    },
    {
      "type": "textarea",
      "id": "paragraph_3",
      "label": "Paragraph 3 (closer)",
      "default": "Pick your format, pick your length, pick where you want to start. We'll handle the rest."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 80,
      "unit": "px"
    }
  ],
  "presets": [
    { "name": "Membership explainer" }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
