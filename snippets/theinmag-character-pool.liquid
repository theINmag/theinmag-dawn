{%- comment -%}
  theinmag-character-pool
  Sitewide random kid-character pool. Drop one render of this snippet
  on a page (top of any always-rendered section), then drop bare
  <span data-theinmag-pool-character> markers wherever you want a
  character to pop in. JS picks one URL per marker, with Fisher-Yates
  shuffle so the picks are distinct per page until the pool is
  exhausted.

  ----------------------------------------------------------------
  WHEN YOU UPLOAD MORE CHARACTERS
  ----------------------------------------------------------------
  Files live in /assets/ as character-1.png ... character-N.png.
  Bump pool_size below to N (the number of files you've uploaded).

  Why does pool_size matter? The snippet emits a tiny inline JSON
  ({"size": N, "firstUrl": "..."}) and JS builds character-N URLs
  by replacing the "1" in firstUrl. So pool_size doesn't change the
  inline weight - even 500 emits ~150 bytes. What it controls is
  the random pick range. Set it to 500 if you only have 26 files
  and most slots will 404 (the JS retries by walking the shuffled
  indices, but with 26/500 valid, nearly every retry would still
  fail). Set it to 26 today, bump to 500 the day you actually have
  500. The retry handler covers GAPS in the sequence (file 7 missing
  while 1-6 and 8-26 exist), not pools that are mostly empty.

  Scaling note: the picks are TOTALLY RANDOM. Math.random() per page
  load + Fisher-Yates shuffle = a fresh permutation every visit. No
  deterministic algorithm.
  ----------------------------------------------------------------
{%- endcomment -%}

{%- liquid
  assign pool_size = 26
  assign first_url = 'character-1.png' | asset_url
-%}

<script type="application/json" data-theinmag-character-pool>
{"size":{{ pool_size }},"firstUrl":{{ first_url | json }}}
</script>

<script>
  (function () {
    /* Multiple sections may render this snippet on the same page (so any
       page that has character slots is self-sufficient). The guard
       ensures only the first instance does work; subsequent renders
       early-return so we don't fight over the slots or double-bind
       scroll listeners. */
    if (window.__theinmagCharacterPoolInit) return;
    window.__theinmagCharacterPoolInit = true;

    /* Defer until the full DOM is parsed. Without this, when the
       snippet renders at the top of a section, the slot
       querySelectorAll returns 0 elements - the spans don't exist
       in DOM yet because the HTML parser hasn't reached them. The
       init guard then blocks any retry. Waiting for
       DOMContentLoaded ensures every span on the page is visible
       to the query. */
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    function init() {
    var poolEl = document.querySelector('[data-theinmag-character-pool]');
    if (!poolEl) return;
    var data;
    try { data = JSON.parse(poolEl.textContent); } catch (e) { return; }
    if (!data || !data.size || !data.firstUrl) return;

    var slots = document.querySelectorAll('[data-theinmag-pool-character]');
    if (!slots.length) return;

    /* Build shuffled list of indices 1..size. Fisher-Yates so the
       distribution is uniform per page load. Each slot reads from its
       own offset into this shared list so multi-slot pages get
       distinct picks (until the pool is exhausted). */
    var indices = [];
    for (var i = 1; i <= data.size; i++) indices.push(i);
    for (var k = indices.length - 1; k > 0; k--) {
      var j = Math.floor(Math.random() * (k + 1));
      var tmp = indices[k]; indices[k] = indices[j]; indices[j] = tmp;
    }

    function urlForIndex(n) {
      return data.firstUrl.replace('character-1.png', 'character-' + n + '.png');
    }

    /* Shared "taken" set so each character index can only fill one
       slot on the page. Without this, two slots whose initial
       offsets land on 404'd files can both walk forward and land on
       the same valid index - which is the duplicate Ryan flagged
       on 2026-05-11. Set is shared across all slots' fillSlot
       calls; the check fires both before probing and after onload
       (covers the race where two slots are probing the same index
       concurrently). */
    var taken = (typeof window.Set === 'function') ? new Set() : null;
    function isTaken(n) { return taken ? taken.has(n) : false; }
    function markTaken(n) { if (taken) taken.add(n); }

    /* Walk the shuffled indices starting from a per-slot offset until
       we find one that loads AND isn't already taken by another slot.
       Covers gaps in the sequence (file 7 missing while 1-6 and 8-26
       exist). Each attempt creates a fresh Image so onerror fires
       reliably. Once we exhaust the indices, hide the slot. */
    function fillSlot(slot, startOffset, attempt) {
      if (attempt >= indices.length) {
        slot.style.display = 'none';
        return;
      }
      var n = indices[(startOffset + attempt) % indices.length];
      if (isTaken(n)) {
        fillSlot(slot, startOffset, attempt + 1);
        return;
      }
      var url = urlForIndex(n);
      var probe = new Image();
      probe.onload = function () {
        if (slot.querySelector('img')) return;
        /* Race guard: another slot may have claimed this index while
           our probe was in flight. If so, walk forward. */
        if (isTaken(n)) {
          fillSlot(slot, startOffset, attempt + 1);
          return;
        }
        markTaken(n);
        var finalImg = document.createElement('img');
        finalImg.className = 'theinmag-pool-character__img';
        finalImg.src = url;
        finalImg.alt = '';
        finalImg.setAttribute('aria-hidden', 'true');
        slot.appendChild(finalImg);
      };
      probe.onerror = function () {
        fillSlot(slot, startOffset, attempt + 1);
      };
      probe.src = url;
    }

    Array.prototype.forEach.call(slots, function (slot, idx) {
      if (slot.querySelector('img')) return;
      fillSlot(slot, idx, 0);
    });

    /* One-shot scroll-pop. Sections supply their own .is-popped CSS;
       this snippet just adds the class when each slot scrolls into
       view. Plain scroll listener (not IntersectionObserver) for
       parity with the other theinmag- sections. */
    var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      Array.prototype.forEach.call(slots, function (s) { s.classList.add('is-popped'); });
      return;
    }

    var pending = Array.prototype.slice.call(slots);
    function check() {
      pending = pending.filter(function (slot) {
        var rect = slot.getBoundingClientRect();
        if (rect.top < window.innerHeight * 0.85) {
          slot.classList.add('is-popped');
          return false;
        }
        return true;
      });
      if (!pending.length) window.removeEventListener('scroll', onScroll);
    }
    function onScroll() { window.requestAnimationFrame(check); }
    window.addEventListener('scroll', onScroll, { passive: true });
    check();
    } /* end init() */
  })();
</script>

{%- comment -%}
  Base styling. Sections that already have their own character CSS
  (mission, philosophy, reviews, FAQ) keep their wrapper-level
  positioning + animations and override the pool's bob to avoid
  double-animating. Sections without bespoke styling get the default
  pop + bob from below.
{%- endcomment -%}
{% stylesheet %}
/* :where() drops the pool's base rules to specificity 0,0,0 so any
   section-level rule on .theinmag-<section>__character wins. Without
   this, the pool's display:block was tying with section
   display:none on mobile (both at 0,1,0) and the load order
   sometimes flipped the winner - sections that should have hidden
   the character on mobile rendered it at huge sizes instead. */
:where([data-theinmag-pool-character]) {
  display: block;
  pointer-events: none;
  opacity: 0;
  transform: translateY(8px);
  transition: opacity 0.6s ease, transform 0.6s ease;
}
:where([data-theinmag-pool-character].is-popped) {
  opacity: 1;
  transform: translateY(0);
}
.theinmag-pool-character__img {
  display: block;
  width: 100%;
  height: auto;
  animation: theinmag-pool-character-bob 4s ease-in-out infinite;
}
@keyframes theinmag-pool-character-bob {
  0%, 100% { transform: translateY(0) rotate(-2deg); }
  50% { transform: translateY(-5px) rotate(2deg); }
}
@media (prefers-reduced-motion: reduce) {
  [data-theinmag-pool-character] {
    opacity: 1;
    transform: none;
    transition: none;
  }
  .theinmag-pool-character__img {
    animation: none;
  }
}
{% endstylesheet %}
