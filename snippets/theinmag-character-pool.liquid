{%- comment -%}
  theinmag-character-pool
  Sitewide random kid-character pool. Drop one render of this snippet
  on a page (top of any always-rendered section), then drop bare
  <span data-theinmag-pool-character> markers wherever you want a
  character to pop in. JS picks one URL per marker, with Fisher-Yates
  shuffle so picks are distinct per page until the pool is exhausted.

  ----------------------------------------------------------------
  AUTO-DISCOVERY (rewired 2026-05-12)
  ----------------------------------------------------------------
  Files live in /assets/ as character-1.png .. character-N.png. On
  page load, JS parallel-probes character-1 through character-{max}
  (max = 100, hardcoded below) and discovers which exist. Valid
  indices get cached in sessionStorage with a 1-hour TTL so subsequent
  page loads in the same tab don't re-probe.

  When you upload more characters, bump pool_max below to the new
  total; the cache invalidates next time the TTL expires or tab closes.

  Keep pool_max equal to the actual file count (no headroom) so the
  per-load probes never 404 - that keeps the console clean. The first
  page load in a tab fires pool_max parallel image probes; slots stay
  opacity:0 until they settle.

  Cache invalidation: sessionStorage clears with the tab. If you add
  files mid-session and want to see them immediately, open a new tab.

  Scaling note: Math.random() per page load + Fisher-Yates shuffle on
  the discovered indices = a fresh permutation every visit.
  ----------------------------------------------------------------
{%- endcomment -%}

{%- liquid
  assign pool_max = 53
  assign first_url = 'character-1.png' | asset_url
-%}

<script type="application/json" data-theinmag-character-pool>
{"max":{{ pool_max }},"firstUrl":{{ first_url | json }}}
</script>

<script>
  (function () {
    /* Multiple sections may render this snippet on the same page (so
       any page that has character slots is self-sufficient). The guard
       ensures only the first instance does work; subsequent renders
       early-return so we don't fight over the slots or double-bind
       scroll listeners. */
    if (window.__theinmagCharacterPoolInit) return;
    window.__theinmagCharacterPoolInit = true;

    /* Defer until the full DOM is parsed. Without this, when the
       snippet renders at the top of a section, the slot
       querySelectorAll returns 0 elements - the spans don't exist
       in DOM yet because the HTML parser hasn't reached them. */
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

    function init() {
      var poolEl = document.querySelector('[data-theinmag-character-pool]');
      if (!poolEl) return;
      var data;
      try { data = JSON.parse(poolEl.textContent); } catch (e) { return; }
      if (!data || !data.firstUrl) return;

      var slots = document.querySelectorAll('[data-theinmag-pool-character]');
      if (!slots.length) return;

      var max = data.max || 100;
      var firstUrl = data.firstUrl;
      var cacheKey = 'theinmagCharacterPool';
      var ttl = 60 * 60 * 1000; /* 1 hour */

      var cached = readCache();
      if (cached) {
        run(cached);
      } else {
        probe(function (valid) {
          writeCache(valid);
          run(valid);
        });
      }

      function urlForIndex(n) {
        return firstUrl.replace('character-1.png', 'character-' + n + '.png');
      }

      function readCache() {
        try {
          var raw = sessionStorage.getItem(cacheKey);
          if (!raw) return null;
          var parsed = JSON.parse(raw);
          if (!parsed || !parsed.ts || !parsed.indices) return null;
          if (Date.now() - parsed.ts > ttl) return null;
          if (!parsed.indices.length) return null;
          return parsed.indices.slice();
        } catch (e) { return null; }
      }

      function writeCache(indices) {
        try {
          sessionStorage.setItem(cacheKey, JSON.stringify({
            ts: Date.now(),
            indices: indices
          }));
        } catch (e) {}
      }

      function probe(callback) {
        /* Parallel-probe characters 1..max. Each new Image() either
           fires onload (file exists) or onerror (404). When all have
           settled, call back with the sorted list of valid indices. */
        var pending = max;
        var valid = [];
        for (var i = 1; i <= max; i++) {
          (function (idx) {
            var img = new Image();
            img.onload = function () {
              valid.push(idx);
              if (--pending === 0) finish();
            };
            img.onerror = function () {
              if (--pending === 0) finish();
            };
            img.src = urlForIndex(idx);
          })(i);
        }
        function finish() {
          valid.sort(function (a, b) { return a - b; });
          callback(valid);
        }
      }

      function run(validIndices) {
        if (!validIndices.length) return;

        /* Fisher-Yates shuffle over the discovered valid indices. */
        var indices = validIndices.slice();
        for (var k = indices.length - 1; k > 0; k--) {
          var j = Math.floor(Math.random() * (k + 1));
          var tmp = indices[k]; indices[k] = indices[j]; indices[j] = tmp;
        }

        /* Shared "taken" set so each index can only fill one slot per
           page. Without this, two slots can land on the same valid
           index (the duplicate Ryan flagged 2026-05-11). */
        var taken = (typeof window.Set === 'function') ? new Set() : null;
        function isTaken(n) { return taken ? taken.has(n) : false; }
        function markTaken(n) { if (taken) taken.add(n); }

        /* Indices are pre-validated by the probe step so no per-slot
           probe-and-retry-on-404 is needed. We only walk forward if
           an index is already taken by another slot. */
        function fillSlot(slot, startOffset) {
          for (var attempt = 0; attempt < indices.length; attempt++) {
            var n = indices[(startOffset + attempt) % indices.length];
            if (isTaken(n)) continue;
            markTaken(n);
            var img = document.createElement('img');
            img.className = 'theinmag-pool-character__img';
            img.src = urlForIndex(n);
            img.alt = '';
            img.setAttribute('aria-hidden', 'true');
            slot.appendChild(img);
            return;
          }
          /* All indices taken - hide this slot. */
          slot.style.display = 'none';
        }

        Array.prototype.forEach.call(slots, function (slot, idx) {
          if (slot.querySelector('img')) return;
          fillSlot(slot, idx);
        });

        /* One-shot scroll-pop. Sections supply their own .is-popped
           CSS; this snippet just adds the class when each slot
           scrolls into view. Plain scroll listener for parity with
           the other theinmag- sections. */
        var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduced) {
          Array.prototype.forEach.call(slots, function (s) { s.classList.add('is-popped'); });
          return;
        }

        var pending = Array.prototype.slice.call(slots);
        function check() {
          pending = pending.filter(function (slot) {
            var rect = slot.getBoundingClientRect();
            if (rect.top < window.innerHeight * 0.85) {
              slot.classList.add('is-popped');
              return false;
            }
            return true;
          });
          if (!pending.length) window.removeEventListener('scroll', onScroll);
        }
        function onScroll() { window.requestAnimationFrame(check); }
        window.addEventListener('scroll', onScroll, { passive: true });
        check();
      }
    }
  })();
</script>

{%- comment -%}
  Base styling. Sections that already have their own character CSS
  (mission, philosophy, reviews, FAQ) keep their wrapper-level
  positioning + animations and override the pool's bob to avoid
  double-animating.
{%- endcomment -%}
{% stylesheet %}
/* :where() drops these base rules to specificity 0,0,0 so any
   section-level rule on .theinmag-<section>__character wins. */
:where([data-theinmag-pool-character]) {
  display: block;
  pointer-events: none;
  opacity: 0;
  transform: translateY(8px);
  transition: opacity 0.6s ease, transform 0.6s ease;
}
:where([data-theinmag-pool-character].is-popped) {
  opacity: 1;
  transform: translateY(0);
}
.theinmag-pool-character__img {
  display: block;
  width: 100%;
  height: auto;
  animation: theinmag-pool-character-bob 4s ease-in-out infinite;
}
@keyframes theinmag-pool-character-bob {
  0%, 100% { transform: translateY(0) rotate(-2deg); }
  50% { transform: translateY(-5px) rotate(2deg); }
}
@media (prefers-reduced-motion: reduce) {
  [data-theinmag-pool-character] {
    opacity: 1;
    transform: none;
    transition: none;
  }
  .theinmag-pool-character__img {
    animation: none;
  }
}
{% endstylesheet %}
