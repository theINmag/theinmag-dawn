{%- comment -%}
  theinmag-series-hub-card
  One piece on a series hub page (theinmag-series-hub section), v2 per
  the 2026-08-31 premium rebuild: image plus caption, NO card chrome
  (no box, border, shadow or button), per the Maude / Colossal /
  Modern House research.

  Inputs:
    article       - Article object (required)
    variant       - 'lead'    large 4:3 feature (Maude's 853-wide slot)
                    'small'   16:9 compact (the stacked pair beside a lead)
                    'natural' masonry item, image keeps its own aspect
                              ratio, never cropped (Colossal pattern,
                              and the never-distort-kid-art rule)
    shopify_attrs - block.shopify_attributes passthrough

  Caption anatomy: small caps chip (guest name, else text_type, else
  primary_topic), title, and a quiet byline for kid pieces.

  data-search-hay feeds the hub's live search: title, chip, topic, tags,
  kid first name, guest name, excerpt, full body text.
{%- endcomment -%}

{%- liquid
  assign variant = variant | default: 'natural'

  assign card_title = article.title

  assign text_type = article.metafields.field_notes.text_type
  assign card_topic = article.metafields.field_notes.primary_topic
  if card_topic == blank
    assign card_topic = article.tags.first
  endif

  assign guest_name = article.metafields.field_notes.guest_name
  assign chip = guest_name | default: text_type | default: card_topic

  assign kid_name = article.metafields.field_notes.kid_first_name
  assign kid_age = article.metafields.field_notes.kid_age

  capture card_excerpt
    render 'theinmag-card-excerpt', article: article, words: 18
  endcapture
  assign card_excerpt = card_excerpt | strip

  comment
    One-sentence library blurb: field_notes.hub_blurb (Fern writes it,
    never repeating the title or the byline), falling back to the
    excerpt when unset.
  endcomment
  assign card_blurb = article.metafields.field_notes.hub_blurb | default: card_excerpt

  assign is_kid_art = false
  if kid_name != blank
    assign is_kid_art = true
  endif

  assign tag_str = article.tags | join: ' '
  assign full_body = article.content | strip_html

  capture search_hay
    echo card_title
    echo ' '
    echo chip
    echo ' '
    echo card_topic
    echo ' '
    echo tag_str
    echo ' '
    echo kid_name
    echo ' '
    echo guest_name
    echo ' '
    echo card_excerpt
    echo ' '
    echo full_body
  endcapture

  comment
    Image sizing per variant. lead and small are deliberate editorial
    crops (cover); natural keeps the artwork's own proportions with
    real width/height attributes so layout reserves the right space.
  endcomment
  assign img_w = 1200
  if variant == 'small'
    assign img_w = 800
  elsif variant == 'natural'
    assign img_w = 900
  endif

  assign card_image = ''
  if article.image != blank
    assign card_image = article.image | image_url: width: img_w
  endif
  assign card_alt = article.image.alt | default: card_title

  assign nat_w = article.image.width | default: 900
  assign nat_h = article.image.height | default: 600
-%}

<a
  class="theinmag-series-hub__piece theinmag-series-hub__piece--{{ variant }}"
  data-hub-card
  data-text-type="{{ text_type | downcase | strip | escape }}"
  data-search-hay="{{ search_hay | escape | downcase }}"
  href="{{ article.url }}"
  {{ shopify_attrs }}
>
  {%- if card_image != blank -%}
    {%- if variant == 'natural' -%}
      <img
        class="theinmag-series-hub__piece-image theinmag-series-hub__piece-image--natural"
        src="{{ card_image }}"
        alt="{{ card_alt | escape }}"
        loading="lazy"
        width="{{ nat_w }}"
        height="{{ nat_h }}"
      >
    {%- else -%}
      <span class="theinmag-series-hub__piece-frame">
        <img
          class="theinmag-series-hub__piece-image{% if is_kid_art %} theinmag-series-hub__piece-image--top{% endif %}"
          src="{{ card_image }}"
          alt="{{ card_alt | escape }}"
          loading="lazy"
          width="{{ img_w }}"
          {% if variant == 'lead' %}height="{{ img_w | times: 3 | divided_by: 4 }}"{% else %}height="{{ img_w | times: 9 | divided_by: 16 }}"{% endif %}
        >
      </span>
    {%- endif -%}
  {%- endif -%}

  <span class="theinmag-series-hub__piece-caption">
    {%- if chip != blank -%}
      <span class="theinmag-series-hub__piece-chip">{{ chip }}</span>
    {%- endif -%}
    <span class="theinmag-series-hub__piece-title">{{ card_title }}</span>
    {%- if is_kid_art -%}
      <span class="theinmag-series-hub__piece-byline">by {{ kid_name }}{% if kid_age != blank %}, age {{ kid_age }}{% endif %}</span>
    {%- endif -%}
    {%- if card_blurb != blank -%}
      <span class="theinmag-series-hub__piece-excerpt">{{ card_blurb }}</span>
    {%- endif -%}
  </span>
</a>
