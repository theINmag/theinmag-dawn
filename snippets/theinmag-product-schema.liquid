{%- comment -%}
  Product + BreadcrumbList JSON-LD for product pages, emitted as one JSON-LD array
  inside a single <script type="application/ld+json"> tag (Google supports multiple
  schema nodes as a top-level array).
    - Product: Shopify's native `structured_data` filter, which omits priceValidUntil
      (a non-critical GSC Product-snippet warning); we inject priceValidUntil one year
      out into every offer, keeping all of Shopify's other fields intact.
    - BreadcrumbList: Home -> Shop -> {product title}, so product pages carry the same
      breadcrumb schema as the rest of the site (AEO requirement, CLAUDE.md).
  Accepts: product (required).
{%- endcomment -%}
{%- liquid
  assign price_valid_until = 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d'
  assign pvu_find = '"priceCurrency":"' | append: shop.currency | append: '"'
  assign pvu_repl = pvu_find | append: ',"priceValidUntil":"' | append: price_valid_until | append: '"'
-%}
{%- capture product_schema -%}{{ product | structured_data }}{%- endcapture -%}
[
{{- product_schema | replace: pvu_find, pvu_repl -}},
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | json }}},
    {"@type": "ListItem", "position": 2, "name": "Shop", "item": {{ shop.url | append: '/pages/shop' | json }}},
    {"@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ shop.url | append: product.url | json }}}
  ]
}
]
