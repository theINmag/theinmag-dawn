{%- comment -%}
  Stop mobile Safari auto-linking digit strings (the ABN, order numbers, dates)
  into bright-blue tel: links that fail contrast on dark surfaces. There are no
  phone numbers to call on the site, so disabling detection is all upside.
{%- endcomment -%}
<meta name="format-detection" content="telephone=no">
{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

{%- comment -%}
  theINmag - keep the address-check utility pages out of search. They are
  evergreen YES/NO landings reached only via a private Klaviyo link, not
  meant to be discoverable. noindex,follow so any links still pass through.
{%- endcomment -%}
{%- assign noindex_handles = 'address-confirmed,update-address,submitted' | split: ',' -%}
{%- if request.page_type == 'page' and noindex_handles contains page.handle -%}
  <meta name="robots" content="noindex,follow">
{%- endif -%}

{%- comment -%} theINmag - Meta (Facebook) Business domain verification for theinmag.com.au. Static, server-rendered in <head> (Meta rejects JS-injected tags). Added 2026-08-31. {%- endcomment -%}
<meta name="facebook-domain-verification" content="v7l3wm2et7n9ga53u5wxbqrks2snfe">

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- if page_image -%}
  {%- assign og_image_alt = page_image.alt | default: og_title | default: shop.name -%}
  <meta property="og:image" content="http:{{ page_image | image_url }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url }}">
  <meta property="og:image:width" content="{{ page_image.width }}">
  <meta property="og:image:height" content="{{ page_image.height }}">
  <meta property="og:image:alt" content="{{ og_image_alt | escape }}">
  <meta name="twitter:image" content="https:{{ page_image | image_url }}">
  <meta name="twitter:image:alt" content="{{ og_image_alt | escape }}">
{%- else -%}
  {%- comment -%} theINmag - default social share image when the page has no image of its own {%- endcomment -%}
  {%- assign default_og_image = 'Default_graphimage.png' | asset_url | prepend: 'https:' -%}
  {%- assign default_og_image_alt = 'theINmag - the Australian magazine for creative kids.' -%}
  <meta property="og:image" content="{{ default_og_image }}">
  <meta property="og:image:secure_url" content="{{ default_og_image }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ default_og_image_alt | escape }}">
  <meta name="twitter:image" content="{{ default_og_image }}">
  <meta name="twitter:image:alt" content="{{ default_og_image_alt | escape }}">
{%- endif -%}

{%- comment -%}
  theINmag - variant-aware og:price (2026-09-13).
  Dawn shipped `product.price`, which is the product's MINIMUM variant price, not the
  price of the variant the URL actually names. So every non-cheapest variant URL told
  crawlers the wrong price: /products/membership?variant=<Print 4-Issue> advertised
  10.45 against a real 89.00, and every mag's Print variant advertised 10.45 against
  23.95. That contradicted our own (correct) ProductGroup/hasVariant JSON-LD, which
  carries the right per-variant price and offer URL, and it is the strongest candidate
  for the Merchant Center price_mismatch disapprovals on account 5562282575.
  `product.selected_variant` is populated only when ?variant= names a real variant, so
  the bare product URL keeps its previous "from" price behaviour unchanged.
{%- endcomment -%}
{%- if request.page_type == 'product' -%}
  {%- liquid
    if product.selected_variant
      assign og_price = product.selected_variant.price
    else
      assign og_price = product.price
    endif
  -%}
  <meta property="og:price:amount" content="{{ og_price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">

{%- comment -%} theINmag - Apple touch icon (iOS home-screen / bookmark) {%- endcomment -%}
<link rel="apple-touch-icon" href="{{ 'theINlogo-touch.png' | asset_url }}">
