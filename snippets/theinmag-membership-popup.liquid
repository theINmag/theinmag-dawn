{%- comment -%}
  theinmag-membership-popup
  Modal dialog rendered once on /shop. Triggered by clicking the Membership
  tile's "Join the club" CTA. Lets the customer pick Format / Length /
  Starting Issue and add the resulting Membership variant to cart without
  leaving the grid.

  Source of truth for the picker fields is the PDP inline form in
  sections/theinmag-membership-hero.liquid (lines ~263-323). If that
  form changes, mirror the change here. The two are duplicated by design:
  the PDP version carries PDP-only chrome (gallery sync, floating cart,
  Rolling-only accordion) and we don't want that bleeding into /shop.

  Renders nothing if the membership product is missing from the store.

  Required render arg:
    membership_product - the Shopify product object for Membership.

  Mounts its own document-level click listener for [data-membership-popup-trigger]
  so the bundle-tile snippet can stay dumb (just sets the data attribute).
{%- endcomment -%}

{%- if membership_product == blank or membership_product.id == blank -%}{%- else -%}

{%- liquid
  assign current_issue = shop.metafields.theinmag.current_issue_number.value | default: 'Mag09'
  assign print_in_stock = shop.metafields.theinmag.current_issue_print_in_stock.value
  assign next_release_value = shop.metafields.theinmag.next_release_date.value
  assign next_release_formatted = next_release_value | date: '%-d %B %Y'

  assign current_num_str = current_issue | remove: 'Mag'
  assign current_num = current_num_str | times: 1
  assign next_num = current_num | plus: 1
  if next_num < 10
    assign next_issue = 'Mag0' | append: next_num
  else
    assign next_issue = 'Mag' | append: next_num
  endif

  comment
    lead = current issue, alt = next issue. The pre-drop lead shift that
    once lived here was retired at the Mag10 drop; the sold-out safe
    default below is the only time lead moves off the current issue.
  endcomment
  assign lead_issue = current_issue
  assign lead_release_formatted = next_release_formatted
  assign alt_num = next_num
  if alt_num < 10
    assign alt_issue = 'Mag0' | append: alt_num
  else
    assign alt_issue = 'Mag' | append: alt_num
  endif
  assign alt_release_formatted = next_release_value | date: '%-d %B %Y' | default: '15 October 2026'

  # Safe no-JS default for the hidden _starting_mag input: never the
  # sold-out issue. The real pick happens in the start picker dialog
  # (snippets/theinmag-start-picker) which gates every Print add.
  assign cur_handle = current_issue | downcase
  assign cur_prod = all_products[cur_handle]
  assign cur_print_available = false
  for v in cur_prod.variants
    if v.option1 == 'Print' and v.available
      assign cur_print_available = true
    endif
  endfor
  if cur_print_available == false or print_in_stock == false
    assign prev_num = current_num | minus: 1
    if prev_num < 10
      assign prev_issue = 'Mag0' | append: prev_num
    else
      assign prev_issue = 'Mag' | append: prev_num
    endif
    assign prev_handle = prev_issue | downcase
    assign prev_prod = all_products[prev_handle]
    assign prev_print_available = false
    for v in prev_prod.variants
      if v.option1 == 'Print' and v.available
        assign prev_print_available = true
      endif
    endfor
    if prev_print_available
      assign lead_issue = prev_issue
    else
      assign lead_issue = alt_issue
    endif
  endif

  assign first_variant = membership_product.selected_or_first_available_variant

  # Three most recent covers for the header fan (real kid art, the design
  # system's whole point) and the current issue's single prices so the JS
  # can say what a membership saves against buying mags one at a time.
  assign fan_num_1 = current_num | minus: 2
  assign fan_num_2 = current_num | minus: 1
  if fan_num_1 < 10
    assign fan_handle_1 = 'mag0' | append: fan_num_1
  else
    assign fan_handle_1 = 'mag' | append: fan_num_1
  endif
  if fan_num_2 < 10
    assign fan_handle_2 = 'mag0' | append: fan_num_2
  else
    assign fan_handle_2 = 'mag' | append: fan_num_2
  endif
  assign fan_handle_3 = current_issue | downcase
  assign fan_prod_1 = all_products[fan_handle_1]
  assign fan_prod_2 = all_products[fan_handle_2]
  assign fan_prod_3 = all_products[fan_handle_3]
  assign single_print_cents = 0
  assign single_digital_cents = 0
  for v in fan_prod_3.variants
    if v.option1 == 'Print'
      assign single_print_cents = v.price
    elsif v.option1 == 'Digital'
      assign single_digital_cents = v.price
    endif
  endfor
-%}

<dialog
  class="theinmag-membership-popup"
  data-theinmag-membership-popup
  data-single-print="{{ single_print_cents }}"
  data-single-digital="{{ single_digital_cents }}"
  aria-labelledby="theinmag-membership-popup-title"
>
  <div class="theinmag-membership-popup__inner">
    <button
      type="button"
      class="theinmag-membership-popup__close"
      data-membership-popup-close
      aria-label="Close membership options"
    >&#10005;</button>

    <header class="theinmag-membership-popup__head">
      <div class="theinmag-membership-popup__fan" aria-hidden="true">
        {%- if fan_prod_1.featured_image != blank -%}
          <img class="theinmag-membership-popup__fan-cover theinmag-membership-popup__fan-cover--left" src="{{ fan_prod_1.featured_image | image_url: width: 240 }}" width="240" height="314" alt="" loading="lazy">
        {%- endif -%}
        {%- if fan_prod_2.featured_image != blank -%}
          <img class="theinmag-membership-popup__fan-cover theinmag-membership-popup__fan-cover--right" src="{{ fan_prod_2.featured_image | image_url: width: 240 }}" width="240" height="314" alt="" loading="lazy">
        {%- endif -%}
        {%- if fan_prod_3.featured_image != blank -%}
          <img class="theinmag-membership-popup__fan-cover theinmag-membership-popup__fan-cover--centre" src="{{ fan_prod_3.featured_image | image_url: width: 240 }}" width="240" height="314" alt="" loading="lazy">
        {%- endif -%}
      </div>
      <p class="theinmag-membership-popup__eyebrow">Join the club</p>
      <h2 id="theinmag-membership-popup-title" class="theinmag-membership-popup__title">Set up your membership</h2>
      <p class="theinmag-membership-popup__sub">A new mag every drop, straight to their letterbox. No ads, ever.</p>
    </header>

    <div class="theinmag-membership-popup__value">
      <div class="theinmag-membership-popup__price" data-price-display>{{ first_variant.price | money }}</div>
      <div class="theinmag-membership-popup__per" data-per-mag></div>
      <span class="theinmag-membership-popup__save" data-save hidden></span>
    </div>

    <form
      action="{{ routes.cart_add_url }}"
      method="post"
      enctype="multipart/form-data"
      class="theinmag-membership-popup__form"
      data-membership-popup-form
    >
      <input type="hidden" name="id" data-variant-id-input value="{{ first_variant.id }}">
      <input type="hidden" name="quantity" value="1">
      <input type="hidden" name="properties[_starting_mag]" data-prop-starting-mag value="{{ lead_issue }}">
      <input type="hidden" name="properties[_remaining_after_first]" data-prop-remaining value="3">
      <input type="hidden" name="properties[_mags_included]" data-prop-mags-included value="">

      <fieldset class="theinmag-membership-popup__fieldset">
        <legend class="theinmag-membership-popup__legend">Format</legend>
        <div class="theinmag-membership-popup__pills" role="radiogroup" data-option-name="format">
          <button type="button" class="theinmag-membership-popup__pill" data-value="Print" aria-pressed="true">Print</button>
          <button type="button" class="theinmag-membership-popup__pill" data-value="Digital" aria-pressed="false">Digital</button>
        </div>
      </fieldset>

      <fieldset class="theinmag-membership-popup__fieldset">
        <legend class="theinmag-membership-popup__legend">Length</legend>
        <div class="theinmag-membership-popup__pills" role="radiogroup" data-option-name="length">
          <button type="button" class="theinmag-membership-popup__pill theinmag-membership-popup__pill--stacked" data-value="4-Issue" aria-pressed="true"><span>4-Issue</span><small data-pill-price></small></button>
          <button type="button" class="theinmag-membership-popup__pill theinmag-membership-popup__pill--stacked theinmag-membership-popup__pill--featured" data-value="8-Issue" aria-pressed="false"><span>8-Issue</span><small data-pill-price></small><span class="theinmag-membership-popup__pill-chip">Best value</span></button>
          <button type="button" class="theinmag-membership-popup__pill theinmag-membership-popup__pill--stacked" data-value="Rolling" aria-pressed="false"><span>Rolling</span><small data-pill-price></small></button>
        </div>
      </fieldset>

      {%- comment -%}
        The starting-issue choice lives in the start picker dialog now
        (covers, not labels; opens on Add to cart for Print). Digital
        always starts with the current issue and skips it.
      {%- endcomment -%}
      <p class="theinmag-membership-popup__start-hint" data-print-start-hint>Next, you'll pick which mag arrives first.</p>
      <p class="theinmag-membership-popup__start-note" data-digital-start-note hidden>
        Digital always starts with the <strong>current issue ({{ current_issue }})</strong>, in your inbox straight away.
      </p>

      <button type="submit" class="theinmag-membership-popup__cta" data-membership-popup-submit>Add to cart</button>

      <ul class="theinmag-membership-popup__ticks" role="list">
        <li>Free shipping over $40</li>
        <li>Printed in Australia</li>
        <li>120+ pages, zero ads</li>
      </ul>
    </form>
  </div>

  <script type="application/json" data-membership-popup-variants>{{ membership_product.variants | json }}</script>
</dialog>

{% render 'theinmag-start-picker' %}

