{%- comment -%}
  theinmag-membership-popup
  Modal dialog rendered once on /shop. Triggered by clicking the Membership
  tile's "Join the club" CTA. Lets the customer pick Format / Length /
  Starting Issue and add the resulting Membership variant to cart without
  leaving the grid.

  Source of truth for the picker fields is the PDP inline form in
  sections/theinmag-membership-hero.liquid (lines ~263-323). If that
  form changes, mirror the change here. The two are duplicated by design:
  the PDP version carries PDP-only chrome (gallery sync, floating cart,
  Rolling-only accordion) and we don't want that bleeding into /shop.

  Renders nothing if the membership product is missing from the store.

  Required render arg:
    membership_product - the Shopify product object for Membership.

  Mounts its own document-level click listener for [data-membership-popup-trigger]
  so the bundle-tile snippet can stay dumb (just sets the data attribute).
{%- endcomment -%}

{%- if membership_product == blank or membership_product.id == blank -%}{%- else -%}

{%- liquid
  assign current_issue = shop.metafields.theinmag.current_issue_number.value | default: 'Mag09'
  assign print_in_stock = shop.metafields.theinmag.current_issue_print_in_stock.value
  assign next_release_value = shop.metafields.theinmag.next_release_date.value
  assign next_release_formatted = next_release_value | date: '%-d %B %Y'

  assign current_num_str = current_issue | remove: 'Mag'
  assign current_num = current_num_str | times: 1
  assign next_num = current_num | plus: 1
  if next_num < 10
    assign next_issue = 'Mag0' | append: next_num
  else
    assign next_issue = 'Mag' | append: next_num
  endif

  assign first_variant = membership_product.selected_or_first_available_variant
-%}

<dialog
  class="theinmag-membership-popup"
  data-theinmag-membership-popup
  aria-labelledby="theinmag-membership-popup-title"
>
  <div class="theinmag-membership-popup__inner">
    <button
      type="button"
      class="theinmag-membership-popup__close"
      data-membership-popup-close
      aria-label="Close membership options"
    >&#10005;</button>

    <header class="theinmag-membership-popup__head">
      <p class="theinmag-membership-popup__eyebrow">Join the club</p>
      <h2 id="theinmag-membership-popup-title" class="theinmag-membership-popup__title">Set up your membership</h2>
      <div class="theinmag-membership-popup__price" data-price-display>{{ first_variant.price | money }}</div>
    </header>

    <form
      action="{{ routes.cart_add_url }}"
      method="post"
      enctype="multipart/form-data"
      class="theinmag-membership-popup__form"
      data-membership-popup-form
    >
      <input type="hidden" name="id" data-variant-id-input value="{{ first_variant.id }}">
      <input type="hidden" name="quantity" value="1">
      <input type="hidden" name="properties[_starting_mag]" data-prop-starting-mag value="{{ current_issue }}">
      <input type="hidden" name="properties[_remaining_after_first]" data-prop-remaining value="3">
      <input type="hidden" name="properties[_mags_included]" data-prop-mags-included value="">

      <fieldset class="theinmag-membership-popup__fieldset">
        <legend class="theinmag-membership-popup__legend">Format</legend>
        <div class="theinmag-membership-popup__pills" role="radiogroup" data-option-name="format">
          <button type="button" class="theinmag-membership-popup__pill" data-value="Print" aria-pressed="true">Print</button>
          <button type="button" class="theinmag-membership-popup__pill" data-value="Digital" aria-pressed="false">Digital</button>
        </div>
      </fieldset>

      <fieldset class="theinmag-membership-popup__fieldset">
        <legend class="theinmag-membership-popup__legend">Length</legend>
        <div class="theinmag-membership-popup__pills" role="radiogroup" data-option-name="length">
          <button type="button" class="theinmag-membership-popup__pill" data-value="4-Issue" aria-pressed="true">4-Issue</button>
          <button type="button" class="theinmag-membership-popup__pill theinmag-membership-popup__pill--featured" data-value="8-Issue" aria-pressed="false">8-Issue<span class="theinmag-membership-popup__pill-chip">Best value</span></button>
          <button type="button" class="theinmag-membership-popup__pill" data-value="Rolling" aria-pressed="false">Rolling</button>
        </div>
      </fieldset>

      <fieldset class="theinmag-membership-popup__fieldset">
        <legend class="theinmag-membership-popup__legend">Starting issue</legend>
        <div class="theinmag-membership-popup__starting" role="radiogroup" data-option-name="starting" data-starting-group>
          <button type="button" class="theinmag-membership-popup__start-tile" data-value="current" aria-pressed="true">
            <span class="theinmag-membership-popup__start-title">Start with the current issue</span>
            <span class="theinmag-membership-popup__start-sub">{{ current_issue }}{% if print_in_stock %} - in stock now{% endif %}</span>
          </button>
          <button type="button" class="theinmag-membership-popup__start-tile" data-value="next" aria-pressed="false">
            <span class="theinmag-membership-popup__start-title">Start with the next issue</span>
            <span class="theinmag-membership-popup__start-sub">{{ next_issue }} - drops {{ next_release_formatted }}</span>
          </button>
        </div>
        <p class="theinmag-membership-popup__start-note" data-digital-start-note hidden>
          Digital always starts with the <strong>current issue ({{ current_issue }})</strong>.
        </p>
      </fieldset>

      <button type="submit" class="theinmag-membership-popup__cta" data-membership-popup-submit>Add to cart</button>

      <p class="theinmag-membership-popup__microcopy">
        Free shipping over $40 - Sustainably printed in Australia - 120+ pages, zero ads
      </p>
    </form>
  </div>

  <script type="application/json" data-membership-popup-variants>{{ membership_product.variants | json }}</script>
</dialog>

<style>
  .theinmag-membership-popup {
    padding: 0;
    border: none;
    background: transparent;
    max-width: min(540px, calc(100vw - 24px));
    width: 100%;
    color: var(--color-inky-purple-navy);
  }
  .theinmag-membership-popup::backdrop {
    background-color: rgba(42, 31, 61, 0.55);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  .theinmag-membership-popup__inner {
    position: relative;
    background-color: var(--color-cream);
    border: 1.5px solid var(--color-soft-pink);
    border-radius: 22px;
    box-shadow: 0 24px 60px rgba(42, 31, 61, 0.30), 0 6px 18px rgba(42, 31, 61, 0.14);
    padding: clamp(20px, 4vw, 32px);
    max-height: calc(100vh - 32px);
    overflow-y: auto;
  }
  .theinmag-membership-popup__close {
    position: absolute;
    top: 10px;
    right: 12px;
    appearance: none;
    background: transparent;
    border: none;
    color: var(--color-inky-purple-navy);
    font-size: 18px;
    line-height: 1;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .theinmag-membership-popup__close:hover,
  .theinmag-membership-popup__close:focus-visible {
    background-color: rgba(42, 31, 61, 0.08);
    outline: none;
  }
  .theinmag-membership-popup__head {
    text-align: center;
    margin-bottom: var(--space-md, 20px);
  }
  .theinmag-membership-popup__eyebrow {
    margin: 0 0 4px;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: var(--color-purple-dark, #5D3A7A);
  }
  .theinmag-membership-popup__title {
    margin: 0 0 8px;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(22px, 3vw, 28px);
    line-height: 1.1;
  }
  .theinmag-membership-popup__price {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 22px;
  }
  .theinmag-membership-popup__form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .theinmag-membership-popup__fieldset {
    border: none;
    padding: 0;
    margin: 0;
  }
  .theinmag-membership-popup__legend {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-inky-purple-navy);
    opacity: 0.78;
    margin-bottom: 8px;
    padding: 0;
  }
  .theinmag-membership-popup__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    /* Headroom for the "Best value" chip on the 8-Issue pill. */
    margin-top: 14px;
  }
  .theinmag-membership-popup__pill {
    position: relative;
    appearance: none;
    background: #ffffff;
    border: 2px solid var(--color-soft-pink);
    color: var(--color-inky-purple-navy);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 13px;
    padding: 8px 16px;
    border-radius: var(--radius-pill, 9999px);
    cursor: pointer;
    min-height: 38px;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .theinmag-membership-popup__pill:hover,
  .theinmag-membership-popup__pill:focus-visible {
    background-color: rgba(93, 58, 122, 0.07);
    outline: none;
  }
  .theinmag-membership-popup__pill[aria-pressed='true'] {
    background-color: rgba(93, 58, 122, 0.10);
    border-color: var(--color-purple-dark);
    color: var(--color-purple-dark);
  }
  .theinmag-membership-popup__pill-chip {
    position: absolute;
    top: -10px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    background: var(--color-yellow);
    color: var(--color-inky-purple-navy);
    font-weight: 700;
    font-size: 9px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 9999px;
    white-space: nowrap;
    pointer-events: none;
  }
  .theinmag-membership-popup__starting {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
  }
  .theinmag-membership-popup__starting[hidden] { display: none; }
  .theinmag-membership-popup__start-tile {
    appearance: none;
    background-color: #FFFFFF;
    border: 1.5px solid rgba(247, 160, 146, 0.55);
    color: var(--color-inky-purple-navy);
    text-align: left;
    padding: 12px 16px;
    border-radius: 16px;
    cursor: pointer;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: 12px;
    row-gap: 2px;
    align-items: center;
    transition: border-color 0.2s ease, background-color 0.2s ease;
    font-family: var(--font-body);
  }
  .theinmag-membership-popup__start-tile::before {
    content: '';
    grid-column: 1;
    grid-row: 1 / 3;
    align-self: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid var(--color-soft-pink);
    background: #ffffff;
    box-sizing: border-box;
    transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
  }
  .theinmag-membership-popup__start-tile:hover,
  .theinmag-membership-popup__start-tile:focus-visible {
    outline: none;
    border-color: var(--color-purple-dark);
  }
  .theinmag-membership-popup__start-tile[aria-pressed='true'] {
    background-color: rgba(93, 58, 122, 0.10);
    border-color: var(--color-purple-dark);
    border-width: 2px;
    padding: 11.5px 15.5px;
  }
  .theinmag-membership-popup__start-tile[aria-pressed='true']::before {
    border-color: var(--color-purple-dark);
    background: var(--color-purple-dark);
    box-shadow: inset 0 0 0 3px #ffffff;
  }
  .theinmag-membership-popup__start-title {
    grid-column: 2;
    font-weight: 700;
    font-size: 14px;
    line-height: 1.3;
  }
  .theinmag-membership-popup__start-sub {
    grid-column: 2;
    font-size: 12.5px;
    opacity: 0.78;
    line-height: 1.35;
  }
  .theinmag-membership-popup__start-note {
    margin: 0;
    padding: 12px 16px;
    background: rgba(93, 58, 122, 0.07);
    border: 1.5px solid rgba(93, 58, 122, 0.25);
    border-radius: 16px;
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.45;
    color: var(--color-inky-purple-navy);
  }
  .theinmag-membership-popup__start-note[hidden] { display: none; }
  .theinmag-membership-popup__cta {
    appearance: none;
    background-color: var(--color-yellow);
    border: none;
    color: var(--color-inky-purple-navy);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 15px;
    padding: 14px 22px;
    border-radius: var(--radius-pill, 9999px);
    cursor: pointer;
    min-height: 48px;
    margin-top: 4px;
    transition: filter 0.2s ease;
  }
  .theinmag-membership-popup__cta:hover,
  .theinmag-membership-popup__cta:focus-visible {
    filter: brightness(0.94);
    outline: none;
  }
  .theinmag-membership-popup__cta[disabled] {
    opacity: 0.6;
    cursor: wait;
  }
  .theinmag-membership-popup__microcopy {
    margin: 4px 0 0;
    font-family: var(--font-body);
    font-size: 11.5px;
    line-height: 1.45;
    text-align: center;
    color: var(--color-inky-purple-navy);
    opacity: 0.78;
  }
  @media (prefers-reduced-motion: reduce) {
    .theinmag-membership-popup__pill,
    .theinmag-membership-popup__start-tile,
    .theinmag-membership-popup__cta {
      transition: none;
    }
  }
</style>

<script>
  (function () {
    const dialog = document.querySelector('[data-theinmag-membership-popup]');
    if (!dialog) return;

    const form = dialog.querySelector('[data-membership-popup-form]');
    const variantsScript = dialog.querySelector('[data-membership-popup-variants]');
    const closeBtn = dialog.querySelector('[data-membership-popup-close]');
    const submitBtn = dialog.querySelector('[data-membership-popup-submit]');

    let variants = [];
    try {
      variants = JSON.parse(variantsScript.textContent);
    } catch (err) {
      console.error('[theinmag-membership-popup] failed to parse variants', err);
      return;
    }

    const variantInput = form.querySelector('[data-variant-id-input]');
    const priceDisplay = dialog.querySelector('[data-price-display]');
    const propStarting = form.querySelector('[data-prop-starting-mag]');
    const propRemaining = form.querySelector('[data-prop-remaining]');
    const propIncluded = form.querySelector('[data-prop-mags-included]');

    const currentIssue = '{{ current_issue }}';
    const nextIssue = '{{ next_issue }}';
    const printInStock = {{ print_in_stock | default: false | json }};

    function selected(optionName) {
      const tile = form.querySelector('[data-option-name="' + optionName + '"] [aria-pressed="true"]');
      return tile ? tile.dataset.value : null;
    }
    function setSelected(optionName, value) {
      const tiles = form.querySelectorAll('[data-option-name="' + optionName + '"] [data-value]');
      tiles.forEach(function (tile) {
        tile.setAttribute('aria-pressed', tile.dataset.value === value ? 'true' : 'false');
      });
    }
    function formatMoney(cents) { return '$' + (cents / 100).toFixed(2); }
    function padNumber(n) { return n < 10 ? '0' + n : String(n); }
    function issueNumberOf(label) { return parseInt(String(label).replace('Mag', ''), 10); }
    function magLabelFor(n) { return 'Mag' + padNumber(n); }
    function computeMagsIncluded(startMag, length) {
      if (length === 'Rolling') return startMag;
      const count = length === '4-Issue' ? 4 : 8;
      const startNum = issueNumberOf(startMag);
      const labels = [];
      for (let i = 0; i < count; i += 1) labels.push(magLabelFor(startNum + i));
      return labels.join(', ');
    }
    function computeRemainingAfterFirst(length) {
      if (length === '4-Issue') return '3';
      if (length === '8-Issue') return '7';
      return '0';
    }
    function findVariant(format, length) {
      return variants.find(function (v) { return v.option1 === format && v.option2 === length; });
    }

    function update() {
      const format = selected('format');
      const length = selected('length');
      let starting = selected('starting');

      const currentTile = form.querySelector('[data-option-name="starting"] [data-value="current"]');
      const startingGroup = form.querySelector('[data-starting-group]');
      const digitalStartNote = form.querySelector('[data-digital-start-note]');

      if (format === 'Digital') {
        /* Digital always begins with the current issue (no print-stock
           wait, no "next issue" split). Force current, hide the chooser,
           show the note. Combo keeps the choice - it ships the print copy. */
        starting = 'current';
        setSelected('starting', 'current');
        if (currentTile) currentTile.hidden = false;
        if (startingGroup) startingGroup.hidden = true;
        if (digitalStartNote) digitalStartNote.hidden = false;
      } else {
        if (startingGroup) startingGroup.hidden = false;
        if (digitalStartNote) digitalStartNote.hidden = true;
        const needsPrintStock = format === 'Print' || format === 'Combo';
        const hideCurrent = needsPrintStock && !printInStock;
        if (currentTile) {
          currentTile.hidden = hideCurrent;
          if (hideCurrent && starting === 'current') {
            starting = 'next';
            setSelected('starting', 'next');
          }
        }
      }

      const variant = findVariant(format, length);
      if (variant) {
        if (variantInput) variantInput.value = variant.id;
        if (priceDisplay) {
          let priceStr = formatMoney(variant.price);
          if (length === 'Rolling') priceStr += ' per drop';
          priceDisplay.textContent = priceStr;
        }
      }

      const startMag = starting === 'current' ? currentIssue : nextIssue;
      if (propStarting) propStarting.value = startMag;
      if (propRemaining) propRemaining.value = computeRemainingAfterFirst(length);
      if (propIncluded) propIncluded.value = computeMagsIncluded(startMag, length);
    }

    form.querySelectorAll('[data-option-name] [data-value]').forEach(function (tile) {
      tile.addEventListener('click', function () {
        const group = tile.closest('[data-option-name]');
        if (!group) return;
        setSelected(group.dataset.optionName, tile.dataset.value);
        update();
      });
    });

    function openPopup() {
      update();
      if (typeof dialog.showModal === 'function') {
        dialog.showModal();
      } else {
        dialog.setAttribute('open', '');
      }
    }
    function closePopup() {
      if (typeof dialog.close === 'function') {
        dialog.close();
      } else {
        dialog.removeAttribute('open');
      }
    }

    document.addEventListener('click', function (event) {
      const trigger = event.target.closest('[data-membership-popup-trigger]');
      if (trigger) {
        event.preventDefault();
        openPopup();
        return;
      }
    });
    if (closeBtn) closeBtn.addEventListener('click', closePopup);
    /* Click outside the inner card (on the ::backdrop) also closes. */
    dialog.addEventListener('click', function (event) {
      if (event.target === dialog) closePopup();
    });

    function flashFeedback(message) {
      const feedback = document.querySelector('[data-shop-feedback]');
      if (!feedback) return;
      feedback.textContent = message;
      feedback.removeAttribute('hidden');
      clearTimeout(feedback._timer);
      feedback._timer = setTimeout(function () { feedback.setAttribute('hidden', ''); }, 2400);
    }

    function refreshCartCount(productTitle) {
      fetch('/cart.js', { headers: { Accept: 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (cart) {
          document.querySelectorAll('[data-cart-count]').forEach(function (el) { el.textContent = cart.item_count; });
          document.body.setAttribute('data-theinmag-cart-count', cart.item_count);
          document.dispatchEvent(new CustomEvent('cart:updated', { detail: cart }));
          if (typeof publish === 'function' && typeof PUB_SUB_EVENTS !== 'undefined') {
            publish(PUB_SUB_EVENTS.cartUpdate, {
              source: 'theinmag-membership-popup',
              cartData: cart,
              productTitle: productTitle || ''
            });
          }
        })
        .catch(function () { /* graceful degradation */ });
    }

    form.addEventListener('submit', function (event) {
      event.preventDefault();
      if (submitBtn && submitBtn.disabled) return;
      update();
      if (submitBtn) submitBtn.disabled = true;

      const cartDrawer = document.querySelector('cart-drawer');
      const sectionIds = cartDrawer && typeof cartDrawer.getSectionsToRender === 'function'
        ? cartDrawer.getSectionsToRender().map(function (s) { return s.id; }).join(',')
        : '';

      const body = new FormData(form);
      if (sectionIds) {
        body.append('sections', sectionIds);
        body.append('sections_url', window.location.pathname);
      }

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
        body: body
      })
        .then(function (r) {
          if (!r.ok) throw new Error('Add failed');
          return r.json();
        })
        .then(function (data) {
          closePopup();
          const prettyTitle = (data.product_title || 'Membership').replace(/^theINmag\s*[-–]\s*/i, '');
          flashFeedback(prettyTitle + ' added to your cart');
          refreshCartCount(data.product_title);
          if (cartDrawer && data.sections && typeof cartDrawer.renderContents === 'function') {
            cartDrawer.renderContents(data);
          }
        })
        .catch(function () {
          flashFeedback('Could not add to cart. Try again.');
        })
        .finally(function () {
          if (submitBtn) submitBtn.disabled = false;
        });
    });

    update();
  })();
</script>

{%- endif -%}
