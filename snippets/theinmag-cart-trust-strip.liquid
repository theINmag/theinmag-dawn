{%- comment -%}
  theinmag-cart-trust-strip.liquid

  Five locked brand truths in slim text-only form. Rendered between
  line items and totals on both cart surfaces (drawer + /cart). No
  images - the existing trust-overlay JPGs are sized for product hero
  swaps, not slim cart bars.

  Copy is hardcoded so a single Liquid edit changes both surfaces;
  no schema settings (the 5 truths are brand-locked per spec 2.18).
{%- endcomment -%}

{%- liquid
  assign tick = '<svg class="theinmag-cart-trust__icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 10.5l3 3 7-7"/></svg>'
  assign surface_modifier = ''
  if surface == 'page'
    assign surface_modifier = ' theinmag-cart-trust--page'
  endif
-%}

<ul class="theinmag-cart-trust{{ surface_modifier }}" role="list">
  <li class="theinmag-cart-trust__item">
    {{ tick }}
    <span>100% ad-free</span>
  </li>
  <li class="theinmag-cart-trust__item">
    {{ tick }}
    <span>Made by Aussie kids, for Aussie kids</span>
  </li>
  <li class="theinmag-cart-trust__item">
    {{ tick }}
    <span>Sustainably printed in Australia</span>
  </li>
  <li class="theinmag-cart-trust__item">
    {{ tick }}
    <span>120+ pages of pure creativity</span>
  </li>
  <li class="theinmag-cart-trust__item">
    {{ tick }}
    <span>Real kids. Real names. Real towns.</span>
  </li>
</ul>

{%- comment -%} CSS lives in assets/theinmag-cart.css (snippet-level {% stylesheet %} blocks aren't reliably extracted). {%- endcomment -%}
