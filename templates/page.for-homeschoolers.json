    "curriculum-accordion": {
      "type": "theinmag-curriculum-accordion",
      "settings": {
        "heading": "What's [[IN]]side",
        "subhead": "Real-life experiences, rich open tasks, and a few hundred Aussie kids your kid hasn't met yet. Here's how each issue is broken down.",
        "subhead_size": "small",
        "mobile_tall_image": true,
        "image_filename": "blog-image-universal-03.jpg",
        "image_alt": "An Australian homeschool kid engaging with theINmag at home.",
        "caption": ""
      },
      "blocks": {
        "i1": {
          "type": "item",
          "settings": {
            "number": "01",
            "section_name": "The [[IN]] Map",
            "kicker": "GEOGRAPHY",
            "body": "A full Australian map, dotted with the home town of every kid published in the issue. Whose dot is closest to yours? How far would you have to drive to meet them? Brilliant for kids who love maps, road trips, or wondering where other kids live.",
            "is_open": true
          }
        },
        "i2": {
          "type": "item",
          "settings": {
            "number": "02",
            "section_name": "The Featured Story",
            "kicker": "LITERACY",
            "body": "Each issue, one standout piece of kid writing gets the spotlight - usually a picture story book with the kid's own illustrations. A read-aloud your kid actually asks for, written by someone their own age, which lands in a way grown-up authors never quite do."
          }
        },
        "i3": {
          "type": "item",
          "settings": {
            "number": "03",
            "section_name": "Taste the PIE",
            "kicker": "LITERACY",
            "body": "Real kid writing, with real intent - to persuade, inform, or entertain. The mentor texts your homeschooler actually wants to read, because the writer is their age. Pick one apart together, then have a go at your own and send it [[IN]]."
          }
        },
        "i4": {
          "type": "item",
          "settings": {
            "number": "04",
            "section_name": "Making the Best Me",
            "kicker": "WELLBEING",
            "body": "Real reflections from real kids on big feelings, friendships and staying safe. It's quite empowering to see kids share the little strategies that help them find balance. A gentle conversation starter for the kitchen table whenever you need one."
          }
        },
        "i5": {
          "type": "item",
          "settings": {
            "number": "05",
            "section_name": "The Art Hub",
            "kicker": "VISUAL ARTS",
            "body": "Every issue, dozens of kids share their art and the story behind it. Your kid sees what's possible - and what's allowed. Use any piece as an 'I notice, I wonder' starter, then hand over the pencils and see where it goes."
          }
        },
        "i6": {
          "type": "item",
          "settings": {
            "number": "06",
            "section_name": "What's Not to Like?",
            "kicker": "PROBLEM-SOLVING",
            "body": "Real problems, solved by real kids - jokes, riddles, codes and puzzles included. Open-ended, multi-solution, the kind of thinking that doesn't fit on a worksheet. Get your kid inventing their own to send [[IN]]; the engagement is immediate."
          }
        },
        "i7": {
          "type": "item",
          "settings": {
            "number": "07",
            "section_name": "We Can Solve It!",
            "kicker": "NUMERACY",
            "body": "Real maths problems dreamed up by Aussie kids. Surprisingly deep, often with more than one right answer, perfect for slow thinking out loud together. A quiet way to show your kid that maths is something you play with, not just something you finish."
          }
        },
        "i8": {
          "type": "item",
          "settings": {
            "number": "08",
            "section_name": "Snaps!",
            "kicker": "VISUAL ARTS / PHOTOGRAPHY",
            "body": "Photography sent [[IN]] by Aussie kids - landscapes, animals, plants, found-object compositions (no faces, for safety). The perfect nudge to hand your kid a camera and send them out the door, then send their best shot [[IN]] for the next issue."
          }
        },
        "i9": {
          "type": "item",
          "settings": {
            "number": "09",
            "section_name": "Meet the Professional",
            "kicker": "CAREER PATHWAYS",
            "body": "Each issue, a real person shares the job they love and how they got there. Great for the 'what do you want to be?' chats, and a lovely prompt for your kid to go and interview someone in your own community."
          }
        },
        "i10": {
          "type": "item",
          "settings": {
            "number": "10",
            "section_name": "HobbyTime",
            "kicker": "PASSIONS, INTERESTS & HOBBIES",
            "body": "Aussie kids sharing what they love outside of any lesson - cooking, music, nature, building, gaming, sport, pets, art. Real fuel for following your kid's own obsessions wherever they lead, and proof there's a whole country of kids into the same wild stuff."
          }
        }
      },
      "block_order": ["i1", "i2", "i3", "i4", "i5", "i6", "i7", "i8", "i9", "i10"]
    },
