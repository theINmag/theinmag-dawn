    "theinmag_philosophy": {
      "type": "theinmag-philosophy",
      "blocks": {
        "anchor-philosophy": {
          "type": "anchor",
          "settings": {
            "label": "our philosophy",
            "paragraph": "Creativity is the foundation of impactful learning. theINmag is a safe place for kids to explore, stay curious, and be inspired - and a real chance to see their creation in print. No grades, no right answers. Just the joy of being seen, heard and celebrated for what you make."
          }
        },
        "anchor-standards": {
          "type": "anchor",
          "settings": {
            "label": "our standards",
            "paragraph": "We're set on giving Aussie kids the best magazine on the market. Always ad-free. Sustainably printed in Melbourne. The reason we go this hard on quality? Seeing your creation in a beautifully made magazine respects the kid who made it - way more than a cheap mag or a forgotten website ever could."
          }
        },
        "anchor-impact": {
          "type": "anchor",
          "settings": {
            "label": "our impact",
            "paragraph": "Read by thousands of kids in every state and territory, theINmag turns creativity into connection. The first time a kid sees their creation in print, something shifts. They start to see themselves as a creator - someone whose ideas are worth a real, printed page. That's the impact we're chasing."
          }
        },
        "anchor-story": {
          "type": "anchor",
          "settings": {
            "label": "our story",
            "paragraph": "Two former teachers with a small idea that wouldn't quit. Ryan and Tam sold the house to fund theINmag, and they're now travelling Australia in their self-converted van with their baby Nora - meeting kids, schools and families face to face, and reminding every Aussie kid their voice belongs in print."
          }
        }
      },
      "block_order": [
        "anchor-philosophy",
        "anchor-standards",
        "anchor-impact",
        "anchor-story"
      ],
      "settings": {
        "fallback_filename": "HERO_founders-atthemarket.jpg",
