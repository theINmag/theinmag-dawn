        "card-4": { "type": "archive_card", "settings": { "topic": "Creativity", "title_override": "things to draw when you're stuck.", "tags": "creativity, kids, drawing, prompts", "body_content": "Twelve quick prompts for when the page is staring back. Draw your shoe upside down. Draw your dog if you have one, or someone else's dog. Draw what you ate for breakfast as if it were a face. Draw the same tree four times - in summer, autumn, winter, spring. Draw a self portrait but only your hands. Draw your favourite room from above, like a bird looking down. Draw a cloud that looks like an animal. Draw the inside of your pencil case. Draw a map of the walk to school. Draw the last dream you remember. Draw a vegetable that doesn't exist. Draw your hand drawing your hand.", "fallback_filename": "blog-image-universal-04.jpg", "link_override": "/blogs/field-notes" } },
