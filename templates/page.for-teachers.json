          "type": "item",
          "settings": {
            "number": "04",
            "section_name": "Making the Best Me",
            "kicker": "WELLBEING",
            "body": "Real reflections from real kids on emotions, friendships and safety. It's pretty amazing to see kids sharing the strategies they use to maintain a healthy way of being. Use as a circle-time prompt, a journal starter, or a discussion springboard for your wellbeing block."
          }
        },
        "i5": {
          "type": "item",
          "settings": {
            "number": "05",
            "section_name": "The Art Hub",
            "kicker": "VISUAL ARTS",
            "body": "A gallery of kid-made artworks across every medium - drawing, painting, sculpture, craft, chalk, pottery, mixed media. Use any piece as a picture prompt for 'I notice, I wonder' protocols, story starters, art critique sessions, or visual literacy work. Show your students what's possible from kids their age and watch the bar rise across the whole room."
          }
        },
