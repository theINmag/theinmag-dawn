    "statement": {
      "type": "theinmag-for-parents-statement",
      "settings": {
        "heading": "The kid who never puts their hand up. Published.",
        "body": "There's one in every classroom. The quiet one. The reluctant writer. The kid who's brilliant but won't read aloud. theINmag gives them a way through - their words, their art, their voice, on a page that goes out to thousands of Aussie kids. Something shifts after that. You'll see it.",
        "cta_label": "Send IN a student's creation",
        "cta_link": "/pages/send-in",
        "trust_microcopy": "Free to submit. Open to every Aussie kid. Curated by teachers."
      }
    },
