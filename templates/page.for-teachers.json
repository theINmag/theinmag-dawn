      "blocks": {
        "trio-1": {
          "type": "pillar",
          "settings": {
            "weight": "standard",
            "eyebrow": "ENGAGEMENT",
            "headline": "Kids read it because they want to.",
            "body": "Real Aussie kids fill every page - their stories, their art, their jokes, their puzzles. Your students see themselves in it instantly. The engagement is built in - because the content actually belongs to them. Open-ended prompts, real-world problems, the kind of rich tasks kids can take in their own direction.",
            "accent_filename": "kid-leaves_topleft.png",
            "accent_position": "top-right",
            "accent_opacity": 18
          }
        },
        "trio-2": {
          "type": "pillar",
          "settings": {
            "weight": "standard",
            "eyebrow": "MENTOR TEXTS",
            "headline": "Genuine authenticity.",
            "body": "Every piece is a mentor text written by a kid their age, in their voice, with their wonky bits and brilliant turns. Far more persuasive than anything in a textbook. Show your students what's possible, then watch them reach for it - across literacy, art, numeracy and wellbeing.",
            "accent_filename": "bundle1.png",
            "accent_position": "bottom-left",
            "accent_opacity": 65
          }
        },
        "trio-3": {
          "type": "pillar",
          "settings": {
            "weight": "standard",
            "eyebrow": "REAL AUDIENCE",
            "headline": "Writing for kids they've never met.",
            "body": "A classroom task with a real audience changes everything. Submit your students' creations - the ones we publish reach Aussie kids right across the country. Suddenly the ending matters. Suddenly the colour choice matters. Suddenly they care.",
            "accent_filename": "bundle2.png",
            "accent_position": "top-right",
