    "faq": {
      "type": "theinmag-membership-faq",
      "settings": {
        "heading": "Common questions,<br>honestly answered.",
        "bg_image_filename": "parents-FAQ.jpg",
        "bg_image_opacity": 75
      },
      "blocks": {
        "q1": {
          "type": "faq_item",
          "settings": {
            "question": "What ages is theINmag for?",
            "answer": "theINmag is designed for primary-age kids, with a sweet spot from 7 to 13. That said, we've had kids from age 3 right through to 16 sending in their creations and getting published. Every section is built to work for any age - the writing, the art, the puzzles, the photography - because the magazine carries the kids' voices exactly as they are. We don't alter the text. We don't polish the images. What you read is what they made."
          }
        },
        "q2": {
          "type": "faq_item",
          "settings": {
            "question": "How does my kid get published?",
            "answer": "Send their creation IN through our submission page - art, writing, photography, jokes, puzzles, comics, anything they've made. A small team of teachers, artists and parents considers every single submission. What we look for most isn't talent or polish - it's effort. The piece a kid clearly cared about, kept working on, made their own. Those are the ones that land in the next issue, published with the kid's first name, surname initial, age and town."
          }
        },
        "q3": {
          "type": "faq_item",
          "settings": {
            "question": "What's the difference between the Memberships?",
            "answer": "Three options. 4-Issue Membership ($89) - four issues paid upfront, our cheapest per-issue price for trying it. 8-Issue Membership ($159) - eight issues paid upfront, biggest saving per issue. Rolling Membership ($28.90 per drop) - one issue per drop, auto-renews at each release, cancel anytime from your account. All three include free shipping over $40."
          }
        },
        "q4": {
          "type": "faq_item",
          "settings": {
            "question": "When does the next issue come out?",
            "answer": "theINmag releases three times a year - 15 February, 15 June and 15 October. The next issue (Mag10) drops 15 June 2026. If you start a Membership today, you can pick whether to begin with the current issue (Mag09, in stock now) or the next one (Mag10, ships on release)."
          }
        },
        "q5": {
          "type": "faq_item",
          "settings": {
            "question": "Can I cancel a Rolling Membership?",
            "answer": "Yes, anytime, from your account dashboard. No phone calls, no hoops, no guilt. The Rolling Membership exists so families can stay subscribed for as long as it's working for them, and stop the moment it isn't. We'd rather have a happy ex-Member than an annoyed current one."
          }
        },
        "q6": {
          "type": "faq_item",
          "settings": {
            "question": "Is theINmag actually different from other kids' magazines?",
            "answer": "Three things make it different. One, every page is made by Australian kids, not adult illustrators or content teams. Two, there are no ads, ever - no banner ads, no sponsored content, no brand integrations. Three, it's printed in Melbourne using vegetable-based inks on FSC-certified paper. If those things matter to you, theINmag is for you."
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4",
        "q5",
        "q6"
      ]
    },
